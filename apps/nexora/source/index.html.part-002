>
                <div className="lp-folder-metro-stations">
                  <div className="lp-folder-metro-line" style={{ "--folder-color": folderMetro.folder?.color || "var(--text-muted)" }} />
                  {folderMetro.items.map((item, i) => {
                    const itemColor = item.color || folderMetro.folder?.color || "var(--text-muted)";
                    return (
                      <button key={item.id} type="button" className="lp-folder-metro-station" onClick={() => navigateFromFolderMetro(item)} title={`Afficher ${item.name}`}>
                        <span className="lp-folder-metro-name">{item.name}</span>
                        <span className="lp-folder-metro-dot" style={{ "--folder-color": itemColor }}>
                          <IconGlyph icon={item.icon || (folderMetro.type === "project" ? "tabler:folder" : "tabler:layout-dashboard")} size={13} />
                        </span>
                      </button>
                    );
                  })}
                </div>
              </div>
            ) : (
              <div className="lp-folder-metro-empty">
                <IconGlyph icon={folderMetro.folder?.icon || (folderMetro.type === "project" ? "tabler:folder" : "tabler:layout-dashboard")} size={20} />
                <span>Aucun {folderMetro.type === "project" ? "projet" : "tableau de bord"} dans ce dossier</span>
              </div>
            )}
          </div>
        </div>
      )}
      <button
        type="button"
        className="lp-global-add-task"
        onClick={() => openNewTask({})}
        aria-label="Créer une tâche"
        title="Créer une tâche"
      >
        <Plus size={23} strokeWidth={2.5} />
        <span className="lp-global-add-task-label">Nouvelle tâche</span>
      </button>

      {/* ---------------- Barre de navigation mobile (bas d'écran) ----------------
          Masquée en desktop/tablette via CSS (display:none), affichée uniquement
          sous 768px. Réutilise exactement les mêmes données/handlers que le rail
          desktop (view, setView, ALL_VIEWS_META, enabledViews) — aucune logique
          dupliquée, seule la présentation change. */}
      <nav className="lp-mobile-tabbar" aria-label="Navigation principale">
        {["control", "today", "projects"].map((key) => {
          if (enabledViews[key] === false) return null;
          const meta = ALL_VIEWS_META.find((v) => v.key === key);
          if (!meta) return null;
          const isActive = key === "projects" ? PROJECT_TAB_VIEW_KEYS.includes(view) : view === key;
          return (
            <button key={key} type="button" className={"lp-mobile-tab" + (isActive ? " active" : "")} onClick={() => { setView(key); setMobileMoreOpen(false); }}>
              <IconGlyph icon={appearance.viewIcons?.[meta.key] || meta.iconKey} size={21} />
              <span>{meta.label === "Planning Projets" ? "Réseau" : meta.label}</span>
            </button>
          );
        })}
        <button type="button" className={"lp-mobile-tab" + (sidebarCollapsed === false ? " active" : "")} onClick={() => { setSidebarCollapsed((c) => !c); setMobileMoreOpen(false); }}>
          <Folder size={21} />
          <span>Dossiers</span>
        </button>
        <button type="button" className={"lp-mobile-tab" + (mobileMoreOpen ? " active" : "")} onClick={() => setMobileMoreOpen((o) => !o)}>
          <MoreHorizontal size={21} />
          {unreadNotificationsCount > 0 && <span className="lp-tab-badge lp-mobile-tab-badge">{unreadNotificationsCount > 9 ? "9+" : unreadNotificationsCount}</span>}
          <span>Plus</span>
        </button>
      </nav>
      {mobileMoreOpen && (
        <>
          <div className="lp-mobile-sheet-overlay" onMouseDown={() => setMobileMoreOpen(false)} onTouchStart={() => setMobileMoreOpen(false)} />
          <div className="lp-mobile-sheet" role="dialog" aria-modal="true" aria-label="Plus d'options">
            <div className="lp-mobile-sheet-handle" />
            <div className="lp-mobile-sheet-grid">
              {ALL_VIEWS_META.filter((v) => !["control", "projects", "today"].includes(v.key) && enabledViews[v.key] !== false).map((meta) => (
                <button key={meta.key} type="button" className="lp-mobile-sheet-item" onClick={() => { setView(meta.key); setMobileMoreOpen(false); }}>
                  <IconGlyph icon={appearance.viewIcons?.[meta.key] || meta.iconKey} size={20} />
                  <span>{meta.label}</span>
                  {meta.key === "notifications" && unreadNotificationsCount > 0 && <span className="lp-tab-badge">{unreadNotificationsCount > 9 ? "9+" : unreadNotificationsCount}</span>}
                </button>
              ))}
            </div>
            <hr className="lp-divider" />
            <button type="button" className="lp-mobile-sheet-item lp-mobile-sheet-item-wide" onClick={() => { setSettingsTab("projects"); setSettingsOpen(true); setMobileMoreOpen(false); }}>
              <Settings size={20} /><span>Réglages</span>
            </button>
            <button type="button" className="lp-mobile-sheet-item lp-mobile-sheet-item-wide" onClick={() => { setReadmeOpen(true); setMobileMoreOpen(false); }}>
              <BookOpen size={20} /><span>Guide de démarrage</span>
            </button>
          </div>
        </>
      )}
      <ToastStack toasts={toasts} onDismiss={dismissToast} />
      {readmeOpen && <ReadmeModal onClose={() => setReadmeOpen(false)} />}
      {filtersOpen && <FiltersModal filters={filters} setFilters={setFilters} ctx={ctx} onClose={() => setFiltersOpen(false)} />}
      {globalSearchOpen && (
        <GlobalMetaSearchModal
          tasks={tasks}
          taskArchive={taskArchive}
          ctx={ctx}
          onRestoreArchived={restoreArchivedTasks}
          onOpenTask={(t) => { setGlobalSearchOpen(false); openEditTask(t); }}
          onClose={() => setGlobalSearchOpen(false)}
        />
      )}
      {importOpen && <ImportCsvModal ctx={ctx} projects={projects} statuses={statuses} setProjects={setProjects} setStatuses={setStatuses} setTasks={setTasks} persistKey={persistKey} pushToast={pushToast} syncBlocked={syncBlocked} onClose={() => setImportOpen(false)} />}
      {markdownImportOpen && (
        <MarkdownImportModal
          projects={projects}
          setProjects={setProjects}
          statuses={statuses}
          setStatuses={setStatuses}
          taskTypes={taskTypes}
          setTasks={setTasks}
          palette={PROJECT_PALETTES[appearance.projectPalette] || PROJECT_PALETTES.default}
          pushToast={pushToast}
          onClose={() => setMarkdownImportOpen(false)}
        />
      )}
      {projectFoldersOpen && <SimpleFolderManager title="Dossiers de projets" folders={projectFolders} setFolders={setProjectFolders} countInFolder={(id) => projects.filter((p) => p.folderId === id).length} pushToast={pushToast} onClose={() => setProjectFoldersOpen(false)} itemLabel="dossier" />}
      {viewFoldersOpen && <SimpleFolderManager title="Dossiers de vues" folders={viewFolders} setFolders={setViewFolders} countInFolder={(id) => savedViews.filter((v) => v.folderId === id).length} pushToast={pushToast} onClose={() => setViewFoldersOpen(false)} />}
      {saveViewOpen && <SaveViewModal onClose={() => setSaveViewOpen(false)} onSave={saveCurrentView} activeFilterCount={fCount} currentView={view} viewFolders={viewFolders} />}
      {newDashboardOpen && <NewDashboardModal onClose={() => setNewDashboardOpen(false)} onCreate={createDashboard} dashboardFolders={dashboardFolders} />}
      {quickEditDashboard && (
        <DashboardEditModal
          dashboard={quickEditDashboard}
          onSave={(patch) => { updateDashboardMeta(quickEditDashboard.id, patch); setQuickEditDashboard(null); }}
          onClose={() => setQuickEditDashboard(null)}
        />
      )}
      {dashboardFoldersOpen && <SimpleFolderManager title="Dossiers de tableaux de bord" folders={dashboardFolders} setFolders={setDashboardFolders} countInFolder={(id) => dashboards.filter((d) => d.folderId === id).length} pushToast={pushToast} onClose={() => setDashboardFoldersOpen(false)} />}
      {quickEditDashboardFolder && (
        <SimpleFolderManager
          title="Dossiers de tableaux de bord"
          folders={dashboardFolders}
          setFolders={setDashboardFolders}
          countInFolder={(id) => dashboards.filter((d) => d.folderId === id).length}
          pushToast={pushToast}
          initialEditFolder={quickEditDashboardFolder}
          onClose={() => setQuickEditDashboardFolder(null)}
        />
      )}
    </div>
  );
}

// ============================================================================
// Modale Filtres
// ============================================================================
function filterFieldOptions(field, ctx) {
  if (field === "project") return [
    { value:NO_PROJECT_FILTER, label:"Sans projet", color:"#94A3B8", folderId:null },
    ...sortedByName(ctx.projects).map((p) => ({ value:p.id, label:p.name, color:p.color, folderId:p.folderId || null })),
  ];
  if (field === "status") return sortedByName(ctx.statuses).map((s) => ({ value: s.id, label: s.name, color:s.color }));
  // Pas de tri : l'ordre de CRITICALITIES est l'ordre voulu, Bas avant Urgent.
  if (field === "criticality") return CRITICALITIES.map((c) => ({ value: c.id, label: c.name, color: c.color }));
  if (field === "taskType") return sortedByName(ctx.taskTypes || []).map((s) => ({ value: s.id, label: s.name, color:s.color }));
  if (field === "assignee") return sortedByName(ctx.teamMembers || []).map((u) => ({ value: u.name, label: u.name, color: u.color }));
  if (field === "milestone") return [{ value: "yes", label: "Oui" }, { value: "no", label: "Non" }];
  if (field && field.startsWith("cf:")) {
    const id = field.slice(3);
    const def = (ctx.customFieldDefs || []).find((f) => f.id === id);
    if (!def) return [];
    if (def.type === "checkbox") return [{ value: "true", label: "Oui" }, { value: "false", label: "Non" }];
    if (def.type === "select") return (def.options || []).map((o) => ({ value: o, label: o }));
    // Texte / nombre / date : pas de liste fermée — on propose les valeurs
    // réellement déjà utilisées dans les tâches, comme pour "Responsable".
    const values = new Set();
    (ctx.tasks || []).forEach((t) => {
      const v = t.customFields ? t.customFields[id] : undefined;
      if (v !== undefined && v !== null && v !== "") values.add(String(v));
    });
    return [...values].sort().map((v) => ({ value: v, label: def.type === "date" ? fmtShort(v) : v }));
  }
  return [];
}

function FilterConditionRow({ cond, onChange, onRemove, ctx, fieldsOverride }) {
  const options = filterFieldOptions(cond.field, ctx);
  const isDateField = cond.field === "start" || cond.field === "end";
  const isTitleField = cond.field === "title";
  const isInactivityField = cond.field === "inactivity";
  const isEntityField = cond.field === "project" || cond.field === "status" || cond.field === "taskType";
  return (
    <div className="lp-filter-condition-row">
      <select className="lp-filter-cond-select" value={cond.field} onChange={(e) => onChange({ ...cond, field: e.target.value, values: [], datePreset: "", textValue: "", numberValue: "", mode: "is" })}>
        {fieldsOverride ? (
          fieldsOverride.map((f) => <option key={f} value={f}>{fieldLabel(f, ctx)}</option>)
        ) : (
          <>
            <optgroup label="Champs standards">
              {ADVANCED_FILTER_FIELDS.map((f) => <option key={f} value={f}>{fieldLabel(f, ctx)}</option>)}
            </optgroup>
            {(ctx.customFieldDefs || []).length > 0 && (
              <optgroup label="Champs personnalisés">
                {ctx.customFieldDefs.map((f) => <option key={f.id} value={"cf:" + f.id}>{f.name}</option>)}
              </optgroup>
            )}
          </>
        )}
      </select>
      {isTitleField ? (
        <div className="lp-mode-toggle lp-mode-toggle-icon">
          <button type="button" className={cond.mode !== "not_contains" ? "active" : ""} onClick={() => onChange({ ...cond, mode: "contains" })} title="Contient"><SearchCheck size={13} /></button>
          <button type="button" className={cond.mode === "not_contains" ? "active" : ""} onClick={() => onChange({ ...cond, mode: "not_contains" })} title="Ne contient pas"><SearchX size={13} /></button>
        </div>
      ) : isInactivityField ? (
        <div className="lp-mode-toggle">
          <button type="button" className="active" style={{pointerEvents:"none"}}>Supérieur à</button>
        </div>
      ) : (
        <div className="lp-mode-toggle">
          <button className={cond.mode !== "isnot" ? "active" : ""} onClick={() => onChange({ ...cond, mode: "is" })}>Est</button>
          <button className={cond.mode === "isnot" ? "active" : ""} onClick={() => onChange({ ...cond, mode: "isnot" })}>N'est pas</button>
        </div>
      )}
      {isTitleField ? (
        <input type="text" style={{ flex: 1 }} value={cond.textValue || ""} onChange={(e) => onChange({ ...cond, textValue: e.target.value })} placeholder="Texte à rechercher dans le titre…" />
      ) : isDateField ? (
        <select className="lp-filter-date-preset-select" style={{ flex: 1 }} value={cond.datePreset || ""} onChange={(e) => onChange({ ...cond, datePreset: e.target.value })}>
          <option value="">— Choisir une période —</option>
          {DATE_FILTER_PRESETS.map((p) => <option key={p.key} value={p.key}>{p.label}</option>)}
        </select>
      ) : isInactivityField ? (
        <div style={{flex:1,display:"flex",alignItems:"center",gap:7}}>
          <input
            type="number"
            min="0"
            step="1"
            value={cond.numberValue ?? ""}
            onChange={(e) => onChange({ ...cond, numberValue:e.target.value })}
            placeholder="Nombre de jours"
            style={{maxWidth:150}}
          />
          <span style={{fontSize:11,color:"var(--text-muted)"}}>jours</span>
        </div>
      ) : isEntityField ? (
        <div style={{flex:1,minWidth:0}}>
          <EntityFilterMultiSelect
            compact
            options={options}
            selectedIds={cond.values || []}
            onToggle={(id)=>{
              const current=cond.values || [];
              const has=current.includes(id);
              onChange({...cond,values:has ? current.filter((v)=>v!==id) : [...current,id]});
            }}
            onSelectAll={()=>onChange({...cond,values:options.map((o)=>o.value)})}
            onDeselectAll={()=>onChange({...cond,values:[]})}
            metaGroups={cond.field === "project" ? (ctx.projectFolders || []) : null}
            onSelectGroup={cond.field === "project" ? (folderId)=>{
              const ids=(ctx.projects || []).filter((p)=>p.folderId===folderId).map((p)=>p.id);
              onChange({...cond,values:[...new Set([...(cond.values || []),...ids])]});
            } : null}
          />
        </div>
      ) : (
        <div className="lp-filter-chipset" style={{ flex: 1 }}>
          {options.map((o) => (
            <button
              key={o.value}
              className={"lp-filter-chip" + ((cond.values || []).includes(o.value) ? " active" : "")}
              onClick={() => {
                const has = (cond.values || []).includes(o.value);
                onChange({ ...cond, values: has ? cond.values.filter((v) => v !== o.value) : [...(cond.values || []), o.value] });
              }}
            >{o.label}</button>
          ))}
          {options.length === 0 && <span style={{ fontSize: 11.5, color: "var(--text-600)" }}>Aucune valeur disponible</span>}
        </div>
      )}
      <button className="lp-icon-btn" onClick={onRemove} title="Supprimer cette condition"><Trash2 size={13} /></button>
    </div>
  );
}

function FilterGroupEditor({ group, onChange, ctx, depth = 0 }) {
  const items = group.items || [];
  const updateItem = (idx, newItem) => { const n = [...items]; n[idx] = newItem; onChange({ ...group, items: n }); };
  const removeItem = (idx) => onChange({ ...group, items: items.filter((_, i) => i !== idx) });
  const addCondition = () => onChange({ ...group, items: [...items, { field: "project", mode: "is", values: [] }] });
  const addGroup = () => onChange({ ...group, items: [...items, { op: "and", items: [] }] });

  return (
    <div className={"lp-filter-group" + (depth > 0 ? " lp-filter-group-nested" : "")}>
      <div className="lp-filter-group-header">
        <div className="lp-mode-toggle">
          <button className={group.op !== "or" ? "active" : ""} onClick={() => onChange({ ...group, op: "and" })}>ET</button>
          <button className={group.op === "or" ? "active" : ""} onClick={() => onChange({ ...group, op: "or" })}>OU</button>
        </div>
        <span style={{ fontSize: 11, color: "var(--text-600)" }}>{items.length === 0 ? "Aucune condition — ne filtre rien" : `${items.length} élément${items.length > 1 ? "s" : ""} combiné${items.length > 1 ? "s" : ""} avec ${group.op === "or" ? "OU" : "ET"}`}</span>
        <button className="lp-tool-btn" onClick={addCondition} style={{ marginLeft: "auto" }}><Plus size={12} /> Condition</button>
        <button className="lp-tool-btn" onClick={addGroup}><Layers size={12} /> Sous-groupe</button>
      </div>
      {items.map((item, idx) => (
        item.items ? (
          <div key={idx} className="lp-filter-subgroup-wrap">
            <FilterGroupEditor group={item} onChange={(g) => updateItem(idx, g)} ctx={ctx} depth={depth + 1} />
            <button className="lp-icon-btn" onClick={() => removeItem(idx)} title="Supprimer ce sous-groupe"><Trash2 size={13} /></button>
          </div>
        ) : (
          <FilterConditionRow key={idx} cond={item} onChange={(c) => updateItem(idx, c)} onRemove={() => removeItem(idx)} ctx={ctx} />
        )
      ))}
    </div>
  );
}

// Corps des champs de filtre, extrait de FiltersModal pour être réutilisable
// ailleurs (notamment dans l'édition d'une vue enregistrée, qui doit permettre
// de retoucher ses conditions sans passer par le panneau de filtres général).
function FilterFieldsBody({ local, setLocal, ctx }) {
  return (
    <>
      <div className="lp-field"><label>Recherche</label><input type="text" value={local.search} onChange={(e) => setLocal({ ...local, search: e.target.value })} placeholder="Titre ou description..." /></div>

      <div className="lp-filter-section">
        <div className="lp-section-title">Filtres avancés (ET / OU, imbricables)</div>
        <FilterGroupEditor group={local.advanced || { op: "and", items: [] }} onChange={(g) => setLocal({ ...local, advanced: g })} ctx={ctx} />
      </div>
      <div className="lp-filter-section">
        <div className="lp-section-title">Jalon (compatibilité)</div>
        <div className="lp-filter-chipset">
          {[["all", "Tous"], ["yes", "Oui"], ["no", "Non"]].map(([v, l]) => <button key={v} className={"lp-filter-chip" + (local.milestone === v ? " active" : "")} onClick={() => setLocal({ ...local, milestone: v })}>{l}</button>)}
        </div>
      </div>
      <div className="lp-checkbox-row">
        <input type="checkbox" id="lateOnly" checked={local.lateOnly} onChange={(e) => setLocal({ ...local, lateOnly: e.target.checked })} />
        <label htmlFor="lateOnly" style={{ margin: 0, textTransform: "none", fontWeight: 500 }}>Tâches en retard uniquement</label>
      </div>
      <div className="lp-row2">
        <div className="lp-field">
          <label>X jours dans le passé</label>
          <input
            type="number"
            min="0"
            value={local.pastDays ?? ""}
            onChange={(e) => setLocal({ ...local, pastDays: e.target.value })}
            placeholder="Vide = tout"
            style={{ maxWidth: 120 }}
          />
          <div style={{fontSize:10,color:"var(--text-muted)",marginTop:4}}>
            Vide = tout l'historique · 0 = aujourd'hui + futur · 30 = J−30 + futur.
          </div>
        </div>
        <div className="lp-field">
          <label>Échéance dans les prochains jours</label>
          <input
            type="number"
            min="0"
            value={local.dueWithinDays}
            onChange={(e) => setLocal({ ...local, dueWithinDays: e.target.value })}
            placeholder="Vide = tout"
            style={{ maxWidth: 120 }}
          />
          <div style={{fontSize:10,color:"var(--text-muted)",marginTop:4}}>
            Vide = aucune limite future.
          </div>
        </div>
      </div>
      <div className="lp-filter-section">
        <div className="lp-section-title">Inactivité / tâches mortes</div>
        <div className="lp-field">
          <label>Inactivité supérieure à X jours</label>
          <input
            type="number"
            min="0"
            value={local.inactivityDays ?? local.inactivityMinDays ?? ""}
            onChange={(e) => setLocal({ ...local, inactivityDays:e.target.value, inactivityMinDays:"", inactivityMaxDays:"" })}
            placeholder="Ex. 14"
            style={{ maxWidth:120 }}
          />
        </div>
        <div style={{fontSize:10,color:"var(--text-muted)",marginTop:4}}>
          Exemple : 30 affiche uniquement les tâches dont l'inactivité est strictement supérieure à 30 jours.
        </div>
      </div>
      <div className="lp-row2">
        <div className="lp-field"><label>Avancement min (%)</label><input type="number" min="0" max="100" value={local.progressMin} onChange={(e) => setLocal({ ...local, progressMin: Number(e.target.value) })} /></div>
        <div className="lp-field"><label>Avancement max (%)</label><input type="number" min="0" max="100" value={local.progressMax} onChange={(e) => setLocal({ ...local, progressMax: Number(e.target.value) })} /></div>
      </div>
      <div className="lp-row2">
        <div className="lp-field"><label>Début — de</label><input type="date" value={local.startFrom} onChange={(e) => setLocal({ ...local, startFrom: e.target.value })} /></div>
        <div className="lp-field"><label>Début — à</label><input type="date" value={local.startTo} onChange={(e) => setLocal({ ...local, startTo: e.target.value })} /></div>
      </div>
      <div className="lp-row2">
        <div className="lp-field"><label>Fin — de</label><input type="date" value={local.endFrom} onChange={(e) => setLocal({ ...local, endFrom: e.target.value })} /></div>
        <div className="lp-field"><label>Fin — à</label><input type="date" value={local.endTo} onChange={(e) => setLocal({ ...local, endTo: e.target.value })} /></div>
      </div>
    </>
  );
}
function FiltersModal({ filters, setFilters, ctx, onClose }) {
  const local = filters;
  const setLocal = setFilters;
  const reset = () => setFilters(defaultFilters());

  return (
    <Modal title="Filtres" onClose={onClose} extraWide className="lp-filters-modal" footer={
      <>
        <button className="lp-btn" onClick={reset}>Réinitialiser</button>
        <button className="lp-btn lp-btn-primary" onClick={onClose}>Fermer</button>
      </>
    }>
      <FilterFieldsBody local={local} setLocal={setLocal} ctx={ctx} />
    </Modal>
  );
}

function GlobalMetaSearchModal({ tasks, taskArchive = [], ctx, onOpenTask, onRestoreArchived, onClose }) {
  const [query, setQuery] = useState("");
  const [filters, setFilters] = useState(() => defaultMetaFilters());
  const [filtersExpanded, setFiltersExpanded] = useState(false);
  const [searchFields, setSearchFields] = useState({
    title:true,
    project:true,
    status:true,
    description:true,
    assignee:true,
  });
  const inputRef = useRef(null);

  useEffect(() => {
    const timer = setTimeout(() => inputRef.current?.focus(), 0);
    return () => clearTimeout(timer);
  }, []);

  const norm = (v) => String(v == null ? "" : v)
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .toLowerCase();

  const projectName = (t) => {
    const p = (ctx.projects || []).find((x) => x.id === t.projectId);
    return p?.name || p?.title || "Sans projet";
  };
  const statusName = (t) => {
    const s = (ctx.statuses || []).find((x) => x.id === t.statusId);
    return s?.name || s?.label || "Sans statut";
  };

  const assigneeName = (t) => {
    const raw = t.assignee || t.responsible || t.assigneeId || t.responsibleId || "";
    if (!raw) return "";
    const people = [
      ...(ctx.members || []),
      ...(ctx.users || []),
      ...(ctx.assignees || []),
    ];
    const person = people.find((p) => p.id === raw || p.uid === raw || p.email === raw);
    return person?.name || person?.displayName || person?.email || raw;
  };

  // Recherche strictement limitée aux champs cochés par l'utilisateur.
  const globalHaystack = (t) => {
    const parts = [];
    if (searchFields.title) parts.push(t.title || "");
    if (searchFields.project) parts.push(projectName(t));
    if (searchFields.status) parts.push(statusName(t));
    if (searchFields.description) parts.push(t.desc || t.description || "");
    if (searchFields.assignee) parts.push(assigneeName(t));
    return norm(parts.join(" "));
  };

  const queryTerms = useMemo(
    () => norm(query).split(/\s+/).filter(Boolean),
    [query]
  );

  const searchableTasks = useMemo(() => [
    ...(tasks || []).map((t) => ({ ...t, __searchArchived:false })),
    ...(taskArchive || []).map((t) => ({ ...t, __searchArchived:true })),
  ], [tasks, taskArchive]);

  const results = useMemo(() => {
    return searchableTasks
      .filter((t) => {
        if (queryTerms.length) {
          const haystack = globalHaystack(t);
          if (!queryTerms.every((term) => haystack.includes(term))) return false;
        }
        // Le champ de recherche propre aux filtres reste vide : la zone principale
        // ci-dessus assure la recherche réellement globale sur tous les champs.
        const f = { ...filters, search: "" };
        return matchTaskFilters(t, f, ctx);
      })
      .sort((a, b) => {
        const ae = a.end || a.dueDate || "9999-12-31";
        const be = b.end || b.dueDate || "9999-12-31";
        return String(ae).localeCompare(String(be)) || String(a.title || "").localeCompare(String(b.title || ""));
      });
  }, [
    searchableTasks,
    ctx,
    filters,
    queryTerms.join("|"),
    searchFields.title,
    searchFields.project,
    searchFields.status,
    searchFields.description,
    searchFields.assignee,
  ]);

  const dateLabel = (v) => {
    if (!v) return "—";
    const d = new Date(String(v).length <= 10 ? `${v}T12:00:00` : v);
    if (Number.isNaN(d.getTime())) return String(v);
    return d.toLocaleDateString("fr-FR", { day:"2-digit", month:"2-digit", year:"numeric" });
  };

  const resetFilters = () => setFilters(defaultMetaFilters());
  const filterCount = activeFilterCount(filters);

  return (
    <Modal
      title="Méta-recherche globale"
      onClose={onClose}
      extraWide
      className="lp-global-meta-search"
      footer={
        <>
          <div style={{ marginRight:"auto", fontSize:11.5, color:"var(--text-600)" }}>
            {results.length} tâche{results.length > 1 ? "s" : ""} trouvée{results.length > 1 ? "s" : ""} · actives + archivées
          </div>
          <button className="lp-btn" onClick={onClose}>Fermer</button>
        </>
      }
    >
      <div style={{ display:"flex", flexDirection:"column", height:"min(76vh, 760px)", minHeight:520 }}>
        <div style={{
          flex:"0 0 auto",
          paddingBottom:14,
          borderBottom:"1px solid var(--border)",
          background:"var(--surface)",
          position:"relative",
          zIndex:2
        }}>
          <div className="lp-field" style={{ marginBottom:8 }}>
            <label>MÉTA-RECHERCHE</label>
            <div style={{ position:"relative" }}>
              <Search size={16} style={{ position:"absolute", left:12, top:"50%", transform:"translateY(-50%)", color:"var(--text-500)", pointerEvents:"none" }} />
              <input
                ref={inputRef}
                value={query}
                onChange={(e) => setQuery(e.target.value)}
                placeholder="Rechercher dans les champs sélectionnés…"
                style={{ width:"100%", height:42, paddingLeft:38, paddingRight:36, fontSize:14 }}
              />
              {!!query && (
                <button
                  type="button"
                  onClick={() => setQuery("")}
                  title="Effacer"
                  style={{ position:"absolute", right:8, top:"50%", transform:"translateY(-50%)", border:0, background:"transparent", cursor:"pointer", color:"var(--text-500)", padding:4 }}
                >
                  <X size={15}/>
                </button>
              )}
            </div>
          </div>

          <div style={{
            display:"flex",
            flexWrap:"wrap",
            alignItems:"center",
            gap:"6px 14px",
            marginBottom:10,
            padding:"2px 1px"
          }}>
            {[
              ["title","Titre"],
              ["project","Projet"],
              ["status","Statut"],
              ["description","Description"],
              ["assignee","Responsable"],
            ].map(([key,label]) => (
              <label
                key={key}
                style={{
                  display:"inline-flex",
                  alignItems:"center",
                  gap:6,
                  fontSize:11.5,
                  fontWeight:650,
                  color:"var(--text-700)",
                  cursor:"pointer",
                  userSelect:"none"
                }}
              >
                <input
                  type="checkbox"
                  checked={!!searchFields[key]}
                  onChange={(e) => setSearchFields((prev) => ({ ...prev, [key]:e.target.checked }))}
                  style={{ width:14, height:14, margin:0, accentColor:"var(--accent)" }}
                />
                {label}
              </label>
            ))}
          </div>

          <div style={{ display:"flex", alignItems:"center", gap:8 }}>
            <button
              className={"lp-btn" + (filterCount ? " lp-btn-primary" : "")}
              type="button"
              onClick={() => setFiltersExpanded((v) => !v)}
            >
              <Filter size={14}/> {filtersExpanded ? "Masquer les filtres" : "Ajouter des filtres"}
              {filterCount > 0 && <span style={{ marginLeft:4 }}>({filterCount})</span>}
            </button>
            {filterCount > 0 && (
              <button className="lp-btn" type="button" onClick={resetFilters}>Réinitialiser les filtres</button>
            )}
          </div>

          {filtersExpanded && (
            <div style={{
              marginTop:10,
              maxHeight:"31vh",
              overflowY:"auto",
              overflowX:"hidden",
              padding:"12px 14px",
              border:"1px solid var(--border)",
              borderRadius:8,
              background:"var(--paper-soft)"
            }}>
              <FilterFieldsBody local={filters} setLocal={setFilters} ctx={ctx} />
            </div>
          )}
        </div>

        <div style={{ flex:"1 1 auto", minHeight:0, overflowY:"auto", paddingTop:8 }}>
          <div style={{
            display:"grid",
            gridTemplateColumns:"minmax(240px, 1fr) minmax(130px, .42fr) minmax(120px, .38fr) 105px 105px",
            gap:10,
            alignItems:"center",
            position:"sticky",
            top:0,
            zIndex:1,
            padding:"7px 10px",
            background:"var(--surface)",
            borderBottom:"1px solid var(--border)",
            color:"var(--text-500)",
            fontSize:10.5,
            fontWeight:750,
            textTransform:"uppercase",
            letterSpacing:".035em"
          }}>
            <div>Tâche</div><div>Projet</div><div>Statut</div><div>Fin</div><div>Inactivité</div>
          </div>

          {results.length === 0 ? (
            <div style={{ padding:"34px 12px", textAlign:"center", color:"var(--text-500)", fontSize:12.5 }}>
              Aucune tâche ne correspond aux critères.
            </div>
          ) : results.map((t) => {
            const project = (ctx.projects || []).find((p) => p.id === t.projectId);
            const status = (ctx.statuses || []).find((s) => s.id === t.statusId);
            const inactivity = taskInteractionAgeDays(t);
            return (
              <button
                key={t.id}
                type="button"
                onClick={() => onOpenTask(t)}
                style={{
                  width:"100%",
                  display:"grid",
                  gridTemplateColumns:"minmax(240px, 1fr) minmax(130px, .42fr) minmax(120px, .38fr) 105px 105px",
                  gap:10,
                  alignItems:"center",
                  padding:"9px 10px",
                  border:0,
                  borderBottom:"1px solid var(--border)",
                  background:"transparent",
                  color:"inherit",
                  textAlign:"left",
                  cursor:"pointer",
                  fontFamily:"inherit"
                }}
                onMouseEnter={(e) => e.currentTarget.style.background = "var(--paper-soft)"}
                onMouseLeave={(e) => e.currentTarget.style.background = "transparent"}
              >
                <div style={{ minWidth:0, display:"flex", alignItems:"center", gap:7, fontSize:12.5, fontWeight:700, whiteSpace:"nowrap", overflow:"hidden" }} title={t.title || "Sans titre"}>
                  <span style={{overflow:"hidden",textOverflow:"ellipsis"}}>{t.title || "Sans titre"}</span>
                  {t.__searchArchived && (
                    <span style={{
                      flex:"0 0 auto", padding:"2px 5px", borderRadius:999,
                      fontSize:9.5, fontWeight:600, color:"var(--text-600)",
                      background:"var(--paper-soft)", border:"1px solid var(--border)"
                    }}>Archivée</span>
                  )}
                </div>
                <div style={{ minWidth:0, display:"flex", alignItems:"center", gap:7, fontSize:11.5, whiteSpace:"nowrap", overflow:"hidden", textOverflow:"ellipsis" }}>
                  <span style={{ width:8, height:8, flex:"0 0 auto", borderRadius:"50%", background:project?.color || "#94A3B8" }} />
                  <span style={{ overflow:"hidden", textOverflow:"ellipsis" }}>{projectName(t)}</span>
                </div>
                <div style={{ minWidth:0, display:"flex", alignItems:"center", gap:7, fontSize:11.5, whiteSpace:"nowrap", overflow:"hidden", textOverflow:"ellipsis" }}>
                  <span style={{ width:8, height:8, flex:"0 0 auto", borderRadius:"50%", background:status?.color || "#94A3B8" }} />
                  <span style={{ overflow:"hidden", textOverflow:"ellipsis" }}>{statusName(t)}</span>
                </div>
                <div style={{ fontFamily:"var(--font-mono)", fontSize:10.5 }}>{dateLabel(t.end || t.dueDate)}</div>
                <div style={{ fontFamily:"var(--font-mono)", fontSize:10.5, fontWeight:inactivity >= 14 ? 750 : 500 }}>
                  {inactivity} j
                </div>
              </button>
            );
          })}
        </div>
      </div>
    </Modal>
  );
}

// ============================================================================
// Modale Apparence
// ============================================================================

const BAR_SHAPES = [
  { key: "rounded", label: "Arrondi", radius: "6px" },
  { key: "square", label: "Rectangle", radius: "0px" },
  { key: "pill", label: "Pilule", radius: "20px" },
];
function AppearanceModal({ appearance, setAppearance, saveStatus, saveError, pushToast, onClose, embedded }) {
  const g = appearance.gradient;
  const set = (patch) => setAppearance((a) => ({ ...a, gradient: { ...a.gradient, ...patch } }));
  const setBarBg = (color) => setAppearance((a) => ({ ...a, barBg: color }));
  const barBg = appearance.barBg || "#C7CED9";
  const body = (
    <>
      <div className="lp-save-status">
        {saveStatus === "saving" && <span style={{ color: "var(--text-600)" }}>Enregistrement…</span>}
        {saveStatus === "saved" && <span style={{ color: "var(--success)" }}><Check size={13} style={{ verticalAlign: -2 }} /> Préférences enregistrées</span>}
        {saveStatus === "error" && (
          <span style={{ color: "var(--danger)" }}>
            <AlertTriangle size={13} style={{ verticalAlign: -2 }} /> Échec de l'enregistrement — {saveError || "vérifie ta connexion ou tes règles Firestore."}
          </span>
        )}
      </div>

      <div className="lp-checkbox-row">
        <input type="checkbox" id="grad" checked={g.enabled} onChange={(e) => set({ enabled: e.target.checked })} />
        <label htmlFor="grad" style={{ margin: 0, textTransform: "none", fontWeight: 500 }}>Dégradé sur les barres d'avancement (Liste, Gantt)</label>
      </div>
      <div className="lp-row2">
        <div className="lp-field"><label>Couleur de départ</label><input type="color" value={g.from} onChange={(e) => set({ from: e.target.value })} style={{ width: "100%", height: 36 }} /></div>
        <div className="lp-field"><label>Couleur d'arrivée</label><input type="color" value={g.to} onChange={(e) => set({ to: e.target.value })} style={{ width: "100%", height: 36 }} /></div>
      </div>

      <div className="lp-checkbox-row">
        <input type="checkbox" id="progByStatus" checked={!!appearance.progressColorByStatus} onChange={(e) => setAppearance((a) => ({ ...a, progressColorByStatus: e.target.checked }))} />
        <label htmlFor="progByStatus" style={{ margin: 0, textTransform: "none", fontWeight: 500 }}>Avancement coloré selon le statut de la tâche (au lieu du dégradé ci-dessus)</label>
      </div>
      <div className="lp-checkbox-row">
        <input type="checkbox" id="progTexture" checked={!!appearance.progressTexture} onChange={(e) => setAppearance((a) => ({ ...a, progressTexture: e.target.checked }))} />
        <label htmlFor="progTexture" style={{ margin: 0, textTransform: "none", fontWeight: 500 }}>Texture discrète (rayures) sur la barre d'avancement du Gantt</label>
      </div>

      <hr className="lp-divider" />
      <div className="lp-field">
        <label>Couleur de fond des barres du diagramme de Gantt</label>
        <input type="color" value={barBg} onChange={(e) => setBarBg(e.target.value)} style={{ width: "100%", height: 36 }} />
      </div>

      <hr className="lp-divider" />
      <div className="lp-section-title">Dégradé de la Heat map</div>
      <p style={{ fontSize: 12, color: "var(--text-600)", marginTop: -6, marginBottom: 8 }}>S'applique à la vue Heat map complète. Uniquement pour les jours sans retard — les jours en retard restent en dégradé rouge, pour rester un signal d'alerte reconnaissable. Le widget Heat map mensuelle colore désormais les jours par projet ; les jours en retard y gardent un contour rouge.</p>
      <div className="lp-row2">
        <div className="lp-field"><label>Couleur minimum (peu de tâches)</label><input type="color" value={appearance.heatmapMinColor || "#d4f0e4"} onChange={(e) => setAppearance((a) => ({ ...a, heatmapMinColor: e.target.value }))} style={{ width: "100%", height: 36 }} /></div>
        <div className="lp-field"><label>Couleur maximum (beaucoup de tâches)</label><input type="color" value={appearance.heatmapMaxColor || "#0f5c40"} onChange={(e) => setAppearance((a) => ({ ...a, heatmapMaxColor: e.target.value }))} style={{ width: "100%", height: 36 }} /></div>
      </div>

      <hr className="lp-divider" />
      <div className="lp-field">
        <label>Style des barres du diagramme de Gantt</label>
        <div className="lp-bar-shape-row">
          {BAR_SHAPES.map((sh) => (
            <button key={sh.key} className={"lp-bar-shape-btn" + (( appearance.barShape || "rounded") === sh.key ? " active" : "")} onClick={() => setAppearance((a) => ({ ...a, barShape: sh.key }))}>
              <span className="lp-bar-shape-preview" style={{ borderRadius: sh.radius }} />
              {sh.label}
            </button>
          ))}
        </div>
      </div>

      <hr className="lp-divider" />
      <div className="lp-checkbox-row">
        <input type="checkbox" id="autoText" checked={!appearance.ganttTextColor} onChange={(e) => setAppearance((a) => ({ ...a, ganttTextColor: e.target.checked ? null : "#FFFFFF" }))} />
        <label htmlFor="autoText" style={{ margin: 0, textTransform: "none", fontWeight: 500 }}>Couleur de police du Gantt automatique (contraste avec le fond)</label>
      </div>
      {appearance.ganttTextColor && (
        <div className="lp-field">
          <label>Couleur de police du Gantt</label>
          <input type="color" value={appearance.ganttTextColor} onChange={(e) => setAppearance((a) => ({ ...a, ganttTextColor: e.target.value }))} style={{ width: "100%", height: 36 }} />
        </div>
      )}

      <hr className="lp-divider" />
      <div className="lp-section-title">Couleur d'accent</div>
      <div className="lp-appearance-swatch-row">
        {ACCENT_PRESETS.map((c) => (
          <button key={c} className={"lp-appearance-swatch" + (appearance.accentColor === c ? " active" : "")} style={{ background: c }} onClick={() => setAppearance((a) => ({ ...a, accentColor: c }))} title={c} />
        ))}
        <input type="color" value={appearance.accentColor || "#FF7A3D"} onChange={(e) => setAppearance((a) => ({ ...a, accentColor: e.target.value }))} className="lp-appearance-swatch-custom" title="Couleur personnalisée" />
      </div>

      <hr className="lp-divider" />
      <div className="lp-section-title">Densité d'affichage</div>
      <div className="lp-density-row">
        {[["compact", "Compact"], ["comfortable", "Confortable"], ["spacious", "Spacieux"]].map(([k, l]) => (
          <button key={k} className={"lp-density-btn" + ((appearance.density || "comfortable") === k ? " active" : "")} onClick={() => setAppearance((a) => ({ ...a, density: k }))}>{l}</button>
        ))}
      </div>

      <hr className="lp-divider" />
      <div className="lp-section-title">Rayon des angles</div>
      <div className="lp-density-row">
        {[["sharp", "Anguleux"], ["normal", "Normal"], ["round", "Arrondi"]].map(([k, l]) => (
          <button key={k} className={"lp-density-btn" + ((appearance.radiusStyle || "sharp") === k ? " active" : "")} onClick={() => setAppearance((a) => ({ ...a, radiusStyle: k }))} style={{ borderRadius: RADIUS_SCALES[k].sm }}>{l}</button>
        ))}
      </div>

      <hr className="lp-divider" />
      <div className="lp-section-title">Logo personnalisé</div>
      <div style={{ display: "flex", alignItems: "center", gap: 12 }}>
        <div style={{ width: 40, height: 40, borderRadius: "var(--radius-sm)", overflow: "hidden", border: "1px solid var(--border)", flex: "0 0 auto", display: "flex", alignItems: "center", justifyContent: "center", background: "var(--paper-soft)" }}>
          <img src={appearance.logoDataUrl || NEXORA_ICON} alt="Logo" style={{ width: "100%", height: "100%", objectFit: "cover" }} />
        </div>
        <label className="lp-btn" style={{ cursor: "pointer" }}>
          Choisir une image
          <input type="file" accept="image/*" style={{ display: "none" }} onChange={(e) => {
            const file = e.target.files && e.target.files[0];
            if (!file) return;
            if (file.size > 800 * 1024) { pushToast({ message: "Image trop lourde (max ~800 Ko). Choisis une image plus légère ou compressée." }); return; }
            const reader = new FileReader();
            reader.onload = () => setAppearance((a) => ({ ...a, logoDataUrl: reader.result }));
            reader.readAsDataURL(file);
          }} />
        </label>
        {appearance.logoDataUrl && <button className="lp-btn" onClick={() => setAppearance((a) => ({ ...a, logoDataUrl: null }))}>Réinitialiser</button>}
      </div>

      <hr className="lp-divider" />
      <div className="lp-section-title">En-tête d'impression / export PDF</div>
      <p style={{ fontSize: 12, color: "var(--text-600)", marginTop: -6 }}>
        Utilisé quand tu exportes une vue en PDF (icône d'impression, en haut à droite) — pour arriver en réunion de chantier avec un document présentable plutôt qu'une capture d'écran brute. Réutilise le logo ci-dessus.
      </p>
      <div className="lp-checkbox-row">
        <input type="checkbox" id="exportHeader" checked={appearance.exportHeaderEnabled !== false} onChange={(e) => setAppearance((a) => ({ ...a, exportHeaderEnabled: e.target.checked }))} />
        <label htmlFor="exportHeader" style={{ margin: 0, textTransform: "none", fontWeight: 500 }}>Afficher un en-tête à l'impression/export</label>
      </div>
      {appearance.exportHeaderEnabled !== false && (
        <div className="lp-field">
          <label>Titre affiché dans l'en-tête</label>
          <input type="text" value={appearance.exportHeaderTitle || ""} onChange={(e) => setAppearance((a) => ({ ...a, exportHeaderTitle: e.target.value }))} placeholder="Ex. Chantier Lot 3 — Suivi hydroélectrique" />
        </div>
      )}

      <hr className="lp-divider" />
      <div className="lp-section-title">Palette des nouveaux projets</div>
      <div className="lp-density-row" style={{ flexWrap: "wrap" }}>
        {[["default", "Défaut"], ["pastel", "Pastel"], ["vivid", "Vive"], ["corporate", "Corporate"]].map(([k, l]) => (
          <button key={k} className={"lp-density-btn" + ((appearance.projectPalette || "default") === k ? " active" : "")} onClick={() => setAppearance((a) => ({ ...a, projectPalette: k }))}>
            <span style={{ display: "flex", gap: 2, marginRight: 6 }}>
              {PROJECT_PALETTES[k].slice(0, 4).map((c, i) => <span key={i} style={{ width: 9, height: 9, borderRadius: 3, background: c, display: "inline-block" }} />)}
            </span>
            {l}
          </button>
        ))}
      </div>

      <hr className="lp-divider" />
      <div className="lp-section-title">Style des jalons</div>
      <div className="lp-density-row" style={{ flexWrap: "wrap" }}>
        {Object.entries(MILESTONE_STYLES).map(([k, s]) => (
          <button key={k} className={"lp-density-btn" + ((appearance.milestoneStyle || "flag") === k ? " active" : "")} style={{ flex: "0 0 auto" }} onClick={() => setAppearance((a) => ({ ...a, milestoneStyle: k }))}>
            <IconGlyph icon={s.icon} size={13} style={{ marginRight: 5, verticalAlign: -2 }} />
            {s.label}
          </button>
        ))}
        <button className={"lp-density-btn" + (appearance.milestoneStyle === "custom" ? " active" : "")} style={{ flex: "0 0 auto" }} onClick={() => setAppearance((a) => ({ ...a, milestoneStyle: "custom" }))}>
          🖼️ Image personnalisée
        </button>
      </div>
      {appearance.milestoneStyle === "custom" && (
        <div className="lp-field" style={{ marginTop: 8 }}>
          <label>Lien de l'image (redimensionnée automatiquement)</label>
          <input type="text" value={appearance.milestoneCustomUrl || ""} onChange={(e) => setAppearance((a) => ({ ...a, milestoneCustomUrl: e.target.value }))} placeholder="https://..." />
          {appearance.milestoneCustomUrl && (
            <div style={{ marginTop: 8, display: "flex", alignItems: "center", gap: 8 }}>
              <span style={{ fontSize: 12, color: "var(--text-600)" }}>Aperçu :</span>
              <img src={appearance.milestoneCustomUrl} alt="" style={{ width: 20, height: 20, objectFit: "contain" }} />
            </div>
          )}
        </div>
      )}


      <hr className="lp-divider" />
      <div className="lp-section-title">Icônes des vues natives</div>
      <p style={{ fontSize: 12, color: "var(--text-600)", marginTop: -6, marginBottom: 10 }}>Personnalise les icônes des vues principales de Nexora. Le choix est enregistré dans tes préférences et s'applique partout dans l'interface.</p>
      <div style={{ display: "grid", gridTemplateColumns: "repeat(2,minmax(0,1fr))", gap: 8 }}>
        {ALL_VIEWS_META.map((v) => (
          <div key={v.key} style={{ display: "flex", alignItems: "center", justifyContent: "space-between", gap: 8, padding: "7px 8px", border: "1px solid var(--border)", borderRadius: "var(--radius-sm)", background: "var(--surface)" }}>
            <span style={{ display: "flex", alignItems: "center", gap: 7, fontSize: 12.5, fontWeight: 600, minWidth: 0 }}><IconGlyph icon={appearance.viewIcons?.[v.key] || v.iconKey} size={15} /> <span style={{ overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" }}>{v.label}</span></span>
            <IconEditor icon={appearance.viewIcons?.[v.key] || v.iconKey} setIcon={(val) => setAppearance((a) => ({ ...a, viewIcons: { ...(a.viewIcons || {}), [v.key]: val || v.iconKey } }))} />
          </div>
        ))}
      </div>

      <hr className="lp-divider" />
      <div className="lp-section-title">Style du tronc commun (tâches à deux projets)</div>
      <p style={{ fontSize: 12.5, color: "var(--text-600)", marginTop: -6, marginBottom: 10 }}>
        En vue Métro, comment afficher la portion partagée d'une tâche entre deux projets.
      </p>
      <div className="lp-density-row" style={{ flexWrap: "wrap" }}>
        <button className={"lp-density-btn" + ((appearance.sharedTrunkStyle || "gradient") === "gradient" ? " active" : "")} style={{ flex: "0 0 auto" }} onClick={() => setAppearance((a) => ({ ...a, sharedTrunkStyle: "gradient" }))}>
          🌈 Dégradé fondu
        </button>
        <button className={"lp-density-btn" + (appearance.sharedTrunkStyle === "braid" ? " active" : "")} style={{ flex: "0 0 auto" }} onClick={() => setAppearance((a) => ({ ...a, sharedTrunkStyle: "braid" }))}>
          🧵 Torsade
        </button>
      </div>

      <hr className="lp-divider" />
      <div className="lp-section-title">Aperçu du diagramme</div>
      <div style={{ background: "#EAEDF3", borderRadius: 10, padding: 14, display: "flex", flexDirection: "column", gap: 8 }}>
        {[{ w: 68, pct: 65, label: "Revue DOE · 65%" }, { w: 42, pct: 30, label: "PV Contrôles · 30%" }].map((row, i) => (
          <div key={i} style={{ position: "relative", height: 22, borderRadius: 6, background: barBg, overflow: "hidden", width: `${row.w}%` }}>
            <div style={{ position: "absolute", left: 0, top: 0, bottom: 0, width: `${row.pct}%`, background: g.enabled ? `linear-gradient(90deg, ${g.from}, ${g.to})` : "#C7CED9" }} />
            <div style={{ position: "relative", zIndex: 1, color: appearance.ganttTextColor || (luminance(barBg) > 0.5 ? "#151313" : "#fff"), fontSize: 11, fontWeight: 600, padding: "0 8px", lineHeight: "22px", whiteSpace: "nowrap", overflow: "hidden", textOverflow: "ellipsis" }}>{row.label}</div>
          </div>
        ))}
      </div>
    </>
  );
  if (embedded) return <div className="lp-settings-pane">{body}</div>;
  return <Modal title="Apparence" onClose={onClose} footer={<button className="lp-btn lp-btn-primary" onClick={onClose}>Fermer</button>}>{body}</Modal>;
}

// ============================================================================
// Réglages — Animations
// ============================================================================
function AnimationSettingsPane({ appearance, setAppearance, saveStatus, saveError }) {
  const metroAnimations = [
    { key: "animTodayPulse", icon: <CalendarClock size={15} />, title: 'Pulsation "Aujourd’hui"', desc: "Un halo discret respire autour de la ligne du jour et le repère supérieur pulse légèrement." },
    { key: "animTrainFlow", icon: <TrainTrack size={15} />, title: "Train circulant sur les lignes", desc: "Un point lumineux parcourt en continu chaque ligne de projet active." },
    { key: "animLateAlert", icon: <AlertTriangle size={15} />, title: "Halo pulsé sur les retards", desc: "Un anneau d’alerte s’étend autour des stations en retard." },
    { key: "animLineDraw", icon: <Waypoints size={15} />, title: "Tracé progressif au chargement", desc: "Les lignes se dessinent progressivement à l’ouverture de la carte." },
    { key: "animSharedShimmer", icon: <Wand2 size={15} />, title: "Reflet sur les tâches partagées", desc: "Un reflet discret parcourt le tronc commun des tâches liées à deux projets." },
  ];
  const appAnimations = [
    { key: "animCheckPop", icon: <CheckCircle2 size={15} />, title: "Validation de tâche", desc: "Petit pop élastique et coche dessinée lors de la complétion." },
    { key: "animConfetti", icon: <Milestone size={15} />, title: "Fin de projet", desc: "Brève célébration quand un projet atteint 100 %." },
    { key: "animCountUp", icon: <Activity size={15} />, title: "Chiffres qui comptent", desc: "Les indicateurs montent depuis zéro à leur apparition." },
    { key: "animBarFill", icon: <BarChart3 size={15} />, title: "Barres qui se remplissent", desc: "Les barres de progression animent leur remplissage au chargement." },
    { key: "animCardLift", icon: <LayoutDashboard size={15} />, title: "Élévation au survol", desc: "Les cartes et widgets gagnent une légère profondeur au survol." },
    { key: "animTabSlide", icon: <SlidersHorizontal size={15} />, title: "Indicateur d’onglet", desc: "Le trait actif glisse d’un onglet à l’autre." },
    { key: "animCascade", icon: <Layers size={15} />, title: "Cascade des widgets", desc: "Les widgets apparaissent successivement à l’ouverture d’un tableau de bord." },
    { key: "animSkeleton", icon: <RefreshCw size={15} />, title: "Squelette de chargement", desc: "Des blocs animés remplacent l’indicateur simple pendant le chargement." },
  ];

  const renderRows = (items) => items.map((a) => (
    <label
      key={a.key}
      className="lp-checkbox-row"
      style={{
        padding:"10px",
        alignItems:"flex-start",
        border:"1px solid var(--border)",
        borderRadius:"var(--radius)",
        background:"var(--surface)",
        marginBottom:6
      }}
    >
      <input
        type="checkbox"
        checked={!!appearance[a.key]}
        onChange={(e) => setAppearance((prev) => ({ ...prev, [a.key]: e.target.checked }))}
        style={{ marginTop:3 }}
      />
      <span style={{ display:"flex", gap:9, minWidth:0, textTransform:"none" }}>
        <span style={{ color:"var(--line-blue)", marginTop:1, flex:"0 0 auto" }}>{a.icon}</span>
        <span>
          <span style={{ fontWeight:650, display:"block", color:"var(--text-primary)" }}>{a.title}</span>
          <span style={{ fontWeight:400, fontSize:12, lineHeight:1.45, color:"var(--text-600)" }}>{a.desc}</span>
        </span>
      </span>
    </label>
  ));

  return (
    <div className="lp-settings-pane">
      <div className="lp-save-status">
        {saveStatus === "saving" && <span style={{ color:"var(--text-600)" }}>Enregistrement…</span>}
        {saveStatus === "saved" && <span style={{ color:"var(--success)" }}><Check size={13} style={{ verticalAlign:-2 }} /> Préférences enregistrées</span>}
        {saveStatus === "error" && <span style={{ color:"var(--danger)" }}><AlertTriangle size={13} style={{ verticalAlign:-2 }} /> Échec de l’enregistrement — {saveError || "vérifie ta connexion ou tes règles Firestore."}</span>}
      </div>

      <div className="lp-section-title">Vue Métro</div>
      <p style={{ fontSize:12.5, color:"var(--text-600)", marginTop:-6, marginBottom:10 }}>
        Animations propres au langage cartographique de Nexora. Elles sont indépendantes et désactivées par défaut.
      </p>
      {renderRows(metroAnimations)}

      <hr className="lp-divider" />
      <div className="lp-section-title">Ensemble de l’application</div>
      <p style={{ fontSize:12.5, color:"var(--text-600)", marginTop:-6, marginBottom:10 }}>
        Micro-interactions et transitions générales de l’interface.
      </p>
      {renderRows(appAnimations)}

      <div style={{ marginTop:14, padding:"9px 11px", borderLeft:"3px solid var(--line-blue)", background:"var(--paper-soft)", fontSize:11.5, lineHeight:1.45, color:"var(--text-600)" }}>
        Si « Réduire les animations » est activé au niveau du système ou du navigateur, certaines animations peuvent être neutralisées pour l’accessibilité.
      </div>
    </div>
  );
}

// ============================================================================
// Réglages — hub unique : projets, statuts, apparence, vues affichées, données
// ============================================================================
const SETTINGS_TABS = [
  { key: "projects", label: "Projets", icon: "folder" },
  { key: "statuses", label: "Statuts", icon: "settings" },
  { key: "taskTypes", label: "Types", icon: "tag" },
  { key: "users", label: "Utilisateurs", icon: "user" },
  { key: "customFields", label: "Champs personnalisés", icon: "hash" },
  { key: "syncedCalendars", label: "Calendriers synchronisés", icon: "calendar" },
  { key: "chatgpt", label: "ChatGPT", icon: "sparkles" },
  { key: "gcal", label: "Google Calendar", icon: "calendar" },
  { key: "metaFilters", label: "Méta-filtres", icon: "filter" },
  { key: "metaBlocks", label: "Méta blocs temporels", icon: "chart-gantt" },
  { key: "appearance", label: "Apparence", icon: "palette" },
  { key: "animations", label: "Animations", icon: "sparkles" },
  { key: "shortcuts", label: "Raccourcis", icon: "keyboard" },
  { key: "views", label: "Vues affichées", icon: "layers" },
  { key: "data", label: "Données", icon: "upload" },
];

function ShortcutSettingsPane({ shortcutPrefs, setShortcutPrefs }) {
  const defs = [
    { key: "addTask", label: "Ajouter une tâche", defaultValue: "Ctrl+Alt+N" },
    { key: "addMeetingTask", label: "Ajouter une tâche de type Réunion (jalon)", defaultValue: "Ctrl+Shift+R" },
    { key: "addPlanningTask", label: "Ajouter une tâche de type Planning", defaultValue: "Ctrl+Shift+P" },
    { key: "saveNow", label: "Enregistrer maintenant", defaultValue: "Ctrl+Shift+S" },
    { key: "zoomDay", label: "Mettre le planning en mode jour", defaultValue: "Ctrl+Alt+J" },
    { key: "zoomWeek", label: "Mettre le planning en mode semaine", defaultValue: "Ctrl+Alt+W" },
    { key: "toggleDeadlineMode", label: "Basculer Métro normal / Échéances", defaultValue: "Ctrl+Alt+S" },
    { key: "goToday", label: "Revenir à aujourd'hui", defaultValue: "Ctrl+Alt+T" },
    { key: "openLocalFilters", label: "Ouvrir les filtres locaux", defaultValue: "Ctrl+Alt+F" },
    { key: "openMetaFilters", label: "Ouvrir les méta-filtres", defaultValue: "Ctrl+Shift+F" },
    { key: "openGlobalSearch", label: "Ouvrir la méta-recherche globale", defaultValue: "Ctrl+Shift+K" },
    { key: "markdownChecklist", label: "Insérer une checkbox Markdown", defaultValue: "Ctrl+Space" },
    { key: "markdownPreviewToggle", label: "Basculer Markdown Modifier / Aperçu", defaultValue: "Ctrl+ArrowLeft" },
    { key: "createWidget", label: "Créer un widget", defaultValue: "Ctrl+Shift+W" },
    { key: "zoomMonth", label: "Mettre le planning en mode mois", defaultValue: "Ctrl+Alt+M" },
    { key: "zoomAuto", label: "Mettre le planning en mode automatique", defaultValue: "Ctrl+Alt+A" },
  ];
  const formatKey = (e) => {
    const mods = [];
    if (e.ctrlKey) mods.push("Ctrl");
    if (e.metaKey) mods.push("Cmd");
    if (e.altKey) mods.push("Alt");
    if (e.shiftKey) mods.push("Shift");
    let key = e.key;
    if (["Control", "Alt", "Shift", "Meta"].includes(key)) return null;
    if (key === " ") key = "Space";
    if (key.length === 1) key = key.toUpperCase();
    return [...mods, key].join("+");
  };
  return (
    <div className="lp-settings-pane">
      <div className="lp-section-title">Raccourcis clavier</div>
      <p style={{ fontSize: 12.5, color: "var(--text-600)", marginTop: -6, marginBottom: 16 }}>Cliquez dans un champ puis appuyez sur la combinaison souhaitée. Les raccourcis sont enregistrés pour votre compte.</p>
      <div style={{ display: "grid", gap: 8 }}>
        {defs.map((d) => (
          <div key={d.key} style={{ display: "grid", gridTemplateColumns: "1fr 220px 90px", alignItems: "center", gap: 14, padding: "10px 12px", border: "1px solid var(--border)", borderRadius: 8, background: "var(--surface)" }}>
            <div style={{ fontSize: 12.5, fontWeight: 650 }}>{d.label}</div>
            <input value={shortcutPrefs[d.key] || ""} placeholder={d.defaultValue} readOnly onKeyDown={(e) => { e.preventDefault(); if (e.key === "Backspace" || e.key === "Delete") { setShortcutPrefs((p) => ({ ...p, [d.key]: "" })); return; } const combo = formatKey(e); if (combo) setShortcutPrefs((p) => ({ ...p, [d.key]: combo })); }} style={{ fontFamily: "var(--font-mono)", fontSize: 12, fontWeight: 700, textAlign: "center" }} />
            <button className="lp-btn" type="button" onClick={() => setShortcutPrefs((p) => ({ ...p, [d.key]: d.defaultValue }))}>Défaut</button>
          </div>
        ))}
      </div>
      <p style={{ fontSize: 11.5, color: "var(--text-600)", marginTop: 14 }}>Les raccourcis avec Ctrl+Alt sont utilisés par défaut pour éviter les conflits avec les raccourcis réservés du navigateur.</p>
    </div>
  );
}

// Réglages > Méta blocs temporels. Même mécanique de liste que les sections
// d'annotations du Mini-Gantt (lp-gantt-annot-*) : rien de nouveau à styler.
function MetaTemporalBlocksSettingsPane({ metaTemporalBlocks, setMetaTemporalBlocks, dashboards }) {
  const [editingId, setEditingId] = useState(null);
  const [pendingDelete, setPendingDelete] = useState(null);
  const list = Array.isArray(metaTemporalBlocks) ? metaTemporalBlocks : [];
  const allIds = dashboards.map((d) => d.id);
  const patch = (id, values) => setMetaTemporalBlocks(list.map((b) => (b.id === id ? { ...b, ...values } : b)));
  const move = (id, dir) => {
    const i = list.findIndex((b) => b.id === id);
    const j = i + dir;
    if (i < 0 || j < 0 || j >= list.length) return;
    const next = [...list];
    [next[i], next[j]] = [next[j], next[i]];
    setMetaTemporalBlocks(next);
  };
  const add = () => {
    const today = iso(new Date());
    // dashboardIds absent = tous les tableaux de bord, y compris ceux à venir :
    // c'est ce que « tous cochés » veut dire à la création.
    const created = { id: uid(), title: "Congés", startDate: today, endDate: addDays(today, 14), kind: "phase", color: GANTT_BLOCK_DEFAULT_COLOR, borderStyle: "dashed", dashboardIds: null };
    setMetaTemporalBlocks([...list, created]);
    setEditingId(created.id);
  };
  const duplicate = (block) => {
    const copy = { ...block, id: uid(), title: `${block.title} (copie)`, dashboardIds: block.dashboardIds ? [...block.dashboardIds] : null };
    const i = list.findIndex((b) => b.id === block.id);
    setMetaTemporalBlocks([...list.slice(0, i + 1), copy, ...list.slice(i + 1)]);
    setEditingId(copy.id);
  };
  const toggleDashboard = (block, dashboardId) => {
    const current = block.dashboardIds === null || block.dashboardIds === undefined ? allIds : block.dashboardIds;
    const next = current.includes(dashboardId) ? current.filter((x) => x !== dashboardId) : [...current, dashboardId];
    // Tous cochés à nouveau : on repasse à « tous », pour que les tableaux de
    // bord créés plus tard héritent du bloc au lieu d'en être exclus.
    const isAll = allIds.length > 0 && allIds.every((id) => next.includes(id));
    patch(block.id, { dashboardIds: isAll ? null : next });
  };
  const scopeLabel = (block) => {
    if (block.dashboardIds === null || block.dashboardIds === undefined) return "Tous les tableaux de bord";
    const kept = block.dashboardIds.filter((id) => allIds.includes(id));
    if (!kept.length) return "Aucun tableau de bord";
    return `${kept.length} tableau${kept.length > 1 ? "x" : ""} de bord`;
  };

  return (
    <div className="lp-settings-pane">
      <div className="lp-section-title">Méta blocs temporels</div>
      <p style={{ fontSize: 12.5, color: "var(--text-600)", marginTop: -6, marginBottom: 12, lineHeight: 1.5 }}>
        Une période définie une seule fois ici et dessinée dans les Mini-Gantt des tableaux de bord retenus — congés, absences,
        fermeture de site, gel de production. Les blocs propres à un widget restent indépendants : les deux se dessinent.
      </p>
      <div style={{ display: "flex", flexDirection: "column", gap: 10 }}>
        {list.map((block) => {
          const validation = validateTemporalBlock(block);
          const editing = editingId === block.id;
          const checkedIds = block.dashboardIds === null || block.dashboardIds === undefined ? allIds : block.dashboardIds;
          return (
            <div className={"lp-gantt-annot-item" + (editing ? " editing" : "")} key={block.id}>
              <div className="lp-gantt-annot-head" onClick={() => setEditingId(editing ? null : block.id)}>
                <span className="lp-gantt-annot-swatch" style={{ background: block.color, borderStyle: block.borderStyle }} />
                <span className="lp-gantt-annot-summary">
                  <strong>{block.title || "Sans titre"}{block.kind === "decision" ? " · décision" : ""}</strong>
                  <span>
                    {isGanttIsoDate(block.startDate) ? fmtShort(block.startDate) : "—"} → {isGanttIsoDate(block.endDate) ? fmtShort(block.endDate) : "—"} · {scopeLabel(block)}
                  </span>
                </span>
                {!validation.ok && <AlertTriangle size={12} color="var(--danger)" />}
                <span className="lp-gantt-annot-actions" onClick={(e) => e.stopPropagation()}>
                  <button type="button" className="lp-icon-btn" onClick={() => move(block.id, -1)} disabled={list[0]?.id === block.id} title="Monter"><ChevronUp size={12} /></button>
                  <button type="button" className="lp-icon-btn" onClick={() => move(block.id, 1)} disabled={list[list.length - 1]?.id === block.id} title="Descendre"><ChevronDown size={12} /></button>
                  <button type="button" className="lp-icon-btn" onClick={() => duplicate(block)} title="Dupliquer"><Copy size={12} /></button>
                  <button type="button" className="lp-icon-btn" onClick={() => setPendingDelete(block)} title="Supprimer"><Trash2 size={12} /></button>
                </span>
              </div>
              {editing && (
                <div className="lp-gantt-annot-form">
                  <div className="lp-field">
                    <label>Titre</label>
                    <input type="text" value={block.title} onChange={(e) => patch(block.id, { title: e.target.value })} placeholder="Congés, fermeture de site…" />
                  </div>
                  <div className="lp-row2">
                    <div className="lp-field">
                      <label>Début</label>
                      <input type="date" value={block.startDate || ""} onChange={(e) => patch(block.id, { startDate: e.target.value })} />
                    </div>
                    <div className="lp-field">
                      <label>Fin</label>
                      <input type="date" value={block.endDate || ""} onChange={(e) => patch(block.id, { endDate: e.target.value })} />
                    </div>
                  </div>
                  {!validation.ok && <p className="lp-gantt-annot-error">{validation.error}</p>}
                  <div className="lp-field">
                    <label>Tableaux de bord concernés</label>
                    <DropdownButton label={scopeLabel(block)} icon={<LayoutDashboard size={13} />} title="Choisir les tableaux de bord">
                      {dashboards.length === 0 && <div className="lp-dropdown-group-label">Aucun tableau de bord</div>}
                      {dashboards.map((d) => (
                        <label className="lp-checkbox-line" key={d.id}>
                          <input type="checkbox" checked={checkedIds.includes(d.id)} onChange={() => toggleDashboard(block, d.id)} /> {d.name}
                        </label>
                      ))}
                    </DropdownButton>
                    <p className="lp-gantt-annot-hint">
                      {block.dashboardIds === null || block.dashboardIds === undefined
                        ? "Tous cochés : les tableaux de bord créés plus tard recevront aussi ce bloc."
                        : "Sélection explicite : un tableau de bord créé plus tard ne recevra pas ce bloc."}
                    </p>
                  </div>
                  <div className="lp-field">
                    <label>Nature</label>
                    <div className="lp-density-row">
                      <button type="button" className={"lp-density-btn" + (block.kind !== "decision" ? " active" : "")} onClick={() => patch(block.id, { kind: "phase" })}>Phase</button>
                      <button type="button" className={"lp-density-btn" + (block.kind === "decision" ? " active" : "")} onClick={() => patch(block.id, { kind: "decision", color: block.color || GANTT_DECISION_DEFAULT_COLOR })}>Fenêtre de décision</button>
                    </div>
                  </div>
                  <div className="lp-field">
                    <label>Bordure</label>
                    <div className="lp-density-row">
                      <button type="button" className={"lp-density-btn" + (block.borderStyle !== "solid" ? " active" : "")} onClick={() => patch(block.id, { borderStyle: "dashed" })}>Pointillés</button>
                      <button type="button" className={"lp-density-btn" + (block.borderStyle === "solid" ? " active" : "")} onClick={() => patch(block.id, { borderStyle: "solid" })}>Continue</button>
                    </div>
                  </div>
                  <div className="lp-field">
                    <label>Couleur</label>
                    <ColorPicker value={block.color || GANTT_BLOCK_DEFAULT_COLOR} onChange={(color) => patch(block.id, { color })} />
                  </div>
                </div>
              )}
            </div>
          );
        })}
        <button type="button" className="lp-btn lp-gantt-annot-add" onClick={add}><Plus size={13} /> Ajouter un méta bloc temporel</button>
      </div>
      {pendingDelete && (
        <ConfirmModal
          title="Supprimer le méta bloc temporel"
          message={`Supprimer « ${pendingDelete.title || "Sans titre"} » ? Il disparaîtra de tous les Mini-Gantt concernés. Les tâches ne sont pas modifiées.`}
          danger confirmLabel="Supprimer"
          onConfirm={() => { setMetaTemporalBlocks(list.filter((b) => b.id !== pendingDelete.id)); setPendingDelete(null); }}
          onClose={() => setPendingDelete(null)}
        />
      )}
    </div>
  );
}

function MetaFiltersSettingsPane({ metaFilters, setMetaFilters, ctx }) {
  const count = activeFilterCount(metaFilters);
  const reset = () => setMetaFilters(defaultMetaFilters());
  return (
    <div className="lp-settings-pane">
      <div className="lp-section-title">Méta-filtres globaux</div>
      <p style={{ fontSize: 12.5, color: "var(--text-600)", marginTop: -6, marginBottom: 10, lineHeight: 1.5 }}>
        Ces filtres constituent le socle de Nexora : ils sont appliqués automatiquement avant les filtres propres à chaque vue,
        tableau de bord, widget ou vue enregistrée. Ils restent actifs lors des changements de vue et ne sont pas remplacés par un filtre local.
      </p>
      <div style={{ display:"flex", alignItems:"center", gap:8, marginBottom:14, padding:"9px 10px", border:"1px solid var(--border)", borderRadius:"var(--radius)", background:"var(--paper-soft)" }}>
        <Filter size={14} />
        <strong style={{ fontSize:12.5 }}>{count} méta-filtre{count > 1 ? "s" : ""} actif{count > 1 ? "s" : ""}</strong>
        <span style={{ fontSize:11.5, color:"var(--text-600)" }}>· appliqué partout</span>
        <button className="lp-btn" type="button" onClick={reset} style={{ marginLeft:"auto" }}>Réinitialiser</button>
      </div>

      <div className="lp-filter-section" style={{ marginBottom: 12 }}>
        <div className="lp-section-title">Visibilité globale</div>
        <label className="lp-checkbox-row" style={{ padding:"6px 0" }}>
          <input
            type="checkbox"
            checked={metaFilters.showDone !== false}
            onChange={(e) => setMetaFilters((f) => ({ ...f, showDone: e.target.checked }))}
          />
          <span style={{ textTransform:"none", fontWeight:500 }}>Inclure les tâches terminées</span>
        </label>
        <label className="lp-checkbox-row" style={{ padding:"6px 0" }}>
          <input
            type="checkbox"
            checked={!!metaFilters.urgentOnly}
            onChange={(e) => setMetaFilters((f) => ({ ...f, urgentOnly: e.target.checked }))}
          />
          <span style={{ textTransform:"none", fontWeight:500 }}>Afficher uniquement les tâches de criticité urgente</span>
        </label>
      </div>

      <FilterFieldsBody local={metaFilters} setLocal={setMetaFilters} ctx={ctx} />

      <div style={{ marginTop:16, padding:"10px 12px", borderLeft:"3px solid var(--line-blue)", background:"color-mix(in srgb, var(--line-blue) 5%, var(--surface))", fontSize:11.5, lineHeight:1.5, color:"var(--text-600)" }}>
        Exemple : si un méta-filtre limite Nexora à un dossier, un projet ou une période, les filtres de chaque vue ne pourront agir
        que sur ce sous-ensemble. Les écrans de réglages et d'administration conservent volontairement l'accès aux données complètes.
      </div>
    </div>
  );
}


function MarkdownImportModal({ projects, setProjects, statuses, setStatuses, taskTypes, setTasks, onClose, pushToast, palette }) {
  const today = iso(new Date());

  const normalize = (s) => String(s || "")
    .normalize("NFD").replace(/[\u0300-\u036f]/g, "")
    .trim().toLowerCase();

  const existingInbox = projects.find((p) => normalize(p.name) === "inbox");
  const existingPlanStatus =
    statuses.find((s) => /^a\s*planifier$/.test(normalize(s.name))) ||
    statuses.find((s) => /planifier/.test(normalize(s.name)));

  const DEFAULT_PROJECT = existingInbox?.id || "__create_inbox__";
  const DEFAULT_STATUS = existingPlanStatus?.id || "__create_plan__";

  const [items, setItems] = useState([]);
  const [reading, setReading] = useState(false);
  const [batchProjectId, setBatchProjectId] = useState(DEFAULT_PROJECT);
  const [batchStatusId, setBatchStatusId] = useState(DEFAULT_STATUS);

  const titleFromMarkdown = (name, content) => {
    const firstHeading = String(content || "").split(/\r?\n/).find((line) => /^\s*#\s+/.test(line));
    if (firstHeading) return firstHeading.replace(/^\s*#\s+/, "").trim() || name.replace(/\.(md|markdown)$/i, "");
    return name.replace(/\.(md|markdown)$/i, "").replace(/[-_]+/g, " ").trim();
  };

  const loadFiles = async (fileList) => {
    const files = [...(fileList || [])].filter((f) => /\.(md|markdown)$/i.test(f.name));
    if (!files.length) {
      pushToast?.({ message:"Sélectionnez au moins un fichier .md ou .markdown." });
      return;
    }
    setReading(true);
    try {
      const loaded = [];
      for (const file of files) {
        const content = await file.text();
        loaded.push({
          id: uid(),
          fileName:file.name,
          title:titleFromMarkdown(file.name, content),
          content,
          date:today,
          projectId:batchProjectId,
          statusId:batchStatusId,
        });
      }
      setItems((prev) => [...prev, ...loaded]);
    } finally {
      setReading(false);
    }
  };

  const updateItem = (id, patch) => setItems((prev) => prev.map((x) => x.id === id ? { ...x, ...patch } : x));
  const removeItem = (id) => setItems((prev) => prev.filter((x) => x.id !== id));

  const applyAll = (field, value) => {
    if (field === "projectId") setBatchProjectId(value);
    if (field === "statusId") setBatchStatusId(value);
    setItems((prev) => prev.map((x) => ({ ...x, [field]:value })));
  };

  const doImport = () => {
    if (!items.length) return;

    // Les valeurs par défaut demandées sont garanties même si l'utilisateur n'a
    // jamais créé "Inbox" ou "À planifier" auparavant.
    let inbox = existingInbox;
    let planned = existingPlanStatus;
    if (!inbox && items.some((x) => x.projectId === "__create_inbox__")) {
      inbox = {
        id:uid(), name:"Inbox",
        color:(palette && palette[0]) || "#2C6BE0",
        icon:null, folderId:DEFAULT_UNSORTED_FOLDER_ID,
      };
      setProjects((prev) => [...prev, inbox]);
    }
    if (!planned && items.some((x) => x.statusId === "__create_plan__")) {
      planned = { id:uid(), name:"À planifier", color:"#F59E0B", icon:null };
      setStatuses((prev) => [...prev, planned]);
    }

    const now = new Date().toISOString();
    const created = items.map((x) => {
      const projectId = x.projectId === "__create_inbox__" ? inbox?.id : x.projectId;
      const statusId = x.statusId === "__create_plan__" ? planned?.id : x.statusId;
      const date = x.date || today;

      // Un Markdown ne fournit qu'une date. Action et Jalon restent à date unique.
      // Pour une Activité, cette date est son début et une durée minimale d'un jour
      // est créée afin de respecter l'invariant Activité = début + fin.
      const start = date;
      const end = date;

      return {
        id:uid(),
        title:(x.title || x.fileName || "Markdown").trim(),
        desc:x.content || "",
        projectId:projectId || inbox?.id || projects[0]?.id || null,
        secondaryProjectId:null,
        statusId:statusId || planned?.id || statuses[0]?.id || null,
        taskTypeId:getDefaultTaskTypeForProject(taskTypes, projects, projectId || inbox?.id || projects[0]?.id)?.id || null,
        milestone:false,
        start,
        end,
        progress:0,
        assignee:"",
        checklist:[],
        dependsOn:[],
        recurrence:null,
        customFields:{},
        attachments:[],
        lastInteraction:now,
        markdownSourceFile:x.fileName,
      };
    });

    setTasks((prev) => [...prev, ...created]);
    pushToast?.({ message:`${created.length} Markdown${created.length > 1 ? "s" : ""} importé${created.length > 1 ? "s" : ""}.` });
    onClose();
  };

  return (
    <Modal
      title="Importer des Markdown"
      onClose={onClose}
      extraWide
      className="lp-markdown-import-modal"
      footer={
        <>
          <button className="lp-btn" onClick={onClose}>Annuler</button>
          <button className="lp-btn lp-btn-primary" disabled={!items.length || reading} onClick={doImport}>
            <FileUp size={13} style={{marginRight:5,verticalAlign:-2}} />Importer {items.length || ""}
          </button>
        </>
      }
    >
      <div style={{
        border:"1px dashed var(--border-strong)", background:"var(--paper-soft)",
        padding:"14px", borderRadius:"var(--radius)", marginBottom:14
      }}>
        <div style={{display:"flex",alignItems:"center",gap:10,flexWrap:"wrap"}}>
          <FileText size={20} color="var(--line-blue)" />
          <div style={{flex:"1 1 260px"}}>
            <div style={{fontWeight:780,fontSize:13}}>Ajouter un ou plusieurs fichiers Markdown</div>
            <div style={{fontSize:10.5,color:"var(--text-muted)",marginTop:2}}>
              Le contenu intégral du fichier est placé dans la Description. Le premier titre <code>#</code> devient le titre de la tâche ; sinon Nexora utilise le nom du fichier.
            </div>
          </div>
          <label className="lp-btn lp-btn-primary" style={{cursor:"pointer"}}>
            <FileUp size={13} style={{marginRight:5}} />{reading ? "Lecture…" : "Choisir les Markdown"}
            <input type="file" accept=".md,.markdown,text/markdown,text/plain" multiple hidden disabled={reading} onChange={(e) => { loadFiles(e.target.files); e.target.value=""; }} />
          </label>
        </div>
      </div>

      <div className="lp-section-title">Valeurs communes</div>
      <div style={{fontSize:10.5,color:"var(--text-muted)",marginBottom:8}}>
        Ces réglages s'appliquent aux nouveaux fichiers. Le bouton « Appliquer à tous » met également à jour tous les Markdown déjà chargés.
      </div>

      <div className="lp-md-common-grid">
        <div className="lp-field" style={{margin:0}}>
          <label>Projet</label>
          <div style={{display:"flex",gap:5}}>
            <select value={batchProjectId} onChange={(e) => setBatchProjectId(e.target.value)} style={{minWidth:0}}>
              {!existingInbox && <option value="__create_inbox__">Inbox (créé automatiquement)</option>}
              {sortedByName(projects).map((p) => <option key={p.id} value={p.id}>{p.name}</option>)}
            </select>
            <button className="lp-btn" type="button" onClick={() => applyAll("projectId", batchProjectId)}>Tous</button>
          </div>
        </div>

        <div className="lp-field" style={{margin:0}}>
          <label>Statut</label>
          <div style={{display:"flex",gap:5}}>
            <select value={batchStatusId} onChange={(e) => setBatchStatusId(e.target.value)} style={{minWidth:0}}>
              {!existingPlanStatus && <option value="__create_plan__">À planifier (créé automatiquement)</option>}
              {sortedByName(statuses).map((s) => <option key={s.id} value={s.id}>{s.name}</option>)}
            </select>
            <button className="lp-btn" type="button" onClick={() => applyAll("statusId", batchStatusId)}>Tous</button>
          </div>
        </div>
      </div>

      {items.length === 0 ? (
        <div className="lp-empty" style={{padding:28}}>
          Aucun Markdown chargé. Sans modification de votre part, les valeurs utilisées seront :
          <strong> aujourd'hui · Inbox · À planifier</strong>.
        </div>
      ) : (
        <>
          <hr className="lp-divider" />
          <div className="lp-section-title">Markdown par Markdown</div>
          <div className="lp-md-import-list">
            {items.map((x,index) => (
              <div key={x.id} className="lp-md-import-row">
                <div className="lp-field lp-md-title-field" style={{margin:0,minWidth:0}}>
                  <label>{index + 1}. Titre</label>
                  <div className="lp-md-filename" title={x.fileName}>{x.fileName}</div>
                  <input value={x.title} onChange={(e) => updateItem(x.id,{title:e.target.value})} />
                </div>
                <div className="lp-field" style={{margin:0}}>
                  <label>Date</label>
                  <input type="date" value={x.date || today} onChange={(e) => updateItem(x.id,{date:e.target.value || today})} />
                </div>
                <div className="lp-field" style={{margin:0}}>
                  <label>Projet</label>
                  <select value={x.projectId} onChange={(e) => updateItem(x.id,{projectId:e.target.value})}>
                    {!existingInbox && <option value="__create_inbox__">Inbox</option>}
                    {sortedByName(projects).map((p) => <option key={p.id} value={p.id}>{p.name}</option>)}
                  </select>
                </div>

                <div className="lp-field" style={{margin:0}}>
                  <label>Statut</label>
                  <select value={x.statusId} onChange={(e) => updateItem(x.id,{statusId:e.target.value})}>
                    {!existingPlanStatus && <option value="__create_plan__">À planifier</option>}
                    {sortedByName(statuses).map((s) => <option key={s.id} value={s.id}>{s.name}</option>)}
                  </select>
                </div>
                <button className="lp-icon-btn lp-md-remove" onClick={() => removeItem(x.id)} title="Retirer ce fichier"><X size={14}/></button>
              </div>
            ))}
          </div>
          <div style={{fontSize:10,color:"var(--text-muted)",marginTop:8}}>
            Pour une Activité, la date choisie devient la date de début et Nexora crée une durée initiale de 1 jour, modifiable ensuite normalement.
          </div>
        </>
      )}
    </Modal>
  );
}


function ChatGPTCaptureSettingsPane(){
  const browserOrigin = (typeof window !== "undefined" && window.location.protocol !== "file:") ? window.location.origin : "";
  const savedPublicUrl = (() => {
    try { return localStorage.getItem("nexora:publicCaptureUrl") || ""; } catch(e) { return ""; }
  })();
  const [publicUrl, setPublicUrl] = useState(savedPublicUrl || browserOrigin);

  const normalizedUrl = (publicUrl || "").trim().replace(/\/+$/, "");
  const validPublicUrl = /^https?:\/\/[^ ]+$/i.test(normalizedUrl);
  const baseUrl = validPublicUrl ? normalizedUrl : "https://VOTRE-NEXORA.netlify.app";

  useEffect(() => {
    try {
      if (validPublicUrl) localStorage.setItem("nexora:publicCaptureUrl", normalizedUrl);
    } catch(e) {}
  }, [normalizedUrl, validPublicUrl]);

  const template = `${baseUrl}/?nexoraCapture=1&title=TITRE&desc=DESCRIPTION&due=AAAA-MM-JJ&project=Inbox&sourceUrl=URL_DU_MAIL&sourceMessageId=ID_DU_MAIL`;
  const prompt = `Quand tu analyses mes emails et qu’un mail nécessite une action, propose-moi la tâche Nexora avec :
- un titre court et actionnable ;
- une échéance seulement si elle est explicitement déductible du mail ;
- un résumé très court dans la description ;
- le projet Inbox par défaut ;
- le lien vers le mail original si tu l’as.

Pour chaque recommandation, génère aussi un lien cliquable vers Nexora en utilisant ce format :
${baseUrl}/?nexoraCapture=1&title=<titre URL-encodé>&desc=<description URL-encodée>&due=<AAAA-MM-JJ si connue>&project=Inbox&sourceUrl=<URL du mail URL-encodée>&sourceMessageId=<ID si disponible>

Ne crée pas automatiquement la tâche : le lien doit ouvrir Nexora avec la fiche préremplie pour que je valide avant enregistrement.`;

  const copy = async (text) => {
    try { await navigator.clipboard.writeText(text); }
    catch(e) {
      const ta=document.createElement("textarea"); ta.value=text; document.body.appendChild(ta); ta.select(); document.execCommand("copy"); ta.remove();
    }
  };

  return (
    <div className="lp-settings-pane">
      <div className="lp-section-title">ChatGPT → Nexora</div>
      <p style={{fontSize:12.5,color:"var(--text-600)",marginTop:-6,lineHeight:1.55}}>
        ChatGPT peut analyser tes mails dans ChatGPT puis générer un lien de capture Nexora.
        Un clic ouvre la fiche de tâche préremplie : rien n’est créé avant ta validation.
      </p>

      <div className="lp-section-title" style={{marginTop:12}}>URL publique de Nexora</div>
      <div className="lp-field">
        <label>Adresse HTTPS utilisée dans les liens ChatGPT</label>
        <input
          type="url"
          value={publicUrl}
          onChange={e=>setPublicUrl(e.target.value)}
          placeholder="https://ton-nexora.netlify.app"
        />
      </div>
      {!validPublicUrl && (
        <div style={{marginTop:6,padding:"9px 11px",borderLeft:"3px solid #d97706",background:"var(--paper-soft)",fontSize:11.5,lineHeight:1.45,color:"var(--text-600)"}}>
          Renseigne l’URL HTTPS de Nexora déployé sur Netlify. Un fichier ouvert directement en <code>file://</code> ne peut pas servir de destination fiable pour les liens générés par ChatGPT.
        </div>
      )}

      <div className="lp-section-title" style={{marginTop:14}}>URL de capture</div>
      <div style={{display:"flex",gap:8,alignItems:"center"}}>
        <input readOnly value={template} style={{flex:1,fontFamily:"ui-monospace,SFMono-Regular,Menlo,monospace",fontSize:10.5}}/>
        <button className="lp-btn" onClick={()=>copy(template)}><Copy size={13}/> Copier</button>
      </div>

      <div className="lp-section-title" style={{marginTop:14}}>Instruction à donner à ChatGPT</div>
      <textarea readOnly value={prompt} rows={13} style={{width:"100%",resize:"vertical",fontSize:11.5,lineHeight:1.5}} />
      <div style={{display:"flex",justifyContent:"flex-end",marginTop:8}}>
        <button className="lp-btn lp-btn-primary" onClick={()=>copy(prompt)} disabled={!validPublicUrl}>
          <Copy size={13}/> Copier l’instruction
        </button>
      </div>

      <div style={{marginTop:12,padding:"10px 12px",borderLeft:"3px solid var(--line-blue)",background:"var(--paper-soft)",fontSize:11.5,lineHeight:1.5,color:"var(--text-600)"}}>
        Cette méthode ne synchronise pas Gmail dans Nexora. ChatGPT analyse le mail ; Nexora ne reçoit que la proposition que tu choisis d’ouvrir.
      </div>
    </div>
  );
}


function TaskArchiveSettingsPane({ tasks, taskArchive, projects, statuses, onArchiveOldCompleted, onArchiveTasks, onRestore, onDeleteForever }) {
  const FIRESTORE_DOC_LIMIT = 1048576;
  const [daysThreshold, setDaysThreshold] = useState(180);
  const [archiveOpen, setArchiveOpen] = useState(false);
  const [archiveQuery, setArchiveQuery] = useState("");
  const [selectedArchived, setSelectedArchived] = useState([]);

  const currentSize = useMemo(() => JSON.stringify(tasks).length, [tasks]);
  const pct = Math.min(100, Math.round((currentSize / FIRESTORE_DOC_LIMIT) * 100));
  const gaugeColor = pct >= 90 ? "var(--danger)" : pct >= 70 ? "#d97706" : "var(--success)";

  // Classement des tâches les plus lourdes en octets JSON, avec le champ qui
  // pèse le plus dans chacune (généralement la description). Sert à repérer
  // précisément le coupable quand ce n'est pas l'ancienneté qui explique la
  // taille du document (par ex. une seule tâche active avec une description
  // démesurée peut peser plus que 500 tâches normales).
  const [heaviestOpen, setHeaviestOpen] = useState(true);
  const heaviestTasks = useMemo(() => {
    return tasks
      .map((t) => {
        const total = JSON.stringify(t).length;
        const descLen = JSON.stringify(t.desc || t.description || "").length;
        const checklistLen = JSON.stringify(t.checklist || []).length;
        const otherLen = Math.max(0, total - descLen - checklistLen);
        const parts = [
          { label:"description", len:descLen },
          { label:"checklist", len:checklistLen },
          { label:"autres champs", len:otherLen },
        ].sort((a, b) => b.len - a.len);
        return { task:t, total, dominant:parts[0] };
      })
      .sort((a, b) => b.total - a.total)
      .slice(0, 15);
  }, [tasks]);

  const filteredArchive = archiveQuery.trim()
    ? taskArchive.filter((t) => (t.title || "").toLowerCase().includes(archiveQuery.trim().toLowerCase()))
    : taskArchive;

  const toggleSelected = (id) => setSelectedArchived((prev) => (prev.includes(id) ? prev.filter((x) => x !== id) : [...prev, id]));

  // ---------------------------------------------------------------------
  // Archivage manuel : filtre global + sélection multiple + archivage en
  // masse, en complément de l'archivage automatique par ancienneté
  // ci-dessus. Donne un contrôle total sur QUELLES tâches actives partent
  // dans l'archive, quel que soit leur statut ou leur date de complétion.
  const [manualOpen, setManualOpen] = useState(false);
  const [manualQuery, setManualQuery] = useState("");
  const [manualProjectId, setManualProjectId] = useState("");
  const [manualStatusId, setManualStatusId] = useState("");
  const [manualDoneOnly, setManualDoneOnly] = useState(false);
  const [manualSelected, setManualSelected] = useState([]);

  const manualFilteredTasks = useMemo(() => {
    const q = manualQuery.trim().toLowerCase();
    return tasks.filter((t) => {
      if (q && !(t.title || "").toLowerCase().includes(q)) return false;
      if (manualProjectId && t.projectId !== manualProjectId) return false;
      if (manualStatusId && t.statusId !== manualStatusId) return false;
      if (manualDoneOnly) {
        const statusName = (statuses.find((s) => s.id === t.statusId)?.name || "");
        if (!/termin/i.test(statusName)) return false;
      }
      return true;
    });
  }, [tasks, manualQuery, manualProjectId, manualStatusId, manualDoneOnly, statuses]);

  // La sélection ne garde que des ids toujours visibles dans le filtre actuel
  // — change de filtre ne doit pas archiver par surprise une tâche qu'on ne
  // voit plus à l'écran.
  const manualVisibleIds = useMemo(() => new Set(manualFilteredTasks.map((t) => t.id)), [manualFilteredTasks]);
  const manualSelectedVisible = manualSelected.filter((id) => manualVisibleIds.has(id));

  const toggleManualSelected = (id) => setManualSelected((prev) => (prev.includes(id) ? prev.filter((x) => x !== id) : [...prev, id]));
  const manualSelectAllVisible = () => setManualSelected((prev) => [...new Set([...prev, ...manualFilteredTasks.map((t) => t.id)])]);
  const manualDeselectAllVisible = () => setManualSelected((prev) => prev.filter((id) => !manualVisibleIds.has(id)));

  const manualArchiveSelection = () => {
    if (manualSelectedVisible.length === 0) return;
    onArchiveTasks(manualSelectedVisible);
    setManualSelected((prev) => prev.filter((id) => !manualVisibleIds.has(id)));
  };

  return (
    <>
      <div className="lp-section-title">Fiabilité de la sauvegarde</div>
      <div style={{ fontSize:11.5, color:"var(--text-600)", lineHeight:1.5, marginBottom:8 }}>
        <strong>nexora:tasks</strong> est le document le plus lourd de l'appli — au-delà de 1 048 576 octets (la limite d'un document Firestore), chaque sauvegarde échoue. La jauge ci-dessous montre où tu en es en ce moment.
      </div>
      <div style={{ display:"flex", alignItems:"center", gap:10, marginBottom:4 }}>
        <div style={{ flex:1, height:8, borderRadius:4, background:"var(--border)", overflow:"hidden" }}>
          <div style={{ width:`${pct}%`, height:"100%", background:gaugeColor, transition:"width .2s ease" }} />
        </div>
        <span style={{ fontSize:11.5, fontWeight:700, color:gaugeColor, flex:"0 0 auto" }}>{pct}%</span>
      </div>
      <div style={{ fontSize:11, color:"var(--text-600)", marginBottom:12 }}>
        {currentSize.toLocaleString("fr-FR")} / {FIRESTORE_DOC_LIMIT.toLocaleString("fr-FR")} octets · {tasks.length} tâche{tasks.length > 1 ? "s" : ""} en cours
        {taskArchive.length > 0 && <> · {taskArchive.length} archivée{taskArchive.length > 1 ? "s" : ""}</>}
      </div>

      <button className="lp-btn" onClick={() => setHeaviestOpen((v) => !v)} style={{ marginBottom:8 }}>
        {heaviestOpen ? "Masquer" : "Voir"} les tâches les plus lourdes
      </button>
      {heaviestOpen && (
        <div style={{ border:"1px solid var(--border)", borderRadius:"var(--radius-sm)", padding:8, marginBottom:14, maxHeight:320, overflowY:"auto" }}>
          <div style={{ fontSize:11, color:"var(--text-600)", padding:"2px 4px 8px" }}>
            Si la taille ne vient pas de l'ancienneté, elle vient presque toujours d'une poignée de descriptions très longues. Voici les 15 tâches (actives) les plus lourdes, avec le champ responsable.
          </div>
          {heaviestTasks.map(({ task:t, total, dominant }) => {
            const project = projects.find((p) => p.id === t.projectId);
            return (
              <div key={t.id} style={{ display:"flex", alignItems:"center", gap:8, padding:"6px 4px", borderTop:"1px solid var(--border)" }}>
                <span style={{ flex:1, minWidth:0 }}>
                  <div style={{ fontSize:12.5, fontWeight:600, overflow:"hidden", textOverflow:"ellipsis", whiteSpace:"nowrap" }}>{t.title || "(sans titre)"}</div>
                  <div style={{ fontSize:10.5, color:"var(--text-600)" }}>
                    {project?.name || "Sans projet"} · surtout : {dominant.label} ({dominant.len.toLocaleString("fr-FR")} oct.)
                  </div>
                </span>
                <span style={{ fontSize:12, fontWeight:700, color: total > 30000 ? "var(--danger)" : "var(--text-600)", flex:"0 0 auto" }}>
                  {(total / 1024).toFixed(1)} Ko
                </span>
              </div>
            );
          })}
          {heaviestTasks.length === 0 && <div style={{ fontSize:12, color:"var(--text-600)", padding:8 }}>Aucune tâche.</div>}
        </div>
      )}

      <div style={{ display:"flex", alignItems:"center", gap:8, flexWrap:"wrap" }}>
        <span style={{ fontSize:12 }}>Archiver les tâches terminées depuis plus de</span>
        <input
          type="number"
          min={1}
          max={3650}
          value={daysThreshold}
          onChange={(e) => setDaysThreshold(Math.max(1, Math.min(3650, Number(e.target.value) || 1)))}
          style={{ width:72 }}
        />
        <span style={{ fontSize:12 }}>jours</span>
        <button className="lp-btn lp-btn-primary" onClick={() => onArchiveOldCompleted(daysThreshold)}>
          <Archive size={13} style={{ marginRight:4, verticalAlign:-2 }} />Archiver maintenant
        </button>
      </div>
      <div style={{ fontSize:11, color:"var(--text-600)", marginTop:4 }}>
        Rien n'est supprimé : les tâches archivées sortent de <strong>nexora:tasks</strong> vers un document séparé, et restent consultables et restaurables ci-dessous à tout moment.
      </div>

      <hr className="lp-divider" style={{ margin: "14px 0" }} />

      <div style={{ display:"flex", alignItems:"center", justifyContent:"space-between", marginBottom: manualOpen ? 8 : 0 }}>
        <div className="lp-section-title" style={{ marginBottom:0 }}>Archivage manuel</div>
        <button className="lp-btn" onClick={() => setManualOpen((v) => !v)}>{manualOpen ? "Masquer" : "Choisir des tâches à archiver"}</button>
      </div>

      {manualOpen && (
        <div style={{ border:"1px solid var(--border)", borderRadius:"var(--radius-sm)", padding:10, marginTop:4 }}>
          <div style={{ fontSize:11, color:"var(--text-600)", marginBottom:8 }}>
            Filtre les tâches actives ci-dessous, coche celles à archiver, puis archive-les en une fois — quel que soit leur statut ou leur ancienneté.
          </div>

          <div style={{ display:"flex", gap:8, flexWrap:"wrap", marginBottom:8 }}>
            <input
              placeholder="Rechercher par titre…"
              value={manualQuery}
              onChange={(e) => setManualQuery(e.target.value)}
              style={{ flex:1, minWidth:160 }}
            />
            <select value={manualProjectId} onChange={(e) => setManualProjectId(e.target.value)} style={{ minWidth:140 }}>
              <option value="">Tous les projets</option>
              {projects.map((p) => <option key={p.id} value={p.id}>{p.name}</option>)}
            </select>
            <select value={manualStatusId} onChange={(e) => setManualStatusId(e.target.value)} style={{ minWidth:140 }}>
              <option value="">Tous les statuts</option>
              {statuses.map((s) => <option key={s.id} value={s.id}>{s.name}</option>)}
            </select>
            <label className="lp-checkbox-line" style={{ fontSize:12, display:"flex", alignItems:"center", gap:6 }}>
              <input type="checkbox" checked={manualDoneOnly} onChange={(e) => setManualDoneOnly(e.target.checked)} />
              Terminées uniquement
            </label>
          </div>

          <div style={{ display:"flex", alignItems:"center", gap:8, marginBottom:8, flexWrap:"wrap" }}>
            <span style={{ fontSize:11, color:"var(--text-600)" }}>
              {manualFilteredTasks.length} tâche{manualFilteredTasks.length > 1 ? "s" : ""} affichée{manualFilteredTasks.length > 1 ? "s" : ""}
              {manualSelectedVisible.length > 0 && <> · {manualSelectedVisible.length} sélectionnée{manualSelectedVisible.length > 1 ? "s" : ""}</>}
            </span>
            <button className="lp-btn" disabled={!manualFilteredTasks.length} onClick={manualSelectAllVisible}>Tout sélectionner</button>
            <button className="lp-btn" disabled={!manualSelectedVisible.length} onClick={manualDeselectAllVisible}>Tout désélectionner</button>
            <button className="lp-btn lp-btn-primary" disabled={!manualSelectedVisible.length} onClick={manualArchiveSelection} style={{ marginLeft:"auto" }}>
              <Archive size={13} style={{ marginRight:4, verticalAlign:-2 }} />Archiver la sélection ({manualSelectedVisible.length})
            </button>
          </div>

          <div style={{ maxHeight:320, overflowY:"auto", border:"1px solid var(--border)", borderRadius:"var(--radius-sm)" }}>
            {manualFilteredTasks.length === 0 && (
              <div style={{ fontSize:12, color:"var(--text-600)", padding:10 }}>Aucune tâche active ne correspond à ce filtre.</div>
            )}
            {manualFilteredTasks.map((t) => {
              const project = projects.find((p) => p.id === t.projectId);
              const status = statuses.find((s) => s.id === t.statusId);
              const checked = manualSelected.includes(t.id);
              return (
                <label
                  key={t.id}
                  style={{ display:"flex", alignItems:"center", gap:8, padding:"7px 8px", borderTop:"1px solid var(--border)", cursor:"pointer" }}
                >
                  <input type="checkbox" checked={checked} onChange={() => toggleManualSelected(t.id)} />
                  <span style={{ flex:1, minWidth:0, overflow:"hidden", textOverflow:"ellipsis", whiteSpace:"nowrap", fontSize:12.5 }}>
                    {t.title || "(sans titre)"}
                  </span>
                  <span style={{ fontSize:10.5, color:"var(--text-600)", flexShrink:0 }}>
                    {project?.name || "Sans projet"}{status ? ` · ${status.name}` : ""}
                  </span>
                </label>
              );
            })}
          </div>
        </div>
      )}

      {taskArchive.length > 0 && (
        <div style={{ marginTop:12 }}>
          <button className="lp-btn" onClick={() => setArchiveOpen((v) => !v)}>
            {archiveOpen ? "Masquer" : "Voir"} les {taskArchive.length} tâche{taskArchive.length > 1 ? "s" : ""} archivée{taskArchive.length > 1 ? "s" : ""}
          </button>
          {archiveOpen && (
            <div style={{ marginTop:8, border:"1px solid var(--border)", borderRadius:"var(--radius-sm)", padding:10 }}>
              <div style={{ display:"flex", gap:8, marginBottom:8, flexWrap:"wrap" }}>
                <input
                  placeholder="Rechercher dans les archives…"
                  value={archiveQuery}
                  onChange={(e) => setArchiveQuery(e.target.value)}
                  style={{ flex:1, minWidth:160 }}
                />
                {selectedArchived.length > 0 && (
                  <>
                    <button className="lp-btn lp-btn-primary" onClick={() => { onRestore(selectedArchived); setSelectedArchived([]); }}>
                      Restaurer ({selectedArchived.length})
                    </button>
                    <button className="lp-btn lp-btn-danger" onClick={() => { onDeleteForever(selectedArchived); setSelectedArchived([]); }}>
                      Supprimer pour de bon ({selectedArchived.length})
                    </button>
                  </>
                )}
              </div>
              <div style={{ maxHeight:260, overflowY:"auto", display:"flex", flexDirection:"column", gap:2 }}>
                {filteredArchive.length === 0 && <div style={{ fontSize:12, color:"var(--text-600)", padding:8 }}>Aucun résultat.</div>}
                {filteredArchive.map((t) => {
                  const project = projects.find((p) => p.id === t.projectId);
                  return (
                    <label key={t.id} className="lp-checkbox-line" style={{ padding:"5px 4px", borderRadius:6 }}>
                      <input type="checkbox" checked={selectedArchived.includes(t.id)} onChange={() => toggleSelected(t.id)} />
                      <span style={{ flex:1, fontSize:12.5, display:"flex", flexDirection:"column" }}>
                        <span>{t.title}</span>
                        <span style={{ fontSize:10.5, color:"var(--text-600)" }}>
                          {project?.name || "Sans projet"} · archivée le {t.archivedAt ? new Date(t.archivedAt).toLocaleDateString("fr-FR") : "?"}
                        </span>
                      </span>
                      <button className="lp-icon-btn" title="Restaurer" onClick={(e) => { e.preventDefault(); onRestore([t.id]); }}><RotateCcw size={13} /></button>
                    </label>
                  );
                })}
              </div>
            </div>
          )}
        </div>
      )}
    </>
  );
}


function FullBackupSettingsPane({ onExportBackup, onRestoreBackup, pushToast, snapshotIndex, onRestoreSnapshot, snapshotBusy }) {
  const [candidate, setCandidate] = useState(null);
  const [mode, setMode] = useState("merge");
  const [busy, setBusy] = useState(false);
  const [error, setError] = useState("");

  const escapeCsvCell = (value) => {
    const text = String(value ?? "");
    return `"${text.replace(/"/g,'""')}"`;
  };

  const parseBackupCsv = (text) => {
    const lines = String(text || "").split(/\r?\n/).filter(Boolean);
    if (!lines.length) throw new Error("CSV vide.");
    const header = lines[0];
    if (!/nexoraKey/i.test(header) || !/nexoraJson/i.test(header)) {
      throw new Error("Ce CSV n'est pas une sauvegarde complète Nexora.");
    }

    const parseLine = (line) => {
      const out = [];
      let cur = "", quoted = false;
      for (let i=0;i<line.length;i++) {
        const ch=line[i];
        if (quoted) {
          if (ch === '"' && line[i+1] === '"') { cur+='"'; i++; }
          else if (ch === '"') quoted=false;
          else cur+=ch;
        } else {
          if (ch === '"') quoted=true;
          else if (ch === ",") { out.push(cur); cur=""; }
          else cur+=ch;
        }
      }
      out.push(cur);
      return out;
    };

    const payload = {};
    for (let i=1;i<lines.length;i++) {
      const cols = parseLine(lines[i]);
      if (cols.length < 2) continue;
      const key = cols[0];
      const raw = cols.slice(1).join(",");
      if (!key) continue;
      payload[key] = JSON.parse(raw);
    }

    return {
      format:"nexora-full-backup",
      version:1,
      exportedAt:null,
      payload,
      importedFromCsv:true,
    };
  };

  const readFile = async (file) => {
    setError("");
    setCandidate(null);
    if (!file) return;

    try {
      const text = await file.text();
      let parsed;
      if (/\.csv$/i.test(file.name)) {
        parsed = parseBackupCsv(text);
      } else {
        parsed = JSON.parse(text);
      }

      if (!parsed || parsed.format !== "nexora-full-backup" || !parsed.payload || typeof parsed.payload !== "object") {
        throw new Error("Format de sauvegarde Nexora invalide.");
      }

      const keys = Object.keys(parsed.payload);
      if (!keys.length) throw new Error("La sauvegarde ne contient aucune donnée.");

      setCandidate({
        fileName:file.name,
        backup:parsed,
        keyCount:keys.length,
        taskCount:Array.isArray(parsed.payload["nexora:tasks"]) ? parsed.payload["nexora:tasks"].length : null,
        archivedCount:Array.isArray(parsed.payload["nexora:taskArchive"]) ? parsed.payload["nexora:taskArchive"].length : null,
        projectCount:Array.isArray(parsed.payload["nexora:projects"]) ? parsed.payload["nexora:projects"].length : null,
      });
    } catch (e) {
      setError((e&&e.message)||String(e));
    }
  };

  const restore = async () => {
    if (!candidate?.backup) return;
    setBusy(true);
    setError("");
    try {
      await onRestoreBackup(candidate.backup, mode);
    } catch (e) {
      setError((e&&e.message)||String(e));
      setBusy(false);
    }
  };

  return (
    <div className="lp-full-backup-pane">
      <div className="lp-section-title">Sauvegarde complète anti-perte</div>
      <p className="lp-full-backup-intro">
        Cette sauvegarde contient les tâches actives et archivées, projets, statuts, dossiers, tableaux de bord,
        vues, widgets, champs personnalisés, budgets, dépenses, risques, automatisations, historiques, réglages
        et autres données persistées Nexora. Les secrets d'authentification ne sont pas exportés.
      </p>

      <div className="lp-full-backup-grid">
        <div className="lp-full-backup-card">
          <div className="lp-full-backup-card-title"><ShieldCheck size={15}/> Exporter maintenant</div>
          <div className="lp-full-backup-card-copy">
            JSON est le format recommandé pour une restauration exacte. Le CSV contient les mêmes données,
            une ligne par clé Nexora, avec le JSON intégral de chaque valeur.
          </div>
          <div className="lp-full-backup-actions">
            <button className="lp-btn lp-btn-primary" disabled={busy} onClick={()=>onExportBackup("json")}>
              <Download size={13}/> Sauvegarde JSON complète
            </button>
            <button className="lp-btn" disabled={busy} onClick={()=>onExportBackup("csv")}>
              <Download size={13}/> Archive CSV complète
            </button>
          </div>
        </div>

        <div className="lp-full-backup-card">
          <div className="lp-full-backup-card-title"><RotateCcw size={15}/> Restaurer une sauvegarde</div>
          <div className="lp-full-backup-card-copy">
            Avant toute restauration, Nexora crée automatiquement une sauvegarde de sécurité de l'état actuel.
          </div>
          <label className="lp-btn" style={{cursor:"pointer",width:"fit-content"}}>
            <FileUp size={13}/> Choisir un JSON ou CSV
            <input
              type="file"
              hidden
              accept=".json,.csv,application/json,text/csv"
              onChange={(e)=>{readFile(e.target.files?.[0]); e.target.value="";}}
            />
          </label>

          {candidate && (
            <div className="lp-full-backup-preview">
              <div><strong>{candidate.fileName}</strong></div>
              <div>
                {candidate.keyCount} clé{candidate.keyCount>1?"s":""}
                {candidate.projectCount!=null ? ` · ${candidate.projectCount} projets` : ""}
                {candidate.taskCount!=null ? ` · ${candidate.taskCount} tâches actives` : ""}
                {candidate.archivedCount!=null ? ` · ${candidate.archivedCount} tâches archivées` : ""}
              </div>
              {candidate.backup.exportedAt && (
                <div>Créée le {new Date(candidate.backup.exportedAt).toLocaleString("fr-FR")}</div>
              )}
            </div>
          )}

          {candidate && (
            <>
              <div className="lp-full-backup-mode">
                <label>
                  <input type="radio" name="backup-mode" checked={mode==="merge"} onChange={()=>setMode("merge")}/>
                  <span>
                    <strong>Fusion non destructive</strong>
                    <small>Récupère les éléments manquants sans écraser les éléments actuels portant le même ID.</small>
                  </span>
                </label>
                <label>
                  <input type="radio" name="backup-mode" checked={mode==="replace"} onChange={()=>setMode("replace")}/>
                  <span>
                    <strong>Restauration exacte</strong>
                    <small>Remplace les données présentes dans la sauvegarde par leur version sauvegardée.</small>
                  </span>
                </label>
              </div>
              <button className="lp-btn lp-btn-primary" disabled={busy} onClick={restore}>
                <RotateCcw size={13}/> {busy ? "Restauration…" : mode==="merge" ? "Fusionner la sauvegarde" : "Restaurer exactement"}
              </button>
            </>
          )}

          {error && <div className="lp-full-backup-error">{error}</div>}
        </div>
      </div>

      <SnapshotHistoryCard snapshotIndex={snapshotIndex} onRestoreSnapshot={onRestoreSnapshot} snapshotBusy={snapshotBusy} pushToast={pushToast} />

      <div className="lp-full-backup-note">
        <strong>Conseil :</strong> conserve régulièrement une copie JSON hors de Nexora (Drive, OneDrive, iCloud ou disque local).
        Le JSON est autonome : il ne dépend pas de Firebase pour être relu.
      </div>
    </div>
  );
}

// Historique de versions : filet de sécurité indépendant du moteur de sync en
// direct. Un instantané tâches+projets est écrit automatiquement toutes les
// ~20 minutes d'activité (voir maybeSnapshotTasksProjects dans LePlan),
// conservé même si tout le reste échoue.
function SnapshotHistoryCard({ snapshotIndex, onRestoreSnapshot, snapshotBusy, pushToast }) {
  const [confirmingId, setConfirmingId] = useState(null);
  const [confirmMode, setConfirmMode] = useState("merge");

  useEffect(() => {
    if (!confirmingId) return;
    const t = setTimeout(() => setConfirmingId(null), 5000);
    return () => clearTimeout(t);
  }, [confirmingId]);

  const list = Array.isArray(snapshotIndex) ? snapshotIndex : [];

  const doRestore = async (entry) => {
    setConfirmingId(null);
    try {
      await onRestoreSnapshot(entry, confirmMode);
    } catch (e) {
      pushToast?.({ message: "Échec de la restauration : " + ((e && e.message) || String(e)), duration: 9000 });
    }
  };

  return (
    <div className="lp-full-backup-card" style={{ marginTop: 14 }}>
      <div className="lp-full-backup-card-title"><History size={15} /> Historique de versions</div>
      <div className="lp-full-backup-card-copy">
        Instantané automatique des tâches et projets toutes les ~20 minutes d'activité (jusqu'à {50} versions conservées).
        Indépendant de la synchronisation en direct : utile même si un problème de sync survenait ailleurs.
      </div>
      {!list.length && (
        <div className="lp-full-backup-preview">Aucun instantané pour l'instant — le premier sera créé automatiquement lors de la prochaine sauvegarde de tâches.</div>
      )}
      {!!list.length && (
        <div className="lp-snapshot-list">
          {list.map((entry) => (
            <div key={entry.id} className="lp-snapshot-row">
              <div className="lp-snapshot-row-info">
                <strong>{new Date(entry.at).toLocaleString("fr-FR")}</strong>
                <span>{entry.taskCount} tâche{entry.taskCount > 1 ? "s" : ""} · {entry.projectCount} projet{entry.projectCount > 1 ? "s" : ""}</span>
              </div>
              {confirmingId === entry.id ? (
                <div className="lp-snapshot-confirm">
                  <select value={confirmMode} onChange={(e) => setConfirmMode(e.target.value)}>
                    <option value="merge">Fusion non destructive</option>
                    <option value="replace">Restauration exacte</option>
                  </select>
                  <button className="lp-btn lp-btn-primary" disabled={snapshotBusy} onClick={() => doRestore(entry)}>
                    {snapshotBusy ? "…" : "Confirmer"}
                  </button>
                  <button className="lp-btn" onClick={() => setConfirmingId(null)}>Annuler</button>
                </div>
              ) : (
                <button className="lp-btn" disabled={snapshotBusy} onClick={() => setConfirmingId(entry.id)}>
                  <RotateCcw size={13} /> Restaurer
                </button>
              )}
            </div>
          ))}
        </div>
      )}
    </div>
  );
}

function SettingsModal({
  activeTab, setActiveTab, onClose,
  projects, setProjects, projectFolders, setProjectFolders, tasks, setTasks, onDeleteProject, onBulkDelete, palette,
  statuses, setStatuses,
  taskTypes, setTaskTypes,
  teamMembers, setTeamMembers,
  customFieldDefs, setCustomFieldDefs,
  risks, setRisks,
  gcalSettings, setGcalSettings, gcalList, gcalListLoading, gcalListError, onFetchList,
  syncedCalendarSettings, setSyncedCalendarSettings, onSyncSyncedCalendars,
  metaFilters, setMetaFilters,
  metaTemporalBlocks, setMetaTemporalBlocks,
  appearance, setAppearance, saveStatus, saveError,
  shortcutPrefs, setShortcutPrefs,
  enabledViews, setEnabledViews,
  viewOrder, setViewOrder,
  startupPref, setStartupPref, savedViews, dashboards,
  onOpenImport,
  onOpenMarkdownImport,
  onExportFullBackup,
  onRestoreFullBackup,
  pushToast,
  taskArchive, onArchiveOldCompletedTasks, onArchiveTasks, onRestoreArchivedTasks, onDeleteArchivedTasksForever,
  snapshotIndex, onRestoreSnapshot, snapshotBusy,
}) {
  const [draggingViewKey, setDraggingViewKey] = useState(null);
  const [dragOverViewKey, setDragOverViewKey] = useState(null);
  const moveView = (key, dir) => {
    setViewOrder((prev) => {
      const idx = prev.indexOf(key);
      const swapIdx = idx + dir;
      if (idx === -1 || swapIdx < 0 || swapIdx >= prev.length) return prev;
      const next = [...prev];
      [next[idx], next[swapIdx]] = [next[swapIdx], next[idx]];
      return next;
    });
  };
  const toggleView = (key) => {
    setEnabledViews((prev) => {
      const next = { ...prev, [key]: prev[key] === false ? true : false };
      const stillEnabled = ALL_VIEWS_META.some((v) => next[v.key] !== false);
      if (!stillEnabled) return prev; // on garde toujours au moins une vue active
      return next;
    });
  };

  return (
    <div className="lp-overlay" onMouseDown={(e) => e.target === e.currentTarget && onClose()}>
      <div className="lp-modal lp-modal-extra-wide lp-settings-modal">
        <div className="lp-modal-head">
          <h3>Réglages</h3>
          <button className="lp-icon-btn" onClick={onClose}><X size={18} /></button>
        </div>
        <div className="lp-settings-body">
          <div className="lp-settings-nav">
            {SETTINGS_TABS.map((t) => (
              <button key={t.key} className={"lp-settings-nav-btn" + (activeTab === t.key ? " active" : "")} onClick={() => setActiveTab(t.key)}>
                {t.label}
              </button>
            ))}
          </div>
          <div className="lp-settings-content">
            {activeTab === "projects" && (
              <ProjectManager embedded projects={projects} setProjects={setProjects} projectFolders={projectFolders} setProjectFolders={setProjectFolders} tasks={tasks} statuses={statuses} taskTypes={taskTypes} risks={risks} setRisks={setRisks} teamMembers={teamMembers} customFieldDefs={customFieldDefs} onDeleteProject={onDeleteProject} onBulkDelete={onBulkDelete} palette={palette} />
            )}
            {activeTab === "statuses" && (
              <StatusManager embedded statuses={statuses} setStatuses={setStatuses} tasks={tasks} projects={projects} pushToast={pushToast} />
            )}
            {activeTab === "taskTypes" && (
              <TaskTypeManager embedded taskTypes={taskTypes} setTaskTypes={setTaskTypes} tasks={tasks} projects={projects} pushToast={pushToast} />
            )}
            {activeTab === "users" && (
              <TeamMemberManager embedded teamMembers={teamMembers} setTeamMembers={setTeamMembers} tasks={tasks} pushToast={pushToast} />
            )}
            {activeTab === "customFields" && (
              <CustomFieldManager embedded customFieldDefs={customFieldDefs} setCustomFieldDefs={setCustomFieldDefs} tasks={tasks} projects={projects} pushToast={pushToast} />
            )}
            {activeTab === "syncedCalendars" && (
              <SyncedCalendarsSettingsPane
                settings={syncedCalendarSettings}
                setSettings={setSyncedCalendarSettings}
                projects={projects}
                tasks={tasks}
                onSync={onSyncSyncedCalendars}
                pushToast={pushToast}
              />
            )}
            {activeTab === "chatgpt" && (
              <ChatGPTCaptureSettingsPane />
            )}
            {activeTab === "gcal" && (
              <GcalSettingsManager
                gcalSettings={gcalSettings} setGcalSettings={setGcalSettings}
                gcalList={gcalList} gcalListLoading={gcalListLoading} gcalListError={gcalListError}
                onFetchList={onFetchList}
              />
            )}
            {activeTab === "metaBlocks" && (
              <MetaTemporalBlocksSettingsPane metaTemporalBlocks={metaTemporalBlocks} setMetaTemporalBlocks={setMetaTemporalBlocks} dashboards={dashboards || []} />
            )}
            {activeTab === "metaFilters" && (
              <MetaFiltersSettingsPane metaFilters={metaFilters} setMetaFilters={setMetaFilters} ctx={{ projects, statuses, tasks, teamMembers, projectFolders, customFieldDefs }} />
            )}
            {activeTab === "appearance" && (
              <AppearanceModal embedded appearance={appearance} setAppearance={setAppearance} saveStatus={saveStatus} saveError={saveError} pushToast={pushToast} />
            )}
            {activeTab === "animations" && (
              <AnimationSettingsPane appearance={appearance} setAppearance={setAppearance} saveStatus={saveStatus} saveError={saveError} />
            )}
            {activeTab === "shortcuts" && (
              <ShortcutSettingsPane shortcutPrefs={shortcutPrefs} setShortcutPrefs={setShortcutPrefs} />
            )}
            {activeTab === "views" && (
              <div className="lp-settings-pane">
                <div className="lp-section-title">Page d'ouverture par défaut</div>
                <p style={{ fontSize: 12.5, color: "var(--text-600)", marginTop: -6, marginBottom: 10 }}>
                  Ce qui s'affiche à l'ouverture de Nexora, avant toute navigation.
                </p>
                <div className="lp-row2" style={{ marginBottom: 16 }}>
                  <div className="lp-field">
                    <label>Type</label>
                    <select value={startupPref?.mode || "view"} onChange={(e) => setStartupPref({ mode: e.target.value, value: "" })}>
                      <option value="last">Dernière page ouverte</option>
                      <option value="view">Une vue précise</option>
                      <option value="dashboard">Un tableau de bord précis</option>
                      <option value="savedView">Une vue enregistrée</option>
                      <option value="project">Un projet précis (dans la dernière vue utilisée)</option>
                    </select>
                  </div>
                  <div className="lp-field">
                    <label>Laquelle</label>
                    {startupPref?.mode === "last" ? (
                      <div style={{minHeight:34,display:"flex",alignItems:"center",padding:"0 10px",border:"1px solid var(--border)",borderRadius:6,background:"var(--paper-soft)",fontSize:12.5,color:"var(--text-600)"}}>
                        Restaurée automatiquement
                      </div>
                    ) : startupPref?.mode === "dashboard" ? (
                      <select value={startupPref.value || ""} onChange={(e) => setStartupPref((p) => ({ ...p, value: e.target.value }))}>
                        <option value="">— Choisir —</option>
                        {dashboards.map((d) => <option key={d.id} value={d.id}>{d.name}</option>)}
                      </select>
                    ) : startupPref?.mode === "savedView" ? (
                      <select value={startupPref.value || ""} onChange={(e) => setStartupPref((p) => ({ ...p, value: e.target.value }))}>
                        <option value="">— Choisir —</option>
                        {savedViews.map((v) => <option key={v.id} value={v.id}>{v.name}</option>)}
                      </select>
                    ) : startupPref?.mode === "project" ? (
                      <select value={startupPref.value || ""} onChange={(e) => setStartupPref((p) => ({ ...p, value: e.target.value }))}>
                        <option value="">— Choisir —</option>
                        {sortedByName(projects).map((p) => <option key={p.id} value={p.id}>{p.name}</option>)}
                      </select>
                    ) : (
                      <select value={startupPref?.value || "gantt"} onChange={(e) => setStartupPref((p) => ({ ...p, value: e.target.value }))}>
                        {ALL_VIEWS_META.map((v) => <option key={v.key} value={v.key}>{v.label}</option>)}
                      </select>
                    )}
                  </div>
                </div>

                <div className="lp-section-title">Tableau de bord</div>
                <p style={{ fontSize: 12.5, color: "var(--text-600)", marginTop: -6, marginBottom: 10 }}>
                  Affiché comme un bouton central dans la barre du haut, séparé des autres vues.
                </p>
                <label className="lp-checkbox-row" style={{ padding: "7px 0", marginBottom: 14 }}>
                  <input type="checkbox" checked={enabledViews.dashboard !== false} onChange={() => toggleView("dashboard")} />
                  <span style={{ textTransform: "none", fontWeight: 500, fontSize: 13.5, display: "flex", alignItems: "center", gap: 8 }}><LayoutDashboard size={13} /> Tableau de bord</span>
                </label>

                <div className="lp-section-title">Vues affichées dans la barre d'onglets</div>
                <p style={{ fontSize: 12.5, color: "var(--text-600)", marginTop: -6, marginBottom: 14 }}>
                  Décoche les vues que tu n'utilises pas, et glisse-dépose une ligne (ou utilise les flèches) pour réordonner. Au moins une vue doit rester active.
                </p>
                {viewOrder.map((key, i) => {
                  const v = ALL_VIEWS_META.find((m) => m.key === key);
                  if (!v) return null;
                  return (
                    <div
                      className={"lp-view-order-row" + (dragOverViewKey === v.key ? " lp-view-order-row-dragover" : "")}
                      key={v.key}
                      draggable
                      onDragStart={(e) => { e.dataTransfer.effectAllowed = "move"; e.dataTransfer.setData("text/plain", v.key); setDraggingViewKey(v.key); }}
                      onDragOver={(e) => { e.preventDefault(); if (v.key !== draggingViewKey) setDragOverViewKey(v.key); }}
                      onDragLeave={() => setDragOverViewKey((k) => (k === v.key ? null : k))}
                      onDrop={(e) => {
                        e.preventDefault();
                        const draggedKey = e.dataTransfer.getData("text/plain");
                        setDraggingViewKey(null);
                        setDragOverViewKey(null);
                        if (!draggedKey || draggedKey === v.key) return;
                        setViewOrder((prev) => {
                          const next = prev.filter((k) => k !== draggedKey);
                          const targetIdx = next.indexOf(v.key);
                          next.splice(targetIdx, 0, draggedKey);
                          return next;
                        });
                      }}
                      onDragEnd={() => { setDraggingViewKey(null); setDragOverViewKey(null); }}
                    >
                      <span className="lp-view-order-drag-handle" title="Glisser pour réordonner"><GripVertical size={13} /></span>
                      <div className="lp-view-order-arrows">
                        <button type="button" className="lp-icon-btn" disabled={i === 0} onClick={() => moveView(v.key, -1)} title="Monter"><ChevronUp size={13} /></button>
                        <button type="button" className="lp-icon-btn" disabled={i === viewOrder.length - 1} onClick={() => moveView(v.key, 1)} title="Descendre"><ChevronDown size={13} /></button>
                      </div>
                      <label className="lp-checkbox-row" style={{ padding: "7px 0", flex: 1 }}>
                        <input type="checkbox" checked={enabledViews[v.key] !== false} onChange={() => toggleView(v.key)} />
                        <span style={{ textTransform: "none", fontWeight: 500, fontSize: 13.5, display: "flex", alignItems: "center", gap: 8 }}>
                          <IconGlyph icon={appearance.viewIcons?.[v.key] || v.iconKey} size={13} />
                          {v.label}
                        </span>
                      </label>
                    </div>
                  );
                })}
              </div>
            )}
            {activeTab === "data" && (
              <div className="lp-settings-pane">
                <FullBackupSettingsPane
                  onExportBackup={onExportFullBackup}
                  onRestoreBackup={onRestoreFullBackup}
                  pushToast={pushToast}
                  snapshotIndex={snapshotIndex}
                  onRestoreSnapshot={onRestoreSnapshot}
                  snapshotBusy={snapshotBusy}
                />
                <hr className="lp-divider" />
                <div className="lp-section-title">Import / export ciblé</div>
                <div style={{display:"flex",gap:8,flexWrap:"wrap"}}>
                  <button className="lp-btn lp-btn-primary" onClick={onOpenImport}><FileUp size={13} style={{ marginRight: 4, verticalAlign: -2 }} />Importer un CSV</button>
                  <button className="lp-btn lp-btn-primary" onClick={onOpenMarkdownImport}><FileText size={13} style={{ marginRight: 4, verticalAlign: -2 }} />Importer des Markdown</button>
                </div>
                <div style={{marginTop:12,padding:"10px 12px",border:"1px solid var(--border)",borderRadius:"var(--radius-sm)",background:"var(--paper-soft)"}}>
                  <div style={{fontSize:12,fontWeight:750,marginBottom:4}}>Import Markdown</div>
                  <div style={{fontSize:11,color:"var(--text-600)",lineHeight:1.5}}>
                    Un fichier Markdown crée un élément Nexora et place son texte intégral dans le champ <strong>Description</strong>.
                    Les valeurs par défaut sont <strong>Aujourd'hui · Inbox · À planifier · Action</strong>.
                    Projet, type et statut peuvent être définis pour tous les fichiers ou individuellement ; la date reste configurable fichier par fichier.
                  </div>
                </div>
                <p style={{ fontSize: 12, color: "var(--text-600)" }}>L'export PDF de la vue active est disponible depuis l'icône d'impression, en haut à droite de l'application.</p>
                <hr className="lp-divider" />
                <TaskArchiveSettingsPane
                  tasks={tasks}
                  taskArchive={taskArchive}
                  projects={projects}
                  statuses={statuses}
                  onArchiveOldCompleted={onArchiveOldCompletedTasks}
                  onArchiveTasks={onArchiveTasks}
                  onRestore={onRestoreArchivedTasks}
                  onDeleteForever={onDeleteArchivedTasksForever}
                />
                <hr className="lp-divider" />
                <div className="lp-section-title">Zone de danger</div>
                <button
                  className="lp-btn lp-btn-danger"
                  onClick={() => onBulkDelete(tasks.map((t) => t.id), "(absolument toutes, sans exception)")}
                >
                  <Trash2 size={13} style={{ marginRight: 4, verticalAlign: -2 }} />Supprimer toutes les tâches
                </button>
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  );
}

function SaveViewModal({ onClose, onSave, activeFilterCount, currentView, viewFolders }) {
  const [name, setName] = useState("");
  const [folderId, setFolderId] = useState("");
  const [icon, setIcon] = useState("");
  const [nameError, setNameError] = useState(false);
  const submit = () => { if (!name.trim()) { setNameError(true); return; } onSave(name, folderId, icon); };
  const viewLabel = { list: "Liste", gantt: "Gantt" }[currentView] || currentView;
  return (
    <Modal title="Enregistrer la vue actuelle" onClose={onClose} footer={
      <>
        <button className="lp-btn" onClick={onClose}>Annuler</button>
        <button className="lp-btn lp-btn-primary" onClick={submit}>Enregistrer</button>
      </>
    }>
      <NamedField
        label="Nom de la vue"
        value={name}
        onChange={(v) => { setName(v); if (nameError && v.trim()) setNameError(false); }}
        error={nameError}
        onEnter={submit}
        placeholder="Ex. Gantt · Lot 2B et CTEX6 · retards"
        autoFocus
      />
      <div className="lp-field"><label>Icône (facultatif)</label><IconEditor icon={icon} setIcon={setIcon} /></div>
      {viewFolders.length > 0 && (
        <div className="lp-field">
          <label>Dossier (optionnel)</label>
          <select value={folderId} onChange={(e) => setFolderId(e.target.value)}>
            <option value="">Aucun</option>
            {viewFolders.map((f) => <option key={f.id} value={f.id}>{f.name}</option>)}
          </select>
        </div>
      )}
      <div style={{ fontSize: 12, color: "var(--text-600)" }}>
        Cette vue enregistre un <strong>instantané complet</strong> de l'affichage :
        onglet actif (<strong>{viewLabel}</strong>), {activeFilterCount > 0 ? <><strong>{activeFilterCount} filtre{activeFilterCount > 1 ? "s" : ""}</strong>, </> : ""}
        périmètre projets, zoom, groupements, colonnes et paramètres propres à la vue.
        Pour la vue Métro, le mode <strong>Normal / Échéances / Réseau</strong> est également mémorisé.
        Un clic sur la vue enregistrée restaure l'ensemble.
      </div>
    </Modal>
  );
}

function ViewEditModal({ view, onSave, onClose, ctx }) {
  const [name, setName] = useState(view.name);
  const [icon, setIcon] = useState(view.icon || "");
  const [viewType, setViewType] = useState(view.view);
  const [filters, setFilters] = useState(() => ({ ...defaultFilters(), ...(view.filters || {}), advanced:(view.filters?.advanced || defaultFilters().advanced) }));
  const [nameError, setNameError] = useState(false);
  const submit = () => { if (!name.trim()) { setNameError(true); return; } onSave({ name: name.trim(), icon: icon || null, view: viewType, filters }); };
  return (
    <Modal title="Modifier la vue" onClose={onClose} wide footer={
      <>
        <button className="lp-btn" onClick={onClose}>Annuler</button>
        <button className="lp-btn lp-btn-primary" onClick={submit}>Enregistrer</button>
      </>
    }>
      <div className="lp-row2">
        <NamedField label="Nom de la vue" value={name} onChange={(v) => { setName(v); if (nameError && v.trim()) setNameError(false); }} error={nameError} onEnter={submit} autoFocus />
        <div className="lp-field"><label>Icône</label><IconEditor icon={icon} setIcon={setIcon} /></div>
      </div>
      <div className="lp-field">
        <label>Type de vue</label>
        <select value={viewType} onChange={(e) => setViewType(e.target.value)}>
          {PROJECT_TAB_VIEW_KEYS.map((k) => {
            const meta = ALL_VIEWS_META.find((m) => m.key === k);
            return <option key={k} value={k}>{meta ? meta.label : k}</option>;
          })}
        </select>
      </div>
      <hr className="lp-divider" />
      <div className="lp-section-title">Conditions de filtre</div>
      <FilterFieldsBody local={filters} setLocal={setFilters} ctx={ctx} />
    </Modal>
  );
}

function NewDashboardModal({ onClose, onCreate, dashboardFolders }) {
  const [name, setName] = useState("");
  const [folderId, setFolderId] = useState("");
  const [nameError, setNameError] = useState(false);
  const submit = () => { if (!name.trim()) { setNameError(true); return; } onCreate(name, folderId); };
  return (
    <Modal title="Nouveau tableau de bord" onClose={onClose} footer={
      <>
        <button className="lp-btn" onClick={onClose}>Annuler</button>
        <button className="lp-btn lp-btn-primary" onClick={submit}>Créer</button>
      </>
    }>
      <NamedField label="Nom" value={name} onChange={(v) => { setName(v); if (nameError && v.trim()) setNameError(false); }} error={nameError} onEnter={submit} placeholder="Ex. Suivi chantier Lot 3" autoFocus />
      {dashboardFolders.length > 0 && (
        <div className="lp-field">
          <label>Dossier (optionnel)</label>
          <select value={folderId} onChange={(e) => setFolderId(e.target.value)}>
            <option value="">Aucun</option>
            {dashboardFolders.map((f) => <option key={f.id} value={f.id}>{f.name}</option>)}
          </select>
        </div>
      )}
      <div style={{ fontSize: 12, color: "var(--text-600)" }}>Le tableau démarre vide — tu ajoutes ses widgets ensuite, une fois dessus.</div>
    </Modal>
  );
}

function DashboardEditModal({ dashboard, onSave, onClose }) {
  const [name, setName] = useState(dashboard.name);
  const [icon, setIcon] = useState(dashboard.icon || "");
  const [nameError, setNameError] = useState(false);
  const submit = () => { if (!name.trim()) { setNameError(true); return; } onSave({ name: name.trim(), icon: icon || null }); };
  return (
    <Modal title="Modifier le tableau de bord" onClose={onClose} footer={
      <>
        <button className="lp-btn" onClick={onClose}>Annuler</button>
        <button className="lp-btn lp-btn-primary" onClick={submit}>Enregistrer</button>
      </>
    }>
      <NamedField label="Nom" value={name} onChange={(v) => { setName(v); if (nameError && v.trim()) setNameError(false); }} error={nameError} onEnter={submit} autoFocus />
      <div className="lp-field">
        <label>Icône <span style={{ fontWeight: 400, textTransform: "none", color: "var(--text-600)" }}>(icône Tabler, image importée, ou lien — facultatif)</span></label>
        <IconEditor icon={icon} setIcon={setIcon} />
      </div>
    </Modal>
  );
}

// ============================================================================
// Vue Liste
// ============================================================================
const LIST_FIELD_OPTIONS = ["project", "status", "taskType", "assignee", "milestone", "progress", "start", "end", "period", "checklist"];
const GROUP_OPTIONS = ["none", "status", "taskType", "project", "assignee", "milestone", "period", "inactivity"];
const GANTT_GROUP_OPTIONS = ["status", "taskType", "project", "assignee", "milestone", "period"];

// ============================================================================
// Tooltip de survol de tâche — non persistant, disparaît quand le survol cesse
// ============================================================================
function TaskHoverCard({ task, ctx, gradient }) {
  if (!task) return null;
  const proj = ctx.projects.find((p) => p.id === task.projectId);
  const st = ctx.statuses.find((s) => s.id === task.statusId);
  const cl = task.checklist || [];
  const clDone = cl.filter((i) => i.done).length;
  return (
    <div className="lp-hover-card">
      <div className="lp-hover-card-header">
        {proj && <span className="lp-project-dot" style={{ background: proj.color, width: 14, height: 14, fontSize: 8, flex: "0 0 auto" }}><IconGlyph icon={proj.icon} size={9} /></span>}
        <strong style={{ fontSize: 12, flex: 1 }}>{task.milestone && <MilestoneGlyph size={11} style={{ marginRight: 4, verticalAlign: -2 }} icon={resolveMilestoneIcon(task, ctx)} />}{task.title}</strong>
      </div>
      <div className="lp-hover-card-chips">
        {st && <span className="lp-chip" style={{ background: st.color + "22", color: st.color }}>{st.name}</span>}
        {proj && <span className="lp-chip" style={{ background: proj.color + "22", color: proj.color }}>{proj.name}</span>}
        {task.assignee && <span className="lp-chip">{task.assignee}</span>}
      </div>
      <div className="lp-hover-card-chips">
        <span className="lp-chip lp-mono">Début {fmtShort(task.start)}</span>
        <span className="lp-chip lp-mono">Fin {fmtShort(task.end)}</span>
        <span className="lp-chip">{task.progress}%</span>
        {cl.length > 0 && <span className="lp-chip"><Check size={10} /> {clDone}/{cl.length}</span>}
      </div>
      {task.desc && <div className="lp-hover-card-desc">{task.desc}</div>}
    </div>
  );
}

function BulkEditBar({ count, ctx, onStatus, onType, onProject, onShiftDays, onDelete, onClear }) {
  const [statusOpen, setStatusOpen] = useState(false);
  const [typeOpen, setTypeOpen] = useState(false);
  const [projectOpen, setProjectOpen] = useState(false);
  return (
    <div className="lp-bulk-bar">
      <span className="lp-bulk-count">{count} tâche{count > 1 ? "s" : ""} sélectionnée{count > 1 ? "s" : ""}</span>
      <div className="lp-bulk-actions">
        <div className="lp-color-select" style={{ minWidth: 160 }}>
          <button type="button" className="lp-color-select-btn" disabled={count === 0} onClick={() => { setStatusOpen((o) => !o); setTypeOpen(false); setProjectOpen(false); }}>
            <span className="cs-label">Changer le statut</span>
            <ChevronDown size={14} />
          </button>
          {statusOpen && (
            <div className="lp-color-select-panel">
              {sortedByName(ctx.statuses.filter((s)=>!s.projectId)).map((s) => (
                <button type="button" key={s.id} className="cs-option" onClick={() => { onStatus(s.id); setStatusOpen(false); }}>
                  <span className="swatch small" style={{ background: s.color }} />{s.name}
                </button>
              ))}
            </div>
          )}
        </div>
        <div className="lp-color-select" style={{ minWidth: 160 }}>
          <button type="button" className="lp-color-select-btn" disabled={count === 0} onClick={() => { setTypeOpen((o) => !o); setStatusOpen(false); setProjectOpen(false); }}>
            <span className="cs-label">Changer le type</span>
            <ChevronDown size={14} />
          </button>
          {typeOpen && (
            <div className="lp-color-select-panel">
              {sortedByName((ctx.taskTypes || []).filter((s)=>!s.projectId)).map((s) => (
                <button type="button" key={s.id} className="cs-option" onClick={() => { onType(s.id); setTypeOpen(false); }}>
                  <span className="swatch small" style={{ background: s.color }} />{s.name}
                </button>
              ))}
            </div>
          )}
        </div>
        <div className="lp-color-select" style={{ minWidth: 160 }}>
          <button type="button" className="lp-color-select-btn" disabled={count === 0} onClick={() => { setProjectOpen((o) => !o); setStatusOpen(false); setTypeOpen(false); }}>
            <span className="cs-label">Changer le projet</span>
            <ChevronDown size={14} />
          </button>
          {projectOpen && (
            <div className="lp-color-select-panel">
              {sortedByName(ctx.projects).map((p) => (
                <button type="button" key={p.id} className="cs-option" onClick={() => { onProject(p.id); setProjectOpen(false); }}>
                  <span className="swatch small" style={{ background: p.color }} />{p.name}
                </button>
              ))}
            </div>
          )}
        </div>
        <div className="lp-bulk-shift">
          <span style={{ fontSize: 12, color: "var(--text-600)", fontWeight: 600 }}>Décaler :</span>
          <button className="lp-tool-btn" disabled={count === 0} onClick={() => onShiftDays(-7)}>-7j</button>
          <button className="lp-tool-btn" disabled={count === 0} onClick={() => onShiftDays(-1)}>-1j</button>
          <button className="lp-tool-btn" disabled={count === 0} onClick={() => onShiftDays(1)}>+1j</button>
          <button className="lp-tool-btn" disabled={count === 0} onClick={() => onShiftDays(7)}>+7j</button>
        </div>
        <button className="lp-btn lp-btn-danger" disabled={count === 0} onClick={onDelete}><Trash2 size={13} style={{ marginRight: 4, verticalAlign: -2 }} />Supprimer</button>
        {count > 0 && <button className="lp-icon-btn" onClick={onClear} title="Désélectionner tout"><X size={15} /></button>}
      </div>
    </div>
  );
}

function InlineTextField({ value, placeholder, onCommit, style }) {
  const [editing, setEditing] = useState(false);
  const [val, setVal] = useState(value || "");
  useEffect(() => { setVal(value || ""); }, [value]);
  if (editing) {
    return (
      <input
        className="lp-inline-edit-input"
        value={val}
        placeholder={placeholder}
        autoFocus
        style={style}
        onClick={(e) => e.stopPropagation()}
        onChange={(e) => setVal(e.target.value)}
        onBlur={() => { setEditing(false); if (val !== (value || "")) onCommit(val); }}
        onKeyDown={(e) => { if (e.key === "Enter") e.currentTarget.blur(); if (e.key === "Escape") { setVal(value || ""); setEditing(false); } }}
      />
    );
  }
  return (
    <span className="lp-inline-editable-text" style={style} onClick={(e) => { e.stopPropagation(); setEditing(true); }}>
      {value || <span style={{ color: "var(--text-600)", fontStyle: "italic" }}>{placeholder}</span>}
    </span>
  );
}
function InlineDateField({ value, onCommit }) {
  const [editing, setEditing] = useState(false);
  const [val, setVal] = useState(value || "");
  useEffect(() => { setVal(value || ""); }, [value]);
  if (editing) {
    return (
      <input
        type="date"
        className="lp-inline-edit-input"
        value={val}
        autoFocus
        onClick={(e) => e.stopPropagation()}
        onChange={(e) => setVal(e.target.value)}
        onBlur={() => { setEditing(false); if (val && val !== value) onCommit(val); }}
        onKeyDown={(e) => { if (e.key === "Enter") e.currentTarget.blur(); if (e.key === "Escape") { setVal(value || ""); setEditing(false); } }}
      />
    );
  }
  return <span className="lp-inline-editable-text lp-date-badge" onClick={(e) => { e.stopPropagation(); setEditing(true); }}>{fmtShort(value)}</span>;
}
function InlineChipSelect({ options, value, onChange }) {
  const [open, setOpen] = useState(false);
  const [q, setQ] = useState("");
  const ref = useRef(null);
  const searchRef = useRef(null);
  useEffect(() => {
    function onDoc(e) { if (ref.current && !ref.current.contains(e.target)) setOpen(false); }
    document.addEventListener("mousedown", onDoc);
    return () => document.removeEventListener("mousedown", onDoc);
  }, []);
  useEffect(() => { if (open) { setQ(""); setTimeout(() => searchRef.current?.focus(), 0); } }, [open]);
  const current = options.find((o) => o.value === value);
  const sortedOptions = sortedByName(options);
  const filtered = q.trim() ? sortedOptions.filter((o) => o.label.toLowerCase().includes(q.trim().toLowerCase())) : sortedOptions;
  return (
    <div className="lp-inline-chip-select" ref={ref} onClick={(e) => e.stopPropagation()}>
      <button type="button" className="lp-chip lp-chip-editable" style={{ background: (current?.color || "var(--text-muted)") + "22", color: current?.color || "var(--text-muted)" }} onClick={() => setOpen((o) => !o)}>
        {current?.icon ? <IconGlyph icon={current.icon} size={11} /> : null} {current?.label || "—"}
      </button>
      {open && (
        <div className="lp-color-select-panel lp-status-dropdown" style={{ minWidth: 180 }}>
          {options.length > 5 && (
            <input ref={searchRef} type="text" className="lp-select-search" placeholder="Rechercher…" value={q} onChange={(e) => setQ(e.target.value)} onClick={(e) => e.stopPropagation()} />
          )}
          {filtered.map((o) => (
            <button
              type="button"
              key={o.value}
              className={"cs-option lp-status-option" + (o.value === value ? " active" : "")}
              style={o.color ? { background: o.color + (o.value === value ? "26" : "14"), color: o.color } : undefined}
              onClick={() => { onChange(o.value); setOpen(false); }}
            >
              {o.color && <span className="swatch small" style={{ background: o.color }} />}
              <span style={{ fontWeight: o.value === value ? 700 : 600 }}>{o.label}</span>
              {o.value === value && <Check size={13} style={{ marginLeft: "auto" }} />}
            </button>
          ))}
          {filtered.length === 0 && <div className="lp-select-empty">Aucun résultat</div>}
        </div>
      )}
    </div>
  );
}
function InlineEditableField({ fieldKey, task, ctx, setTasks, gradient, progressByStatus, onProgressChange }) {
  const update = (patch) => setTasks((prev) => prev.map((t) => (t.id === task.id ? { ...t, ...patch } : t)));
  if (fieldKey === "project") {
    const options = ctx.projects.map((p) => ({ value: p.id, label: p.name, color: p.color, icon: p.icon }));
    return <InlineChipSelect options={options} value={task.projectId} onChange={(v) => update({ projectId: v })} />;
  }
  if (fieldKey === "status") {
    const current = ctx.statuses.find((s) => s.id === task.statusId);
    const isGoogle = isGoogleCalendarProjectId(task.projectId, ctx.projects);
    const restrictedStatus = restrictedStatusForType(ctx.taskTypes, ctx.statuses, task.taskTypeId);
    if (isGoogle) {
      return (
        <span
          className="lp-chip"
          title="Statut calculé automatiquement depuis les dates Google Calendar"
          style={{
            background:(current?.color || "var(--text-muted)") + "18",
            color:current?.color || "var(--text-muted)",
            cursor:"default",
            border:"1px solid " + ((current?.color || "#64748B") + "30")
          }}
        >
          <Lock size={10} /> {current?.name || "—"}
        </span>
      );
    }
    if (restrictedStatus) {
      return (
        <span
          className="lp-chip"
          title="Statut automatique — imposé par le type de tâche"
          style={{
            background:(restrictedStatus.color || "var(--text-muted)") + "18",
            color:restrictedStatus.color || "var(--text-muted)",
            cursor:"default",
            border:"1px solid " + ((restrictedStatus.color || "#64748B") + "30")
          }}
        >
          <Lock size={10} /> {restrictedStatus.name}
        </span>
      );
    }
    const options = getStatusesForProject(ctx.statuses, ctx.projects, task.projectId, task.statusId)
      .map((s) => ({ value: s.id, label: s.name, color: s.color }));
    return <InlineChipSelect options={options} value={task.statusId} onChange={(v) => update({ statusId: v })} />;
  }
  if (fieldKey === "criticality") {
    const options = CRITICALITIES.map((c) => ({ value: c.id, label: c.name, color: c.color }));
    return <InlineChipSelect options={options} value={task.criticality || ""} onChange={(v) => update({ criticality: v })} />;
  }
  if (fieldKey === "taskType") {
    const options = getTaskTypesForProject(ctx.taskTypes, ctx.projects, task.projectId, task.taskTypeId)
      .map((t) => ({ value: t.id, label: t.name, color: t.color, icon: t.icon }));
    return (
      <InlineChipSelect
        options={options}
        value={task.taskTypeId}
        onChange={(v) => {
          // Si le nouveau type impose un statut unique automatique (ex.
          // "Information"), on le bascule dans le même geste — cohérent avec
          // le comportement de la fiche tâche complète (TaskModal).
          const restricted = restrictedStatusForType(ctx.taskTypes, ctx.statuses, v);
          update(restricted ? { taskTypeId: v, statusId: restricted.id } : { taskTypeId: v });
        }}
      />
    );
  }
  if (fieldKey === "assignee") {
    return <InlineTextField value={task.assignee} placeholder="Responsable" onCommit={(v) => update({ assignee: v })} />;
  }
  if (fieldKey === "start" || fieldKey === "end") {
    return <InlineDateField value={task[fieldKey]} onCommit={(v) => update({ [fieldKey]: v, ...(fieldKey === "start" && v > task.end ? { end: v } : {}), ...(fieldKey === "end" && v < task.start ? { start: v } : {}) })} />;
  }
  return <FieldValue fieldKey={fieldKey} task={task} ctx={ctx} gradient={gradient} progressByStatus={progressByStatus} onProgressChange={onProgressChange} />;
}

function ListView({ tasks, ctx, gradient, progressColorByStatus, setTasks, onOpen, onAdd, onDelete, onMarkDone, onCycleStatus, onBulkDelete, prefs, setPrefs, toolbarSlot, embedded }) {
  const groupBy = prefs.groupBy;
  const setGroupBy = (v) => setPrefs({ groupBy: v });
  const visibleFields = prefs.visibleFields;
  const setVisibleFields = (updater) => setPrefs((p) => ({ visibleFields: typeof updater === "function" ? updater(p.visibleFields) : updater }));
  const [collapsed, setCollapsed] = useState({});
  const [openChecklists, setOpenChecklists] = useState({});
  const groups = useMemo(() => groupTasks(tasks, groupBy, ctx), [tasks, groupBy, ctx]);
  const shownFields = groupBy === "none" ? visibleFields : visibleFields.filter((f) => f !== groupBy);

  const toggleChecklistOpen = (id) => setOpenChecklists((o) => ({ ...o, [id]: !o[id] }));
  const toggleChecklistItem = (taskId, itemId) => {
    setTasks((prev) => prev.map((t) => (t.id === taskId ? { ...t, checklist: (t.checklist || []).map((i) => (i.id === itemId ? { ...i, done: !i.done } : i)) } : t)));
  };
  const updateChecklistItemText = (taskId, itemId, text) => {
    setTasks((prev) => prev.map((t) => (t.id === taskId ? { ...t, checklist: (t.checklist || []).map((i) => (i.id === itemId ? { ...i, text } : i)) } : t)));
  };
  const updateChecklistItemDate = (taskId, itemId, end) => {
    setTasks((prev) => prev.map((t) => (t.id === taskId ? { ...t, checklist: (t.checklist || []).map((i) => (i.id === itemId ? { ...i, end } : i)) } : t)));
  };
  const tasksWithChecklist = tasks.filter((t) => (t.checklist || []).length > 0);
  const allChecklistsOpen = tasksWithChecklist.length > 0 && tasksWithChecklist.every((t) => openChecklists[t.id]);
  const toggleAllChecklists = () => {
    const n = {};
    tasksWithChecklist.forEach((t) => { n[t.id] = !allChecklistsOpen; });
    setOpenChecklists((o) => ({ ...o, ...n }));
  };
  const updateProgress = (taskId, value) => {
    setTasks((prev) => prev.map((t) => (t.id === taskId ? { ...t, progress: value } : t)));
  };
  const allGroupsOpen = groups.length > 0 && groups.every((g) => !collapsed[g.key]);
  const toggleAllGroups = () => {
    const n = {};
    groups.forEach((g) => { n[g.key] = allGroupsOpen; });
    setCollapsed(n);
  };

  const [selectMode, setSelectMode] = useState(false);
  const [selectedIds, setSelectedIds] = useState([]);
  const toggleSelect = (id) => setSelectedIds((prev) => (prev.includes(id) ? prev.filter((x) => x !== id) : [...prev, id]));
  const exitSelectMode = () => { setSelectMode(false); setSelectedIds([]); };
  const applyBulkStatus = (statusId) => setTasks((prev) => prev.map((t) => (
    selectedIds.includes(t.id) && !isGoogleCalendarProjectId(t.projectId, ctx.projects)
      ? { ...t, statusId }
      : t
  )));
  const applyBulkType = (taskTypeId) => setTasks((prev) => prev.map((t) => {
    if (!selectedIds.includes(t.id)) return t;
    // Comme pour la modification à l'unité : si le nouveau type impose un statut
    // automatique (ex. "Information"), on le bascule dans le même geste.
    const restricted = restrictedStatusForType(ctx.taskTypes, ctx.statuses, taskTypeId);
    return restricted ? { ...t, taskTypeId, statusId: restricted.id } : { ...t, taskTypeId };
  }));
  const applyBulkProject = (projectId) => setTasks((prev) => prev.map((t) => (selectedIds.includes(t.id) ? { ...t, projectId } : t)));
  const applyBulkDateShift = (days) => setTasks((prev) => prev.map((t) => (selectedIds.includes(t.id) ? { ...t, start: addDays(t.start, days), end: addDays(t.end, days) } : t)));

  return (
    <div>
      <ViewToolbarPortal slot={toolbarSlot}>
        <DropdownButton label="" icon={<Layers size={14} />} title={`Grouper par : ${fieldLabel(groupBy, ctx)}`}>
          {GROUP_OPTIONS.map((k) => (
            <label className="lp-checkbox-line" key={k}><input type="radio" name="lp-gb" checked={groupBy === k} onChange={() => setGroupBy(k)} /> {fieldLabel(k, ctx)}</label>
          ))}
          {(ctx.customFieldDefs || []).length > 0 && (
            <>
              <div className="lp-dropdown-group-label">Champs personnalisés</div>
              {ctx.customFieldDefs.map((f) => (
                <label className="lp-checkbox-line" key={f.id}><input type="radio" name="lp-gb" checked={groupBy === "cf:" + f.id} onChange={() => setGroupBy("cf:" + f.id)} /> {f.name}</label>
              ))}
            </>
          )}
        </DropdownButton>
        {!embedded && (
          <DropdownButton label="" icon={<Columns3 size={14} />} title="Colonnes affichées">
            {LIST_FIELD_OPTIONS.map((k) => (
              <label className="lp-checkbox-line" key={k}><input type="checkbox" checked={visibleFields.includes(k)} onChange={() => setVisibleFields((v) => (v.includes(k) ? v.filter((x) => x !== k) : [...v, k]))} /> {fieldLabel(k)}</label>
            ))}
          </DropdownButton>
        )}
        {!embedded && groupBy !== "none" && (
          <button className="lp-tool-btn" onClick={toggleAllGroups} title={allGroupsOpen ? "Replier les sections" : "Déplier les sections"}>{allGroupsOpen ? <ChevronsUp size={14} /> : <ChevronsDown size={14} />}</button>
        )}
        {!embedded && tasksWithChecklist.length > 0 && (
          <button className="lp-tool-btn" onClick={toggleAllChecklists} title={allChecklistsOpen ? "Replier les sous-tâches" : "Déplier les sous-tâches"}>{allChecklistsOpen ? <ChevronsUp size={14} /> : <ChevronsDown size={14} />}</button>
        )}
        {!embedded && (
          <button className={"lp-tool-btn" + (selectMode ? " active" : "")} onClick={() => (selectMode ? exitSelectMode() : setSelectMode(true))} title={selectMode ? "Quitter la sélection" : "Sélection multiple"}>
            <CheckCircle2 size={14} />
          </button>
        )}
        {embedded && (
          <DropdownButton label="" icon={<MoreHorizontal size={14} />} title="Plus d'options">
            <div className="lp-dropdown-group-label">Colonnes affichées</div>
            {LIST_FIELD_OPTIONS.map((k) => (
              <label className="lp-checkbox-line" key={k}><input type="checkbox" checked={visibleFields.includes(k)} onChange={() => setVisibleFields((v) => (v.includes(k) ? v.filter((x) => x !== k) : [...v, k]))} /> {fieldLabel(k)}</label>
            ))}
            {groupBy !== "none" && (
              <>
                <hr className="lp-divider" style={{ margin: "6px 0" }} />
                <label className="lp-checkbox-line"><input type="checkbox" checked={allGroupsOpen} onChange={toggleAllGroups} /> Déplier les sections</label>
              </>
            )}
            {tasksWithChecklist.length > 0 && (
              <label className="lp-checkbox-line"><input type="checkbox" checked={allChecklistsOpen} onChange={toggleAllChecklists} /> Déplier les sous-tâches</label>
            )}
          </DropdownButton>
        )}
      </ViewToolbarPortal>

      {selectMode && (
        <BulkEditBar
          count={selectedIds.length}
          ctx={ctx}
          onStatus={applyBulkStatus}
          onType={applyBulkType}
          onProject={applyBulkProject}
          onShiftDays={applyBulkDateShift}
          onDelete={() => { if (selectedIds.length) { onBulkDelete(selectedIds, "sélectionnées"); setSelectedIds([]); } }}
          onClear={() => setSelectedIds([])}
        />
      )}

      {tasks.length === 0 && <div className="lp-empty">Aucune tâche ne correspond aux filtres actifs.</div>}
      {groups.map((g) => {
        if (g.tasks.length === 0 && groupBy !== "none") return null;
        const isOpen = !collapsed[g.key];
        return (
          <div
            className="lp-group" key={g.key}
            onDragOver={(e) => e.preventDefault()}
            onDrop={(e) => {
              const id = e.dataTransfer.getData("application/x-nexora-task");
              if (!id) return;
              const dragged = tasks.find((x) => x.id === id);
              if (!dragged) return;
              if (groupBy !== "none" && !matchesGroupKey(dragged, groupBy, g.key, ctx)) setTaskField(setTasks, id, groupBy, g.key);
            }}
          >
            <div className="lp-group-head">
              <span style={{ display: "flex", alignItems: "center", flex: 1, gap: 8, cursor: "pointer" }} onClick={() => setCollapsed((c) => ({ ...c, [g.key]: !c[g.key] }))}>
                {isOpen ? <ChevronDown size={15} /> : <ChevronUp size={15} style={{ transform: "rotate(90deg)" }} />}
                <span className="lp-status-dot" style={{ background: g.color }} />
                <span className="lp-group-title">{g.label}</span>
                <span className="lp-group-count">{g.tasks.length}</span>
              </span>
              <button className="lp-group-action-btn" onClick={(e) => { e.stopPropagation(); const defaults = {}; if (groupBy === "status") defaults.statusId = g.key; else if (groupBy === "project") defaults.projectId = g.key; else if (groupBy === "assignee") defaults.assignee = g.key; onAdd(defaults); }} title={`Ajouter une tâche dans « ${g.label} »`}><Plus size={13} /></button>
              {g.tasks.length > 0 && <button className="lp-group-action-btn lp-group-action-danger" onClick={(e) => { e.stopPropagation(); onBulkDelete(g.tasks.map((t) => t.id), `du groupe « ${g.label} »`); }} title={`Supprimer toutes les tâches de « ${g.label} »`}><Trash2 size={13} /></button>}
            </div>
            {isOpen && g.tasks.map((t) => {
              const late = isTaskLate(t, ctx);
              const done = isTaskDoneGlobal(t, ctx);
              const urgent = isTaskUrgent(t, ctx);
              const hasChecklist = (t.checklist || []).length > 0;
              const checklistOpen = !!openChecklists[t.id];
              return (
                <React.Fragment key={t.id}>
                  <div
                    className="lp-row" onClick={() => onOpen(t)}
                    onDragOver={(e) => e.preventDefault()}
                    onDrop={(e) => {
                      e.stopPropagation();
                      const id = e.dataTransfer.getData("application/x-nexora-task");
                      if (!id || id === t.id) return;
                      const dragged = tasks.find((x) => x.id === id);
                      if (dragged && groupBy !== "none" && !matchesGroupKey(dragged, groupBy, g.key, ctx)) setTaskField(setTasks, id, groupBy, g.key);
                      setTasks((prev) => reorderArray(prev, id, t.id));
                    }}
                    style={urgent ? { borderLeft: "3px solid var(--danger)", backgroundImage: "repeating-linear-gradient(45deg, color-mix(in srgb, var(--danger) 4%, transparent) 0 6px, color-mix(in srgb, var(--danger) 9%, transparent) 6px 12px)" } : late ? { borderLeft: "3px solid var(--danger)", backgroundImage: "repeating-linear-gradient(45deg, color-mix(in srgb, var(--danger) 5%, transparent) 0 6px, color-mix(in srgb, var(--danger) 10%, transparent) 6px 12px)" } : done ? { borderLeft: "3px solid var(--success)", backgroundImage: "repeating-linear-gradient(45deg, color-mix(in srgb, var(--success) 5%, transparent) 0 6px, color-mix(in srgb, var(--success) 10%, transparent) 6px 12px)" } : undefined}
                  >
                    {selectMode && (
                      <input
                        type="checkbox"
                        checked={selectedIds.includes(t.id)}
                        onClick={(e) => e.stopPropagation()}
                        onChange={() => toggleSelect(t.id)}
                        style={{ flex: "0 0 auto", width: 16, height: 16, cursor: "pointer" }}
                      />
                    )}
                    <span className="lp-drag-handle" draggable onMouseDown={(e) => e.stopPropagation()} onDragStart={(e) => { e.stopPropagation(); e.dataTransfer.setData("application/x-nexora-task", t.id); }} onClick={(e) => e.stopPropagation()} title="Glisser pour déplacer">
                      <GripVertical size={13} />
                    </span>
                    <button
                      className="lp-row-checklist-toggle"
                      draggable={false}
                      onMouseDown={(e) => e.stopPropagation()}
                      onClick={(e) => { e.stopPropagation(); toggleChecklistOpen(t.id); }}
                      style={{ visibility: hasChecklist ? "visible" : "hidden" }}
                      title={checklistOpen ? "Replier la checklist" : "Déplier la checklist"}
                    >
                      {checklistOpen ? <ChevronDown size={13} /> : <ChevronRight size={13} />}
                    </button>
                    <button className={"lp-mark-done" + (done ? " done" : "")} draggable={false} onMouseDown={(e) => e.stopPropagation()} onClick={(e) => { e.stopPropagation(); onMarkDone(t.id); }} title="Marquer comme terminé"><CheckCircle2 size={15} /></button><button className="lp-cycle-btn" draggable={false} onMouseDown={(e) => e.stopPropagation()} onClick={(e) => { e.stopPropagation(); onCycleStatus(t.id); }} title="Changer le statut"><RefreshCw size={13} /></button>
                    <div className="lp-row-title">
                      <span className="lp-project-dot" style={{ background: ctx.projects.find((x) => x.id === t.projectId)?.color, width: 16, height: 16, fontSize: 9, flex: "0 0 auto" }}><IconGlyph icon={ctx.projects.find((x) => x.id === t.projectId)?.icon} size={11} /></span>
                      {t.milestone && <MilestoneGlyph size={14} icon={resolveMilestoneIcon(t, ctx)} />}
                      <InlineTextField value={t.title} placeholder="Titre" onCommit={(v) => v.trim() && setTasks((prev) => prev.map((x) => (x.id === t.id ? { ...x, title: v.trim() } : x)))} style={{ fontWeight: 500 }} />
                      {getPrimaryGoogleDriveAttachment(t) && (
                        <a className="lp-icon-btn lp-drive-quick-link" href={getPrimaryGoogleDriveAttachment(t).url} target="_blank" rel="noopener noreferrer" onMouseDown={(e) => e.stopPropagation()} onClick={(e) => e.stopPropagation()} title={`Ouvrir dans Google Drive${getGoogleDriveAttachments(t).length > 1 ? ` (${getGoogleDriveAttachments(t).length} liens)` : ""}`}><Folder size={13} /></a>
                      )}
                    </div>
                    {shownFields.map((f) => <InlineEditableField key={f} fieldKey={f} task={t} ctx={ctx} setTasks={setTasks} gradient={gradient} progressByStatus={progressColorByStatus} onProgressChange={f === "progress" ? updateProgress : undefined} />)}
                    <button className="lp-row-delete" draggable={false} onMouseDown={(e) => e.stopPropagation()} onClick={(e) => { e.stopPropagation(); onDelete(t); }} title="Supprimer la tâche"><Trash2 size={13} /></button>
                  </div>
                  {hasChecklist && checklistOpen && (
                    <div className="lp-row-checklist" onClick={(e) => e.stopPropagation()}>
                      {t.checklist.map((item) => (
                        <label className="lp-checklist-item" key={item.id} onClick={(e) => e.stopPropagation()}>
                          <input type="checkbox" checked={item.done} onChange={() => toggleChecklistItem(t.id, item.id)} />
                          <input
                            type="text"
                            value={item.text}
                            onChange={(e) => updateChecklistItemText(t.id, item.id, e.target.value)}
                            onClick={(e) => e.stopPropagation()}
                            style={{ flex: 1, border: "none", background: "transparent", padding: "2px 4px", fontSize: 12, textDecoration: item.done ? "line-through" : "none", color: item.done ? "var(--text-600)" : "var(--text-900)" }}
                          />
                          <InlineDateField value={item.end} onCommit={(v) => updateChecklistItemDate(t.id, item.id, v)} />
                        </label>
                      ))}
                    </div>
                  )}
                </React.Fragment>
              );
            })}
          </div>
        );
      })}
    </div>
  );
}

// ============================================================================
// Vue Gantt
// ============================================================================
function unitStart(dateStr, unit) {
  if (unit === "day") return dateStr;
  if (unit === "week") return getMonday(dateStr);
  const d = new Date(dateStr + "T00:00:00");
  if (unit === "month") return iso(new Date(d.getFullYear(), d.getMonth(), 1));
  if (unit === "quarter") return iso(new Date(d.getFullYear(), Math.floor(d.getMonth() / 3) * 3, 1));
  if (unit === "year") return iso(new Date(d.getFullYear(), 0, 1));
  return dateStr;
}
function unitLen(dateStr, unit) {
  const d = new Date(dateStr + "T00:00:00");
  if (unit === "day") return 1;
  if (unit === "week") return 7;
  if (unit === "month") { const next = new Date(d.getFullYear(), d.getMonth() + 1, 1); return Math.round((next - d) / DAY_MS); }
  if (unit === "quarter") { const next = new Date(d.getFullYear(), d.getMonth() + 3, 1); return Math.round((next - d) / DAY_MS); }
  if (unit === "year") { const next = new Date(d.getFullYear() + 1, 0, 1); return Math.round((next - d) / DAY_MS); }
  return 1;
}
function unitLabel(dateStr, unit) {
  const dt = new Date(dateStr + "T00:00:00");
  if (unit === "day") return String(dt.getDate());
  if (unit === "week") return "S" + isoWeek(dateStr);
  if (unit === "month") return dt.toLocaleDateString("fr-FR", { month: "short" });
  if (unit === "quarter") return "T" + (Math.floor(dt.getMonth() / 3) + 1);
  if (unit === "year") return String(dt.getFullYear());
  return dateStr;
}
function topKeyFor(dateStr, topUnit) {
  return unitStart(dateStr, topUnit);
}
function topLabelFor(dateStr, topUnit) {
  const dt = new Date(dateStr + "T00:00:00");
  if (topUnit === "week") return "S" + isoWeek(dateStr);
  if (topUnit === "month") return monthLabel(dateStr);
  if (topUnit === "year") return String(dt.getFullYear());
  return dateStr;
}
const ZOOMS = [
  { key: "day", label: "Jour", dayWidth: 34, unit: "day", top: "week", pad: 7 },
  { key: "week", label: "Semaine", dayWidth: 26, unit: "week", top: "month", pad: 10 },
  { key: "month", label: "Mois", dayWidth: 9, unit: "month", top: "year", pad: 35 },
  { key: "quarter", label: "Trimestre", dayWidth: 3.2, unit: "quarter", top: "year", pad: 100 },
  { key: "year", label: "Année", dayWidth: 1, unit: "year", top: null, pad: 400 },
  { key: "5years", label: "5 ans", dayWidth: 0.22, unit: "year", top: null, pad: 1500 },
];
const GANTT_COL_OPTIONS = [
  { key: "status",   label: "Statut",      w: 90 },
  { key: "criticality", label: "Criticité", w: 90 },
  { key: "taskType", label: "Type",        w: 90 },
  { key: "project",  label: "Projet",      w: 100 },
  { key: "assignee", label: "Responsable", w: 110 },
  { key: "start",    label: "Début",       w: 90 },
  { key: "end",      label: "Fin",         w: 90 },
  { key: "progress", label: "Avancement",  w: 80 },
  { key: "period",   label: "Période",     w: 80 },
];
const BUBBLE_FIELD_OPTIONS = ["status", "criticality", "taskType", "project", "assignee", "start", "end", "period", "progress", "milestone", "desc", "checklist"];

// ============================================================================
// Annotations du Gantt — blocs temporels et encadrés
//
// Logique pure (ni React, ni DOM), partagée par le rendu du Gantt et par
// l'éditeur d'annotations : un seul jeu de règles, jamais recopié.
// Les tests unitaires extraient ce bloc de dist/index.html entre les deux
// sentinelles ci-dessous et l'évaluent tel quel — il ne doit donc utiliser
// aucun helper défini ailleurs dans le fichier.
// ============================================================================
// === NEXORA:GANTT-ANNOTATIONS:START ===
const GANTT_BLOCK_DEFAULT_COLOR = "#4F6AF5";
const GANTT_FRAME_DEFAULT_COLOR = "#D64545";
const GANTT_FRAME_DEFAULT_PADDING = 4;
const GANTT_FRAME_MAX_PADDING = 24;

function isGanttIsoDate(value) {
  if (typeof value !== "string" || !/^\d{4}-\d{2}-\d{2}$/.test(value)) return false;
  const [y, m, d] = value.split("-").map(Number);
  const dt = new Date(Date.UTC(y, m - 1, d));
  return dt.getUTCFullYear() === y && dt.getUTCMonth() === m - 1 && dt.getUTCDate() === d;
}

// Retour d'erreur volontairement dans le style du reste de Nexora : un message
// court sous le champ, et aucun enregistrement tant qu'il est présent.
function validateTemporalBlock(block) {
  const title = block && typeof block.title === "string" ? block.title.trim() : "";
  if (!title) return { ok: false, error: "Le titre est obligatoire." };
  if (!isGanttIsoDate(block.startDate)) return { ok: false, error: "La date de début est invalide." };
  if (!isGanttIsoDate(block.endDate)) return { ok: false, error: "La date de fin est invalide." };
  if (block.endDate < block.startDate) return { ok: false, error: "La date de fin doit être postérieure ou égale à la date de début." };
  return { ok: true, error: "" };
}

function normalizeGanttBorderStyle(value) { return value === "solid" ? "solid" : "dashed"; }

function normalizeGanttPadding(value) {
  const n = Number(value);
  if (!Number.isFinite(n)) return GANTT_FRAME_DEFAULT_PADDING;
  return Math.min(GANTT_FRAME_MAX_PADDING, Math.max(0, Math.round(n)));
}

// Migration non destructive : une configuration Gantt sans annotations donne
// simplement des listes vides, et une entrée illisible est ignorée plutôt que
// de casser le rendu de tout le diagramme.
function normalizeTemporalBlocks(list) {
  if (!Array.isArray(list)) return [];
  return list
    .filter((b) => b && typeof b === "object" && b.id && validateTemporalBlock(b).ok)
    .map((b) => ({
      id: String(b.id),
      title: String(b.title).trim(),
      startDate: b.startDate,
      endDate: b.endDate,
      kind: normalizeGanttBlockKind(b.kind),
      color: typeof b.color === "string" && b.color
        ? b.color
        : (normalizeGanttBlockKind(b.kind) === "decision" ? GANTT_DECISION_DEFAULT_COLOR : GANTT_BLOCK_DEFAULT_COLOR),
      borderStyle: normalizeGanttBorderStyle(b.borderStyle),
    }));
}

function normalizeHighlightFrames(list) {
  if (!Array.isArray(list)) return [];
  return list
    .filter((f) => f && typeof f === "object" && f.id)
    .map((f) => ({
      id: String(f.id),
      label: typeof f.label === "string" ? f.label : "",
      taskIds: Array.isArray(f.taskIds) ? [...new Set(f.taskIds.filter((id) => typeof id === "string" && id))] : [],
      color: typeof f.color === "string" && f.color ? f.color : GANTT_FRAME_DEFAULT_COLOR,
      borderStyle: normalizeGanttBorderStyle(f.borderStyle),
      padding: normalizeGanttPadding(f.padding),
    }));
}

// Groupes continus de lignes sélectionnées, dans l'ordre d'affichage : une
// tâche absente (supprimée, masquée par un filtre, repliée dans un groupe)
// n'apparaît pas dans orderedIds et coupe donc naturellement la série.
function ganttContinuousRuns(orderedIds, selectedIds) {
  const selected = new Set(Array.isArray(selectedIds) ? selectedIds : []);
  const runs = [];
  let current = null;
  (Array.isArray(orderedIds) ? orderedIds : []).forEach((id) => {
    if (selected.has(id)) {
      if (!current) { current = []; runs.push(current); }
      current.push(id);
    } else current = null;
  });
  return runs;
}

// rows : lignes visibles du Gantt, dans l'ordre d'affichage, chacune décrite
// par sa géométrie MESURÉE (top/height en pixels, ce qui suit sans recalcul les
// bulles dépliées, la densité et les en-têtes de groupe) et par ses bornes
// temporelles (startIdx/endIdx en index de jour).
//
// Une frontière de groupe coupe toujours la continuité : deux lignes séparées
// par un en-tête de groupe ne sont pas adjacentes à l'écran, et produisent donc
// deux cadres distincts.
function ganttFrameSegments(rows, frame) {
  const list = Array.isArray(rows) ? rows.filter((r) => r && typeof r.id === "string") : [];
  const padding = normalizeGanttPadding(frame && frame.padding);
  const byId = new Map(list.map((r) => [r.id, r]));
  const chunks = [];
  list.forEach((row) => {
    const last = chunks[chunks.length - 1];
    if (last && last.groupKey === row.groupKey) last.ids.push(row.id);
    else chunks.push({ groupKey: row.groupKey, ids: [row.id] });
  });
  const segments = [];
  chunks.forEach((chunk) => {
    ganttContinuousRuns(chunk.ids, frame && frame.taskIds).forEach((ids) => {
      const cells = ids.map((id) => byId.get(id));
      const starts = cells.map((r) => Number(r.startIdx)).filter((n) => Number.isFinite(n));
      const ends = cells.map((r) => Number(r.endIdx)).filter((n) => Number.isFinite(n));
      if (!starts.length || !ends.length) return;
      const tops = cells.map((r) => Number(r.top) || 0);
      const bottoms = cells.map((r) => (Number(r.top) || 0) + (Number(r.height) || 0));
      segments.push({
        ids,
        top: Math.min(...tops) - padding,
        height: Math.max(...bottoms) - Math.min(...tops) + padding * 2,
        startIdx: Math.min(...starts),
        endIdx: Math.max(...ends),
        padding,
      });
    });
  });
  return segments;
}

// Nettoyage explicite, déclenché depuis l'éditeur uniquement — jamais au rendu,
// pour qu'un simple filtre de vue ne détruise pas une configuration : on retire
// les tâches qui n'existent plus, et l'encadré disparaît s'il n'en reste aucune.
function pruneHighlightFrames(frames, knownTaskIds) {
  const known = new Set(Array.isArray(knownTaskIds) ? knownTaskIds : []);
  return normalizeHighlightFrames(frames)
    .map((f) => ({ ...f, taskIds: f.taskIds.filter((id) => known.has(id)) }))
    .filter((f) => f.taskIds.length > 0);
}

// --- Mini-Gantt : fenêtres de décision, jalons, risques, annotations --------
// Tout vit dans la configuration du widget, jamais dans les données métier.
const GANTT_DECISION_DEFAULT_COLOR = "#8B5CF6";
const MINIGANTT_MILESTONE_TYPES = ["standard", "decision", "contractual", "delivery", "commissioning"];
const MINIGANTT_MILESTONE_COLORS = {
  standard: "#4F6AF5",
  decision: "#8B5CF6",
  contractual: "#0EA5E9",
  delivery: "#22B07D",
  commissioning: "#F2A93B",
};
const MINIGANTT_RISK_STYLES = ["solid", "dashed", "hatched"];
const MINIGANTT_RISK_SEVERITIES = ["low", "medium", "high", "critical"];
const MINIGANTT_RISK_DEFAULT_COLOR = "#D64545";
// Durée par défaut d'un risque, en jours, quand aucun décalage explicite n'est
// donné : plus la gravité est forte, plus le couloir d'incertitude est long.
const MINIGANTT_RISK_DEFAULT_DAYS = { low: 2, medium: 5, high: 10, critical: 15 };
const MINIGANTT_RISK_SEVERITY_LABELS = { low: "faible", medium: "moyen", high: "élevé", critical: "critique" };
const MINIGANTT_MILESTONE_LABELS = {
  standard: "Jalon",
  decision: "Décision",
  contractual: "Engagement contractuel",
  delivery: "Livraison",
  commissioning: "Mise en service",
};

function normalizeGanttBlockKind(value) { return value === "decision" ? "decision" : "phase"; }

function normalizeMiniGanttMilestones(list) {
  if (!Array.isArray(list)) return [];
  return list
    .filter((m) => m && typeof m === "object" && m.id && isGanttIsoDate(m.date) && String(m.title || "").trim())
    .map((m) => {
      const type = MINIGANTT_MILESTONE_TYPES.includes(m.type) ? m.type : "standard";
      return {
        id: String(m.id),
        title: String(m.title).trim(),
        date: m.date,
        type,
        color: typeof m.color === "string" && m.color ? m.color : MINIGANTT_MILESTONE_COLORS[type],
        taskId: typeof m.taskId === "string" && m.taskId ? m.taskId : null,
      };
    });
}

function normalizeGanttOffset(value) {
  if (value === null || value === undefined || value === "") return null;
  const n = Number(value);
  return Number.isFinite(n) ? Math.round(n) : null;
}

function normalizeMiniGanttRisks(list) {
  if (!Array.isArray(list)) return [];
  return list
    .filter((r) => r && typeof r === "object" && r.id && typeof r.taskId === "string" && r.taskId)
    .map((r) => ({
      id: String(r.id),
      taskId: r.taskId,
      title: String(r.title || "").trim(),
      color: typeof r.color === "string" && r.color ? r.color : MINIGANTT_RISK_DEFAULT_COLOR,
      style: MINIGANTT_RISK_STYLES.includes(r.style) ? r.style : "hatched",
      severity: MINIGANTT_RISK_SEVERITIES.includes(r.severity) ? r.severity : "medium",
      // `null` et `""` valent ABSENT, pas zéro : sans ce garde-fou, normaliser
      // deux fois une liste déjà normalisée transformait « pas de décalage » en
      // « décalage de 0 jour », et tous les couloirs s'effondraient à un jour.
      startOffset: normalizeGanttOffset(r.startOffset),
      endOffset: normalizeGanttOffset(r.endOffset),
    }));
}

function normalizeMiniGanttNotes(list) {
  if (!Array.isArray(list)) return [];
  return list
    .filter((n) => n && typeof n === "object" && n.id && String(n.title || "").trim())
    .map((n) => {
      const anchor = n.anchor && typeof n.anchor === "object" ? n.anchor : {};
      const kind = ["task", "risk", "milestone", "date"].includes(anchor.kind) ? anchor.kind : "date";
      return {
        id: String(n.id),
        title: String(n.title).trim(),
        text: String(n.text || ""),
        anchor: {
          kind,
          id: typeof anchor.id === "string" ? anchor.id : null,
          date: isGanttIsoDate(anchor.date) ? anchor.date : null,
        },
      };
    })
    .filter((n) => (n.anchor.kind === "date" ? !!n.anchor.date : !!n.anchor.id));
}

// Couloirs d'incertitude placés APRÈS la fin de la barre, à la suite les uns
// des autres dans l'ordre de la liste.
//
// rows : lignes visibles, `[{ id, endIdx }]` en index de jour. Un risque dont
// la tâche n'est pas visible (supprimée, filtrée, groupe replié) est ignoré —
// jamais une erreur de rendu.
//
// Décalages : `startOffset` et `endOffset` comptent les jours À PARTIR DE LA FIN
// de la tâche. Sans `startOffset`, le risque reprend là où le précédent s'arrête
// (chaînage) ; sans `endOffset`, il dure le nombre de jours par défaut de sa
// gravité. Deux risques qui se recouvrent malgré tout sont empilés sur des
// couloirs distincts (`lane`) plutôt que dessinés l'un sur l'autre.
function miniGanttRiskSegments(rows, risks) {
  const byTask = new Map((Array.isArray(rows) ? rows : []).filter((r) => r && typeof r.id === "string").map((r) => [r.id, r]));
  const grouped = new Map();
  normalizeMiniGanttRisks(risks).forEach((risk) => {
    if (!byTask.has(risk.taskId)) return;
    if (!grouped.has(risk.taskId)) grouped.set(risk.taskId, []);
    grouped.get(risk.taskId).push(risk);
  });
  const segments = [];
  grouped.forEach((list, taskId) => {
    const row = byTask.get(taskId);
    const taskEnd = Number(row.endIdx);
    if (!Number.isFinite(taskEnd)) return;
    let cursor = taskEnd;
    const placed = [];
    list.forEach((risk) => {
      const start = risk.startOffset != null ? taskEnd + risk.startOffset : cursor;
      const fallback = MINIGANTT_RISK_DEFAULT_DAYS[risk.severity] || MINIGANTT_RISK_DEFAULT_DAYS.medium;
      const end = risk.endOffset != null ? taskEnd + risk.endOffset : start + fallback;
      const startIdx = Math.min(start, end);
      const endIdx = Math.max(start, end, startIdx + 1);
      let lane = 0;
      while (placed.some((p) => p.lane === lane && startIdx < p.endIdx && p.startIdx < endIdx)) lane += 1;
      const segment = { ...risk, taskId, startIdx, endIdx, lane };
      placed.push(segment);
      segments.push(segment);
      cursor = Math.max(cursor, endIdx);
    });
  });
  return segments;
}

// Étiquettes des couloirs de risque.
//
// Deux risques qui se chevauchent dans le temps voient leurs COULOIRS empilés
// sur des niveaux distincts, séparés de quelques pixels : assez pour deux
// filets de 9 px de haut, beaucoup trop peu pour deux textes, qui se
// recouvraient alors mot pour mot.
//
// Les étiquettes tiennent donc sur UNE SEULE ligne : chacune est posée à la
// suite de son couloir, puis repoussée vers la droite tant qu'elle
// recouvrirait celle d'un risque précédent de la même tâche. Le calcul se fait
// en pixels, sur la largeur réellement mesurée de la piste.
const MINIGANTT_RISK_LABEL_GAP = 7;
const MINIGANTT_RISK_LABEL_OFFSET = 4;
// Quand la première ligne est pleine jusqu'au bord de la piste, l'étiquette
// passe à la ligne suivante plutôt que de disparaître. Deux lignes suffisent :
// au-delà, l'empilement mordrait sur la ligne voisine.
const MINIGANTT_RISK_LABEL_LINES = 2;
const MINIGANTT_RISK_LABEL_LINE_H = 12;

// Texte 8,5 px gras (Inter), casse mixte : ~4,6 px par caractère. Légèrement
// généreux — sous-estimer laisserait deux étiquettes se toucher, surestimer
// trop les repousserait hors de la piste et les ferait disparaître.
function miniGanttRiskLabelWidth(title) {
  return 5 + String(title || "").length * 4.6;
}

function miniGanttRiskLabelLayout(segments, options) {
  const opts = options || {};
  const trackPx = Number(opts.trackPx) || 0;
  const minIdx = Number(opts.minIdx) || 0;
  const span = Number(opts.span) || 1;
  const maxIdx = Number.isFinite(Number(opts.maxIdx)) ? Number(opts.maxIdx) : minIdx + span;
  const placements = new Map();
  if (trackPx <= 0) return placements;

  const byTask = new Map();
  (Array.isArray(segments) ? segments : []).forEach((seg) => {
    if (!seg || !seg.id || !seg.title) return;
    if (!byTask.has(seg.taskId)) byTask.set(seg.taskId, []);
    byTask.get(seg.taskId).push(seg);
  });

  byTask.forEach((list) => {
    const cursors = [];
    list
      .slice()
      .sort((a, b) => a.endIdx - b.endIdx || a.startIdx - b.startIdx)
      .forEach((seg) => {
        const to = Math.min(maxIdx, seg.endIdx);
        const natural = ((to - minIdx) / span) * trackPx + MINIGANTT_RISK_LABEL_OFFSET;
        const width = miniGanttRiskLabelWidth(seg.title);
        for (let line = 0; line < MINIGANTT_RISK_LABEL_LINES; line += 1) {
          const cursor = cursors[line] === undefined ? -Infinity : cursors[line];
          const left = Math.max(natural, cursor);
          if (left < 0 || left + width > trackPx) continue;
          cursors[line] = left + width + MINIGANTT_RISK_LABEL_GAP;
          placements.set(seg.id, { leftPct: (left / trackPx) * 100, line });
          return;
        }
        // Aucune ligne ne peut l'accueillir sans déborder de la piste : elle
        // serait tronquée de toute façon, et l'infobulle du couloir dit tout.
      });
  });
  return placements;
}

// ENCADRÉS DANS LA VUE MÉTRO — les lignes y sont des PROJETS, pas des tâches.
// La règle du Gantt reste la même (un cadre par groupe CONTINU de lignes), mais
// la continuité s'apprécie sur l'ordre d'affichage des projets : un encadré qui
// couvre les lignes 1 et 3 produit deux cadres, jamais un seul qui engloberait
// la ligne 2 sans la concerner.
function metroFrameSegments(frames, options) {
  const opts = options || {};
  const order = Array.isArray(opts.projectOrder) ? opts.projectOrder : [];
  const projectOf = typeof opts.projectOf === "function" ? opts.projectOf : () => null;
  const index = new Map(order.map((id, i) => [id, i]));
  const out = [];

  (Array.isArray(frames) ? frames : []).forEach((frame) => {
    if (!frame || !frame.id) return;
    const byRow = new Map();
    (Array.isArray(frame.taskIds) ? frame.taskIds : []).forEach((taskId) => {
      const projectId = projectOf(taskId);
      if (projectId == null || !index.has(projectId)) return;
      if (!byRow.has(projectId)) byRow.set(projectId, []);
      byRow.get(projectId).push(taskId);
    });
    if (byRow.size === 0) return;

    const rows = [...byRow.keys()].sort((a, b) => index.get(a) - index.get(b));
    let run = [];
    const flush = () => {
      if (!run.length) return;
      out.push({
        id: frame.id + ":" + run[0],
        frame,
        projectIds: [...run],
        taskIds: run.reduce((acc, projectId) => acc.concat(byRow.get(projectId)), []),
      });
      run = [];
    };
    rows.forEach((projectId, i) => {
      if (i > 0 && index.get(projectId) !== index.get(rows[i - 1]) + 1) flush();
      run.push(projectId);
    });
    flush();
  });
  return out;
}

// Méta blocs temporels : définis une seule fois dans les Réglages et dessinés
// dans les Mini-Gantt des tableaux de bord retenus — congés, absences,
// fermeture de site… Ils ne vivent ni dans un widget ni dans une tâche.
function normalizeMetaTemporalBlocks(list) {
  if (!Array.isArray(list)) return [];
  return list
    .filter((b) => b && typeof b === "object" && b.id && validateTemporalBlock(b).ok)
    .map((b) => ({
      id: String(b.id),
      title: String(b.title).trim(),
      startDate: b.startDate,
      endDate: b.endDate,
      kind: normalizeGanttBlockKind(b.kind),
      color: typeof b.color === "string" && b.color
        ? b.color
        : (normalizeGanttBlockKind(b.kind) === "decision" ? GANTT_DECISION_DEFAULT_COLOR : GANTT_BLOCK_DEFAULT_COLOR),
      borderStyle: normalizeGanttBorderStyle(b.borderStyle),
      // Absent = TOUS les tableaux de bord, y compris ceux créés plus tard.
      // Décocher un tableau matérialise la liste.
      dashboardIds: Array.isArray(b.dashboardIds) ? b.dashboardIds.filter((id) => typeof id === "string" && id) : null,
    }));
}

// Méta blocs applicables à un tableau de bord donné. `dashboardId` vaut null
// hors tableau de bord (page « Aujourd'hui ») : seuls les blocs valables pour
// tous s'y appliquent.
function metaBlocksForDashboard(blocks, dashboardId) {
  return normalizeMetaTemporalBlocks(blocks).filter((b) => {
    if (b.dashboardIds === null) return true;
    return dashboardId ? b.dashboardIds.includes(dashboardId) : false;
  });
}

// Une tâche d'un projet calendrier peut devenir elle-même un méta bloc : la
// case est cochée dans la fiche de tâche, l'habillage est réglé au même
// endroit, mais le titre et les dates restent ceux de la tâche. Rien n'est
// recopié : déplacer l'événement dans Google Calendar déplace le bloc.
const TASK_META_BLOCK_ID_PREFIX = "task:";

function normalizeTaskMetaBlock(meta) {
  if (!meta || typeof meta !== "object" || !meta.enabled) return null;
  const kind = normalizeGanttBlockKind(meta.kind);
  return {
    enabled: true,
    kind,
    color: typeof meta.color === "string" && meta.color
      ? meta.color
      : (kind === "decision" ? GANTT_DECISION_DEFAULT_COLOR : GANTT_BLOCK_DEFAULT_COLOR),
    borderStyle: normalizeGanttBorderStyle(meta.borderStyle),
    // Même convention que les méta blocs des Réglages : absent = tous les
    // tableaux de bord, y compris ceux créés plus tard.
    dashboardIds: Array.isArray(meta.dashboardIds) ? meta.dashboardIds.filter((id) => typeof id === "string" && id) : null,
  };
}

// Méta blocs dérivés des tâches. Un jalon (pas de date de fin) tient sur sa
// seule journée. Une tâche dont les dates sont incomplètes est ignorée plutôt
// que de casser le rendu.
function metaBlocksFromTasks(tasks) {
  const blocks = [];
  (Array.isArray(tasks) ? tasks : []).forEach((t) => {
    if (!t || !t.id) return;
    const meta = normalizeTaskMetaBlock(t.metaBlock);
    if (!meta) return;
    const candidate = {
      id: TASK_META_BLOCK_ID_PREFIX + t.id,
      title: typeof t.title === "string" ? t.title.trim() : "",
      startDate: t.start,
      endDate: t.milestone ? t.start : (t.end || t.start),
      kind: meta.kind,
      color: meta.color,
      borderStyle: meta.borderStyle,
      dashboardIds: meta.dashboardIds,
    };
    if (!validateTemporalBlock(candidate).ok) return;
    blocks.push(candidate);
  });
  return blocks;
}

// Source unique des méta blocs : ceux des Réglages d'abord, puis ceux portés
// par les tâches calendrier.
function mergeMetaTemporalBlocks(settingsBlocks, tasks) {
  return [...normalizeMetaTemporalBlocks(settingsBlocks), ...metaBlocksFromTasks(tasks)];
}

// Les imports calendrier reconstruisent entièrement leurs tâches à chaque
// synchronisation : l'identifiant Nexora change, l'événement non. La clé
// stable de l'événement permet donc de reporter le réglage « méta bloc »
// d'une synchronisation à la suivante.
function calendarTaskEventKey(task) {
  if (!task) return "";
  if (task.googleEventId) return "gcal:" + (task.gcalCalendarId || "") + ":" + task.googleEventId;
  if (task.syncedCalendarKey) return "sync:" + (task.syncedCalendarId || "") + ":" + task.syncedCalendarKey;
  return "";
}

function carryOverTaskMetaBlocks(previousTasks, freshTasks) {
  const fresh = Array.isArray(freshTasks) ? freshTasks : [];
  const byKey = new Map();
  (Array.isArray(previousTasks) ? previousTasks : []).forEach((t) => {
    const key = calendarTaskEventKey(t);
    const meta = normalizeTaskMetaBlock(t && t.metaBlock);
    if (key && meta) byKey.set(key, meta);
  });
  if (byKey.size === 0) return fresh;
  return fresh.map((t) => {
    const meta = byKey.get(calendarTaskEventKey(t));
    return meta ? { ...t, metaBlock: meta } : t;
  });
}

// Les risques de délai appartiennent à la TÂCHE (`task.delayRisks`), pas au
// widget : le même risque apparaît donc dans tous les Mini-Gantt qui affichent
// cette tâche. Le registre de risques de Nexora (`nexora:risks`) reste un objet
// distinct — projet, probabilité et impact — et n'est pas touché.
function normalizeTaskDelayRisks(list) {
  return normalizeMiniGanttRisks((Array.isArray(list) ? list : []).map((r) => ({ ...r, taskId: "-" })))
    .map(({ taskId, ...rest }) => rest);
}

// Liste à plat, telle que l'attendent miniGanttRiskSegments et l'éditeur.
function collectTaskDelayRisks(tasks) {
  const flat = [];
  (Array.isArray(tasks) ? tasks : []).forEach((t) => {
    if (!t || !t.id || !Array.isArray(t.delayRisks)) return;
    normalizeTaskDelayRisks(t.delayRisks).forEach((risk) => flat.push({ ...risk, taskId: t.id }));
  });
  return flat;
}

// Réécrit une liste à plat sur les tâches concernées, en ne touchant que celles
// dont la liste change réellement — une tâche vidée de ses risques est mise à
// jour elle aussi, sinon la suppression ne serait jamais enregistrée.
function applyTaskDelayRisks(flat, tasks, updateTask) {
  const grouped = new Map();
  (Array.isArray(flat) ? flat : []).forEach((risk) => {
    if (!risk || !risk.taskId) return;
    const { taskId, ...rest } = risk;
    if (!grouped.has(taskId)) grouped.set(taskId, []);
    grouped.get(taskId).push(rest);
  });
  const touched = [];
  (Array.isArray(tasks) ? tasks : []).forEach((task) => {
    if (!task || !task.id) return;
    const next = grouped.get(task.id) || [];
    const prev = Array.isArray(task.delayRisks) ? task.delayRisks : [];
    if (!next.length && !prev.length) return;
    if (JSON.stringify(prev) === JSON.stringify(next)) return;
    touched.push(task.id);
    if (typeof updateTask === "function") updateTask(task.id, { delayRisks: next });
  });
  return touched;
}

// Fenêtre temporelle minimale couvrant une sélection de lignes, élargie d'une
// marge et des couloirs de risque qui prolongent ces lignes.
function miniGanttSelectionWindow(rows, selectedIds, riskSegments, pad = 1) {
  const selected = new Set(Array.isArray(selectedIds) ? selectedIds : []);
  const kept = (Array.isArray(rows) ? rows : []).filter((r) => r && selected.has(r.id));
  if (!kept.length) return null;
  let minIdx = Infinity;
  let maxIdx = -Infinity;
  kept.forEach((r) => {
    const s = Number(r.startIdx);
    const e = Number(r.endIdx);
    if (Number.isFinite(s)) minIdx = Math.min(minIdx, s);
    if (Number.isFinite(e)) maxIdx = Math.max(maxIdx, e);
  });
  (Array.isArray(riskSegments) ? riskSegments : []).forEach((seg) => {
    if (!selected.has(seg.taskId)) return;
    if (Number.isFinite(seg.endIdx)) maxIdx = Math.max(maxIdx, seg.endIdx);
  });
  if (!Number.isFinite(minIdx) || !Number.isFinite(maxIdx)) return null;
  const margin = Math.max(0, Math.round(pad));
  return { minIdx: minIdx - margin, maxIdx: Math.max(minIdx - margin + 1, maxIdx + margin) };
}

// Accentuation d'une ligne, déduite de ce que l'utilisateur a déjà déclaré —
// aucun second système de marquage à tenir à jour :
// « risque » vient de la gravité des risques posés sur la tâche,
// « critique » du chemin critique calculé par le widget.
function miniGanttRowEmphasis(taskId, riskSegments, criticalIds) {
  const risks = (Array.isArray(riskSegments) ? riskSegments : []).filter((r) => r.taskId === taskId);
  if (risks.some((r) => r.severity === "critical" || r.severity === "high")) return "risk";
  if (criticalIds && typeof criticalIds.has === "function" && criticalIds.has(taskId)) return "critical";
  if (risks.length) return "watch";
  return "none";
}
// === NEXORA:GANTT-ANNOTATIONS:END ===

// === NEXORA:PROJECT-TREEMAP:START ===
// Widget « Treemap projets ». Règle fondatrice : UNE TUILE = UN PROJET. Une
// tâche n'est jamais une tuile — elle ne sert qu'à calculer les métriques du
// projet auquel elle appartient.
//
// Tout ce bloc est PUR : il ne connaît ni React, ni le moteur de filtres de
// Nexora. L'application lui passe des prédicats et des faits déjà construits
// (`sizeMatch`, `colorMatch`, `factsOf`), ce qui rend chaque règle testable
// sans monter l'interface.

const TREEMAP_COLOR_MODES = ["sizeFilterGradient", "secondaryFilterGradient", "averageCriticality"];
const TREEMAP_GROUP_BY = ["none", "folder", "priority", "owner", "criticality"];
const TREEMAP_GRADIENT_DIRECTIONS = ["lowToHigh", "highToLow"];
// Couleur des projets dont la valeur de coloration est absente ou nulle : un
// gris neutre, jamais une couleur d'alerte.
const TREEMAP_NEUTRAL_COLOR = "#E6EAF1";

// Palettes sobres : le bas de l'échelle reste quasi neutre, la couleur forte
// est réservée au haut. Un portefeuille sain ne doit pas s'afficher en rouge.
const TREEMAP_PALETTES = {
  ember: { label: "Maîtrisé → critique", stops: ["#EDF1F8", "#D5E7DD", "#F6E3B8", "#F0A95F", "#D64545"] },
  ocean: { label: "Océan", stops: ["#EFF4FB", "#CCE0F4", "#93BFE6", "#4F8FD1", "#1E4C8A"] },
  violet: { label: "Violet", stops: ["#F2EFFB", "#DED5F4", "#B8A5E7", "#8B5CF6", "#5B32B8"] },
  slate: { label: "Ardoise", stops: ["#F2F4F8", "#DBE1EA", "#B1BCCC", "#7F8DA4", "#4A5870"] },
  levels: { label: "Palette d'état", stops: ["#22B07D", "#F2A93B", "#F07A3D", "#D64545"], discrete: true },
};
const TREEMAP_DEFAULT_PALETTE = "ember";

// Niveaux de criticité, bornes inférieures incluses.
const TREEMAP_CRITICALITY_LEVELS = [
  { key: "controlled", label: "Maîtrisé", min: 0, color: "#22B07D" },
  { key: "watch", label: "Vigilance", min: 25, color: "#F2A93B" },
  { key: "high", label: "Élevé", min: 50, color: "#F07A3D" },
  { key: "critical", label: "Critique", min: 70, color: "#D64545" },
];

// CRITICITÉ — Nexora n'a pas de champ « criticité » sur la tâche, et en inventer
// un produirait une donnée opaque que personne ne saurait expliquer. Le score
// est donc une RÈGLE DÉTERMINISTE composée uniquement de faits déjà présents
// dans le modèle : retard, statut urgent, échéance proche, jalon, inactivité,
// priorité du projet. Chaque poids retenu est listé tel quel dans l'infobulle
// de la tuile, de sorte qu'un chiffre affiché soit toujours redémontrable.
//
// Une tâche terminée vaut 0 : un projet dont tout est fait doit ressortir calme.
const TREEMAP_CRITICALITY_WEIGHTS = {
  late: 40,
  urgent: 25,
  dueSoon: 10,
  milestone: 10,
  stale: 10,
  projectPriorityHigh: 15,
  projectPriorityNormal: 5,
};
const TREEMAP_DUE_SOON_DAYS = 7;
const TREEMAP_STALE_DAYS = 14;

// facts : { done, late, urgent, milestone, daysToDue, inactivityDays, projectPriority }
// Retourne { score, reasons } — `reasons` sert directement l'infobulle.
function treemapTaskCriticality(facts) {
  const f = facts || {};
  if (f.done) return { score: 0, reasons: [] };
  const W = TREEMAP_CRITICALITY_WEIGHTS;
  const reasons = [];
  let score = 0;
  const add = (points, label) => { score += points; reasons.push({ points, label }); };
  if (f.late) add(W.late, "En retard");
  if (f.urgent) add(W.urgent, "Criticité urgente");
  const days = Number(f.daysToDue);
  if (!f.late && Number.isFinite(days) && days >= 0 && days <= TREEMAP_DUE_SOON_DAYS) add(W.dueSoon, `Échéance dans ${TREEMAP_DUE_SOON_DAYS} jours ou moins`);
  if (f.milestone) add(W.milestone, "Jalon");
  const idle = Number(f.inactivityDays);
  if (Number.isFinite(idle) && idle >= TREEMAP_STALE_DAYS) add(W.stale, `Sans interaction depuis ${TREEMAP_STALE_DAYS} jours`);
  if (f.projectPriority === "high") add(W.projectPriorityHigh, "Projet prioritaire");
  else if (f.projectPriority === "normal") add(W.projectPriorityNormal, "Projet à priorité normale");
  return { score: Math.max(0, Math.min(100, score)), reasons };
}

function treemapCriticalityLevel(score) {
  const n = Number(score);
  const value = Number.isFinite(n) ? n : 0;
  let level = TREEMAP_CRITICALITY_LEVELS[0];
  TREEMAP_CRITICALITY_LEVELS.forEach((l) => { if (value >= l.min) level = l; });
  return level;
}

// Prochaines tâches d'un projet : les non terminées qui portent une échéance,
// de la plus ancienne à la plus récente. La liste est plafonnée à la source —
// au-delà, aucune tuile ne pourrait les afficher.
const TREEMAP_UPCOMING_MAX = 8;
// Hauteur d'une ligne de la liste, en pixels : c'est elle qui décide combien de
// tâches tiennent dans une tuile donnée.
const TREEMAP_UPCOMING_LINE_H = 14;

// Largeur en deçà de laquelle un titre de tâche ne reste pas lisible : une
// puce suivie de trois points n'apprend rien, autant ne rien afficher.
const TREEMAP_UPCOMING_MIN_W = 110;

// Combien de tâches tiennent dans la place restante. Zéro si la place manque :
// mieux vaut aucune ligne qu'une ligne coupée en deux.
function treemapUpcomingCapacity(tileHeight, reservedHeight, tileWidth) {
  if (tileWidth !== undefined && (Number(tileWidth) || 0) < TREEMAP_UPCOMING_MIN_W) return 0;
  const free = (Number(tileHeight) || 0) - (Number(reservedHeight) || 0);
  if (!Number.isFinite(free) || free < TREEMAP_UPCOMING_LINE_H) return 0;
  return Math.max(0, Math.min(TREEMAP_UPCOMING_MAX, Math.floor(free / TREEMAP_UPCOMING_LINE_H)));
}

// Poids minimal d'une tuile : un projet dont le COUNT() est nul reste visible
// (quand le réglage le demande) sans jamais écraser les projets qui portent
// réellement des tâches.
const TREEMAP_ZERO_WEIGHT_RATIO = 0.12;
const TREEMAP_MIN_WEIGHT = 1;

// Statistiques par projet. `tasks` est déjà réduit par les méta-filtres, le
// filtre de page et le filtre du widget : ce bloc ne refiltre rien, il compte.
function computeTreemapProjects(input) {
  const {
    projects = [],
    tasks = [],
    sizeMatch = () => true,
    colorMatch = () => true,
    factsOf = () => ({}),
    extras = {},
    colorMode = "sizeFilterGradient",
    showZeroProjects = false,
  } = input || {};

  const byProject = new Map();
  (Array.isArray(tasks) ? tasks : []).forEach((t) => {
    if (!t || !t.projectId) return;
    if (!byProject.has(t.projectId)) byProject.set(t.projectId, []);
    byProject.get(t.projectId).push(t);
  });

  const rows = [];
  (Array.isArray(projects) ? projects : []).forEach((project) => {
    if (!project || !project.id) return;
    const projectTasks = byProject.get(project.id) || [];
    const sized = projectTasks.filter((t) => sizeMatch(t));
    const colored = projectTasks.filter((t) => colorMatch(t));
    if (!showZeroProjects && sized.length === 0) return;

    let doneCount = 0, lateCount = 0, urgentCount = 0, progressSum = 0, criticalitySum = 0;
    let endDate = null;
    let nextMilestone = null;
    const statusTally = new Map();
    const ownerTally = new Map();
    const upcoming = [];

    sized.forEach((t) => {
      const facts = factsOf(t) || {};
      if (facts.done) doneCount += 1;
      if (facts.late) lateCount += 1;
      if (facts.urgent) urgentCount += 1;
      progressSum += Math.max(0, Math.min(100, Number(t.progress) || 0));
      criticalitySum += treemapTaskCriticality({ ...facts, projectPriority: project.priority || "normal" }).score;
      if (t.end && (!endDate || t.end > endDate)) endDate = t.end;
      if (facts.milestone && !facts.done) {
        const days = Number(facts.daysToDue);
        if (Number.isFinite(days) && days >= 0 && (!nextMilestone || days < nextMilestone.daysToDue)) {
          nextMilestone = { id: t.id, title: t.title, date: t.end, daysToDue: days };
        }
      }
      if (!facts.done && t.end) upcoming.push({ id: t.id, title: t.title, end: t.end, late: !!facts.late });
      if (t.statusId) statusTally.set(t.statusId, (statusTally.get(t.statusId) || 0) + 1);
      const owner = typeof t.assignee === "string" ? t.assignee.trim() : "";
      if (owner) ownerTally.set(owner, (ownerTally.get(owner) || 0) + 1);
    });

    const best = (tally) => {
      let key = null, max = 0;
      tally.forEach((n, k) => { if (n > max) { max = n; key = k; } });
      return key;
    };

    // De la plus ancienne à la plus récente : les échéances dépassées viennent
    // donc naturellement en tête, là où le regard se pose.
    upcoming.sort((a, b) => a.end.localeCompare(b.end) || String(a.title || "").localeCompare(String(b.title || "")));
    const criticalityScore = sized.length ? Math.round(criticalitySum / sized.length) : 0;
    rows.push({
      project,
      projectId: project.id,
      taskCount: projectTasks.length,
      sizeCount: sized.length,
      colorCount: colored.length,
      doneCount,
      lateCount,
      urgentCount,
      progress: sized.length ? Math.round(progressSum / sized.length) : 0,
      criticality: { score: criticalityScore, level: treemapCriticalityLevel(criticalityScore) },
      endDate,
      nextMilestone,
      dominantStatusId: best(statusTally),
      owner: best(ownerTally),
      upcoming: upcoming.slice(0, TREEMAP_UPCOMING_MAX),
      upcomingTotal: upcoming.length,
      ...(extras[project.id] || {}),
    });
  });

  const maxSize = rows.reduce((m, r) => (r.sizeCount > m ? r.sizeCount : m), 0);
  const zeroWeight = Math.max(TREEMAP_MIN_WEIGHT, maxSize * TREEMAP_ZERO_WEIGHT_RATIO);
  rows.forEach((r) => { r.weight = r.sizeCount > 0 ? r.sizeCount : zeroWeight; });

  rows.forEach((r) => { r.colorValue = treemapColorValue(r, colorMode); });
  rows.sort((a, b) => b.sizeCount - a.sizeCount || String(a.project.name || "").localeCompare(String(b.project.name || "")));
  return rows;
}

function treemapColorValue(row, colorMode) {
  if (!row) return 0;
  if (colorMode === "averageCriticality") return row.criticality ? row.criticality.score : 0;
  if (colorMode === "secondaryFilterGradient") return row.colorCount || 0;
  return row.sizeCount || 0;
}

// Plancher de l'échelle des comptages : sans lui, un portefeuille où le pire
// projet compte deux tâches afficherait ce projet — et tous ses égaux — au rouge
// le plus vif. La couleur forte doit rester réservée aux valeurs réellement
// élevées, pas au simple maximum d'un domaine minuscule.
const TREEMAP_MIN_COLOR_SPAN = 4;

// Domaine de l'échelle de couleur. La criticité a un domaine fixe 0–100 : deux
// widgets côte à côte doivent donner la même couleur au même score.
function treemapColorDomain(rows, colorMode) {
  if (colorMode === "averageCriticality") return { min: 0, max: 100 };
  const values = (rows || []).map((r) => Number(r.colorValue) || 0);
  const max = values.length ? Math.max(...values) : 0;
  // `top` est le maximum réellement observé — la légende en a besoin pour
  // annoncer des tranches vraies ; `max` est l'échelle de couleur.
  return { min: 0, max: max > 0 ? Math.max(max, TREEMAP_MIN_COLOR_SPAN) : 0, top: max };
}

function treemapRampColor(stops, t) {
  const list = Array.isArray(stops) && stops.length ? stops : [TREEMAP_NEUTRAL_COLOR];
  if (list.length === 1) return list[0];
  const p = Math.max(0, Math.min(1, Number(t) || 0));
  const scaled = p * (list.length - 1);
  const i = Math.min(list.length - 2, Math.floor(scaled));
  return lerpColor(list[i], list[i + 1], scaled - i);
}

// Couleur d'une tuile. `direction` inverse l'échelle sans toucher aux palettes.
function treemapTileColor(value, domain, paletteKey, direction) {
  const palette = TREEMAP_PALETTES[paletteKey] || TREEMAP_PALETTES[TREEMAP_DEFAULT_PALETTE];
  const min = Number(domain && domain.min) || 0;
  const max = Number(domain && domain.max) || 0;
  // Valeur ABSENTE et valeur ZÉRO ne sont pas la même chose : Number(null) vaut
  // 0, ce qui donnerait au projet sans donnée la couleur du bas d'échelle au
  // lieu du gris neutre.
  if (value === null || value === undefined || value === "") return TREEMAP_NEUTRAL_COLOR;
  const v = Number(value);
  if (!Number.isFinite(v) || max <= min) return TREEMAP_NEUTRAL_COLOR;
  let t = (v - min) / (max - min);
  if (direction === "highToLow") t = 1 - t;
  if (palette.discrete) {
    const idx = Math.min(palette.stops.length - 1, Math.max(0, Math.round(t * (palette.stops.length - 1))));
    return palette.stops[idx];
  }
  return treemapRampColor(palette.stops, t);
}

// Luminance relative, pour choisir un texte lisible sur n'importe quelle tuile
// plutôt que d'imposer une couleur de texte fixe.
function treemapLuminance(hex) {
  const h = String(hex || "").replace("#", "");
  if (h.length !== 6) return 1;
  const channel = (v) => {
    const c = parseInt(v, 16) / 255;
    return c <= 0.03928 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4);
  };
  return 0.2126 * channel(h.slice(0, 2)) + 0.7152 * channel(h.slice(2, 4)) + 0.0722 * channel(h.slice(4, 6));
}

function treemapTextColor(background) {
  return treemapLuminance(background) > 0.45 ? "#0B1526" : "#FFFFFF";
}

// Densité d'une tuile, d'après sa taille réelle en pixels — c'est elle qui
// décide du nombre de champs affichés, jamais une estimation a priori.
function treemapTileDensity(w, h, compact) {
  const width = Number(w) || 0;
  const height = Number(h) || 0;
  const k = compact ? 0.8 : 1;
  if (width >= 190 * k && height >= 118 * k) return "large";
  if (width >= 118 * k && height >= 74 * k) return "medium";
  return "small";
}

// Nombre de champs secondaires tolérés par densité : au-delà, les textes se
// chevaucheraient et la tuile deviendrait illisible.
function treemapSecondaryFieldBudget(density) {
  if (density === "large") return 3;
  if (density === "medium") return 1;
  return 0;
}

// Pavage « squarified » (Bruls, Huizing, van Wijk) : des tuiles aussi proches
// du carré que possible, donc comparables à l'œil. Les tuiles sont placées dans
// le rectangle fourni, sans jamais en sortir.
function squarifyTreemap(items, rect) {
  const list = (Array.isArray(items) ? items : []).filter((i) => i && Number.isFinite(Number(i.weight)) && Number(i.weight) > 0);
  const W = Number(rect && rect.w) || 0;
  const H = Number(rect && rect.h) || 0;
  if (!list.length || W <= 0 || H <= 0) return [];
  const originX = Number(rect.x) || 0;
  const originY = Number(rect.y) || 0;

  const total = list.reduce((s, i) => s + Number(i.weight), 0);
  const k = (W * H) / total;
  const scaled = list
    .map((i) => ({ item: i, area: Number(i.weight) * k }))
    .sort((a, b) => b.area - a.area);

  const out = [];
  let x = originX, y = originY, w = W, h = H;

  const worst = (row, len) => {
    if (!row.length || len <= 0) return Infinity;
    const s = row.reduce((a, b) => a + b.area, 0);
    if (s <= 0) return Infinity;
    const mx = Math.max(...row.map((r) => r.area));
    const mn = Math.min(...row.map((r) => r.area));
    if (mn <= 0) return Infinity;
    const len2 = len * len, s2 = s * s;
    return Math.max((len2 * mx) / s2, s2 / (len2 * mn));
  };

  const layoutRow = (row) => {
    const s = row.reduce((a, b) => a + b.area, 0);
    if (s <= 0) return;
    if (w >= h) {
      const rowW = Math.min(w, s / h);
      let cy = y;
      row.forEach((r, i) => {
        const rowH = i === row.length - 1 ? y + h - cy : (r.area / s) * h;
        out.push({ ...r.item, x, y: cy, w: rowW, h: rowH });
        cy += rowH;
      });
      x += rowW; w -= rowW;
    } else {
      const rowH = Math.min(h, s / w);
      let cx = x;
      row.forEach((r, i) => {
        const rowW = i === row.length - 1 ? x + w - cx : (r.area / s) * w;
        out.push({ ...r.item, x: cx, y, w: rowW, h: rowH });
        cx += rowW;
      });
      y += rowH; h -= rowH;
    }
  };

  let row = [];
  scaled.forEach((entry) => {
    const side = Math.min(w, h);
    const next = [...row, entry];
    if (row.length && worst(row, side) < worst(next, side)) {
      layoutRow(row);
      row = [entry];
    } else {
      row = next;
    }
  });
  if (row.length) layoutRow(row);
  return out;
}

// Répartition verticale des groupes : chaque groupe reçoit une hauteur
// proportionnelle à son poids, jamais inférieure à sa hauteur minimale utile.
function treemapGroupRects(groups, rect, options) {
  const list = (Array.isArray(groups) ? groups : []).filter((g) => g && Array.isArray(g.rows) && g.rows.length);
  const W = Number(rect && rect.w) || 0;
  const H = Number(rect && rect.h) || 0;
  if (!list.length || W <= 0 || H <= 0) return [];
  const opts = options || {};
  const headerH = Number(opts.headerH) || 22;
  const gap = Number(opts.gap) || 8;
  const minBodyH = Number(opts.minBodyH) || 54;

  const weights = list.map((g) => g.rows.reduce((s, r) => s + (Number(r.weight) || 0), 0));
  const totalWeight = weights.reduce((a, b) => a + b, 0) || list.length;
  const available = H - list.length * headerH - Math.max(0, list.length - 1) * gap;
  // Pas la place de tout caser proprement : chaque groupe garde sa hauteur
  // minimale et la zone défile, plutôt que d'écraser les tuiles à néant.
  const bodyTotal = Math.max(available, list.length * minBodyH);

  let cursor = Number(rect.y) || 0;
  return list.map((group, i) => {
    const share = totalWeight > 0 ? weights[i] / totalWeight : 1 / list.length;
    const bodyH = Math.max(minBodyH, Math.round(bodyTotal * share));
    const out = {
      group,
      headerRect: { x: Number(rect.x) || 0, y: cursor, w: W, h: headerH },
      bodyRect: { x: Number(rect.x) || 0, y: cursor + headerH, w: W, h: bodyH },
    };
    cursor += headerH + bodyH + gap;
    return out;
  });
}

// Configuration du widget. Toute valeur absente ou illisible retombe sur une
// valeur sûre : un widget enregistré avant l'ajout d'un réglage continue de
// s'afficher sans migration de données.
const TREEMAP_TILE_FIELDS = [
  { key: "projectName", label: "Nom du projet", locked: true },
  { key: "dominantStatus", label: "Statut dominant des tâches" },
  { key: "owner", label: "Responsable principal" },
  { key: "sizeCount", label: "Tâches du filtre de taille" },
  { key: "colorCount", label: "Tâches du filtre de coloration" },
  { key: "progress", label: "Progression" },
  { key: "averageCriticality", label: "Criticité moyenne" },
  { key: "lateTaskCount", label: "Tâches en retard" },
  { key: "urgentTaskCount", label: "Tâches urgentes" },
  { key: "riskCount", label: "Risques ouverts" },
  { key: "nextMilestone", label: "Prochain jalon" },
  { key: "endDate", label: "Dernière échéance" },
  { key: "budget", label: "Budget consommé" },
  { key: "priority", label: "Priorité du projet" },
  { key: "folder", label: "Dossier" },
];
const TREEMAP_DEFAULT_FIELDS = ["projectName", "sizeCount", "progress", "averageCriticality", "lateTaskCount"];

function normalizeProjectTreemapConfig(widget) {
  const w = widget || {};
  const colorMode = TREEMAP_COLOR_MODES.includes(w.treemapColorMode) ? w.treemapColorMode : "sizeFilterGradient";
  const known = new Set(TREEMAP_TILE_FIELDS.map((f) => f.key));
  const rawFields = Array.isArray(w.treemapFields) ? w.treemapFields : TREEMAP_DEFAULT_FIELDS;
  const fields = [];
  rawFields.forEach((key) => {
    if (typeof key !== "string" || !key) return;
    if (!known.has(key) && !key.startsWith("cf:")) return;
    if (!fields.includes(key)) fields.push(key);
  });
  // Le nom du projet est toujours affiché : sans lui la tuile ne désigne rien.
  if (!fields.includes("projectName")) fields.unshift("projectName");
  const paletteKey = TREEMAP_PALETTES[w.treemapPalette]
    ? w.treemapPalette
    : (colorMode === "averageCriticality" ? "levels" : TREEMAP_DEFAULT_PALETTE);
  return {
    sizeFilter: w.treemapSizeFilter || null,
    colorFilter: w.treemapColorFilter || null,
    colorMode,
    palette: paletteKey,
    direction: TREEMAP_GRADIENT_DIRECTIONS.includes(w.treemapDirection) ? w.treemapDirection : "lowToHigh",
    showZeroProjects: w.treemapShowZeroProjects === true,
    fields,
    showProgressRing: w.treemapShowProgressRing !== false,
    showUpcoming: w.treemapShowUpcoming === true,
    groupBy: TREEMAP_GROUP_BY.includes(w.treemapGroupBy) ? w.treemapGroupBy : "none",
    compact: w.treemapCompact === true,
    showLegend: w.treemapShowLegend !== false,
    showSearch: w.treemapShowSearch !== false,
    openOnClick: w.treemapOpenOnClick !== false,
    radius: ["sharp", "medium", "round"].includes(w.treemapRadius) ? w.treemapRadius : "medium",
    gap: Math.max(0, Math.min(12, Number.isFinite(Number(w.treemapGap)) ? Math.round(Number(w.treemapGap)) : 4)),
    border: w.treemapBorder !== false,
  };
}

// Paliers de la légende : quatre tranches du domaine, avec le nombre de projets
// de chacune — cliquables pour ne garder temporairement que cette tranche.
function treemapLegendBuckets(rows, colorMode, paletteKey, direction) {
  const list = Array.isArray(rows) ? rows : [];
  if (colorMode === "averageCriticality") {
    return TREEMAP_CRITICALITY_LEVELS.map((level, i) => {
      const next = TREEMAP_CRITICALITY_LEVELS[i + 1];
      const max = next ? next.min : 101;
      return {
        key: level.key,
        label: level.label,
        min: level.min,
        max,
        color: treemapTileColor((level.min + Math.min(100, max - 1)) / 2, { min: 0, max: 100 }, paletteKey, direction),
        count: list.filter((r) => r.colorValue >= level.min && r.colorValue < max).length,
      };
    });
  }
  const domain = treemapColorDomain(list, colorMode);
  const top = Number(domain.top) || 0;
  if (top <= 0) return [];
  // Des tranches ENTIÈRES : un comptage de tâches n'a pas de valeur décimale, et
  // « 1–1 » ou « 0–0,5 » ne veut rien dire pour qui lit la légende.
  // top + 1 valeurs distinctes (0 compris) réparties en quatre tranches au plus.
  const step = Math.max(1, Math.ceil((top + 1) / 4));
  const buckets = [];
  for (let start = 0; start <= top; start += step) {
    const last = Math.min(top, start + step - 1);
    buckets.push({
      key: "b" + start,
      label: start === last ? String(start) : `${start}–${last}`,
      min: start,
      max: last + 1,
      color: treemapTileColor((start + last) / 2, domain, paletteKey, direction),
      count: list.filter((r) => r.colorValue >= start && r.colorValue <= last).length,
    });
  }
  return buckets;
}
// === NEXORA:PROJECT-TREEMAP:END ===

// Sélecteur multiple de tâches, respectant l'arborescence Projet → tâches du
// Gantt, avec recherche — même mise en forme (pastille de projet, chip) que le
// reste de Nexora.
function GanttTaskMultiSelect({ tasks, ctx, value, onChange }) {
  const [query, setQuery] = useState("");
  const selected = Array.isArray(value) ? value : [];
  const needle = query.trim().toLowerCase();
  const groups = useMemo(() => {
    const matching = tasks.filter((t) => !needle || (t.title || "").toLowerCase().includes(needle));
    const byProject = new Map();
    matching.forEach((t) => {
      const key = t.projectId || "";
      if (!byProject.has(key)) byProject.set(key, []);
      byProject.get(key).push(t);
    });
    return [...byProject.entries()].map(([projectId, list]) => ({
      projectId,
      project: ctx.projects.find((p) => p.id === projectId) || null,
      tasks: list,
    }));
  }, [tasks, ctx.projects, needle]);
  const toggle = (id) => onChange(selected.includes(id) ? selected.filter((x) => x !== id) : [...selected, id]);
  // Une tâche cochée puis supprimée reste dans la liste enregistrée : on la
  // signale plutôt que de la faire disparaître en silence.
  const missing = selected.filter((id) => !tasks.some((t) => t.id === id));
  return (
    <div className="lp-field">
      <label>Tâches encadrées</label>
      <div className="lp-gantt-annot-search">
        <Search size={12} />
        <input type="text" value={query} onChange={(e) => setQuery(e.target.value)} placeholder="Rechercher une tâche…" />
        {query && <button type="button" className="lp-icon-btn" onClick={() => setQuery("")} title="Effacer"><X size={12} /></button>}
      </div>
      <div className="lp-gantt-annot-tasklist">
        {groups.length === 0 && <p className="lp-gantt-annot-hint" style={{ margin: 6 }}>Aucune tâche ne correspond.</p>}
        {groups.map((g) => (
          <div key={g.projectId || "sans-projet"}>
            <div className="lp-gantt-annot-tasklist-group">
              <span className="lp-project-dot" style={{ background: g.project?.color || "var(--text-muted)", width: 11, height: 11, fontSize: 7 }}>
                <IconGlyph icon={g.project?.icon} size={7} />
              </span>
              {g.project?.name || "Sans projet"}
            </div>
            {g.tasks.map((t) => (
              <label className="lp-checkbox-line" key={t.id}>
                <input type="checkbox" checked={selected.includes(t.id)} onChange={() => toggle(t.id)} /> {t.title}
              </label>
            ))}
          </div>
        ))}
      </div>
      <p className="lp-gantt-annot-hint">
        {selected.length} tâche{selected.length > 1 ? "s" : ""} retenue{selected.length > 1 ? "s" : ""}
        {missing.length > 0 && ` · ${missing.length} tâche${missing.length > 1 ? "s" : ""} introuvable${missing.length > 1 ? "s" : ""}`}
        {" · "}Les tâches non successives produisent plusieurs cadres.
      </p>
    </div>
  );
}

function GanttAnnotationBorderRow({ value, onChange }) {
  return (
    <div className="lp-field">
      <label>Bordure</label>
      <div className="lp-density-row">
        <button type="button" className={"lp-density-btn" + (value !== "solid" ? " active" : "")} onClick={() => onChange("dashed")}>Pointillés</button>
        <button type="button" className={"lp-density-btn" + (value === "solid" ? " active" : "")} onClick={() => onChange("solid")}>Continue</button>
      </div>
    </div>
  );
}

// Éditeur unique des annotations du Gantt : les deux sections repliables sont
// rendues telles quelles dans les paramètres du widget, et dans la modale
// ouverte depuis la barre d'actions du Gantt. Aucune duplication de formulaire.
function GanttAnnotationsEditor({ blocks, frames, tasks, ctx, defaultStart, defaultEnd, onChange, initialSection, focusId, autoCreate, allowDecisionWindows }) {
  const [openBlocks, setOpenBlocks] = useState(initialSection !== "frames");
  const [openFrames, setOpenFrames] = useState(initialSection === "frames");
  const [editingId, setEditingId] = useState(focusId || null);
  const [pendingDelete, setPendingDelete] = useState(null); // { kind, item }
  const knownTaskIds = useMemo(() => tasks.map((t) => t.id), [tasks]);

  const setBlocks = (next) => onChange({ temporalBlocks: next });
  const setFrames = (next) => onChange({ highlightFrames: next });
  const patchBlock = (id, patch) => setBlocks(blocks.map((b) => (b.id === id ? { ...b, ...patch } : b)));
  const patchFrame = (id, patch) => setFrames(frames.map((f) => (f.id === id ? { ...f, ...patch } : f)));
  const move = (list, setList, id, dir) => {
    const i = list.findIndex((x) => x.id === id);
    const j = i + dir;
    if (i < 0 || j < 0 || j >= list.length) return;
    const next = [...list];
    [next[i], next[j]] = [next[j], next[i]];
    setList(next);
  };

  const addBlock = () => {
    const created = { id: uid(), title: "Nouvelle phase", startDate: defaultStart, endDate: defaultEnd, color: GANTT_BLOCK_DEFAULT_COLOR, borderStyle: "dashed" };
    setBlocks([...blocks, created]);
    setOpenBlocks(true);
    setEditingId(created.id);
  };
  const addFrame = () => {
    const created = { id: uid(), label: "", taskIds: [], color: GANTT_FRAME_DEFAULT_COLOR, borderStyle: "dashed", padding: GANTT_FRAME_DEFAULT_PADDING };
    setFrames([...frames, created]);
    setOpenFrames(true);
    setEditingId(created.id);
  };
  const duplicateBlock = (b) => {
    const copy = { ...b, id: uid(), title: `${b.title} (copie)` };
    const i = blocks.findIndex((x) => x.id === b.id);
    setBlocks([...blocks.slice(0, i + 1), copy, ...blocks.slice(i + 1)]);
    setEditingId(copy.id);
  };
  const duplicateFrame = (f) => {
    const copy = { ...f, id: uid(), label: f.label ? `${f.label} (copie)` : "", taskIds: [...f.taskIds] };
    const i = frames.findIndex((x) => x.id === f.id);
    setFrames([...frames.slice(0, i + 1), copy, ...frames.slice(i + 1)]);
    setEditingId(copy.id);
  };
  // « + Bloc temporel » / « + Encadré » de la barre d'actions du Gantt : la
  // création passe par le même chemin que le bouton « Ajouter » de la section,
  // puis le formulaire correspondant s'ouvre — jamais un second formulaire.
  const autoCreated = useRef(false);
  useEffect(() => {
    if (autoCreated.current || !autoCreate) return;
    autoCreated.current = true;
    if (autoCreate === "frame") addFrame();
    else addBlock();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [autoCreate]);

  const confirmDelete = () => {
    if (!pendingDelete) return;
    if (pendingDelete.kind === "block") setBlocks(blocks.filter((b) => b.id !== pendingDelete.item.id));
    else setFrames(frames.filter((f) => f.id !== pendingDelete.item.id));
    setPendingDelete(null);
  };

  const RowActions = ({ item, list, setList, kind, onDuplicate }) => (
    <span className="lp-gantt-annot-actions" onClick={(e) => e.stopPropagation()}>
      <button type="button" className="lp-icon-btn" onClick={() => move(list, setList, item.id, -1)} disabled={list[0]?.id === item.id} title="Monter"><ChevronUp size={12} /></button>
      <button type="button" className="lp-icon-btn" onClick={() => move(list, setList, item.id, 1)} disabled={list[list.length - 1]?.id === item.id} title="Descendre"><ChevronDown size={12} /></button>
      <button type="button" className="lp-icon-btn" onClick={() => onDuplicate(item)} title="Dupliquer"><Copy size={12} /></button>
      <button type="button" className="lp-icon-btn" onClick={() => setPendingDelete({ kind, item })} title="Supprimer"><Trash2 size={12} /></button>
    </span>
  );

  return (
    <>
      <div className="lp-widget-appearance-toggle" onClick={() => setOpenBlocks((v) => !v)}>
        <ChevronRight size={13} style={{ transform: openBlocks ? "rotate(90deg)" : "none" }} />
        <Layers size={13} /> Blocs temporels
        <span className="lp-widget-appearance-hint">{blocks.length || "aucun"}</span>
      </div>
      {openBlocks && (
        <div className="lp-widget-appearance-panel">
          <p className="lp-gantt-annot-hint" style={{ marginTop: 0 }}>
            Une grande phase transverse — Études, Gros œuvre, Second œuvre… — dessinée sur toute la hauteur du diagramme.
          </p>
          {blocks.map((b) => {
            const validation = validateTemporalBlock(b);
            const editing = editingId === b.id;
            return (
              <div className={"lp-gantt-annot-item" + (editing ? " editing" : "")} key={b.id}>
                <div className="lp-gantt-annot-head" onClick={() => setEditingId(editing ? null : b.id)}>
                  <span className="lp-gantt-annot-swatch" style={{ background: b.color, borderStyle: b.borderStyle }} />
                  <span className="lp-gantt-annot-summary">
                    <strong>{b.title || "Sans titre"}{b.kind === "decision" ? " · décision" : ""}</strong>
                    <span>{isGanttIsoDate(b.startDate) ? fmtShort(b.startDate) : "—"} → {isGanttIsoDate(b.endDate) ? fmtShort(b.endDate) : "—"}</span>
                  </span>
                  {!validation.ok && <AlertTriangle size={12} color="var(--danger)" />}
                  <RowActions item={b} list={blocks} setList={setBlocks} kind="block" onDuplicate={duplicateBlock} />
                </div>
                {editing && (
                  <div className="lp-gantt-annot-form">
                    <div className="lp-field">
                      <label>Titre</label>
                      <input type="text" value={b.title} onChange={(e) => patchBlock(b.id, { title: e.target.value })} placeholder="Études, Gros œuvre…" />
                    </div>
                    <div className="lp-row2">
                      <div className="lp-field">
                        <label>Début</label>
                        <input type="date" value={b.startDate} onChange={(e) => patchBlock(b.id, { startDate: e.target.value })} />
                      </div>
                      <div className="lp-field">
                        <label>Fin</label>
                        <input type="date" value={b.endDate} onChange={(e) => patchBlock(b.id, { endDate: e.target.value })} />
                      </div>
                    </div>
                    {!validation.ok && <p className="lp-gantt-annot-error">{validation.error}</p>}
                    {allowDecisionWindows && (
                      <div className="lp-field">
                        <label>Nature</label>
                        <div className="lp-density-row">
                          <button type="button" className={"lp-density-btn" + (b.kind !== "decision" ? " active" : "")} onClick={() => patchBlock(b.id, { kind: "phase" })}>Phase</button>
                          <button type="button" className={"lp-density-btn" + (b.kind === "decision" ? " active" : "")} onClick={() => patchBlock(b.id, { kind: "decision", color: b.color || GANTT_DECISION_DEFAULT_COLOR })}>Fenêtre de décision</button>
                        </div>
                        <p className="lp-gantt-annot-hint">Une fenêtre de décision est plus discrète qu'une phase : arbitrage fournisseur, validation de budget, date de gouvernance.</p>
                      </div>
                    )}
                    <div className="lp-field">
                      <label>Couleur</label>
                      <ColorPicker value={b.color} onChange={(color) => patchBlock(b.id, { color })} />
                    </div>
                    <GanttAnnotationBorderRow value={b.borderStyle} onChange={(borderStyle) => patchBlock(b.id, { borderStyle })} />
                  </div>
                )}
              </div>
            );
          })}
          <button type="button" className="lp-btn lp-gantt-annot-add" onClick={addBlock}><Plus size={13} /> Ajouter un bloc temporel</button>
        </div>
      )}

      <div className="lp-widget-appearance-toggle" onClick={() => setOpenFrames((v) => !v)}>
        <ChevronRight size={13} style={{ transform: openFrames ? "rotate(90deg)" : "none" }} />
        <Crosshair size={13} /> Encadrés
        <span className="lp-widget-appearance-hint">{frames.length || "aucun"}</span>
      </div>
      {openFrames && (
        <div className="lp-widget-appearance-panel">
          <p className="lp-gantt-annot-hint" style={{ marginTop: 0 }}>
            Met en évidence une ou plusieurs tâches. Les tâches non successives produisent plusieurs cadres.
          </p>
          {frames.map((f) => {
            const editing = editingId === f.id;
            const live = f.taskIds.filter((id) => knownTaskIds.includes(id)).length;
            return (
              <div className={"lp-gantt-annot-item" + (editing ? " editing" : "")} key={f.id}>
                <div className="lp-gantt-annot-head" onClick={() => setEditingId(editing ? null : f.id)}>
                  <span className="lp-gantt-annot-swatch" style={{ borderColor: f.color, borderStyle: f.borderStyle, background: "transparent" }} />
                  <span className="lp-gantt-annot-summary">
                    <strong>{f.label || "Sans libellé"}</strong>
                    <span>{f.taskIds.length} tâche{f.taskIds.length > 1 ? "s" : ""}{live !== f.taskIds.length ? ` · ${f.taskIds.length - live} introuvable(s)` : ""}</span>
                  </span>
                  {f.taskIds.length === 0 && <AlertTriangle size={12} color="var(--danger)" />}
                  <RowActions item={f} list={frames} setList={setFrames} kind="frame" onDuplicate={duplicateFrame} />
                </div>
                {editing && (
                  <div className="lp-gantt-annot-form">
                    <div className="lp-field">
                      <label>Étiquette <span style={{ fontWeight: 400, textTransform: "none", color: "var(--text-600)" }}>(facultative)</span></label>
                      <input type="text" value={f.label} onChange={(e) => patchFrame(f.id, { label: e.target.value })} placeholder="Lot critique, à sécuriser…" />
                    </div>
                    <GanttTaskMultiSelect tasks={tasks} ctx={ctx} value={f.taskIds} onChange={(taskIds) => patchFrame(f.id, { taskIds })} />
                    {f.taskIds.length === 0 && <p className="lp-gantt-annot-error">Sélectionne au moins une tâche : sans tâche, l'encadré n'est pas dessiné.</p>}
                    <div className="lp-field">
                      <label>Couleur</label>
                      <ColorPicker value={f.color} onChange={(color) => patchFrame(f.id, { color })} />
                    </div>
                    <GanttAnnotationBorderRow value={f.borderStyle} onChange={(borderStyle) => patchFrame(f.id, { borderStyle })} />
                    <div className="lp-field">
                      <label>Marge intérieure — {f.padding} px</label>
                      <input type="range" min="0" max={GANTT_FRAME_MAX_PADDING} value={f.padding} onChange={(e) => patchFrame(f.id, { padding: Number(e.target.value) })} />
                    </div>
                  </div>
                )}
              </div>
            );
          })}
          <button type="button" className="lp-btn lp-gantt-annot-add" onClick={addFrame}><Plus size={13} /> Ajouter un encadré</button>
          {frames.some((f) => f.taskIds.some((id) => !knownTaskIds.includes(id))) && (
            <button
              type="button"
              className="lp-btn lp-gantt-annot-add"
              onClick={() => setFrames(pruneHighlightFrames(frames, knownTaskIds))}
              title="Retire les tâches supprimées, et l'encadré s'il n'en reste aucune"
            >
              <Eraser size={13} /> Nettoyer les tâches supprimées
            </button>
          )}
        </div>
      )}

      {pendingDelete && (
        <ConfirmModal
          title={pendingDelete.kind === "block" ? "Supprimer le bloc temporel" : "Supprimer l'encadré"}
          message={
            pendingDelete.kind === "block"
              ? `Supprimer le bloc « ${pendingDelete.item.title || "Sans titre"} » ? Les tâches ne sont pas modifiées.`
              : `Supprimer l'encadré « ${pendingDelete.item.label || "Sans libellé"} » ? Les tâches ne sont pas modifiées.`
          }
          danger
          confirmLabel="Supprimer"
          onConfirm={confirmDelete}
          onClose={() => setPendingDelete(null)}
        />
      )}
    </>
  );
}

// Liste déroulante avec recherche rapide. L'habillage est celui du sélecteur
// d'activité déjà présent dans Nexora (classes lp-activity-search-*) : même
// panneau, même champ de recherche, même comportement — rien de nouveau à
// apprendre pour l'utilisateur, aucun style supplémentaire à maintenir.
function SearchableSelect({ value, options, onChange, placeholder, searchPlaceholder, emptyLabel }) {
  const [open, setOpen] = useState(false);
  const [query, setQuery] = useState("");
  const ref = useRef(null);
  useEffect(() => {
    const close = (e) => { if (ref.current && !ref.current.contains(e.target)) setOpen(false); };
    document.addEventListener("mousedown", close);
    return () => document.removeEventListener("mousedown", close);
  }, []);
  const list = Array.isArray(options) ? options : [];
  const selected = list.find((o) => o.id === value) || null;
  const q = query.trim().toLocaleLowerCase("fr");
  const filtered = q ? list.filter((o) => `${o.label} ${o.hint || ""}`.toLocaleLowerCase("fr").includes(q)) : list;
  const choose = (id) => { onChange(id); setQuery(""); setOpen(false); };
  return (
    <div className="lp-activity-search-select" ref={ref}>
      <button type="button" className="lp-activity-search-trigger" onClick={() => setOpen((v) => !v)}>
        <span className="lp-activity-search-trigger-text">
          {selected
            ? <><strong>{selected.label}</strong>{selected.hint ? <span>{selected.hint}</span> : null}</>
            : <span className="lp-activity-empty-value">{placeholder || "Choisir…"}</span>}
        </span>
        <ChevronDown size={15} />
      </button>
      {open && (
        <div className="lp-activity-search-menu">
          <div className="lp-activity-search-box">
            <Search size={14} />
            <input
              autoFocus value={query} onChange={(e) => setQuery(e.target.value)}
              placeholder={searchPlaceholder || "Rechercher…"}
              onKeyDown={(e) => { if (e.key === "Escape") { e.stopPropagation(); setOpen(false); } }}
            />
            {query && <button type="button" onClick={() => setQuery("")}><X size={12} /></button>}
          </div>
          <div className="lp-activity-search-options">
            {emptyLabel && (
              <button type="button" className={"lp-activity-search-option none" + (!value ? " selected" : "")} onClick={() => choose("")}>
                <span className="lp-activity-option-main">{emptyLabel}</span>
              </button>
            )}
            {filtered.length === 0
              ? <div className="lp-activity-search-empty">Aucun résultat.</div>
              : filtered.map((o) => (
                  <button type="button" key={o.id} className={"lp-activity-search-option" + (o.id === value ? " selected" : "")} onClick={() => choose(o.id)}>
                    <span className="lp-activity-option-dot" style={o.color ? { borderColor: o.color } : undefined} />
                    <span className="lp-activity-option-main">{o.label}</span>
                    {o.hint ? <span className="lp-activity-option-project">{o.hint}</span> : <span />}
                    {o.id === value && <Check size={13} />}
                  </button>
                ))}
          </div>
        </div>
      )}
    </div>
  );
}

// Section de liste réutilisable pour les annotations propres au Mini-Gantt
// (jalons, risques, notes) : même repli, mêmes actions, même confirmation que
// les sections blocs et encadrés — une seule mécanique à maintenir.
function MiniGanttListSection({ icon, title, hint, items, count, open, onToggle, children, onAdd, addLabel }) {
  return (
    <>
      <div className="lp-widget-appearance-toggle" onClick={onToggle}>
        <ChevronRight size={13} style={{ transform: open ? "rotate(90deg)" : "none" }} />
        {icon} {title}
        <span className="lp-widget-appearance-hint">{count || "aucun"}</span>
      </div>
      {open && (
        <div className="lp-widget-appearance-panel">
          {hint && <p className="lp-gantt-annot-hint" style={{ marginTop: 0 }}>{hint}</p>}
          {children}
          <button type="button" className="lp-btn lp-gantt-annot-add" onClick={onAdd}><Plus size={13} /> {addLabel}</button>
        </div>
      )}
    </>
  );
}

function MiniGanttAnnotationRow({ item, list, onMove, onDuplicate, onDelete, editing, onToggleEdit, swatch, title, subtitle, warning, children }) {
  return (
    <div className={"lp-gantt-annot-item" + (editing ? " editing" : "")}>
      <div className="lp-gantt-annot-head" onClick={onToggleEdit}>
        {swatch}
        <span className="lp-gantt-annot-summary">
          <strong>{title}</strong>
          <span>{subtitle}</span>
        </span>
        {warning && <AlertTriangle size={12} color="var(--danger)" />}
        <span className="lp-gantt-annot-actions" onClick={(e) => e.stopPropagation()}>
          <button type="button" className="lp-icon-btn" onClick={() => onMove(-1)} disabled={list[0]?.id === item.id} title="Monter"><ChevronUp size={12} /></button>
          <button type="button" className="lp-icon-btn" onClick={() => onMove(1)} disabled={list[list.length - 1]?.id === item.id} title="Descendre"><ChevronDown size={12} /></button>
          <button type="button" className="lp-icon-btn" onClick={onDuplicate} title="Dupliquer"><Copy size={12} /></button>
          <button type="button" className="lp-icon-btn" onClick={onDelete} title="Supprimer"><Trash2 size={12} /></button>
        </span>
      </div>
      {editing && <div className="lp-gantt-annot-form">{children}</div>}
    </div>
  );
}

// Éditeur complet du Mini-Gantt : il réutilise tel quel l'éditeur partagé des
// blocs et encadrés, et lui ajoute les trois sections propres à ce widget.
// `risks` est ici en LECTURE SEULE : les risques de délai appartiennent à la
// tâche et s'éditent dans sa fiche. L'éditeur n'en a besoin que pour proposer
// un risque comme ancre d'annotation.
function MiniGanttAnnotationsEditor({ blocks, frames, milestones, risks, notes, tasks, ctx, defaultStart, defaultEnd, onChange, initialSection, autoCreate, focusId }) {
  const [open, setOpen] = useState({
    milestones: initialSection === "milestones",
    notes: initialSection === "notes",
  });
  const [editingId, setEditingId] = useState(focusId || null);
  const [pendingDelete, setPendingDelete] = useState(null); // { kind, item }
  const toggle = (key) => setOpen((o) => ({ ...o, [key]: !o[key] }));
  const knownTaskIds = useMemo(() => new Set(tasks.map((t) => t.id)), [tasks]);
  const taskTitle = (id) => tasks.find((t) => t.id === id)?.title || "Tâche introuvable";

  const setMilestones = (next) => onChange({ milestones: next });
  const setNotes = (next) => onChange({ notes: next });
  const patch = (list, setList) => (id, values) => setList(list.map((x) => (x.id === id ? { ...x, ...values } : x)));
  const patchMilestone = patch(milestones, setMilestones);
  const patchNote = patch(notes, setNotes);

  const moveIn = (list, setList, id, dir, sameGroup) => {
    const i = list.findIndex((x) => x.id === id);
    if (i < 0) return;
    // Pour les risques, « monter » signifie passer devant le risque précédent
    // DE LA MÊME TÂCHE : c'est cet ordre qui décide de leur enchaînement.
    let j = i + dir;
    while (j >= 0 && j < list.length && sameGroup && !sameGroup(list[i], list[j])) j += dir;
    if (j < 0 || j >= list.length) return;
    const next = [...list];
    [next[i], next[j]] = [next[j], next[i]];
    setList(next);
  };

  const addMilestone = () => {
    const created = { id: uid(), title: "Nouveau jalon", date: defaultEnd, type: "standard", color: "", taskId: null };
    setMilestones([...milestones, created]);
    setOpen((o) => ({ ...o, milestones: true }));
    setEditingId(created.id);
  };
  const addNote = () => {
    const created = { id: uid(), title: "Nouvelle annotation", text: "", anchor: { kind: "date", date: defaultEnd } };
    setNotes([...notes, created]);
    setOpen((o) => ({ ...o, notes: true }));
    setEditingId(created.id);
  };

  const autoCreated = useRef(false);
  useEffect(() => {
    if (autoCreated.current || !autoCreate) return;
    autoCreated.current = true;
    if (autoCreate === "milestone") addMilestone();
    else if (autoCreate === "note") addNote();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [autoCreate]);

  const duplicateAfter = (list, setList, item, rename) => {
    const copy = { ...item, id: uid(), ...rename(item) };
    const i = list.findIndex((x) => x.id === item.id);
    setList([...list.slice(0, i + 1), copy, ...list.slice(i + 1)]);
    setEditingId(copy.id);
  };

  const confirmDelete = () => {
    if (!pendingDelete) return;
    const { kind, item } = pendingDelete;
    if (kind === "milestone") setMilestones(milestones.filter((x) => x.id !== item.id));
    else setNotes(notes.filter((x) => x.id !== item.id));
    setPendingDelete(null);
  };

  const taskOptions = useMemo(() => tasks
    .map((t) => ({ id: t.id, label: t.title, hint: ctx.projects.find((p) => p.id === t.projectId)?.name || "", color: ctx.projects.find((p) => p.id === t.projectId)?.color }))
    .sort((a, b) => a.hint.localeCompare(b.hint, "fr") || a.label.localeCompare(b.label, "fr")), [tasks, ctx.projects]);

  const TaskSelect = ({ value, onSelect, allowEmpty }) => (
    <SearchableSelect
      value={value || ""}
      options={taskOptions}
      onChange={(id) => onSelect(id || null)}
      placeholder={value && !knownTaskIds.has(value) ? "Tâche introuvable" : "Choisir une tâche"}
      searchPlaceholder="Rechercher une tâche ou un projet…"
      emptyLabel={allowEmpty ? "Aucune tâche" : null}
    />
  );

  return (
    <>
      <GanttAnnotationsEditor
        blocks={blocks}
        frames={frames}
        tasks={tasks}
        ctx={ctx}
        defaultStart={defaultStart}
        defaultEnd={defaultEnd}
        onChange={onChange}
        initialSection={initialSection === "frames" ? "frames" : "blocks"}
        autoCreate={autoCreate === "block" || autoCreate === "frame" ? autoCreate : null}
        focusId={focusId}
        allowDecisionWindows
      />

      <MiniGanttListSection
        icon={<Milestone size={13} />} title="Jalons et décisions" count={milestones.length}
        hint="Permis, décision CODIR, mise en service, engagement contractuel, réception… Un jalon peut n'être rattaché à aucune tâche."
        open={open.milestones} onToggle={() => toggle("milestones")} onAdd={addMilestone} addLabel="Ajouter un jalon"
      >
        {milestones.map((m) => {
          const valid = isGanttIsoDate(m.date) && String(m.title || "").trim();
          return (
            <MiniGanttAnnotationRow
              key={m.id} item={m} list={milestones} editing={editingId === m.id}
              onToggleEdit={() => setEditingId(editingId === m.id ? null : m.id)}
              onMove={(dir) => moveIn(milestones, setMilestones, m.id, dir)}
              onDuplicate={() => duplicateAfter(milestones, setMilestones, m, (x) => ({ title: `${x.title} (copie)` }))}
              onDelete={() => setPendingDelete({ kind: "milestone", item: m })}
              warning={!valid}
              swatch={<span className="lp-gantt-annot-swatch" style={{ background: m.color || MINIGANTT_MILESTONE_COLORS[m.type] || MINIGANTT_MILESTONE_COLORS.standard, transform: "rotate(45deg)" }} />}
              title={m.title || "Sans titre"}
              subtitle={`${MINIGANTT_MILESTONE_LABELS[m.type] || "Jalon"} · ${isGanttIsoDate(m.date) ? fmtShort(m.date) : "—"}`}
            >
              <div className="lp-field">
                <label>Titre</label>
                <input type="text" value={m.title} onChange={(e) => patchMilestone(m.id, { title: e.target.value })} placeholder="Décision CODIR, Permis…" />
              </div>
              <div className="lp-row2">
                <div className="lp-field">
                  <label>Date</label>
                  <input type="date" value={m.date || ""} onChange={(e) => patchMilestone(m.id, { date: e.target.value })} />
                </div>
                <div className="lp-field">
                  <label>Type</label>
                  <SearchableSelect
                    value={m.type || "standard"}
                    options={MINIGANTT_MILESTONE_TYPES.map((k) => ({ id: k, label: MINIGANTT_MILESTONE_LABELS[k], color: MINIGANTT_MILESTONE_COLORS[k] }))}
                    onChange={(id) => patchMilestone(m.id, { type: id || "standard", color: "" })}
                    searchPlaceholder="Rechercher un type…"
                  />
                </div>
              </div>
              {!valid && <p className="lp-gantt-annot-error">Un jalon demande un titre et une date valide.</p>}
              <div className="lp-field">
                <label>Tâche rattachée <span style={{ fontWeight: 400, textTransform: "none", color: "var(--text-600)" }}>(facultatif)</span></label>
                <TaskSelect value={m.taskId} onSelect={(id) => patchMilestone(m.id, { taskId: id })} allowEmpty />
              </div>
              <div className="lp-field">
                <label>Couleur</label>
                <ColorPicker value={m.color || MINIGANTT_MILESTONE_COLORS[m.type] || MINIGANTT_MILESTONE_COLORS.standard} onChange={(color) => patchMilestone(m.id, { color })} />
              </div>
            </MiniGanttAnnotationRow>
          );
        })}
      </MiniGanttListSection>

      <MiniGanttListSection
        icon={<StickyNote size={13} />} title="Annotations" count={notes.length}
        hint="Une bulle courte ancrée à une tâche, un risque, un jalon ou une date."
        open={open.notes} onToggle={() => toggle("notes")} onAdd={addNote} addLabel="Ajouter une annotation"
      >
        {notes.map((n) => {
          const anchor = n.anchor || {};
          const resolved = anchor.kind === "date"
            ? isGanttIsoDate(anchor.date)
            : anchor.kind === "task" ? knownTaskIds.has(anchor.id)
            : anchor.kind === "risk" ? risks.some((r) => r.id === anchor.id)
            : milestones.some((m) => m.id === anchor.id);
          const setAnchor = (values) => patchNote(n.id, { anchor: { ...anchor, ...values } });
          return (
            <MiniGanttAnnotationRow
              key={n.id} item={n} list={notes} editing={editingId === n.id}
              onToggleEdit={() => setEditingId(editingId === n.id ? null : n.id)}
              onMove={(dir) => moveIn(notes, setNotes, n.id, dir)}
              onDuplicate={() => duplicateAfter(notes, setNotes, n, (x) => ({ title: `${x.title} (copie)` }))}
              onDelete={() => setPendingDelete({ kind: "note", item: n })}
              warning={!resolved}
              swatch={<span className="lp-gantt-annot-swatch" style={{ background: "transparent", borderColor: "#64748B", borderRadius: "50%" }} />}
              title={n.title || "Sans titre"}
              subtitle={anchor.kind === "date" ? (isGanttIsoDate(anchor.date) ? fmtShort(anchor.date) : "date à définir")
                : anchor.kind === "task" ? taskTitle(anchor.id)
                : anchor.kind === "risk" ? (risks.find((r) => r.id === anchor.id)?.title || "risque introuvable")
                : (milestones.find((m) => m.id === anchor.id)?.title || "jalon introuvable")}
            >
              <div className="lp-field">
                <label>Titre</label>
                <input type="text" value={n.title} onChange={(e) => patchNote(n.id, { title: e.target.value })} />
              </div>
              <div className="lp-field">
                <label>Texte <span style={{ fontWeight: 400, textTransform: "none", color: "var(--text-600)" }}>(court)</span></label>
                <textarea rows={2} value={n.text || ""} onChange={(e) => patchNote(n.id, { text: e.target.value })} />
              </div>
              <div className="lp-field">
                <label>Ancrage</label>
                <div className="lp-density-row">
                  {[["date", "Date"], ["task", "Tâche"], ["milestone", "Jalon"], ["risk", "Risque"]].map(([k, label]) => (
                    <button key={k} type="button" className={"lp-density-btn" + (anchor.kind === k ? " active" : "")} onClick={() => setAnchor({ kind: k })}>{label}</button>
                  ))}
                </div>
              </div>
              {anchor.kind === "date" && (
                <div className="lp-field">
                  <label>Date</label>
                  <input type="date" value={anchor.date || ""} onChange={(e) => setAnchor({ date: e.target.value })} />
                </div>
              )}
              {anchor.kind === "task" && (
                <div className="lp-field"><label>Tâche</label><TaskSelect value={anchor.id} onSelect={(id) => setAnchor({ id })} /></div>
              )}
              {anchor.kind === "milestone" && (
                <div className="lp-field">
                  <label>Jalon</label>
                  <SearchableSelect
                    value={anchor.id || ""}
                    options={milestones.map((m) => ({ id: m.id, label: m.title || "Sans titre", hint: isGanttIsoDate(m.date) ? fmtShort(m.date) : "", color: m.color || MINIGANTT_MILESTONE_COLORS[m.type] }))}
                    onChange={(id) => setAnchor({ id })}
                    placeholder="Choisir un jalon"
                    searchPlaceholder="Rechercher un jalon…"
                  />
                </div>
              )}
              {anchor.kind === "risk" && (
                <div className="lp-field">
                  <label>Risque</label>
                  <SearchableSelect
                    value={anchor.id || ""}
                    options={risks.map((r) => ({ id: r.id, label: r.title || "Sans titre", hint: taskTitle(r.taskId), color: r.color || MINIGANTT_RISK_DEFAULT_COLOR }))}
                    onChange={(id) => setAnchor({ id })}
                    placeholder="Choisir un risque"
                    searchPlaceholder="Rechercher un risque…"
                  />
                </div>
              )}
              {!resolved && <p className="lp-gantt-annot-error">Ancrage introuvable : l'annotation n'est pas dessinée.</p>}
            </MiniGanttAnnotationRow>
          );
        })}
      </MiniGanttListSection>

      {pendingDelete && (
        <ConfirmModal
          title="Supprimer"
          message={`Supprimer « ${pendingDelete.item.title || "Sans titre"} » ? Les tâches ne sont pas modifiées.`}
          danger confirmLabel="Supprimer"
          onConfirm={confirmDelete}
          onClose={() => setPendingDelete(null)}
        />
      )}
    </>
  );
}

function GanttView({ tasks: allTasks, ctx, appearance, setAppearance, setTasks, setProjects, setStatuses, onOpen, onAdd, onDelete, onMarkDone, onCycleStatus, onBulkDelete, prefs, setPrefs, toolbarSlot, embedded, annotations, onAnnotationsChange }) {
  const tasks = useMemo(() => allTasks.filter((t) => t.start && t.end), [allTasks]);
  const ROW_H = { compact: 26, comfortable: 34, spacious: 44 }[appearance.density] || 34;
  const gradient = appearance.gradient;
  const ganttBg = "#EAEDF3"; // couleur de fond figée, non modifiable
  const barBg = appearance.progressColorByStatus ? "#EAEDF3" : (appearance.barBg || "#C7CED9");
  const barRadius = (BAR_SHAPES.find((s) => s.key === (appearance.barShape || "rounded")) || BAR_SHAPES[0]).radius;
  const bgIsLight = luminance(ganttBg) > 0.5;
  const gridLineColor = bgIsLight ? "rgba(10,15,25,0.12)" : "rgba(255,255,255,0.14)";
  const onBgText = appearance.ganttTextColor || (bgIsLight ? "#151313" : "#ffffff");
  const onBgTextSoft = appearance.ganttTextColor ? appearance.ganttTextColor + "B8" : (bgIsLight ? "rgba(21,19,19,0.72)" : "rgba(255,255,255,0.82)");
  const defaultNameW = useMemo(() => {
    const longest = tasks.reduce((m, t) => Math.max(m, t.title.length), 8);
    return Math.max(240, Math.min(600, longest * 7.8 + 100));
  }, [tasks]);
  const [NAME_W, setNameW] = useState(defaultNameW);
  const [nameCollapsed, setNameCollapsed] = useState(false);
  const effectiveNameW = nameCollapsed ? 0 : NAME_W;
  const hasResizedNameW = useRef(false);
  useEffect(() => { if (!hasResizedNameW.current) setNameW(defaultNameW); }, [defaultNameW]);
  const nameResizing = useRef(false);
  const startNameResize = (e) => {
    e.preventDefault();
    nameResizing.current = true;
    hasResizedNameW.current = true;
    const startX = e.clientX;
    const startW = NAME_W;
    const onMove = (ev) => { if (nameResizing.current) setNameW(Math.max(80, Math.min(700, startW + ev.clientX - startX))); };
    const onUp = () => { nameResizing.current = false; window.removeEventListener("mousemove", onMove); window.removeEventListener("mouseup", onUp); document.body.style.cursor = ""; };
    window.addEventListener("mousemove", onMove);
    window.addEventListener("mouseup", onUp);
    document.body.style.cursor = "ew-resize";
  };
  const today = iso(new Date());
  const zoomKey = prefs.zoomKey || "week";
  const setZoomKey = (value) => setPrefs((p) => ({
    ...p,
    zoomKey: typeof value === "function" ? value(p.zoomKey || "week") : value,
  }));
  const zoom = ZOOMS.find((z) => z.key === zoomKey);
  const dayWidth = zoom.dayWidth;
  const scrollRef = useRef(null);
  const [bubbles, setBubbles] = useState({}); // {[taskId]: true} — ouvert/fermé, piloté uniquement par la flèche sur la barre
  const bubbleFields = prefs.bubbleFields;
  const setBubbleFields = (updater) => setPrefs((p) => ({ bubbleFields: typeof updater === "function" ? updater(p.bubbleFields) : updater }));
  const bubbleNodes = useRef({});
  const ganttGroupBy = prefs.ganttGroupBy;
  const setGanttGroupBy = (v) => setPrefs({ ganttGroupBy: v });
  const ganttCols = prefs.ganttCols || ["status", "assignee", "start", "end", "progress"];
  const setGanttCols = (updater) => setPrefs((p) => ({ ganttCols: typeof updater === "function" ? updater(p.ganttCols || []) : updater }));
  const colDefs = GANTT_COL_OPTIONS.filter((c) => ganttCols.includes(c.key));
  const COLS_W = colDefs.reduce((sum, c) => sum + c.w, 0);
  const TOTAL_LEFT_W = effectiveNameW + COLS_W;
  const [expandedGroups, setExpandedGroups] = useState({});

  // --- Annotations : blocs temporels et encadrés ---------------------------
  // Deux origines possibles, jamais deux systèmes : la configuration du widget
  // quand le Gantt est embarqué (annotations/onAnnotationsChange), sinon les
  // préférences de vue, déjà persistées dans « nexora:viewPrefs ».
  const annotationsControlled = typeof onAnnotationsChange === "function";
  const annotationSource = annotationsControlled ? (annotations || {}) : prefs;
  // Listes brutes pour l'éditeur (une date en cours de saisie doit rester
  // modifiable), listes normalisées pour le rendu (une annotation invalide
  // n'est jamais dessinée).
  const rawTemporalBlocks = useMemo(() => (Array.isArray(annotationSource.temporalBlocks) ? annotationSource.temporalBlocks : []), [annotationSource.temporalBlocks]);
  const rawHighlightFrames = useMemo(() => (Array.isArray(annotationSource.highlightFrames) ? annotationSource.highlightFrames : []), [annotationSource.highlightFrames]);
  const temporalBlocks = useMemo(() => normalizeTemporalBlocks(rawTemporalBlocks), [rawTemporalBlocks]);
  const highlightFrames = useMemo(() => normalizeHighlightFrames(rawHighlightFrames), [rawHighlightFrames]);
  const applyAnnotations = (patch) => {
    if (annotationsControlled) onAnnotationsChange({ temporalBlocks: rawTemporalBlocks, highlightFrames: rawHighlightFrames, ...patch });
    else setPrefs(patch);
  };
  const [annotationPanel, setAnnotationPanel] = useState(null); // null | { section, autoCreate, focusId }

  const groupedLanes = useMemo(() => {
    const minGapDays = Math.ceil(180 / dayWidth); // place pour les étiquettes de dates + le bouton déplier
    const groups = groupTasks(tasks, ganttGroupBy, ctx).filter((g) => g.tasks.length > 0);
    return groups.map((g) => ({ ...g, lanes: g.tasks.map((t) => [t]) }));
  }, [tasks, ganttGroupBy, ctx, dayWidth]);

  const toggleBubble = (taskId) => setBubbles((b) => { const n = { ...b }; if (n[taskId]) delete n[taskId]; else n[taskId] = true; return n; });
  const allOpen = tasks.length > 0 && tasks.every((t) => bubbles[t.id]);
  const toggleAllBubbles = () => {
    if (allOpen) { setBubbles({}); return; }
    const n = {};
    tasks.forEach((t) => { n[t.id] = true; });
    setBubbles(n);
  };
  const allGroupsExpanded = groupedLanes.length > 0 && groupedLanes.every((g) => expandedGroups[g.key] !== false);
  const toggleAllGroups = () => {
    const n = {};
    groupedLanes.forEach((g) => { n[g.key] = !allGroupsExpanded; });
    setExpandedGroups(n);
  };

  const { rangeStart, rangeEnd } = useMemo(() => {
    const validTasks = tasks.filter((t) => !isNaN(dayIndex(t.start)) && !isNaN(dayIndex(t.end)));
    if (validTasks.length === 0) return { rangeStart: addDays(today, -zoom.pad), rangeEnd: addDays(today, zoom.pad * 3) };
    let min = validTasks[0].start, max = validTasks[0].end;
    validTasks.forEach((t) => { if (t.start < min) min = t.start; if (t.end > max) max = t.end; });
    return { rangeStart: unitStart(addDays(min, -zoom.pad), zoom.unit), rangeEnd: addDays(max, zoom.pad) };
  }, [tasks, zoomKey]);

  const ticks = useMemo(() => {
    const arr = [];
    let cur = unitStart(rangeStart, zoom.unit);
    let guard = 0;
    while (dayIndex(cur) <= dayIndex(rangeEnd) && guard < 4000) {
      const len = unitLen(cur, zoom.unit);
      arr.push({ start: cur, len, label: unitLabel(cur, zoom.unit) });
      cur = addDays(cur, len);
      guard++;
    }
    return arr;
  }, [rangeStart, rangeEnd, zoomKey]);

  const topGroups = useMemo(() => {
    if (!zoom.top) return [];
    const groups = [];
    ticks.forEach((t) => {
      const k = topKeyFor(t.start, zoom.top);
      const last = groups[groups.length - 1];
      if (last && last.key === k) last.len += t.len;
      else groups.push({ key: k, start: t.start, len: t.len, label: topLabelFor(t.start, zoom.top) });
    });
    return groups;
  }, [ticks, zoomKey]);

  const originIdx = ticks.length ? dayIndex(ticks[0].start) : dayIndex(rangeStart);
  const timelineWidth = ticks.reduce((s, t) => s + t.len, 0) * dayWidth;
  const xFor = (dateStr) => (dayIndex(dateStr) - originIdx) * dayWidth;
  const xForIdx = (idx) => (idx - originIdx) * dayWidth;
  const topH = zoom.top ? 26 : 0;

  // --- Géométrie des annotations -------------------------------------------
  // Les encadrés suivent la mise en page RÉELLE au lieu de la recalculer : on
  // mesure chaque ligne visible (hauteur de densité, bulle dépliée, en-tête de
  // groupe). Un zoom, un filtre, un repli/dépli ou un déplacement de tâche
  // déplace les lignes, la mesure suit — sans second moteur de disposition à
  // maintenir en parallèle du Gantt.
  const rowsWrapRef = useRef(null);
  const rowNodes = useRef({});
  const [rowRects, setRowRects] = useState({});
  const rowsPanelW = nameCollapsed ? 0 : effectiveNameW + COLS_W;

  const visibleRows = useMemo(() => {
    const rows = [];
    groupedLanes.forEach((g) => {
      if (expandedGroups[g.key] === false) return;
      g.lanes.forEach((lane) => {
        const t = lane[0];
        if (t) rows.push({ id: t.id, groupKey: g.key, start: t.start, end: t.end });
      });
    });
    return rows;
  }, [groupedLanes, expandedGroups]);

  const measureRows = useCallback(() => {
    const wrap = rowsWrapRef.current;
    if (!wrap) return;
    const base = wrap.getBoundingClientRect();
    const next = {};
    visibleRows.forEach((row) => {
      const el = rowNodes.current[row.id];
      if (!el || !el.isConnected) return;
      const rect = el.getBoundingClientRect();
      next[row.id] = { top: Math.round(rect.top - base.top), height: Math.round(rect.height) };
    });
    // Ne remplace l'état que si une position a réellement changé : c'est ce qui
    // empêche l'observateur de redimensionnement de boucler indéfiniment.
    setRowRects((prev) => {
      const prevKeys = Object.keys(prev);
      const nextKeys = Object.keys(next);
      const same = prevKeys.length === nextKeys.length
        && nextKeys.every((k) => prev[k] && prev[k].top === next[k].top && prev[k].height === next[k].height);
      return same ? prev : next;
    });
  }, [visibleRows]);

  useEffect(() => {
    const id = requestAnimationFrame(measureRows);
    return () => cancelAnimationFrame(id);
  }, [measureRows, zoomKey, ROW_H, nameCollapsed, COLS_W, bubbles, timelineWidth]);

  useEffect(() => {
    if (typeof ResizeObserver === "undefined") return undefined;
    const wrap = rowsWrapRef.current;
    if (!wrap) return undefined;
    const ro = new ResizeObserver(() => measureRows());
    ro.observe(wrap);
    return () => ro.disconnect();
  }, [measureRows]);

  const frameShapes = useMemo(() => {
    if (!highlightFrames.length) return [];
    const rows = visibleRows
      .map((row) => {
        const rect = rowRects[row.id];
        if (!rect) return null;
        const startIdx = dayIndex(row.start);
        const endIdx = dayIndex(row.end);
        if (!Number.isFinite(startIdx) || !Number.isFinite(endIdx)) return null;
        return { id: row.id, groupKey: row.groupKey, top: rect.top, height: rect.height, startIdx, endIdx };
      })
      .filter(Boolean);
    if (!rows.length) return [];
    const shapes = [];
    highlightFrames.forEach((frame) => {
      ganttFrameSegments(rows, frame).forEach((seg, i) => shapes.push({ ...seg, frame, key: frame.id + "-" + i }));
    });
    // Deux cadres qui commencent au même endroit sur des lignes voisines
    // superposeraient leurs étiquettes : on décale les suivantes vers le bas
    // plutôt que d'en laisser une définitivement masquée.
    const placed = [];
    shapes.slice().sort((a, b) => a.top - b.top || a.startIdx - b.startIdx).forEach((shape) => {
      shape.labelOffset = placed.filter((x) => Math.abs(x.top - shape.top) < 16 && Math.abs(x.startIdx - shape.startIdx) * dayWidth < 90).length * 12;
      placed.push(shape);
    });
    return shapes;
  }, [highlightFrames, visibleRows, rowRects, dayWidth]);

  // Un bloc temporel est dessiné DANS chaque piste, exactement comme la grille
  // et la ligne « aujourd'hui » : il reste au-dessus du fond du Gantt mais sous
  // les barres, jalons et dépendances, et suit sans effort le zoom, le scroll
  // horizontal et tout changement de plage affichée.
  const temporalBlockShapes = useMemo(() => {
    const shapes = [];
    temporalBlocks.forEach((block) => {
      const startIdx = dayIndex(block.startDate);
      const endIdx = dayIndex(block.endDate);
      if (!Number.isFinite(startIdx) || !Number.isFinite(endIdx)) return;
      shapes.push({
        block,
        left: (startIdx - originIdx) * dayWidth,
        width: Math.max(2, (endIdx - startIdx + 1) * dayWidth),
      });
    });
    // Étiquettes verticales décalées quand deux blocs commencent presque au même
    // endroit : aucune ne reste définitivement masquée derrière une autre.
    const placed = [];
    shapes.slice().sort((a, b) => a.left - b.left).forEach((shape) => {
      const clashes = placed.filter((x) => Math.abs(x.left - shape.left) < 18).length;
      shape.labelOffset = clashes * 15;
      placed.push(shape);
    });
    return shapes;
  }, [temporalBlocks, originIdx, dayWidth]);

  const renderTemporalBlocks = () => temporalBlockShapes.map((shape) => (
    <div
      key={shape.block.id}
      className="lp-gantt-tblock"
      style={{
        left: shape.left,
        width: shape.width,
        background: "color-mix(in srgb, " + shape.block.color + " 10%, transparent)",
        borderLeft: "1.5px " + shape.block.borderStyle + " " + shape.block.color,
        borderRight: "1.5px " + shape.block.borderStyle + " " + shape.block.color,
      }}
    />
  ));

  // ------- Drag & resize -------
  const dragState = useRef(null);
  const tasksRef = useRef(tasks);
  useEffect(() => { tasksRef.current = tasks; }, [tasks]);

  useEffect(() => {
    function onMove(e) {
      const d = dragState.current;
      if (!d) return;
      const point = e.touches ? e.touches[0] : e;
      if (!point) return;
      if (e.cancelable) e.preventDefault(); // évite que le scroll tactile prenne le dessus pendant un glisser actif
      const deltaDays = Math.round((point.clientX - d.startX) / d.dayWidth);
      if (deltaDays !== 0) d.moved = true;
      let newStart = d.origStart, newEnd = d.origEnd;
      if (d.mode === "move" || d.mode === "move-milestone") { newStart = addDays(d.origStart, deltaDays); newEnd = addDays(d.origEnd, deltaDays); }
      else if (d.mode === "resize-start") { newStart = addDays(d.origStart, deltaDays); if (dayIndex(newStart) > dayIndex(d.origEnd)) newStart = d.origEnd; }
      else if (d.mode === "resize-end") { newEnd = addDays(d.origEnd, deltaDays); if (dayIndex(newEnd) < dayIndex(d.origStart)) newEnd = d.origStart; }
      setTasks((prev) => prev.map((t) => (t.id === d.id ? { ...t, start: newStart, end: newEnd } : t)));
    }
    function onUp() {
      const d = dragState.current;
      if (d) {
        if (!d.moved) { const t = tasksRef.current.find((x) => x.id === d.id); if (t) onOpen(t); }
        document.body.style.cursor = "";
      }
      dragState.current = null;
    }
    window.addEventListener("mousemove", onMove);
    window.addEventListener("mouseup", onUp);
    window.addEventListener("touchmove", onMove, { passive: false });
    window.addEventListener("touchend", onUp);
    window.addEventListener("touchcancel", onUp);
    return () => {
      window.removeEventListener("mousemove", onMove); window.removeEventListener("mouseup", onUp);
      window.removeEventListener("touchmove", onMove); window.removeEventListener("touchend", onUp); window.removeEventListener("touchcancel", onUp);
    };
  }, [setTasks, onOpen]);

  const startDrag = (e, task, mode) => {
    const touch = e.touches && e.touches[0];
    if (!touch && e.button !== 0) return; // laisse le clic droit ouvrir la bulle sans déclencher de glisser
    e.preventDefault(); e.stopPropagation();
    dragState.current = { id: task.id, mode, startX: touch ? touch.clientX : e.clientX, origStart: task.start, origEnd: task.end, moved: false, dayWidth };
    document.body.style.cursor = mode === "resize-start" || mode === "resize-end" ? "ew-resize" : "grabbing";
  };

  const recenterToday = () => {
    const el = scrollRef.current;
    if (!el) return;
    el.scrollTo({ left: Math.max(0, xFor(today) - el.clientWidth / 2), behavior: "smooth" });
  };

  const [fitVersion, setFitVersion] = useState(0);
  const fitAll = () => {
    if (tasks.length === 0) return;
    let min = tasks[0].start, max = tasks[0].end;
    tasks.forEach((t) => { if (t.start < min) min = t.start; if (t.end > max) max = t.end; });
    const spanDays = dayIndex(max) - dayIndex(min) + 6;
    const available = Math.max(200, (scrollRef.current?.clientWidth || 900) - NAME_W - 24);
    let chosen = ZOOMS[ZOOMS.length - 1];
    for (const z of ZOOMS) { if (spanDays * z.dayWidth <= available) { chosen = z; break; } }
    setZoomKey(chosen.key);
    setFitVersion((v) => v + 1);
  };
  useEffect(() => {
    if (fitVersion === 0) return;
    const id = requestAnimationFrame(() => scrollRef.current?.scrollTo({ left: 0, behavior: "auto" }));
    return () => cancelAnimationFrame(id);
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [fitVersion, zoomKey]);

  const toggleChecklist = (taskId, itemId) => {
    setTasks((prev) => prev.map((t) => (t.id === taskId ? { ...t, checklist: (t.checklist || []).map((i) => (i.id === itemId ? { ...i, done: !i.done } : i)) } : t)));
  };
  const updateProgress = (taskId, value) => {
    setTasks((prev) => prev.map((t) => (t.id === taskId ? { ...t, progress: value } : t)));
  };

  const renderShape = (t, laneTop = 0) => {
    if (isNaN(dayIndex(t.start)) || isNaN(dayIndex(t.end))) return null;
    const st = ctx.statuses.find((s) => s.id === t.statusId) || ctx.statuses[0] || { color: "var(--text-muted)" };
    const p = ctx.projects.find((x) => x.id === t.projectId);
    const barLeft = xFor(t.start);
    const barWidth = Math.max(dayWidth, xFor(t.end) - xFor(t.start) + dayWidth);
    const midY = laneTop + ROW_H / 2;
    const fill = appearance.progressColorByStatus ? st.color : (gradient && gradient.enabled ? `linear-gradient(90deg, ${gradient.from}, ${gradient.to})` : st.color);
    const isDone = /termin/i.test(st.name || "");
    const late = !isDone && dayIndex(t.end) < dayIndex(iso(new Date()));
    const isUrgent = isTaskUrgent(t, ctx);
    const DONE_GREEN = "#6FC79A";
    const doneHatch = `repeating-linear-gradient(45deg, ${DONE_GREEN}, ${DONE_GREEN} 8px, rgba(255,255,255,0.55) 8px, rgba(255,255,255,0.55) 11px)`;
    if (t.milestone) {
      const pct = Math.max(0, Math.min(100, Math.round(t.progress || 0)));
      const pieBg = barBg;
      const arcFrom = gradient && gradient.enabled ? gradient.from : st.color;
      const arcTo = gradient && gradient.enabled ? gradient.to : st.color;
      const D = 20, R = 8.5, SW = 2.2, innerR = 4.6, C = 2 * Math.PI * R;
      const gradId = `mg-${t.id}`;
      return (
        <React.Fragment key={t.id}>
          <svg
            width={D} height={D} viewBox={`0 0 ${D} ${D}`}
            style={{ position: "absolute", left: barLeft, top: midY, transform: "translate(-50%,-50%)", cursor: "grab", overflow: "visible" }}
            onMouseDown={(e) => startDrag(e, t, "move-milestone")}
            onTouchStart={(e) => startDrag(e, t, "move-milestone")}
            onContextMenu={(e) => { e.preventDefault(); toggleBubble(t.id); }}
          >
            <title>{`${t.title} — ${pct}%`}</title>
            <defs>
              <linearGradient id={gradId} x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" stopColor={arcFrom} />
                <stop offset="100%" stopColor={arcTo} />
              </linearGradient>
            </defs>
            {late && <circle cx={D / 2} cy={D / 2} r={R + 2.6} fill="none" stroke="var(--danger)" strokeWidth="1.6" />}
            <circle cx={D / 2} cy={D / 2} r={R} fill="none" stroke={pieBg} strokeWidth={SW} />
            {pct > 0 && (
              <circle
                cx={D / 2} cy={D / 2} r={R} fill="none" stroke={`url(#${gradId})`} strokeWidth={SW} strokeLinecap="round"
                strokeDasharray={`${(C * pct) / 100} ${C}`}
                transform={`rotate(-90 ${D / 2} ${D / 2})`}
              />
            )}
            <circle cx={D / 2} cy={D / 2} r={innerR} fill={isDone ? "var(--success)" : (p?.color || "var(--text-muted)")} />
            {isDone && <path d="M 7.6 10 L 9.2 11.7 L 12.6 7.9" stroke="#fff" strokeWidth="1.4" fill="none" strokeLinecap="round" strokeLinejoin="round" />}
          </svg>
          <button className="lp-gantt-bar-toggle" style={{ left: barLeft + 16, top: midY - 9 }} onMouseDown={(e) => e.stopPropagation()} onClick={(e) => { e.stopPropagation(); toggleBubble(t.id); }} title={bubbles[t.id] ? "Replier" : "Déplier"}>
            {bubbles[t.id] ? <ChevronUp size={12} /> : <ChevronDown size={12} />}
          </button>
          <div className="lp-date-label lp-gantt-title-label" style={{ left: barLeft + 16 + 24, top: midY, color: onBgText, fontWeight: 600, cursor: "pointer", display: "flex", alignItems: "center", gap: 4 }} onClick={() => onOpen(t)}><MilestoneGlyph size={12} icon={resolveMilestoneIcon(t, ctx)} />{t.title} · {fmtFull(t.start)}</div>
        </React.Fragment>
      );
    }
    const controlsStart = barLeft + barWidth + 6;
    const controlsEnd = controlsStart + (isDone ? 22 : 0) + 24; // largeur badge terminé + bouton bulle + marge
    return (
      <React.Fragment key={t.id}>
        <div className="lp-date-label" style={{ left: Math.max(2, barLeft - 76), width: 68, top: midY, textAlign: "right", color: onBgTextSoft }}>{fmtFull(t.start)}</div>
        <div className="lp-gantt-bar" style={{ left: barLeft, width: barWidth, top: laneTop + 6, background: isDone ? doneHatch : barBg, border: isUrgent ? "1.5px solid var(--danger)" : late ? "2px solid var(--danger)" : "none", borderRadius: barRadius }} onMouseDown={(e) => startDrag(e, t, "move")} onTouchStart={(e) => startDrag(e, t, "move")} onContextMenu={(e) => { e.preventDefault(); toggleBubble(t.id); }}>
          {!isDone && (
            <div className="lp-gantt-bar-fill" style={{ width: `${t.progress}%`, background: fill }}>
              {appearance.progressTexture && <div className="lp-gantt-bar-texture" />}
            </div>
          )}
          {barWidth > 34 && <div className="lp-gantt-bar-label" style={isDone ? { color: "#0B3D26" } : { color: appearance.ganttTextColor || (luminance(barBg) > 0.5 ? "#151313" : "#fff") }}>{t.progress}%</div>}
          <div className="lp-gantt-handle left" onMouseDown={(e) => startDrag(e, t, "resize-start")} onTouchStart={(e) => startDrag(e, t, "resize-start")} />
          <div className="lp-gantt-handle right" onMouseDown={(e) => startDrag(e, t, "resize-end")} onTouchStart={(e) => startDrag(e, t, "resize-end")} />
        </div>
        {appearance.ganttShowSubtasks && (t.checklist || []).length > 0 && (() => {
          const subPositions = [...t.checklist]
            .map((item) => ({ item, x: xFor(item.end || t.end) }))
            .sort((a, b) => a.x - b.x);
          const subTop = laneTop + ROW_H - 13;
          const metroColor = p?.color || "var(--text-muted)";
          return (
            <React.Fragment>
              {subPositions.map(({ item, x }) => (
                <div key={item.id} className={"lp-gantt-metro-station" + (item.done ? " done" : "")} style={{ left: x, top: subTop, borderColor: metroColor, color: item.done ? "#fff" : metroColor, background: item.done ? metroColor : "#fff" }} title={`${item.text} · ${fmtShort(item.end || t.end)}`}>
                  {item.done && <Check size={9} color="#fff" strokeWidth={3.5} />}
                </div>
              ))}
            </React.Fragment>
          );
        })()}
        {isDone && (
          <span className="lp-gantt-done-badge" style={{ left: controlsStart, top: midY - 9 }} title="Terminé">
            <Check size={11} color="#fff" strokeWidth={3} />
          </span>
        )}
        <button className="lp-gantt-bar-toggle" style={{ left: isDone ? controlsStart + 22 : controlsStart, top: midY - 9 }} onMouseDown={(e) => e.stopPropagation()} onClick={(e) => { e.stopPropagation(); toggleBubble(t.id); }} title={bubbles[t.id] ? "Replier" : "Déplier"}>
          {bubbles[t.id] ? <ChevronUp size={12} /> : <ChevronDown size={12} />}
        </button>
        {/* Titre toujours affiché en entier, jamais tronqué — placé après les boutons */}
        <div className="lp-date-label lp-gantt-title-label" style={{ left: controlsEnd, top: midY, color: onBgText, fontWeight: 600, cursor: "pointer" }} onClick={() => onOpen(t)}>{t.title} · {fmtFull(t.end)}</div>
      </React.Fragment>
    );
  };

  const renderBubbleRow = (tasksOpen, rowKey) => {
    if (!tasksOpen || tasksOpen.length === 0) return null;
    const sorted = [...tasksOpen].sort((a, b) => xFor(a.start) - xFor(b.start));
    let runningRight = 0;
    const connectors = [];
    const cards = sorted.map((t, i) => {
      const st = ctx.statuses.find((s) => s.id === t.statusId) || ctx.statuses[0] || { color: "var(--text-muted)" };
      const barLeft = xFor(t.start);
      const barWidth = Math.max(dayWidth, xFor(t.end) - xFor(t.start) + dayWidth);
      const bubbleWidth = Math.min(560, Math.max(barWidth, 300));
      const targetLeft = Math.max(0, Math.min(barLeft, timelineWidth - bubbleWidth));
      const marginLeft = i === 0 ? targetLeft : Math.max(8, targetLeft - runningRight);
      runningRight += marginLeft + bubbleWidth;
      connectors.push(<div key={t.id + "-conn"} className="lp-bubble-connector" style={{ left: Math.max(4, Math.min(barLeft, timelineWidth - 4)), borderBottomColor: st.color }} />);
      const cl = t.checklist || [];
      const clPct = cl.length > 0 ? Math.round((cl.filter((i) => i.done).length / cl.length) * 100) : 0;
      return (
        <div key={t.id} className="lp-bubble-card" style={{ width: bubbleWidth, marginLeft, flex: "0 0 auto", borderTop: `3px solid ${st.color}` }} ref={(node) => { bubbleNodes.current[t.id] = node; }}>
          {cl.length > 0 && (
            <div className="lp-card-checklist-bar"><div className="lp-card-checklist-bar-fill" style={{ width: `${clPct}%` }} /></div>
          )}
          {bubbleFields.includes("checklist") && cl.length > 0 && (
            <div className="lp-bubble-card-checklist" style={{ background: st.color + "10" }}>
              {t.checklist.map((item) => (
                <label className="lp-checklist-item" key={item.id}>
                  <input type="checkbox" checked={item.done} onChange={() => toggleChecklist(t.id, item.id)} />
                  <span style={{ flex: 1, textDecoration: item.done ? "line-through" : "none", color: item.done ? "var(--text-600)" : "var(--text-900)" }}>{item.text}</span>
                  {(item.start || item.end) && <span className="lp-date-badge" style={{ fontSize: 9.5, flex: "0 0 auto" }}>{fmtShort(item.end || item.start)}</span>}
                </label>
              ))}
            </div>
          )}
          <div className="lp-bubble-card-fields">
            {bubbleFields.filter((k) => k !== "checklist").map((k) => <FieldValue key={k} fieldKey={k} task={t} ctx={ctx} gradient={gradient} progressByStatus={appearance.progressColorByStatus} onProgressChange={k === "progress" ? updateProgress : undefined} />)}
            <button className="lp-bubble-delete" onClick={() => onDelete(t)} title="Supprimer la tâche"><Trash2 size={12} /></button>
          </div>
        </div>
      );
    });
    return (
      <div className="lp-gantt-bubble-line" key={rowKey} style={{ background: ganttBg, width: timelineWidth, minWidth: timelineWidth, flex: "0 0 auto" }}>
        <div className="lp-gantt-bubble-cell" style={{ width: timelineWidth, minWidth: timelineWidth, background: ganttBg, display: "flex", alignItems: "flex-start", position: "relative", minHeight: 20, boxSizing: "border-box" }}>
          {ticks.map((tk, i) => <div key={i} style={{ position: "absolute", left: xFor(tk.start), top: 0, bottom: 0, width: 1, background: gridLineColor }} />)}
          {renderTemporalBlocks()}
          {dayIndex(today) >= originIdx && dayIndex(today) <= originIdx + timelineWidth / dayWidth && <div className="lp-gantt-today" style={{ left: xFor(today) }} title="Aujourd'hui" />}
          {connectors}
          {cards}
        </div>
      </div>
    );
  };

  return (
    <div>
      <ViewToolbarPortal slot={toolbarSlot}>

        <div className="lp-zoom-group">
          {ZOOMS.map((z) => <button key={z.key} className={"lp-zoom-btn" + (zoomKey === z.key ? " active" : "")} onClick={() => setZoomKey(z.key)}>{z.label}</button>)}
        </div>
        <button className="lp-tool-btn" onClick={recenterToday} title="Aujourd'hui"><Crosshair size={14} /></button>
        <button className="lp-tool-btn" onClick={fitAll} title="Zoom automatique"><Maximize2 size={14} /></button>
        <button className="lp-tool-btn" onClick={() => setAnnotationPanel({ section: "blocks", autoCreate: "block" })} title="Ajouter une grande phase transverse (Études, Gros œuvre…)">
          <Plus size={13} /> Bloc temporel
        </button>
        <button className="lp-tool-btn" onClick={() => setAnnotationPanel({ section: "frames", autoCreate: "frame" })} title="Encadrer une ou plusieurs tâches">
          <Plus size={13} /> Encadré
        </button>
        {!embedded && (
          <button className="lp-tool-btn" onClick={toggleAllBubbles} title={allOpen ? "Replier les tâches" : "Déplier les tâches"}>{allOpen ? <ChevronsUp size={14} /> : <ChevronsDown size={14} />}</button>
        )}
        {!embedded && (
          <button className="lp-tool-btn" onClick={toggleAllGroups} title={allGroupsExpanded ? "Replier les groupes" : "Déplier les groupes"}>{allGroupsExpanded ? <ChevronUp size={14} /> : <ChevronDown size={14} />}</button>
        )}
        {!embedded && (
          <button className={"lp-tool-btn" + (appearance.ganttShowSubtasks ? " active" : "")} onClick={() => setAppearance((a) => ({ ...a, ganttShowSubtasks: !a.ganttShowSubtasks }))} title="Afficher les sous-tâches en mode carte de métro, dans les barres">
            <GripVertical size={14} />
          </button>
        )}
        {!embedded && (
          <DropdownButton label="" icon={<Layers size={14} />} title={`Grouper par : ${fieldLabel(ganttGroupBy, ctx)}`}>
            {GANTT_GROUP_OPTIONS.map((k) => (
              <label className="lp-checkbox-line" key={k}><input type="radio" name="lp-gantt-gb" checked={ganttGroupBy === k} onChange={() => setGanttGroupBy(k)} /> {fieldLabel(k, ctx)}</label>
            ))}
            {(ctx.customFieldDefs || []).length > 0 && (
              <>
                <div className="lp-dropdown-group-label">Champs personnalisés</div>
                {ctx.customFieldDefs.map((f) => (
                  <label className="lp-checkbox-line" key={f.id}><input type="radio" name="lp-gantt-gb" checked={ganttGroupBy === "cf:" + f.id} onChange={() => setGanttGroupBy("cf:" + f.id)} /> {f.name}</label>
                ))}
              </>
            )}
          </DropdownButton>
        )}
        {!embedded && (
          <DropdownButton label="" icon={<Columns3 size={14} />} title="Colonnes">
            {GANTT_COL_OPTIONS.map((c) => (
              <label className="lp-checkbox-line" key={c.key}>
                <input type="checkbox" checked={ganttCols.includes(c.key)} onChange={() => setGanttCols((prev) => prev.includes(c.key) ? prev.filter((x) => x !== c.key) : [...prev, c.key])} />
                {c.label}
              </label>
            ))}
          </DropdownButton>
        )}
        {!embedded && (
          <DropdownButton label="" icon={<Settings size={14} />} title="Champs de la bulle">
            {BUBBLE_FIELD_OPTIONS.map((k) => (
              <label className="lp-checkbox-line" key={k}><input type="checkbox" checked={bubbleFields.includes(k)} onChange={() => setBubbleFields((f) => (f.includes(k) ? f.filter((x) => x !== k) : [...f, k]))} /> {fieldLabel(k)}</label>
            ))}
          </DropdownButton>
        )}
        {embedded && (
          <DropdownButton label="" icon={<MoreHorizontal size={14} />} title="Plus d'options">
            <label className="lp-checkbox-line"><input type="checkbox" checked={allOpen} onChange={toggleAllBubbles} /> Déplier toutes les tâches</label>
            <label className="lp-checkbox-line"><input type="checkbox" checked={allGroupsExpanded} onChange={toggleAllGroups} /> Déplier les groupes</label>
            <label className="lp-checkbox-line"><input type="checkbox" checked={!!appearance.ganttShowSubtasks} onChange={() => setAppearance((a) => ({ ...a, ganttShowSubtasks: !a.ganttShowSubtasks }))} /> Afficher les sous-tâches</label>
            <hr className="lp-divider" style={{ margin: "6px 0" }} />
            <div className="lp-dropdown-group-label">Grouper par</div>
            {GANTT_GROUP_OPTIONS.map((k) => (
              <label className="lp-checkbox-line" key={k}><input type="radio" name="lp-gantt-gb-embed" checked={ganttGroupBy === k} onChange={() => setGanttGroupBy(k)} /> {fieldLabel(k, ctx)}</label>
            ))}
            <hr className="lp-divider" style={{ margin: "6px 0" }} />
            <div className="lp-dropdown-group-label">Colonnes</div>
            {GANTT_COL_OPTIONS.map((c) => (
              <label className="lp-checkbox-line" key={c.key}>
                <input type="checkbox" checked={ganttCols.includes(c.key)} onChange={() => setGanttCols((prev) => prev.includes(c.key) ? prev.filter((x) => x !== c.key) : [...prev, c.key])} />
                {c.label}
              </label>
            ))}
          </DropdownButton>
        )}
      </ViewToolbarPortal>

      <div className="lp-gantt-wrap" ref={scrollRef}>
        <div style={{ minWidth: (nameCollapsed ? 0 : TOTAL_LEFT_W) + 16 + timelineWidth }}>
          {zoom.top && (
            <div className="lp-gantt-header-row" style={{ height: topH }}>
              <div className="lp-gantt-corner" style={{ width: (nameCollapsed ? 0 : (effectiveNameW + COLS_W)) + 16, height: topH, position: "relative", display: "flex", alignItems: "center", padding: nameCollapsed ? 0 : "0 14px", overflow: "hidden" }}>
                {!nameCollapsed && <>Tâche<div className="lp-gantt-name-resize" onMouseDown={startNameResize} title="Glisser pour redimensionner la colonne titre" /></>}
              </div>
              <div style={{ position: "relative", flex: "1 0 auto", minWidth: timelineWidth, height: topH }}>
                {topGroups.map((g, i) => <div key={i} className="lp-gantt-month" style={{ left: xFor(g.start), width: g.len * dayWidth }}>{g.label}</div>)}
              </div>
            </div>
          )}
          <div className="lp-gantt-header-row" style={{ top: topH }}>
            {/* Le panneau gauche du header : bouton collapse + colonnes */}
            <div style={{ width: (nameCollapsed ? 0 : (effectiveNameW + COLS_W)) + 16, background: "#fff", position: "sticky", left: 0, zIndex: 12, borderRight: "1px solid var(--border)", borderBottom: "1px solid var(--border)", display: "flex", flex: "0 0 auto" }}>
              {/* Bouton collapse toujours visible */}
              <button
                onClick={() => setNameCollapsed((c) => !c)}
                title={nameCollapsed ? "Afficher la colonne Tâche" : "Masquer la colonne Tâche"}
                style={{ width: 16, flex: "0 0 16px", background: "var(--paper-soft)", border: "none", borderRight: "1px solid var(--border)", cursor: "pointer", display: "flex", alignItems: "center", justifyContent: "center", color: "var(--text-600)", fontSize: 10, fontWeight: 900, padding: 0 }}
              >
                {nameCollapsed ? "›" : "‹"}
              </button>
              {/* Colonne titre (masquée si collapsed) */}
              {!nameCollapsed && (
                <div style={{ width: effectiveNameW, flex: `0 0 ${effectiveNameW}px`, position: "relative", display: "flex", alignItems: "center", padding: "0 12px", fontSize: 11, fontWeight: 700, color: "var(--text-600)", textTransform: "uppercase", letterSpacing: ".4px", borderRight: "1px solid var(--border)", overflow: "hidden" }}>
                  Tâche
                  <div className="lp-gantt-name-resize" onMouseDown={startNameResize} title="Glisser pour redimensionner" />
                </div>
              )}
              {/* Colonnes de données — masquées si collapsed */}
              {!nameCollapsed && colDefs.map((c) => (
                <div key={c.key} style={{ width: c.w, flex: `0 0 ${c.w}px`, display: "flex", alignItems: "center", justifyContent: "center", fontSize: 10, fontWeight: 700, color: "var(--text-600)", textTransform: "uppercase", letterSpacing: ".3px", borderRight: "1px solid var(--border)", overflow: "hidden" }}>
                  {c.label}
                </div>
              ))}
            </div>
            <div className="lp-gantt-weeks" style={{ flex: "1 0 auto", minWidth: timelineWidth }}>
              {ticks.map((t, i) => <div key={i} className="lp-gantt-week" style={{ left: xFor(t.start), width: t.len * dayWidth }}>{t.len * dayWidth > 18 ? t.label : ""}</div>)}
            </div>
          </div>

          {tasks.length === 0 && <div className="lp-empty">Aucune tâche ne correspond aux filtres actifs.</div>}
          <div className="lp-gantt-rows" ref={rowsWrapRef}>
          {groupedLanes.map((g) => {
            const expanded = expandedGroups[g.key] !== false;
            const proj = ganttGroupBy === "project" ? ctx.projects.find((p) => p.id === g.key) : null;
            const groupReorderable = ganttGroupBy === "project" || ganttGroupBy === "status";
            const reorderGanttGroup = (draggedKey, targetKey) => {
              if (ganttGroupBy === "project") setProjects((prev) => reorderArray(prev, draggedKey, targetKey));
              else if (ganttGroupBy === "status") setStatuses((prev) => reorderArray(prev, draggedKey, targetKey));
            };
            const onGroupDrop = (e) => {
              e.preventDefault();
              const draggedGroupKey = e.dataTransfer.getData("application/x-nexora-gantt-group");
              if (draggedGroupKey && draggedGroupKey !== g.key) { reorderGanttGroup(draggedGroupKey, g.key); return; }
              const taskId = e.dataTransfer.getData("application/x-nexora-task");
              if (taskId) setTaskField(setTasks, taskId, ganttGroupBy, g.key);
            };

            // Composant inline de cellule de données pour une tâche
            const GanttDataCell = ({ t, colKey, w }) => {
              const st = ctx.statuses.find((s) => s.id === t.statusId);
              const tt = ctx.taskTypes.find((s) => s.id === t.taskTypeId);
              const pr = ctx.projects.find((p) => p.id === t.projectId);
              const style = { width: w, flex: `0 0 ${w}px`, borderRight: "1px solid var(--border)", height: ROW_H, display: "flex", alignItems: "center", justifyContent: "center", padding: "0 4px", fontSize: 10.5, overflow: "hidden" };
              if (colKey === "status") return <div style={style}>{st && <span className="lp-chip" style={{ background: st.color + "22", color: st.color, fontSize: 9.5, padding: "1px 5px", whiteSpace: "nowrap", maxWidth: "100%", overflow: "hidden", textOverflow: "ellipsis" }}>{st.name}</span>}</div>;
              if (colKey === "criticality") { const c = criticalityOf(t); return <div style={style}>{c && <span className="lp-chip" style={{ background: c.color + "22", color: c.color, fontSize: 9.5, padding: "1px 5px", whiteSpace: "nowrap", maxWidth: "100%", overflow: "hidden", textOverflow: "ellipsis" }}>{c.name}</span>}</div>; }
              if (colKey === "taskType") return <div style={style}>{tt && <span className="lp-chip" style={{ background: tt.color + "22", color: tt.color, fontSize: 9.5, padding: "1px 5px", whiteSpace: "nowrap", maxWidth: "100%", overflow: "hidden", textOverflow: "ellipsis" }}>{tt.name}</span>}</div>;
              if (colKey === "project") return <div style={style}>{pr && <span style={{ display: "flex", alignItems: "center", gap: 3, color: pr.color, fontSize: 10, fontWeight: 600, whiteSpace: "nowrap", overflow: "hidden", textOverflow: "ellipsis" }}><span className="lp-project-dot" style={{ background: pr.color, width: 11, height: 11, fontSize: 7, flex: "0 0 auto" }}><IconGlyph icon={pr.icon} size={7} /></span>{pr.name}</span>}</div>;
              if (colKey === "assignee") return <div style={{ ...style, justifyContent: "flex-start", fontSize: 10.5, color: "var(--text-900)", whiteSpace: "nowrap", overflow: "hidden", textOverflow: "ellipsis" }}>{t.assignee}</div>;
              if (colKey === "start") return <div style={{ ...style, fontFamily: "monospace", fontSize: 10, color: "var(--text-600)" }}>{fmtShort(t.start)}</div>;
              if (colKey === "end") return <div style={{ ...style, fontFamily: "monospace", fontSize: 10, color: "var(--text-600)" }}>{fmtShort(t.end)}</div>;
              if (colKey === "progress") return <div style={style}><div style={{ width: "90%", height: 5, background: appearance.progressColorByStatus ? "#EAEDF3" : "var(--border)", borderRadius: 9 }}><div style={{ height: "100%", width: `${t.progress}%`, background: appearance.progressColorByStatus ? (st?.color || "var(--success)") : "var(--success)", borderRadius: 9 }} /></div></div>;
              if (colKey === "period") return <div style={{ ...style, fontSize: 10, color: "var(--text-600)" }}>{monthLabel(periodOf(t.end))}</div>;
              return <div style={style} />;
            };

            return (
              <React.Fragment key={g.key}>
                {/* Ligne d'en-tête de groupe : s'étend sur TOTAL_LEFT_W */}
                {/* Ligne de groupe — masquée entièrement si panneau collapsed ET sans colonnes */}
                {!nameCollapsed && (effectiveNameW + COLS_W) > 0 && (
                <div className="lp-gantt-group-row" style={{ top: topH, width: "100%" }}>
                  <div className="lp-gantt-group-name-timeline" style={{ width: effectiveNameW + COLS_W, background: `color-mix(in srgb, ${proj?.color || g.color || "var(--text-muted)"} 10%, white)`, display: "flex", padding: 0, gap: 0 }}>
                    {/* Cellule titre du groupe — même largeur que effectiveNameW */}
                    <div style={{ width: effectiveNameW, minWidth: effectiveNameW, maxWidth: effectiveNameW, display: "flex", alignItems: "center", gap: 4, padding: "0 6px", borderRight: "1px solid var(--border)", overflow: "hidden", boxSizing: "border-box" }}>
                      <button className="lp-group-toggle" onClick={() => setExpandedGroups((e) => ({ ...e, [g.key]: !expanded }))} title={expanded ? "Replier" : "Déplier"} style={{ flexShrink: 0 }}>
                        {expanded ? <ChevronDown size={13} /> : <ChevronRight size={13} />}
                      </button>
                      {groupReorderable && (
                        <span className="lp-drag-handle" draggable onMouseDown={(e) => e.stopPropagation()} onDragStart={(e) => { e.stopPropagation(); e.dataTransfer.setData("application/x-nexora-gantt-group", g.key); }} onClick={(e) => e.stopPropagation()} title="Glisser pour trier" style={{ flexShrink: 0 }}>
                          <GripVertical size={12} />
                        </span>
                      )}
                      {proj ? <IconGlyph icon={proj.icon} size={13} /> : <span className="lp-status-dot" style={{ background: g.color || "var(--text-muted)", flexShrink: 0 }} />}
                      <span style={{ whiteSpace: "nowrap", overflow: "hidden", textOverflow: "ellipsis", flex: 1, fontWeight: 700, fontSize: 11, textTransform: "uppercase", letterSpacing: ".3px", color: "var(--text-600)" }}>{g.label}</span>
                      <span className="lp-group-count" style={{ flexShrink: 0 }}>{g.tasks.length}</span>
                      <button className="lp-gantt-group-btn" onClick={() => { const defs = {}; if (ganttGroupBy === "project") defs.projectId = g.key; else if (ganttGroupBy === "status") defs.statusId = g.key; onAdd(defs); }} title={`Ajouter dans « ${g.label} »`} style={{ flexShrink: 0 }}><Plus size={12} /></button>
                      {g.tasks.length > 0 && <button className="lp-gantt-group-btn lp-gantt-group-btn-danger" onClick={() => onBulkDelete(g.tasks.map((t) => t.id), `du groupe « ${g.label} »`)} title="Supprimer toutes les tâches" style={{ flexShrink: 0 }}><Trash2 size={12} /></button>}
                    </div>
                    {/* Cellules des colonnes de données — vides pour le groupe, mais présentes pour l'alignement */}
                    {colDefs.map((c) => (
                      <div key={c.key} style={{ width: c.w, minWidth: c.w, maxWidth: c.w, height: "100%", borderRight: "1px solid var(--border)", boxSizing: "border-box" }} />
                    ))}
                  </div>
                  <div style={{ position: "absolute", left: 0, right: 0, top: 0, bottom: 0, zIndex: 0, background: (proj?.color || g.color || "var(--text-muted)") + "12" }} />
                  {ganttGroupBy === "project" && g.tasks.filter((t) => t.milestone).map((m) => {
                    const mColor = ctx.statuses.find((s) => s.id === m.statusId)?.color || proj?.color || "var(--text-muted)";
                    return (
                      <div
                        key={m.id}
                        className="lp-gantt-group-milestone"
                        style={{ left: effectiveNameW + COLS_W + xFor(m.end), background: mColor }}
                        title={`${m.title} — ${fmtShort(m.end)}`}
                        onClick={() => onOpen(m)}
                      />
                    );
                  })}
                </div>
                )}

                {expanded && g.lanes.map((lane, li) => {
                  const t = lane[0];
                  if (!t) return null;
                  const done = isTaskDoneGlobal(t, ctx);
                  const urgent = isTaskUrgent(t, ctx);
                  // Largeur réelle du panneau gauche selon l'état collapsed
                  // Quand nameCollapsed : on masque TOUT le panneau gauche (titre + colonnes)
                  const showLeft = !nameCollapsed;
                  const groupBg = `color-mix(in srgb, ${proj?.color || g.color || "var(--text-muted)"} 5%, white)`;
                  const groupBorder = `3px solid ${proj?.color || g.color || "var(--text-muted)"}`;
                  // Largeur réelle : colonne titre (fixe) + somme des colonnes de données (fixes)
                  const panelW = effectiveNameW + COLS_W;
                  return (
                    <React.Fragment key={g.key + "-lane-" + li}>
                      <div style={{ display: "flex" }} ref={(el) => { if (el) rowNodes.current[t.id] = el; else delete rowNodes.current[t.id]; }}>
                        {/* Panneau gauche sticky — masqué entièrement si nameCollapsed */}
                        {showLeft && panelW > 0 && (
                          <div
                            className="lp-gantt-group-left-panel"
                            style={{ width: panelW, flex: `0 0 ${panelW}px`, background: urgent ? `${groupBg} repeating-linear-gradient(45deg, color-mix(in srgb, var(--danger) 5%, transparent) 0 6px, color-mix(in srgb, var(--danger) 11%, transparent) 6px 12px)` : groupBg, borderRight: urgent ? "3px solid var(--danger)" : groupBorder, height: ROW_H, display: "flex", flexDirection: "row", flexWrap: "nowrap", overflow: "hidden" }}
                            onDragOver={(e) => e.preventDefault()}
                            onDrop={(e) => { const taskId = e.dataTransfer.getData("application/x-nexora-task"); if (taskId && taskId !== t.id) { const dragged = tasks.find((x) => x.id === taskId); if (dragged && !matchesGroupKey(dragged, ganttGroupBy, g.key, ctx)) setTaskField(setTasks, taskId, ganttGroupBy, g.key); setTasks((prev) => reorderArray(prev, taskId, t.id)); } }}
                          >
                            {/* Cellule titre — largeur fixe exacte */}
                            <div style={{ width: effectiveNameW, minWidth: effectiveNameW, maxWidth: effectiveNameW, height: ROW_H, display: "flex", alignItems: "center", gap: 4, padding: "0 6px", borderRight: "1px solid rgba(10,15,25,0.08)", overflow: "hidden", boxSizing: "border-box" }}>
                              <span className="lp-drag-handle" draggable onMouseDown={(e) => e.stopPropagation()} onDragStart={(e) => { e.stopPropagation(); e.dataTransfer.setData("application/x-nexora-task", t.id); }} onClick={(e) => e.stopPropagation()} title="Glisser" style={{ flexShrink: 0 }}><GripVertical size={11} /></span>
                              <button className={"lp-mark-done" + (done ? " done" : "")} draggable={false} onMouseDown={(e) => e.stopPropagation()} onClick={(e) => { e.stopPropagation(); onMarkDone(t.id); }} title="Marquer terminé" style={{ flexShrink: 0 }}><CheckCircle2 size={13} /></button><button className="lp-cycle-btn" draggable={false} onMouseDown={(e) => e.stopPropagation()} onClick={(e) => { e.stopPropagation(); onCycleStatus(t.id); }} title="Changer le statut" style={{ flexShrink: 0 }}><RefreshCw size={12} /></button>
                              <span className="lp-project-dot" style={{ background: ctx.projects.find((x) => x.id === t.projectId)?.color, width: 13, height: 13, fontSize: 7, flexShrink: 0 }}><IconGlyph icon={ctx.projects.find((x) => x.id === t.projectId)?.icon} size={8} /></span>
                              {t.milestone && <MilestoneGlyph size={11} style={{ flexShrink: 0 }} icon={resolveMilestoneIcon(t, ctx)} />}
                              <span className="lp-hover-wrap" style={{ fontSize: 12, color: done ? "var(--text-600)" : "var(--text-900)", cursor: "pointer", textDecoration: done ? "line-through" : "none", whiteSpace: "nowrap", overflow: "hidden", textOverflow: "ellipsis", minWidth: 0, flexShrink: 1, fontWeight: 500 }} onClick={() => onOpen(t)}>
                                {t.title}
                                <TaskHoverCard task={t} ctx={ctx} />
                              </span>
                            </div>
                            {/* Cellules de données — largeurs fixes, affichées à droite du titre */}
                            {colDefs.map((c) => <GanttDataCell key={c.key} t={t} colKey={c.key} w={c.w} />)}
                          </div>
                        )}
                        {/* Piste de la barre */}
                        <div
                          className="lp-gantt-row" style={{ height: ROW_H, flex: 1 }}
                          onDragOver={(e) => e.preventDefault()}
                          onDrop={(e) => { e.stopPropagation(); const taskId = e.dataTransfer.getData("application/x-nexora-task"); if (!taskId) return; const dragged = tasks.find((x) => x.id === taskId); if (!dragged) return; if (!matchesGroupKey(dragged, ganttGroupBy, g.key, ctx)) setTaskField(setTasks, taskId, ganttGroupBy, g.key); if (t.id !== taskId) setTasks((prev) => reorderArray(prev, taskId, t.id)); }}
                        >
                          <div className="lp-gantt-track" style={{ flex: "1 0 auto", minWidth: timelineWidth, height: ROW_H, background: ganttBg }}>
                            {ticks.map((tk, i) => <div key={i} style={{ position: "absolute", left: xFor(tk.start), top: 0, bottom: 0, width: 1, background: gridLineColor }} />)}
                            {renderTemporalBlocks()}
                            {dayIndex(today) >= originIdx && dayIndex(today) <= originIdx + timelineWidth / dayWidth && <div className="lp-gantt-today" style={{ left: xFor(today) }} title="Aujourd'hui" />}
                            {renderShape(t, 0)}
                          </div>
                        </div>
                      </div>
                      {/* Bulle sous la voie */}
                      {bubbles[t.id] && (
                        <div style={{ display: "flex", alignItems: "stretch", position: "relative" }}>
                          {showLeft && panelW > 0 && <div style={{ width: panelW, flex: `0 0 ${panelW}px`, background: groupBg, borderRight: groupBorder, minHeight: "100%", position: "sticky", left: 0, zIndex: 10 }} />}
                          <div style={{ flex: "1 0 auto", minWidth: timelineWidth, width: timelineWidth, position: "relative" }}>
                            {/* Continuité visuelle : repères de grille + ligne "aujourd'hui" traversant aussi la bulle */}
                            <div style={{ position: "absolute", inset: 0, pointerEvents: "none", zIndex: 0 }}>
                              {ticks.map((tk, i) => <div key={i} style={{ position: "absolute", left: xFor(tk.start), top: 0, bottom: 0, width: 1, background: gridLineColor }} />)}
                              {renderTemporalBlocks()}
                              {dayIndex(today) >= originIdx && dayIndex(today) <= originIdx + timelineWidth / dayWidth && <div className="lp-gantt-today" style={{ left: xFor(today) }} />}
                            </div>
                            <div style={{ position: "relative", zIndex: 1 }}>{renderBubbleRow([t], `${g.key}-bl-${li}`)}</div>
                          </div>
                        </div>
                      )}
                    </React.Fragment>
                  );
                })}
              </React.Fragment>
            );
          })}
          {(temporalBlockShapes.length > 0 || frameShapes.length > 0) && (
            <div className="lp-gantt-annot-layer" style={{ left: rowsPanelW, width: timelineWidth }}>
              {temporalBlockShapes.map((shape) => (
                <button
                  key={shape.block.id}
                  type="button"
                  className="lp-gantt-tblock-label"
                  style={{ left: shape.left + 4 + shape.labelOffset, color: shape.block.color }}
                  title={`${shape.block.title} · ${fmtShort(shape.block.startDate)} → ${fmtShort(shape.block.endDate)} — cliquer pour modifier`}
                  onClick={() => setAnnotationPanel({ section: "blocks", focusId: shape.block.id })}
                >
                  {shape.block.title}
                </button>
              ))}
              {frameShapes.map((seg) => {
                const left = xForIdx(seg.startIdx) - seg.padding;
                const width = Math.max(4, (seg.endIdx - seg.startIdx + 1) * dayWidth + seg.padding * 2);
                return (
                  <React.Fragment key={seg.key}>
                    <div
                      className="lp-gantt-frame"
                      style={{ left, width, top: seg.top, height: seg.height, border: `2px ${seg.frame.borderStyle} ${seg.frame.color}` }}
                    />
                    {seg.frame.label && (
                      <button
                        type="button"
                        className="lp-gantt-frame-label"
                        style={{ left, top: Math.max(0, seg.top - 13) + (seg.labelOffset || 0), background: seg.frame.color }}
                        title={`${seg.frame.label} — cliquer pour modifier`}
                        onClick={() => setAnnotationPanel({ section: "frames", focusId: seg.frame.id })}
                      >
                        {seg.frame.label}
                      </button>
                    )}
                  </React.Fragment>
                );
              })}
            </div>
          )}
          </div>
        </div>
      </div>

      {annotationPanel && (
        <Modal
          title="Annotations du Gantt"
          onClose={() => setAnnotationPanel(null)}
          wide
          footer={<button className="lp-btn lp-btn-primary" onClick={() => setAnnotationPanel(null)}>Terminé</button>}
        >
          <GanttAnnotationsEditor
            blocks={rawTemporalBlocks}
            frames={rawHighlightFrames}
            tasks={tasks}
            ctx={ctx}
            defaultStart={rangeStart}
            defaultEnd={rangeEnd}
            onChange={applyAnnotations}
            initialSection={annotationPanel.section}
            autoCreate={annotationPanel.autoCreate}
            focusId={annotationPanel.focusId}
          />
        </Modal>
      )}
    </div>
  );
}

// ============================================================================
// Modale Tâche (avec checklist)
// ============================================================================

function LinkedActivitySelect({ activities, projects, value, onChange }) {
  const [open,setOpen]=useState(false), [query,setQuery]=useState("");
  const ref=useRef(null);
  useEffect(()=>{ const close=e=>{if(ref.current&&!ref.current.contains(e.target))setOpen(false)}; document.addEventListener("mousedown",close); return()=>document.removeEventListener("mousedown",close)},[]);
  const projectName=a=>projects.find(p=>p.id===a.projectId)?.name||"Sans projet";
  const selected=activities.find(a=>a.id===value);
  const q=query.trim().toLocaleLowerCase("fr");
  const filtered=activities.filter(a=>!q||`${a.title||""} ${projectName(a)}`.toLocaleLowerCase("fr").includes(q))
    .sort((a,b)=>projectName(a).localeCompare(projectName(b),"fr")||(a.title||"").localeCompare(b.title||"","fr"));
  const choose=id=>{onChange(id);setQuery("");setOpen(false)};
  return <div className="lp-activity-search-select" ref={ref}>
    <button type="button" className="lp-activity-search-trigger" onClick={()=>setOpen(v=>!v)}>
      <span className="lp-activity-search-trigger-text">
        {selected?<><strong>{selected.title}</strong><span>{projectName(selected)}</span></>:<span className="lp-activity-empty-value">Aucune — action autonome</span>}
      </span><ChevronDown size={15}/>
    </button>
    {open&&<div className="lp-activity-search-menu">
      <div className="lp-activity-search-box"><Search size={14}/><input autoFocus value={query} onChange={e=>setQuery(e.target.value)} placeholder="Rechercher activité ou projet…" onKeyDown={e=>{if(e.key==="Escape")setOpen(false)}}/>{query&&<button type="button" onClick={()=>setQuery("")}><X size={12}/></button>}</div>
      <div className="lp-activity-search-options">
        <button type="button" className={"lp-activity-search-option none"+(!value?" selected":"")} onClick={()=>choose("")}><span className="lp-activity-option-main">Aucune — action autonome</span><span className="lp-activity-option-project">Sans activité</span></button>
        {filtered.length===0?<div className="lp-activity-search-empty">Aucune activité correspondante.</div>:filtered.map(a=>{const p=projects.find(x=>x.id===a.projectId);return <button type="button" key={a.id} className={"lp-activity-search-option"+(a.id===value?" selected":"")} onClick={()=>choose(a.id)}><span className="lp-activity-option-dot" style={{borderColor:p?.color||"var(--line-blue)"}}/><span className="lp-activity-option-main">{a.title}</span><span className="lp-activity-option-project">{p?.name||"Sans projet"}</span>{a.id===value&&<Check size={13}/>}</button>})}
      </div>
    </div>}
  </div>;
}


function TaskWritingModeOverlay({
  title,
  project,
  status,
  assignee,
  start,
  end,
  progress,
  milestone,
  desc,
  onChangeDesc,
  onClose,
  shortcutPrefs,
  modeLabel = "Mode écriture",
  showTaskMeta = true,
}) {
  const [preview, setPreview] = useState(false);
  const textareaRef = useRef(null);

  useEffect(() => {
    if (!preview) requestAnimationFrame(()=>textareaRef.current?.focus());
  }, [preview]);

  const insert = (payload, cursorOffset = null) => {
    insertMarkdownAtCursor({
      textarea:textareaRef.current,
      value:desc || "",
      insert:payload,
      onChange:onChangeDesc,
      cursorOffset,
    });
  };

  useEffect(() => {
    const onKey = (e) => {
      const key = String(e.key || "");
      const ctrlLeft =
        e.ctrlKey &&
        !e.altKey &&
        !e.shiftKey &&
        !e.metaKey &&
        (key === "ArrowLeft" || e.code === "ArrowLeft");

      const ctrlSpace =
        e.ctrlKey &&
        !e.altKey &&
        !e.shiftKey &&
        !e.metaKey &&
        (key === " " || key === "Spacebar" || e.code === "Space");

      // 1) Ctrl + ← : toujours disponible dans le Mode écriture.
      if (ctrlLeft || matchesShortcutCombo(e, shortcutPrefs?.markdownPreviewToggle || "Ctrl+ArrowLeft")) {
        e.preventDefault();
        e.stopPropagation();
        setPreview((v)=>!v);
        return;
      }

      // 2) Ctrl + Espace : toujours disponible quand on écrit.
      // L'insertion se fait exactement à la position du curseur.
      if (!preview && (ctrlSpace || matchesShortcutCombo(e, shortcutPrefs?.markdownChecklist || "Ctrl+Space"))) {
        e.preventDefault();
        e.stopPropagation();
        insertMarkdownAtCursor({
          textarea:textareaRef.current,
          value:desc || "",
          insert:"- [ ] ",
          onChange:onChangeDesc,
        });
        return;
      }

      if (e.key === "Escape") {
        e.preventDefault();
        e.stopPropagation();
        onClose?.();
      }
    };

    // Capture=true : ces deux raccourcis sont traités avant les gestionnaires
    // du navigateur, de la modale et des autres composants Nexora.
    document.addEventListener("keydown", onKey, true);
    return () => document.removeEventListener("keydown", onKey, true);
  }, [onClose, shortcutPrefs, preview, desc, onChangeDesc]);

  return (
    <div className="lp-writing-mode-overlay" onMouseDown={(e)=>e.stopPropagation()}>
      <div className="lp-writing-mode-shell">
        <div className="lp-writing-mode-head">
          <div className="lp-writing-mode-titleblock">
            <div className="lp-writing-mode-kicker"><Pencil size={13}/> {modeLabel}</div>
            <div className="lp-writing-mode-title">{title || "Sans titre"}</div>
          </div>

          {showTaskMeta && (
            <div className="lp-writing-mode-meta">
              {project && (
                <span className="lp-writing-mode-chip">
                  <span className="lp-writing-mode-dot" style={{background:project.color || "var(--text-muted)"}}/>
                  {project.name}
                </span>
              )}
              {status && (
                <span className="lp-writing-mode-chip">
                  <span className="lp-writing-mode-dot" style={{background:status.color || "var(--text-muted)"}}/>
                  {status.name}
                </span>
              )}
              {assignee && <span className="lp-writing-mode-chip"><User size={11}/>{assignee}</span>}
              {(start || end) && (
                <span className="lp-writing-mode-chip lp-mono">
                  {milestone ? (start ? fmtShort(start) : "Sans date") : `${start ? fmtShort(start) : "—"} → ${end ? fmtShort(end) : "—"}`}
                </span>
              )}
              <span className="lp-writing-mode-chip">{Math.max(0,Math.min(100,Number(progress)||0))}%</span>
            </div>
          )}

          <div className="lp-writing-mode-actions">
            <div className="lp-desc-mode-toggle">
              <button type="button" className={!preview ? "active" : ""} onClick={()=>setPreview(false)}>Écrire</button>
              <button type="button" className={preview ? "active" : ""} onClick={()=>setPreview(true)}>Aperçu</button>
            </div>
            <button type="button" className="lp-icon-btn" onClick={onClose} title="Fermer le mode écriture"><X size={16}/></button>
          </div>
        </div>

        {!preview && (
          <div className="lp-writing-mode-toolbar">
            {Object.entries(CALLOUT_TYPES).map(([key,meta])=>(
              <button
                type="button"
                key={key}
                className="lp-callout-insert-btn"
                style={{color:meta.color,borderColor:meta.color+"55"}}
                onClick={()=>insert(`:::callout-${key} ${meta.label}\n\n:::\n`,-5)}
              >
                {meta.icon} {meta.label}
              </button>
            ))}
            <button type="button" className="lp-callout-insert-btn" onClick={()=>insert("- [ ] ")}>☑ Checklist</button>
          </div>
        )}

        <div className="lp-writing-mode-editor">
          {preview ? (
            <div
              className="lp-writing-mode-preview lp-desc-preview lp-desc-preview-interactive"
              onClick={(e)=>{
                const input=e.target?.closest?.(".lp-md-task-checkbox[data-md-line]");
                if(!input) return;
                e.preventDefault();
                e.stopPropagation();
                onChangeDesc(toggleMarkdownTaskLine(desc || "",Number(input.dataset.mdLine),null));
              }}
              dangerouslySetInnerHTML={{
                __html:renderMarkdown(desc || "",true) || '<p style="color:var(--text-muted)">Aucune description.</p>'
              }}
            />
          ) : (
            <textarea
              ref={textareaRef}
              className="lp-writing-mode-textarea"
              value={desc || ""}
              onChange={(e)=>onChangeDesc(e.target.value)}
              placeholder="Écris ici… Markdown, callouts et checklists sont pris en charge."
            />
          )}
        </div>
      </div>
    </div>
  );
}

function TaskModal({ task, defaults, projects, dashboards, statuses, taskTypes, tasks, teamMembers, gradient, progressColorByStatus, customFieldDefs, shortcutPrefs, onClose, onSave, onDelete, onMarkDone, onCycleStatus, onOpenImpactLine, isFavoriteTask, onToggleFavoriteTask }) {
  const isNew = !task.id;
  const base = isNew ? { ...defaults } : task;
  const [title, setTitle] = useState(base.title || "");
  const [titleError, setTitleError] = useState(false);
  const [projectId, setProjectId] = useState(base.projectId || projects[0]?.id || "");
  const [secondaryProjectId, setSecondaryProjectId] = useState(base.secondaryProjectId || "");
  useEffect(() => { if (secondaryProjectId && secondaryProjectId === projectId) setSecondaryProjectId(""); }, [projectId]);
  // Le type de tâche est résolu AVANT le statut car certains types (ex.
  // "Information") restreignent les statuts disponibles à un seul, choisi
  // automatiquement — voir getStatusesForTask()/getDefaultStatusForTask().
  const initialAllowedTaskTypes = getTaskTypesForProject(taskTypes, projects, base.projectId || projects[0]?.id || "", base.taskTypeId || null);
  const [taskTypeId, setTaskTypeId] = useState(base.taskTypeId || initialAllowedTaskTypes[0]?.id || "");
  const availableTaskTypes = useMemo(
    () => getTaskTypesForProject(taskTypes, projects, projectId, taskTypeId),
    [taskTypes, projects, projectId, taskTypeId]
  );
  useEffect(() => {
    const strictAllowed = getTaskTypesForProject(taskTypes, projects, projectId);
    if (!strictAllowed.some((t)=>t.id===taskTypeId)) {
      const fallback = getDefaultTaskTypeForProject(taskTypes, projects, projectId);
      if (fallback) setTaskTypeId(fallback.id);
    }
  }, [projectId]);
  const initialAllowedStatuses = getStatusesForTask(statuses, projects, taskTypes, base.projectId || projects[0]?.id || "", base.taskTypeId || taskTypeId, base.statusId || null);
  const [statusId, setStatusId] = useState(base.statusId || initialAllowedStatuses[0]?.id || "");
  // Pas de valeur par défaut imposée : une tâche sans criticité n'affiche pas de
  // capsule, plutôt que de se voir attribuer un « Moyen » que personne n'a choisi.
  const [criticality, setCriticality] = useState(base.criticality || "");
  const availableStatuses = useMemo(
    () => getStatusesForTask(statuses, projects, taskTypes, projectId, taskTypeId, statusId),
    [statuses, projects, taskTypes, projectId, taskTypeId, statusId]
  );
  const restrictedStatus = restrictedStatusForType(taskTypes, statuses, taskTypeId);
  useEffect(() => {
    // Se redéclenche à la fois sur un changement de projet ET de type de tâche :
    // c'est ce second cas qui force le statut "Information" dès qu'on bascule
    // sur ce type (et inversement, restaure un statut normal si on le quitte).
    const strictAllowed = getStatusesForTask(statuses, projects, taskTypes, projectId, taskTypeId);
    if (!strictAllowed.some((s)=>s.id===statusId)) {
      const fallback = getDefaultStatusForTask(statuses, projects, taskTypes, projectId, taskTypeId);
      if (fallback) setStatusId(fallback.id);
    }
  }, [projectId, taskTypeId]);
  const [milestone, setMilestone] = useState(base.milestone || false);
  const [milestoneIcon, setMilestoneIcon] = useState(base.milestoneIcon || "");
  const [customFields, setCustomFields] = useState(base.customFields || {});
  const setCustomField = (fieldId, value) => setCustomFields((prev) => ({ ...prev, [fieldId]: value }));
  const [attachments, setAttachments] = useState(base.attachments || []);
  const [attachError, setAttachError] = useState("");
  const [driveName, setDriveName] = useState("");
  const [driveUrl, setDriveUrl] = useState("");
  const [driveError, setDriveError] = useState("");
  const addGoogleDriveAttachment = () => {
    const url = driveUrl.trim();
    setDriveError("");
    if (!url) return;
    if (!isGoogleDriveUrl(url)) {
      setDriveError("Colle une URL Google Drive ou Google Docs valide commençant par https://.");
      return;
    }
    if (attachments.some((a) => String(a.url || "").trim() === url)) {
      setDriveError("Ce lien est déjà rattaché à la tâche.");
      return;
    }
    const kind = googleDriveKind(url);
    setAttachments((prev) => [...prev, {
      id: uid(), type: "link", provider: "google-drive", driveKind: kind,
      name: driveName.trim() || (kind === "folder" ? "Dossier Google Drive" : "Fichier Google Drive"),
      url, addedAt: iso(new Date())
    }]);
    setDriveName("");
    setDriveUrl("");
  };
  const [linkName, setLinkName] = useState("");
  const [linkUrl, setLinkUrl] = useState("");
  const addLinkAttachment = () => {
    if (!linkUrl.trim()) return;
    const url = linkUrl.trim();
    const drive = isGoogleDriveUrl(url);
    setAttachments((prev) => [...prev, { id: uid(), type: "link", provider: drive ? "google-drive" : undefined, driveKind: drive ? googleDriveKind(url) : undefined, name: linkName.trim() || (drive ? (googleDriveKind(url) === "folder" ? "Dossier Google Drive" : "Fichier Google Drive") : url), url, addedAt: iso(new Date()) }]);
    setLinkName(""); setLinkUrl("");
  };
  // Fichiers embarqués tels quels (data-URL) directement dans le document de la
  // tâche — pas de vrai stockage de fichiers dans cette appli, donc on se limite
  // volontairement aux petits fichiers pour ne jamais dépasser la limite de
  // taille d'un document Firestore (1 Mo). Pour les gros plans/PDF, le lien
  // externe (Drive, etc.) reste la bonne option ci-dessus.
  const MAX_ATTACHMENT_BYTES = 350 * 1024;
  const onFileAttach = (e) => {
    const file = e.target.files?.[0];
    e.target.value = "";
    if (!file) return;
    setAttachError("");
    if (file.size > MAX_ATTACHMENT_BYTES) {
      setAttachError(`« ${file.name} » fait ${Math.round(file.size / 1024)} Ko — trop volumineux pour être joint directement (limite ${Math.round(MAX_ATTACHMENT_BYTES / 1024)} Ko). Utilise plutôt un lien externe (Drive, etc.) ci-dessus.`);
      return;
    }
    const reader = new FileReader();
    reader.onload = () => {
      setAttachments((prev) => [...prev, { id: uid(), type: "file", name: file.name, url: reader.result, mime: file.type, size: file.size, addedAt: iso(new Date()) }]);
    };
    reader.readAsDataURL(file);
  };
  const removeAttachment = (id) => setAttachments((prev) => prev.filter((a) => a.id !== id));
  const [start, setStart] = useState(base.start || iso(new Date()));
  const [end, setEnd] = useState(base.end || addDays(iso(new Date()), 5));
  const [duration, setDuration] = useState(Math.max(0, dayIndex(base.end || addDays(iso(new Date()), 5)) - dayIndex(base.start || iso(new Date()))));
  const isGoogleCalendarTask = isGoogleCalendarProjectId(projectId, projects);
  // Méta bloc temporel porté par la tâche. Réservé aux projets calendrier :
  // ce sont leurs tâches qui représentent des périodes réelles (congés,
  // absence, déplacement) importées depuis l'agenda. Seul l'habillage est
  // réglé ici — le titre et les dates restent ceux de la tâche.
  const isCalendarBackedTask = isCalendarBackedProjectId(projectId, projects);
  const [metaBlock, setMetaBlock] = useState(
    base.metaBlock && base.metaBlock.enabled ? { ...base.metaBlock } : null
  );
  const patchMetaBlock = (values) => setMetaBlock((prev) => (prev ? { ...prev, ...values } : prev));
  // Risques de délai : ils appartiennent à la tâche, donc ils s'éditent ICI —
  // le Mini-Gantt ne fait que les dessiner, dans tous les widgets qui affichent
  // cette tâche. Plusieurs risques s'enchaînent dans l'ordre de cette liste.
  const [delayRisks, setDelayRisks] = useState(() => (Array.isArray(base.delayRisks) ? base.delayRisks.map((r) => ({ ...r })) : []));
  const [editingRiskId, setEditingRiskId] = useState(null);
  const patchDelayRisk = (id, values) => setDelayRisks((prev) => prev.map((r) => (r.id === id ? { ...r, ...values } : r)));
  const addDelayRisk = () => {
    const created = { id: uid(), title: "Nouveau risque", color: MINIGANTT_RISK_DEFAULT_COLOR, style: "hatched", severity: "medium", startOffset: null, endOffset: null };
    setDelayRisks((prev) => [...prev, created]);
    setEditingRiskId(created.id);
  };
  const moveDelayRisk = (id, dir) => setDelayRisks((prev) => {
    const i = prev.findIndex((r) => r.id === id);
    const j = i + dir;
    if (i < 0 || j < 0 || j >= prev.length) return prev;
    const next = [...prev];
    [next[i], next[j]] = [next[j], next[i]];
    return next;
  });
  const metaDashboardIds = (dashboards || []).map((d) => d.id);
  const metaCheckedIds = metaBlock && Array.isArray(metaBlock.dashboardIds) ? metaBlock.dashboardIds : metaDashboardIds;
  const toggleMetaDashboard = (dashboardId) => {
    const next = metaCheckedIds.includes(dashboardId)
      ? metaCheckedIds.filter((x) => x !== dashboardId)
      : [...metaCheckedIds, dashboardId];
    // Tous cochés à nouveau : retour à « tous », pour que les tableaux de bord
    // créés plus tard héritent aussi du bloc.
    const isAll = metaDashboardIds.length > 0 && metaDashboardIds.every((id) => next.includes(id));
    patchMetaBlock({ dashboardIds: isAll ? null : next });
  };
  const metaScopeLabel = () => {
    if (!metaBlock || !Array.isArray(metaBlock.dashboardIds)) return "Tous les tableaux de bord";
    const kept = metaBlock.dashboardIds.filter((id) => metaDashboardIds.includes(id));
    if (!kept.length) return "Aucun tableau de bord";
    return `${kept.length} tableau${kept.length > 1 ? "x" : ""} de bord`;
  };
  const computedGoogleStatusId = isGoogleCalendarTask
    ? googleCalendarComputedStatusId({ projectId, start, end: milestone ? start : end, statusId }, projects, statuses, iso(new Date()))
    : statusId;

  useEffect(() => {
    if (!isGoogleCalendarTask) return;
    const computed = googleCalendarComputedStatusId(
      { projectId, start, end: milestone ? start : end, statusId },
      projects,
      statuses,
      iso(new Date())
    );
    if (computed && computed !== statusId) setStatusId(computed);
  }, [isGoogleCalendarTask, projectId, start, end, milestone, statuses, projects]);
  const [progress, setProgress] = useState(base.progress ?? 0);
  const [desc, setDesc] = useState(base.desc || "");
  const [descPreview, setDescPreview] = useState(true);
  const [writingMode, setWritingMode] = useState(false);
  const descRef = useRef(null);

  const [assignee, setAssignee] = useState(base.assignee || "");
  const [checklist, setChecklist] = useState(base.checklist || []);
  const [newItem, setNewItem] = useState("");
  const [dependsOn, setDependsOn] = useState(base.dependsOn || []);
  const [recurrence, setRecurrence] = useState(base.recurrence || null);

  const otherTasks = useMemo(() => (tasks || []).filter((t) => t.id !== task.id), [tasks, task.id]);
  const dependencyTasks = useMemo(() => otherTasks.filter((t) => dependsOn.includes(t.id)), [otherTasks, dependsOn]);
  const conflictingDeps = useMemo(() => dependencyTasks.filter((t) => t.end && start && t.end > start), [dependencyTasks, start]);
  const [depSearch, setDepSearch] = useState("");
  const [depSearchOpen, setDepSearchOpen] = useState(false);
  const depSearchResults = useMemo(() => {
    const q = depSearch.trim().toLowerCase();
    const pool = otherTasks.filter((t) => !dependsOn.includes(t.id));
    const filtered = q ? pool.filter((t) => t.title.toLowerCase().includes(q)) : pool;
    return sortedByName(filtered).slice(0, 8);
  }, [otherTasks, dependsOn, depSearch]);

  // Retire une dépendance et recale la date de début au plus tôt possible :
  // s'il reste d'autres dépendances, la date est recalculée sur leur fin la plus
  // tardive (peut avancer OU reculer). S'il n'en reste plus aucune, la date
  // n'est pas touchée — l'utilisateur redevient libre de la choisir.
  const removeDependency = (depId) => {
    const remaining = dependsOn.filter((x) => x !== depId);
    setDependsOn(remaining);
    if (remaining.length > 0 && !milestone) {
      const remainingTasks = otherTasks.filter((t) => remaining.includes(t.id));
      const ends = remainingTasks.map((t) => t.end).filter(Boolean);
      if (ends.length > 0) {
        const newStart = ends.reduce((m, d) => (d > m ? d : m), ends[0]);
        if (newStart !== start) {
          const shift = dayIndex(newStart) - dayIndex(start);
          setStart(newStart);
          setEnd((prevEnd) => addDays(prevEnd, shift));
        }
      }
    }
  };

  // Détecter si des modifications ont été faites depuis l'ouverture
  const hasChanged = isNew || title !== (base.title || "") || projectId !== (base.projectId || projects[0]?.id || "") || statusId !== (base.statusId || statuses[0]?.id || "") || taskTypeId !== (base.taskTypeId || taskTypes[0]?.id || "") || milestone !== (base.milestone || false) || start !== (base.start || iso(new Date())) || end !== (base.end || addDays(iso(new Date()), 5)) || progress !== (base.progress ?? 0) || desc !== (base.desc || "") || assignee !== (base.assignee || "") || JSON.stringify(checklist) !== JSON.stringify(base.checklist || []) || JSON.stringify(dependsOn) !== JSON.stringify(base.dependsOn || []) || JSON.stringify(recurrence) !== JSON.stringify(base.recurrence || null) || JSON.stringify(customFields) !== JSON.stringify(base.customFields || {}) || JSON.stringify(attachments) !== JSON.stringify(base.attachments || []) || JSON.stringify(metaBlock) !== JSON.stringify(base.metaBlock && base.metaBlock.enabled ? base.metaBlock : null) || JSON.stringify(delayRisks) !== JSON.stringify(base.delayRisks || []);

  useEffect(() => {
    const onKeyDown = (e) => {
      if (matchesShortcutCombo(e, shortcutPrefs?.markdownPreviewToggle || "Ctrl+ArrowLeft")) {
        e.preventDefault();
        e.stopPropagation();
        setDescPreview((v) => !v);
        return;
      }
      if (e.key !== "Escape") return;
      const nestedOpen = document.querySelector(".lp-dropdown-panel-portal, .lp-color-select-panel, .lp-quick-context-menu, .lp-activity-search-menu");
      if (nestedOpen) return; // laisse le menu imbriqué (Projet, Statut…) se fermer en premier
      // Phase de capture + stopPropagation : empêche le gestionnaire générique
      // de Modal de fermer sans respecter la protection "modifications non
      // enregistrées" ci-dessous, propre à la fiche de tâche.
      e.stopPropagation();
      if (!hasChanged) onClose();
    };
    document.addEventListener("keydown", onKeyDown, true);
    return () => document.removeEventListener("keydown", onKeyDown, true);
  }, [hasChanged, onClose, shortcutPrefs]);

  const addItem = () => { if (!newItem.trim()) return; setChecklist((c) => [...c, { id: uid(), text: newItem.trim(), done: false, end, statusId: null, assignee: "" }]); setNewItem(""); };
  const toggleItem = (id) => setChecklist((c) => c.map((i) => (i.id === id ? { ...i, done: !i.done } : i)));
  const removeItem = (id) => setChecklist((c) => c.filter((i) => i.id !== id));
  const updateItemText = (id, text) => setChecklist((c) => c.map((i) => (i.id === id ? { ...i, text } : i)));
  const updateItemDates = (id, patch) => setChecklist((c) => c.map((i) => (i.id === id ? { ...i, ...patch } : i)));

  const onStartChange = (v) => { setStart(v); if (!milestone) setEnd(addDays(v, duration)); };
  const onEndChange = (v) => { setEnd(v); if (!milestone) setDuration(Math.max(0, dayIndex(v) - dayIndex(start))); };
  const onDurationChange = (v) => { const d = Math.max(0, Number(v) || 0); setDuration(d); if (!milestone) setEnd(addDays(start, d)); };

  const submit = () => {
    if (!title.trim()) { setTitleError(true); return; }
    if (!projectId || !statusId) return;
    setTitleError(false);
    // Contrainte fin→début : une tâche ne peut jamais commencer avant que toutes
    // ses dépendances soient terminées. Si c'est le cas (dépendance ajoutée après
    // coup, ou dates changées manuellement), on décale automatiquement la tâche
    // vers l'avant en conservant sa durée, plutôt que de laisser une
    // incohérence — la ligne pointillée de connexion (vue Planning Projets)
    // reliera donc toujours vraiment "fin de la précédente" à "début de la
    // suivante".
    let finalStart = start, finalEnd = milestone ? start : end;
    if (dependsOn.length > 0) {
      const depTasks = dependsOn.map((id) => tasks.find((t) => t.id === id)).filter(Boolean);
      if (depTasks.length > 0) {
        const latestDepEnd = depTasks.reduce((max, t) => (t.end > max ? t.end : max), depTasks[0].end);
        if (dayIndex(finalStart) < dayIndex(latestDepEnd)) {
          const shift = dayIndex(latestDepEnd) - dayIndex(finalStart);
          finalStart = latestDepEnd;
          finalEnd = milestone ? finalStart : addDays(finalEnd, shift);
        }
      }
    }
    const finalStatusId = isGoogleCalendarProjectId(projectId, projects)
      ? googleCalendarComputedStatusId(
          { projectId, start:finalStart, end:finalEnd, statusId },
          projects,
          statuses,
          iso(new Date())
        )
      : statusId;
    onSave({
      id: task.id,
      title: title.trim(),
      projectId,
      secondaryProjectId: secondaryProjectId || null,
      statusId: finalStatusId,
      criticality: criticality || null,
      taskTypeId,
      milestone,
      milestoneIcon: milestoneIcon || null,
      start: finalStart,
      end: finalEnd,
      progress,
      desc,
      assignee: assignee.trim(),
      checklist,
      dependsOn,
      recurrence,
      customFields,
      attachments,
      // Un projet qui n'est plus adossé à un calendrier perd son méta bloc :
      // la période n'est alors plus tenue à jour par l'agenda.
      metaBlock: isCalendarBackedProjectId(projectId, projects) && metaBlock && metaBlock.enabled ? metaBlock : null,
      delayRisks: normalizeTaskDelayRisks(delayRisks),
      source: base.source || null,
      sourceUrl: base.sourceUrl || null,
      sourceMessageId: base.sourceMessageId || null,
      sourceSender: base.sourceSender || null,
    });
  };

  return (
    <Modal title={isNew ? "Nouvelle tâche" : "Modifier la tâche"} onClose={onClose} wide extraWide footer={
      <>
        <div className="lp-task-modal-actions-compact">
          {!isNew && <button className="lp-btn lp-btn-danger" onClick={() => onDelete(task)}><Trash2 size={13} style={{ marginRight: 5, verticalAlign: -2 }} />Supprimer</button>}
          {!isNew && onToggleFavoriteTask && (
            <button
              className={"lp-btn"+(isFavoriteTask ? " lp-task-favorite-active" : "")}
              onClick={() => onToggleFavoriteTask(task.id)}
              title={isFavoriteTask ? "Retirer cette tâche des favoris" : "Ajouter cette tâche aux favoris"}
            >
              <Star size={13} fill={isFavoriteTask ? "currentColor" : "none"} style={{ marginRight:5, verticalAlign:-2 }}/>
              {isFavoriteTask ? "Favori" : "Ajouter aux favoris"}
            </button>
          )}
          {!isNew && onOpenImpactLine && (
            <button className="lp-btn" style={{color:"var(--line-blue)"}} onClick={() => { onOpenImpactLine(task.id); onClose(); }}>
              <GitBranch size={14} style={{marginRight:5,verticalAlign:-2}} />Ligne d’impact
            </button>
          )}
          {!isNew && !isGoogleCalendarTask && onMarkDone && (
            <button className="lp-btn" style={{ color: "var(--success)", borderColor: "var(--success)" }} onClick={() => { onMarkDone(task.id); onClose(); }}>
              <CheckCircle2 size={14} style={{ marginRight: 4, verticalAlign: -2 }} />
              {/termin/i.test(statuses.find((s) => s.id === (statusId || task.statusId))?.name || "") ? "Réouvrir (En cours)" : "Marquer terminé"}
            </button>
          )}
          {!isNew && !isGoogleCalendarTask && onCycleStatus && (
            <button className="lp-btn" style={{ color: "var(--accent)", borderColor: "var(--accent)" }} onClick={() => { onCycleStatus(task.id); onClose(); }} title="Passer au statut suivant (hors Terminé)">
              <RefreshCw size={14} style={{ marginRight: 4, verticalAlign: -2 }} />Changer statut
            </button>
          )}
        </div>
        <div className="lp-task-modal-actions-compact lp-task-modal-actions-primary"><button className="lp-btn" onClick={onClose}>Annuler</button><button className="lp-btn lp-btn-primary" onClick={submit}>Enregistrer</button></div>
      </>
    }>
      {writingMode && (
        <TaskWritingModeOverlay
          title={title}
          project={projects.find((p)=>p.id===projectId)}
          status={statuses.find((st)=>st.id===statusId)}
          assignee={assignee}
          start={start}
          end={milestone ? start : end}
          progress={progress}
          milestone={milestone}
          desc={desc}
          onChangeDesc={setDesc}
          onClose={()=>setWritingMode(false)}
          shortcutPrefs={shortcutPrefs}
        />
      )}
      {(base.source === "gmail" || base.sourceUrl) && (
        <div style={{display:"flex",alignItems:"center",justifyContent:"space-between",gap:12,padding:"9px 11px",marginBottom:12,border:"1px solid var(--border)",borderRadius:"var(--radius)",background:"var(--paper-soft)"}}>
          <div style={{minWidth:0}}>
            <div style={{fontSize:10,fontWeight:800,textTransform:"uppercase",letterSpacing:".06em",color:"var(--text-muted)"}}>Source</div>
            <div style={{fontSize:12.5,fontWeight:650,marginTop:2}}>✉ Gmail{base.sourceSender ? ` · ${base.sourceSender}` : ""}</div>
          </div>
          {base.sourceUrl && (
            <a href={base.sourceUrl} target="_blank" rel="noopener noreferrer" className="lp-btn" style={{textDecoration:"none",whiteSpace:"nowrap"}}>
              <LinkIcon size={13}/> Ouvrir le mail
            </a>
          )}
        </div>
      )}
      <div className="lp-field">
        <label>Titre</label>
        <input
          type="text"
          value={title}
          onChange={(e) => { setTitle(e.target.value); if (titleError && e.target.value.trim()) setTitleError(false); }}
          placeholder="Ex. Revue DOE"
          autoFocus
          style={titleError ? { borderColor: "var(--danger)", boxShadow: "0 0 0 3px color-mix(in srgb, var(--danger) 14%, transparent)" } : undefined}
        />
        {titleError && <p style={{ fontSize: 11.5, color: "var(--danger)", margin: "5px 0 0", fontWeight: 600 }}>Le titre est obligatoire.</p>}
      </div>
      <div className="lp-row3">
        <div className="lp-field"><label>Projet</label>
          <ProjectSelect projects={projects} value={projectId} onChange={setProjectId} />
        </div>
        <div className="lp-field">
          <label>Statut {isGoogleCalendarTask && <span style={{ fontWeight:500, textTransform:"none", color:"var(--text-600)" }}>· automatique Google Calendar</span>}{!isGoogleCalendarTask && restrictedStatus && <span style={{ fontWeight:500, textTransform:"none", color:"var(--text-600)" }}>· automatique pour ce type de tâche</span>}</label>
          {isGoogleCalendarTask ? (() => {
            const st = statuses.find((s) => s.id === computedGoogleStatusId);
            return (
              <div
                className="lp-chip"
                title="Calculé automatiquement à partir des dates de début et de fin"
                style={{
                  minHeight:34,
                  display:"flex",
                  alignItems:"center",
                  gap:7,
                  width:"100%",
                  boxSizing:"border-box",
                  background:(st?.color || "var(--text-muted)") + "12",
                  color:st?.color || "var(--text-muted)",
                  border:"1px solid " + ((st?.color || "#64748B") + "30"),
                  cursor:"default"
                }}
              >
                <Lock size={12} /> {st?.name || "Statut automatique"}
              </div>
            );
          })() : (
            <StatusSelect
              statuses={availableStatuses}
              value={statusId}
              onChange={setStatusId}
              disabled={!!restrictedStatus}
              disabledTitle="Statut automatique — imposé par le type de tâche"
            />
          )}
        </div>
        <div className="lp-field">
          <label>Type</label>
          <TaskTypeSelect taskTypes={availableTaskTypes} value={taskTypeId} onChange={setTaskTypeId} />
        </div>
      </div>
      <div className="lp-field">
        <label>Criticité <span style={{ fontWeight: 400, textTransform: "none", color: "var(--text-600)" }}>(facultatif — à quel point la tâche presse, indépendamment de son avancement)</span></label>
        <select value={criticality} onChange={(e) => setCriticality(e.target.value)}>
          <option value="">Non définie</option>
          {CRITICALITIES.map((c) => <option key={c.id} value={c.id}>{c.name}</option>)}
        </select>
      </div>
      <div className="lp-field">
        <label>Second projet <span style={{ fontWeight: 400, textTransform: "none", color: "var(--text-600)" }}>(facultatif — la tâche apparaît sur les deux lignes en vue Métro, reliées par un tronc commun)</span></label>
        <ProjectSelect
          projects={projects.filter((p) => p.id !== projectId)}
          value={secondaryProjectId}
          onChange={setSecondaryProjectId}
          emptyLabel="Aucun"
        />
      </div>
      <div className="lp-row2">
        <div className="lp-field"><label>Responsable</label><AssigneeSelect members={teamMembers} value={assignee} onChange={setAssignee} /></div>
      </div>
      <div className="lp-checkbox-row"><input type="checkbox" id="ms" checked={milestone} onChange={(e) => setMilestone(e.target.checked)} /><label htmlFor="ms" style={{ margin: 0, textTransform: "none", fontWeight: 500, fontSize: 13 }}>Il s'agit d'un jalon (date unique)</label></div>
      <div className="lp-checkbox-row">
        <input type="checkbox" id="noDate" checked={!start} onChange={(e) => { if (e.target.checked) { setStart(""); setEnd(""); } else { setStart(iso(new Date())); setEnd(addDays(iso(new Date()), 5)); } }} />
        <label htmlFor="noDate" style={{ margin: 0, textTransform: "none", fontWeight: 500, fontSize: 13 }}>Aucune date (n'apparaîtra pas dans le Gantt, la Timeline, le Radar ni la Heat map)</label>
      </div>
      {start && (
        <div className="lp-row2">
          <div className="lp-field"><label>{milestone ? "Date" : "Début"} {dependsOn.length > 0 && <span className="lp-auto-start-badge" title="Calculée automatiquement d'après la fin des tâches dont celle-ci dépend"><RefreshCw size={9} /> auto</span>}</label><input type="date" value={start} onChange={(e) => onStartChange(e.target.value)} /></div>
          {!milestone && <div className="lp-field"><label>Fin</label><input type="date" value={end} min={start} onChange={(e) => onEndChange(e.target.value)} /></div>}
          <div className="lp-field" style={{ flex: "0 0 auto" }}>
            <label>Icône {milestone ? "du jalon" : ""} <span style={{ fontWeight: 400, textTransform: "none", color: "var(--text-600)" }} title={`Facultatif — écrase l'icône du projet pour ${milestone ? "ce jalon précis" : "cette tâche précise"}`}>ⓘ</span></label>
            <IconEditor icon={milestoneIcon} setIcon={setMilestoneIcon} />
          </div>
        </div>
      )}
      {!start && (
        <div className="lp-field" style={{ maxWidth: 160 }}>
          <label>Icône <span style={{ fontWeight: 400, textTransform: "none", color: "var(--text-600)" }} title="Facultatif — écrase l'icône du projet pour cette tâche précise">ⓘ</span></label>
          <IconEditor icon={milestoneIcon} setIcon={setMilestoneIcon} />
        </div>
      )}
      {start && !milestone && <div className="lp-field"><label>Durée (jours)</label><input type="number" min="0" value={duration} onChange={(e) => onDurationChange(e.target.value)} style={{ maxWidth: 120 }} /></div>}

      {start && (
        <div className="lp-field">
          <div className="lp-checkbox-row">
            <input type="checkbox" id="recur" checked={!!recurrence} onChange={(e) => setRecurrence(e.target.checked ? { unit: "week", interval: 1 } : null)} />
            <label htmlFor="recur" style={{ margin: 0, textTransform: "none", fontWeight: 500, fontSize: 13 }}>Tâche récurrente — une nouvelle occurrence sera créée automatiquement à chaque passage à "Terminé"</label>
          </div>
          {recurrence && (
            <div style={{ display: "flex", alignItems: "center", gap: 6, marginTop: 6, marginLeft: 26 }}>
              <span style={{ fontSize: 12.5, color: "var(--text-600)" }}>Tous les</span>
              <input type="number" min="1" value={recurrence.interval} onChange={(e) => setRecurrence((r) => ({ ...r, interval: Math.max(1, Number(e.target.value) || 1) }))} style={{ width: 56, padding: "4px 6px", border: "1px solid var(--border)", borderRadius: 6 }} />
              <select value={recurrence.unit} onChange={(e) => setRecurrence((r) => ({ ...r, unit: e.target.value }))} style={{ padding: "4px 6px", border: "1px solid var(--border)", borderRadius: 6 }}>
                <option value="day">jour(s)</option>
                <option value="week">semaine(s)</option>
                <option value="month">mois</option>
              </select>
            </div>
          )}
        </div>
      )}

      {isCalendarBackedTask && (
        <div className="lp-field">
          <div className="lp-checkbox-row">
            <input
              type="checkbox"
              id="task-meta-block"
              checked={!!metaBlock}
              onChange={(e) => setMetaBlock(e.target.checked
                ? { enabled: true, kind: "phase", color: GANTT_BLOCK_DEFAULT_COLOR, borderStyle: "dashed", dashboardIds: null }
                : null)}
            />
            <label htmlFor="task-meta-block" style={{ margin: 0, textTransform: "none", fontWeight: 500, fontSize: 13 }}>
              Méta bloc temporel — dessiner cette période dans les Mini-Gantt (congés, absence, déplacement)
            </label>
          </div>
          {metaBlock && (
            <div style={{ marginTop: 8, marginLeft: 26, display: "flex", flexDirection: "column", gap: 10 }}>
              <p className="lp-gantt-annot-hint" style={{ margin: 0 }}>
                Titre et dates suivent la tâche : {(title || "").trim() || "sans titre"} · {start ? fmtShort(start) : "—"} → {milestone ? (start ? fmtShort(start) : "—") : (end ? fmtShort(end) : "—")}.
                Déplacer l'événement dans l'agenda déplace le bloc.
              </p>
              <div className="lp-field">
                <label>Tableaux de bord concernés</label>
                <DropdownButton label={metaScopeLabel()} icon={<LayoutDashboard size={13} />} title="Choisir les tableaux de bord">
                  {(dashboards || []).length === 0 && <div className="lp-dropdown-group-label">Aucun tableau de bord</div>}
                  {(dashboards || []).map((d) => (
                    <label className="lp-checkbox-line" key={d.id}>
                      <input type="checkbox" checked={metaCheckedIds.includes(d.id)} onChange={() => toggleMetaDashboard(d.id)} /> {d.name}
                    </label>
                  ))}
                </DropdownButton>
                <p className="lp-gantt-annot-hint">
                  {!Array.isArray(metaBlock.dashboardIds)
                    ? "Tous cochés : les tableaux de bord créés plus tard recevront aussi ce bloc."
                    : "Sélection explicite : un tableau de bord créé plus tard ne recevra pas ce bloc."}
                </p>
              </div>
              <div className="lp-field">
                <label>Nature</label>
                <div className="lp-density-row">
                  <button type="button" className={"lp-density-btn" + (metaBlock.kind !== "decision" ? " active" : "")} onClick={() => patchMetaBlock({ kind: "phase" })}>Phase</button>
                  <button type="button" className={"lp-density-btn" + (metaBlock.kind === "decision" ? " active" : "")} onClick={() => patchMetaBlock({ kind: "decision", color: metaBlock.color || GANTT_DECISION_DEFAULT_COLOR })}>Fenêtre de décision</button>
                </div>
              </div>
              <div className="lp-field">
                <label>Bordure</label>
                <div className="lp-density-row">
                  <button type="button" className={"lp-density-btn" + (metaBlock.borderStyle !== "solid" ? " active" : "")} onClick={() => patchMetaBlock({ borderStyle: "dashed" })}>Pointillés</button>
                  <button type="button" className={"lp-density-btn" + (metaBlock.borderStyle === "solid" ? " active" : "")} onClick={() => patchMetaBlock({ borderStyle: "solid" })}>Continue</button>
                </div>
              </div>
              <div className="lp-field">
                <label>Couleur</label>
                <ColorPicker value={metaBlock.color || GANTT_BLOCK_DEFAULT_COLOR} onChange={(color) => patchMetaBlock({ color })} />
              </div>
            </div>
          )}
        </div>
      )}

      <div className="lp-field">
        <label>Risques de délai <span style={{ fontWeight: 400, textTransform: "none", color: "var(--text-600)" }}>(couloirs dessinés à la suite de la barre, dans tous les Mini-Gantt qui affichent cette tâche)</span></label>
        {delayRisks.length === 0 && (
          <p className="lp-gantt-annot-hint" style={{ marginTop: 0 }}>
            Aucun risque. Un risque n'avance pas la tâche : il matérialise le délai qu'elle prendrait si le risque se réalisait.
          </p>
        )}
        <div style={{ display: "flex", flexDirection: "column", gap: 6 }}>
          {delayRisks.map((r) => {
            const editing = editingRiskId === r.id;
            return (
              <div className={"lp-gantt-annot-item" + (editing ? " editing" : "")} key={r.id}>
                <div className="lp-gantt-annot-head" onClick={() => setEditingRiskId(editing ? null : r.id)}>
                  <span className="lp-gantt-annot-swatch" style={{ background: "transparent", borderColor: r.color || MINIGANTT_RISK_DEFAULT_COLOR, borderStyle: r.style === "solid" ? "solid" : "dashed" }} />
                  <span className="lp-gantt-annot-summary">
                    <strong>{r.title || "Sans titre"}</strong>
                    <span>{MINIGANTT_RISK_SEVERITY_LABELS[r.severity || "medium"]}</span>
                  </span>
                  <span className="lp-gantt-annot-actions" onClick={(e) => e.stopPropagation()}>
                    <button type="button" className="lp-icon-btn" onClick={() => moveDelayRisk(r.id, -1)} disabled={delayRisks[0]?.id === r.id} title="Monter"><ChevronUp size={12} /></button>
                    <button type="button" className="lp-icon-btn" onClick={() => moveDelayRisk(r.id, 1)} disabled={delayRisks[delayRisks.length - 1]?.id === r.id} title="Descendre"><ChevronDown size={12} /></button>
                    <button type="button" className="lp-icon-btn" onClick={() => setDelayRisks((prev) => prev.filter((x) => x.id !== r.id))} title="Supprimer"><Trash2 size={12} /></button>
                  </span>
                </div>
                {editing && (
                  <div className="lp-gantt-annot-form">
                    <div className="lp-field">
                      <label>Titre</label>
                      <input type="text" value={r.title || ""} onChange={(e) => patchDelayRisk(r.id, { title: e.target.value })} placeholder="Risque fournisseur — impact potentiel +10 j" />
                    </div>
                    <div className="lp-field">
                      <label>Gravité</label>
                      <div className="lp-density-row">
                        {MINIGANTT_RISK_SEVERITIES.map((sev) => (
                          <button key={sev} type="button" className={"lp-density-btn" + ((r.severity || "medium") === sev ? " active" : "")} onClick={() => patchDelayRisk(r.id, { severity: sev })}>
                            {MINIGANTT_RISK_SEVERITY_LABELS[sev]}
                          </button>
                        ))}
                      </div>
                    </div>
                    <div className="lp-field">
                      <label>Style</label>
                      <div className="lp-density-row">
                        {MINIGANTT_RISK_STYLES.map((st) => (
                          <button key={st} type="button" className={"lp-density-btn" + ((r.style || "hatched") === st ? " active" : "")} onClick={() => patchDelayRisk(r.id, { style: st })}>
                            {st === "solid" ? "Plein" : st === "dashed" ? "Pointillés" : "Hachuré"}
                          </button>
                        ))}
                      </div>
                    </div>
                    <div className="lp-row2">
                      <div className="lp-field">
                        <label>Début (j après la tâche)</label>
                        <input type="number" value={r.startOffset ?? ""} placeholder="à la suite" onChange={(e) => patchDelayRisk(r.id, { startOffset: e.target.value === "" ? null : Number(e.target.value) })} />
                      </div>
                      <div className="lp-field">
                        <label>Fin (j après la tâche)</label>
                        <input type="number" value={r.endOffset ?? ""} placeholder="selon la gravité" onChange={(e) => patchDelayRisk(r.id, { endOffset: e.target.value === "" ? null : Number(e.target.value) })} />
                      </div>
                    </div>
                    <p className="lp-gantt-annot-hint" style={{ marginTop: 0 }}>
                      Laissés vides, le risque commence là où le précédent s'arrête et dure {MINIGANTT_RISK_DEFAULT_DAYS[r.severity || "medium"]} jours.
                    </p>
                    <div className="lp-field">
                      <label>Couleur</label>
                      <ColorPicker value={r.color || MINIGANTT_RISK_DEFAULT_COLOR} onChange={(color) => patchDelayRisk(r.id, { color })} />
                    </div>
                  </div>
                )}
              </div>
            );
          })}
        </div>
        <button type="button" className="lp-btn" style={{ marginTop: 8 }} onClick={addDelayRisk}>
          <Plus size={13} style={{ marginRight: 4, verticalAlign: -2 }} />Ajouter un risque de délai
        </button>
      </div>

      {otherTasks.length > 0 && (
        <div className="lp-field">
          <label>Dépend de <span style={{ fontWeight: 400, color: "var(--text-600)", fontSize: 11 }}>(cette tâche ne devrait démarrer qu'après la fin de toutes celles-ci)</span></label>
          <div className="lp-dep-chips">
            {dependencyTasks.map((t) => {
              const proj = projects.find((p) => p.id === t.projectId);
              return (
                <span key={t.id} className="lp-chip lp-dep-chip">
                  {proj && <span className="lp-dep-chip-dot" style={{ background: proj.color || "var(--text-muted)" }} />}
                  {t.title}
                  <button onClick={() => removeDependency(t.id)}><X size={11} /></button>
                </span>
              );
            })}
          </div>
          <div className="lp-dep-search-wrap">
            <input
              type="text"
              placeholder="Rechercher une tâche à ajouter comme dépendance…"
              value={depSearch}
              onChange={(e) => setDepSearch(e.target.value)}
              onFocus={() => setDepSearchOpen(true)}
              onBlur={() => setTimeout(() => setDepSearchOpen(false), 150)}
            />
            {depSearchOpen && depSearchResults.length > 0 && (
              <div className="lp-dep-search-results">
                {depSearchResults.map((t) => {
                  const proj = projects.find((p) => p.id === t.projectId);
                  return (
                    <button key={t.id} type="button" onMouseDown={(e) => { e.preventDefault(); setDependsOn((d) => [...d, t.id]); setDepSearch(""); }}>
                      {proj && <span className="lp-dep-chip-dot" style={{ background: proj.color || "var(--text-muted)" }} />}
                      <span className="lp-dep-search-result-title">{t.title}</span>
                      {proj && <span className="lp-dep-search-result-proj">{proj.name}</span>}
                    </button>
                  );
                })}
              </div>
            )}
          </div>
          {conflictingDeps.length > 0 && (
            <div className="lp-dep-warning">
              <AlertTriangle size={13} /> Conflit : cette tâche commence avant la fin de {conflictingDeps.map((t) => `« ${t.title} »`).join(", ")}.
            </div>
          )}
        </div>
      )}
      <div className="lp-field"><label>Avancement — {progress}%</label><input type="range" min="0" max="100" value={progress} onChange={(e) => setProgress(Number(e.target.value))} className="lp-gradient-slider" style={{ width: "100%", background: sliderGradientBg(progress, gradient, progressColorByStatus ? statuses.find((s) => s.id === statusId)?.color : null) }} /></div>
      <div className="lp-field">
        <div style={{ display: "flex", alignItems: "center", justifyContent: "space-between", marginBottom: 4 }}>
          <label style={{ margin: 0 }}>Description <span style={{ fontWeight: 400, color: "var(--text-600)", fontSize: 11 }}>(Markdown pris en charge)</span></label>
          <div style={{display:"flex",alignItems:"center",gap:6}}>
            <button type="button" className="lp-writing-mode-launch" onClick={()=>setWritingMode(true)} title="Ouvrir une grande zone dédiée à l’écriture">
              <Pencil size={12}/> Mode écriture
            </button>
            <div className="lp-desc-mode-toggle">
              <button type="button" className={descPreview ? "" : "active"} onClick={() => setDescPreview(false)}>Édition</button>
              <button type="button" className={descPreview ? "active" : ""} onClick={() => setDescPreview(true)}>Aperçu</button>
            </div>
          </div>
        </div>
        {!descPreview && (
          <div className="lp-callout-insert-row">
            {Object.entries(CALLOUT_TYPES).map(([key, meta]) => (
              <button
                type="button"
                key={key}
                className="lp-callout-insert-btn"
                style={{ color: meta.color, borderColor: meta.color + "55" }}
                title={`Insérer un callout pliable « ${meta.label} » · structure complète ajoutée automatiquement, il ne reste plus qu'à écrire au milieu · ajoute - après le nom pour le fermer par défaut`}
                onClick={() => {
                  // Balises begin/end : tout ce qui est tapé entre les deux ":::"
                  // appartient au callout, pas besoin de répéter "> " à chaque ligne.
                  insertMarkdownAtCursor({
                    textarea: descRef.current,
                    value: desc,
                    insert: `:::callout-${key} ${meta.label}\n\n:::\n`,
                    onChange: setDesc,
                    cursorOffset: -5, // curseur placé sur la ligne vide, entre l'ouverture et ":::"
                  });
                }}
              >
                {meta.icon} {meta.label}
              </button>
            ))}
            <button
              type="button"
              className="lp-callout-insert-btn"
              style={{ color:"var(--text-700)", borderColor:"var(--border-strong)" }}
              title="Insérer une checklist Markdown"
              onClick={() => {
                insertMarkdownAtCursor({
                  textarea:descRef.current,
                  value:desc,
                  insert:"- [ ] ",
                  onChange:setDesc
                });
              }}
            >
              ☑ Checklist
            </button>
          </div>
        )}
        {descPreview ? (
          <div
            className="lp-desc-preview lp-desc-preview-interactive"
            style={{ minHeight: 320 }}
            onClick={(e) => {
              const input=e.target?.closest?.(".lp-md-task-checkbox[data-md-line]");
              if(!input) return;
              e.preventDefault();
              e.stopPropagation();
              const lineIndex=Number(input.dataset.mdLine);
              setDesc((current)=>toggleMarkdownTaskLine(current,lineIndex,null));
            }}
            dangerouslySetInnerHTML={{ __html: renderMarkdown(desc, true) || '<p style="color:var(--text-600)">Rien à prévisualiser.</p>' }}
          />
        ) : (
          <textarea
            ref={descRef}
            value={desc}
            onChange={(e) => setDesc(e.target.value)}
            onKeyDown={(e) => {
              if (!matchesShortcutCombo(e, shortcutPrefs?.markdownChecklist || "Ctrl+Space")) return;
              e.preventDefault();
              insertMarkdownAtCursor({ textarea:descRef.current, value:desc, insert:"- [ ] ", onChange:setDesc });
            }}
            placeholder="Détails, contacts, liens... (** gras **, * italique *, # titre, - liste, - [ ] tâche, - [x] terminée, boutons ci-dessus pour les callouts :::callout-...:::)"
            rows={14}
            style={{ minHeight: 320 }}
          />
        )}
      </div>

      <div className="lp-field">
        <label>Sous-tâches</label>
        {checklist.map((item) => (
          <div key={item.id} className="lp-subtask-card">
            <div className="lp-subtask-card-top">
              <input type="checkbox" checked={item.done} onChange={() => toggleItem(item.id)} />
              <input
                type="text"
                value={item.text}
                onChange={(e) => updateItemText(item.id, e.target.value)}
                placeholder="Nom de la sous-tâche…"
                className="lp-subtask-title-input"
                style={{ textDecoration: item.done ? "line-through" : "none", color: item.done ? "var(--text-600)" : "var(--text-900)" }}
              />
              <button className="lp-icon-btn" onClick={() => removeItem(item.id)} title="Supprimer cette sous-tâche"><X size={14} /></button>
            </div>
            <div className="lp-subtask-card-meta">
              <InlineChipSelect
                options={[{ value: null, label: "Aucun statut", color: "var(--text-muted)" }, ...availableStatuses.map((s) => ({ value: s.id, label: s.name, color: s.color }))]}
                value={item.statusId}
                onChange={(v) => updateItemDates(item.id, { statusId: v })}
              />
              <input type="text" className="lp-subtask-meta-input" placeholder="Responsable" value={item.assignee || ""} onChange={(e) => updateItemDates(item.id, { assignee: e.target.value })} />
              <input type="date" className="lp-subtask-meta-input lp-subtask-meta-date" value={item.end || item.start || end} onChange={(e) => updateItemDates(item.id, { end: e.target.value })} />
            </div>
          </div>
        ))}
        <div className="lp-subtask-add-row">
          <input type="text" value={newItem} onChange={(e) => setNewItem(e.target.value)} onKeyDown={(e) => e.key === "Enter" && (e.preventDefault(), addItem())} placeholder="Ajouter une sous-tâche…" />
          <button className="lp-btn" onClick={addItem}><Plus size={13} /> Ajouter</button>
        </div>
      </div>

      {(() => {
        // Ne montre que les champs personnalisés du projet actuellement sélectionné
        // pour cette tâche (ou les champs "Tous les projets", pour compatibilité
        // avec ceux créés avant l'introduction du cloisonnement par projet).
        const relevantFields = (customFieldDefs || []).filter((f) => !f.projectId || f.projectId === projectId);
        return relevantFields.length > 0 && (
        <div className="lp-field">
          <label>Champs personnalisés</label>
          <div className="lp-custom-fields-grid">
            {relevantFields.map((f) => (
              <div className="lp-custom-field-item" key={f.id}>
                <label>{f.name}</label>
                {f.type === "text" && <input type="text" value={customFields[f.id] || ""} onChange={(e) => setCustomField(f.id, e.target.value)} />}
                {f.type === "number" && <input type="number" value={customFields[f.id] ?? ""} onChange={(e) => setCustomField(f.id, e.target.value === "" ? "" : Number(e.target.value))} />}
                {f.type === "date" && <input type="date" value={customFields[f.id] || ""} onChange={(e) => setCustomField(f.id, e.target.value)} />}
                {f.type === "select" && (
                  <select value={customFields[f.id] || ""} onChange={(e) => setCustomField(f.id, e.target.value)}>
                    <option value="">—</option>
                    {(f.options || []).map((o) => <option key={o} value={o}>{o}</option>)}
                  </select>
                )}
                {f.type === "checkbox" && (
                  <label className="lp-checkbox-line"><input type="checkbox" checked={!!customFields[f.id]} onChange={(e) => setCustomField(f.id, e.target.checked)} /> {customFields[f.id] ? "Oui" : "Non"}</label>
                )}
              </div>
            ))}
          </div>
        </div>
        );
      })()}

      <div className="lp-field lp-drive-panel">
        <div className="lp-drive-panel-head">
          <div className="lp-drive-panel-title"><Folder size={15} color="#4285F4" /> Google Drive</div>
          <span className="lp-drive-badge">{getGoogleDriveAttachments({ attachments }).length} lien{getGoogleDriveAttachments({ attachments }).length > 1 ? "s" : ""}</span>
        </div>
        {getGoogleDriveAttachments({ attachments }).length > 0 && (
          <div className="lp-attachments-list">
            {getGoogleDriveAttachments({ attachments }).map((a) => (
              <a key={a.id} className="lp-attachment-item" href={a.url} target="_blank" rel="noopener noreferrer">
                <Folder size={13} color="#4285F4" />
                <span className="lp-attachment-name">{a.name || (googleDriveKind(a.url) === "folder" ? "Dossier Google Drive" : "Fichier Google Drive")}</span>
                <span className="lp-attachment-size">{googleDriveKind(a.url) === "folder" ? "Dossier" : "Fichier"}</span>
                <button type="button" className="lp-icon-btn" onClick={(e) => { e.preventDefault(); e.stopPropagation(); removeAttachment(a.id); }} title="Retirer"><X size={12} /></button>
              </a>
            ))}
          </div>
        )}
        <div className="lp-attachment-add-row">
          <input type="text" placeholder="Nom (facultatif)" value={driveName} onChange={(e) => setDriveName(e.target.value)} className="lp-attachment-name-input" />
          <input type="url" placeholder="Coller le lien d’un fichier ou dossier Google Drive" value={driveUrl} onChange={(e) => { setDriveUrl(e.target.value); if (driveError) setDriveError(""); }} onKeyDown={(e) => e.key === "Enter" && (e.preventDefault(), addGoogleDriveAttachment())} />
          <button type="button" className="lp-btn" onClick={addGoogleDriveAttachment}><LinkIcon size={12} /> Rattacher</button>
        </div>
        {driveError && <p style={{ fontSize: 11.5, color: "var(--danger)", margin: "6px 0 0" }}>{driveError}</p>}
        <p style={{ fontSize: 11, color: "var(--text-600)", margin: "6px 0 0" }}>Le fichier reste dans Drive ; Nexora conserve uniquement son URL dans la tâche.</p>
      </div>

      <div className="lp-field">
        <label>Autres pièces jointes</label>
        {attachments.some((a) => !isGoogleDriveAttachment(a)) && (
          <div className="lp-attachments-list">
            {attachments.filter((a) => !isGoogleDriveAttachment(a)).map((a) => (
              <a key={a.id} className="lp-attachment-item" href={a.url} target="_blank" rel="noreferrer" download={a.type === "file" ? a.name : undefined}>
                {a.type === "link" ? <LinkIcon size={13} /> : <Paperclip size={13} />}
                <span className="lp-attachment-name">{a.name}</span>
                {a.type === "file" && a.size && <span className="lp-attachment-size">{Math.round(a.size / 1024)} Ko</span>}
                <button type="button" className="lp-icon-btn" onClick={(e) => { e.preventDefault(); e.stopPropagation(); removeAttachment(a.id); }} title="Retirer"><X size={12} /></button>
              </a>
            ))}
          </div>
        )}
        <div className="lp-attachment-add-row">
          <input type="text" placeholder="Nom (facultatif)" value={linkName} onChange={(e) => setLinkName(e.target.value)} className="lp-attachment-name-input" />
          <input type="text" placeholder="Coller un lien (Drive, plan en ligne, PV...)" value={linkUrl} onChange={(e) => setLinkUrl(e.target.value)} onKeyDown={(e) => e.key === "Enter" && (e.preventDefault(), addLinkAttachment())} />
          <button type="button" className="lp-btn" onClick={addLinkAttachment}><LinkIcon size={12} /> Ajouter</button>
        </div>
        <div className="lp-attachment-add-row" style={{ marginTop: 6 }}>
          <label className="lp-btn lp-attachment-file-btn">
            <Paperclip size={12} /> Joindre un petit fichier (image, PDF léger…)
            <input type="file" style={{ display: "none" }} onChange={onFileAttach} />
          </label>
        </div>
        {attachError && <p style={{ fontSize: 11.5, color: "var(--danger)", marginTop: 6, marginBottom: 0 }}>{attachError}</p>}
        <p style={{ fontSize: 11, color: "var(--text-600)", marginTop: 6, marginBottom: 0 }}>Les fichiers joints directement sont limités à {Math.round(MAX_ATTACHMENT_BYTES / 1024)} Ko (stockés dans la fiche elle-même) — pour les plans et gros documents, préfère un lien externe.</p>
      </div>
    </Modal>
  );
}

// ============================================================================
// Gestion des projets (édition + upload d'icône)
// ============================================================================
// Sélecteur d'icône compact : affiche seulement l'icône actuelle dans un petit
// bouton — la grille d'émojis (90 choix), l'import d'image et le collage d'URL
// n'apparaissent que dans une fenêtre contextuelle au clic, plutôt que de
// toujours occuper une grande zone dans le formulaire (Réglages projet, fiche
// tâche, jalons, etc. — ce composant est partagé partout dans l'app).
function IconEditor({ icon, setIcon }) {
  const [open, setOpen] = useState(false);
  const nexoraAccent = (() => {
    try {
      const app = document.querySelector('.lp-app');
      return (app ? getComputedStyle(app).getPropertyValue('--accent') : '').trim() || '#FF7A3D';
    } catch (e) { return '#FF7A3D'; }
  })();
  const [search, setSearch] = useState("");
  const [page, setPage] = useState(0);
  const [draftIcon, setDraftIcon] = useState(icon || null);
  const [color, setColor] = useState(parseTablerIconSpec(icon).color || parseIconifySpec(icon).color || "#0B1526");
  const [customUrl, setCustomUrl] = useState(/^(https?:|data:)/.test(icon || "") ? icon : "");
  const isImageUrl = (u) => /^(https?:\/\/|data:image\/)/i.test((u || "").trim());
  const [items, setItems] = useState([]);
  const [loading, setLoading] = useState(false);
  const [styleFilter, setStyleFilter] = useState("all");
  const btnRef = useRef(null);
  const panelRef = useRef(null);
  const PAGE_SIZE = 400;
  const searchTimer = useRef(null);

  const getIconPrefix = (spec) => {
    if (!spec) return "tabler";
    if (spec.startsWith("tabler:")) return "tabler";
    if (spec.startsWith("iconify:")) return (parseIconifySpec(spec).prefix || "").toLowerCase();
    return "tabler";
  };
  const isMonochromePrefix = (prefix) => {
    if (!prefix) return true;
    const known = ["tabler","ph","phosphor","material-symbols","material-symbols-rounded","material-symbols-sharp","material-symbols-outlined","material-symbols-rounded","simple-icons","lucide","heroicons","feather","carbon","mingcute","ri","solar","hugeicons"];
    return known.includes(prefix);
  };
  const isColorPrefix = (prefix) => {
    if (!prefix) return false;
    const p = String(prefix).toLowerCase();
    const colorPrefixes = [
      "fluent-emoji", "fluent-emoji-flat", "fluent-color", "noto", "noto-emoji",
      "twemoji", "openmoji", "emojione", "emojione-v2", "streamline-color",
      "streamline-emojis", "streamline-flex-color", "icon-park", "icon-park-outline",
      "flat-color-icons", "fxemoji", "pixelarticons-color", "duo-icons", "solar-color",
      "phosphor-fill", "phosphor-duotone", "material-symbols-color", "material-symbols-rounded-color",
      "material-symbols-sharp-color", "material-symbols-outlined-color"
    ];
    return colorPrefixes.some(x => p === x || p.startsWith(x + "-"));
  };
  // Une icône est classée « monochrome » uniquement si son jeu d'icônes est
  // explicitement conçu pour être recolorable par currentColor.
  // On reste volontairement conservateur : les collections dont certaines
  // icônes embarquent des couleurs/gradients sont exclues du filtre.
  const isRecolorablePrefix = (prefix) => {
    const p = String(prefix || "").toLowerCase();
    const safe = new Set([
      "tabler", "lucide", "feather", "heroicons", "heroicons-outline",
      "carbon", "mingcute", "ri", "hugeicons", "prime", "bi",
      "bootstrap-icons", "octicon", "octicons", "akar-icons", "radix-icons",
      "typcn", "eva", "majesticons", "uil", "uiw", "clarity", "vaadin",
      "zondicons", "grommet-icons", "simple-icons", "phosphor", "ph"
    ]);
    if (safe.has(p)) return true;
    // Material Symbols reste recolorable, y compris ses variantes de style.
    if (p === "material-symbols" || p.startsWith("material-symbols-")) return true;
    return false;
  };
  const matchesStyleFilter = (item) => {
    if (styleFilter === "all") return true;
    if (styleFilter === "color") return isColorPrefix(item.prefix);
    return isRecolorablePrefix(item.prefix);
  };
  const selectedTabler = parseTablerIconSpec(draftIcon);
  const selectedIconify = parseIconifySpec(draftIcon);
  const selectedPrefix = getIconPrefix(draftIcon);
  const canRecolor = isRecolorablePrefix(selectedPrefix);
  const selectedName = draftIcon?.startsWith("iconify:") ? selectedIconify.name : selectedTabler.name;

  const normalizeResult = (full) => {
    const str = String(full || "");
    if (!str.includes(":")) return null;
    const idx = str.indexOf(":");
    const prefix = str.slice(0, idx);
    const name = str.slice(idx + 1);
    if (!prefix || !name) return null;
    return { full: str, prefix, name, label: humanizeIconifyName(name.replace(/[-_]/g, "-")) };
  };

  const searchEverywhere = async (query) => {
    const q = normalizeIconSearch(query.trim());
    if (!q) {
      // Sans recherche, on présente la sélection Tabler locale (rapide et complète côté Nexora).
      const base = NEXORA_ICON_CATALOG.map(([name,label,cat]) => ({ full:`tabler:${name}`, prefix:"tabler", name, label, cat }));
      setItems(base.filter(matchesStyleFilter));
      setLoading(false);
      return;
    }
    setLoading(true);
    try {
      const words = q.split(/\s+/).filter(Boolean);
      const expanded = [];
      words.forEach(word => {
        expanded.push(word);
        const aliases = NEXORA_FR_SYNONYMS[word] || NEXORA_ICONIFY_SEARCH_ALIASES[word] || "";
        aliases.split(/\s+/).filter(Boolean).forEach(x => expanded.push(x));
      });
      const uniqueWords = Array.from(new Set(expanded)).slice(0, 16);
      const responses = await Promise.all(uniqueWords.map(async word => {
        try {
          const res = await fetch(`${NEXORA_ICONIFY_API}/search?query=${encodeURIComponent(word)}&limit=999`);
          if (!res.ok) return [];
          const data = await res.json();
          return data.icons || [];
        } catch { return []; }
      }));
      const map = new Map();
      responses.flat().forEach(full => {
        const item = normalizeResult(full);
        if (item && !map.has(item.full)) map.set(item.full, item);
      });
      // Garantit aussi les résultats Tabler locaux, y compris les alias français spécifiques à Nexora.
      const local = NEXORA_ICON_CATALOG.filter(([name,label,cat]) => {
        const hay = iconSearchText(name,label,cat);
        return words.every(word => {
          const expandedWord = normalizeIconSearch([word, NEXORA_FR_SYNONYMS[word] || "", NEXORA_ICONIFY_SEARCH_ALIASES[word] || ""].join(" "));
          return expandedWord.split(/\s+/).filter(Boolean).some(token => hay.includes(token));
        });
      });
      local.forEach(([name,label,cat]) => map.set(`tabler:${name}`, {full:`tabler:${name}`,prefix:"tabler",name,label,cat}));
      const sorted = Array.from(map.values()).sort((a,b) => {
        const aq = normalizeIconSearch(a.name + " " + a.label), bq = normalizeIconSearch(b.name + " " + b.label);
        const exactA = aq.includes(q) ? 0 : 1, exactB = bq.includes(q) ? 0 : 1;
        return exactA - exactB || a.label.localeCompare(b.label,"fr");
      });
      setItems(sorted.filter(matchesStyleFilter));
      setPage(0);
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    if (!open) return;
    setDraftIcon(icon || null);
    const p = icon?.startsWith("iconify:") ? parseIconifySpec(icon) : parseTablerIconSpec(icon);
    setColor(p.color || "#0B1526");
    setCustomUrl(isImageUrl(icon) ? icon : "");
    searchEverywhere(search);
  }, [open]);

  useEffect(() => {
    if (!open) return;
    setPage(0);
    clearTimeout(searchTimer.current);
    searchTimer.current = setTimeout(() => searchEverywhere(search), 180);
    return () => clearTimeout(searchTimer.current);
  }, [search, open, styleFilter]);

  useEffect(() => {
    if (!open) return undefined;
    const onKey = (e) => {
      if (e.key === "Escape") setOpen(false);
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === "k") { e.preventDefault(); document.querySelector(".nexora-icon-editor-search")?.focus(); }
    };
    document.addEventListener("keydown", onKey);
    return () => document.removeEventListener("keydown", onKey);
  }, [open]);

  useEffect(() => {
    if (!open) return undefined;
    const html = document.documentElement, body = document.body;
    const prevH = html.style.overflow, prevB = body.style.overflow;
    html.style.overflow = "hidden"; body.style.overflow = "hidden";
    return () => { html.style.overflow = prevH; body.style.overflow = prevB; };
  }, [open]);

  const toggle = () => {
    if (!open) {
      setDraftIcon(icon || null);
      const p = icon?.startsWith("iconify:") ? parseIconifySpec(icon) : parseTablerIconSpec(icon);
      setColor(p.color || "#0B1526");
    }
    setOpen(o => !o);
  };

  const applyColor = (nextColor) => {
    if (!canRecolor) return;
    setColor(nextColor);
    if (!draftIcon) return;
    if (draftIcon.startsWith("iconify:")) {
      const p = parseIconifySpec(draftIcon);
      setDraftIcon(iconifySpec(p.prefix, p.name, nextColor));
    } else if (selectedTabler.name) setDraftIcon(makeTablerIconSpec(selectedTabler.name, nextColor));
  };

  const chooseItem = (item) => {
    if (item.prefix === "tabler") setDraftIcon(makeTablerIconSpec(item.name, color));
    else setDraftIcon(iconifySpec(item.prefix, item.name, isRecolorablePrefix(item.prefix) ? color : ""));
  };
  const saveIcon = () => { setIcon(draftIcon || null); setOpen(false); };
  const pageCount = Math.max(1, Math.ceil(items.length / PAGE_SIZE));
  const safePage = Math.min(page, pageCount - 1);
  const pageItems = items.slice(safePage * PAGE_SIZE, safePage * PAGE_SIZE + PAGE_SIZE);
  const visiblePages = Array.from({ length: pageCount }, (_, i) => i).filter(i => pageCount <= 9 || i < 2 || i >= pageCount - 2 || Math.abs(i - safePage) <= 1);

  return (
    <div className="lp-icon-editor" ref={btnRef}>
      <button type="button" className="lp-icon-editor-trigger" onClick={toggle} title="Choisir une icône">
        <span className="lp-icon-preview" style={{ margin: 0 }}>{icon ? <IconGlyph icon={icon} size={20} /> : <NexoraIcon name="sparkles" size={15} style={{ color: "var(--text-muted)" }} />}</span>
        <ChevronDown size={12} />
      </button>
      {open && createPortal(
        <>
          <div className="nexora-icon-editor-backdrop" onMouseDown={() => setOpen(false)} />
          <div className="lp-dropdown-panel lp-dropdown-panel-portal lp-icon-editor-panel nexora-icon-editor-panel-v16" ref={panelRef} style={{"--nexora-icon-accent":nexoraAccent}} >
            <div className="nexora-icon-editor-shell">
              <aside className="nexora-icon-editor-side">
                <div className="nexora-icon-selected-preview"><IconGlyph icon={draftIcon || "tabler:sparkles"} size={64} /></div>
                <div className="lp-field">
                  <div style={{display:"flex",gap:7,alignItems:"center",opacity:canRecolor?1:.55}}>
                    <input type="color" value={color} disabled={!canRecolor} onChange={e=>applyColor(e.target.value)} style={{width:42,height:36,padding:2}} />
                    <input type="text" value={color} disabled={!canRecolor} onChange={e=>/^#[0-9a-fA-F]{6}$/.test(e.target.value)&&applyColor(e.target.value)} style={{flex:1}} />
                  </div>
                  <div className="nexora-icon-swatches" style={{opacity:canRecolor?1:.45,pointerEvents:canRecolor?"auto":"none"}}>{["#0B1526","#4F6AF5","#22B07D","#F2A93B","#D64545","#7C5CFF","#0EA5E9","#64748B"].map(c=><button key={c} type="button" className={"nexora-icon-swatch"+(color.toLowerCase()===c.toLowerCase()?" active":"")} style={{background:c}} onClick={()=>applyColor(c)} />)}</div>
                  <button type="button" className="lp-btn" disabled={!canRecolor} style={{width:"100%",marginTop:9,opacity:canRecolor?1:.55}} onClick={()=>{ if(draftIcon?.startsWith("tabler:")){setDraftIcon(`tabler:${selectedTabler.name}`);} else if(draftIcon?.startsWith("iconify:")){setDraftIcon(`iconify:${selectedIconify.prefix}/${selectedIconify.name}`);} setColor("#0B1526"); }}>Couleur automatique</button>
                </div>
                {draftIcon && <button type="button" className="lp-btn" style={{width:"100%",marginTop:8}} onClick={()=>setDraftIcon(null)}>Retirer l'icône</button>}
                <div className="lp-field" style={{marginTop:12,paddingTop:12,borderTop:"1px solid var(--border)"}}>
                  <label style={{fontSize:10.5,fontWeight:700,textTransform:"uppercase",letterSpacing:.4,color:"var(--text-600)"}}>Image personnalisée</label>
                  <div style={{display:"flex",gap:6,marginTop:5}}>
                    <input
                      type="text"
                      value={customUrl}
                      onChange={(e)=>setCustomUrl(e.target.value)}
                      onKeyDown={(e)=>{ if(e.key==="Enter" && isImageUrl(customUrl)){ e.preventDefault(); setDraftIcon(customUrl.trim()); } }}
                      placeholder="Coller une URL d'image…"
                      style={{flex:1,minWidth:0,fontSize:12}}
                    />
                    <button type="button" className="lp-icon-btn" disabled={!isImageUrl(customUrl)} title="Utiliser cette image" onClick={()=>setDraftIcon(customUrl.trim())}><Check size={14} /></button>
                  </div>
                </div>
              </aside>

              <section className="nexora-icon-editor-main">
                <div className="nexora-icon-editor-head">
                  <div className="nexora-icon-editor-search-wrap"><Search size={17}/><input autoFocus className="nexora-icon-editor-search" value={search} onChange={e=>setSearch(e.target.value)} placeholder="Rechercher une icône : montagne, école, chantier…" />{search&&<button type="button" className="nexora-icon-search-clear" onClick={()=>setSearch("")}>×</button>}</div>
                  <select className="nexora-icon-style-filter" value={styleFilter} onChange={e=>setStyleFilter(e.target.value)} aria-label="Filtrer les icônes">
                    <option value="all">Toutes</option>
                    <option value="mono">Monochromes</option>
                    <option value="color">Couleurs</option>
                  </select>
                  <span className="nexora-icon-editor-count">{loading ? "Recherche…" : `${items.length.toLocaleString("fr-FR")} résultat${items.length>1?"s":""}`}</span>
                  <button type="button" className="lp-icon-btn" title="Fermer" onClick={()=>setOpen(false)}>×</button>
                </div>

                <div className="nexora-icon-editor-grid">
                  {loading ? <div className="lp-select-empty" style={{gridColumn:"1/-1",padding:50}}>Recherche dans toutes les bibliothèques…</div> : pageItems.map(item=>{
                    const isSelected = item.full === draftIcon?.split("|")[0] || (draftIcon?.startsWith("tabler:") && item.full === draftIcon.split("|")[0]);
                    const spec = item.prefix === "tabler" ? makeTablerIconSpec(item.name, isSelected ? color : "") : iconifySpec(item.prefix,item.name,isRecolorablePrefix(item.prefix)&&isSelected?color:"");
                    return <button key={item.full} type="button" aria-label={item.label} className={"nexora-icon-option"+(isSelected?" active":"")} onClick={()=>chooseItem(item)}><IconGlyph icon={spec} size={22} /></button>;
                  })}
                  {!loading && pageItems.length===0 && <div className="lp-select-empty" style={{gridColumn:"1/-1",padding:30}}>Aucune icône trouvée. Essayez un autre terme ou un synonyme français.</div>}
                </div>

                <div className="nexora-icon-pagination">
                  <button type="button" className="nexora-icon-page-btn" disabled={safePage===0} onClick={()=>setPage(p=>Math.max(0,p-1))}>‹</button>
                  {visiblePages.map((i,idx)=>{const prev=visiblePages[idx-1];return <React.Fragment key={i}>{prev!=null&&i-prev>1&&<span style={{color:"var(--text-600)",padding:"0 2px"}}>…</span>}<button type="button" className={"nexora-icon-page-btn"+(i===safePage?" active":"")} onClick={()=>setPage(i)}>{i+1}</button></React.Fragment>})}
                  <button type="button" className="nexora-icon-page-btn" disabled={safePage>=pageCount-1} onClick={()=>setPage(p=>Math.min(pageCount-1,p+1))}>›</button>
                </div>
                <div className="nexora-icon-footer"><div style={{display:"flex",gap:8,marginLeft:"auto"}}><button type="button" className="lp-btn" onClick={()=>{setDraftIcon(icon||null);const p=icon?.startsWith("iconify:")?parseIconifySpec(icon):parseTablerIconSpec(icon);setColor(p.color||"#0B1526");setOpen(false);}}>Annuler</button><button type="button" className="lp-btn lp-btn-primary nexora-icon-save-bottom" style={{background:nexoraAccent,borderColor:nexoraAccent,color:'#fff',minWidth:130,minHeight:36,fontWeight:800,opacity:1,visibility:'visible'}} onClick={saveIcon}>Enregistrer</button></div></div>
              </section>
            </div>
          </div>
        </>, document.body
      )}
    </div>
  );
}


function ProjectNavigationDefaultsEditor({ value, onChange, ctx, inheritedLabel = "" }) {
  const nav = value || {};
  const viewKey = nav.view || "";
  const zoomOptions = projectNavigationZoomOptions(viewKey);
  const filtersEnabled = nav.filters !== undefined && nav.filters !== null;
  const localFilters = filtersEnabled
    ? { ...defaultFilters(), ...nav.filters, advanced:nav.filters?.advanced || defaultFilters().advanced }
    : defaultFilters();

  const update = (patch) => onChange({ ...nav, ...patch });

  return (
    <div style={{marginTop:14,padding:"12px 13px",border:"1px solid var(--border)",borderRadius:"var(--radius)",background:"var(--paper-soft)"}}>
      <div className="lp-section-title" style={{marginBottom:10}}>Ouverture par défaut</div>

      <div className="lp-row2">
        <div className="lp-field">
          <label>Vue par défaut</label>
          <select
            value={viewKey}
            onChange={(e)=>{
              const nextView=e.target.value;
              const allowed=projectNavigationZoomOptions(nextView);
              update({
                view:nextView || null,
                zoom:allowed.some((z)=>z.key===nav.zoom) ? nav.zoom : null
              });
            }}
          >
            <option value="">{inheritedLabel || "Conserver la vue actuelle"}</option>
            {PROJECT_DEFAULT_VIEW_OPTIONS.map((v)=><option key={v.key} value={v.key}>{v.label}</option>)}
          </select>
        </div>

        <div className="lp-field">
          <label>Niveau de zoom</label>
          <select
            value={nav.zoom || ""}
            disabled={!viewKey || zoomOptions.length===0}
            onChange={(e)=>update({zoom:e.target.value || null})}
          >
            <option value="">{viewKey && zoomOptions.length ? "Zoom actuel" : "Non applicable"}</option>
            {zoomOptions.map((z)=><option key={z.key} value={z.key}>{z.label}</option>)}
          </select>
        </div>
      </div>

      <label className="lp-checkbox-row" style={{padding:"7px 0",marginTop:4}}>
        <input
          type="checkbox"
          checked={filtersEnabled}
          onChange={(e)=>update({filters:e.target.checked ? defaultFilters() : undefined})}
        />
        <span style={{textTransform:"none",fontWeight:600}}>Appliquer des filtres par défaut à l’ouverture</span>
      </label>

      {filtersEnabled && (
        <div style={{marginTop:8,paddingTop:10,borderTop:"1px solid var(--border)"}}>
          <div style={{fontSize:10.5,color:"var(--text-muted)",marginBottom:8,lineHeight:1.45}}>
            Le périmètre projet/dossier est imposé automatiquement. Les autres conditions ci-dessous sont appliquées en complément.
          </div>
          <FilterFieldsBody
            local={localFilters}
            setLocal={(updater)=>{
              const next=typeof updater==="function" ? updater(localFilters) : updater;
              update({filters:next});
            }}
            ctx={ctx}
          />
        </div>
      )}
    </div>
  );
}

function ProjectFolderNavigationModal({ folder, folders, setFolders, projects, statuses, taskTypes, tasks, teamMembers, projectFolders, customFieldDefs, onClose }) {
  const current = folders.find((f)=>f.id===folder.id) || folder;
  const [navigationDefaults, setNavigationDefaults] = useState(current.navigationDefaults || {});
  const ctx = { projects, statuses, taskTypes, tasks, teamMembers, projectFolders, customFieldDefs };

  const save = () => {
    setFolders((prev)=>prev.map((f)=>f.id===folder.id ? {...f,navigationDefaults} : f));
    onClose();
  };

  return (
    <Modal title={`Ouverture du dossier — ${folder.name}`} onClose={onClose} wide footer={
      <>
        <button className="lp-btn" onClick={onClose}>Annuler</button>
        <button className="lp-btn lp-btn-primary" onClick={save}>Enregistrer</button>
      </>
    }>
      <div style={{fontSize:12,color:"var(--text-600)",lineHeight:1.5}}>
        Ces réglages s’appliquent lorsque tu ouvres le dossier. Un projet du dossier peut les remplacer par ses propres réglages.
      </div>
      <ProjectNavigationDefaultsEditor
        value={navigationDefaults}
        onChange={setNavigationDefaults}
        ctx={ctx}
        inheritedLabel="Conserver la vue actuelle"
      />
    </Modal>
  );
}

function ProjectManager({ projects, setProjects, projectFolders, setProjectFolders, tasks, statuses, taskTypes, risks, setRisks, teamMembers, customFieldDefs, onDeleteProject, onBulkDelete, palette, onClose, embedded }) {
  const [formTarget, setFormTarget] = useState(null); // null | "new" | projet à modifier
  const [riskTarget, setRiskTarget] = useState(null); // projet dont le registre des risques est ouvert
  const [folderNavTarget, setFolderNavTarget] = useState(null);

  const handleSave = (data) => {
    if (formTarget === "new") setProjects((prev) => [...prev, { id: uid(), ...data }]);
    else setProjects((prev) => prev.map((p) => (p.id === formTarget.id ? { ...p, ...data } : p)));
    setFormTarget(null);
  };

  const body = (
    <>
      <div className="lp-section-title">Projets existants</div>
      {projects.map((p) => {
        const count = tasks.filter((t) => t.projectId === p.id).length;
        return (
          <div className="lp-manage-item" key={p.id}>
            <span className="lp-project-dot" style={{ background: p.color, width: 24, height: 24 }}><IconGlyph icon={p.icon} size={15} /></span>
            <span className="lp-manage-name">{p.name}{p.folderId ? <span style={{ color: "var(--text-600)", fontWeight: 400 }}> · {projectFolders.find((f) => f.id === p.folderId)?.name}</span> : ""} <span style={{ color: "var(--text-600)", fontWeight: 400 }}>({count} tâche{count > 1 ? "s" : ""})</span>
              {p.milestoneIcon && <span className="lp-project-setting-badge lp-project-setting-badge-icon" title="Icône de jalon personnalisée définie"><IconGlyph icon={p.milestoneIcon} size={10} /></span>}
              {p.metroTaskIcons && <span className="lp-project-setting-badge lp-project-setting-badge-icon" title="Icônes de tâches actives en vue Métro"><TrainTrack size={10} /></span>}
              {(p.disabledStatusIds || []).length > 0 && <span className="lp-project-setting-badge" title={`${p.disabledStatusIds.length} statut(s) global(aux) masqué(s)`}>{p.disabledStatusIds.length} masqué{p.disabledStatusIds.length > 1 ? "s" : ""}</span>}
              {statuses.some((st)=>st.projectId===p.id) && <span className="lp-project-setting-badge lp-status-scope-badge" title="Ce projet possède des statuts spécifiques">Spécifiques</span>}
            </span>
            {count > 0 && <button className="lp-icon-btn" onClick={() => onBulkDelete(tasks.filter((t) => t.projectId === p.id).map((t) => t.id), `du projet « ${p.name} »`)} title="Vider ce projet (supprimer toutes ses tâches)"><Eraser size={14} /></button>}
            <button className="lp-icon-btn" onClick={() => setRiskTarget(p)} title="Registre des risques">
              <AlertOctagon size={14} />
              {risks.some((r) => r.projectId === p.id && r.status !== "closed") && <span className="lp-risk-dot-indicator" />}
            </button>
            <button className="lp-icon-btn" onClick={() => setFormTarget(p)}><Pencil size={14} /></button>
            <button className="lp-icon-btn" onClick={() => onDeleteProject(p)}><Trash2 size={15} /></button>
          </div>
        );
      })}
      <hr className="lp-divider" />
      <button className="lp-btn lp-btn-primary" onClick={() => setFormTarget("new")}><Plus size={13} style={{ marginRight: 4, verticalAlign: -2 }} />Nouveau projet</button>
      {projectFolders.length > 0 && (
        <>
          <hr className="lp-divider" />
          <div className="lp-section-title">Ouverture par défaut des dossiers</div>
          <div style={{fontSize:11.5,color:"var(--text-600)",marginBottom:8,lineHeight:1.45}}>
            Configure la vue, le zoom et les filtres utilisés lorsque tu ouvres un dossier.
          </div>
          {projectFolders.map((folder)=>{
            const nav=folder.navigationDefaults || {};
            const viewLabel=PROJECT_DEFAULT_VIEW_OPTIONS.find((v)=>v.key===nav.view)?.label;
            const zoomLabel=projectNavigationZoomOptions(nav.view).find((z)=>z.key===nav.zoom)?.label;
            return (
              <div className="lp-manage-item" key={"nav-folder-"+folder.id}>
                <span className="lp-project-dot" style={{background:folder.color || "var(--text-muted)",width:22,height:22}}>
                  <Folder size={12} color="#fff"/>
                </span>
                <span className="lp-manage-name">
                  {folder.name}
                  <span style={{display:"block",fontSize:10.5,color:"var(--text-muted)",fontWeight:400,marginTop:2}}>
                    {viewLabel || "Vue actuelle"}{zoomLabel ? ` · ${zoomLabel}` : ""}{nav.filters ? " · filtres personnalisés" : ""}
                  </span>
                </span>
                <button className="lp-icon-btn" onClick={()=>setFolderNavTarget(folder)} title="Configurer l’ouverture"><Settings size={14}/></button>
              </div>
            );
          })}
        </>
      )}
      {formTarget && (
        <ProjectFormModal
          project={formTarget === "new" ? null : formTarget}
          projects={projects}
          projectFolders={projectFolders}
          statuses={statuses}
          taskTypes={taskTypes}
          tasks={tasks}
          teamMembers={teamMembers}
          customFieldDefs={customFieldDefs}
          inheritedFolder={formTarget === "new" ? null : projectFolders.find((f)=>f.id===formTarget.folderId)}
          defaultColor={palette[projects.length % palette.length]}
          onSave={handleSave}
          onClose={() => setFormTarget(null)}
        />
      )}
    </>
  );

  return (
    <>
      {embedded ? <div className="lp-settings-pane">{body}</div> : <Modal title="Gérer les projets" onClose={onClose} wide>{body}</Modal>}
      {riskTarget && (
        <RiskRegisterModal project={riskTarget} risks={risks} setRisks={setRisks} teamMembers={teamMembers} onClose={() => setRiskTarget(null)} />
      )}
      {folderNavTarget && (
        <ProjectFolderNavigationModal
          folder={folderNavTarget}
          folders={projectFolders}
          setFolders={setProjectFolders}
          projects={projects}
          statuses={statuses}
          taskTypes={taskTypes}
          tasks={tasks}
          teamMembers={teamMembers}
          projectFolders={projectFolders}
          customFieldDefs={customFieldDefs}
          onClose={()=>setFolderNavTarget(null)}
        />
      )}
    </>
  );
}

// Registre des risques d'UN projet — liste triée par score décroissant (les
// risques les plus critiques toujours en tête), avec sélecteur probabilité ×
// impact façon petite grille cliquable plutôt qu'un simple menu déroulant,
// pour visualiser le niveau pendant la saisie elle-même.
function RiskRegisterModal({ project, risks, setRisks, teamMembers, onClose }) {
  const [formTarget, setFormTarget] = useState(null); // null | "new" | risque à modifier
  const [statusFilter, setStatusFilter] = useState("open"); // "open" = actif + sous contrôle (masque les clos par défaut)

  const projectRisks = useMemo(() => risks.filter((r) => r.projectId === project.id), [risks, project.id]);
  const visibleRisks = useMemo(() => {
    const filtered = statusFilter === "all" ? projectRisks : statusFilter === "open" ? projectRisks.filter((r) => r.status !== "closed") : projectRisks.filter((r) => r.status === statusFilter);
    return [...filtered].sort((a, b) => riskScoreOf(b) - riskScoreOf(a));
  }, [projectRisks, statusFilter]);

  const handleSave = (data) => {
    if (formTarget === "new") setRisks((prev) => [...prev, { id: uid(), projectId: project.id, createdAt: iso(new Date()), ...data }]);
    else setRisks((prev) => prev.map((r) => (r.id === formTarget.id ? { ...r, ...data } : r)));
    setFormTarget(null);
  };
  const removeRisk = (r) => setRisks((prev) => prev.filter((x) => x.id !== r.id));

  return (
    <Modal title={`Registre des risques — ${project.name}`} onClose={onClose} wide>
      <div className="lp-risk-toolbar">
        <div className="lp-density-row">
          <button type="button" className={"lp-density-btn" + (statusFilter === "open" ? " active" : "")} onClick={() => setStatusFilter("open")}>Actifs</button>
          <button type="button" className={"lp-density-btn" + (statusFilter === "all" ? " active" : "")} onClick={() => setStatusFilter("all")}>Tous</button>
          <button type="button" className={"lp-density-btn" + (statusFilter === "closed" ? " active" : "")} onClick={() => setStatusFilter("closed")}>Clos</button>
        </div>
        <button className="lp-btn lp-btn-primary" onClick={() => setFormTarget("new")}><Plus size={13} style={{ marginRight: 4, verticalAlign: -2 }} />Nouveau risque</button>
      </div>

      {visibleRisks.length === 0 && <div className="lp-empty" style={{ padding: 20 }}>Aucun risque {statusFilter === "closed" ? "clos" : statusFilter === "open" ? "actif" : ""} pour l'instant.</div>}

      <div className="lp-risk-list">
        {visibleRisks.map((r) => {
          const level = riskLevelOf(r);
          const statusLabel = RISK_STATUSES.find((s) => s.key === r.status)?.label || "Actif";
          return (
            <div className="lp-risk-row" key={r.id} onClick={() => setFormTarget(r)}>
              <span className="lp-risk-score-badge" style={{ background: level.color }}>{riskScoreOf(r)}</span>
              <div className="lp-risk-row-main">
                <div className="lp-risk-row-title">{r.title}</div>
                <div className="lp-risk-row-meta">
                  <span style={{ color: level.color, fontWeight: 700 }}>{level.label}</span>
                  {r.owner && <span>· {r.owner}</span>}
                  <span>· {statusLabel}</span>
                </div>
              </div>
              <button className="lp-icon-btn" onClick={(e) => { e.stopPropagation(); removeRisk(r); }} title="Supprimer"><Trash2 size={14} /></button>
            </div>
          );
        })}
      </div>

      {formTarget && (
        <RiskFormModal
          risk={formTarget === "new" ? null : formTarget}
          teamMembers={teamMembers}
          onSave={handleSave}
          onClose={() => setFormTarget(null)}
        />
      )}
    </Modal>
  );
}

function RiskFormModal({ risk, teamMembers, onSave, onClose }) {
  const [title, setTitle] = useState(risk?.title || "");
  const [probability, setProbability] = useState(risk?.probability || 3);
  const [impact, setImpact] = useState(risk?.impact || 3);
  const [status, setStatus] = useState(risk?.status || "open");
  const [owner, setOwner] = useState(risk?.owner || "");
  const [mitigation, setMitigation] = useState(risk?.mitigation || "");
  const [titleError, setTitleError] = useState(false);

  const submit = () => {
    if (!title.trim()) { setTitleError(true); return; }
    onSave({ title: title.trim(), probability, impact, status, owner: owner.trim() || null, mitigation: mitigation.trim() || null });
  };

  const previewLevel = riskLevelOf({ probability, impact });

  return (
    <Modal title={risk ? "Modifier le risque" : "Nouveau risque"} onClose={onClose} footer={
      <>
        <button className="lp-btn" onClick={onClose}>Annuler</button>
        <button className="lp-btn lp-btn-primary" onClick={submit}>{risk ? "Enregistrer les modifications" : "Ajouter le risque"}</button>
      </>
    }>
      <NamedField label="Intitulé" value={title} onChange={(v) => { setTitle(v); if (titleError && v.trim()) setTitleError(false); }} error={titleError} onEnter={submit} placeholder="Ex. Retard livraison charpente" autoFocus />

      <div className="lp-field">
        <label>Probabilité × Impact <span style={{ fontWeight: 700, textTransform: "none", color: previewLevel.color }}>— {riskScoreOf({ probability, impact })} · {previewLevel.label}</span></label>
        <div className="lp-risk-grid-picker">
          <div className="lp-risk-grid-picker-yaxis">
            {[5, 4, 3, 2, 1].map((p) => <div key={p} className="lp-risk-grid-picker-axislabel">{p}</div>)}
          </div>
          <div className="lp-risk-grid-picker-grid">
            {[5, 4, 3, 2, 1].map((p) => (
              <React.Fragment key={p}>
                {[1, 2, 3, 4, 5].map((im) => {
                  const cellLevel = riskLevelOf({ probability: p, impact: im });
                  const active = p === probability && im === impact;
                  return (
                    <button
                      type="button"
                      key={im}
                      className={"lp-risk-grid-cell" + (active ? " active" : "")}
                      style={{ background: cellLevel.color + (active ? "" : "33") }}
                      onClick={() => { setProbability(p); setImpact(im); }}
                      title={`Probabilité ${p} × Impact ${im} = ${p * im}`}
                    />
                  );
                })}
              </React.Fragment>
            ))}
          </div>
          <div className="lp-risk-grid-picker-xaxis">
            {[1, 2, 3, 4, 5].map((im) => <div key={im} className="lp-risk-grid-picker-axislabel">{im}</div>)}
          </div>
        </div>
        <div className="lp-risk-grid-picker-labels">
          <span>↑ Probabilité</span>
          <span>Impact →</span>
        </div>
      </div>

      <div className="lp-row2">
        <div className="lp-field">
          <label>Statut</label>
          <select value={status} onChange={(e) => setStatus(e.target.value)}>
            {RISK_STATUSES.map((s) => <option key={s.key} value={s.key}>{s.label}</option>)}
          </select>
        </div>
        <div className="lp-field">
          <label>Responsable</label>
          <select value={owner} onChange={(e) => setOwner(e.target.value)}>
            <option value="">Non assigné</option>
            {sortedByName(teamMembers || []).map((u) => <option key={u.id} value={u.name}>{u.name}</option>)}
          </select>
        </div>
      </div>

      <div className="lp-field"><label>Plan de mitigation</label><textarea rows={4} value={mitigation} onChange={(e) => setMitigation(e.target.value)} placeholder="Actions prévues pour réduire la probabilité ou l'impact…" /></div>
    </Modal>
  );
}

function ProjectFormModal({ project, projects, projectFolders, statuses, taskTypes, tasks, teamMembers, customFieldDefs, inheritedFolder, defaultColor, onSave, onClose }) {
  const [name, setName] = useState(project?.name || "");
  const [icon, setIcon] = useState(project?.icon || "tabler:route");
  const [color, setColor] = useState(project?.color || defaultColor || PROJECT_PALETTES.default[0]);
  const [folderId, setFolderId] = useState(project?.folderId || DEFAULT_UNSORTED_FOLDER_ID);
  const [priority, setPriority] = useState(project?.priority || "normal");
  const [milestoneIcon, setMilestoneIcon] = useState(project?.milestoneIcon || "");
  const [metroTaskIcons, setMetroTaskIcons] = useState(project?.metroTaskIcons || false);
  const [disabledStatusIds, setDisabledStatusIds] = useState(project?.disabledStatusIds || []);
  const [disabledTaskTypeIds, setDisabledTaskTypeIds] = useState(project?.disabledTaskTypeIds || []);
  const [navigationDefaults, setNavigationDefaults] = useState(project?.navigationDefaults || {});
  const [nameError, setNameError] = useState(false);

  const submit = () => {
    if (!name.trim()) { setNameError(true); return; }
    onSave({
      name: name.trim(),
      icon,
      color,
      folderId: folderId || null,
      priority,
      milestoneIcon: milestoneIcon || null,
      metroTaskIcons,
      disabledStatusIds,
      disabledTaskTypeIds,
      navigationDefaults
    });
  };

  return (
    <Modal title={project ? "Modifier le projet" : "Nouveau projet"} onClose={onClose} footer={
      <>
        <button className="lp-btn" onClick={onClose}>Annuler</button>
        <button className="lp-btn lp-btn-primary" onClick={submit}>{project ? "Enregistrer les modifications" : "Ajouter le projet"}</button>
      </>
    }>
      <NamedField label="Nom" value={name} onChange={(v) => { setName(v); if (nameError && v.trim()) setNameError(false); }} error={nameError} onEnter={submit} placeholder="Ex. Lot 3" autoFocus />
      <div className="lp-field"><label>Icône</label><IconEditor icon={icon} setIcon={setIcon} /></div>
      <div className="lp-field"><label>Couleur</label><input type="color" value={color} onChange={(e) => setColor(e.target.value)} style={{ width: "100%", height: 36 }} /></div>
      <div className="lp-field">
        <label>Icône des jalons <span style={{ fontWeight: 400, textTransform: "none", color: "var(--text-600)" }}>(facultatif — sinon le style global s'applique)</span></label>
        <IconEditor icon={milestoneIcon} setIcon={setMilestoneIcon} />
      </div>
      <label className="lp-checkbox-row" style={{ padding: "7px 0" }}>
        <input type="checkbox" checked={metroTaskIcons} onChange={(e) => setMetroTaskIcons(e.target.checked)} />
        <span style={{ textTransform: "none", fontWeight: 500 }}>En vue Métro, remplacer le rond de fin de chaque tâche par son icône (ou celle du jalon/du projet à défaut)</span>
      </label>
      <div className="lp-field">
        <label>Priorité <span style={{ fontWeight: 400, textTransform: "none", color: "var(--text-600)" }}>(utilisée par Next Best Action)</span></label>
        <div className="lp-density-row">
          <button type="button" className={"lp-density-btn" + (priority === "low" ? " active" : "")} onClick={() => setPriority("low")}>Faible</button>
          <button type="button" className={"lp-density-btn" + (priority === "normal" ? " active" : "")} onClick={() => setPriority("normal")}>Normale</button>
          <button type="button" className={"lp-density-btn" + (priority === "high" ? " active" : "")} onClick={() => setPriority("high")}>Prioritaire</button>
        </div>
      </div>

      {project && (
        <div className="lp-field">
          <label>Statuts disponibles pour ce projet</label>
          <div style={{fontSize:11,color:"var(--text-600)",marginBottom:8,lineHeight:1.45}}>
            Décoche les statuts globaux inutiles pour ce projet. Les statuts protégés restent toujours actifs.
            Les statuts créés spécifiquement pour ce projet sont toujours affichés ici.
          </div>
          <div style={{display:"flex",flexDirection:"column",gap:6,padding:"8px 10px",border:"1px solid var(--border)",borderRadius:"var(--radius-sm)",background:"var(--paper-soft)"}}>
            {(statuses || []).filter((st)=>!st.projectId || st.projectId===project.id).map((st)=>{
              const protectedStatus=isProtectedStatus(st);
              const specific=st.projectId===project.id;
              const usedCount=(tasks || []).filter((t)=>t.projectId===project.id && t.statusId===st.id).length;
              const enabled=specific || protectedStatus || !disabledStatusIds.includes(st.id);
              return (
                <label key={st.id} className="lp-checkbox-row" style={{padding:"4px 0",margin:0}}>
                  <input
                    type="checkbox"
                    checked={enabled}
                    disabled={specific || protectedStatus}
                    onChange={(e)=>{
                      if (e.target.checked) setDisabledStatusIds(prev=>prev.filter(id=>id!==st.id));
                      else setDisabledStatusIds(prev=>prev.includes(st.id)?prev:[...prev,st.id]);
                    }}
                  />
                  <span className="lp-project-status-row-label" style={{textTransform:"none",fontWeight:500}}>
                    <span className="lp-status-dot" style={{background:st.color,width:10,height:10,flex:"0 0 auto"}}/>
                    <span className="lp-project-status-row-name">{st.name}</span>
                    {specific && <span className="lp-project-setting-badge lp-status-scope-badge">Spécifique</span>}
                    {protectedStatus && <Lock size={11} title="Statut protégé" style={{flex:"0 0 auto"}}/>}
                    {usedCount>0 && !enabled && <span style={{color:"var(--warning)",fontSize:10,whiteSpace:"nowrap"}}>· {usedCount} tâche(s) l’utilisent encore</span>}
                  </span>
                </label>
              );
            })}
          </div>
        </div>
      )}

      {project && (
        <div className="lp-field">
          <label>Types disponibles pour ce projet</label>
          <div style={{fontSize:11,color:"var(--text-600)",marginBottom:8,lineHeight:1.45}}>
            Décoche les types globaux inutiles pour ce projet. Les types verrouillés restent toujours actifs.
            Les types créés spécifiquement pour ce projet sont toujours affichés ici.
          </div>
          <div style={{display:"flex",flexDirection:"column",gap:6,padding:"8px 10px",border:"1px solid var(--border)",borderRadius:"var(--radius-sm)",background:"var(--paper-soft)"}}>
            {(taskTypes || []).filter((tt)=>!tt.projectId || tt.projectId===project.id).map((tt)=>{
              const lockedType=isLockedTaskType(tt);
              const specific=tt.projectId===project.id;
              const usedCount=(tasks || []).filter((t)=>t.projectId===project.id && t.taskTypeId===tt.id).length;
              const enabled=specific || lockedType || !disabledTaskTypeIds.includes(tt.id);
              return (
                <label key={tt.id} className="lp-checkbox-row" style={{padding:"4px 0",margin:0}}>
                  <input
                    type="checkbox"
                    checked={enabled}
                    disabled={specific || lockedType}
                    onChange={(e)=>{
                      if (e.target.checked) setDisabledTaskTypeIds(prev=>prev.filter(id=>id!==tt.id));
                      else setDisabledTaskTypeIds(prev=>prev.includes(tt.id)?prev:[...prev,tt.id]);
                    }}
                  />
                  <span className="lp-project-status-row-label" style={{textTransform:"none",fontWeight:500}}>
                    <span className="lp-status-dot" style={{background:tt.color,width:10,height:10,flex:"0 0 auto"}}/>
                    {tt.icon && <IconGlyph icon={tt.icon} size={12}/>}
                    <span className="lp-project-status-row-name">{tt.name}</span>
                    {specific && <span className="lp-project-setting-badge lp-status-scope-badge">Spécifique</span>}
                    {lockedType && <Lock size={11} title="Type verrouillé" style={{flex:"0 0 auto"}}/>}
                    {usedCount>0 && !enabled && <span style={{color:"var(--warning)",fontSize:10,whiteSpace:"nowrap"}}>· {usedCount} tâche(s) l’utilisent encore</span>}
                  </span>
                </label>
              );
            })}
          </div>
        </div>
      )}

      {project && (
        <ProjectNavigationDefaultsEditor
          value={navigationDefaults}
          onChange={setNavigationDefaults}
          ctx={{projects, statuses, taskTypes, tasks, teamMembers, projectFolders, customFieldDefs}}
          inheritedLabel={inheritedFolder?.navigationDefaults?.view
            ? `Hériter du dossier (${PROJECT_DEFAULT_VIEW_OPTIONS.find((v)=>v.key===inheritedFolder.navigationDefaults.view)?.label || "vue configurée"})`
            : "Conserver la vue actuelle"}
        />
      )}
      {projectFolders.length > 0 && (
        <div className="lp-field">
          <label>Dossier</label>
          <select value={folderId} onChange={(e) => setFolderId(e.target.value)}>
            {projectFolders.map((f) => <option key={f.id} value={f.id}>{f.name}</option>)}
          </select>
        </div>
      )}
    </Modal>
  );
}

// ============================================================================
// Table des utilisateurs (Réglages) — nom, couleur, logo/avatar. Sert de source
// pour le champ "Responsable" (liste déroulante) partout dans l'application.
// ============================================================================
function TeamMemberManager({ teamMembers, setTeamMembers, tasks, pushToast, onClose, embedded }) {
  const [formTarget, setFormTarget] = useState(null); // null | "new" | membre à modifier

  const handleSave = (data) => {
    if (formTarget === "new") setTeamMembers((prev) => [...prev, { id: uid(), ...data }]);
    else setTeamMembers((prev) => prev.map((u) => (u.id === formTarget.id ? { ...u, ...data } : u)));
    setFormTarget(null);
  };
  const removeMember = (u) => {
    const count = tasks.filter((t) => t.assignee === u.name).length;
    if (count > 0) { pushToast({ message: `${count} tâche${count > 1 ? "s" : ""} assignée${count > 1 ? "s" : ""} à ${u.name}. Réassigne-les avant de supprimer cet utilisateur.` }); return; }
    setTeamMembers((prev) => prev.filter((x) => x.id !== u.id));
  };

  const body = (
    <>
      <div className="lp-section-title">Utilisateurs</div>
      {teamMembers.map((u) => {
        const count = tasks.filter((t) => t.assignee === u.name).length;
        return (
          <div className="lp-manage-item" key={u.id}>
            <span className="lp-project-dot" style={{ background: u.color, width: 24, height: 24 }}>{u.avatarDataUrl ? <IconGlyph icon={u.avatarDataUrl} size={15} /> : <User size={13} color="#fff" />}</span>
            <span className="lp-manage-name">{u.name} <span style={{ color: "var(--text-600)", fontWeight: 400 }}>({count} tâche{count > 1 ? "s" : ""})</span></span>
            <button className="lp-icon-btn" onClick={() => setFormTarget(u)}><Pencil size={14} /></button>
            <button className="lp-icon-btn" onClick={() => removeMember(u)}><Trash2 size={15} /></button>
          </div>
        );
      })}
      <hr className="lp-divider" />
      <button className="lp-btn lp-btn-primary" onClick={() => setFormTarget("new")}><Plus size={13} style={{ marginRight: 4, verticalAlign: -2 }} />Nouvel utilisateur</button>
      {formTarget && (
        <TeamMemberFormModal
          member={formTarget === "new" ? null : formTarget}
          onSave={handleSave}
          onClose={() => setFormTarget(null)}
        />
      )}
    </>
  );

  if (embedded) return <div className="lp-settings-pane">{body}</div>;
  return <Modal title="Utilisateurs" onClose={onClose} wide>{body}</Modal>;
}

// Types de champ personnalisé disponibles — volontairement limités à des types
// simples et robustes (pas de champ "formule" ou de dépendances entre champs)
// pour rester fiables et faciles à comprendre dans un contexte chantier.
const CUSTOM_FIELD_TYPES = [
  { key: "text", label: "Texte" },
  { key: "number", label: "Nombre" },
  { key: "date", label: "Date" },
  { key: "select", label: "Liste déroulante" },
  { key: "checkbox", label: "Case à cocher" },
];

// Réglages Google Calendar : quels calendriers synchroniser (un projet sera
// créé par calendrier coché), et sur quelle fenêtre temporelle. La liste des
// calendriers n'est chargée qu'à la demande (nécessite l'autorisation Google).
function GcalSettingsManager({ gcalSettings, setGcalSettings, gcalList, gcalListLoading, gcalListError, onFetchList }) {
  const selectedIds = new Set((gcalSettings.calendars || []).map((c) => c.id));
  const selectedByCalId = (id) => (gcalSettings.calendars || []).find((c) => c.id === id);
  const toggleCalendar = (cal) => {
    setGcalSettings((prev) => {
      const already = (prev.calendars || []).some((c) => c.id === cal.id);
      const calendars = already
        ? prev.calendars.filter((c) => c.id !== cal.id)
        : [...(prev.calendars || []), { id: cal.id, name: cal.name, color: cal.color, customName: "" }];
      return { ...prev, calendars };
    });
  };
  const setCalendarCustomName = (calId, customName) => {
    setGcalSettings((prev) => ({ ...prev, calendars: (prev.calendars || []).map((c) => (c.id === calId ? { ...c, customName } : c)) }));
  };

  return (
    <div className="lp-settings-pane">
      <div className="lp-section-title">Fenêtre temporelle</div>
      <p style={{ fontSize: 12.5, color: "var(--text-600)", marginTop: -6, marginBottom: 10 }}>
        Les événements en dehors de cette plage ne sont pas importés — et sont retirés au prochain clic sur « Synchroniser » si tu réduis la fenêtre.
      </p>
      <div className="lp-row2" style={{ marginBottom: 16 }}>
        <div className="lp-field">
          <label>Jours dans le passé</label>
          <input type="number" min="0" value={gcalSettings.daysPast ?? 30} onChange={(e) => setGcalSettings((p) => ({ ...p, daysPast: Math.max(0, Number(e.target.value) || 0) }))} />
        </div>
        <div className="lp-field">
          <label>Jours dans le futur</label>
          <input type="number" min="0" value={gcalSettings.daysFuture ?? 365} onChange={(e) => setGcalSettings((p) => ({ ...p, daysFuture: Math.max(0, Number(e.target.value) || 0) }))} />
        </div>
      </div>

      <label className="lp-checkbox-row" style={{ padding: "7px 0", marginBottom: 16 }}>
        <input type="checkbox" checked={!!gcalSettings.autoCompletePastEvents} onChange={(e) => setGcalSettings((p) => ({ ...p, autoCompletePastEvents: e.target.checked }))} />
        <span style={{ textTransform: "none", fontWeight: 500, fontSize: 13.5 }}>Marquer automatiquement « Terminé » les événements dont la fin est passée</span>
      </label>

      <div className="lp-section-title">Synchronisation en lecture seule</div>
      <p style={{ fontSize: 12.5, color: "var(--text-600)", marginTop: -6, marginBottom: 16, lineHeight: 1.5 }}>
        Google Calendar est la source de vérité. À chaque synchronisation, Nexora supprime entièrement les tâches appartenant aux projets Google Calendar puis les recrée depuis les événements actuellement présents dans Google. Aucune modification, création ou suppression n'est envoyée de Nexora vers Google Calendar.
      </p>

      <div className="lp-section-title">Calendriers à synchroniser</div>
      <p style={{ fontSize: 12.5, color: "var(--text-600)", marginTop: -6, marginBottom: 10 }}>
        Un projet Nexora est créé pour chaque calendrier coché. Un nom de remplacement peut être défini pour chacun (utilisé partout dans Nexora à la place du nom Google).
      </p>
      <button className="lp-btn" onClick={onFetchList} disabled={gcalListLoading}>
        {gcalListLoading ? "Chargement…" : "Charger mes calendriers Google"}
      </button>
      {gcalListError && <p style={{ fontSize: 12, color: "var(--danger)", marginTop: 8 }}>{gcalListError}</p>}

      {gcalList && (
        <div style={{ marginTop: 12 }}>
          {gcalList.length === 0 && <div className="lp-empty" style={{ padding: 12 }}>Aucun calendrier trouvé sur ce compte Google.</div>}
          {gcalList.map((cal) => {
            const selected = selectedByCalId(cal.id);
            return (
              <div key={cal.id} className="lp-gcal-calendar-row">
                <label className="lp-checkbox-row" style={{ padding: "7px 0" }}>
                  <input type="checkbox" checked={selectedIds.has(cal.id)} onChange={() => toggleCalendar(cal)} />
                  <span className="lp-project-dot" style={{ background: cal.color, width: 14, height: 14 }} />
                  <span style={{ textTransform: "none", fontWeight: 500, fontSize: 13.5 }}>{cal.name}</span>
                </label>
                {selected && (
                  <input
                    type="text"
                    className="lp-gcal-custom-name-input"
                    placeholder="Nom de remplacement (facultatif)"
                    value={selected.customName || ""}
                    onChange={(e) => setCalendarCustomName(cal.id, e.target.value)}
                  />
                )}
              </div>
            );
          })}
        </div>
      )}
      {!gcalList && (gcalSettings.calendars || []).length > 0 && (
        <div style={{ marginTop: 12 }}>
          <p style={{ fontSize: 11.5, color: "var(--text-600)", marginBottom: 6 }}>Déjà sélectionnés (recharge la liste ci-dessus pour modifier) :</p>
          {gcalSettings.calendars.map((cal) => (
            <div key={cal.id} className="lp-gcal-calendar-row">
              <div className="lp-checkbox-row" style={{ padding: "5px 0" }}>
                <span className="lp-project-dot" style={{ background: cal.color, width: 14, height: 14 }} />
                <span style={{ fontSize: 13 }}>{cal.customName || cal.name}</span>
              </div>
              <input
                type="text"
                className="lp-gcal-custom-name-input"
                placeholder="Nom de remplacement (facultatif)"
                value={cal.customName || ""}
                onChange={(e) => setCalendarCustomName(cal.id, e.target.value)}
              />
            </div>
          ))}
        </div>
      )}
    </div>
  );
}

function CustomFieldManager({ customFieldDefs, setCustomFieldDefs, tasks, projects, pushToast, onClose, embedded }) {
  const [formTarget, setFormTarget] = useState(null); // null | "new" | définition à modifier

  const handleSave = (data) => {
    if (formTarget === "new") setCustomFieldDefs((prev) => [...prev, { id: uid(), ...data }]);
    else setCustomFieldDefs((prev) => prev.map((f) => (f.id === formTarget.id ? { ...f, ...data } : f)));
    setFormTarget(null);
  };
  const [confirmRemoveField, setConfirmRemoveField] = useState(null); // { field, count } | null
  const removeField = (f) => {
    const count = tasks.filter((t) => t.customFields && t.customFields[f.id] !== undefined && t.customFields[f.id] !== "" && t.customFields[f.id] !== null).length;
    if (count > 0) { setConfirmRemoveField({ field: f, count }); return; }
    setCustomFieldDefs((prev) => prev.filter((x) => x.id !== f.id));
  };
  const moveField = (id, dir) => {
    setCustomFieldDefs((prev) => {
      const idx = prev.findIndex((f) => f.id === id);
      const swapIdx = idx + dir;
      if (idx === -1 || swapIdx < 0 || swapIdx >= prev.length) return prev;
      const next = [...prev];
      [next[idx], next[swapIdx]] = [next[swapIdx], next[idx]];
      return next;
    });
  };
  const projectName = (id) => (id ? projects.find((p) => p.id === id)?.name || "(projet supprimé)" : null);

  const body = (
    <>
      <div className="lp-section-title">Champs personnalisés des tâches</div>
      <p style={{ fontSize: 12.5, color: "var(--text-600)", marginTop: -6, marginBottom: 12 }}>
        Ex. numéro de lot, référence marché, zone chantier... Propres à UN projet — les tâches d'un autre projet ne les affichent pas. Ces champs apparaissent dans la fiche de chaque tâche du projet concerné et peuvent servir de colonnes dans le Tableur.
      </p>
      {customFieldDefs.length === 0 && <div className="lp-empty" style={{ padding: 12 }}>Aucun champ personnalisé pour l'instant.</div>}
      {customFieldDefs.map((f, i) => (
        <div className="lp-manage-item" key={f.id}>
          <div className="lp-view-order-arrows">
            <button type="button" className="lp-icon-btn" disabled={i === 0} onClick={() => moveField(f.id, -1)} title="Monter"><ChevronUp size={12} /></button>
            <button type="button" className="lp-icon-btn" disabled={i === customFieldDefs.length - 1} onClick={() => moveField(f.id, 1)} title="Descendre"><ChevronDown size={12} /></button>
          </div>
          <span className="lp-project-dot" style={{ background: "var(--text-muted)", width: 24, height: 24 }}><Hash size={13} color="#fff" /></span>
          <span className="lp-manage-name">
            {f.name} <span style={{ color: "var(--text-600)", fontWeight: 400 }}>({CUSTOM_FIELD_TYPES.find((t) => t.key === f.type)?.label || f.type})</span>
            <span className={"lp-cf-scope-badge" + (f.projectId ? "" : " lp-cf-scope-badge-global")}>{f.projectId ? projectName(f.projectId) : "Tous les projets"}</span>
          </span>
          <button className="lp-icon-btn" onClick={() => setFormTarget(f)}><Pencil size={14} /></button>
          <button className="lp-icon-btn" onClick={() => removeField(f)}><Trash2 size={15} /></button>
        </div>
      ))}
      <hr className="lp-divider" />
      <button className="lp-btn lp-btn-primary" onClick={() => setFormTarget("new")}><Plus size={13} style={{ marginRight: 4, verticalAlign: -2 }} />Nouveau champ</button>
      {formTarget && (
        <CustomFieldFormModal
          field={formTarget === "new" ? null : formTarget}
          projects={projects}
          onSave={handleSave}
          onClose={() => setFormTarget(null)}
        />
      )}
      {confirmRemoveField && (
        <ConfirmModal
          title="Supprimer le champ"
          message={`${confirmRemoveField.count} tâche${confirmRemoveField.count > 1 ? "s ont" : " a"} une valeur pour « ${confirmRemoveField.field.name} ». La supprimer effacera aussi ces valeurs. Continuer ?`}
          danger
          confirmLabel="Supprimer"
          onConfirm={() => { setCustomFieldDefs((prev) => prev.filter((x) => x.id !== confirmRemoveField.field.id)); setConfirmRemoveField(null); }}
          onClose={() => setConfirmRemoveField(null)}
        />
      )}
    </>
  );

  if (embedded) return <div className="lp-settings-pane">{body}</div>;
  return <Modal title="Champs personnalisés" onClose={onClose} wide>{body}</Modal>;
}

function CustomFieldFormModal({ field, projects, onSave, onClose }) {
  const [name, setName] = useState(field?.name || "");
  const [type, setType] = useState(field?.type || "text");
  const [optionsText, setOptionsText] = useState((field?.options || []).join("\n"));
  const [projectId, setProjectId] = useState(field?.projectId || (projects[0]?.id ?? ""));
  const [nameError, setNameError] = useState(false);

  const submit = () => {
    if (!name.trim()) { setNameError(true); return; }
    const options = type === "select" ? optionsText.split("\n").map((s) => s.trim()).filter(Boolean) : undefined;
    onSave({ name: name.trim(), type, options, projectId: projectId || null });
  };

  return (
    <Modal title={field ? "Modifier le champ" : "Nouveau champ personnalisé"} onClose={onClose} footer={
      <>
        <button className="lp-btn" onClick={onClose}>Annuler</button>
        <button className="lp-btn lp-btn-primary" onClick={submit}>{field ? "Enregistrer les modifications" : "Ajouter le champ"}</button>
      </>
    }>
      <NamedField label="Nom du champ" value={name} onChange={(v) => { setName(v); if (nameError && v.trim()) setNameError(false); }} error={nameError} onEnter={submit} placeholder="Ex. Numéro de lot" autoFocus />
      <div className="lp-field">
        <label>Projet <span style={{ fontWeight: 400, textTransform: "none", color: "var(--text-600)" }}>(le champ n'apparaîtra que sur les tâches de ce projet)</span></label>
        <ProjectSelect projects={projects} value={projectId} onChange={setProjectId} emptyLabel={`Tous les projets${field && !field.projectId ? " (réglage existant)" : " — déconseillé, préfère un projet précis"}`} />
      </div>
      <div className="lp-field">
        <label>Type</label>
        <select value={type} onChange={(e) => setType(e.target.value)}>
          {CUSTOM_FIELD_TYPES.map((t) => <option key={t.key} value={t.key}>{t.label}</option>)}
        </select>
      </div>
      {type === "select" && (
        <div className="lp-field">
          <label>Options <span style={{ fontWeight: 400, textTransform: "none", color: "var(--text-600)" }}>(une par ligne)</span></label>
          <textarea rows={4} value={optionsText} onChange={(e) => setOptionsText(e.target.value)} placeholder={"Lot 1\nLot 2\nLot 3"} />
        </div>
      )}
    </Modal>
  );
}

function TeamMemberFormModal({ member, onSave, onClose }) {
  const [name, setName] = useState(member?.name || "");
  const [avatar, setAvatar] = useState(member?.avatarDataUrl || "");
  const [color, setColor] = useState(member?.color || PALETTE[0]);
  const [email, setEmail] = useState(member?.email || "");
  const [nameError, setNameError] = useState(false);

  const submit = () => {
    if (!name.trim()) { setNameError(true); return; }
    onSave({ name: name.trim(), color, avatarDataUrl: avatar || null, email: email.trim() || null });
  };

  return (
    <Modal title={member ? "Modifier l'utilisateur" : "Nouvel utilisateur"} onClose={onClose} footer={
      <>
        <button className="lp-btn" onClick={onClose}>Annuler</button>
        <button className="lp-btn lp-btn-primary" onClick={submit}>{member ? "Enregistrer les modifications" : "Ajouter l'utilisateur"}</button>
      </>
    }>
      <NamedField label="Nom" value={name} onChange={(v) => { setName(v); if (nameError && v.trim()) setNameError(false); }} error={nameError} onEnter={submit} placeholder="Ex. Vincent" autoFocus />
      <div className="lp-field">
        <label>Email <span style={{ fontWeight: 400, textTransform: "none", color: "var(--text-600)" }}>(facultatif — s'il correspond à ton compte connecté, ça active "Mes tâches" dans certains widgets)</span></label>
        <input type="email" value={email} onChange={(e) => setEmail(e.target.value)} placeholder="prenom@exemple.com" />
      </div>
      <div className="lp-field"><label>Logo / avatar (facultatif, sinon pastille de couleur)</label><IconEditor icon={avatar} setIcon={setAvatar} /></div>
      <div className="lp-field"><label>Couleur</label><input type="color" value={color} onChange={(e) => setColor(e.target.value)} style={{ width: "100%", height: 36 }} /></div>
    </Modal>
  );
}

function ProjectDeleteChoiceModal({ project, projects, tasks, setTasks, onConfirm, onClose }) {
  const count = tasks.filter((t) => t.projectId === project.id).length;
  const otherProjects = projects.filter((p) => p.id !== project.id);
  const [mode, setMode] = useState(otherProjects.length ? "reassign" : "deleteAll");
  const [targetId, setTargetId] = useState(otherProjects[0]?.id || "");

  const confirm = () => {
    if (mode === "deleteAll") {
      setTasks((prev) => prev.filter((t) => t.projectId !== project.id));
    } else {
      if (!targetId) return;
      setTasks((prev) => prev.map((t) => (t.projectId === project.id ? { ...t, projectId: targetId } : t)));
    }
    onConfirm();
  };

  return (
    <Modal title={`Supprimer « ${project.name} »`} onClose={onClose} footer={
      <>
        <button className="lp-btn" onClick={onClose}>Annuler</button>
        <button className="lp-btn lp-btn-danger" onClick={confirm}>Confirmer la suppression</button>
      </>
    }>
      <p style={{ fontSize: 13, marginTop: 0 }}>Ce projet contient <strong>{count} tâche{count > 1 ? "s" : ""}</strong>. Que veux-tu en faire ?</p>
      {otherProjects.length > 0 && (
        <label className="lp-checkbox-row" style={{ alignItems: "flex-start" }}>
          <input type="radio" checked={mode === "reassign"} onChange={() => setMode("reassign")} style={{ marginTop: 3 }} />
          <span style={{ textTransform: "none", fontWeight: 500, fontSize: 13 }}>Réaffecter ces tâches à un autre projet</span>
        </label>
      )}
      {mode === "reassign" && otherProjects.length > 0 && (
        <div className="lp-field" style={{ marginLeft: 26 }}>
          <select value={targetId} onChange={(e) => setTargetId(e.target.value)}>
            {sortedByName(otherProjects).map((p) => {
              const isImageIcon = p.icon && (p.icon.startsWith("http") || p.icon.startsWith("data:"));
              return <option key={p.id} value={p.id}>{!isImageIcon && p.icon ? p.icon + " " : ""}{p.name}</option>;
            })}
          </select>
        </div>
      )}
      <label className="lp-checkbox-row" style={{ alignItems: "flex-start" }}>
        <input type="radio" checked={mode === "deleteAll"} onChange={() => setMode("deleteAll")} style={{ marginTop: 3 }} />
        <span style={{ textTransform: "none", fontWeight: 500, fontSize: 13 }}>Supprimer ces {count} tâche{count > 1 ? "s" : ""} avec le projet</span>
      </label>
      {otherProjects.length === 0 && <div style={{ fontSize: 11.5, color: "var(--text-600)", marginTop: 8 }}>Aucun autre projet disponible pour réaffecter — seule la suppression est possible.</div>}
    </Modal>
  );
}

// ============================================================================
// Gestion des statuts (édition + icône optionnelle)
// ============================================================================
function StatusManager({ statuses, setStatuses, tasks, projects, pushToast, onClose, embedded }) {
  const [editingId, setEditingId] = useState(null);
  const [name, setName] = useState("");
  const [color, setColor] = useState(PALETTE[0]);
  const [icon, setIcon] = useState(null);
  const [scope, setScope] = useState("global"); // global | project
  const [projectId, setProjectId] = useState("");

  const startEdit = (status) => {
    setEditingId(status.id);
    setName(status.name);
    setColor(status.color);
    setIcon(status.icon || null);
    setScope(status.projectId ? "project" : "global");
    setProjectId(status.projectId || "");
  };

  const cancelEdit = () => {
    setEditingId(null);
    setName("");
    setColor(PALETTE[0]);
    setIcon(null);
    setScope("global");
    setProjectId("");
  };

  const save = () => {
    if (!name.trim()) return;
    if (scope === "project" && !projectId) {
      pushToast?.({message:"Choisis le projet auquel ce statut doit appartenir."});
      return;
    }

    if (editingId) {
      const previous = statuses.find((s)=>s.id===editingId);
      const protectedStatus = isProtectedStatus(previous);
      setStatuses((prev) => prev.map((status) => (
        status.id === editingId
          ? {
              ...status,
              name: protectedStatus ? status.name : name.trim(),
              color,
              icon,
              projectId: protectedStatus ? null : (scope === "project" ? projectId : null)
            }
          : status
      )));
    } else {
      setStatuses((prev) => [...prev, {
        id:uid(),
        name:name.trim(),
        color,
        icon,
        projectId:scope === "project" ? projectId : null
      }]);
    }

    cancelEdit();
  };

  const remove = (id) => {
    if (tasks.some((t) => t.statusId === id)) {
      pushToast({ message: "Ce statut est utilisé par des tâches. Réassigne-les avant de le supprimer." });
      return;
    }
    setStatuses((prev) => prev.filter((s) => s.id !== id));
    if (editingId === id) cancelEdit();
  };

  const move = (idx, dir) => setStatuses((prev) => {
    const arr=[...prev];
    const j=idx+dir;
    if(j<0||j>=arr.length) return arr;
    [arr[idx],arr[j]]=[arr[j],arr[idx]];
    return arr;
  });

  const body = (
    <>
      <div className="lp-section-title">Statuts existants</div>
      <div style={{fontSize:11.5,color:"var(--text-600)",marginBottom:10,lineHeight:1.45}}>
        Un statut global est disponible dans tous les projets sauf s’il est désactivé dans les réglages du projet.
        Un statut spécifique n’existe que pour le projet choisi.
      </div>

      {statuses.map((status, i) => {
        const protectedStatus=isProtectedStatus(status);
        const project=status.projectId ? projects.find((p)=>p.id===status.projectId) : null;
        return (
          <div className="lp-manage-item" key={status.id}>
            <div className="lp-order-btns">
              <button onClick={()=>move(i,-1)}><ChevronUp size={14}/></button>
              <button onClick={()=>move(i,1)}><ChevronDown size={14}/></button>
            </div>
            <span className="lp-status-dot" style={{background:status.color,width:12,height:12}}/>
            {status.icon && <IconGlyph icon={status.icon} size={14}/>}
            <span className="lp-manage-name" style={{display:"flex",alignItems:"center",gap:6,flexWrap:"wrap"}}>
              {status.name}
              {status.projectId ? (
                <span className="lp-project-setting-badge lp-status-scope-badge" title="Statut spécifique à ce projet">
                  {project?.name || "Projet supprimé"}
                </span>
              ) : (
                <span style={{fontSize:9.5,color:"var(--text-muted)",fontWeight:500}}>Global</span>
              )}
            </span>
            {protectedStatus && (
              <span className="lp-protected-badge" title="Statut protégé — global et impossible à désactiver">
                <Lock size={13}/>
              </span>
            )}
            <button className="lp-icon-btn" onClick={()=>startEdit(status)}><Pencil size={14}/></button>
            {!protectedStatus && <button className="lp-icon-btn" onClick={()=>remove(status.id)}><Trash2 size={15}/></button>}
          </div>
        );
      })}

      <hr className="lp-divider"/>
      <div className="lp-section-title">{editingId ? "Modifier le statut" : "Nouveau statut"}</div>

      <div className="lp-field">
        <label>Nom</label>
        <input
          type="text"
          value={name}
          onChange={(e)=>setName(e.target.value)}
          placeholder="Ex. En validation"
          disabled={editingId && isProtectedStatus(statuses.find((s)=>s.id===editingId))}
        />
        {editingId && isProtectedStatus(statuses.find((s)=>s.id===editingId)) && (
          <div style={{fontSize:11,color:"var(--text-600)",marginTop:4}}>
            Ce statut est protégé : son nom, sa portée et sa suppression sont verrouillés.
          </div>
        )}
      </div>

      {!isProtectedStatus(statuses.find((s)=>s.id===editingId)) && (
        <div className="lp-field">
          <label>Portée</label>
          <div className="lp-density-row">
            <button
              type="button"
              className={"lp-density-btn"+(scope==="global"?" active":"")}
              onClick={()=>{setScope("global");setProjectId("");}}
            >
              Tous les projets
            </button>
            <button
              type="button"
              className={"lp-density-btn"+(scope==="project"?" active":"")}
              onClick={()=>setScope("project")}
            >
              Un projet précis
            </button>
          </div>
        </div>
      )}

      {scope==="project" && !isProtectedStatus(statuses.find((s)=>s.id===editingId)) && (
        <div className="lp-field">
          <label>Projet concerné</label>
          <select value={projectId} onChange={(e)=>setProjectId(e.target.value)}>
            <option value="">— Choisir un projet —</option>
            {sortedByName(projects).map((project)=>(
              <option key={project.id} value={project.id}>{project.name}</option>
            ))}
          </select>
        </div>
      )}

      <div className="lp-field"><label>Icône (optionnelle)</label><IconEditor icon={icon} setIcon={setIcon}/></div>
      <div className="lp-field"><label>Couleur</label><ColorPicker value={color} onChange={setColor}/></div>

      <div style={{display:"flex",gap:8}}>
        <button className="lp-btn lp-btn-primary" onClick={save}>
          {editingId ? "Enregistrer les modifications" : "Ajouter le statut"}
        </button>
        {editingId && <button className="lp-btn" onClick={cancelEdit}>Annuler</button>}
      </div>
    </>
  );

  if (embedded) return <div className="lp-settings-pane">{body}</div>;
  return <Modal title="Gérer les statuts" onClose={onClose} wide>{body}</Modal>;
}

// ============================================================================
// Gestion des types de tâche (édition + icône + couleur) — mécanique identique
// à StatusManager : un type global est disponible partout sauf désactivation
// projet par projet ; un type spécifique n'existe que pour son projet. Les 3
// types par défaut (Tâches, Planning, Réunions) sont verrouillés : nom, portée
// et suppression bloqués (équivalent des statuts protégés, mais explicite via
// un champ `locked` plutôt qu'une détection par nom).
// ============================================================================
function TaskTypeManager({ taskTypes, setTaskTypes, tasks, projects, pushToast, onClose, embedded }) {
  const [editingId, setEditingId] = useState(null);
  const [name, setName] = useState("");
  const [color, setColor] = useState(PALETTE[0]);
  const [icon, setIcon] = useState(null);
  const [scope, setScope] = useState("global"); // global | project
  const [projectId, setProjectId] = useState("");

  const startEdit = (type) => {
    setEditingId(type.id);
    setName(type.name);
    setColor(type.color);
    setIcon(type.icon || null);
    setScope(type.projectId ? "project" : "global");
    setProjectId(type.projectId || "");
  };

  const cancelEdit = () => {
    setEditingId(null);
    setName("");
    setColor(PALETTE[0]);
    setIcon(null);
    setScope("global");
    setProjectId("");
  };

  const save = () => {
    if (!name.trim()) return;
    if (scope === "project" && !projectId) {
      pushToast?.({message:"Choisis le projet auquel ce type doit appartenir."});
      return;
    }

    if (editingId) {
      const previous = taskTypes.find((t)=>t.id===editingId);
      const lockedType = isLockedTaskType(previous);
      setTaskTypes((prev) => prev.map((type) => (
        type.id === editingId
          ? {
              ...type,
              name: lockedType ? type.name : name.trim(),
              color,
              icon,
              projectId: lockedType ? null : (scope === "project" ? projectId : null)
            }
          : type
      )));
    } else {
      setTaskTypes((prev) => [...prev, {
        id:uid(),
        name:name.trim(),
        color,
        icon,
        projectId:scope === "project" ? projectId : null,
        locked:false
      }]);
    }

    cancelEdit();
  };

  const remove = (id) => {
    if (tasks.some((t) => t.taskTypeId === id)) {
      pushToast({ message: "Ce type est utilisé par des tâches. Réassigne-les avant de le supprimer." });
      return;
    }
    setTaskTypes((prev) => prev.filter((t) => t.id !== id));
    if (editingId === id) cancelEdit();
  };

  const move = (idx, dir) => setTaskTypes((prev) => {
    const arr=[...prev];
    const j=idx+dir;
    if(j<0||j>=arr.length) return arr;
    [arr[idx],arr[j]]=[arr[j],arr[idx]];
    return arr;
  });

  const body = (
    <>
      <div className="lp-section-title">Types existants</div>
      <div style={{fontSize:11.5,color:"var(--text-600)",marginBottom:10,lineHeight:1.45}}>
        Un type global est disponible dans tous les projets sauf s’il est désactivé dans les réglages du projet.
        Un type spécifique n’existe que pour le projet choisi. Les types verrouillés (Tâches, Planning, Réunions) restent toujours globaux.
      </div>

      {taskTypes.map((type, i) => {
        const lockedType=isLockedTaskType(type);
        const project=type.projectId ? projects.find((p)=>p.id===type.projectId) : null;
        return (
          <div className="lp-manage-item" key={type.id}>
            <div className="lp-order-btns">
              <button onClick={()=>move(i,-1)}><ChevronUp size={14}/></button>
              <button onClick={()=>move(i,1)}><ChevronDown size={14}/></button>
            </div>
            <span className="lp-status-dot" style={{background:type.color,width:12,height:12}}/>
            {type.icon && <IconGlyph icon={type.icon} size={14}/>}
            <span className="lp-manage-name" style={{display:"flex",alignItems:"center",gap:6,flexWrap:"wrap"}}>
              {type.name}
              {type.projectId ? (
                <span className="lp-project-setting-badge lp-status-scope-badge" title="Type spécifique à ce projet">
                  {project?.name || "Projet supprimé"}
                </span>
              ) : (
                <span style={{fontSize:9.5,color:"var(--text-muted)",fontWeight:500}}>Global</span>
              )}
            </span>
            {lockedType && (
              <span className="lp-protected-badge" title="Type verrouillé — global et impossible à supprimer">
                <Lock size={13}/>
              </span>
            )}
            <button className="lp-icon-btn" onClick={()=>startEdit(type)}><Pencil size={14}/></button>
            {!lockedType && <button className="lp-icon-btn" onClick={()=>remove(type.id)}><Trash2 size={15}/></button>}
          </div>
        );
      })}

      <hr className="lp-divider"/>
      <div className="lp-section-title">{editingId ? "Modifier le type" : "Nouveau type"}</div>

      <div className="lp-field">
        <label>Nom</label>
        <input
          type="text"
          value={name}
          onChange={(e)=>setName(e.target.value)}
          placeholder="Ex. Astreinte"
          disabled={editingId && isLockedTaskType(taskTypes.find((t)=>t.id===editingId))}
        />
        {editingId && isLockedTaskType(taskTypes.find((t)=>t.id===editingId)) && (
          <div style={{fontSize:11,color:"var(--text-600)",marginTop:4}}>
            Ce type est verrouillé : son nom, sa portée et sa suppression sont bloqués. Seuls la couleur et l’icône restent modifiables.
          </div>
        )}
      </div>

      {!isLockedTaskType(taskTypes.find((t)=>t.id===editingId)) && (
        <div className="lp-field">
          <label>Portée</label>
          <div className="lp-density-row">
            <button
              type="button"
              className={"lp-density-btn"+(scope==="global"?" active":"")}
              onClick={()=>{setScope("global");setProjectId("");}}
            >
              Tous les projets
            </button>
            <button
              type="button"
              className={"lp-density-btn"+(scope==="project"?" active":"")}
              onClick={()=>setScope("project")}
            >
              Un projet précis
            </button>
          </div>
        </div>
      )}

      {scope==="project" && !isLockedTaskType(taskTypes.find((t)=>t.id===editingId)) && (
        <div className="lp-field">
          <label>Projet concerné</label>
          <select value={projectId} onChange={(e)=>setProjectId(e.target.value)}>
            <option value="">— Choisir un projet —</option>
            {sortedByName(projects).map((project)=>(
              <option key={project.id} value={project.id}>{project.name}</option>
            ))}
          </select>
        </div>
      )}

      <div className="lp-field"><label>Icône (optionnelle)</label><IconEditor icon={icon} setIcon={setIcon}/></div>
      <div className="lp-field"><label>Couleur</label><ColorPicker value={color} onChange={setColor}/></div>

      <div style={{display:"flex",gap:8}}>
        <button className="lp-btn lp-btn-primary" onClick={save}>
          {editingId ? "Enregistrer les modifications" : "Ajouter le type"}
        </button>
        {editingId && <button className="lp-btn" onClick={cancelEdit}>Annuler</button>}
      </div>
    </>
  );

  if (embedded) return <div className="lp-settings-pane">{body}</div>;
  return <Modal title="Gérer les types" onClose={onClose} wide>{body}</Modal>;
}

// ============================================================================
// Import CSV avec mappage des colonnes
// ============================================================================
function ImportCsvModal({ ctx, projects, statuses, setProjects, setStatuses, setTasks, persistKey, pushToast, syncBlocked, onClose }) {
  const [headers, setHeaders] = useState(null);
  const [rows, setRows] = useState([]);
  const [mapping, setMapping] = useState({});
  const [fileName, setFileName] = useState("");
  const [pasteText, setPasteText] = useState("");
  const [parseError, setParseError] = useState("");
  const [importSaving, setImportSaving] = useState(false);
  const [importError, setImportError] = useState("");
  const fileRef = useRef(null);

  const applyParsed = (results) => {
    const fields = (results.meta && results.meta.fields) || [];
    if (!fields.length) { setParseError("Aucune colonne détectée. Vérifie que le fichier est bien un CSV avec une ligne d'en-têtes."); return; }
    const m = {};
    fields.forEach((h) => { m[h] = guessImportField(h); });
    setHeaders(fields);
    setRows(results.data.filter((r) => Object.values(r).some((v) => String(v || "").trim() !== "")));
    setMapping(m);
    setParseError("");
  };

  const onFile = (e) => {
    const file = e.target.files[0];
    if (!file) return;
    setFileName(file.name);
    Papa.parse(file, { header: true, skipEmptyLines: true, complete: applyParsed, error: (err) => setParseError(err.message) });
  };
  const onParsePaste = () => {
    if (!pasteText.trim()) return;
    const results = Papa.parse(pasteText.trim(), { header: true, skipEmptyLines: true });
    applyParsed(results);
  };

  const setFieldFor = (header, fieldKey) => setMapping((m) => ({ ...m, [header]: fieldKey }));
  const titleMapped = Object.values(mapping).includes("title");

  const doImport = async () => {
    if (!titleMapped || importSaving) return;
    if (syncBlocked) {
      setImportError("Import impossible tant que la synchronisation Firebase est en erreur. Répare d’abord la connexion/synchronisation.");
      return;
    }
    setImportSaving(true);
    setImportError("");
    const projLookup = new Map(projects.map((p) => [p.name.trim().toLowerCase(), p.id]));
    const statLookup = new Map(statuses.map((s) => [s.name.trim().toLowerCase(), s.id]));
    const newProjects = [];
    const newStatuses = [];
    const newTasks = [];

    rows.forEach((row) => {
      const title = String(getMappedValue(row, mapping, "title") || "").trim();
      if (!title) return;

      let projectId = projects[0]?.id || null;
      const projectName = String(getMappedValue(row, mapping, "project") || "").trim();
      if (projectName) {
        const key = projectName.toLowerCase();
        if (projLookup.has(key)) projectId = projLookup.get(key);
        else {
          const np = { id: uid(), name: projectName, icon: EMOJIS[newProjects.length % EMOJIS.length], color: PROJECT_PALETTES.default[newProjects.length % PROJECT_PALETTES.default.length], folderId: DEFAULT_UNSORTED_FOLDER_ID };
          newProjects.push(np);
          projLookup.set(key, np.id);
          projectId = np.id;
        }
      }

      const allowedForProject = getStatusesForProject([...statuses, ...newStatuses], [...projects, ...newProjects], projectId);
      let statusId = getDefaultStatusForProject([...statuses, ...newStatuses], [...projects, ...newProjects], projectId)?.id || null;
      const statusName = String(getMappedValue(row, mapping, "status") || "").trim();
      if (statusName) {
        const key = statusName.toLowerCase();
        const exactAllowed = allowedForProject.find((st)=>String(st.name||"").trim().toLowerCase()===key);
        if (exactAllowed) statusId = exactAllowed.id;
        else {
          const ns = { id: uid(), name: statusName, color: PALETTE[(newStatuses.length + 2) % PALETTE.length], icon: null, projectId:null };
          newStatuses.push(ns);
          statLookup.set(key, ns.id);
          statusId = ns.id;
        }
      }

      const milestone = parseImportBool(getMappedValue(row, mapping, "milestone"));
      const start = parseFlexibleDate(getMappedValue(row, mapping, "start")) || iso(new Date());
      const end = milestone ? start : (parseFlexibleDate(getMappedValue(row, mapping, "end")) || start);
      const progress = parseImportProgress(getMappedValue(row, mapping, "progress"));
      const assignee = String(getMappedValue(row, mapping, "assignee") || "").trim();
      const desc = String(getMappedValue(row, mapping, "desc") || "").trim();
      // Type de tâche : on ne fait correspondre qu'à un type EXISTANT (par nom,
      // insensible à la casse/accents) — contrairement au statut, on n'en crée
      // jamais un nouveau à la volée ici, faute de pouvoir persister setTaskTypes
      // depuis cette modale d'import ; à défaut de correspondance, on retombe sur
      // le type par défaut du projet, comme avant.
      const taskTypeName = String(getMappedValue(row, mapping, "taskType") || "").trim();
      const matchedTaskType = taskTypeName ? findTaskTypeByName(ctx?.taskTypes, taskTypeName) : null;

      newTasks.push({
        id: uid(),
        title,
        projectId,
        statusId,
        taskTypeId: matchedTaskType?.id || getDefaultTaskTypeForProject(ctx?.taskTypes, [...projects, ...newProjects], projectId)?.id || null,
        assignee,
        type: milestone ? "milestone" : "action",
        milestone,
        start,
        end,
        progress,
        desc,
        checklist: [],
        lastInteraction:new Date().toISOString(),
        importSource:"csv",
        importFileName:fileName || null
      });
    });

    try {
      // Construire les tableaux finaux AVANT de modifier React afin que la même
      // version exacte soit écrite dans Firestore et affichée à l'écran.
      const finalProjects = [...projects, ...newProjects];
      const finalStatuses = [...statuses, ...newStatuses];
      const currentTasks = Array.isArray(ctx?.tasks) ? ctx.tasks : [];
      const finalTasks = [...currentTasks, ...newTasks];

      setProjects(finalProjects);
      setStatuses(finalStatuses);
      setTasks(finalTasks);

      if (typeof persistKey !== "function") {
        throw new Error("Mécanisme de sauvegarde indisponible.");
      }

      // Sauvegarde explicite : on attend réellement les trois écritures avant
      // de considérer l'import comme terminé.
      await persistKey("nexora:projects", finalProjects);
      await persistKey("nexora:statuses", finalStatuses);
      await persistKey("nexora:tasks", finalTasks);

      pushToast?.({
        message:`Import CSV confirmé dans Firebase · ${newTasks.length} tâche${newTasks.length > 1 ? "s" : ""}${newProjects.length ? ` · ${newProjects.length} projet${newProjects.length > 1 ? "s" : ""} créé${newProjects.length > 1 ? "s" : ""}` : ""}`
      });

      onClose();
    } catch (e) {
      const msg = (e && e.message) || String(e);
      setImportError(`Import affiché mais sauvegarde impossible : ${msg}`);
      pushToast?.({ message:`Échec sauvegarde import CSV · ${msg}` });
    } finally {
      setImportSaving(false);
    }
  };

  return (
    <Modal title="Importer un CSV" onClose={onClose} wide footer={
      headers && (
        <>
          <button className="lp-btn" onClick={onClose}>Annuler</button>
          <button className="lp-btn lp-btn-primary" disabled={!titleMapped || importSaving} onClick={doImport} style={(!titleMapped || importSaving) ? { opacity: 0.5, cursor: "not-allowed" } : undefined}>
            {importSaving ? "Sauvegarde…" : `Importer ${rows.length} tâche${rows.length > 1 ? "s" : ""}`}
          </button>
        </>
      )
    }>
      {!headers && (
        <>
          <div className="lp-section-title">1. Choisir un fichier</div>
          <div className="lp-upload-row" style={{ marginBottom: 14 }}>
            <button className="lp-upload-btn" onClick={() => fileRef.current?.click()}><FileUp size={13} /> {fileName || "Choisir un fichier .csv"}</button>
            <input ref={fileRef} type="file" accept=".csv,text/csv" style={{ display: "none" }} onChange={onFile} />
          </div>
          <div className="lp-section-title">— ou coller le contenu CSV —</div>
          <div className="lp-field">
            <textarea rows={6} value={pasteText} onChange={(e) => setPasteText(e.target.value)} placeholder={"Titre,Projet,Statut,Début,Fin,Avancement\nRevue DOE,Lot 2B,En cours,20/07/2026,10/09/2026,40"} />
          </div>
          <button className="lp-btn lp-btn-primary" onClick={onParsePaste} disabled={!pasteText.trim()}>Analyser le texte collé</button>
          {parseError && (
            <div className="lp-checkbox-row" style={{ marginTop: 12, color: "var(--danger)" }}>
              <AlertTriangle size={15} /> {parseError}
            </div>
          )}
        </>
      )}

      {headers && (
        <>
          <div className="lp-section-title">2. Faire correspondre les colonnes</div>
          {!titleMapped && (
            <div className="lp-checkbox-row" style={{ marginBottom: 10, color: "var(--danger)" }}>
              <AlertTriangle size={15} /> Associe au moins une colonne au champ "Titre" pour pouvoir importer.
            </div>
          )}
          <div style={{ display: "flex", flexDirection: "column", gap: 8, marginBottom: 16 }}>
            {headers.map((h) => (
              <div key={h} className="lp-row2" style={{ alignItems: "center" }}>
                <div style={{ flex: 1, fontSize: 12.5, fontWeight: 600, overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" }}>{h}</div>
                <div style={{ flex: 1 }}>
                  <select value={mapping[h] || "ignore"} onChange={(e) => setFieldFor(h, e.target.value)}>
                    {IMPORT_FIELD_OPTIONS.map((f) => <option key={f.key} value={f.key}>{f.label}</option>)}
                  </select>
                </div>
              </div>
            ))}
          </div>

          <div className="lp-section-title">3. Aperçu ({rows.length} ligne{rows.length > 1 ? "s" : ""} détectée{rows.length > 1 ? "s" : ""})</div>
          <div style={{ overflowX: "auto", border: "1px solid var(--border)", borderRadius: 8 }}>
            <table style={{ borderCollapse: "collapse", width: "100%", fontSize: 11.5 }}>
              <thead>
                <tr>
                  {headers.map((h) => (
                    <th key={h} style={{ textAlign: "left", padding: "6px 8px", background: "var(--paper-soft)", borderBottom: "1px solid var(--border)", whiteSpace: "nowrap" }}>
                      {h} <span style={{ color: "var(--text-600)", fontWeight: 400 }}>→ {IMPORT_FIELD_OPTIONS.find((f) => f.key === (mapping[h] || "ignore"))?.label}</span>
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {rows.slice(0, 5).map((r, i) => (
                  <tr key={i}>
                    {headers.map((h) => <td key={h} style={{ padding: "5px 8px", borderBottom: "1px solid var(--border)", whiteSpace: "nowrap", maxWidth: 160, overflow: "hidden", textOverflow: "ellipsis" }}>{r[h]}</td>)}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          {rows.length > 5 && <div style={{ fontSize: 11.5, color: "var(--text-600)", marginTop: 6 }}>… et {rows.length - 5} ligne{rows.length - 5 > 1 ? "s" : ""} de plus.</div>}
          <div style={{ fontSize: 11.5, color: "var(--text-600)", marginTop: 10 }}>
            Les projets et statuts qui n'existent pas encore seront créés automatiquement. Les dates sont acceptées au format JJ/MM/AAAA ou AAAA-MM-JJ.
          </div>
          {importError && (
            <div style={{marginTop:10,padding:"9px 11px",borderLeft:"3px solid var(--danger)",background:"var(--paper-soft)",color:"var(--danger)",fontSize:11.5,lineHeight:1.45}}>
              {importError}
            </div>
          )}
          {importSaving && (
            <div style={{marginTop:10,padding:"9px 11px",borderLeft:"3px solid var(--line-blue)",background:"var(--paper-soft)",color:"var(--text-600)",fontSize:11.5}}>
              Sauvegarde de l’import dans Firebase… ne ferme pas Nexora.
            </div>
          )}
        </>
      )}
    </Modal>
  );
}

// ============================================================================
// Gestion générique des dossiers (projets ou vues)
// ============================================================================
const capitalize = (s) => (s ? s.charAt(0).toUpperCase() + s.slice(1) : s);
function SimpleFolderManager({ title, folders, setFolders, countInFolder, pushToast, initialEditFolder, onClose, itemLabel = "dossier" }) {
  const [editingId, setEditingId] = useState(initialEditFolder ? initialEditFolder.id : null);
  const [name, setName] = useState(initialEditFolder ? initialEditFolder.name : "");
  const [color, setColor] = useState(initialEditFolder ? (initialEditFolder.color || PROJECT_PALETTES.default[0]) : PROJECT_PALETTES.default[folders.length % PROJECT_PALETTES.default.length]);

  const startEdit = (f) => { setEditingId(f.id); setName(f.name); setColor(f.color || PROJECT_PALETTES.default[0]); };
  const cancelEdit = () => { setEditingId(null); setName(""); setColor(PROJECT_PALETTES.default[folders.length % PROJECT_PALETTES.default.length]); };
  const save = () => {
    if (!name.trim()) return;
    if (editingId) setFolders((prev) => prev.map((f) => (f.id === editingId ? { ...f, name: name.trim(), color } : f)));
    else setFolders((prev) => [...prev, { id: uid(), name: name.trim(), color }]);
    cancelEdit();
  };
  const remove = (id) => {
    if (countInFolder(id) > 0) { pushToast({ message: `Ce ${itemLabel} contient des éléments. Déplace-les avant de le supprimer.` }); return; }
    setFolders((prev) => prev.filter((f) => f.id !== id));
    if (editingId === id) cancelEdit();
  };

  return (
    <Modal title={title} onClose={onClose}>
      <div className="lp-section-title">{capitalize(itemLabel)}s existants</div>
      {folders.length === 0 && <div className="lp-empty" style={{ padding: 12 }}>Aucun {itemLabel} pour l'instant.</div>}
      {folders.map((f) => (
        <div className="lp-manage-item" key={f.id}>
          <span className="lp-project-dot" style={{ background: f.color || "var(--text-muted)", width: 22, height: 22 }}><Folder size={12} color="#fff" /></span>
          <span className="lp-manage-name">{f.name} <span style={{ color: "var(--text-600)", fontWeight: 400 }}>({countInFolder(f.id)})</span></span>
          <button className="lp-icon-btn" onClick={() => startEdit(f)}><Pencil size={14} /></button>
          <button className="lp-icon-btn" onClick={() => remove(f.id)}><Trash2 size={15} /></button>
        </div>
      ))}
      <hr className="lp-divider" />
      <div className="lp-section-title">{editingId ? `Modifier le ${itemLabel}` : `Nouveau ${itemLabel}`}</div>
      <div className="lp-field"><input type="text" value={name} onChange={(e) => setName(e.target.value)} onKeyDown={(e) => e.key === "Enter" && save()} placeholder={`Nom du ${itemLabel}`} autoFocus /></div>
      <div className="lp-field"><label>Couleur</label><ColorPicker value={color} onChange={setColor} palette={PROJECT_PALETTES.default} /></div>
      <div style={{ display: "flex", gap: 8 }}>
        <button className="lp-btn lp-btn-primary" onClick={save}>{editingId ? "Enregistrer" : "Ajouter"}</button>
        {editingId && <button className="lp-btn" onClick={cancelEdit}>Annuler</button>}
      </div>
    </Modal>
  );
}

// ============================================================================
// Vue Heat map
// ============================================================================
function HeatmapView({ tasks: allTasks, ctx, onOpen, appearance }) {
  const tasks = useMemo(() => allTasks.filter((t) => t.start && t.end), [allTasks]);
  const [selectedDay, setSelectedDay] = useState(null);
  const today = iso(new Date());
  const currentYear = new Date().getFullYear();
  const [year, setYear] = useState(currentYear);

  // Génère les 52 semaines de l'année ISO (S1–S52)
  const weeks = useMemo(() => {
    // S1 = semaine contenant le premier jeudi de l'année
    const jan4 = new Date(year, 0, 4); // le 4 janvier est toujours en S1
    const dow = (jan4.getDay() + 6) % 7; // lundi = 0
    const s1Start = new Date(jan4);
    s1Start.setDate(jan4.getDate() - dow); // lundi de la S1
    const ws = [];
    for (let w = 0; w < 53; w++) {
      const weekStart = addDays(s1Start.toISOString().slice(0, 10), w * 7);
      const days = [];
      for (let i = 0; i < 7; i++) days.push(addDays(weekStart, i));
      // Vérifier que cette semaine appartient bien à l'année affichée
      const mainDay = new Date(weekStart + "T00:00:00");
      const thu = new Date(weekStart + "T00:00:00");
      thu.setDate(thu.getDate() + 3); // jeudi de la semaine (définit l'année ISO)
      if (thu.getFullYear() !== year) continue;
      ws.push({ weekStart, weekNum: w + 1, days });
    }
    return ws;
  }, [year]);

  const { dayEndCounts, dayLateCounts } = useMemo(() => {
    const ends = {}, late = {};
    tasks.forEach((t) => {
      ends[t.end] = (ends[t.end] || 0) + 1;
      // En retard = non terminé et date de fin avant aujourd'hui
      if (!isTaskDoneGlobal(t, ctx) && t.end < today) {
        late[t.end] = (late[t.end] || 0) + 1;
      }
    });
    return { dayEndCounts: ends, dayLateCounts: late };
  }, [tasks, ctx, today]);

  const maxEnd = Math.max(1, ...Object.values(dayEndCounts));
  const maxLate = Math.max(1, ...Object.values(dayLateCounts));
  const DAY_NAMES = ["Lun", "Mar", "Mer", "Jeu", "Ven", "Sam", "Dim"];

  const cellColor = (day) => {
    const nLate = dayLateCounts[day] || 0;
    const n = dayEndCounts[day] || 0;
    if (nLate > 0) {
      // Dégradé rouge pour les tâches en retard non terminées — fixe, pour rester
      // un signal d'alerte immédiatement reconnaissable, indépendant du réglage
      // de couleur personnalisé (qui ne concerne que le dégradé "normal").
      const pct = nLate / maxLate;
      if (pct < 0.2) return "#fde0e0";
      if (pct < 0.4) return "#f4a0a0";
      if (pct < 0.6) return "#e85555";
      if (pct < 0.8) return "#c22020";
      return "#8b0000";
    }
    if (n === 0) return "#F5F2EA";
    const pct = n / maxEnd;
    return lerpColor(appearance?.heatmapMinColor || "#d4f0e4", appearance?.heatmapMaxColor || "#0f5c40", pct);
  };

  const tasksForDay = (day) => ({
    ending: tasks.filter((t) => t.end === day),
    ongoing: tasks.filter((t) => t.start < day && t.end > day),
  });

  // Mois : afficher le libellé quand il change d'une semaine à l'autre
  const MONTHS = ["Jan","Fév","Mar","Avr","Mai","Juin","Juil","Aoû","Sep","Oct","Nov","Déc"];
  const monthLabel = (w, i) => {
    const dt = new Date(w.weekStart + "T00:00:00");
    if (i === 0) return MONTHS[dt.getMonth()];
    const prev = new Date(weeks[i - 1].weekStart + "T00:00:00");
    if (dt.getMonth() !== prev.getMonth()) return MONTHS[dt.getMonth()];
    return "";
  };

  return (
    <div className="lp-heatmap-wrap">
      <div className="lp-heatmap-top">
      <div className="lp-toolbar" style={{ marginBottom: 8, gap: 8 }}>
        <span style={{ fontWeight: 700, fontSize: 13, display: "flex", alignItems: "center", gap: 6 }}><Flame size={14} color="var(--text-600)" /> Heat map — Tâches se terminant par jour</span>
        <div style={{ display: "flex", alignItems: "center", gap: 4 }}>
          <button className="lp-tool-btn" onClick={() => setYear(y => y - 1)}><ChevronLeft size={13} /> {year - 1}</button>
          <span style={{ fontFamily: "var(--font-mono)", fontWeight: 700, fontSize: 13, minWidth: 42, textAlign: "center" }}>{year}</span>
          <button className="lp-tool-btn" onClick={() => setYear(y => y + 1)}>{year + 1} <ChevronRight size={13} /></button>
        </div>
        <button className="lp-tool-btn" onClick={() => { setYear(currentYear); }} title="Revenir à l'année courante" style={year !== currentYear ? {} : { opacity: 0.4 }}><Crosshair size={13} /> Aujourd'hui</button>
      </div>

      {/* Mois en en-tête */}
      <div style={{ display: "flex", marginLeft: 44, marginBottom: 1, gap: 3, overflow: "hidden" }}>
        {weeks.map((w, i) => (
          <div key={w.weekStart} style={{ width: 26, flex: "0 0 26px", fontSize: 8, fontWeight: 700, color: "var(--text-secondary)", textAlign: "center", overflow: "hidden" }}>
            {monthLabel(w, i)}
          </div>
        ))}
      </div>

      <div className="lp-heatmap-grid">
        <div className="lp-heatmap-header">
          <div className="lp-heatmap-day-label" />
          {weeks.map((w) => (
            <div key={w.weekStart} className="lp-heatmap-week-label">S{w.weekNum}</div>
          ))}
        </div>
        {DAY_NAMES.map((dayName, di) => (
          <div key={di} className="lp-heatmap-row">
            <div className="lp-heatmap-day-label">{dayName}</div>
            {weeks.map((w) => {
              const day = w.days[di];
              const nEnd = dayEndCounts[day] || 0;
              const nLate = dayLateCounts[day] || 0;
              const isToday = day === today;
              const isSelected = day === selectedDay;
              const count = nEnd;
              return (
                <div
                  key={day}
                  className={"lp-heatmap-cell" + (isToday ? " today" : "") + (isSelected ? " selected" : "")}
                  style={{ background: cellColor(day) }}
                  title={`${fmtShort(day)} — ${nEnd} se terminant${nLate > 0 ? ` dont ${nLate} en retard` : ""}`}
                  onClick={() => setSelectedDay(isSelected ? null : day)}
                >
                  {count > 0 && <span className="lp-heatmap-count">{count}</span>}
                </div>
              );
            })}
          </div>
        ))}
      </div>

      {/* Légende */}
      <div style={{ display: "flex", alignItems: "center", gap: 10, marginTop: 8, flexWrap: "wrap" }}>
        <div style={{ display: "flex", alignItems: "center", gap: 4 }}>
          <span style={{ fontSize: 9, color: "var(--text-600)" }}>En retard :</span>
          {["#fde0e0","#f4a0a0","#e85555","#c22020","#8b0000"].map((c) => <div key={c} style={{ width: 12, height: 12, borderRadius: 2, background: c }} />)}
        </div>
        <div style={{ display: "flex", alignItems: "center", gap: 4 }}>
          <span style={{ fontSize: 9, color: "var(--text-600)" }}>À venir :</span>
          {["#d4f0e4","#7dd3b0","#22B07D","#1a8a61","#0f5c40"].map((c) => <div key={c} style={{ width: 12, height: 12, borderRadius: 2, background: c }} />)}
        </div>
      </div>

      </div>{/* lp-heatmap-top */}

      <div className="lp-heatmap-bottom">
        {selectedDay ? (
          <DayDetailPanel day={selectedDay} tasks={tasksForDay(selectedDay)} ctx={ctx} onOpen={onOpen} onClose={() => setSelectedDay(null)} />
        ) : (
          <div style={{ height: "100%", display: "flex", alignItems: "center", justifyContent: "center", color: "var(--text-600)", fontSize: 13, background: "var(--paper-soft)", borderRadius: 14, border: "1px dashed var(--border)" }}>
            Clique sur un jour de la grille pour voir ses tâches
          </div>
        )}
      </div>
    </div>
  );
}

function DayDetailPanel({ day, tasks, ctx, onOpen, onClose }) {
  const prev = addDays(day, -1);
  const next = addDays(day, 1);

  const allRelatedTasks = useMemo(() => {
    const seen = new Set();
    const all = [...tasks.ending, ...tasks.ongoing];
    return all.filter((t) => { if (seen.has(t.id)) return false; seen.add(t.id); return true; });
  }, [tasks]);

  return (
    <div className="lp-day-detail">
      <div className="lp-day-detail-header">
        <span style={{ fontWeight: 700, fontSize: 14 }}>Calendrier du {fmtShort(day)}</span>
        <button className="lp-icon-btn" onClick={onClose}><X size={16} /></button>
      </div>
      <div className="lp-day-cols-wrap">
      <div className="lp-day-cols">
        <DayColSimple d={prev} label="Veille" isMain={false} allRelatedTasks={allRelatedTasks} ctx={ctx} onOpen={onOpen} />
        <DayColSimple d={day} label="Jour J" isMain={true} allRelatedTasks={allRelatedTasks} ctx={ctx} onOpen={onOpen} />
        <DayColSimple d={next} label="Lendemain" isMain={false} allRelatedTasks={allRelatedTasks} ctx={ctx} onOpen={onOpen} />
      </div>
      </div>{/* lp-day-cols-wrap */}
    </div>
  );
}

function DayColSimple({ d, label, isMain, allRelatedTasks, ctx, onOpen }) {
  const ending = allRelatedTasks.filter((t) => t.end === d);
  const ongoing = allRelatedTasks.filter((t) => t.start < d && t.end > d);
  const [ongoingOpen, setOngoingOpen] = useState(false);
  return (
    <div className={"lp-day-col" + (isMain ? " main" : "")}>
      <div className="lp-day-col-header">
        <span className="lp-day-col-date">{fmtShort(d)}</span>
        <span className="lp-day-col-label">{label}</span>
      </div>
      {ending.length === 0 && ongoing.length === 0 && <div style={{ fontSize: 12, color: "var(--text-600)", padding: "12px 0" }}>Aucune tâche</div>}
      {ending.length > 0 && (
        <div className="lp-day-section">
          <div className="lp-day-section-title">Se termine</div>
          {ending.map((t) => <DayTaskCard key={t.id} task={t} ctx={ctx} onOpen={onOpen} variant="ending" />)}
        </div>
      )}
      {ongoing.length > 0 && (
        <div className="lp-day-section">
          <button className="lp-day-section-toggle" onClick={() => setOngoingOpen((o) => !o)}>
            <span className="lp-day-section-title" style={{ margin: 0 }}>⏳ En cours ({ongoing.length})</span>
            {ongoingOpen ? <ChevronUp size={14} /> : <ChevronDown size={14} />}
          </button>
          {ongoingOpen && ongoing.map((t) => <DayTaskCard key={t.id} task={t} ctx={ctx} onOpen={onOpen} variant="ongoing" />)}
        </div>
      )}
    </div>
  );
}

function DayTaskCard({ task, ctx, onOpen, variant }) {
  const proj = ctx.projects.find((p) => p.id === task.projectId);
  const st = ctx.statuses.find((s) => s.id === task.statusId);
  const done = isTaskDoneGlobal(task, ctx);
  return (
    <div className={"lp-day-task-card lp-day-task-" + variant + (done ? " done" : "")} onClick={() => onOpen(task)}>
      {proj && <span className="lp-project-dot" style={{ background: proj.color, width: 12, height: 12, fontSize: 7, flex: "0 0 auto" }}><IconGlyph icon={proj.icon} size={7} /></span>}
      {task.milestone && <MilestoneGlyph size={10} icon={resolveMilestoneIcon(task, ctx)} />}
      <span className="lp-day-task-title">{task.title}</span>
      {st && <span className="lp-chip" style={{ background: st.color + "22", color: st.color, fontSize: 9, padding: "1px 5px", flex: "0 0 auto" }}>{st.name}</span>}
      {done && <CheckCircle2 size={11} color="var(--success)" style={{ flex: "0 0 auto" }} />}
      <span style={{ fontSize: 10, color: "var(--text-600)", flex: "0 0 auto" }}>{task.progress}%</span>
      <div className="lp-day-task-bar">
        <div className="lp-day-task-bar-fill" style={{ width: `${task.progress}%`, background: variant === "ending" ? "var(--warning)" : "var(--border-strong)" }} />
      </div>
    </div>
  );
}

// ============================================================================
// Vue Calendrier — hebdomadaire (cartes détaillées) ou mensuelle (grille)
// ============================================================================
const CAL_FIELD_OPTIONS = ["project", "status", "assignee", "progress", "start", "end", "period", "checklist"];
const CAL_MONTHS_FR = ["Janvier", "Février", "Mars", "Avril", "Mai", "Juin", "Juillet", "Août", "Septembre", "Octobre", "Novembre", "Décembre"];
const CAL_DAY_NAMES = ["Lun", "Mar", "Mer", "Jeu", "Ven", "Sam", "Dim"];

function tasksActiveOnDay(tasks, dateStr) {
  return tasks.filter((t) => t.start <= dateStr && t.end >= dateStr);
}

function CalTaskCard({ task, ctx, cardFields, gradient, onOpen, compact }) {
  const proj = ctx.projects.find((p) => p.id === task.projectId);
  const done = isTaskDoneGlobal(task, ctx);
  const isStart = task.start === task.end ? null : "range";
  return (
    <div className={"lp-cal-card" + (done ? " done" : "")} style={{ borderLeftColor: proj?.color || "var(--text-muted)" }} onClick={() => onOpen(task)}>
      <div className="lp-cal-card-head">
        <span className="lp-project-dot" style={{ background: proj?.color || "var(--text-muted)", width: 15, height: 15, fontSize: 8, flex: "0 0 auto" }}><IconGlyph icon={proj?.icon} size={9} /></span>
        {task.milestone && <MilestoneGlyph size={13} icon={resolveMilestoneIcon(task, ctx)} />}
        <span className="lp-cal-card-title">{task.title}</span>
        {done && <CheckCircle2 size={14} color="var(--success)" style={{ flex: "0 0 auto" }} />}
      </div>
      {!compact && cardFields.length > 0 && (
        <div className="lp-cal-card-fields">
          {cardFields.map((f) => <FieldValue key={f} fieldKey={f} task={task} ctx={ctx} gradient={gradient} />)}
        </div>
      )}
    </div>
  );
}

function CalendarView({ tasks, ctx, onOpen, onAdd, gradient, prefs, setPrefs }) {
  const today = iso(new Date());
  const mode = prefs.mode || "week";
  const setMode = (m) => setPrefs({ mode: m });
  const cardFields = prefs.cardFields || ["project", "status", "assignee", "progress"];
  const setCardFields = (updater) => setPrefs((p) => ({ cardFields: typeof updater === "function" ? updater(p.cardFields || []) : updater }));
  const [anchor, setAnchor] = useState(today);
  const [selectedDay, setSelectedDay] = useState(null);

  const weekDays = useMemo(() => {
    const monday = getMonday(anchor);
    return Array.from({ length: 7 }, (_, i) => addDays(monday, i));
  }, [anchor]);

  const monthGrid = useMemo(() => {
    const d = new Date(anchor + "T00:00:00");
    const firstOfMonth = iso(new Date(d.getFullYear(), d.getMonth(), 1));
    const monday = getMonday(firstOfMonth);
    return Array.from({ length: 42 }, (_, i) => addDays(monday, i));
  }, [anchor]);

  const curMonthIdx = new Date(anchor + "T00:00:00").getMonth();

  const goPrev = () => {
    if (mode === "week") { setAnchor((a) => addDays(a, -7)); return; }
    const d = new Date(anchor + "T00:00:00"); d.setMonth(d.getMonth() - 1); setAnchor(iso(d));
  };
  const goNext = () => {
    if (mode === "week") { setAnchor((a) => addDays(a, 7)); return; }
    const d = new Date(anchor + "T00:00:00"); d.setMonth(d.getMonth() + 1); setAnchor(iso(d));
  };
  const goToday = () => { setAnchor(today); setSelectedDay(null); };

  const weekLabel = () => {
    const start = weekDays[0], end = weekDays[6];
    const sd = new Date(start + "T00:00:00"), ed = new Date(end + "T00:00:00");
    if (sd.getMonth() === ed.getMonth()) return `${sd.getDate()} – ${ed.getDate()} ${CAL_MONTHS_FR[sd.getMonth()]} ${sd.getFullYear()}`;
    return `${sd.getDate()} ${CAL_MONTHS_FR[sd.getMonth()]} – ${ed.getDate()} ${CAL_MONTHS_FR[ed.getMonth()]} ${sd.getFullYear()}`;
  };

  const tasksForDayObj = (day) => ({
    ending: tasks.filter((t) => t.end === day),
    ongoing: tasks.filter((t) => t.start < day && t.end > day),
  });

  return (
    <div className="lp-cal-wrap">
      <div className="lp-toolbar" style={{ marginBottom: 10 }}>
        <div className="lp-mode-toggle">
          <button className={mode !== "month" ? "active" : ""} onClick={() => setMode("week")}>Hebdomadaire</button>
          <button className={mode === "month" ? "active" : ""} onClick={() => setMode("month")}>Mensuel</button>
        </div>
        <button className="lp-tool-btn" onClick={goPrev}>‹</button>
        <button className="lp-tool-btn" onClick={goToday}><Crosshair size={13} /> Aujourd'hui</button>
        <button className="lp-tool-btn" onClick={goNext}>›</button>
        <span style={{ fontWeight: 700, fontSize: 14, marginLeft: 4 }}>
          {mode === "week" ? weekLabel() : `${CAL_MONTHS_FR[curMonthIdx]} ${new Date(anchor + "T00:00:00").getFullYear()}`}
        </span>
        {mode === "week" && (
          <DropdownButton label="Colonnes des cartes" icon={<Columns3 size={14} />}>
            {CAL_FIELD_OPTIONS.map((f) => (
              <label className="lp-checkbox-line" key={f}>
                <input type="checkbox" checked={cardFields.includes(f)} onChange={() => setCardFields((prev) => prev.includes(f) ? prev.filter((x) => x !== f) : [...prev, f])} />
                {fieldLabel(f)}
              </label>
            ))}
          </DropdownButton>
        )}
      </div>

      {mode === "week" ? (
        <div className="lp-cal-week-grid">
          {weekDays.map((day) => {
            const dayTasks = tasksActiveOnDay(tasks, day);
            const isToday = day === today;
            const dt = new Date(day + "T00:00:00");
            return (
              <div key={day} className={"lp-cal-day-col" + (isToday ? " today" : "")}>
                <div className="lp-cal-day-header">
                  <span className="lp-cal-day-name">{CAL_DAY_NAMES[(dt.getDay() + 6) % 7]}</span>
                  <span className="lp-cal-day-num">{dt.getDate()}</span>
                  <button className="lp-cal-day-add" onClick={() => onAdd({ start: day, end: day })} title="Ajouter une tâche ce jour"><Plus size={13} /></button>
                </div>
                <div className="lp-cal-day-body">
                  {dayTasks.length === 0 && <div className="lp-cal-empty">Aucune tâche</div>}
                  {dayTasks.map((t) => <CalTaskCard key={t.id} task={t} ctx={ctx} cardFields={cardFields} gradient={gradient} onOpen={onOpen} />)}
                </div>
              </div>
            );
          })}
        </div>
      ) : (
        <div className="lp-cal-month-layout">
          <div className="lp-cal-month-left">
            <div className="lp-cal-month-daynames">
              {CAL_DAY_NAMES.map((d) => <div key={d}>{d}</div>)}
            </div>
            <div className="lp-cal-month-grid">
              {monthGrid.map((day) => {
                const dt = new Date(day + "T00:00:00");
                const inMonth = dt.getMonth() === curMonthIdx;
                const dayTasks = tasksActiveOnDay(tasks, day);
                const isToday = day === today;
                const isSelected = day === selectedDay;
                const projColors = [...new Set(dayTasks.map((t) => ctx.projects.find((p) => p.id === t.projectId)?.color).filter(Boolean))];
                return (
                  <div
                    key={day}
                    className={"lp-cal-month-cell" + (inMonth ? "" : " other-month") + (isToday ? " today" : "") + (isSelected ? " selected" : "")}
                    onClick={() => setSelectedDay(isSelected ? null : day)}
                  >
                    <div className="lp-cal-month-cell-head">
                      <span className="lp-cal-month-cell-num">{dt.getDate()}</span>
                      {dayTasks.length > 0 && <span className="lp-cal-month-cell-count">{dayTasks.length}</span>}
                    </div>
                    <div className="lp-cal-month-dots">
                      {projColors.slice(0, 6).map((c, i) => <span key={i} className="lp-cal-month-dot" style={{ background: c }} />)}
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
          <div className="lp-cal-day-list">
            <div className="lp-cal-day-list-header">
              <span style={{ fontWeight: 700, fontSize: 14 }}>{selectedDay ? `Tâches du ${fmtShort(selectedDay)}` : "Sélectionne un jour"}</span>
              {selectedDay && <button className="lp-icon-btn" onClick={() => setSelectedDay(null)}><X size={16} /></button>}
            </div>
            <div className="lp-cal-day-list-body">
              {!selectedDay && <div className="lp-cal-empty">Clique sur un jour du calendrier pour voir ses tâches</div>}
              {selectedDay && tasksActiveOnDay(tasks, selectedDay).length === 0 && <div className="lp-cal-empty">Aucune tâche ce jour</div>}
              {selectedDay && tasksActiveOnDay(tasks, selectedDay).map((t) => (
                <CalTaskCard key={t.id} task={t} ctx={ctx} cardFields={["project", "status", "assignee", "start", "end", "progress"]} gradient={gradient} onOpen={onOpen} />
              ))}
            </div>
          </div>
        </div>
      )}
    </div>
  );
}

// ============================================================================
// Vue Timeline — roadmap horizontal avec bulles alternées anti-chevauchement
// ============================================================================
const TIMELINE_CARD_FIELD_OPTIONS = ["project", "status", "assignee", "progress", "period"];
const TIMELINE_BUBBLE_W = 310;
const TIMELINE_BUBBLE_H = 76; // compactée au maximum : date+titre sur la même ligne, méta sur 2 lignes max
const TIMELINE_ROW_STEP = TIMELINE_BUBBLE_H + 22; // hauteur de bulle + marge de sécurité entre rangées empilées

function TimelineView({ tasks, ctx, onOpen, prefs, setPrefs, gradient, progressColorByStatus, setTasks, onAdd, onDelete, onMarkDone, onCycleStatus, onBulkDelete, listPrefs, setListPrefs, toolbarSlot, embedded }) {
  const timelineCollapsed = !!prefs.timelineCollapsed;
  const listSectionCollapsed = !!prefs.listSectionCollapsed;
  // À l'ouverture de la page, on repart toujours en zoom automatique (plage
  // calculée sur les tâches), même si une plage manuelle avait été choisie avant.
  useEffect(() => { setPrefs({ minDate: null, maxDate: null }); }, []);
  const dated = useMemo(() => tasks.filter((t) => t.start && t.end), [tasks]);
  const autoMin = useMemo(() => (dated.length ? dated.reduce((m, t) => (t.end < m ? t.end : m), dated[0].end) : iso(new Date())), [dated]);
  const autoMax = useMemo(() => (dated.length ? dated.reduce((m, t) => (t.end > m ? t.end : m), dated[0].end) : addDays(iso(new Date()), 60)), [dated]);
  const minDate = prefs.minDate || autoMin;
  const maxDate = prefs.maxDate || autoMax;

  const originIdx = dayIndex(minDate);
  const totalDays = Math.max(1, dayIndex(maxDate) - originIdx);

  // La largeur d'un jour est calculée dynamiquement pour que l'axe occupe TOUJOURS
  // toute la largeur réellement disponible, quelle que soit la plage choisie — le
  // zoom ne contrôle plus que la granularité des repères (jour/semaine/mois...).
  const scrollRef = useRef(null);
  const [containerW, setContainerW] = useState(1000);
  useEffect(() => {
    const measure = () => { if (scrollRef.current) setContainerW(scrollRef.current.clientWidth - 40); };
    measure();
    window.addEventListener("resize", measure);
    return () => window.removeEventListener("resize", measure);
  }, []);
  const dayWidth = Math.max((containerW - TIMELINE_BUBBLE_W) / totalDays, 3);
  const timelineWidth = containerW; // l'axe occupe toujours toute la largeur mesurée
  const AXIS_MARGIN = TIMELINE_BUBBLE_W / 2;
  const xFor = (d) => AXIS_MARGIN + (dayIndex(d) - originIdx) * dayWidth;

  const visible = useMemo(
    () => dated.filter((t) => t.end >= minDate && t.end <= maxDate).sort((a, b) => dayIndex(a.end) - dayIndex(b.end)),
    [dated, minDate, maxDate]
  );

  // Anti-chevauchement : alternance haut/bas + empilement ("shelf packing") avec
  // une marge de sécurité généreuse, calculée sur les vrais bords gauche/droite
  // de chaque bulle (et non son centre) pour garantir zéro chevauchement réel.
  const { above, below, maxRowAbove, maxRowBelow } = useMemo(() => {
    const HALF_W = TIMELINE_BUBBLE_W / 2;
    const GAP = 44;
    const rowsAbove = [];
    const rowsBelow = [];
    const above = [];
    const below = [];
    visible.forEach((t, i) => {
      const x = xFor(t.end);
      const left = x - HALF_W;
      const right = x + HALF_W;
      const side = i % 2 === 0 ? "above" : "below";
      const rows = side === "above" ? rowsAbove : rowsBelow;
      let row = 0;
      while (rows[row] !== undefined && left < rows[row] + GAP) row++;
      rows[row] = right;
      (side === "above" ? above : below).push({ task: t, x, row });
    });
    return { above, below, maxRowAbove: rowsAbove.length, maxRowBelow: rowsBelow.length };
  }, [visible, dayWidth, originIdx]);

  // Graduation adaptative : choisit automatiquement l'unité la plus fine qui reste
  // lisible (espacement minimal entre repères) — garantit qu'il y a TOUJOURS des
  // repères visibles sur toute la largeur, quelle que soit la plage ou le zoom.
  const MIN_TICK_PX = 64;
  const tickUnit = useMemo(() => {
    const candidates = [["day", 1], ["week", 7], ["month", 30.4], ["quarter", 91.3], ["year", 365]];
    for (const [unit, avgDays] of candidates) {
      if (avgDays * dayWidth >= MIN_TICK_PX) return unit;
    }
    return "year";
  }, [dayWidth]);
  const ticks = useMemo(() => {
    const arr = [];
    let cur = unitStart(minDate, tickUnit);
    let guard = 0;
    while (dayIndex(cur) <= dayIndex(maxDate) && guard < 2000) {
      arr.push({ start: cur, label: unitLabel(cur, tickUnit) });
      cur = addDays(cur, unitLen(cur, tickUnit));
      guard++;
    }
    return arr;
  }, [minDate, maxDate, tickUnit]);

  // Repère de contexte (mois/année) au-dessus des graduations fines, pour toujours
  // savoir "où on est" même quand l'unité fine ne suffit pas à lever l'ambiguïté
  // (ex. des numéros de jour seuls ne disent pas de quel mois il s'agit).
  const topUnit = { day: "month", week: "month", month: "year", quarter: "year", year: null }[tickUnit];
  const topTicks = useMemo(() => {
    if (!topUnit) return [];
    const arr = [];
    let cur = unitStart(minDate, topUnit);
    let guard = 0;
    while (dayIndex(cur) <= dayIndex(maxDate) && guard < 300) {
      arr.push({ start: cur, label: topLabelFor(cur, topUnit) });
      cur = addDays(cur, unitLen(cur, topUnit));
      guard++;
    }
    return arr;
  }, [minDate, maxDate, topUnit]);

  const topPad = Math.max(1, maxRowAbove) * TIMELINE_ROW_STEP + 40;
  const bottomPad = Math.max(1, maxRowBelow) * TIMELINE_ROW_STEP + 40;

  const cardFields = prefs.cardFields || ["project", "status"];
  const setCardFields = (updater) => setPrefs((p) => ({ cardFields: typeof updater === "function" ? updater(p.cardFields || []) : updater }));
  const colorBy = prefs.colorBy || "project";

  const TimelineBubble = ({ item, side }) => {
    const { task: t, x, row } = item;
    const proj = ctx.projects.find((p) => p.id === t.projectId);
    const st = ctx.statuses.find((s) => s.id === t.statusId);
    const color = colorBy === "status" ? (st?.color || "var(--text-muted)") : (proj?.color || "var(--text-muted)");
    const dist = 46 + row * TIMELINE_ROW_STEP;
    const bubbleTop = side === "above" ? -dist - TIMELINE_BUBBLE_H : dist;
    const lineTop = side === "above" ? -dist : 0;
    const lineHeight = dist;
    const done = isTaskDoneGlobal(t, ctx);
    const urgent = isTaskUrgent(t, ctx);
    const hatch = urgent
      ? "repeating-linear-gradient(45deg, rgba(214,69,69,0.06) 0 6px, rgba(214,69,69,0.13) 6px 12px)"
      : done
      ? "repeating-linear-gradient(45deg, rgba(34,176,125,0.06) 0 6px, rgba(34,176,125,0.13) 6px 12px)"
      : undefined;
    // Remplissage de fond très subtil, proportionnel à l'avancement, dans la couleur du projet/statut
    // — une tâche terminée est toujours à 100%, même si le champ "progress" n'a pas été mis à jour.
    const progressPct = done ? 100 : Math.max(0, Math.min(100, t.progress || 0));
    const progressDragRef = useRef(null);
    const setProgressFromClientX = (rect, clientX) => {
      const pct = Math.max(0, Math.min(100, Math.round(((clientX - rect.left) / rect.width) * 100)));
      setTasks((prev) => prev.map((task) => (task.id === t.id ? { ...task, progress: pct } : task)));
    };
    const startProgressDrag = (e) => {
      if (t.milestone) return; // pas d'avancement pour un jalon
      e.stopPropagation();
      e.preventDefault();
      const rect = e.currentTarget.getBoundingClientRect();
      progressDragRef.current = { rect, moved: false, startX: e.clientX };
      setProgressFromClientX(rect, e.clientX);
      const onMove = (ev) => {
        if (Math.abs(ev.clientX - progressDragRef.current.startX) > 2) progressDragRef.current.moved = true;
        setProgressFromClientX(progressDragRef.current.rect, ev.clientX);
      };
      const onUp = () => {
        window.removeEventListener("mousemove", onMove);
        window.removeEventListener("mouseup", onUp);
      };
      window.addEventListener("mousemove", onMove);
      window.addEventListener("mouseup", onUp);
    };
    return (
      <React.Fragment>
        <div className="lp-tl-connector" style={{ left: x, top: side === "above" ? lineTop : 0, height: lineHeight, background: color }} />
        <div className="lp-tl-dot" style={{ left: x, background: color }} title={fmtShort(t.end)} />
        <div
          className="lp-tl-bubble"
          style={{ left: Math.max(0, x - TIMELINE_BUBBLE_W / 2), top: bubbleTop, width: TIMELINE_BUBBLE_W, borderColor: urgent ? "var(--danger)" : done ? "var(--success)" : color, backgroundImage: hatch }}
          onClick={() => { if (progressDragRef.current?.moved) { progressDragRef.current = null; return; } onOpen(t); }}
        >
          <div className="lp-tl-bubble-progress-fill" style={{ width: t.milestone ? "100%" : `${progressPct}%`, background: color }} />
          {!t.milestone && (
            <div className="lp-tl-bubble-progress-track" title="Glisser pour ajuster l'avancement" onMouseDown={startProgressDrag} />
          )}
          <div className="lp-tl-bubble-head">
            <div className="lp-tl-bubble-date" style={{ background: color }}>{fmtShort(t.end)}</div>
            <div className="lp-tl-bubble-title">
              {t.milestone && <MilestoneGlyph size={11} icon={resolveMilestoneIcon(t, ctx)} />} {t.title}
            </div>
          </div>
          <div className="lp-tl-bubble-meta">
            {cardFields.includes("project") && proj && <span className="lp-chip" style={{ background: color + "22", color }}><IconGlyph icon={proj.icon} size={10} /> {proj.name}</span>}
            {cardFields.includes("status") && st && <span className="lp-chip" style={{ background: st.color + "22", color: st.color }}>{st.name}</span>}
            {cardFields.includes("assignee") && t.assignee && <span className="lp-chip">👤 {t.assignee}</span>}
            {cardFields.includes("progress") && <span className="lp-chip">{t.progress || 0}%</span>}
            {cardFields.includes("period") && <span className="lp-chip">{monthLabel(periodOf(t.end))}</span>}
            {t.dependsOn && t.dependsOn.length > 0 && <span className="lp-dep-badge" title={`Dépend de ${t.dependsOn.length} tâche${t.dependsOn.length > 1 ? "s" : ""}`}><GripVertical size={10} />{t.dependsOn.length}</span>}
          </div>
        </div>
      </React.Fragment>
    );
  };

  const rangeLabel = (() => {
    const sd = new Date(minDate + "T00:00:00"), ed = new Date(maxDate + "T00:00:00");
    const fmt = (d) => `${d.getDate()} ${monthLabel(iso(d)).split(" ")[0]} ${d.getFullYear()}`;
    return `${fmt(sd)} → ${fmt(ed)}`;
  })();

  return (
    <div className="lp-tl-wrap">
      {/* ==================== Grande section : TIMELINE ==================== */}
      <div className="lp-big-section-head" onClick={() => setPrefs({ timelineCollapsed: !timelineCollapsed })}>
        {timelineCollapsed ? <ChevronRight size={17} /> : <ChevronDown size={17} />}
        <h3 style={{ margin: 0, fontSize: 17, fontWeight: 800 }}>Timeline</h3>
        <span style={{ fontSize: 12.5, color: "var(--text-600)", fontWeight: 600 }}>{rangeLabel}</span>
      </div>

      {!timelineCollapsed && (
        <>
          <ViewToolbarPortal slot={toolbarSlot}>
            <button className="lp-tool-btn" onClick={() => setPrefs({ minDate: autoMin, maxDate: autoMax })} title="Zoom automatique : cale la plage exactement sur la première et la dernière tâche">
              <Maximize2 size={14} />
            </button>
            <div className="lp-field" style={{ marginBottom: 0 }}>
              <input type="date" value={minDate} onChange={(e) => setPrefs({ minDate: e.target.value || null })} title="Date minimale affichée (laisse vide pour un calcul automatique)" />
            </div>
            <span style={{ color: "var(--text-600)", fontSize: 12 }}>→</span>
            <div className="lp-field" style={{ marginBottom: 0 }}>
              <input type="date" value={maxDate} onChange={(e) => setPrefs({ maxDate: e.target.value || null })} title="Date maximale affichée (laisse vide pour un calcul automatique)" />
            </div>
            {(prefs.minDate || prefs.maxDate) && (
              <button className="lp-tool-btn" onClick={() => setPrefs({ minDate: null, maxDate: null })} title="Réinitialiser la plage"><Eraser size={14} /></button>
            )}
            <DropdownButton label="" icon={<Columns3 size={14} />} title="Champs de la carte">
              {TIMELINE_CARD_FIELD_OPTIONS.map((f) => (
                <label className="lp-checkbox-line" key={f}>
                  <input type="checkbox" checked={cardFields.includes(f)} onChange={() => setCardFields((prev) => (prev.includes(f) ? prev.filter((x) => x !== f) : [...prev, f]))} />
                  {fieldLabel(f)}
                </label>
              ))}
            </DropdownButton>
            <DropdownButton label="" icon={<Palette size={14} />} title={`Couleur : ${colorBy === "status" ? "Statut" : "Projet"}`}>
              <label className="lp-checkbox-line"><input type="radio" name="lp-tl-color" checked={colorBy === "project"} onChange={() => setPrefs({ colorBy: "project" })} /> Par projet</label>
              <label className="lp-checkbox-line"><input type="radio" name="lp-tl-color" checked={colorBy === "status"} onChange={() => setPrefs({ colorBy: "status" })} /> Par statut</label>
            </DropdownButton>
          </ViewToolbarPortal>

          {topUnit && (
            <div className="lp-tl-top-header">
              {topTicks.map((tk, i) => (
                <div key={i} className="lp-tl-top-seg" style={{ left: xFor(tk.start) }}>{tk.label}</div>
              ))}
            </div>
          )}
          <div className="lp-tl-scroll" ref={scrollRef}>
            <div className="lp-tl-canvas" style={{ width: "100%", minWidth: timelineWidth, paddingTop: topPad, paddingBottom: bottomPad }}>
              <div className="lp-tl-guides" style={{ top: 0, bottom: 0 }}>
                {ticks.map((tk, i) => <div key={i} className="lp-tl-guide" style={{ left: xFor(tk.start) }} />)}
              </div>
              <div className="lp-tl-axis" style={{ width: "100%", minWidth: timelineWidth }}>
                {ticks.map((tk, i) => (
                  <div key={i} className="lp-tl-tick" style={{ left: xFor(tk.start) }}>
                    <div className="lp-tl-tick-mark" />
                    <div className="lp-tl-tick-label">{tk.label}</div>
                  </div>
                ))}
                {dayIndex(iso(new Date())) >= originIdx && dayIndex(iso(new Date())) <= originIdx + totalDays && (
                  <div className="lp-tl-today-wrap" style={{ left: xFor(iso(new Date())) }} title="Aujourd'hui">
                    <div className="lp-tl-today-badge"><Check size={11} color="#fff" strokeWidth={3.5} /></div>
                    <div className="lp-tl-today-line" />
                  </div>
                )}
                {/* Lien visuel entre un jalon et ses tâches prédécesseurs (dépendances) —
                    tracé le long de l'axe, entre les deux points de la timeline, pour
                    rendre visible d'un coup d'œil ce qui doit être terminé pour
                    atteindre le jalon. */}
                {visible.filter((t) => t.milestone && t.dependsOn && t.dependsOn.length > 0).flatMap((ms) =>
                  ms.dependsOn.map((depId) => {
                    const dep = dated.find((t) => t.id === depId);
                    if (!dep) return null;
                    const msX = xFor(ms.end), depX = xFor(dep.end);
                    const left = Math.min(msX, depX), width = Math.max(2, Math.abs(msX - depX));
                    return <div key={ms.id + "-" + depId} className="lp-tl-dep-link" style={{ left, width }} title={`${dep.title} → ${ms.title}`} />;
                  })
                )}
                {above.map((item) => <TimelineBubble key={item.task.id} item={item} side="above" />)}
                {below.map((item) => <TimelineBubble key={item.task.id} item={item} side="below" />)}
              </div>
            </div>
          </div>
        </>
      )}

      <hr className="lp-divider" style={{ margin: "22px 0" }} />

      {/* ==================== Grande section : LISTE ==================== */}
      <div className="lp-big-section-head" onClick={() => setPrefs({ listSectionCollapsed: !listSectionCollapsed })}>
        {listSectionCollapsed ? <ChevronRight size={17} /> : <ChevronDown size={17} />}
        <h3 style={{ margin: 0, fontSize: 17, fontWeight: 800 }}>Liste</h3>
        <span style={{ fontSize: 12.5, color: "var(--text-600)", fontWeight: 600 }}>{tasks.length} tâche{tasks.length > 1 ? "s" : ""}</span>
      </div>

      {!listSectionCollapsed && (
        <ListView
          tasks={tasks}
          ctx={ctx}
          gradient={gradient}
          progressColorByStatus={progressColorByStatus}
          setTasks={setTasks}
          onOpen={onOpen}
          onAdd={onAdd}
          onDelete={onDelete}
          onMarkDone={onMarkDone}
          onCycleStatus={onCycleStatus}
          onBulkDelete={onBulkDelete}
          prefs={listPrefs}
          setPrefs={setListPrefs}
          toolbarSlot={toolbarSlot}
          embedded={embedded}
        />
      )}
    </div>
  );
}

// ============================================================================
// Vue Radar — calendrier radial annuel, inspiré des roadmaps circulaires
// ============================================================================
const RADAR_TOOLTIP_FIELDS = [
  { key: "project", label: "Projet" },
  { key: "status", label: "Statut" },
  { key: "dates", label: "Dates" },
  { key: "progress", label: "Avancement" },
  { key: "assignee", label: "Responsable" },
  { key: "checklist", label: "Sous-tâches" },
];

function RadarView({ tasks, ctx, onOpen, appearance, prefs, setPrefs, toolbarSlot, embedded }) {
  const year = prefs.year || new Date().getFullYear();
  const colorBy = prefs.colorBy || "project";
  const tooltipFields = prefs.tooltipFields || ["project", "status", "dates", "progress", "assignee", "checklist"];
  const showAllInfo = !!prefs.showAllInfo;
  const fullscreen = !!prefs.fullscreen;
  const [hover, setHover] = useState(null); // { task, x, y } — survol simple (mode normal)

  // Plage de dates personnalisée (facultative) : quand les deux bornes sont
  // renseignées, le radar devient un SECTEUR (demi-cercle) plutôt qu'un cercle
  // complet — date minimale à gauche, date maximale à droite, en passant par le
  // haut. Ça permet de "zoomer" sur une période précise. Sans les deux dates,
  // comportement inchangé : cercle complet sur l'année choisie.
  const rangeStart = prefs.rangeStart || "";
  const rangeEnd = prefs.rangeEnd || "";
  const hasRange = !!(rangeStart && rangeEnd && rangeStart < rangeEnd);

  const yearStart = `${year}-01-01`;
  const yearEnd = `${year}-12-31`;
  const effStart = hasRange ? rangeStart : yearStart;
  const effEnd = hasRange ? rangeEnd : yearEnd;

  const dated = useMemo(() => tasks.filter((t) => t.start && t.end), [tasks]);
  const yearTasks = useMemo(
    () => dated.filter((t) => t.end >= effStart && t.start <= effEnd).sort((a, b) => a.start.localeCompare(b.start)),
    [dated, effStart, effEnd]
  );
  const milestones = yearTasks.filter((t) => t.milestone);
  const regularTasks = yearTasks.filter((t) => !t.milestone);

  const SECTOR_SPAN = hasRange ? 180 : 360;
  const SECTOR_START = hasRange ? 270 : 0; // 270° = 9h (gauche) ; balaie par le haut (0°/12h) vers 90° (3h, droite)
  // Pas hebdomadaire en mode année complète ; interpolation linéaire jour par
  // jour sur le secteur en mode plage personnalisée (plus précis, utile pour
  // zoomer sur une période courte).
  const angleFor = (dateStr) => {
    const clamped = dateStr < effStart ? effStart : dateStr > effEnd ? effEnd : dateStr;
    if (hasRange) {
      const totalR = Math.max(1, dayIndex(effEnd) - dayIndex(effStart));
      const progress = (dayIndex(clamped) - dayIndex(effStart)) / totalR;
      return (SECTOR_START + progress * SECTOR_SPAN + 360) % 360;
    }
    const dayOfYear = dayIndex(clamped) - dayIndex(effStart);
    const week = Math.round(dayOfYear / 7);
    return Math.min(week, 52) * (360 / 52);
  };
  // Repères de dates pour le mode secteur — même logique adaptative (semaine/
  // mois/trimestre/année selon l'écart) que les autres widgets de l'app.
  const sectorTicks = useMemo(() => (hasRange ? widgetAxisTicks(effStart, effEnd) : []), [hasRange, effStart, effEnd]);

  const RING_START = 82;
  const RING_STEP = 22;
  const outerR = RING_START + Math.max(6, regularTasks.length) * RING_STEP;
  const weekRingR = outerR + 26;      // sous-cercle des semaines S1..S52
  const monthSpokeR = weekRingR + 30; // rayons + libellés des mois
  // La taille du SVG s'adapte au rayon réellement nécessaire (marge pour les
  // libellés de mois) — évite tout rognage du contenu quand il y a beaucoup de tâches.
  const SIZE = Math.max(980, (monthSpokeR + 50) * 2);
  const CENTER = SIZE / 2;

  // Taille de la carte persistante : dépend du nombre de colonnes affichées, pour
  // toujours faire tenir toutes les cartes dans l'afficheur.
  const cardRowCount = 1 + ["project", "status"].some((f) => tooltipFields.includes(f)) * 1
    + (tooltipFields.includes("dates") ? 1 : 0)
    + (tooltipFields.includes("progress") ? 1 : 0)
    + (tooltipFields.includes("assignee") ? 1 : 0)
    + (tooltipFields.includes("checklist") ? 1 : 0);
  const CARD_W = 128;
  const CARD_H = 32 + cardRowCount * 16;
  const cardFont = tooltipFields.length <= 2 ? 10 : tooltipFields.length <= 4 ? 9.3 : 8.6;

  const polar = (angleDeg, r) => {
    const rad = ((angleDeg - 90) * Math.PI) / 180;
    return { x: CENTER + r * Math.cos(rad), y: CENTER + r * Math.sin(rad) };
  };
  const arcPath = (a0, a1, r, forceMin = true) => {
    let start = a0, end = a1;
    if (forceMin && end - start < 3) end = start + 3; // arc minimal visible pour les tâches très courtes
    const p0 = polar(start, r), p1 = polar(end, r);
    const largeArc = end - start > 180 ? 1 : 0;
    return `M ${p0.x} ${p0.y} A ${r} ${r} 0 ${largeArc} 1 ${p1.x} ${p1.y}`;
  };

  const colorFor = (t) => {
    if (colorBy === "status") return ctx.statuses.find((s) => s.id === t.statusId)?.color || "var(--text-muted)";
    return ctx.projects.find((p) => p.id === t.projectId)?.color || "var(--text-muted)";
  };

  const today = iso(new Date());
  const showToday = today >= yearStart && today <= yearEnd;

  const showTooltip = (e, t) => { if (!showAllInfo) setHover({ task: t, x: e.clientX, y: e.clientY }); };
  const moveTooltip = (e) => setHover((h) => (h ? { ...h, x: e.clientX, y: e.clientY } : h));
  const hideTooltip = () => setHover(null);

  const setTooltipField = (key) => setPrefs((p) => {
    const cur = p.tooltipFields || tooltipFields;
    return { tooltipFields: cur.includes(key) ? cur.filter((x) => x !== key) : [...cur, key] };
  });

  // Origine (sur son propre anneau) de chaque tâche/jalon, pour les bulles persistantes
  const originFor = (t, idx) => {
    if (t.milestone) return { r: outerR + 6, a: angleFor(t.end) };
    const a0 = angleFor(t.start), a1 = angleFor(t.end);
    return { r: RING_START + idx * RING_STEP, a: (a0 + a1) / 2 };
  };

  // Placement des bulles persistantes au plus près de leur angle d'origine réel, en
  // ne les décalant que lorsqu'une collision avec la carte précédente l'impose —
  // minimise les croisements de traits par rapport à une répartition uniforme forcée.
  const persistentCards = useMemo(() => {
    if (!showAllInfo) return [];
    const items = [
      ...regularTasks.map((t, i) => ({ t, origin: originFor(t, i) })),
      ...milestones.map((t) => ({ t, origin: originFor(t, 0) })),
    ].sort((a, b) => a.origin.a - b.origin.a);
    const n = items.length;
    if (n === 0) return [];
    // On utilise tout le tour du cercle : chaque bulle occupe une part égale de la
    // circonférence (360°/n), dans l'ordre de leur angle d'origine (ce qui minimise
    // les croisements de traits). Le rayon est calculé pour garantir qu'à cette
    // circonférence, chaque bulle dispose d'assez de place pour ne JAMAIS chevaucher
    // sa voisine, quel que soit le nombre d'éléments.
    const GAP = 10;
    const cardDiagonal = Math.sqrt(CARD_W * CARD_W + CARD_H * CARD_H); // cas le plus défavorable, quel que soit l'angle
    const minCircumference = n * (cardDiagonal + GAP);
    const dynamicR = Math.max(monthSpokeR + 20, minCircumference / (2 * Math.PI));
    return items.map((it, i) => ({
      task: it.t,
      originPt: polar(it.origin.a, it.origin.r),
      cardPt: polar((i / n) * 360, dynamicR),
    }));
  }, [showAllInfo, regularTasks, milestones, year, CARD_W, CARD_H, monthSpokeR]);

  const TooltipBody = ({ t, compact }) => {
    const proj = ctx.projects.find((p) => p.id === t.projectId);
    const st = ctx.statuses.find((s) => s.id === t.statusId);
    return (
      <>
        <div className={compact ? "lp-radar-tooltip-title-sm" : "lp-radar-tooltip-title"}>{t.milestone && <MilestoneGlyph size={compact ? 9 : 12} icon={resolveMilestoneIcon(t, ctx)} />} {t.title}</div>
        {(tooltipFields.includes("project") || tooltipFields.includes("status")) && (
          <div className="lp-radar-tooltip-row">
            {tooltipFields.includes("project") && proj && <span className="lp-chip lp-radar-chip-sm" style={{ background: proj.color + "22", color: proj.color }}>{!compact && <IconGlyph icon={proj.icon} size={9} />} {proj.name}</span>}
            {tooltipFields.includes("status") && st && <span className="lp-chip lp-radar-chip-sm" style={{ background: st.color + "22", color: st.color }}>{st.name}</span>}
          </div>
        )}
        {tooltipFields.includes("dates") && (
          <div className="lp-radar-tooltip-row"><span className="lp-date-badge lp-radar-chip-sm">{fmtShort(t.start)}{!t.milestone ? ` → ${fmtShort(t.end)}` : ""}</span></div>
        )}
        {tooltipFields.includes("progress") && !t.milestone && (
          <div className="lp-radar-tooltip-row">
            <div className="lp-progress-track" style={{ flex: 1, height: 4 }}><div className="lp-progress-fill" style={{ width: `${t.progress || 0}%`, background: colorFor(t) }} /></div>
            <span style={{ fontSize: "0.9em", fontWeight: 700 }}>{t.progress || 0}%</span>
          </div>
        )}
        {tooltipFields.includes("assignee") && t.assignee && <div className="lp-radar-tooltip-row" style={{ color: "var(--text-600)" }}>👤 {t.assignee}</div>}
        {tooltipFields.includes("checklist") && (t.checklist || []).length > 0 && (
          <div className="lp-radar-tooltip-row" style={{ color: "var(--text-600)" }}>{t.checklist.filter((i) => i.done).length}/{t.checklist.length} sous-tâches</div>
        )}
      </>
    );
  };

  const [zoom, setZoom] = useState(1);
  const [pan, setPan] = useState({ x: 0, y: 0 });
  const canvasWrapRef = useRef(null);
  useEffect(() => {
    const el = canvasWrapRef.current;
    if (!el) return;
    const onWheel = (e) => {
      e.preventDefault();
      e.stopPropagation();
      setZoom((z) => Math.max(0.5, Math.min(3, z - e.deltaY * 0.0012)));
    };
    el.addEventListener("wheel", onWheel, { passive: false });
    return () => el.removeEventListener("wheel", onWheel);
  }, []);

  // Redimensionnement du panneau latéral — Pointer Events avec capture explicite :
  // garantit que le glissement continue de recevoir les événements même en cas de
  // mouvement rapide de la souris, contrairement à de simples écouteurs window.
  const [listWidth, setListWidth] = useState(prefs.listWidth || 560);
  useEffect(() => { setListWidth(prefs.listWidth || 560); }, [prefs.listWidth]);
  const [listCollapsed, setListCollapsed] = useState(!!prefs.listCollapsed);
  useEffect(() => { setListCollapsed(!!prefs.listCollapsed); }, [prefs.listCollapsed]);
  const toggleListCollapsed = () => { const next = !listCollapsed; setListCollapsed(next); setPrefs((p) => ({ ...p, listCollapsed: next })); };
  const resizingList = useRef(false);
  const resizeStartX = useRef(0);
  const resizeStartWidth = useRef(300);
  const startResize = (e) => {
    e.preventDefault();
    resizingList.current = true;
    resizeStartX.current = e.clientX;
    resizeStartWidth.current = listWidth;
    e.currentTarget.setPointerCapture(e.pointerId);
    document.body.style.cursor = "col-resize";
    document.body.style.userSelect = "none";
  };
  const moveResize = (e) => {
    if (!resizingList.current) return;
    const delta = e.clientX - resizeStartX.current;
    setListWidth(Math.max(220, Math.min(560, resizeStartWidth.current - delta)));
  };
  const endResize = (e) => {
    if (!resizingList.current) return;
    resizingList.current = false;
    try { e.currentTarget.releasePointerCapture(e.pointerId); } catch (err) {}
    document.body.style.cursor = "";
    document.body.style.userSelect = "";
  };
  // Sauvegarde la largeur finale avec un léger anti-rebond, une fois le glissement terminé
  useEffect(() => {
    if (resizingList.current) return;
    const t = setTimeout(() => setPrefs({ listWidth }), 400);
    return () => clearTimeout(t);
  }, [listWidth]);

  // Outil "main" : déplacement du radar en XY à la souris
  const panDragRef = useRef(null);
  const [isPanning, setIsPanning] = useState(false);
  const startPan = (e) => {
    if (e.button !== 0) return;
    panDragRef.current = { startX: e.clientX, startY: e.clientY, startPanX: pan.x, startPanY: pan.y };
    setIsPanning(true);
  };
  useEffect(() => {
    function onMove(e) {
      if (!panDragRef.current) return;
      const d = panDragRef.current;
      setPan({ x: d.startPanX + (e.clientX - d.startX), y: d.startPanY + (e.clientY - d.startY) });
    }
    function onUp() {
      if (!panDragRef.current) return;
      panDragRef.current = null;
      setIsPanning(false);
    }
    window.addEventListener("mousemove", onMove);
    window.addEventListener("mouseup", onUp);
    return () => { window.removeEventListener("mousemove", onMove); window.removeEventListener("mouseup", onUp); };
  }, []);
  const resetView = () => { setZoom(1); setPan({ x: 0, y: 0 }); };

  return (
    <div className={"lp-radar-wrap" + (fullscreen ? " lp-radar-fullscreen" : "")}>
      <ViewToolbarPortal slot={toolbarSlot}>
        <button className="lp-tool-btn" onClick={() => setPrefs({ year: year - 1 })}>‹</button>
        <span className="lp-radar-year-label">{year}</span>
        <button className="lp-tool-btn" onClick={() => setPrefs({ year: year + 1 })}>›</button>
        <button className="lp-tool-btn" onClick={() => setPrefs({ year: new Date().getFullYear() })} title="Année en cours"><Crosshair size={14} /></button>
        <DropdownButton label="" icon={<CalendarClock size={14} />} title={hasRange ? `Secteur : ${fmtShort(rangeStart)} → ${fmtShort(rangeEnd)}` : "Zoomer sur une plage de dates précise"}>
          <div className="lp-field" style={{ marginBottom: 8 }}>
            <label>Date de début</label>
            <input type="date" value={rangeStart} onChange={(e) => setPrefs({ rangeStart: e.target.value })} />
          </div>
          <div className="lp-field" style={{ marginBottom: 8 }}>
            <label>Date de fin</label>
            <input type="date" value={rangeEnd} onChange={(e) => setPrefs({ rangeEnd: e.target.value })} />
          </div>
          <p style={{ fontSize: 11.5, color: "var(--text-600)", margin: "0 0 8px" }}>Les deux dates transforment le radar en secteur (demi-cercle), zoomé sur cette période — date min à gauche, date max à droite. Laisse vide pour revenir à l'année complète.</p>
          {hasRange && <button type="button" className="lp-dropdown-action-row" onClick={() => setPrefs({ rangeStart: "", rangeEnd: "" })}><X size={13} /> Revenir à l'année complète</button>}
        </DropdownButton>
        <div className="lp-radar-zoom-group">
          <button className="lp-tool-btn" onClick={() => setZoom((z) => Math.max(0.5, z - 0.15))} title="Zoom arrière">–</button>
          <span className="lp-radar-zoom-value" onClick={() => setZoom(1)} title="Réinitialiser le zoom (ou molette sur le radar)">{Math.round(zoom * 100)}%</span>
          <button className="lp-tool-btn" onClick={() => setZoom((z) => Math.min(3, z + 0.15))} title="Zoom avant">+</button>
        </div>
        {!embedded && (
          <DropdownButton label="" icon={<Palette size={14} />} title={`Couleur : ${colorBy === "status" ? "Statut" : "Projet"}`}>
            <label className="lp-checkbox-line"><input type="radio" name="lp-radar-color" checked={colorBy === "project"} onChange={() => setPrefs({ colorBy: "project" })} /> Par projet</label>
            <label className="lp-checkbox-line"><input type="radio" name="lp-radar-color" checked={colorBy === "status"} onChange={() => setPrefs({ colorBy: "status" })} /> Par statut</label>
          </DropdownButton>
        )}
        {!embedded && (
          <DropdownButton label="" icon={<Columns3 size={14} />} title="Colonnes des infobulles">
            {RADAR_TOOLTIP_FIELDS.map((f) => (
              <label className="lp-checkbox-line" key={f.key}>
                <input type="checkbox" checked={tooltipFields.includes(f.key)} onChange={() => setTooltipField(f.key)} />
                {f.label}
              </label>
            ))}
          </DropdownButton>
        )}
        {!embedded && (
          <button className={"lp-tool-btn" + (showAllInfo ? " active" : "")} onClick={() => setPrefs({ showAllInfo: !showAllInfo })} title="Montrer toutes les infos">
            <BarChart3 size={14} />
          </button>
        )}
        {!embedded && (
          <button className={"lp-tool-btn" + (fullscreen ? " active" : "")} onClick={() => setPrefs({ fullscreen: !fullscreen })} title={fullscreen ? "Quitter le plein écran" : "Afficher en plein écran"}>
            <Maximize2 size={14} />
          </button>
        )}
        {!embedded && (
          <button className="lp-tool-btn" onClick={resetView} title="Remettre le zoom et la position à zéro">
            <RefreshCw size={14} />
          </button>
        )}
        {embedded && (
          <DropdownButton label="" icon={<MoreHorizontal size={14} />} title="Plus d'options">
            <div className="lp-dropdown-group-label">Couleur</div>
            <label className="lp-checkbox-line"><input type="radio" name="lp-radar-color-embed" checked={colorBy === "project"} onChange={() => setPrefs({ colorBy: "project" })} /> Par projet</label>
            <label className="lp-checkbox-line"><input type="radio" name="lp-radar-color-embed" checked={colorBy === "status"} onChange={() => setPrefs({ colorBy: "status" })} /> Par statut</label>
            <hr className="lp-divider" style={{ margin: "6px 0" }} />
            <label className="lp-checkbox-line"><input type="checkbox" checked={showAllInfo} onChange={() => setPrefs({ showAllInfo: !showAllInfo })} /> Montrer toutes les infos</label>
            <label className="lp-checkbox-line"><input type="checkbox" checked={fullscreen} onChange={() => setPrefs({ fullscreen: !fullscreen })} /> Plein écran</label>
            <hr className="lp-divider" style={{ margin: "6px 0" }} />
            <button type="button" className="lp-dropdown-action-row" onClick={resetView}><RefreshCw size={13} /> Réinitialiser le zoom</button>
          </DropdownButton>
        )}
      </ViewToolbarPortal>

      <div className="lp-radar-body">
        <div className="lp-radar-canvas-wrap" ref={canvasWrapRef}>
          <svg
            width={SIZE} height={SIZE} viewBox={`0 0 ${SIZE} ${SIZE}`}
            style={{ maxWidth: "100%", height: "auto", transform: `translate(${pan.x}px, ${pan.y}px) scale(${zoom})`, transformOrigin: "center center", transition: isPanning ? "none" : "transform .06s linear", cursor: isPanning ? "grabbing" : "grab" }}
            onMouseDown={startPan}
          >
            {!hasRange && (
              <>
                {/* Fond alterné par mois, pour bien distinguer les secteurs d'un coup d'œil — dérivé de la couleur d'accentuation choisie dans Apparence */}
                {CAL_MONTHS_FR.map((m, i) => {
                  if (i % 2 === 0) return null;
                  const a0 = i * 30, a1 = (i + 1) * 30;
                  const rOut = weekRingR;
                  const p0o = polar(a0, rOut), p1o = polar(a1, rOut);
                  const p0i = polar(a0, RING_START - 8), p1i = polar(a1, RING_START - 8);
                  const d = `M ${p0i.x} ${p0i.y} L ${p0o.x} ${p0o.y} A ${rOut} ${rOut} 0 0 1 ${p1o.x} ${p1o.y} L ${p1i.x} ${p1i.y} A ${RING_START - 8} ${RING_START - 8} 0 0 0 ${p0i.x} ${p0i.y} Z`;
                  return <path key={"bg-" + m} d={d} fill={appearance?.accentColor || "#FF7A3D"} opacity="0.09" />;
                })}

                {/* Rayons gris clair du centre vers chaque semaine, pour aider le repérage */}
                {Array.from({ length: 52 }, (_, i) => {
                  const a = i * (360 / 52);
                  const p = polar(a, weekRingR);
                  return <line key={"spoke-" + i} x1={CENTER} y1={CENTER} x2={p.x} y2={p.y} stroke="#000" strokeWidth="0.5" opacity="0.05" />;
                })}
              </>
            )}

            {/* Cercles intermédiaires : un repère discret par tâche, sur toute la circonférence */}
            {regularTasks.map((t, i) => (
              <circle key={"ring-" + t.id} cx={CENTER} cy={CENTER} r={RING_START + i * RING_STEP} fill="none" stroke={colorFor(t)} strokeWidth="1" opacity="0.12" />
            ))}
            <circle cx={CENTER} cy={CENTER} r={RING_START - 8} fill="none" stroke="var(--border)" strokeWidth="1.5" />

            {!hasRange && (
              <>
                {/* Sous-cercle des semaines S1..S52, juste après le dernier anneau de tâches */}
                <circle cx={CENTER} cy={CENTER} r={weekRingR} fill="none" stroke="var(--border)" strokeWidth="1" />
                {Array.from({ length: 52 }, (_, i) => {
                  const a0 = i * (360 / 52);
                  const pLabel = polar(a0 + (360 / 52) / 2, weekRingR);
                  return (
                    <g key={"week-" + i}>
                      <line x1={polar(a0, weekRingR - 6).x} y1={polar(a0, weekRingR - 6).y} x2={polar(a0, weekRingR + 6).x} y2={polar(a0, weekRingR + 6).y} stroke="var(--border)" strokeWidth="1" />
                      <text x={pLabel.x} y={pLabel.y} textAnchor="middle" dominantBaseline="middle" fontSize="6.5" fill="var(--text-600)" opacity="0.75">S{i + 1}</text>
                    </g>
                  );
                })}
              </>
            )}

            {/* Rayons + libellés des mois, avec l'icône du mois placée juste avant le nom */}
            {!hasRange && CAL_MONTHS_FR.map((m, i) => {
              const a = i * 30;
              const spokeOuter = polar(a, monthSpokeR - 14);
              const spokeInner = polar(a, RING_START - 8);
              const pLabel = polar(a, monthSpokeR + 8);
              return (
                <g key={m}>
                  <line x1={spokeInner.x} y1={spokeInner.y} x2={spokeOuter.x} y2={spokeOuter.y} stroke="var(--border)" strokeWidth="1" opacity="0.35" strokeDasharray="1 4" />
                  <text x={pLabel.x} y={pLabel.y} textAnchor="middle" dominantBaseline="middle" fontSize="11.5" fontWeight="700" fill="var(--text-900)">{m}</text>
                </g>
              );
            })}

            {/* Mode secteur (plage de dates personnalisée) : arc de fond + repères de
                dates adaptatifs (semaine/mois/trimestre selon l'écart), le long du
                demi-cercle allant de la date minimale (gauche) à la maximale (droite). */}
            {hasRange && (
              <>
                <path d={arcPath(SECTOR_START, SECTOR_START + SECTOR_SPAN, weekRingR, false)} fill="none" stroke="var(--border)" strokeWidth="1" />
                {sectorTicks.map((tick) => {
                  const a = angleFor(tick.date);
                  const spokeOuter = polar(a, monthSpokeR - 14);
                  const spokeInner = polar(a, RING_START - 8);
                  const pLabel = polar(a, monthSpokeR + 8);
                  return (
                    <g key={"sector-tick-" + tick.date}>
                      <line x1={spokeInner.x} y1={spokeInner.y} x2={spokeOuter.x} y2={spokeOuter.y} stroke="var(--border)" strokeWidth="1" opacity="0.35" strokeDasharray="1 4" />
                      <text x={pLabel.x} y={pLabel.y} textAnchor="middle" dominantBaseline="middle" fontSize="10.5" fontWeight="700" fill="var(--text-900)">{tick.label}</text>
                    </g>
                  );
                })}
                {/* Repères de bornes explicites — toujours affichés même sans graduation intermédiaire pile dessus */}
                <text x={polar(SECTOR_START, monthSpokeR + 8).x} y={polar(SECTOR_START, monthSpokeR + 8).y} textAnchor="middle" dominantBaseline="middle" fontSize="9.5" fontWeight="800" fill="var(--accent)">{fmtShort(effStart)}</text>
                <text x={polar(SECTOR_START + SECTOR_SPAN, monthSpokeR + 8).x} y={polar(SECTOR_START + SECTOR_SPAN, monthSpokeR + 8).y} textAnchor="middle" dominantBaseline="middle" fontSize="9.5" fontWeight="800" fill="var(--accent)">{fmtShort(effEnd)}</text>
              </>
            )}

            {/* Ligne "aujourd'hui" */}
            {showToday && (() => {
              const a = angleFor(today);
              const p = polar(a, weekRingR);
              const pc = polar(a, RING_START - 8);
              return <line x1={pc.x} y1={pc.y} x2={p.x} y2={p.y} stroke="var(--accent)" strokeWidth="1.5" strokeDasharray="3 3" opacity="0.8" />;
            })()}

            {/* Arcs de tâches, un anneau par tâche en partant du centre — piste + avancement, sans texte, tout au survol */}
            {regularTasks.map((t, i) => {
              const r = RING_START + i * RING_STEP;
              const a0 = angleFor(t.start);
              const a1 = angleFor(t.end);
              const color = colorFor(t);
              const done = isTaskDoneGlobal(t, ctx);
              const progress = Math.max(0, Math.min(100, t.progress || 0));
              const aProgress = a0 + (a1 - a0) * (progress / 100);
              return (
                <g key={t.id}>
                  {/* Piste : toute la durée de la tâche, en teinte claire/transparente */}
                  <path
                    d={arcPath(a0, a1, r)}
                    fill="none"
                    stroke={color}
                    strokeWidth="14"
                    strokeLinecap="round"
                    opacity="0.25"
                    className="lp-radar-arc-group"
                    onClick={() => onOpen(t)}
                    onMouseEnter={(e) => showTooltip(e, t)}
                    onMouseMove={moveTooltip}
                    onMouseLeave={hideTooltip}
                  />
                  {/* Avancement : portion réalisée, en teinte pleine et plus foncée — rien si 0% */}
                  {(done || progress > 0) && (
                    <path
                      d={arcPath(a0, done ? a1 : aProgress, r, false)}
                      fill="none"
                      stroke={color}
                      strokeWidth="14"
                      strokeLinecap="round"
                      opacity={done ? 0.75 : 0.98}
                      style={{ pointerEvents: "none" }}
                    />
                  )}
                </g>
              );
            })}

            {/* Jalons — icône propre au jalon/projet si définie (Réglages > Projets,
                ou surchargée sur le jalon lui-même), sinon le style global choisi
                dans Apparence. */}
            {milestones.map((t) => {
              const a = angleFor(t.end);
              const r = outerR + 6;
              const p = polar(a, r);
              const color = colorFor(t);
              const customIcon = resolveMilestoneIcon(t, ctx);
              const isCustomImage = customIcon && (customIcon.startsWith("data:") || customIcon.startsWith("http://") || customIcon.startsWith("https://"));
              const isImage = customIcon ? isCustomImage : (GLOBAL_MILESTONE_STYLE === "flag" || (GLOBAL_MILESTONE_STYLE === "custom" && GLOBAL_MILESTONE_URL));
              const imgSrc = customIcon ? customIcon : (GLOBAL_MILESTONE_STYLE === "custom" ? GLOBAL_MILESTONE_URL : MILESTONE_ICON);
              const emoji = customIcon || (MILESTONE_STYLES[GLOBAL_MILESTONE_STYLE] || MILESTONE_STYLES.flag).icon;
              const handlers = {
                onClick: () => onOpen(t),
                onMouseEnter: (e) => showTooltip(e, t),
                onMouseMove: moveTooltip,
                onMouseLeave: hideTooltip,
              };
              return isImage ? (
                <image key={t.id} href={imgSrc} x={p.x - 9} y={p.y - 9} width="18" height="18" className="lp-radar-milestone" {...handlers} />
              ) : (
                <text key={t.id} x={p.x} y={p.y} textAnchor="middle" dominantBaseline="middle" fontSize="18" fill={color} className="lp-radar-milestone" {...handlers}>{emoji}</text>
              );
            })}

            {/* Centre, réduit */}
            <circle cx={CENTER} cy={CENTER} r={RING_START - 16} fill="var(--paper-soft)" opacity="0.6" />
            <text x={CENTER} y={CENTER - 5} textAnchor="middle" fontSize="19" fontWeight="800" fill="var(--text-900)">{year}</text>
            <text x={CENTER} y={CENTER + 10} textAnchor="middle" fontSize="9.5" fill="var(--text-600)">{yearTasks.length} élément{yearTasks.length > 1 ? "s" : ""}</text>

            {/* Bulles persistantes ("Montrer toutes les infos") : traits de rappel + carte HTML intégrée en SVG */}
            {showAllInfo && persistentCards.map(({ task: t, originPt, cardPt }) => (
              <React.Fragment key={"pcard-" + t.id}>
                <line x1={originPt.x} y1={originPt.y} x2={cardPt.x} y2={cardPt.y} stroke={colorFor(t)} strokeWidth="0.75" opacity="0.4" />
                <circle cx={originPt.x} cy={originPt.y} r="2.5" fill={colorFor(t)} />
                <foreignObject x={cardPt.x - CARD_W / 2} y={cardPt.y - CARD_H / 2} width={CARD_W} height={CARD_H} style={{ overflow: "visible" }}>
                  <div className="lp-radar-tooltip lp-radar-tooltip-pinned" style={{ fontSize: cardFont + "px" }} onClick={() => onOpen(t)}>
                    <TooltipBody t={t} compact />
                  </div>
                </foreignObject>
              </React.Fragment>
            ))}
          </svg>
        </div>

        {!fullscreen && (
          <>
            {listCollapsed ? (
              <button className="lp-radar-list-collapsed-tab" onClick={toggleListCollapsed} title="Afficher la liste des tâches">
                <ChevronLeft size={14} />
              </button>
            ) : (
              <>
                <div
                  className="lp-radar-list-handle"
                  onPointerDown={startResize}
                  onPointerMove={moveResize}
                  onPointerUp={endResize}
                  onPointerCancel={endResize}
                  title="Glisser pour redimensionner"
                >
                  <div className="lp-radar-list-handle-grip" />
                </div>
                <div className="lp-radar-list" style={{ width: listWidth, flex: `0 1 ${listWidth}px`, minWidth: 0 }}>
                <div className="lp-section-title" style={{ marginBottom: 8, display: "flex", alignItems: "center", gap: 6 }}>
                  <button className="lp-icon-btn" onClick={toggleListCollapsed} title="Replier la liste" style={{ padding: 2 }}><ChevronRight size={13} /></button>
                  Tâches de {year} ({regularTasks.length})
                </div>
                {regularTasks.length === 0 && <div className="lp-empty">Aucune tâche sur cette année.</div>}
                {regularTasks.map((t) => (
                  <div key={t.id} className="lp-tl-list-row" onClick={() => onOpen(t)}>
                    <span className="lp-project-dot" style={{ background: colorFor(t), width: 14, height: 14, fontSize: 0 }} />
                    <span className="lp-tl-list-title">{t.title}</span>
                    <span className="lp-tl-list-date">{fmtShort(t.start)} → {fmtShort(t.end)}</span>
                  </div>
                ))}
            <div className="lp-section-title" style={{ margin: "16px 0 8px" }}>Jalons de {year} ({milestones.length})</div>
            {milestones.length === 0 && <div className="lp-empty">Aucun jalon sur cette année.</div>}
            {milestones.map((t) => (
              <div key={t.id} className="lp-tl-list-row" onClick={() => onOpen(t)}>
                <span className="lp-project-dot" style={{ background: colorFor(t), width: 14, height: 14, fontSize: 0 }} />
                <MilestoneGlyph size={12} icon={resolveMilestoneIcon(t, ctx)} />
                <span className="lp-tl-list-title">{t.title}</span>
                <span className="lp-tl-list-date">{fmtShort(t.end)}</span>
              </div>
            ))}
          </div>
              </>
            )}
          </>
        )}
      </div>

      {hover && !showAllInfo && (
        <div className="lp-radar-tooltip" style={{ left: hover.x + 16, top: hover.y + 16 }}>
          <TooltipBody t={hover.task} />
        </div>
      )}
    </div>
  );
}

// ============================================================================
// Vue "Aujourd'hui" — tableau de bord du jour
// ============================================================================
const WEEKDAYS_FR = ["Dimanche", "Lundi", "Mardi", "Mercredi", "Jeudi", "Vendredi", "Samedi"];

function PieChart({ data, size = 190, onHover, onLeave, onToggle, excluded }) {
  // data: [{ label, value, color }]
  const visibleData = data.filter((d) => !excluded || !excluded.has(d.label));
  const total = visibleData.reduce((s, d) => s + d.value, 0);
  const r = size / 2 - 6;
  const cx = size / 2, cy = size / 2;
  if (total === 0) {
    return (
      <svg width={size} height={size} viewBox={`0 0 ${size} ${size}`}>
        <circle cx={cx} cy={cy} r={r} fill="none" stroke="var(--border)" strokeWidth="1.5" />
        <text x={cx} y={cy} textAnchor="middle" dominantBaseline="middle" fontSize="12" fill="var(--text-600)">Aucune donnée</text>
      </svg>
    );
  }
  let cumulative = 0;
  const polar = (angleDeg, radius) => {
    const rad = ((angleDeg - 90) * Math.PI) / 180;
    return { x: cx + radius * Math.cos(rad), y: cy + radius * Math.sin(rad) };
  };
  const slices = visibleData.filter((d) => d.value > 0).map((d) => {
    const a0 = (cumulative / total) * 360;
    cumulative += d.value;
    const a1 = (cumulative / total) * 360;
    const p0 = polar(a0, r), p1 = polar(a1, r);
    const largeArc = a1 - a0 > 180 ? 1 : 0;
    const path = a1 - a0 >= 359.9
      ? `M ${cx} ${cy - r} A ${r} ${r} 0 1 1 ${cx - 0.01} ${cy - r} Z`
      : `M ${cx} ${cy} L ${p0.x} ${p0.y} A ${r} ${r} 0 ${largeArc} 1 ${p1.x} ${p1.y} Z`;
    return { ...d, path, pct: Math.round((d.value / total) * 100) };
  });
  return (
    <svg width={size} height={size} viewBox={`0 0 ${size} ${size}`}>
      {slices.map((s, i) => (
        <path
          key={i} d={s.path} fill={s.color} stroke="#fff" strokeWidth="1.5"
          className="lp-pie-slice"
          onMouseEnter={(e) => onHover && onHover(s, e)}
          onMouseMove={(e) => onHover && onHover(s, e)}
          onMouseLeave={() => onLeave && onLeave()}
          onClick={() => onToggle && onToggle(s.label)}
        />
      ))}
    </svg>
  );
}

function TodayView({ tasks, ctx, onOpen, appearance }) {
  const today = iso(new Date());
  const now = new Date();
  const dateLabel = `${WEEKDAYS_FR[now.getDay()]} ${now.getDate()} ${CAL_MONTHS_FR[now.getMonth()].toLowerCase()} ${now.getFullYear()}`;
  const in7Days = addDays(today, 7);
  const [pieHover, setPieHover] = useState(null);
  const [excludedProjects, setExcludedProjects] = useState(new Set());
  const [excludedStatuses, setExcludedStatuses] = useState(new Set());

  const notDone = useMemo(() => tasks.filter((t) => !isTaskDoneGlobal(t, ctx)), [tasks, ctx]);
  const urgentTasks = useMemo(() => notDone.filter((t) => isTaskUrgent(t, ctx) && !t.milestone), [notDone, ctx]);
  const dueToday = useMemo(() => notDone.filter((t) => !t.milestone && t.end === today), [notDone, today]);
  const upcomingMilestones = useMemo(
    () => tasks.filter((t) => t.milestone && t.end >= today && t.end <= in7Days).sort((a, b) => a.end.localeCompare(b.end)),
    [tasks, today, in7Days]
  );

  const projectPieData = useMemo(() => {
    const counts = {};
    notDone.filter((t) => !t.milestone).forEach((t) => {
      const key = t.projectId || "none";
      counts[key] = (counts[key] || 0) + 1;
    });
    return Object.entries(counts).map(([id, value]) => {
      const p = ctx.projects.find((p) => p.id === id);
      return { label: p ? p.name : "Sans projet", value, color: p?.color || "var(--text-muted)" };
    }).sort((a, b) => b.value - a.value);
  }, [notDone, ctx.projects]);

  const statusPieData = useMemo(() => {
    const counts = {};
    notDone.filter((t) => !t.milestone).forEach((t) => {
      const key = t.statusId || "none";
      counts[key] = (counts[key] || 0) + 1;
    });
    return Object.entries(counts).map(([id, value]) => {
      const s = ctx.statuses.find((s) => s.id === id);
      return { label: s ? s.name : "Sans statut", value, color: s?.color || "var(--text-muted)" };
    }).sort((a, b) => b.value - a.value);
  }, [notDone, ctx.statuses]);

  const TaskMiniRow = ({ t, showDate }) => {
    const proj = ctx.projects.find((p) => p.id === t.projectId);
    const st = ctx.statuses.find((s) => s.id === t.statusId);
    return (
      <div className="lp-today-row" onClick={() => onOpen(t)}>
        <span className="lp-project-dot" style={{ background: proj?.color || "var(--text-muted)", width: 14, height: 14, fontSize: 9 }}><IconGlyph icon={proj?.icon} size={10} /></span>
        {t.milestone && <MilestoneGlyph size={12} icon={resolveMilestoneIcon(t, ctx)} />}
        <span className="lp-today-row-title">{t.title}</span>
        {st && <span className="lp-chip" style={{ background: st.color + "22", color: st.color }}>{st.name}</span>}
        {showDate && <span className="lp-today-row-date">{fmtShort(t.end)}</span>}
      </div>
    );
  };

  return (
    <div className="lp-today-wrap">
      <div className="lp-today-header">
        <div className="lp-today-date-badge" style={{ background: appearance?.accentColor || "#FF7A3D" }}>{now.getDate()}</div>
        <div>
          <h2 style={{ margin: 0, fontSize: 20, fontWeight: 800, textTransform: "capitalize" }}>{dateLabel}</h2>
          <div style={{ fontSize: 12.5, color: "var(--text-600)", marginTop: 2 }}>
            {urgentTasks.length} urgente{urgentTasks.length > 1 ? "s" : ""} · {dueToday.length} se termine{dueToday.length > 1 ? "nt" : ""} aujourd'hui · {upcomingMilestones.length} jalon{upcomingMilestones.length > 1 ? "s" : ""} à venir
          </div>
        </div>
      </div>

      <div className="lp-today-grid">
        <div className="lp-today-block">
          <div className="lp-today-block-title"><AlertTriangle size={14} color="var(--danger)" /> Tâches urgentes</div>
          {urgentTasks.length === 0 && <div className="lp-empty">Aucune tâche urgente.</div>}
          {urgentTasks.map((t) => <TaskMiniRow key={t.id} t={t} showDate />)}
        </div>
        <div className="lp-today-block">
          <div className="lp-today-block-title"><Crosshair size={14} color="var(--signal)" /> Se terminent aujourd'hui</div>
          {dueToday.length === 0 && <div className="lp-empty">Aucune tâche ne se termine aujourd'hui.</div>}
          {dueToday.map((t) => <TaskMiniRow key={t.id} t={t} />)}
        </div>
        <div className="lp-today-block">
          <div className="lp-today-block-title"><MilestoneGlyph size={14} /> Prochains jalons (7 jours)</div>
          {upcomingMilestones.length === 0 && <div className="lp-empty">Aucun jalon dans les 7 prochains jours.</div>}
          {upcomingMilestones.map((t) => <TaskMiniRow key={t.id} t={t} showDate />)}
        </div>
      </div>

      <div className="lp-today-charts">
        <div className="lp-today-chart-card">
          <div className="lp-today-block-title">Tâches par projet <span className="lp-today-chart-sub">(hors terminées)</span></div>
          <div className="lp-today-chart-body">
            <PieChart
              data={projectPieData}
              excluded={excludedProjects}
              onHover={(s, e) => setPieHover({ ...s, x: e.clientX, y: e.clientY })}
              onLeave={() => setPieHover(null)}
              onToggle={(label) => setExcludedProjects((prev) => { const n = new Set(prev); n.has(label) ? n.delete(label) : n.add(label); return n; })}
            />
            <div className="lp-today-chart-legend">
              {projectPieData.map((d, i) => (
                <div
                  key={i}
                  className={"lp-today-legend-item" + (excludedProjects.has(d.label) ? " excluded" : "")}
                  onClick={() => setExcludedProjects((prev) => { const n = new Set(prev); n.has(d.label) ? n.delete(d.label) : n.add(d.label); return n; })}
                >
                  <span className="dot" style={{ background: d.color }} />{d.label} <span className="lp-today-legend-count">{d.value}</span>
                </div>
              ))}
              {projectPieData.length === 0 && <div className="lp-empty">Aucune tâche.</div>}
            </div>
          </div>
        </div>
        <div className="lp-today-chart-card">
          <div className="lp-today-block-title">Tâches par statut <span className="lp-today-chart-sub">(hors terminées)</span></div>
          <div className="lp-today-chart-body">
            <PieChart
              data={statusPieData}
              excluded={excludedStatuses}
              onHover={(s, e) => setPieHover({ ...s, x: e.clientX, y: e.clientY })}
              onLeave={() => setPieHover(null)}
              onToggle={(label) => setExcludedStatuses((prev) => { const n = new Set(prev); n.has(label) ? n.delete(label) : n.add(label); return n; })}
            />
            <div className="lp-today-chart-legend">
              {statusPieData.map((d, i) => (
                <div
                  key={i}
                  className={"lp-today-legend-item" + (excludedStatuses.has(d.label) ? " excluded" : "")}
                  onClick={() => setExcludedStatuses((prev) => { const n = new Set(prev); n.has(d.label) ? n.delete(d.label) : n.add(d.label); return n; })}
                >
                  <span className="dot" style={{ background: d.color }} />{d.label} <span className="lp-today-legend-count">{d.value}</span>
                </div>
              ))}
              {statusPieData.length === 0 && <div className="lp-empty">Aucune tâche.</div>}
            </div>
          </div>
        </div>
      </div>

      {pieHover && (
        <div className="lp-radar-tooltip" style={{ left: pieHover.x + 16, top: pieHover.y + 16 }}>
          <div className="lp-radar-tooltip-title">{pieHover.label}</div>
          <div className="lp-radar-tooltip-row">{pieHover.value} tâche{pieHover.value > 1 ? "s" : ""} · {pieHover.pct}%</div>
        </div>
      )}
    </div>
  );
}

// ============================================================================
// Vue "Projet" — planning en ligne de métro, inspiré des roadmaps circulaires
// Chaque projet = une ligne continue (du plus tôt au plus tard) ; chaque tâche
// crée une bifurcation dont la longueur = sa durée ; chaque sous-tâche crée une
// bifurcation supplémentaire à partir de la bifurcation de sa tâche parente.
// ============================================================================
const PROJECT_METRO_ZOOMS = [
  { key: "day", label: "Jour", dayWidth: 30 },
  { key: "week", label: "Semaine", dayWidth: 9 },
  { key: "month", label: "Mois", dayWidth: 2.6 },
  { key: "quarter", label: "Trimestre", dayWidth: 1 },
  { key: "year", label: "Année", dayWidth: 0.35 },
];
const PM_PAD_LEFT = 40;
const PM_PAD_RIGHT_BASE = 260;
const PM_CRITICAL_COLOR = "#DC2626"; // ligne "express" du chemin critique
const PM_RISK_COLOR = "var(--danger)";
const PM_FIELD_OPTIONS = [
  { key: "status", label: "Statut" },
  { key: "taskType", label: "Type" },
  { key: "assignee", label: "Responsable" },
  { key: "progress", label: "Avancement" },
  { key: "dates", label: "Dates" },
];

// Mesure de largeur de texte via un canevas hors-écran, pour aligner précisément
// le titre puis les champs sélectionnés à la suite, sans qu'ils ne se chevauchent.
let __pmMeasureCanvas = null;
function pmMeasureText(text, font) {
  if (!__pmMeasureCanvas) __pmMeasureCanvas = document.createElement("canvas");
  const c = __pmMeasureCanvas.getContext("2d");
  c.font = font;
  return c.measureText(text).width;
}

function ProjectMetroView({ tasks, ctx, onOpen, toolbarSlot, appearance, prefs, setPrefs, setTasks, pushToast, expenses, embedded, isHomepage, onSelectProject, selectedProjectIds, onToggleProject, metaTemporalBlocks, annotations, onAnnotationsChange }) {
  const dated = useMemo(() => tasks.filter((t) => t.start && t.end), [tasks]);
  const [expandedActivities, setExpandedActivities] = useState(() => new Set());
  const toggleActivityActions = (id) => setExpandedActivities((prev) => {
    const next = new Set(prev);
    next.has(id) ? next.delete(id) : next.add(id);
    return next;
  });
  // Détection "vient d'être terminée" (Réglages > Apparence) — faite ICI, à un
  // niveau STABLE qui ne se remonte pas à chaque rendu, contrairement à chaque
  // <Station/> individuelle. Sans ça, la comparaison "précédent vs actuel" se
  // réinitialise en permanence et l'animation ne se déclenche jamais.
  const wasTaskDoneRef = useRef({});
  const [justCompletedIds, setJustCompletedIds] = useState(() => new Set());
  useEffect(() => {
    if (!appearance?.animCheckPop) return undefined;
    const newlyDone = [];
    dated.forEach((t) => {
      const nowDone = isTaskDoneGlobal(t, ctx);
      const was = wasTaskDoneRef.current[t.id];
      if (nowDone && was === false) newlyDone.push(t.id);
      wasTaskDoneRef.current[t.id] = nowDone;
    });
    if (newlyDone.length === 0) return undefined;
    setJustCompletedIds((prev) => new Set([...prev, ...newlyDone]));
    const tm = setTimeout(() => {
      setJustCompletedIds((prev) => {
        const next = new Set(prev);
        newlyDone.forEach((id) => next.delete(id));
        return next;
      });
    }, 500);
    return () => clearTimeout(tm);
  }, [dated, ctx, appearance?.animCheckPop]);

  // Hauteur réelle de la barre d'onglets (.lp-detail-tabbar), mesurée
  // dynamiquement : les "top" figés en dur des en-têtes sticky de ce planning
  // (.lp-pm-header-row / .lp-pm-sticky-axis-shell) ne suivaient pas sa
  // hauteur réelle, laissant les lignes du planning (jalons, flèches
  // inter-projets…) transparaître dans l'écart au-dessus du titre pendant le
  // défilement — d'où l'impression de "trou" d'opacité juste sous les onglets.
  const pmChromeRef = useRef(null);
  useEffect(() => {
    if (embedded) return undefined;
    const tabbarEl = document.querySelector(".lp-detail-tabbar");
    const node = pmChromeRef.current;
    const headerEl = node?.querySelector(".lp-pm-header-row");
    if (!tabbarEl || !node) return undefined;
    const apply = () => {
      const tabH = Math.ceil(tabbarEl.getBoundingClientRect().height);
      if (tabH > 0) node.style.setProperty("--pm-tabbar-h", tabH + "px");
      if (headerEl) {
        const headerH = Math.ceil(headerEl.getBoundingClientRect().height);
        if (headerH > 0) node.style.setProperty("--pm-header-h", headerH + "px");
      }
    };
    apply();
    const ro = new ResizeObserver(apply);
    ro.observe(tabbarEl);
    if (headerEl) ro.observe(headerEl);
    return () => ro.disconnect();
  }, [embedded]);
  const zoomKey = prefs.zoomKey || "auto";
  const setZoomKey = (value) => setPrefs((p) => ({
    ...p,
    zoomKey: typeof value === "function" ? value(p.zoomKey || "auto") : value,
  }));
  const fields = prefs.fields || ["status"];
  const showSubtasks = !!prefs.showSubtasks;
  const PM_PAD_RIGHT = PM_PAD_RIGHT_BASE + fields.length * 90; // chaque champ affiché ajoute de la place nécessaire
  const collapsed = prefs.collapsed || {};
  const setFields = (updater) => setPrefs((p) => ({ fields: typeof updater === "function" ? updater(p.fields || ["status"]) : updater }));
  const toggleCollapse = (pid) => setPrefs((p) => ({ collapsed: { ...(p.collapsed || {}), [pid]: !(p.collapsed || {})[pid] } }));
  // Regroupement des lignes de métro : par défaut une ligne par projet ("project"),
  // ou une ligne par dossier de projets ("folder") — dans ce second cas, toutes les
  // tâches des projets d'un même dossier se retrouvent fusionnées sur UNE seule ligne,
  // comme si elles appartenaient au même projet ; seule la couleur de chaque tâche
  // (reprise de son projet d'origine) permet encore de les distinguer entre elles.
  const metroGroupBy = prefs.metroGroupBy === "folder" ? "folder" : "project";
  const setMetroGroupBy = (value) => setPrefs((p) => ({ ...p, metroGroupBy: value }));

  // Recherche : centre la vue sur la première tâche trouvée et estompe tout le reste,
  // pour retrouver une tâche précise sans avoir à parcourir toutes les lignes à l'œil.
  const [searchQuery, setSearchQuery] = useState("");
  const matchIds = useMemo(() => {
    const q = searchQuery.trim().toLowerCase();
    if (!q) return null;
    const set = new Set();
    tasks.forEach((t) => { if ((t.title || "").toLowerCase().includes(q)) set.add(t.id); });
    return set;
  }, [searchQuery, tasks]);
  const dimOpacity = (id) => {
    let o = 1;
    if (matchIds && !matchIds.has(id)) o *= 0.15;
    if (showCriticalPath && criticalPathIds && !criticalPathIds.has(id)) o *= 0.2;
    return o;
  };

  // Chemin critique : à partir de la tâche qui termine le plus tard (tous projets
  // confondus), on remonte les dépendances en choisissant à chaque étape celle(s)
  // qui terminent le plus tard — s'il y a égalité entre deux prédécesseurs, les
  // deux branches sont conservées en parallèle plutôt que d'en écarter une
  // arbitrairement. Ancré sur les vraies dates de fin (pas sur une somme de
  // durées). Itératif, sans récursion, pour rester robuste sur un grand volume.
  const [showCriticalPath, setShowCriticalPath] = useState(false);
  const criticalPathIds = useMemo(() => {
    if (!showCriticalPath || dated.length === 0) return null;
    return computeCriticalIds(dated);
  }, [showCriticalPath, dated]);

  // Badges de risque : jalon dont la date est dépassée (ou proche) sans être marqué
  // terminé, ou tâche en retard — même logique que la puce "en retard" déjà utilisée
  // ailleurs dans l'app (isTaskLate), pour rester cohérent d'un écran à l'autre.
  const showRiskBadges = prefs.showRiskBadges !== false;
  const setShowRiskBadges = (value) => setPrefs((p) => ({
    ...p,
    showRiskBadges: typeof value === "function" ? value(p.showRiskBadges !== false) : value,
  }));
  const isAtRisk = (t) => isTaskLate(t, ctx);

  // Ces modes font désormais partie des préférences de la vue Métro afin d'être
  // enregistrés/restaurés dans une vue personnalisée.
  const networkMode = !!prefs.networkMode;
  const setNetworkMode = (value) => setPrefs((p) => ({
    ...p,
    networkMode: typeof value === "function" ? value(!!p.networkMode) : value,
  }));

  const deadlineMode = !!prefs.deadlineMode;
  const setDeadlineMode = (value) => setPrefs((p) => ({
    ...p,
    deadlineMode: typeof value === "function" ? value(!!p.deadlineMode) : value,
  }));

  // Raccourci global personnalisable (Réglages > Raccourcis).
  // Le composant Métro est le seul à écouter cet événement : ailleurs dans
  // Nexora, le raccourci n'altère aucune vue.
  useEffect(() => {
    const toggle = () => {
      setPrefs((p) => ({ ...p, networkMode:false, deadlineMode:!p.deadlineMode }));
    };
    window.addEventListener("nexora:metro-deadline-toggle", toggle);
    return () => window.removeEventListener("nexora:metro-deadline-toggle", toggle);
  }, []);

  // Carte de synthèse au clic sur le terminus (butoir) d'une ligne de projet.
  const [projectSummary, setProjectSummary] = useState(null); // { row, x, y } | null
  const [descriptionPopup, setDescriptionPopup] = useState(null); // { task, x, y } | null

  // Multi-sélection : Ctrl/Cmd-clic (ou Maj-clic) sur une station bascule sa
  // sélection, pour des actions groupées sans repasser par le Tableur.
  const [selectedIds, setSelectedIds] = useState(() => new Set());
  const toggleSelect = (id) => setSelectedIds((prev) => {
    const next = new Set(prev);
    if (next.has(id)) next.delete(id); else next.add(id);
    return next;
  });
  const clearSelection = () => setSelectedIds(new Set());
  const doneStatus = ctx.statuses.find((s) => /termin/i.test(s.name || ""));
  const markSelectedDone = () => {
    if (!doneStatus) return;
    setTasks((prev) => prev.map((t) => (
      selectedIds.has(t.id) && !isGoogleCalendarProjectId(t.projectId, ctx.projects)
        ? { ...t, statusId: doneStatus.id }
        : t
    )));
    clearSelection();
  };
  const deleteSelected = () => {
    const n = selectedIds.size;
    setTasks((prev) => prev.filter((t) => !selectedIds.has(t.id)));
    if (pushToast) pushToast({ message: `${n} tâche${n > 1 ? "s" : ""} supprimée${n > 1 ? "s" : ""}.` });
    clearSelection();
  };

  // Navigation clavier : flèches gauche/droite pour passer d'une station à l'autre
  // (dans l'ordre chronologique, tous projets confondus), Entrée pour l'ouvrir,
  // Échap pour effacer la sélection en cours.
  const [focusedId, setFocusedId] = useState(null);
  const keyboardOrder = useMemo(() => [...dated].sort((a, b) => (a.start || a.end).localeCompare(b.start || b.end)), [dated]);
  useEffect(() => {
    function onKeyDown(e) {
      if (!scrollRef.current) return;
      const tag = document.activeElement?.tagName;
      if (tag === "INPUT" || tag === "TEXTAREA" || document.activeElement?.isContentEditable) return; // ne pas interférer avec la recherche ou un champ ouvert
      if (e.key === "Escape") { clearSelection(); setFocusedId(null); return; }
      if (keyboardOrder.length === 0) return;
      if (e.key === "ArrowRight" || e.key === "ArrowLeft") {
        e.preventDefault();
        const curIdx = keyboardOrder.findIndex((t) => t.id === focusedId);
        const dir = e.key === "ArrowRight" ? 1 : -1;
        const nextIdx = curIdx === -1 ? 0 : Math.max(0, Math.min(keyboardOrder.length - 1, curIdx + dir));
        const next = keyboardOrder[nextIdx];
        setFocusedId(next.id);
        const el = scrollRef.current.querySelector(`[data-pm-task-id="${next.id}"]`);
        if (el) {
          const wrapRect = scrollRef.current.getBoundingClientRect();
          const elRect = el.getBoundingClientRect();
          scrollRef.current.scrollTo({
            left: Math.max(0, scrollRef.current.scrollLeft + (elRect.left - wrapRect.left) - scrollRef.current.clientWidth / 2),
            top: Math.max(0, scrollRef.current.scrollTop + (elRect.top - wrapRect.top) - scrollRef.current.clientHeight / 2),
            behavior: "smooth",
          });
        }
      } else if (e.key === "Enter" && focusedId) {
        const t = keyboardOrder.find((x) => x.id === focusedId);
        if (t) onOpen(t);
      }
    }
    window.addEventListener("keydown", onKeyDown);
    return () => window.removeEventListener("keydown", onKeyDown);
  }, [keyboardOrder, focusedId]);

  // Ordre personnalisé des lignes (glisser-déposer) — stocké dans les préférences
  // de la vue, jamais dans l'ordre global des projets (qui a son propre sens
  // ailleurs, ex. dans la barre latérale). Les projets absents de l'ordre
  // personnalisé (nouveaux projets) sont ajoutés à la fin, dans leur ordre naturel.
  const orderedProjects = useMemo(() => {
    const order = prefs.rowOrder;
    if (!order || !order.length) return ctx.projects;
    const byId = new Map(ctx.projects.map((p) => [p.id, p]));
    const ordered = order.map((id) => byId.get(id)).filter(Boolean);
    const remaining = ctx.projects.filter((p) => !order.includes(p.id));
    return [...ordered, ...remaining];
  }, [ctx.projects, prefs.rowOrder]);
  const [draggingRowId, setDraggingRowId] = useState(null);
  const [dragOverRowId, setDragOverRowId] = useState(null);
  const reorderRows = (draggedId, targetId) => {
    if (!draggedId || draggedId === targetId) return;
    // Basé sur les IDs de lignes RÉELLEMENT affichées à cet instant (rows), pas sur
    // orderedProjects — nécessaire pour rester correct en regroupement par dossier,
    // où les IDs de ligne sont des IDs de dossier, pas de projet.
    const currentOrder = rows.map((r) => r.project.id);
    const next = currentOrder.filter((id) => id !== draggedId);
    const targetIdx = next.indexOf(targetId);
    next.splice(targetIdx, 0, draggedId);
    setPrefs((p) => ({ ...p, rowOrder: next }));
  };

  const rows = useMemo(() => {
    // "Affiché" doit refléter le périmètre RÉEL (tâches effectivement présentes
    // après filtrage), pas la simple existence du projet — orderedProjects vient
    // de ctx.projects, jamais filtré, donc toujours "vrai" même si le filtre actif
    // a exclu toutes les tâches de ce projet. On se base ici sur les tâches
    // principales réellement présentes dans "dated" (déjà filtré en amont).
    const primaryTaskProjectIds = new Set(dated.map((t) => t.projectId));
    // Une tâche à deux projets s'affiche normalement sur SON projet principal — sauf
    // si celui-ci n'est pas dans le périmètre actuel (filtre projet, dossier replié…),
    // auquel cas elle bascule sur son second projet plutôt que de disparaître : "quand
    // un seul projet concerné est visible, ne change rien à la tâche".
    // Si un filtre de projet précis est actif, c'est LUI qui fait autorité pour savoir
    // si le projet principal est "dans le périmètre" — pas seulement la présence de
    // CETTE tâche dans "dated" (qui créerait une référence circulaire : la tâche
    // partagée servirait de sa propre justification pour rester sur son principal,
    // même quand l'utilisateur a explicitement choisi de ne voir que le secondaire).
    const belongsToRow = (t, pid) => {
      const primaryMatches = t.projectId === pid;
      const secondaryMatches = t.secondaryProjectId === pid;
      if (!primaryMatches && !secondaryMatches) return false;
      // Si un filtre de projet précis est actif, il fait STRICTEMENT autorité : la
      // tâche apparaît sur la ligne parmi ses deux projets qui est réellement dans
      // la sélection (les deux lignes si les deux sont sélectionnées) — jamais sur
      // son principal "juste parce que c'est son principal" s'il a été exclu du
      // périmètre par l'utilisateur.
      if (selectedProjectIds && selectedProjectIds.length > 0) return selectedProjectIds.includes(pid);
      if (primaryMatches) return true;
      return !primaryTaskProjectIds.has(t.projectId);
    };
    // Construit une ligne fusionnée à partir d'un ou plusieurs IDs de projet — pour
    // un projet seul (mode normal) ou pour tous les projets d'un même dossier (mode
    // "Grouper par dossier"). `rowProject` porte l'identité affichée de la ligne
    // (couleur, nom, icône) : le vrai projet dans le premier cas, un objet "dossier"
    // synthétique dans le second — les tâches elles-mêmes gardent toujours la
    // référence à leur VRAI projet (t.projectId), utilisée pour les colorer.
    const buildRow = (rowProject, projectIds) => {
      const idSet = new Set(projectIds);
      const pTasks = dated.filter((t) => projectIds.some((pid) => belongsToRow(t, pid)) && !t.milestone).sort((a, b) => a.start.localeCompare(b.start));
      const pMilestones = dated.filter((t) => projectIds.some((pid) => belongsToRow(t, pid)) && t.milestone);
      if (pTasks.length === 0 && pMilestones.length === 0) return null;
      const allDates = [
        ...pTasks.map((t) => t.start), ...pTasks.map((t) => t.end),
        ...pMilestones.map((t) => t.end),
      ];
      // Une tâche partagée doit toujours faire partie de la plage min/max des DEUX
      // projets, même côté secondaire où elle n'est pas physiquement dans pTasks
      // (rendue via le tronc commun, pas sur la ligne elle-même) — sinon la ligne du
      // second projet s'arrête avant la vraie fin de la tâche partagée, laissant une
      // station orpheline déconnectée de tout (voir bug remonté par l'utilisateur).
      dated.forEach((t) => {
        if (t.secondaryProjectId && idSet.has(t.secondaryProjectId) && !idSet.has(t.projectId)) {
          allDates.push(t.start, t.end);
        }
      });
      if (prefs.showSubtasks) {
        pTasks.forEach((t) => (t.checklist || []).forEach((sub) => { if (sub.end) allDates.push(sub.end); }));
      }
      const minDate = allDates.reduce((m, d) => (d < m ? d : m), allDates[0]);
      const maxDate = allDates.reduce((m, d) => (d > m ? d : m), allDates[0]);
      const progressVals = pTasks.map((t) => (isTaskDoneGlobal(t, ctx) ? 100 : t.progress || 0));
      const avgProgress = progressVals.length ? Math.round(progressVals.reduce((s, v) => s + v, 0) / progressVals.length) : 0;
      return { project: rowProject, pTasks, pMilestones, minDate, maxDate, avgProgress };
    };

    if (metroGroupBy === "folder") {
      // Un groupe par dossier — grâce à la migration douce qui assigne "À trier"
      // (DEFAULT_UNSORTED_FOLDER_ID) à tout projet sans dossier, chaque projet a
      // toujours un folderId ici.
      const groupsById = new Map();
      orderedProjects.forEach((p) => {
        const fid = p.folderId || DEFAULT_UNSORTED_FOLDER_ID;
        if (!groupsById.has(fid)) {
          const folder = (ctx.projectFolders || []).find((f) => f.id === fid);
          groupsById.set(fid, {
            projectIds: [],
            rowProject: {
              id: fid,
              name: folder?.name || "Sans dossier",
              color: folder?.color || "var(--text-muted)",
              icon: "tabler:folder",
              isFolderGroup: true,
            },
          });
        }
        groupsById.get(fid).projectIds.push(p.id);
      });
      let groupList = [...groupsById.values()];
      const order = prefs.rowOrder;
      if (order && order.length) {
        const byId = new Map(groupList.map((g) => [g.rowProject.id, g]));
        const ordered = order.map((id) => byId.get(id)).filter(Boolean);
        const remaining = groupList.filter((g) => !order.includes(g.rowProject.id));
        groupList = [...ordered, ...remaining];
      }
      return groupList.map((g) => buildRow(g.rowProject, g.projectIds)).filter(Boolean);
    }

    return orderedProjects.map((p) => buildRow(p, [p.id])).filter(Boolean);
  }, [dated, orderedProjects, ctx, prefs.showSubtasks, prefs.rowOrder, metroGroupBy, selectedProjectIds]);

  const allCollapsed = rows.length > 0 && rows.every((r) => collapsed[r.project.id]);
  const toggleAllCollapsed = () => setPrefs((p) => ({ ...p, collapsed: Object.fromEntries(rows.map((r) => [r.project.id, !allCollapsed])) }));

  // La ligne "Aujourd'hui" doit toujours exister dans le planning : on inclut
  // systématiquement la date du jour dans la plage temporelle, même lorsque tous
  // les projets sont entièrement dans le passé ou dans le futur. Cela permet aux
  // raccourcis Jour/Semaine/Mois/Automatique de réellement centrer cette ligne.
  const planningToday = iso(new Date());
  const globalMin = useMemo(() => {
    const rowsMin = rows.length ? rows.reduce((m, r) => (r.minDate < m ? r.minDate : m), rows[0].minDate) : planningToday;
    return rowsMin < planningToday ? rowsMin : planningToday;
  }, [rows, planningToday]);
  const globalMax = useMemo(() => {
    const rowsMax = rows.length ? rows.reduce((m, r) => (r.maxDate > m ? r.maxDate : m), rows[0].maxDate) : addDays(planningToday, 60);
    return rowsMax > planningToday ? rowsMax : planningToday;
  }, [rows, planningToday]);
  const originIdx = dayIndex(globalMin);
  const totalDays = Math.max(1, dayIndex(globalMax) - originIdx);
  const minYear = new Date(globalMin + "T00:00:00").getFullYear();
  const maxYear = new Date(globalMax + "T00:00:00").getFullYear();

  // Colonne "nom du projet" entièrement repliable — ne laisse qu'un mince bouton
  // bascule toujours visible, pour rendre toute la largeur au diagramme.
  const leftCollapsed = !!prefs.leftCollapsed;
  const LEFT_W_FULL = 220;
  const LEFT_W_COLLAPSED = 34;
  const LEFT_W = leftCollapsed ? LEFT_W_COLLAPSED : LEFT_W_FULL;
  // Sans aucune ligne de projet, la colonne "nom du projet" n'a plus de raison
  // d'être réservée — l'axe des dates et le message vide doivent démarrer au
  // même niveau que le titre au-dessus, pas décalés dans le vide.
  const railLeftW = rows.length === 0 ? 0 : LEFT_W;
  const scrollRef = useRef(null);
  const [containerW, setContainerW] = useState(1200);
  const [pmScrollLeft, setPmScrollLeft] = useState(0);
  useEffect(() => {
    const el = scrollRef.current;
    if (!el) return;
    let raf = 0;
    const onScroll = () => {
      if (raf) return;
      raf = requestAnimationFrame(() => {
        raf = 0;
        setPmScrollLeft(el.scrollLeft || 0);
      });
    };
    onScroll();
    el.addEventListener("scroll", onScroll, { passive: true });
    return () => {
      el.removeEventListener("scroll", onScroll);
      if (raf) cancelAnimationFrame(raf);
    };
  }, []);
  useEffect(() => {
    const el = scrollRef.current;
    if (!el) return;
    // LEFT_W dans les dépendances : sans ça, replier/déplier la colonne projet
    // ne redéclenche jamais la mesure (fermeture obsolète) et le diagramme
    // n'utilise pas l'espace fraîchement libéré en zoom automatique.
    const measure = () => {
      // DevTools, mobile split-screen or a very narrow viewport can make
      // el.clientWidth smaller than LEFT_W. Never propagate a negative SVG width.
      const available = Math.max(1, (el.clientWidth || 0) - LEFT_W);
      setContainerW(available);
    };
    measure();
    if ((el.clientWidth || 0) <= LEFT_W) {
      console.warn("[Nexora Metro] viewport très étroit : largeur SVG protégée", {
        clientWidth: el.clientWidth,
        leftColumn: LEFT_W
      });
    }
    const ro = new ResizeObserver(measure);
    ro.observe(el);
    window.addEventListener("resize", measure);
    return () => { ro.disconnect(); window.removeEventListener("resize", measure); };
  }, [LEFT_W]);

  const isAuto = zoomKey === "auto";
  const zoomDef = PROJECT_METRO_ZOOMS.find((z) => z.key === zoomKey);
  const centerTodayAfterZoomRef = useRef(false);
  const safeContainerW = Math.max(1, Number.isFinite(containerW) ? containerW : 1);
  const safeTotalDays = Math.max(1, totalDays || 1);
  const dayWidth = isAuto
    ? Math.max((safeContainerW - PM_PAD_LEFT - PM_PAD_RIGHT) / safeTotalDays, 0.3)
    : Math.max(0.3, zoomDef?.dayWidth || 0.3);
  const chartWidth = Math.max(
    1,
    isAuto
      ? safeContainerW
      : safeTotalDays * dayWidth + PM_PAD_LEFT + PM_PAD_RIGHT
  );
  const xFor = (d) => PM_PAD_LEFT + (dayIndex(d) - originIdx) * dayWidth;
  // Les raccourcis de zoom doivent toujours repositionner la ligne "Aujourd'hui"
  // au centre du viewport après que le nouveau zoom a été rendu.
  useEffect(() => {
    if (!centerTodayAfterZoomRef.current || !scrollRef.current) return;
    centerTodayAfterZoomRef.current = false;
    const raf = requestAnimationFrame(() => {
      const el = scrollRef.current;
      if (!el) return;
      const todayX = LEFT_W + xFor(planningToday);
      const targetScrollLeft = todayX - el.clientWidth / 2;
      const maxScrollLeft = Math.max(0, el.scrollWidth - el.clientWidth);
      el.scrollTo({
        left: Math.max(0, Math.min(maxScrollLeft, targetScrollLeft)),
        behavior: "smooth",
      });
    });
    return () => cancelAnimationFrame(raf);
  }, [zoomKey, containerW, LEFT_W, planningToday, originIdx, dayWidth, chartWidth]);
  useEffect(() => {
    const onZoomShortcut = (e) => {
      if (["day", "week", "month", "auto"].includes(e.detail)) {
        centerTodayAfterZoomRef.current = true;
        setZoomKey(e.detail);
      }
    };
    window.addEventListener("nexora:timeline-zoom", onZoomShortcut);
    return () => window.removeEventListener("nexora:timeline-zoom", onZoomShortcut);
  }, []);

  // Ctrl+Alt+T (personnalisable) : recentre la vue Métro, y compris le mode
  // Échéances, sur la date d'aujourd'hui sans modifier le niveau de zoom.
  useEffect(() => {
    const onGoToday = () => {
      const el = scrollRef.current;
      if (!el) return;
      const todayX = LEFT_W + xFor(planningToday);
      const targetScrollLeft = todayX - el.clientWidth / 2;
      const maxScrollLeft = Math.max(0, el.scrollWidth - el.clientWidth);
      el.scrollTo({
        left: Math.max(0, Math.min(maxScrollLeft, targetScrollLeft)),
        behavior: "smooth",
      });
    };
    window.addEventListener("nexora:go-today", onGoToday);
    return () => window.removeEventListener("nexora:go-today", onGoToday);
  }, [LEFT_W, planningToday, originIdx, dayWidth, chartWidth, deadlineMode]);

  const TASK_OFFSET = 44;
  const TASK_STEP = 38;
  const SUB_OFFSET = 28; // distance supplémentaire, au-delà de la bifurcation de la tâche, pour ses sous-tâches
  const TITLE_FONT = "700 10.5px Inter, sans-serif";
  const MS_TITLE_FONT = "700 10.5px Inter, sans-serif";
  const SUB_TITLE_FONT = "700 8.5px Inter, sans-serif";
  const CHIP_FONT = "700 8.5px Inter, sans-serif";
  const fieldChipsFor = (t) => {
    const chips = [];
    if (fields.includes("status")) {
      const st = ctx.statuses.find((s) => s.id === t.statusId);
      if (st) chips.push({ type: "text", text: st.name, color: st.color });
    }
    if (fields.includes("taskType")) {
      const tt = (ctx.taskTypes || []).find((s) => s.id === t.taskTypeId);
      if (tt) chips.push({ type: "text", text: tt.name, color: tt.color });
    }
    if (fields.includes("assignee") && t.assignee) chips.push({ type: "text", text: t.assignee, color: "var(--text-muted)" });
    if (fields.includes("progress")) chips.push({ type: "progress", task: t, color: ctx.projects.find((p) => p.id === t.projectId)?.color || "var(--text-muted)" });
    if (fields.includes("dates")) chips.push({ type: "text", text: `${fmtShort(t.start)} → ${fmtShort(t.end)}`, color: "var(--text-muted)" });
    return chips;
  };
  // Largeur réellement occupée par les puces d'une tâche (même logique que le rendu),
  // pour un tassement fidèle plutôt qu'une marge forfaitaire approximative.
  const chipsWidthFor = (t) => {
    let w = 0;
    fieldChipsFor(t).forEach((c) => {
      w += c.type === "progress" ? 46 + 5 : pmMeasureText(c.text, CHIP_FONT) + 16 + 5;
    });
    return w;
  };
  // Tronque un titre trop long, pour ne jamais déborder sur ce qui suit
  const truncateTitle = (title) => (title.length > 25 ? title.slice(0, 25).trimEnd() + "…" : title);

  const buildLayout = (pTasks, pMilestones) => {
    const activities = pTasks
      .filter((t) => getTaskType(t) === "activity")
      .sort((a,b) => a.start.localeCompare(b.start) || a.end.localeCompare(b.end));

    const branchables = [
      ...pTasks.filter((t) => getTaskType(t) === "action").map((t) => ({ t, isMilestone:false, sortDate:t.start })),
      ...pMilestones.map((t) => ({ t, isMilestone:true, sortDate:t.end })),
    ].sort((a,b) => a.sortDate.localeCompare(b.sortDate));

    const GAP = 22;
    const DENSE_MIN_LANES = branchables.length >= 10 ? 4 : branchables.length >= 6 ? 3 : branchables.length >= 3 ? 2 : 1;
    const aboveLanesEnd = [];
    const belowLanesEnd = [];
    let maxAboveDepth = 0, maxBelowDepth = 0;

    const ensureLane = (arr, idx) => {
      while (arr.length <= idx) arr.push(-Infinity);
    };

    // Actions + jalons : on répartit volontairement les éléments sur plusieurs
    // hauteurs quand la ligne devient dense. L'ancienne logique réutilisait trop
    // vite la première voie libre, ce qui finissait par créer une longue "phrase"
    // horizontale quasi unique et très difficile à lire.
    const branchItems = branchables.map(({ t, isMilestone }, i) => {
      const side = i % 2 === 0 ? -1 : 1;
      const startX = isMilestone ? xFor(t.end) : xFor(t.start);
      const endX = xFor(t.end);

      const font = isMilestone ? "700 10.5px Inter, sans-serif" : "700 10.5px Inter, sans-serif";
      const titleW = pmMeasureText(t.title || "", font);
      const extraW = isMilestone ? 52 : chipsWidthFor(t);

      // Emprise visuelle réellement protégée : station + titre + badges + marge.
      const visualStart = Math.min(startX - 12, endX - 10);
      const visualEnd = endX + 20 + titleW + extraW + 22;

      const lanesEnd = side === -1 ? aboveLanesEnd : belowLanesEnd;
      const preferred = Math.floor(i / 2) % DENSE_MIN_LANES;
      ensureLane(lanesEnd, preferred);

      let lane = -1;
      // Cherche d'abord à partir du palier préféré, puis dans les autres paliers.
      const order = [
        ...Array.from({length:lanesEnd.length}, (_,k) => (preferred + k) % lanesEnd.length),
      ];
      for (const idx of order) {
        if (visualStart > lanesEnd[idx] + GAP) { lane = idx; break; }
      }
      if (lane === -1) {
        lane = lanesEnd.length;
        lanesEnd.push(visualEnd);
      } else {
        lanesEnd[lane] = visualEnd;
      }

      const branchDist = TASK_OFFSET + lane * TASK_STEP;
      const subtasks = [];
      let maxDepth = branchDist;
      if (showSubtasks && !isMilestone && t.checklist && t.checklist.length) {
        t.checklist.forEach((sub) => {
          const subX = xFor(sub.end || t.end);
          const subLane = lanesEnd.length;
          lanesEnd.push(subX + 16);
          const subDepth = TASK_OFFSET + subLane * TASK_STEP;
          subtasks.push({ sub, depth:subDepth });
          maxDepth = Math.max(maxDepth, subDepth);
        });
      }

      if (side === -1) maxAboveDepth = Math.max(maxAboveDepth, maxDepth);
      else maxBelowDepth = Math.max(maxBelowDepth, maxDepth);
      return { t, isMilestone, side, branchDist, subtasks, activityOffset:0 };
    });

    // Activités : la voie principale reste prioritaire. En cas de chevauchement
    // temporel OU de chevauchement de libellé, on crée automatiquement des voies
    // parallèles proches de la ligne projet au lieu d'empiler toutes les activités.
    const activityLaneEnds = [];
    const activityItems = activities.map((t) => {
      const x0 = xFor(t.start), x1 = Math.max(xFor(t.end), x0 + 10);
      const titleW = pmMeasureText(t.title || "", "800 10.5px Inter, sans-serif");
      const visualStart = x0 - 12;
      const visualEnd = Math.max(x1 + 12, (x0 + x1) / 2 + titleW / 2 + 18);

      let lane = activityLaneEnds.findIndex((endPx) => visualStart > endPx + 18);
      if (lane === -1) {
        lane = activityLaneEnds.length;
        activityLaneEnds.push(visualEnd);
      } else {
        activityLaneEnds[lane] = visualEnd;
      }

      // 0 = ligne projet. Les voies supplémentaires alternent haut/bas.
      let activityOffset = 0;
      if (lane > 0) {
        const level = Math.ceil(lane / 2);
        activityOffset = (lane % 2 ? -1 : 1) * (24 + (level - 1) * 28);
      }
      if (activityOffset < 0) maxAboveDepth = Math.max(maxAboveDepth, Math.abs(activityOffset) + 28);
      if (activityOffset > 0) maxBelowDepth = Math.max(maxBelowDepth, activityOffset + 28);

      return { t, isMilestone:false, side:activityOffset < 0 ? -1 : 1, branchDist:Math.abs(activityOffset), subtasks:[], activityOffset };
    });

    return {
      items:[...activityItems, ...branchItems].sort((a,b) => {
        const da = a.isMilestone ? a.t.end : a.t.start;
        const db = b.isMilestone ? b.t.end : b.t.start;
        return da.localeCompare(db);
      }),
      maxAboveDepth,
      maxBelowDepth
    };
  };

  // ----------------------------------------------------------
  // MODE ÉCHÉANCES
  // ----------------------------------------------------------
  // Une seule logique de hauteur par projet, calculée à partir du nombre
  // maximal d'échéances simultanées. Les offsets sont symétriques autour de la
  // ligne principale et créent une topologie "diverge / converge" lisible.
  const buildDeadlineLayout = (row) => {
    const all = [...row.pTasks, ...row.pMilestones]
      .filter((t) => t.end)
      .sort((a,b) => a.end.localeCompare(b.end) || (a.title || "").localeCompare(b.title || ""));

    const byDate = new Map();
    all.forEach((t) => {
      if (!byDate.has(t.end)) byDate.set(t.end, []);
      byDate.get(t.end).push(t);
    });

    const groups = [...byDate.entries()]
      .map(([date,tasksForDate]) => ({ date, tasks:tasksForDate }))
      .sort((a,b) => a.date.localeCompare(b.date));

    const maxCount = Math.max(1, ...groups.map((g) => g.tasks.length));

    // Échéances : placement 2D + routage des connecteurs.
    // Les étiquettes et leurs liaisons sont traitées comme des obstacles réels.
    const STATION_GAP = 31;
    const LABEL_TITLE_H = 15;
    const LABEL_META_H = 13;
    const LABEL_META_GAP = 1;
    const LABEL_BLOCK_H = LABEL_TITLE_H + LABEL_META_GAP + LABEL_META_H;
    const LABEL_GAP_X = 8;
    const LABEL_GAP_Y = 5;
    const LABEL_BASE_OFFSET = 17;
    const LABEL_LANE_GAP = 18;
    const CONNECTOR_CLEARANCE = 4;
    // Le mode échéances doit rester compact : on privilégie le déplacement
    // horizontal et les croisements de connecteurs avant d'ajouter
    // de la hauteur au projet.
    const MAX_LABEL_LANES = 4;
    // PROXIMITÉ AU JALON : la distance du libellé est désormais fortement pénalisée.
    const PREFERRED_MAX_LABEL_SHIFT = 96;
    const ABSOLUTE_MAX_LABEL_SHIFT = 140;

    const spreadFor = (n) => {
      if (n <= 1) return [0];
      const center = (n - 1) / 2;
      return Array.from({length:n}, (_,i) => (i - center) * STATION_GAP);
    };

    const baseGroups = groups.map((g) => ({
      ...g,
      x:xFor(g.date),
      offsets:spreadFor(g.tasks.length),
      placements:[],
    }));

    const stationBoxes = [];
    baseGroups.forEach((g) => {
      g.offsets.forEach((off) => {
        stationBoxes.push({
          x1:g.x - 14, x2:g.x + 14,
          y1:off - 14, y2:off + 14,
        });
      });
    });

    const placed = [];
    const connectorSegments = [];

    const intersects = (a,b,padX=0,padY=0) =>
      !(a.x2 + padX <= b.x1 || a.x1 - padX >= b.x2 ||
        a.y2 + padY <= b.y1 || a.y1 - padY >= b.y2);

    const segmentIntersectsBox = (seg, box, pad=0) => {
      const bx1 = box.x1 - pad;
      const bx2 = box.x2 + pad;
      const by1 = box.y1 - pad;
      const by2 = box.y2 + pad;

      if (seg.x1 === seg.x2) {
        const x = seg.x1;
        const y1 = Math.min(seg.y1, seg.y2);
        const y2 = Math.max(seg.y1, seg.y2);
        return x >= bx1 && x <= bx2 && y2 >= by1 && y1 <= by2;
      }

      const y = seg.y1;
      const x1 = Math.min(seg.x1, seg.x2);
      const x2 = Math.max(seg.x1, seg.x2);
      return y >= by1 && y <= by2 && x2 >= bx1 && x1 <= bx2;
    };

    const perpendicularCross = (a,b) => {
      const aVertical = a.x1 === a.x2;
      const bVertical = b.x1 === b.x2;
      if (aVertical === bVertical) return false;

      const v = aVertical ? a : b;
      const h = aVertical ? b : a;
      const vx = v.x1;
      const hy = h.y1;
      const vy1 = Math.min(v.y1, v.y2);
      const vy2 = Math.max(v.y1, v.y2);
      const hx1 = Math.min(h.x1, h.x2);
      const hx2 = Math.max(h.x1, h.x2);

      if (vx < hx1 || vx > hx2 || hy < vy1 || hy > vy2) return false;

      // Un simple contact à une extrémité reste lisible ; un croisement en plein
      // segment est refusé.
      const atVEnd = Math.abs(hy - vy1) < .5 || Math.abs(hy - vy2) < .5;
      const atHEnd = Math.abs(vx - hx1) < .5 || Math.abs(vx - hx2) < .5;
      return !(atVEnd && atHEnd);
    };

    const makeConnector = (sourceX, sourceY, labelX, topY, side, lane) => {
      const entryY = side === "above" ? topY + LABEL_BLOCK_H : topY;
      // Chaque voie possède son propre rail ; les liaisons voisines deviennent
      // parallèles plutôt que de se couper en diagonale.
      const railOffset = CONNECTOR_CLEARANCE + Math.min(5, lane * .45);
      const railY = side === "above" ? entryY + railOffset : entryY - railOffset;

      return [
        {x1:sourceX, y1:sourceY, x2:sourceX, y2:railY},
        {x1:sourceX, y1:railY, x2:labelX, y2:railY},
        {x1:labelX, y1:railY, x2:labelX, y2:entryY},
      ];
    };

    const labelBoxCollides = (box) => {
      if (placed.some((p) => intersects(box,p,LABEL_GAP_X,LABEL_GAP_Y))) return true;
      if (stationBoxes.some((s) => intersects(box,s,5,5))) return true;
      if (connectorSegments.some((seg) => segmentIntersectsBox(seg, box, 3))) return true;
      return false;
    };

    const connectorCollides = (segments) => {
      // Le connecteur courant ne doit traverser aucune étiquette déjà placée.
      if (segments.some((seg) => placed.some((box) => segmentIntersectsBox(seg, box, 3)))) {
        return true;
      }

      // Refuse les croisements perpendiculaires. Les troncs colinéaires peuvent
      // se superposer : visuellement ils fusionnent comme une vraie bifurcation métro.
      return segments.some((seg) =>
        connectorSegments.some((existing) => perpendicularCross(seg, existing))
      );
    };

    let seq = 0;
    let maxAbove = 0;
    let maxBelow = 0;

    baseGroups.forEach((g) => {
      g.tasks.forEach((t,i) => {
        const rawTitle = String(t.title || "Sans titre");
        const displayTitle = rawTitle.length > 27 ? rawTitle.slice(0,26) + "…" : rawTitle;
        const titleW = Math.min(
          168,
          Math.max(60, pmMeasureText(displayTitle, "700 10px Inter, sans-serif"))
        );
        const blockW = Math.max(titleW + 12, 86);
        const stationY = g.offsets[i];

        // Le côté préféré dépend aussi de la position verticale de la station :
        // une station déjà haute privilégie le haut, une station basse le bas.
        const preferredSide = stationY < -2
          ? "above"
          : stationY > 2
            ? "below"
            : ((seq++ % 2 === 0) ? "above" : "below");

        // Les petits décalages sont testés avant les grands, mais dans un ordre
        // alterné qui conserve au maximum l'ordre temporel des étiquettes.
        const shifts = [0, -30, 30, -60, 60, -90, 90, -120, 120, -150, 150];
        const sides = [preferredSide, preferredSide === "above" ? "below" : "above"];
        let chosen = null;

        outer:
        for (const side of sides) {
          for (let lane=0; lane<MAX_LABEL_LANES; lane++) {
            const dy = LABEL_BASE_OFFSET + lane * LABEL_LANE_GAP;
            const topY = side === "above"
              ? stationY - dy - LABEL_BLOCK_H
              : stationY + dy;

            for (const shift of shifts) {
              const halfW = blockW / 2;
              const minCenter = 12 + halfW;
              const maxCenter = Math.max(minCenter, chartWidth - 20 - halfW);
              const labelX = Math.max(minCenter, Math.min(maxCenter, g.x + shift));
              const box = {
                x1:labelX - halfW,
                x2:labelX + halfW,
                y1:topY,
                y2:topY + LABEL_BLOCK_H,
              };

              if (labelBoxCollides(box)) continue;

              const segments = makeConnector(
                g.x,
                stationY,
                labelX,
                topY,
                side,
                lane,
              );

              if (connectorCollides(segments)) continue;

              chosen = {
                side,
                lane,
                labelX,
                titleW,
                displayTitle,
                titleTopRel:topY,
                box,
                connectorSegments:segments,
              };
              break outer;
            }
          }
        }

        // Zone dense : on évalue toutes les positions compactes et on choisit
        // celle qui produit le moins de croisements de connecteurs. Les textes
        // et stations restent des obstacles stricts.
        if (!chosen) {
          const relaxedSides = [preferredSide, preferredSide === "above" ? "below" : "above"];
          let bestRelaxed = null;

          const crossingCount = (segments) => segments.reduce((count, seg) =>
            count + connectorSegments.reduce((n, existing) => n + (perpendicularCross(seg, existing) ? 1 : 0), 0), 0);

          const connectorBoxHits = (segments) => segments.reduce((count, seg) =>
            count + placed.reduce((n, box) => n + (segmentIntersectsBox(seg, box, 2) ? 1 : 0), 0), 0);

          for (const side of relaxedSides) {
            for (let lane=0; lane<MAX_LABEL_LANES; lane++) {
              const dy = LABEL_BASE_OFFSET + lane * LABEL_LANE_GAP;
              const topY = side === "above"
                ? stationY - dy - LABEL_BLOCK_H
                : stationY + dy;
              const halfW = blockW / 2;
              const minCenter = 12 + halfW;
              const maxCenter = Math.max(minCenter, chartWidth - 20 - halfW);

              for (const shift of shifts) {
                const labelX = Math.max(minCenter, Math.min(maxCenter, g.x + shift));
                const box = {
                  x1:labelX - halfW,
                  x2:labelX + halfW,
                  y1:topY,
                  y2:topY + LABEL_BLOCK_H,
                };

                if (placed.some((p) => intersects(box,p,LABEL_GAP_X,LABEL_GAP_Y))) continue;
                if (stationBoxes.some((st) => intersects(box,st,4,4))) continue;

                const segments = makeConnector(g.x, stationY, labelX, topY, side, lane);
                const crosses = crossingCount(segments);
                const textHits = connectorBoxHits(segments);
                const horizontalTravel = Math.abs(labelX - g.x);

                // Les croisements coûtent très cher ; on préfère une voie un peu
                // plus éloignée ou un léger décalage horizontal.
                const score = crosses * 10000 + textHits * 20000 + horizontalTravel * 1.4 + lane * 18 + (side === preferredSide ? 0 : 8);

                if (!bestRelaxed || score < bestRelaxed.score) {
                  bestRelaxed = { score, side, lane, labelX, topY, box, segments };
                }
              }
            }
          }

          if (bestRelaxed) {
            chosen = {
              side:bestRelaxed.side,
              lane:bestRelaxed.lane,
              labelX:bestRelaxed.labelX,
              titleW,
              displayTitle,
              titleTopRel:bestRelaxed.topY,
              box:bestRelaxed.box,
              connectorSegments:bestRelaxed.segments,
            };
          }
        }

        // Dernier recours : choisir la position compacte qui recouvre le moins
        // les autres libellés, sans jamais projeter le titre à plusieurs
        // centaines de pixels de sa station.
        if (!chosen) {
          let best = null;
          const compactSides = [preferredSide, preferredSide === "above" ? "below" : "above"];

          const overlapArea = (a,b) => {
            const w = Math.max(0, Math.min(a.x2,b.x2) - Math.max(a.x1,b.x1));
            const h = Math.max(0, Math.min(a.y2,b.y2) - Math.max(a.y1,b.y1));
            return w * h;
          };

          for (const side of compactSides) {
            for (let lane=0; lane<MAX_LABEL_LANES; lane++) {
              const dy = LABEL_BASE_OFFSET + lane * LABEL_LANE_GAP;
              const topY = side === "above"
                ? stationY - dy - LABEL_BLOCK_H
                : stationY + dy;
              const halfW = blockW / 2;
              const minCenter = 12 + halfW;
              const maxCenter = Math.max(minCenter, chartWidth - 20 - halfW);

              for (const shift of shifts) {
                const labelX = Math.max(minCenter, Math.min(maxCenter, g.x + shift));
                const box = {
                  x1:labelX-halfW,
                  x2:labelX+halfW,
                  y1:topY,
                  y2:topY+LABEL_BLOCK_H,
                };

                const labelPenalty = placed.reduce((sum,p) => sum + overlapArea(box,p), 0);
                const stationPenalty = stationBoxes.reduce((sum,st) => sum + overlapArea(box,st) * 4, 0);
                const segments = makeConnector(g.x, stationY, labelX, topY, side, lane);
                const crossings = segments.reduce((count, seg) =>
                  count + connectorSegments.reduce((n, existing) => n + (perpendicularCross(seg, existing) ? 1 : 0), 0), 0);
                const connectorTextHits = segments.reduce((count, seg) =>
                  count + placed.reduce((n, pb) => n + (segmentIntersectsBox(seg, pb, 2) ? 1 : 0), 0), 0);
                const distancePenalty = Math.abs(labelX - g.x) * 1.2 + lane * 14;
                const score = labelPenalty * 8 + stationPenalty * 12 + crossings * 12000 + connectorTextHits * 24000 + distancePenalty;

                if (!best || score < best.score) {
                  best = { score, side, lane, labelX, box, topY, segments };
                }
              }
            }
          }

          chosen = {
            side:best.side,
            lane:best.lane,
            labelX:best.labelX,
            titleW,
            displayTitle,
            titleTopRel:best.topY,
            box:best.box,
            connectorSegments:best.segments || makeConnector(g.x, stationY, best.labelX, best.topY, best.side, best.lane),
          };
        }

        placed.push(chosen.box);
        chosen.connectorSegments.forEach((seg) => connectorSegments.push(seg));

        if (chosen.side === "above") {
          maxAbove = Math.max(maxAbove, -chosen.box.y1);
        } else {
          maxBelow = Math.max(maxBelow, chosen.box.y2);
        }

        g.placements.push(chosen);
      });
    });

    const maxStationUp = Math.max(
      0,
      ...baseGroups.flatMap((g) => g.offsets.map((v) => Math.max(0,-v)))
    );
    const maxStationDown = Math.max(
      0,
      ...baseGroups.flatMap((g) => g.offsets.map((v) => Math.max(0,v)))
    );
    const aboveDepth = Math.max(maxAbove, maxStationUp + 16);
    const belowDepth = Math.max(maxBelow, maxStationDown + 16);

    // Avec MAX_LABEL_LANES borné, la hauteur reste naturellement compacte
    // (plus de fallback ±840 px) tout en conservant les textes dans le SVG.
    const ROW_H = collapsed[row.project.id]
      ? 56
      : Math.max(92, aboveDepth + belowDepth + 20);
    const mainY = collapsed[row.project.id]
      ? 28
      : aboveDepth + 12;

    return {
      groups:baseGroups,
      maxCount,
      ROW_H,
      mainY,
      aboveDepth,
      belowDepth,
    };
  };

  const branchPath = (x0, y0, x1, y1) => {
    const bend = Math.min(16, Math.abs(x1 - x0) / 2 || 16);
    const dirY = y1 > y0 ? 1 : -1;
    const dirX = x1 >= x0 ? 1 : -1;
    if (Math.abs(x1 - x0) < 1) return `M ${x0} ${y0} L ${x0} ${y1}`;
    return `M ${x0} ${y0} L ${x0} ${y1 - dirY * bend} Q ${x0} ${y1} ${x0 + dirX * bend} ${y1} L ${x1} ${y1}`;
  };

  // Station de métro : bulle blanche cerclée, ou coche verte pleine pour une tâche terminée
  const Station = ({ x, y, color, r = 5, done, icon, justCompleted }) => {
    if (icon) {
      return (
        <g>
          <circle cx={x} cy={y} r={r} fill="#fff" stroke={color} strokeWidth="2.2" />
          <foreignObject x={x - r * 0.85} y={y - r * 0.85} width={r * 1.7} height={r * 1.7} style={{ overflow: "visible", pointerEvents: "none" }}>
            <div style={{ width: "100%", height: "100%", display: "flex", alignItems: "center", justifyContent: "center" }}>
              <IconGlyph icon={icon} size={r * 1.5} />
            </div>
          </foreignObject>
        </g>
      );
    }
    return done ? (
      <g className={justCompleted ? "lp-anim-check-pop" : undefined} style={justCompleted ? { transformBox: "fill-box", transformOrigin: "center" } : undefined}>
        <circle cx={x} cy={y} r={r} fill="var(--success)" stroke="var(--success)" strokeWidth="2" />
        <path className={justCompleted ? "lp-anim-check-draw" : undefined} d={`M ${x - r * 0.5} ${y} L ${x - r * 0.12} ${y + r * 0.42} L ${x + r * 0.55} ${y - r * 0.42}`} stroke="#fff" strokeWidth={Math.max(1.3, r * 0.32)} fill="none" strokeLinecap="round" strokeLinejoin="round" />
      </g>
    ) : (
      <circle cx={x} cy={y} r={r} fill="#fff" stroke={color} strokeWidth="2.2" />
    );
  };

  // Terminus : véritable symbole de butoir de métro (barre perpendiculaire +
  // demi-disque plein), jamais un emoji — la ligne s'arrête littéralement contre
  // un butoir, comme un vrai terminus de fin de voie.
  const Terminus = ({ x, y, color, size = 1 }) => (
    <g>
      <line x1={x} y1={y - 9 * size} x2={x} y2={y + 9 * size} stroke={color} strokeWidth={2.5 * size} strokeLinecap="round" />
      <path d={`M ${x} ${y - 7 * size} A ${7 * size} ${7 * size} 0 0 1 ${x} ${y + 7 * size} Z`} fill={color} transform={`translate(${5 * size}, 0)`} opacity="0.9" />
    </g>
  );

  const resetZoom = () => setZoomKey("auto");
  const accent = appearance?.accentColor || "#FF7A3D";

  // Export "affiche" — une image vectorielle (SVG) autonome et redimensionnable à
  // l'infini sans perte, dans le même esprit graphique que le plan de métro
  // affiché à l'écran : un tronc par projet, ses jalons, sa fin. Vectoriel plutôt
  // que pixellisé pour rester net à n'importe quelle taille d'impression.
  const exportPoster = () => {
    if (rows.length === 0) return;
    const PW = 1600, PAD_L = 260, PAD_R = 80, ROW_H2 = 90, HEADER_H = 110, FOOTER_H = 60;
    const PH = HEADER_H + rows.length * ROW_H2 + FOOTER_H;
    const px = (d) => PAD_L + ((dayIndex(d) - originIdx) / totalDays) * (PW - PAD_L - PAD_R);
    const esc = (s) => String(s || "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
    const parts = [];
    parts.push(`<svg xmlns="http://www.w3.org/2000/svg" width="${PW}" height="${PH}" viewBox="0 0 ${PW} ${PH}" font-family="Inter, Arial, sans-serif">`);
    parts.push(`<rect x="0" y="0" width="${PW}" height="${PH}" fill="#ffffff" />`);
    parts.push(`<text x="40" y="42" font-size="24" font-weight="800" fill="#0B1526">Planning Projets</text>`);
    parts.push(`<text x="40" y="66" font-size="12.5" fill="#64748B">Exporté le ${esc(fmtShort(iso(new Date())))} · ${esc(fmtShort(globalMin))} → ${esc(fmtShort(globalMax))}</text>`);
    parts.push(`<line x1="40" y1="${HEADER_H - 20}" x2="${PW - 40}" y2="${HEADER_H - 20}" stroke="#E2E8F0" stroke-width="1.5" />`);
    rows.forEach((row, i) => {
      const laneY = HEADER_H + i * ROW_H2 + ROW_H2 / 2;
      const color = row.project.color || "var(--text-muted)";
      parts.push(`<text x="40" y="${laneY - 6}" font-size="14" font-weight="800" fill="${color}">${esc(row.project.name)}</text>`);
      parts.push(`<text x="40" y="${laneY + 12}" font-size="11" fill="#64748B">${row.avgProgress}% d'avancement</text>`);
      const x0 = px(row.minDate), x1 = px(row.maxDate);
      parts.push(`<line x1="${x0}" y1="${laneY}" x2="${x1}" y2="${laneY}" stroke="${color}" stroke-width="4" stroke-linecap="round" opacity="0.35" />`);
      parts.push(`<line x1="${x0}" y1="${laneY}" x2="${x0 + (x1 - x0) * (row.avgProgress / 100)}" y2="${laneY}" stroke="${color}" stroke-width="4" stroke-linecap="round" />`);
      parts.push(`<circle cx="${x0}" cy="${laneY}" r="6" fill="${color}" />`);
      row.pMilestones.forEach((t) => {
        const mx = px(t.end);
        const done = isTaskDoneGlobal(t, ctx);
        const stColor = ctx.statuses.find((s) => s.id === t.statusId)?.color || color;
        parts.push(`<g transform="translate(${mx}, ${laneY}) rotate(45)"><rect x="-6" y="-6" width="12" height="12" fill="${done ? stColor : "#fff"}" stroke="${stColor}" stroke-width="2" /></g>`);
        const titleW = pmMeasureText(t.title, "700 10px Inter, sans-serif");
        parts.push(`<rect x="${mx + 10}" y="${laneY - 17}" width="${titleW + 8}" height="15" fill="#fff" opacity="0.9" />`);
        parts.push(`<text x="${mx + 14}" y="${laneY - 6}" font-size="10" font-weight="700" fill="#0B1526">${esc(t.title)}</text>`);
      });
      parts.push(`<line x1="${x1 + 6}" y1="${laneY - 9}" x2="${x1 + 6}" y2="${laneY + 9}" stroke="${color}" stroke-width="2.5" stroke-linecap="round" /><path d="M ${x1 + 6} ${laneY - 7} A 7 7 0 0 1 ${x1 + 6} ${laneY + 7} Z" fill="${color}" transform="translate(5, 0)" opacity="0.9" />`);
    });
    parts.push(`<text x="40" y="${PH - 24}" font-size="10.5" fill="var(--text-muted)">Généré avec Nexora — ${esc(fmtShort(iso(new Date())))}</text>`);
    parts.push(`</svg>`);
    const blob = new Blob([parts.join("\n")], { type: "image/svg+xml" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = `planning-projets-${iso(new Date())}.svg`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  };

  const rowsWithHeights = useMemo(() => {
    return rows.map((row) => {
      if (deadlineMode) {
        const deadline = buildDeadlineLayout(row);
        return {
          ...row,
          items:[],
          deadlineGroups:deadline.groups,
          deadlineMaxCount:deadline.maxCount,
          ROW_H:deadline.ROW_H,
          mainY:deadline.mainY,
        };
      }
      const { items, maxAboveDepth, maxBelowDepth } = buildLayout(row.pTasks, row.pMilestones);
      const ROW_H = collapsed[row.project.id] ? 56 : Math.max(170, maxAboveDepth + maxBelowDepth + 92);
      const mainY = collapsed[row.project.id] ? 28 : maxAboveDepth + 46;
      return { ...row, items, ROW_H, mainY };
    });
  }, [rows, dayWidth, originIdx, collapsed, showSubtasks, fields, deadlineMode]);

  // Confettis de fin de projet (Réglages > Apparence) — détection stable, pas dans
  // le composant ProjectConfetti lui-même (qui peut être remonté à chaque rendu,
  // comme observé pour la coche de complétion — voir plus haut).
  const wasProjectDoneRef = useRef({});
  const [confettiProjectIds, setConfettiProjectIds] = useState(() => new Set());
  const rowsAvgProgress = useMemo(() => {
    const map = {};
    rowsWithHeights.forEach((row) => { map[row.project.id] = row.avgProgress; });
    return map;
  }, [rowsWithHeights]);
  useEffect(() => {
    if (!appearance?.animConfetti) return undefined;
    const newlyComplete = [];
    Object.entries(rowsAvgProgress).forEach(([pid, prog]) => {
      const was = wasProjectDoneRef.current[pid];
      if (prog >= 100 && was !== undefined && was < 100) newlyComplete.push(pid);
      wasProjectDoneRef.current[pid] = prog;
    });
    if (newlyComplete.length === 0) return undefined;
    setConfettiProjectIds((prev) => new Set([...prev, ...newlyComplete]));
    const tm = setTimeout(() => {
      setConfettiProjectIds((prev) => {
        const next = new Set(prev);
        newlyComplete.forEach((id) => next.delete(id));
        return next;
      });
    }, 1200);
    return () => clearTimeout(tm);
  }, [rowsAvgProgress, appearance?.animConfetti]);

  const monthBands = useMemo(() => {
    const arr = [];
    let cur = unitStart(globalMin, "month");
    let i = 0;
    let guard = 0;
    while (dayIndex(cur) <= dayIndex(globalMax) && guard < 200) {
      const next = addDays(cur, unitLen(cur, "month"));
      if (i % 2 === 1) arr.push({ x0: xFor(cur), x1: xFor(next) });
      cur = next;
      i++;
      guard++;
    }
    return arr;
  }, [globalMin, globalMax, dayWidth, originIdx]);

  // Trame week-ends : repères de fond utiles pour un planning chantier en jours
  // ouvrés. N'apparaît qu'à un zoom suffisamment large pour rester lisible (sinon
  // ça devient un bruit visuel plutôt qu'une aide).
  const weekendBands = useMemo(() => {
    if (dayWidth < 6) return [];
    const arr = [];
    let cur = globalMin;
    let guard = 0;
    while (dayIndex(cur) <= dayIndex(globalMax) && guard < 2000) {
      const dow = new Date(cur + "T00:00:00").getDay(); // 0 = dimanche, 6 = samedi
      if (dow === 0 || dow === 6) arr.push({ x0: xFor(cur), x1: xFor(addDays(cur, 1)) });
      cur = addDays(cur, 1);
      guard++;
    }
    return arr;
  }, [globalMin, globalMax, dayWidth, originIdx]);

  // Espace réservé ENTRE deux lignes adjacentes qui partagent au moins une tâche —
  // un véritable territoire dédié au tronc commun, plutôt que de faire cohabiter la
  // bifurcation avec les branches de dépendance existantes de chaque ligne (ce qui
  // créait des croisements confus, non reliés visuellement à leur origine).
  const SHARED_GAP_H = 58;
  const visibleProjectIdsEarly = useMemo(() => new Set(rowsWithHeights.map((r) => r.project.id)), [rowsWithHeights]);
  // Plusieurs tâches partagées entre les MÊMES deux lignes, qui se chevauchent dans
  // le temps, doivent occuper des "voies" distinctes dans l'espace dédié plutôt que
  // de se superposer sur le même axe — même logique de répartition que les tâches
  // qui se chevauchent au sein d'une seule ligne de projet (side/branchDist),
  // appliquée ici à l'intérieur de l'espace partagé.
  const { rowGapAfter, sharedTaskLane } = useMemo(() => {
    if (deadlineMode) return { rowGapAfter:{}, sharedTaskLane:{} };
    const orderIndex = {};
    rowsWithHeights.forEach((r, i) => { orderIndex[r.project.id] = i; });
    const byPair = {}; // topProjectId -> tâches partagées concernées, triées par début
    dated.forEach((t) => {
      if (!t.secondaryProjectId) return;
      if (!visibleProjectIdsEarly.has(t.projectId) || !visibleProjectIdsEarly.has(t.secondaryProjectId)) return;
      const i1 = orderIndex[t.projectId], i2 = orderIndex[t.secondaryProjectId];
      if (i1 == null || i2 == null) return;
      const topIdx = Math.min(i1, i2), botIdx = Math.max(i1, i2);
      if (botIdx - topIdx !== 1) return; // pour l'instant, uniquement les lignes directement voisines
      const topProjectId = rowsWithHeights[topIdx].project.id;
      (byPair[topProjectId] = byPair[topProjectId] || []).push(t);
    });
    const gaps = {}, lanes = {};
    Object.entries(byPair).forEach(([topProjectId, tasksForPair]) => {
      // Répartition par EMPRISE VISUELLE, pas seulement par dates.
      // Le libellé d'une tâche partagée peut dépasser largement sa durée réelle :
      // deux tâches temporellement distinctes peuvent donc avoir des textes qui se
      // chevauchent. Chaque voie mémorise désormais la fin en pixels de tout ce qui
      // est visible (tronc + titre + marge), et non simplement la date de fin.
      const visualItems = tasksForPair.map((t) => {
        const x0 = xFor(t.start);
        const x1 = Math.max(xFor(t.end), x0 + (t.milestone ? 0 : 30));
        const titleW = pmMeasureText(t.title || "", "700 10.5px Inter, sans-serif");
        const labelStart = t.milestone ? x0 + 16 : x0;
        const labelEnd = labelStart + titleW + 18;
        return {
          t,
          visualStart: Math.min(x0 - 14, labelStart - 4),
          visualEnd: Math.max(x1 + 14, labelEnd),
        };
      }).sort((a, b) => a.visualStart - b.visualStart);

      const laneEndPx = [];
      visualItems.forEach(({ t, visualStart, visualEnd }) => {
        // 14 px de respiration horizontale entre deux libellés sur une même voie.
        let laneIdx = laneEndPx.findIndex((endPx) => endPx + 14 <= visualStart);
        if (laneIdx === -1) {
          laneIdx = laneEndPx.length;
          laneEndPx.push(visualEnd);
        } else {
          laneEndPx[laneIdx] = visualEnd;
        }
        lanes[t.id] = laneIdx;
      });
      gaps[topProjectId] = laneEndPx.length * SHARED_GAP_H;
    });
    return { rowGapAfter: gaps, sharedTaskLane: lanes };
  }, [rowsWithHeights, dated, visibleProjectIdsEarly, dayWidth, originIdx, deadlineMode]);
  const totalGapHeight = Object.values(rowGapAfter).reduce((s, v) => s + v, 0);

  // ==========================================================================
  // ANNOTATIONS — mêmes données, mêmes règles et mêmes fonctions pures que le
  // Gantt et le Mini-Gantt. Rien n'est recalculé ici : seule la GÉOMÉTRIE
  // change, parce qu'une ligne du Métro est un projet et non une tâche.
  //
  // Stockage : dans les préférences de la vue (comme le Gantt complet), ou
  // pilotées de l'extérieur quand la vue est embarquée dans un widget.
  // ==========================================================================
  const annotationsControlled = typeof onAnnotationsChange === "function";
  const annotationSource = annotationsControlled ? (annotations || {}) : prefs;
  const rawTemporalBlocks = useMemo(() => (Array.isArray(annotationSource.temporalBlocks) ? annotationSource.temporalBlocks : []), [annotationSource.temporalBlocks]);
  const rawHighlightFrames = useMemo(() => (Array.isArray(annotationSource.highlightFrames) ? annotationSource.highlightFrames : []), [annotationSource.highlightFrames]);
  const rawMilestones = useMemo(() => (Array.isArray(annotationSource.milestones) ? annotationSource.milestones : []), [annotationSource.milestones]);
  const rawNotes = useMemo(() => (Array.isArray(annotationSource.notes) ? annotationSource.notes : []), [annotationSource.notes]);
  const applyAnnotations = (patch) => {
    const next = {
      temporalBlocks: rawTemporalBlocks,
      highlightFrames: rawHighlightFrames,
      milestones: rawMilestones,
      notes: rawNotes,
      ...patch,
    };
    if (annotationsControlled) onAnnotationsChange(next);
    else setPrefs((p) => ({ ...p, ...next }));
  };

  // Méta blocs : la vue Métro n'est pas un tableau de bord, elle reçoit donc
  // ceux qui valent pour TOUS — même règle que la page « Aujourd'hui ».
  const scopedMetaBlocks = useMemo(
    () => metaBlocksForDashboard(metaTemporalBlocks, null).map((b) => ({ ...b, id: "meta:" + b.id, meta: true })),
    [metaTemporalBlocks]
  );
  const temporalBlocks = useMemo(
    () => [...normalizeTemporalBlocks(rawTemporalBlocks), ...scopedMetaBlocks],
    [rawTemporalBlocks, scopedMetaBlocks]
  );
  const highlightFrames = useMemo(() => normalizeHighlightFrames(rawHighlightFrames), [rawHighlightFrames]);
  const configMilestones = useMemo(() => normalizeMiniGanttMilestones(rawMilestones), [rawMilestones]);
  const configNotes = useMemo(() => normalizeMiniGanttNotes(rawNotes), [rawNotes]);
  // Les risques de délai appartiennent aux tâches : ils apparaissent donc ici
  // sans qu'aucun réglage de la vue ne soit nécessaire.
  const taskRisks = useMemo(() => collectTaskDelayRisks(dated), [dated]);

  const xForIdx = (idx) => PM_PAD_LEFT + (idx - originIdx) * dayWidth;
  const [annotationPanel, setAnnotationPanel] = useState(null); // { section, autoCreate }

  // Jalons et annotations partagent une bande de repères au-dessus des lignes.
  // Elle est calculée AVANT la mise en page des lignes, parce que sa hauteur
  // décale tout ce qui suit : sans cela, les repères recouvriraient la première
  // ligne de projet au lieu de lui laisser la place.
  const stripItems = useMemo(() => {
    const items = [];
    configMilestones.forEach((m) => {
      items.push({ kind: "milestone", id: m.id, idx: dayIndex(m.date), label: m.title, color: m.color || MINIGANTT_MILESTONE_COLORS[m.type] || MINIGANTT_MILESTONE_COLORS.standard, type: m.type, data: m });
    });
    configNotes.forEach((n) => {
      // Une annotation ancrée à une tâche, un jalon ou un risque est ramenée à
      // une DATE : c'est la seule chose que la bande de repères sait placer.
      let idx = null;
      if (n.anchor.kind === "date") idx = dayIndex(n.anchor.date);
      else if (n.anchor.kind === "task") { const t = dated.find((x) => x.id === n.anchor.id); if (t) idx = dayIndex(t.end); }
      else if (n.anchor.kind === "milestone") { const m = configMilestones.find((x) => x.id === n.anchor.id); if (m) idx = dayIndex(m.date); }
      else if (n.anchor.kind === "risk") { const r = taskRisks.find((x) => x.id === n.anchor.id); const t = r && dated.find((x) => x.id === r.taskId); if (t) idx = dayIndex(t.end) + (r.endOffset != null ? r.endOffset : 0); }
      if (idx == null || !Number.isFinite(idx)) return;
      items.push({ kind: "note", id: n.id, idx, label: n.title, color: "#64748B", data: n });
    });
    items.sort((a, b) => a.idx - b.idx);
    // Répartition en couloirs sur la largeur RÉELLE : losange, gouttière, puis
    // le texte à ~5,6 px par caractère.
    const laneEnds = [];
    items.forEach((item) => {
      const leftPx = xForIdx(item.idx);
      const widthPx = 20 + String(item.label || "").length * 5.6;
      let lane = laneEnds.findIndex((end) => leftPx >= end + 10);
      if (lane === -1) { lane = laneEnds.length; laneEnds.push(0); }
      laneEnds[lane] = leftPx + widthPx;
      item.lane = lane;
      item.x = leftPx;
    });
    return items;
  }, [configMilestones, configNotes, dated, taskRisks, dayWidth, originIdx]);

  const STRIP_LANE_H = 16;
  const stripLaneCount = stripItems.length ? Math.max(...stripItems.map((i) => i.lane)) + 1 : 0;
  // Hauteur réservée au-dessus des lignes pour cette bande. Zéro sans repère :
  // une vue sans annotation garde exactement sa mise en page d'origine.
  const ANNOT_TOP_H = stripLaneCount ? stripLaneCount * STRIP_LANE_H + 8 : 0;
  // La bande de repères s'ajoute à la hauteur totale : sans cela, la dernière
  // ligne de projet sortirait du calque superposé.
  const totalChartHeight = rowsWithHeights.reduce((s, r) => s + r.ROW_H, 0) + totalGapHeight + ANNOT_TOP_H;

  // Position Y absolue (dans le calque superposé, qui empile toutes les lignes) de
  // l'axe principal de chaque projet — nécessaire pour relier deux lignes de projets
  // différentes (tâche à deux projets) sans dépendre d'une mesure DOM : les lignes
  // sont empilées dans cet ordre exact, avec ces mêmes hauteurs, donc un simple
  // cumul suffit et reste juste même en cours de repli/dépli d'une ligne.
  const rowAbsoluteMainY = useMemo(() => {
    const map = {};
    // Démarre à 50px, PAS 0 : c'est le même décalage codé en dur que .lp-pm-bands
    // (top:50px, hauteur de l'en-tête mois/semaines au-dessus des lignes) — sans
    // lui, toute position calculée ici atterrit 50px trop haut par rapport aux
    // lignes réellement affichées dans le calque superposé (qui, lui, démarre au
    // même point d'ancrage que .lp-pm-bands, pas au sommet des lignes).
    let cursor = 50 + ANNOT_TOP_H;
    rowsWithHeights.forEach((row) => {
      const rh = networkMode ? 60 : row.ROW_H;
      const my = networkMode ? 30 : row.mainY; // NetworkRow centre son unique voie à y=30 dans ses 60px
      map[row.project.id] = cursor + my;
      cursor += rh;
      cursor += rowGapAfter[row.project.id] || 0;
    });
    return map;
  }, [rowsWithHeights, networkMode, rowGapAfter, ANNOT_TOP_H]);
  // Sommet de l'espace réservé (territoire dédié) juste après chaque ligne — sert de
  // base pour positionner chaque VOIE (une par tâche partagée concurrente) à
  // l'intérieur de cet espace, plutôt qu'un unique centre partagé par toutes.
  const rowGapTopAfter = useMemo(() => {
    const map = {};
    let cursor = 50 + ANNOT_TOP_H; // même décalage que ci-dessus
    rowsWithHeights.forEach((row) => {
      cursor += networkMode ? 60 : row.ROW_H;
      const gap = rowGapAfter[row.project.id] || 0;
      if (gap > 0) map[row.project.id] = cursor;
      cursor += gap;
    });
    return map;
  }, [rowsWithHeights, networkMode, rowGapAfter, ANNOT_TOP_H]);

  // Haut et bas de chaque ligne de projet dans le calque superposé : c'est ce
  // qui donne aux encadrés une hauteur exacte, sans mesure du DOM.
  const rowAbsoluteBounds = useMemo(() => {
    const map = {};
    let cursor = 50 + ANNOT_TOP_H;
    rowsWithHeights.forEach((row) => {
      const rh = networkMode ? 60 : row.ROW_H;
      map[row.project.id] = { top: cursor, bottom: cursor + rh };
      cursor += rh + (rowGapAfter[row.project.id] || 0);
    });
    return map;
  }, [rowsWithHeights, networkMode, rowGapAfter, ANNOT_TOP_H]);

  const visibleProjectIds = useMemo(() => new Set(rowsWithHeights.map((r) => r.project.id)), [rowsWithHeights]);

  const isFullyShared = (t) => !!(t.secondaryProjectId && visibleProjectIds.has(t.projectId) && visibleProjectIds.has(t.secondaryProjectId));
  // Courbe douce à trois points (segment droit → virage arrondi → segment droit),
  // même style que branchPath utilisé pour les embranchements de dépendance — pour
  // que la convergence/divergence des deux lignes reste cohérente visuellement.
  const smoothBend = (x0, y0, x1, y1, x2, y2, radius) => {
    const d1 = Math.hypot(x1 - x0, y1 - y0), d2 = Math.hypot(x2 - x1, y2 - y1);
    const r1 = Math.min(radius, d1 / 2), r2 = Math.min(radius, d2 / 2);
    const p1x = x1 - (x1 - x0) / (d1 || 1) * r1, p1y = y1 - (y1 - y0) / (d1 || 1) * r1;
    const p2x = x1 + (x2 - x1) / (d2 || 1) * r2, p2y = y1 + (y2 - y1) / (d2 || 1) * r2;
    return `L ${p1x} ${p1y} Q ${x1} ${y1} ${p2x} ${p2y} `;
  };
  // Trace un filament ondulant (câble tressé) — série de bosses douces alternant
  // au-dessus/en dessous de l'axe central, revenant pile sur l'axe à chaque
  // demi-longueur d'onde. Deux filaments en opposition de phase (voir usage plus
  // bas) donnent l'effet visuel d'une torsade — alternative au dégradé fondu pour
  // le tronc commun d'une tâche à deux projets.
  const buildBraidPath = (x0, x1, yBase, amplitude, wavelength, startsUp) => {
    if (x1 - x0 <= 2) return `M ${x0} ${yBase} L ${x1} ${yBase}`;
    const half = wavelength / 2;
    let d = `M ${x0} ${yBase} `;
    let x = x0, up = startsUp;
    while (x < x1 - 0.5) {
      const nx = Math.min(x + half, x1);
      const midX = (x + nx) / 2;
      const targetY = yBase + (up ? -amplitude : amplitude);
      d += `Q ${midX} ${targetY} ${nx} ${yBase} `;
      x = nx;
      up = !up;
    }
    return d;
  };

  // Flèches de dépendance INTER-projets : chaque projet a son propre <svg>, donc une
  // flèche entre deux tâches de projets différents ne peut pas être tracée localement.
  // On mesure la position réelle de chaque station taguée sur tout le canevas, et on
  // trace un calque unique par-dessus l'ensemble des lignes de projet.
  const crossPositionsRef = useRef({});
  const crossStartPositionsRef = useRef({});
  const [crossVersion, setCrossVersion] = useState(0);
  const remeasureCross = () => {
    if (!scrollRef.current) return;
    const wrapRect = scrollRef.current.getBoundingClientRect();
    const measureAll = (selector, attr) => {
      const nodes = scrollRef.current.querySelectorAll(selector);
      const next = {};
      nodes.forEach((el) => {
        const id = el.getAttribute(attr);
        const rect = el.getBoundingClientRect();
        next[id] = {
          x: rect.left - wrapRect.left + scrollRef.current.scrollLeft + rect.width / 2,
          y: rect.top - wrapRect.top + scrollRef.current.scrollTop + rect.height / 2,
        };
      });
      return next;
    };
    const nextPositions = measureAll("[data-pm-task-id]", "data-pm-task-id");
    // Position du DÉBUT de chaque tâche — pour que les flèches de dépendance
    // inter-projets arrivent sur le début de la tâche suivante (et non sur sa
    // fin). Les jalons n'ont qu'une seule date : pas de marqueur de début séparé
    // pour eux, la position de fin sert de repli naturel.
    const nextStartPositions = measureAll("[data-pm-task-start-id]", "data-pm-task-start-id");
    // Garde essentielle : ne déclenche un nouveau rendu QUE si les positions ont
    // réellement changé. Sans ça, measureAll → setCrossVersion → rendu →
    // ResizeObserver qui re-détecte une variation infime → measureAll à nouveau…
    // crée une boucle de rétroaction quasi continue (mesurée à ~50 appels/seconde
    // en pratique), qui charge le processeur pour rien ET empêche toute animation
    // CSS de progresser (les éléments sont recréés en continu par React avant que
    // l'animation n'ait le temps d'avancer).
    const changed = JSON.stringify(nextPositions) !== JSON.stringify(crossPositionsRef.current)
      || JSON.stringify(nextStartPositions) !== JSON.stringify(crossStartPositionsRef.current);
    crossPositionsRef.current = nextPositions;
    crossStartPositionsRef.current = nextStartPositions;
    if (changed) setCrossVersion((v) => v + 1);
  };
  useEffect(() => {
    if (!scrollRef.current) return;
    const raf = requestAnimationFrame(remeasureCross);
    const ro = new ResizeObserver(() => requestAnimationFrame(remeasureCross));
    ro.observe(scrollRef.current);
    return () => { cancelAnimationFrame(raf); ro.disconnect(); };
  }, [dated, dayWidth, rowsWithHeights.length, collapsed]);
  // Bandes des blocs temporels : bornées à la fenêtre affichée, comme tout le
  // reste de la vue. L'étiquette est verticale, posée sur le bord gauche de la
  // bande — même parti pris que le Gantt complet, et aucun risque de recouvrir
  // une ligne de projet.
  const temporalBlockShapes = useMemo(() => {
    const shapes = [];
    temporalBlocks.forEach((block) => {
      const startIdx = dayIndex(block.startDate);
      const endIdx = dayIndex(block.endDate);
      if (!Number.isFinite(startIdx) || !Number.isFinite(endIdx)) return;
      const x0 = xForIdx(startIdx);
      const x1 = xForIdx(endIdx + 1);
      shapes.push({ block, x0, width: Math.max(2, x1 - x0) });
    });
    // Deux bandes qui démarrent presque au même endroit décalent leur étiquette
    // plutôt que de la superposer.
    const placed = [];
    shapes.slice().sort((a, b) => a.x0 - b.x0).forEach((shape) => {
      const clashes = placed.filter((x) => Math.abs(x.x0 - shape.x0) < 20).length;
      shape.labelOffset = clashes * 14;
      placed.push(shape);
    });
    return shapes;
  }, [temporalBlocks, dayWidth, originIdx]);

  // Encadrés : un cadre par groupe continu de LIGNES DE PROJET, bornes
  // horizontales prises sur les dates réelles des tâches retenues.
  const frameShapes = useMemo(() => {
    const projectById = new Map(dated.map((t) => [t.id, t.projectId]));
    const order = rowsWithHeights.map((r) => r.project.id);
    const segments = metroFrameSegments(highlightFrames, {
      projectOrder: order,
      projectOf: (taskId) => projectById.get(taskId) || null,
    });
    const byId = new Map(dated.map((t) => [t.id, t]));
    return segments.map((seg) => {
      const tasksOf = seg.taskIds.map((id) => byId.get(id)).filter(Boolean);
      if (!tasksOf.length) return null;
      const startIdx = Math.min(...tasksOf.map((t) => dayIndex(t.start)));
      const endIdx = Math.max(...tasksOf.map((t) => dayIndex(t.end)));
      const bounds = seg.projectIds.map((id) => rowAbsoluteBounds[id]).filter(Boolean);
      if (!bounds.length) return null;
      const pad = normalizeGanttPadding(seg.frame.padding);
      const x0 = xForIdx(startIdx) - pad - 10;
      const x1 = xForIdx(endIdx + 1) + pad + 10;
      const top = Math.min(...bounds.map((b) => b.top)) + 6;
      const bottom = Math.max(...bounds.map((b) => b.bottom)) - 6;
      return {
        id: seg.id,
        frame: seg.frame,
        left: x0,
        width: Math.max(12, x1 - x0),
        top,
        height: Math.max(20, bottom - top),
      };
    }).filter(Boolean);
  }, [highlightFrames, dated, rowsWithHeights, rowAbsoluteBounds, dayWidth, originIdx]);

  // Couloirs d'incertitude : posés à la suite de la tâche, sur SA ligne. La
  // position verticale vient de la mesure déjà faite pour les flèches de
  // dépendance — aucune seconde source de vérité.
  const riskShapes = useMemo(() => {
    if (!taskRisks.length) return [];
    const rows = dated.map((t) => ({ id: t.id, startIdx: dayIndex(t.start), endIdx: dayIndex(t.end) }));
    return miniGanttRiskSegments(rows, taskRisks).map((seg) => {
      const pos = crossPositionsRef.current[seg.taskId];
      if (!pos) return null;
      const x0 = xForIdx(seg.startIdx);
      const x1 = xForIdx(seg.endIdx);
      return { seg, left: x0, width: Math.max(4, x1 - x0), y: pos.y };
    }).filter(Boolean);
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [taskRisks, dated, dayWidth, originIdx, crossVersion]);

  const colorOfTask = (t) => ctx.statuses.find((s) => s.id === t.statusId)?.color || "var(--text-muted)";

  // Zones de texte à protéger pour les connecteurs de dépendance inter-projets.
  // Les traits ne doivent jamais traverser un libellé : on estime ici les rectangles
  // réellement occupés par les titres dans le même repère global que le calque SVG.
  const dependencyTextObstacles = useMemo(() => {
    const boxes = [];
    const addBox = (x, y, w, h, taskId) => {
      if (!Number.isFinite(x) || !Number.isFinite(y) || !Number.isFinite(w)) return;
      boxes.push({ x1: x - 5, x2: x + w + 5, y1: y - h / 2 - 4, y2: y + h / 2 + 4, taskId });
    };

    rowsWithHeights.forEach((row) => {
      if (collapsed[row.project.id]) return;
      const rowTop = (rowAbsoluteMainY[row.project.id] || 0) - row.mainY;
      row.items.forEach(({ t, side, branchDist, isMilestone }) => {
        if (isFullyShared(t)) return; // traité plus bas dans l'espace partagé
        const y = rowTop + row.mainY + side * branchDist;
        if (isMilestone) {
          const x = xFor(t.end) + 11;
          const w = pmMeasureText(t.title || "", MS_TITLE_FONT) + 10;
          addBox(x, y, w, 16, t.id);
        } else {
          const x = xFor(t.end) + 7;
          const w = pmMeasureText(t.title || "", TITLE_FONT) + 12;
          addBox(x, y, w, 18, t.id);
        }
      });
    });

    dated.filter((t) => isFullyShared(t)).forEach((t) => {
      const y1 = rowAbsoluteMainY[t.projectId], y2 = rowAbsoluteMainY[t.secondaryProjectId];
      if (y1 == null || y2 == null) return;
      const topProjectId = y1 < y2 ? t.projectId : t.secondaryProjectId;
      const lane = sharedTaskLane[t.id] || 0;
      const gapTop = rowGapTopAfter[topProjectId];
      const midY = gapTop != null ? gapTop + (lane + 0.5) * SHARED_GAP_H : (y1 + y2) / 2;
      const x0 = xFor(t.start);
      const titleW = pmMeasureText(t.title || "", "700 10.5px Inter, sans-serif");
      if (t.milestone) addBox(x0 + 16, midY, titleW + 8, 18, t.id);
      else addBox(x0, midY - 14, titleW + 8, 18, t.id);
    });

    return boxes;
  }, [rowsWithHeights, collapsed, rowAbsoluteMainY, dated, sharedTaskLane, rowGapTopAfter, dayWidth, originIdx]);

  const dependencyLaneX = (fx, fy, tx, ty, fromTaskId, toTaskId) => {
    const yMin = Math.min(fy, ty) - 3;
    const yMax = Math.max(fy, ty) + 3;
    // Le départ vers la GAUCHE est volontaire : les titres de tâches sont placés
    // à droite de leur station de fin. On évite ainsi le texte du prédécesseur dès
    // le premier segment, puis on choisit une voie verticale qui ne traverse aucun
    // autre libellé sur toute la hauteur du connecteur.
    const base = Math.min(fx, tx) - 14;
    const candidates = [base, base - 18, base - 36, base - 54, base - 72, base - 90, base - 108, base - 126];
    for (const x of candidates) {
      const blocked = dependencyTextObstacles.some((b) => {
        if (b.taskId === fromTaskId || b.taskId === toTaskId) return false;
        const verticalOverlap = b.y2 >= yMin && b.y1 <= yMax;
        return verticalOverlap && x >= b.x1 && x <= b.x2;
      });
      if (!blocked) return Math.max(4, x);
    }
    return Math.max(4, base - 144);
  };

  const TRAIN_PX_PER_SECOND = 37.5;
  const pathLengthApprox = (path) => {
    const tokens = String(path || "").match(/[MLQ]|-?\d*\.?\d+(?:e[-+]?\d+)?/gi) || [];
    let i = 0, x = 0, y = 0, len = 0;
    const num = () => Number(tokens[i++]);
    while (i < tokens.length) {
      const cmd = tokens[i++];
      if (cmd === "M" || cmd === "L") { const nx = num(), ny = num(); if (cmd === "L") len += Math.hypot(nx - x, ny - y); x = nx; y = ny; }
      else if (cmd === "Q") {
        const cx = num(), cy = num(), nx = num(), ny = num(); let px = x, py = y;
        for (let k = 1; k <= 12; k++) { const t = k / 12, mt = 1 - t; const qx = mt * mt * x + 2 * mt * t * cx + t * t * nx; const qy = mt * mt * y + 2 * mt * t * cy + t * t * ny; len += Math.hypot(qx - px, qy - py); px = qx; py = qy; }
        x = nx; y = ny;
      }
    }
    return len;
  };

  // Flux animé des dépendances : un disque suit une tâche puis emprunte le connecteur
  // de dépendance jusqu'au début du successeur. À chaque embranchement, le flux est
  // dupliqué afin de rendre visuellement la propagation du travail dans le graphe.
  const buildTrainFlows = () => {
    if (!appearance?.animTrainFlow || networkMode) return [];

    const animTasks = dated.filter((t) =>
      !t.milestone &&
      !isFullyShared(t) &&
      !collapsed[t.projectId]
    );
    if (!animTasks.length) return [];

    const byId = new Map(animTasks.map((t) => [t.id, t]));
    const successors = new Map(animTasks.map((t) => [t.id, []]));
    animTasks.forEach((t) => {
      (t.dependsOn || []).forEach((depId) => {
        if (successors.has(depId)) successors.get(depId).push(t.id);
      });
    });

    const positions = new Map();
    rowsWithHeights.forEach((row) => {
      if (collapsed[row.project.id]) return;
      row.items.forEach(({ t, side, branchDist }) => {
        if (!byId.has(t.id)) return;
        positions.set(t.id, {
          projectId: row.project.id,
          x0: xFor(t.start),
          x1: Math.max(xFor(t.end), xFor(t.start) + 1),
          mainY: rowAbsoluteMainY[row.project.id],
          y: rowAbsoluteMainY[row.project.id] + side * branchDist,
        });
      });
    });

    const taskSegment = (t, entersFromDependency) => {
      const pos = positions.get(t.id);
      if (!pos) return null;
      return entersFromDependency
        ? `M ${pos.x0} ${pos.y} L ${pos.x1} ${pos.y}`
        : branchPath(pos.x0, pos.mainY, pos.x1, pos.y);
    };

    const dependencySegment = (fromTask, toTask) => {
      const from = positions.get(fromTask.id);
      const to = positions.get(toTask.id);
      if (!from || !to) return null;

      const fx = from.x1;
      const fy = from.y;
      const tx = to.x0;
      const ty = to.y;

      // Le disque suit exactement la géométrie du trait réellement dessiné.
      if (from.projectId === to.projectId) {
        // Dépendance principale : le connecteur est le même branchPath que celui
        // utilisé pour l'embranchement visuel de la tâche.
        const sameProjectDeps = (toTask.dependsOn || [])
          .map((id) => positions.get(id))
          .filter(Boolean);
        const primary = sameProjectDeps.length
          ? sameProjectDeps.reduce((best, p) => (!best || p.x1 > best.x1 ? p : best), null)
          : null;
        if (primary && Math.abs(primary.x1 - fx) < 0.01 && Math.abs(primary.y - fy) < 0.01) {
          const fullPath = branchPath(fx, fy, tx, ty);
          return fullPath.slice(fullPath.indexOf('L '));
        }

        // Autres dépendances : reproduit le connecteur local (+6 / -3, bend 8).
        const startX = fx + 6;
        const endX = tx - 3;
        if (Math.abs(ty - fy) < 1) return `L ${endX} ${ty}`;
        const midX = (startX + endX) / 2;
        const bend = Math.min(8, Math.abs(ty - fy) / 2 || 6);
        const dir = ty > fy ? 1 : -1;
        return `L ${midX - bend} ${fy} Q ${midX} ${fy} ${midX} ${fy + dir * bend} L ${midX} ${ty - dir * bend} Q ${midX} ${ty} ${midX + bend} ${ty} L ${endX} ${ty}`;
      }

      // Dépendance inter-projets : reproduit le calque global (+6 / -4, bend 14).
      const startX = fx + 6;
      const endX = tx - 4;
      if (Math.abs(ty - fy) < 1) return `L ${endX} ${ty}`;
      const midX = (startX + endX) / 2;
      const bend = Math.min(14, Math.abs(ty - fy) / 2 || 10);
      const dir = ty > fy ? 1 : -1;
      return `L ${midX - bend} ${fy} Q ${midX} ${fy} ${midX} ${fy + dir * bend} L ${midX} ${ty - dir * bend} Q ${midX} ${ty} ${midX + bend} ${ty} L ${endX} ${ty}`;
    };

    const roots = animTasks.filter((t) =>
      !(t.dependsOn || []).some((depId) => byId.has(depId))
    );

    const flows = [];
    const walk = (task, parts, visited, entersFromDependency, branchIndex = 0) => {
      if (visited.has(task.id)) {
        if (parts.length) { const path = parts.join(" "); flows.push({ id: "cycle-" + flows.length, taskIds: [...visited], path, duration: Math.max(0.35, pathLengthApprox(path) / TRAIN_PX_PER_SECOND) }); }
        return;
      }
      const nextVisited = new Set(visited);
      nextVisited.add(task.id);

      const segment = taskSegment(task, entersFromDependency);
      if (!segment) return;
      const nextParts = [...parts, segment];
      const nextIds = (successors.get(task.id) || []).filter((id) => byId.has(id));

      if (!nextIds.length) {
        { const path = nextParts.join(" "); flows.push({ id: "flow-" + flows.length, taskIds: [...nextVisited], path, duration: Math.max(0.35, pathLengthApprox(path) / TRAIN_PX_PER_SECOND) }); }
        return;
      }

      nextIds.forEach((successorId, i) => {
        const successor = byId.get(successorId);
        const dep = dependencySegment(task, successor);
        if (!dep) return;
        // Le premier segment de chaque branche part du même point de sortie de la tâche :
        // chaque successeur reçoit donc son propre disque animé.
        walk(
          successor,
          [...nextParts, dep],
          nextVisited,
          true,
          i
        );
      });
    };

    roots.forEach((root) => walk(root, [], new Set(), false));

    // Filet de sécurité pour un éventuel cycle de dépendances : on anime au moins une
    // boucle locale plutôt que de supprimer silencieusement toute l'animation.
    if (!flows.length) {
      animTasks.forEach((t) => walk(t, [], new Set(), false));
    }

    // Une chaîne ne doit être affichée que si elle contient au moins une tâche non terminée.
    // Une tâche terminée peut donc servir de prédécesseur et transmettre le disque à une
    // tâche encore active, ce qui rend la continuité de la dépendance lisible.
    return flows.filter((flow) => {
      return flow.taskIds.some((id) => {
        const t = byId.get(id);
        return t && !isTaskDoneGlobal(t, ctx);
      });
    });
  };

  const trainFlows = buildTrainFlows();

  // Centre automatiquement la vue sur la première tâche trouvée par la recherche.
  useEffect(() => {
    if (!matchIds || matchIds.size === 0 || !scrollRef.current) return;
    const firstId = [...matchIds][0];
    const el = scrollRef.current.querySelector(`[data-pm-task-id="${firstId}"]`);
    if (!el) return;
    const wrapRect = scrollRef.current.getBoundingClientRect();
    const elRect = el.getBoundingClientRect();
    scrollRef.current.scrollTo({
      left: Math.max(0, scrollRef.current.scrollLeft + (elRect.left - wrapRect.left) - scrollRef.current.clientWidth / 2),
      top: Math.max(0, scrollRef.current.scrollTop + (elRect.top - wrapRect.top) - scrollRef.current.clientHeight / 2),
      behavior: "smooth",
    });
  }, [matchIds]);

  const separatorUnit = dayWidth >= 15 ? "day" : "week";
  const verticalSeparators = useMemo(() => {
    const arr = [];
    let cur = unitStart(globalMin, separatorUnit);
    let guard = 0;
    while (dayIndex(cur) <= dayIndex(globalMax) && guard < 800) {
      arr.push(xFor(cur));
      cur = addDays(cur, unitLen(cur, separatorUnit));
      guard++;
    }
    return arr;
  }, [globalMin, globalMax, dayWidth, originIdx, separatorUnit]);

  const today = planningToday;
  const showToday = today >= globalMin && today <= globalMax;
  const todayX = showToday ? xFor(today) : null;

  // Glisser-déposer : agrippe une station de début/fin de tâche pour modifier sa date
  const dragRef = useRef(null);
  const [dragging, setDragging] = useState(false);
  const startDragTask = (e, t, mode, extra) => {
    e.stopPropagation();
    e.preventDefault();
    const touch = e.touches && e.touches[0];
    dragRef.current = { taskId: t.id, task: t, mode, startClientX: touch ? touch.clientX : e.clientX, origStart: t.start, origEnd: t.end, origProgress: t.progress || 0, dw: dayWidth, moved: false, ...extra };
    setDragging(true);
  };
  useEffect(() => {
    function onMove(e) {
      const d = dragRef.current;
      if (!d) return;
      const point = e.touches ? e.touches[0] : e;
      if (!point) return;
      if (e.cancelable) e.preventDefault();
      const deltaDays = Math.round((point.clientX - d.startClientX) / d.dw);
      if (Math.abs(point.clientX - d.startClientX) > 2) d.moved = true;
      setTasks((prev) => prev.map((t) => {
        if (t.id !== d.taskId) return t;
        if (d.mode === "progress") {
          // Glisser la limite épais/fin de la ligne pour ajuster l'avancement — en
          // pourcentage de la largeur RÉELLE de la tâche à l'écran, pas en jours,
          // pour un geste qui suit fidèlement le pointeur quel que soit le zoom.
          const deltaPct = ((point.clientX - d.startClientX) / (d.taskPxWidth || 1)) * 100;
          const newProgress = Math.max(0, Math.min(100, Math.round(d.origProgress + deltaPct)));
          const wasDone = isTaskDoneGlobal(t, ctx);
          if (newProgress >= 100) {
            const doneStatus = ctx.statuses.find((s) => /termin/i.test(s.name || ""));
            return { ...t, progress: 100, statusId: doneStatus ? doneStatus.id : t.statusId };
          }
          if (wasDone && newProgress < 100) {
            // Reculer sous 100% doit aussi sortir la tâche de son statut "terminé",
            // sinon la ligne resterait affichée pleine malgré le nouveau pourcentage.
            const inProgressStatus = ctx.statuses.find((s) => /en\s*cours/i.test(s.name || ""));
            return { ...t, progress: newProgress, statusId: inProgressStatus ? inProgressStatus.id : t.statusId };
          }
          return { ...t, progress: newProgress };
        }
        if (d.mode === "deadlineEnd") {
          // Mode Échéances :
          // - objet à date unique (début === fin) : la station représente toute la
          //   date, donc début et fin se déplacent ensemble ;
          // - objet avec durée > 0 : seule la date de fin bouge, avec butée stricte
          //   sur la date de début (fin >= début).
          const originalDuration = dayIndex(d.origEnd) - dayIndex(d.origStart);
          const newEnd = addDays(d.origEnd, deltaDays);
          if (originalDuration <= 0) {
            return { ...t, start:newEnd, end:newEnd };
          }
          return { ...t, end:newEnd < d.origStart ? d.origStart : newEnd };
        }
        if (d.mode === "start") {
          if (t.milestone) {
            // Un jalon n'a qu'une seule date : glisser son point "début" revient à
            // déplacer directement sa date, sans aucune contrainte de sens.
            return { ...t, start: addDays(d.origStart, deltaDays), end: addDays(d.origStart, deltaDays) };
          }
          // Glisser le début décale toute la tâche (durée conservée) plutôt que de la
          // redimensionner — la fin suit automatiquement, y compris vers le passé.
          const newStart = addDays(d.origStart, deltaDays);
          const duration = dayIndex(d.origEnd) - dayIndex(d.origStart);
          return { ...t, start: newStart, end: addDays(newStart, duration) };
        } else {
          const newEnd = addDays(d.origEnd, deltaDays);
          // Un jalon peut être ramené librement dans le passé ou le futur ; seule une
          // tâche non-jalon ne doit pas voir sa fin passer avant son propre début.
          if (t.milestone) return { ...t, start: newEnd, end: newEnd };
          return { ...t, end: newEnd < d.origStart ? d.origStart : newEnd };
        }
      }));
    }
    // Après un glisser qui a réellement changé une date, propose une annulation
    // immédiate — filet de sécurité pour une manipulation directe sur le graphique.
    // Si RIEN n'a bougé (souris relâchée quasiment là où elle a été pressée), on
    // considère qu'il s'agissait d'un simple clic — pas d'un glisser — et on ouvre
    // la fiche de la tâche, exactement comme cliquer sur son libellé le ferait déjà.
    function onUp() {
      const d = dragRef.current;
      dragRef.current = null;
      setDragging(false);
      if (d && d.moved && pushToast) {
        const { taskId, origStart, origEnd } = d;
        pushToast({
          message: d.mode === "deadlineEnd" ? "Échéance modifiée." : "Dates modifiées.",
          actionLabel: "Annuler",
          onAction: () => setTasks((prev) => prev.map((t) => (t.id === taskId ? { ...t, start: origStart, end: origEnd } : t))),
        });
      } else if (d && !d.moved && d.task) {
        onOpen(d.task);
      }
    }
    window.addEventListener("mousemove", onMove);
    window.addEventListener("mouseup", onUp);
    window.addEventListener("touchmove", onMove, { passive: false });
    window.addEventListener("touchend", onUp);
    window.addEventListener("touchcancel", onUp);
    return () => {
      window.removeEventListener("mousemove", onMove); window.removeEventListener("mouseup", onUp);
      window.removeEventListener("touchmove", onMove); window.removeEventListener("touchend", onUp); window.removeEventListener("touchcancel", onUp);
    };
  }, [setTasks, pushToast, onOpen]);

  // Glisser-déposer dédié aux sous-tâches : ne modifie que leur propre date de fin,
  // au sein de la checklist de leur tâche parente.
  const subDragRef = useRef(null);
  const startDragSubtask = (e, taskId, subId, origEnd) => {
    e.stopPropagation();
    e.preventDefault();
    const touch = e.touches && e.touches[0];
    subDragRef.current = { taskId, subId, startClientX: touch ? touch.clientX : e.clientX, origEnd, dw: dayWidth, moved: false };
  };
  useEffect(() => {
    function onMove(e) {
      const d = subDragRef.current;
      if (!d) return;
      const point = e.touches ? e.touches[0] : e;
      if (!point) return;
      if (e.cancelable) e.preventDefault();
      const deltaDays = Math.round((point.clientX - d.startClientX) / d.dw);
      if (deltaDays !== 0) d.moved = true;
      const newEnd = addDays(d.origEnd, deltaDays);
      setTasks((prev) => prev.map((t) => {
        if (t.id !== d.taskId) return t;
        return { ...t, checklist: (t.checklist || []).map((s) => (s.id === d.subId ? { ...s, end: newEnd } : s)) };
      }));
    }
    function onUp() {
      const d = subDragRef.current;
      subDragRef.current = null;
      if (d && d.moved && pushToast) {
        const { taskId, subId, origEnd } = d;
        pushToast({
          message: "Date de sous-tâche modifiée.",
          actionLabel: "Annuler",
          onAction: () => setTasks((prev) => prev.map((t) => (t.id === taskId ? { ...t, checklist: (t.checklist || []).map((s) => (s.id === subId ? { ...s, end: origEnd } : s)) } : t))),
        });
      }
    }
    window.addEventListener("mousemove", onMove);
    window.addEventListener("mouseup", onUp);
    window.addEventListener("touchmove", onMove, { passive: false });
    window.addEventListener("touchend", onUp);
    window.addEventListener("touchcancel", onUp);
    return () => {
      window.removeEventListener("mousemove", onMove); window.removeEventListener("mouseup", onUp);
      window.removeEventListener("touchmove", onMove); window.removeEventListener("touchend", onUp); window.removeEventListener("touchcancel", onUp);
    };
  }, [setTasks, pushToast]);

  // Barre de progression modifiable directement dans le graphique
  const progressDragRef = useRef(null);
  const setProgressFromClientX = (taskId, barX0, barW, clientX) => {
    const pct = Math.max(0, Math.min(100, Math.round(((clientX - barX0) / barW) * 100)));
    setTasks((prev) => prev.map((t) => (t.id === taskId ? { ...t, progress: pct } : t)));
  };
  const startDragProgress = (e, t, barX0, barW) => {
    e.stopPropagation();
    e.preventDefault();
    const svgRect = e.currentTarget.closest("svg").getBoundingClientRect();
    const screenBarX0 = svgRect.left + barX0;
    progressDragRef.current = { taskId: t.id, barX0: screenBarX0, barW };
    setProgressFromClientX(t.id, screenBarX0, barW, e.clientX);
  };
  useEffect(() => {
    function onMove(e) {
      const d = progressDragRef.current;
      if (!d) return;
      setProgressFromClientX(d.taskId, d.barX0, d.barW, e.clientX);
    }
    function onUp() { progressDragRef.current = null; }
    window.addEventListener("mousemove", onMove);
    window.addEventListener("mouseup", onUp);
    return () => { window.removeEventListener("mousemove", onMove); window.removeEventListener("mouseup", onUp); };
  }, [setTasks]);

  const ProjectRow = ({ row }) => {
    const { project: p, minDate, maxDate, items, mainY, ROW_H, avgProgress } = row;
    const color = p.color || "var(--text-muted)";
    const isCollapsed = collapsed[p.id];
    const textHaloStyle = { paintOrder: "stroke fill", stroke: "var(--surface)", strokeWidth: 4, strokeLinejoin: "round" };
    // Position de chaque tâche (au sein de CE projet) pour les flèches de dépendance —
    // seules les dépendances entre tâches du même projet peuvent être tracées, une
    // flèche ne pouvant pas relier deux <svg> distincts (un par projet).
    const posMap = {};
    items.forEach(({ t, side, branchDist, isMilestone, activityOffset = 0 }) => {
      const branchY = getTaskType(t) === "activity"
        ? mainY + activityOffset
        : (mainY + side * branchDist);
      posMap[t.id] = { x0:xFor(t.start), x1:xFor(t.end), y:branchY, activityOffset };
    });
    // Couleur de chaque tâche : normalement la couleur du statut (comme les
    // bifurcations) ; mais quand la ligne fusionne plusieurs projets (regroupement
    // par dossier), on utilise plutôt la couleur du PROJET D'ORIGINE de chaque
    // tâche — c'est le seul repère visuel qui permette encore de distinguer les
    // tâches de projets différents sur cette même ligne fusionnée.
    const taskColorMap = {};
    items.forEach(({ t: it }) => {
      if (p.isFolderGroup) {
        const ownProject = ctx.projects.find((pr) => pr.id === it.projectId);
        taskColorMap[it.id] = ownProject?.color || color;
      } else {
        const st = ctx.statuses.find((s) => s.id === it.statusId);
        taskColorMap[it.id] = st?.color || color;
      }
    });
    // Point de départ réel du tracé d'une tâche : si elle dépend d'une tâche du MÊME
    // projet, son embranchement part du cercle de fin de cette dernière (celle dont la
    // fin est la plus tardive, si plusieurs dépendances — c'est elle qui détermine la
    // date de début auto-calculée) plutôt que de l'axe principal du projet. Les
    // dépendances inter-projets restent matérialisées par la flèche pointillée globale,
    // un embranchement ne pouvant pas franchir deux <svg> distincts.
    const originFor = (t) => {
      if (getTaskType(t) === "action" && t.linkedActivityId) {
        const act = posMap[t.linkedActivityId];
        if (act) {
          const rel = t.activityRelation || "contributes";
          const x = rel === "blocks_start" ? act.x0 : rel === "blocks_end" ? act.x1 : (act.x0 + act.x1) / 2;
          return { x, y:act.y, fromPred:false, fromActivity:true, relation:rel };
        }
      }
      if (t.dependsOn && t.dependsOn.length) {
        let best = null;
        t.dependsOn.forEach((depId) => {
          const p = posMap[depId];
          if (p && (!best || p.x1 > best.x1)) best = p;
        });
        if (best) return { x: best.x1, y: best.y, fromPred: true };
      }
      return { x: xFor(t.start), y: mainY, fromPred: false };
    };
    return (
      <g>
        {/* Flèches de dépendance, tracées en tout premier pour rester TOUJOURS derrière
            le texte (et son halo blanc) — uniquement entre tâches du même projet, une
            flèche ne pouvant pas relier deux <svg> distincts (un par projet). Dégradé
            entre la couleur de la tâche de départ et celle de la tâche d'arrivée,
            épaisseur alignée sur la ligne de métro principale du projet. */}
        {!isCollapsed && items.filter((it) => it.t.dependsOn && it.t.dependsOn.length).flatMap(({ t }) => {
          const primaryOrigin = originFor(t); // dépendance déjà matérialisée par la bifurcation elle-même
          return t.dependsOn.map((depId) => {
            const from = posMap[depId];
            const to = posMap[t.id];
            if (!from || !to || depId === t.id) return null;
            if (primaryOrigin.fromPred && from.x1 === primaryOrigin.x && from.y === primaryOrigin.y) return null; // déjà visible via la bifurcation
            const startX = from.x1 + 6; // sort visiblement du cercle de la tâche de départ, plutôt que de son centre
            const midX = (startX + to.x0) / 2;
            const bend = Math.min(8, Math.abs(to.y - from.y) / 2 || 6);
            const dir = to.y > from.y ? 1 : -1;
            const d = Math.abs(to.y - from.y) < 1
              ? `M ${startX} ${from.y} L ${to.x0 - 3} ${to.y}`
              : `M ${startX} ${from.y} L ${midX - bend} ${from.y} Q ${midX} ${from.y} ${midX} ${from.y + dir * bend} L ${midX} ${to.y - dir * bend} Q ${midX} ${to.y} ${midX + bend} ${to.y} L ${to.x0 - 3} ${to.y}`;
            const gradId = `pm-dep-grad-${depId}-${t.id}`;
            const markerId = `pm-dep-arrow-${depId}-${t.id}`;
            return (
              <React.Fragment key={depId + "-" + t.id}>
                <defs>
                  <linearGradient id={gradId} gradientUnits="userSpaceOnUse" x1={startX} y1={from.y} x2={to.x0} y2={to.y}>
                    <stop offset="0%" stopColor={accent} stopOpacity="0.45" />
                    <stop offset="100%" stopColor={accent} />
                  </linearGradient>
                  <marker id={markerId} markerWidth="5" markerHeight="5" refX="3.5" refY="1.75" orient="auto">
                    <path d="M0,0 L3.5,1.75 L0,3.5 Z" fill={accent} />
                  </marker>
                </defs>
                {/* Contour blanc en dessous, comme pour les flèches inter-projets — sans
                    lui, le trait fin se perd dans la ligne de métro et les autres
                    éléments de la même rangée. */}
                <path d={d} fill="none" stroke="#fff" strokeWidth="4.5" strokeLinecap="round" opacity="0.9" />
                <path d={d} fill="none" stroke={`url(#${gradId})`} strokeWidth="2.2" strokeDasharray="5 4" opacity="0.95" markerEnd={`url(#${markerId})`} strokeLinecap="round" />
              </React.Fragment>
            );
          });
        })}

        {verticalSeparators.map((sx, i) => (
          <line key={"sep-" + i} x1={sx} y1={0} x2={sx} y2={ROW_H} stroke="var(--border)" strokeWidth="1" opacity="0.4" />
        ))}
        {todayX !== null && (
          <g>
            {appearance?.animTodayPulse && (
              <line
                x1={todayX} y1={0} x2={todayX} y2={ROW_H}
                stroke="var(--accent)"
                strokeWidth="4"
                strokeLinecap="round"
                strokeOpacity="0.08"
                className="lp-pm-today-pulse-halo"
              />
            )}
            <line x1={todayX} y1={0} x2={todayX} y2={ROW_H} stroke="var(--accent)" strokeWidth="2.5" strokeLinecap="round" opacity="0.95" className="lp-pm-today-line" />
            <path
              d={`M ${todayX - 5} 0 L ${todayX + 5} 0 L ${todayX} 8 Z`}
              fill="var(--accent)"
              className={"lp-pm-today-marker" + (appearance?.animTodayPulse ? " lp-anim-on" : "")}
            />
          </g>
        )}

        <line x1={xFor(minDate)} y1={mainY} x2={xFor(maxDate)} y2={mainY} stroke={color} strokeWidth="3.2" strokeLinecap="round" opacity="0.55" />
        {avgProgress > 0 && <line x1={xFor(minDate)} y1={mainY} x2={xFor(minDate) + (xFor(maxDate) - xFor(minDate)) * (avgProgress / 100)} y2={mainY} stroke={color} strokeWidth="5.5" strokeLinecap="round" />}
        <Station x={xFor(minDate)} y={mainY} color={color} r={7} />

        {!isCollapsed && items.filter((it) => getTaskType(it.t) === "activity" && !isFullyShared(it.t)).map(({ t, activityOffset = 0 }) => {
          const x0 = xFor(t.start), x1 = xFor(t.end);
          const activityY = mainY + activityOffset;
          const done = isTaskDoneGlobal(t, ctx);

          // IMPORTANT : on compte toutes les Actions liées, même si elles n'ont
          // aucune date. C'était la cause du compteur absent malgré "Actions liées (4)"
          // visible dans la fiche Activité.
          const linked = tasks.filter((a) => getTaskType(a) === "action" && a.linkedActivityId === t.id);
          const linkedDone = linked.filter((a) => isTaskDoneGlobal(a, ctx)).length;
          const isExpanded = expandedActivities.has(t.id);
          const critical = !!criticalPathIds && criticalPathIds.has(t.id);
          const stroke = critical ? PM_CRITICAL_COLOR : color;
          const mid = (x0 + x1) / 2;
          const titleW = pmMeasureText(t.title, TITLE_FONT);
          const hasDescription = !!String(t.desc ?? t.description ?? "").trim();
          return (
            <g key={"activity-" + t.id} opacity={dimOpacity(t.id)}>
              {activityOffset !== 0 && (
                <>
                  <path d={branchPath(x0, mainY, x0, activityY)} fill="none" stroke={stroke} strokeWidth="2" strokeLinecap="round" opacity=".52" />
                  <path d={branchPath(x1, mainY, x1, activityY)} fill="none" stroke={stroke} strokeWidth="2" strokeLinecap="round" opacity=".52" />
                </>
              )}
              <line x1={x0} y1={activityY} x2={x1} y2={activityY} stroke="var(--surface)" strokeWidth="12" strokeLinecap="round" />
              <line x1={x0} y1={activityY} x2={x1} y2={activityY} stroke={stroke} strokeWidth={critical ? "8.5" : "7"} strokeLinecap="round" opacity={done ? .48 : .92} />
              <circle cx={x0} cy={activityY} r="6.5" fill="var(--surface)" stroke={stroke} strokeWidth="1.8" />
              <circle cx={x1} cy={activityY} r="6.5" fill="var(--surface)" stroke={stroke} strokeWidth="1.8" />

              <rect x={mid - titleW/2 - 6} y={activityY - 27} width={titleW + 12} height="18" rx="3" fill="var(--surface)" opacity=".98" />
              <text x={mid} y={activityY - 14} textAnchor="middle" className="lp-pm-activity-label" fill="var(--text-900)" onClick={() => onOpen(t)} style={{ cursor:"pointer" }}>
                {t.title}
              </text>
              {hasDescription && (
                <g
                  className="lp-pm-note-trigger"
                  transform={`translate(${mid + titleW/2 + 9}, ${activityY - 25})`}
                  onClick={(e)=>{
                    e.stopPropagation();
                    setDescriptionPopup({task:t,x:e.clientX,y:e.clientY});
                  }}
                  style={{cursor:"pointer"}}
                >
                  <title>Afficher la description</title>
                  <rect x="0" y="0" width="17" height="16" rx="4" fill="var(--surface)" stroke="var(--border)" strokeWidth="1"/>
                  <path d="M4.5 4.5h8M4.5 7.5h8M4.5 10.5h5.5" fill="none" stroke="var(--text-600)" strokeWidth="1.25" strokeLinecap="round"/>
                  <path d="M11.2 1.9v2.7h2.7" fill="none" stroke="var(--text-600)" strokeWidth="1.05" strokeLinecap="round" strokeLinejoin="round" opacity=".7"/>
                </g>
              )}

              {/* Toujours visible : même une activité sans action affiche 0/0 afin
                  que la logique Action ↔ Activité soit immédiatement compréhensible. */}
              <g className="lp-pm-activity-actions" onClick={(e) => { e.stopPropagation(); if (linked.length) toggleActivityActions(t.id); }} style={{ cursor:linked.length ? "pointer" : "default" }}>
                <line x1={mid} y1={activityY + 7} x2={mid} y2={activityY + 21} stroke={stroke} strokeWidth={isExpanded ? "2.4" : "1.4"} strokeDasharray={isExpanded ? "0" : "2 3"} opacity={linked.length ? .9 : .38} />
                <rect x={mid - 29} y={activityY + 20} width="58" height="19" rx="9.5" fill="var(--surface)" stroke={stroke} strokeWidth="1.2" opacity={linked.length ? 1 : .55} />
                <text x={mid} y={activityY + 33} textAnchor="middle" fill={stroke}>{linkedDone}/{linked.length} actions</text>
              </g>
            </g>
          );
        })}

        {!isCollapsed && items.filter((it) =>
          getTaskType(it.t) === "action" &&
          !isFullyShared(it.t) &&
          (!it.t.linkedActivityId || expandedActivities.has(it.t.linkedActivityId))
        ).map(({ t, side, branchDist, subtasks }) => {
          const branchY = mainY + side * branchDist;
          const x0 = xFor(t.start), x1 = xFor(t.end);
          const origin = originFor(t);
          const st = ctx.statuses.find((s) => s.id === t.statusId);
          // Regroupement par dossier : la couleur du statut ne différencie plus rien
          // (toutes les tâches de la ligne peuvent avoir le même statut) — on bascule
          // sur la couleur du PROJET D'ORIGINE de la tâche, seul repère qui distingue
          // encore les tâches entre elles sur cette ligne fusionnée.
          const taskColor = p.isFolderGroup
            ? (ctx.projects.find((pr) => pr.id === t.projectId)?.color || "var(--text-muted)")
            : (st?.color || "var(--text-muted)");
          const done = isTaskDoneGlobal(t, ctx);
          const pct = Math.max(0, Math.min(100, done ? 100 : t.progress || 0));
          const xProgress = x0 + (x1 - x0) * (pct / 100); // portion réalisée mesurée sur la vraie durée de la tâche
          const isCritical = !!criticalPathIds && criticalPathIds.has(t.id);
          const atRisk = showRiskBadges && !done && isAtRisk(t);
          const blockingRelation = origin.fromActivity && ["blocks_start","blocks_end"].includes(t.activityRelation);
          const lineColor = isCritical ? PM_CRITICAL_COLOR : taskColor;
          // La tâche est TOUJOURS dessinée sur ses propres dates réelles (x0 → x1) : une
          // dépendance ne déplace jamais visuellement son début ou sa fin. Seule la façon
          // dont elle rejoint le reste du plan change : si elle dépend d'une tâche du même
          // projet, un connecteur discret part du cercle de fin de cette dernière et
          // rejoint le début réel de la tâche (sur sa propre ligne) — plutôt que de faire
          // partir la tâche elle-même de ce point, ce qui aurait déplacé sa date affichée.
          const actionAnchorX = origin.fromActivity ? origin.x : x0;
          const mainPath = origin.fromPred
            ? `M ${x0} ${branchY} L ${x1} ${branchY}`
            : origin.fromActivity
              ? branchPath(actionAnchorX, origin.y, x1, branchY)
              : branchPath(x0, mainY, x1, branchY);
          const progressPath = origin.fromPred
            ? `M ${x0} ${branchY} L ${xProgress} ${branchY}`
            : origin.fromActivity
              ? branchPath(actionAnchorX, origin.y, xProgress, branchY)
              : branchPath(x0, mainY, xProgress, branchY);
          const startStationY = origin.fromPred ? branchY : mainY;
          return (
            <g key={"line-" + t.id} opacity={dimOpacity(t.id)}>
              {/* Connecteur de dépendance : part du cercle de fin de la tâche prédécesseure
                  et rejoint le début réel de cette tâche-ci, sur sa propre ligne — visuellement
                  distinct (plus fin, pointillé) de la tâche elle-même pour ne jamais laisser
                  penser que la tâche démarre à la date du prédécesseur. */}
              {origin.fromPred && (
                <path d={branchPath(origin.x, origin.y, x0, branchY)} fill="none" stroke={lineColor} strokeWidth="1.8" strokeLinecap="round" strokeDasharray="1 4" opacity={done ? 0.3 : 0.5} />
              )}
              {/* Épaisseur du trait : plus épais sur la portion déjà réalisée, un peu plus fin sur le reste.
                  En chemin critique, le trait est plus épais et dans la couleur "express" pour ressortir
                  nettement de la ligne, même quand la vue est chargée. */}
              <path d={mainPath} fill="none" stroke={lineColor} strokeWidth={isCritical ? "4" : (blockingRelation ? "3.8" : "2.2")} strokeLinecap="round" opacity={done ? (isCritical ? 0.55 : 0.4) : (isCritical ? 0.8 : 0.55)} pathLength={appearance?.animLineDraw ? "1" : undefined} strokeDasharray={appearance?.animLineDraw ? "1" : undefined} className={appearance?.animLineDraw ? "lp-pm-line-draw" : undefined} />
              {/* Animation du disque déplacée dans le calque SVG global final.
                  Ne jamais la rendre dans le SVG propre à cette ligne : un autre SVG de
                  projet pourrait sinon être peint au-dessus du disque. */}
              {pct > 0 && <path d={progressPath} fill="none" stroke={lineColor} strokeWidth={isCritical ? "6" : "4.5"} strokeLinecap="round" opacity={done ? 0.55 : 0.95} />}
              {/* Poignée sur la limite épais/fin : glisser horizontalement ajuste
                  l'avancement de la tâche, en suivant la largeur réelle affichée à
                  l'écran (donc cohérent quel que soit le niveau de zoom). Un simple
                  clic (sans glisser) ouvre la fiche, comme partout ailleurs. Absente
                  pile à 0% ou 100% : elle coïnciderait alors exactement avec la
                  poignée de début/fin de tâche, qui passe devant dans le DOM. */}
              {!t.milestone && pct > 0 && pct < 100 && (
                <g
                  onMouseDown={(e) => startDragTask(e, t, "progress", { taskPxWidth: x1 - x0 })}
                  onTouchStart={(e) => startDragTask(e, t, "progress", { taskPxWidth: x1 - x0 })}
                  style={{ cursor: "ew-resize" }}
                  className="lp-pm-progress-handle"
                >
                  <rect x={xProgress - 7} y={branchY - 8} width="14" height="16" fill="transparent" />
                  <line x1={xProgress} y1={branchY - 5} x2={xProgress} y2={branchY + 5} stroke={lineColor} strokeWidth="2" strokeLinecap="round" opacity={done ? 0.55 : 0.95} />
                </g>
              )}
              {/* Point de glisser du début : toujours posé sur la vraie date de début de la
                  tâche — sur l'axe du projet si elle est indépendante, ou sur sa propre ligne
                  (juste après le connecteur) si elle dépend d'une autre tâche. */}
              <g onMouseDown={(e) => startDragTask(e, t, "start")} onTouchStart={(e) => startDragTask(e, t, "start")} style={{ cursor: "ew-resize" }} data-pm-task-start-id={t.id}>
                <circle cx={x0} cy={startStationY} r="10" fill="transparent" />
                <Station x={x0} y={startStationY} color={lineColor} r={3.5} />
              </g>
              <g
                onMouseDown={(e) => startDragTask(e, t, "end")}
                onTouchStart={(e) => startDragTask(e, t, "end")}
                onClick={(e) => { if (e.metaKey || e.ctrlKey || e.shiftKey) { e.stopPropagation(); toggleSelect(t.id); } }}
                style={{ cursor: "ew-resize" }}
                data-pm-task-id={t.id}
              >
                <circle cx={x1} cy={branchY} r="11" fill="transparent" />
                {atRisk && appearance?.animLateAlert && (
                  <circle cx={x1} cy={branchY} r="6" fill="none" stroke={PM_RISK_COLOR} strokeWidth="2" className="lp-pm-late-ring" />
                )}
                <Station x={x1} y={branchY} color={lineColor} r={5.5} done={done} icon={p.metroTaskIcons ? resolveMilestoneIcon(t, ctx) : null} justCompleted={justCompletedIds.has(t.id)} />
                {(selectedIds.has(t.id) || focusedId === t.id) && (
                  <circle cx={x1} cy={branchY} r="10" fill="none" stroke={selectedIds.has(t.id) ? "var(--signal)" : "var(--text-muted)"} strokeWidth="2" strokeDasharray={selectedIds.has(t.id) ? "0" : "2 2"} />
                )}
                {atRisk && (
                  <g transform={`translate(${x1 + 7}, ${branchY - 12})`} style={{ cursor: "pointer" }}>
                    <circle r="7" fill="#fff" stroke={PM_RISK_COLOR} strokeWidth="1.4" />
                    <text y="3" textAnchor="middle" fontSize="9" fontWeight="800" fill={PM_RISK_COLOR}>!</text>
                  </g>
                )}
              </g>
              {subtasks.map(({ sub, depth }) => {
                // Une sous-tâche part TOUJOURS du cercle de fin de sa tâche, jamais de la
                // ligne principale du projet — et rejoint sa propre date, passé ou futur.
                const subX = xFor(sub.end || t.end);
                const subY = mainY + side * depth; // profondeur absolue depuis la ligne principale
                return (
                  <g key={"sub-" + sub.id}>
                    <path d={branchPath(x1, branchY, subX, subY)} fill="none" stroke="var(--text-muted)" strokeWidth="1.6" strokeLinecap="round" opacity={sub.done ? 0.4 : 0.65} />
                    <g className="lp-pm-sub-drag" onMouseDown={(e) => startDragSubtask(e, t.id, sub.id, sub.end || t.end)} onTouchStart={(e) => startDragSubtask(e, t.id, sub.id, sub.end || t.end)} style={{ cursor: "ew-resize" }}>
                      <circle cx={subX} cy={subY} r="9" fill="transparent" />
                      <Station x={subX} y={subY} color="var(--text-muted)" r={3} done={sub.done} />
                    </g>
                  </g>
                );
              })}
            </g>
          );
        })}

        {!isCollapsed && items.filter((it) => it.isMilestone && !isFullyShared(it.t)).map(({ t, side, branchDist }) => {
          const branchY = mainY + side * branchDist;
          const mx = xFor(t.end);
          // Même bascule que pour les tâches normales : couleur du projet d'origine
          // du jalon quand la ligne fusionne plusieurs projets (dossier), sinon
          // couleur du statut comme d'habitude.
          const color2 = p.isFolderGroup
            ? (ctx.projects.find((pr) => pr.id === t.projectId)?.color || color)
            : (ctx.statuses.find((s) => s.id === t.statusId)?.color || color);
          const isCritical = !!criticalPathIds && criticalPathIds.has(t.id);
          return (
            <path key={"line-" + t.id} d={branchPath(mx, mainY, mx, branchY)} fill="none" stroke={isCritical ? PM_CRITICAL_COLOR : color2} strokeWidth={isCritical ? "3.5" : "2.5"} strokeLinecap="round" opacity={dimOpacity(t.id) * (isCritical ? 0.95 : 0.85)} strokeDasharray="1 5" onClick={() => onOpen(t)} style={{ cursor: "pointer" }} />
          );
        })}

        {!isCollapsed && items.filter((it) => it.isMilestone && !isFullyShared(it.t)).map(({ t, side, branchDist }) => {
          const branchY = mainY + side * branchDist;
          const mx = xFor(t.end);
          const titleW = pmMeasureText(t.title, MS_TITLE_FONT);
          const hasDescription = !!String(t.desc ?? t.description ?? "").trim();
          const noteX = mx + 17 + titleW + 6;
          const noteBadgeW = hasDescription ? 23 : 0;
          const dateX = mx + 14 + titleW + 6 + noteBadgeW;
          const isCritical = !!criticalPathIds && criticalPathIds.has(t.id);
          const msColor = isCritical ? PM_CRITICAL_COLOR : (ctx.statuses.find((s) => s.id === t.statusId)?.color || color);
          const done = isTaskDoneGlobal(t, ctx);
          const atRisk = showRiskBadges && !done && isAtRisk(t);
          return (
            <g key={"ms-" + t.id} opacity={dimOpacity(t.id)} onClick={(e) => { if (e.metaKey || e.ctrlKey || e.shiftKey) { e.stopPropagation(); toggleSelect(t.id); } }}>
              {/* Point de glisser : ne déclenche jamais l'ouverture de la fiche au clic —
                  glisser pour changer la date et cliquer pour ouvrir sont deux zones
                  distinctes, sinon relâcher après un glisser rouvrait la fiche aussitôt. */}
              <g onMouseDown={(e) => startDragTask(e, t, "end")} onTouchStart={(e) => startDragTask(e, t, "end")} style={{ cursor: "ew-resize" }} data-pm-task-id={t.id}>
                <circle cx={mx} cy={mainY} r="10" fill="transparent" />
                {atRisk && appearance?.animLateAlert && (
                  <circle cx={mx} cy={mainY} r={(isCritical ? 6 : 5) + 1.5} fill="none" stroke={PM_RISK_COLOR} strokeWidth="2" className="lp-pm-late-ring" />
                )}
                <Station x={mx} y={mainY} color={msColor} r={isCritical ? 6 : 5} />
                {(selectedIds.has(t.id) || focusedId === t.id) && (
                  <circle cx={mx} cy={mainY} r="10" fill="none" stroke={selectedIds.has(t.id) ? "var(--signal)" : "var(--text-muted)"} strokeWidth="2" strokeDasharray={selectedIds.has(t.id) ? "0" : "2 2"} />
                )}
                {atRisk && (
                  <g transform={`translate(${mx + 8}, ${mainY - 13})`}>
                    <circle r="7" fill="#fff" stroke={PM_RISK_COLOR} strokeWidth="1.4" />
                    <text y="3" textAnchor="middle" fontSize="9" fontWeight="800" fill={PM_RISK_COLOR}>!</text>
                  </g>
                )}
              </g>
              <foreignObject x={mx - 8} y={branchY - 8} width="16" height="16" style={{ overflow: "visible", cursor: "pointer" }} onClick={() => onOpen(t)}>
                <MilestoneGlyph size={16} icon={resolveMilestoneIcon(t, ctx)} />
              </foreignObject>
              <rect x={mx + 11} y={branchY - 9} width={titleW + 13} height={18} rx="2.5" fill="var(--surface)" opacity="0.99" style={{ cursor: "pointer" }} onClick={() => onOpen(t)} />
              <text x={mx + 17} y={branchY} dominantBaseline="middle" textAnchor="start" fontSize="9.5" fontWeight="700" fill="var(--text-900)" style={{ cursor: "pointer" }} onClick={() => onOpen(t)}>{t.title}</text>
              {hasDescription && (
                <g
                  className="lp-pm-note-trigger"
                  transform={`translate(${noteX}, ${branchY - 8})`}
                  onClick={(e)=>{
                    e.stopPropagation();
                    setDescriptionPopup({task:t,x:e.clientX,y:e.clientY});
                  }}
                  style={{cursor:"pointer"}}
                >
                  <title>Afficher la description</title>
                  <rect x="0" y="0" width="17" height="16" rx="4" fill="var(--surface)" stroke="var(--border)" strokeWidth="1"/>
                  <path d="M4.5 4.5h8M4.5 7.5h8M4.5 10.5h5.5" fill="none" stroke="var(--text-600)" strokeWidth="1.25" strokeLinecap="round"/>
                  <path d="M11.2 1.9v2.7h2.7" fill="none" stroke="var(--text-600)" strokeWidth="1.05" strokeLinecap="round" strokeLinejoin="round" opacity=".7"/>
                </g>
              )}
              {fields.includes("dates") && (
                <>
                  <rect x={dateX - 3} y={branchY - 6} width={pmMeasureText(fmtShort(t.end), MS_TITLE_FONT) + 6} height={12} fill="var(--surface)" />
                  <text x={dateX} y={branchY} dominantBaseline="middle" textAnchor="start" fontFamily="var(--font-mono)" fontSize="9" fontWeight="600" fill="var(--text-600)">{fmtShort(t.end)}</text>
                </>
              )}
            </g>
          );
        })}

        {!isCollapsed && items.filter((it) =>
          getTaskType(it.t) === "action" &&
          !isFullyShared(it.t) &&
          (!it.t.linkedActivityId || expandedActivities.has(it.t.linkedActivityId))
        ).map(({ t, side, branchDist, subtasks }) => {
          const branchY = mainY + side * branchDist;
          const x1 = xFor(t.end);
          const done = isTaskDoneGlobal(t, ctx);
          const chips = fieldChipsFor(t);
          const titleW = pmMeasureText(t.title, TITLE_FONT);
          // Tâche partagée avec un projet actuellement non affiché (repli — voir
          // isFullyShared) : petit repère à côté du titre pour ne pas perdre cette
          // information de partage juste parce que l'autre ligne n'est pas visible.
          const sharedOtherProject = t.secondaryProjectId
            ? ctx.projects.find((pr) => pr.id === (t.projectId === p.id ? t.secondaryProjectId : t.projectId))
            : null;
          const sharedBadgeW = sharedOtherProject ? 18 : 0;
          const hasDescription = !!String(t.desc ?? t.description ?? "").trim();
          const noteBadgeW = hasDescription ? 22 : 0;
          const noteX = x1 + 14 + titleW + 7;
          let cursorX = x1 + 14 + titleW + noteBadgeW + sharedBadgeW + 16;
          const taskColor = p.isFolderGroup
            ? (ctx.projects.find((pr) => pr.id === t.projectId)?.color || "var(--text-muted)")
            : ((ctx.statuses.find((s) => s.id === t.statusId) || {}).color || "var(--text-muted)");
          return (
            <g key={"txt-" + t.id} opacity={dimOpacity(t.id)}>
              {/* Doublon purement visuel de la station, garanti au-dessus de toute ligne
                  (une bulle ne doit jamais être masquée, même partiellement) — mais ne doit
                  surtout pas intercepter les clics/glisser destinés à la vraie station
                  interactive juste en dessous, sous peine de rendre le glisser impossible. */}
              <g style={{ pointerEvents: "none" }}>
                <Station x={x1} y={branchY} color={taskColor} r={5.5} done={done} icon={p.metroTaskIcons ? resolveMilestoneIcon(t, ctx) : null} justCompleted={justCompletedIds.has(t.id)} />
              </g>
              <rect x={x1 + 10} y={branchY - 9} width={titleW + 12} height={18} rx="2.5" fill="var(--surface)" opacity="0.99" />
              <text x={x1 + 14} y={branchY} dominantBaseline="middle" textAnchor="start" fontSize="10.5" fontWeight="700" fontFamily="Inter, sans-serif" fill="var(--text-900)" opacity={done ? 0.55 : 1} onClick={() => onOpen(t)} className="lp-pm-task">{t.title}</text>
              {hasDescription && (
                <g
                  className="lp-pm-note-trigger"
                  transform={`translate(${noteX}, ${branchY - 8})`}
                  onClick={(e) => {
                    e.stopPropagation();
                    setDescriptionPopup({
                      task:t,
                      x:e.clientX,
                      y:e.clientY
                    });
                  }}
                  style={{cursor:"pointer"}}
                >
                  <title>Afficher la description</title>
                  <rect x="0" y="0" width="17" height="16" rx="4" fill="var(--surface)" stroke="var(--border)" strokeWidth="1"/>
                  <path
                    d="M4.5 4.5h8M4.5 7.5h8M4.5 10.5h5.5"
                    fill="none"
                    stroke="var(--text-600)"
                    strokeWidth="1.25"
                    strokeLinecap="round"
                  />
                  <path
                    d="M11.2 1.9v2.7h2.7"
                    fill="none"
                    stroke="var(--text-600)"
                    strokeWidth="1.05"
                    strokeLinecap="round"
                    strokeLinejoin="round"
                    opacity=".7"
                  />
                </g>
              )}
              {sharedOtherProject && (
                <g
                  style={{ cursor: "pointer" }}
                  onClick={(e) => {
                    e.stopPropagation();
                    if ((e.ctrlKey || e.metaKey) && onToggleProject) onToggleProject(sharedOtherProject.id);
                    else if (onSelectProject) onSelectProject(sharedOtherProject.id);
                    else onOpen(t);
                  }}
                >
                  <title>Clic : voir {sharedOtherProject.name} seul · Ctrl/Cmd-clic : l'ajouter à la vue actuelle</title>
                  <circle cx={x1 + 14 + titleW + noteBadgeW + 14} cy={branchY} r="6" fill="#fff" stroke={sharedOtherProject.color || "var(--text-muted)"} strokeWidth="1.6" />
                  <path d={`M ${x1 + 14 + titleW + noteBadgeW + 11} ${branchY} L ${x1 + 14 + titleW + noteBadgeW + 17} ${branchY} M ${x1 + 14 + titleW + noteBadgeW + 15} ${branchY - 2} L ${x1 + 14 + titleW + noteBadgeW + 17} ${branchY} L ${x1 + 14 + titleW + noteBadgeW + 15} ${branchY + 2}`} stroke={sharedOtherProject.color || "var(--text-muted)"} strokeWidth="1.3" fill="none" strokeLinecap="round" strokeLinejoin="round" />
                </g>
              )}
              {chips.map((c, i) => {
                if (c.type === "progress") {
                  const barW = 46, barH = 8;
                  const chipX = cursorX;
                  cursorX += barW + 5;
                  const pct = Math.max(0, Math.min(100, c.task.progress || 0));
                  return (
                    <g key={i} onMouseDown={(e) => startDragProgress(e, c.task, chipX, barW)} style={{ cursor: "pointer" }}>
                      <rect x={chipX} y={branchY - barH / 2} width={barW} height={barH} rx={barH / 2} fill="var(--surface)" />
                      <rect x={chipX} y={branchY - barH / 2} width={barW} height={barH} rx={barH / 2} fill={c.color + "22"} />
                      <rect x={chipX} y={branchY - barH / 2} width={(barW * pct) / 100} height={barH} rx={barH / 2} fill={c.color} />
                    </g>
                  );
                }
                const w = pmMeasureText(c.text, CHIP_FONT) + 16;
                const chipX = cursorX;
                cursorX += w + 5;
                return (
                  <g key={i} onClick={() => onOpen(t)} style={{ cursor: "pointer" }}>
                    <rect x={chipX} y={branchY - 8} width={w} height={16} rx={8} fill="var(--surface)" />
                    <rect x={chipX} y={branchY - 8} width={w} height={16} rx={8} fill={c.color + "22"} />
                    <text x={chipX + w / 2} y={branchY} dominantBaseline="middle" textAnchor="middle" fontSize="8.5" fontWeight="700" fontFamily="Inter, sans-serif" fill={c.color}>{c.text}</text>
                  </g>
                );
              })}
              {subtasks.map(({ sub, depth }) => {
                const subX = xFor(sub.end || t.end);
                const subY = mainY + side * depth; // profondeur absolue depuis la ligne principale
                // Le texte part À GAUCHE de la bulle (jamais à droite) : la marge
                // (au-delà du rayon de la zone de clic invisible, r=9) garantit qu'il
                // ne la recouvre jamais, quelle que soit sa longueur.
                const subTitleW2 = pmMeasureText(truncateTitle(sub.text), SUB_TITLE_FONT);
                const subGap = 12;
                return (
                  <g key={"subtxt-" + sub.id}>
                    <g className="lp-pm-sub-drag" onMouseDown={(e) => startDragSubtask(e, t.id, sub.id, sub.end || t.end)} onTouchStart={(e) => startDragSubtask(e, t.id, sub.id, sub.end || t.end)} style={{ cursor: "ew-resize" }}>
                      <circle cx={subX} cy={subY} r="9" fill="transparent" />
                      <Station x={subX} y={subY} color="var(--text-muted)" r={3} done={sub.done} />
                    </g>
                    <rect x={subX - subGap - subTitleW2} y={subY - 6} width={subTitleW2 + 6} height={12} fill="var(--surface)" />
                    <text x={subX - subGap} y={subY} dominantBaseline="middle" textAnchor="end" fontSize="8" fontWeight="600" fontFamily="Inter, sans-serif" fill="var(--text-600)" opacity={sub.done ? 0.5 : 1} onClick={() => onOpen(t)} className="lp-pm-task">{truncateTitle(sub.text)}</text>
                  </g>
                );
              })}
            </g>
          );
        })}
        {!isCollapsed && (
          <g
            onClick={(e) => { e.stopPropagation(); setProjectSummary({ row, x: e.clientX, y: e.clientY }); }}
            style={{ cursor: "pointer" }}
          >
            {/* Terminus : butoir vectoriel (barre + demi-disque), pas d'emoji. */}
            <circle cx={xFor(maxDate) + 12} cy={mainY} r="14" fill="transparent" />
            <Terminus x={xFor(maxDate) + 6} y={mainY} color={color} />
            {appearance?.animConfetti && <ProjectConfetti x={xFor(maxDate) + 16} y={mainY} active={confettiProjectIds.has(p.id)} />}
          </g>
        )}
      </g>
    );
  };

  // Vue réseau : une ligne compacte par projet, uniquement les jalons (+ un
  // repère de fin de projet), tous alignés sur l'axe temporel commun déjà
  // calculé pour la vue complète — de quoi lire l'état de tous les projets
  // en quelques secondes, sans le détail tâche par tâche.
  const DeadlineRow = ({ row }) => {
    const p = row.project;
    const color = p.color || "var(--text-muted)";
    const statusColorFor = (task) => ctx.statuses.find((st) => st.id === task?.statusId)?.color || color;
    const groups = row.deadlineGroups || [];
    const laneY = row.mainY;
    const isCollapsed = collapsed[p.id];

    if (isCollapsed) {
      return (
        <g>
          {todayX !== null && (
            <line x1={todayX} y1={0} x2={todayX} y2={56} stroke="var(--accent)" strokeWidth="1.8" strokeDasharray="4 5" opacity=".62" />
          )}
          <line x1={xFor(row.minDate)} y1={28} x2={xFor(row.maxDate)} y2={28} stroke={color} strokeWidth="3.2" strokeLinecap="round" opacity=".16" />
          {groups.length > 0 && (
            <g>
              <line x1={xFor(row.minDate)} y1={28} x2={groups[0].x} y2={28} stroke={statusColorFor(groups[0].tasks[0])} strokeWidth="3.2" strokeLinecap="round" opacity=".95" />
              {groups.map((g,gi)=> {
                const next=groups[gi+1];
                if(!next) return null;
                return <line key={`collapsed-seg-${g.date}`} x1={g.x} y1={28} x2={next.x} y2={28} stroke={statusColorFor(g.tasks[0])} strokeWidth="3.2" strokeLinecap="round" opacity=".95"/>;
              })}
              <line x1={groups[groups.length-1].x} y1={28} x2={xFor(row.maxDate)} y2={28} stroke={statusColorFor(groups[groups.length-1].tasks[0])} strokeWidth="3.2" strokeLinecap="round" opacity=".95" />
            </g>
          )}
          {groups.map((g) => {
            const task = g.tasks.find((x) => isTaskLate(x, ctx)) || g.tasks[0];
            const sc = statusColorFor(task);
            const done = isTaskDoneGlobal(task, ctx);
            const collapsedAtRisk = !!task && isTaskLate(task, ctx) && !done;
            return (
              <g key={g.date}>
                {collapsedAtRisk && appearance?.animLateAlert && (
                  <circle
                    cx={g.x}
                    cy={28}
                    r="7"
                    fill="none"
                    stroke={PM_RISK_COLOR}
                    strokeWidth="2"
                    className="lp-pm-late-ring"
                    pointerEvents="none"
                  />
                )}
                <ProjectDeadlineStationGlyph
                  x={g.x}
                  y={28}
                  project={p}
                  task={task}
                  ctx={ctx}
                  color={sc}
                  done={done}
                  radius={6}
                  iconSize={8}
                />
              </g>
            );
          })}
        </g>
      );
    }

    // Connecte deux dates successives. Toutes les branches du jour A convergent
    // vers un nœud virtuel au milieu, puis divergent vers toutes les branches du
    // jour B. Cela produit visuellement :
    // 1 -> N : divergence
    // N -> 1 : convergence
    // N -> M : convergence puis nouvelle divergence
    const transitionPaths = [];
    for (let gi = 0; gi < groups.length - 1; gi++) {
      const a = groups[gi], b = groups[gi + 1];
      const hubX = (a.x + b.x) / 2;
      const bend = Math.min(12, Math.max(5, (b.x - a.x) / 8));

      a.offsets.forEach((off, i) => {
        const y = laneY + off;
        const d = Math.abs(y - laneY) < .5
          ? `M ${a.x} ${y} L ${hubX} ${laneY}`
          : `M ${a.x} ${y} L ${hubX - bend} ${y} Q ${hubX} ${y} ${hubX} ${y + Math.sign(laneY-y)*bend} L ${hubX} ${laneY}`;
        transitionPaths.push(<path key={`in-${gi}-${i}`} d={d} fill="none" stroke={statusColorFor(a.tasks[Math.min(i,a.tasks.length-1)])} strokeWidth="2.2" strokeLinecap="round" opacity=".78" />);
      });

      b.offsets.forEach((off, i) => {
        const y = laneY + off;
        const d = Math.abs(y - laneY) < .5
          ? `M ${hubX} ${laneY} L ${b.x} ${y}`
          : `M ${hubX} ${laneY} L ${hubX} ${y - Math.sign(y-laneY)*bend} Q ${hubX} ${y} ${hubX + bend} ${y} L ${b.x} ${y}`;
        transitionPaths.push(<path key={`out-${gi}-${i}`} d={d} fill="none" stroke={statusColorFor(b.tasks[Math.min(i,b.tasks.length-1)])} strokeWidth="2.2" strokeLinecap="round" opacity=".78" />);
      });

      transitionPaths.push(
        <circle key={`hub-${gi}`} cx={hubX} cy={laneY} r="2.5" fill={color} opacity=".58" />
      );
    }

    return (
      <g>
        {/* Aujourd'hui : repère temporel vertical continu dans chaque ligne.
            Le libellé n'est affiché que sur le premier projet pour éviter la répétition. */}
        {todayX !== null && (
          <g pointerEvents="none">
            <line
              x1={todayX} y1={0} x2={todayX} y2={row.ROW_H}
              stroke="var(--accent)"
              strokeWidth="1.8"
              strokeDasharray="4 5"
              opacity=".62"
            />
            {rowsWithHeights[0]?.project?.id === p.id && (
              <>
                <rect x={todayX - 31} y={5} width="62" height="16" rx="3" fill="var(--surface)" opacity=".96" />
                <text
                  x={todayX} y={16}
                  textAnchor="middle"
                  fontFamily='"Inter", monospace'
                  fontSize="7.5"
                  fontWeight="800"
                  fill="var(--accent)"
                >
                  AUJOURD'HUI
                </text>
              </>
            )}
          </g>
        )}
        {/* Ligne projet : infrastructure temporelle de référence */}
        <line x1={xFor(row.minDate)} y1={laneY} x2={xFor(row.maxDate)} y2={laneY} stroke={color} strokeWidth="3.4" strokeLinecap="round" opacity=".16" />
        {groups.length > 0 && (
          <g>
            <line x1={xFor(row.minDate)} y1={laneY} x2={groups[0].x} y2={laneY} stroke={statusColorFor(groups[0].tasks[0])} strokeWidth="3.4" strokeLinecap="round" opacity=".95"/>
            {groups.map((g,gi)=>{
              const next=groups[gi+1];
              if(!next) return null;
              return <line key={`status-main-${g.date}`} x1={g.x} y1={laneY} x2={next.x} y2={laneY} stroke={statusColorFor(g.tasks[0])} strokeWidth="3.4" strokeLinecap="round" opacity=".95"/>;
            })}
            <line x1={groups[groups.length-1].x} y1={laneY} x2={xFor(row.maxDate)} y2={laneY} stroke={statusColorFor(groups[groups.length-1].tasks[0])} strokeWidth="3.4" strokeLinecap="round" opacity=".95"/>
          </g>
        )}
        {transitionPaths}

        {groups.map((g, gi) => g.tasks.map((t, i) => {
          const y = laneY + g.offsets[i];
          const st = ctx.statuses.find((s) => s.id === t.statusId);
          const done = isTaskDoneGlobal(t, ctx);
          const atRisk = showRiskBadges && !done && isAtRisk(t);
          const stationColor = st?.color || color; // la couleur reflète désormais le statut de la tâche
          const placement = g.placements?.[i] || {
            side:(i % 2 ? "below" : "above"),
            lane:0,
            titleW:120,
            labelX:g.x,
            displayTitle:String(t.title || ""),
            titleTopRel:(i % 2 ? 28 : -56),
          };
          const labelAbove = placement.side === "above";
          const titleW = Math.min(190, Math.max(64, placement.titleW || 120));
          const textX = placement.labelX ?? g.x;
          const titleRectY = laneY + (placement.titleTopRel ?? 0);
          const titleTextY = titleRectY + 11;
          const metaRectY = titleRectY + 16;
          const metaTextY = metaRectY + 10;

          return (
            <g
              key={t.id}
              opacity={dimOpacity(t.id)}
              onMouseDown={(e) => startDragTask(e, t, "deadlineEnd")}
              onTouchStart={(e) => startDragTask(e, t, "deadlineEnd")}
              style={{ cursor:"ew-resize" }}
              data-pm-task-id={t.id}
            >
              {/* Branche de la station depuis la ligne principale */}
              {Math.abs(g.offsets[i]) > .5 && (
                <line x1={g.x} y1={laneY} x2={g.x} y2={y} stroke={stationColor} strokeWidth="1.6" strokeDasharray="2 3" opacity=".30" />
              )}

              {/* Connecteur d'étiquette routé sur une voie dédiée :
                  segments orthogonaux, sans diagonales qui se croisent. */}
              <path
                d={(placement.connectorSegments || []).map((seg, si) =>
                  `${si === 0 ? "M" : "L"} ${si === 0 ? seg.x1 : seg.x2} ${si === 0 ? seg.y1 : seg.y2}`
                ).join(" ")}
                transform={`translate(0 ${laneY})`}
                fill="none"
                stroke={stationColor}
                strokeWidth="1.5"
                strokeLinecap="round"
                strokeLinejoin="round"
                opacity=".38"
                pointerEvents="none"
              />

              <circle cx={g.x} cy={y} r="15" fill="transparent" />
              {atRisk && appearance?.animLateAlert && (
                <circle
                  cx={g.x}
                  cy={y}
                  r="9.5"
                  fill="none"
                  stroke={PM_RISK_COLOR}
                  strokeWidth="2"
                  className="lp-pm-late-ring"
                  pointerEvents="none"
                />
              )}

              <ProjectDeadlineStationGlyph
                x={g.x}
                y={y}
                project={p}
                task={t}
                ctx={ctx}
                color={stationColor}
                done={done}
                radius={8.5}
                iconSize={11}
              />

              {atRisk && (
                <circle
                  cx={g.x}
                  cy={y}
                  r="12"
                  fill="none"
                  stroke={PM_RISK_COLOR}
                  strokeWidth="1.4"
                  strokeDasharray="2 2"
                  pointerEvents="none"
                />
              )}

              {/* Étiquette sur sa propre voie : fond opaque + largeur plafonnée */}
              <rect
                x={textX - titleW/2 - 6}
                y={titleRectY}
                width={titleW + 12}
                height="15"
                rx="3"
                fill="var(--surface)"
                opacity=".985"
              />
              <text
                x={textX}
                y={titleTextY}
                textAnchor="middle"
                fontFamily="Inter, sans-serif"
                fontSize="10"
                fontWeight="700"
                fill="var(--text-900)"
              >
                {placement.displayTitle || (String(t.title || "").length > 30 ? String(t.title).slice(0,29) + "…" : t.title)}
              </text>

              <rect
                x={textX - 43}
                y={metaRectY}
                width="86"
                height="13"
                rx="3"
                fill="var(--surface)"
                opacity=".97"
              />
              <text
                x={textX}
                y={metaTextY}
                textAnchor="middle"
                fontFamily='"Inter", monospace'
                fontSize="7.6"
                fontWeight="700"
                fill={stationColor}
              >
                {fmtShort(t.end)}
              </text>

              <title>{`${t.title} — ${fmtShort(t.end)}${st ? ` — ${st.name}` : ""} — Glisser horizontalement pour modifier l’échéance`}</title>
            </g>
          );
        }))}

        {groups.length > 0 && (
          <>
            <Station x={xFor(row.minDate)} y={laneY} color={color} r={5.5} />
            <Terminus x={xFor(row.maxDate) + 7} y={laneY} color={color} size={.8} />
          </>
        )}
      </g>
    );
  };

  const NetworkRow = ({ row }) => {
    const { project: p, pMilestones, maxDate, avgProgress } = row;
    const color = p.color || "var(--text-muted)";
    const laneY = 30;
    return (
      <g opacity={dimOpacity("net-" + p.id)}>
        <line x1={xFor(row.minDate)} y1={laneY} x2={xFor(maxDate)} y2={laneY} stroke={color} strokeWidth="3" strokeLinecap="round" opacity="0.55" />
        <line x1={xFor(row.minDate)} y1={laneY} x2={xFor(row.minDate) + (xFor(maxDate) - xFor(row.minDate)) * (avgProgress / 100)} y2={laneY} stroke={color} strokeWidth="3" strokeLinecap="round" />
        <Station x={xFor(row.minDate)} y={laneY} color={color} r={6} />
        {pMilestones.map((t) => {
          const mx = xFor(t.end);
          const done = isTaskDoneGlobal(t, ctx);
          const isCritical = !!criticalPathIds && criticalPathIds.has(t.id);
          const atRisk = showRiskBadges && !done && isAtRisk(t);
          return (
            <g key={t.id} onClick={() => onOpen(t)} style={{ cursor: "pointer" }}>
              <foreignObject x={mx - 8} y={laneY - 8} width="16" height="16" style={{ overflow: "visible" }}>
                <MilestoneGlyph size={16} icon={resolveMilestoneIcon(t, ctx)} />
              </foreignObject>
              {isCritical && <circle cx={mx} cy={laneY} r="10" fill="none" stroke={PM_CRITICAL_COLOR} strokeWidth="1.6" />}
              {atRisk && (
                <g transform={`translate(${mx + 8}, ${laneY - 13})`}>
                  <circle r="7" fill="#fff" stroke={PM_RISK_COLOR} strokeWidth="1.4" />
                  <text y="3" textAnchor="middle" fontSize="9" fontWeight="800" fill={PM_RISK_COLOR}>!</text>
                </g>
              )}
            </g>
          );
        })}
        <g onClick={(e) => { e.stopPropagation(); setProjectSummary({ row, x: e.clientX, y: e.clientY }); }} style={{ cursor: "pointer" }}>
          <circle cx={xFor(maxDate) + 12} cy={laneY} r="14" fill="transparent" />
          <Terminus x={xFor(maxDate) + 6} y={laneY} color={color} size={0.85} />
        </g>
      </g>
    );
  };

  const now = iso(new Date());
  // Les widgets de synthèse de l'accueil doivent refléter l'état RÉEL global, pas
  // le sous-ensemble déjà filtré par la vue (ex. "Masquer les tâches terminées