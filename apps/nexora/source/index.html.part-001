  max-width:100%!important;
  margin:0!important;
  display:flex!important;
  align-items:center!important;
  justify-content:flex-end!important;
  gap:10px!important;
  box-sizing:border-box!important;
}
.nexora-icon-editor-panel-v16 .nexora-icon-save-bottom{
  width:130px!important;
  min-width:130px!important;
  max-width:130px!important;
  height:38px!important;
  min-height:38px!important;
  max-height:38px!important;
  margin:0!important;
  box-sizing:border-box!important;
}
@media(max-width:900px){
  .nexora-icon-editor-panel-v16{inset:10px 12px!important;border-radius:7px!important;}
  .nexora-icon-editor-panel-v16 .nexora-icon-editor-shell{grid-template-columns:180px minmax(0,1fr)!important;}
  .nexora-icon-editor-panel-v16 .nexora-icon-editor-head{grid-template-columns:minmax(0,1fr) 120px 32px!important;}
  .nexora-icon-editor-panel-v16 .nexora-icon-editor-count{display:none!important;}
  .nexora-icon-editor-panel-v16 .nexora-icon-style-filter{width:120px!important;min-width:120px!important;max-width:120px!important;}
}
@media(max-width:680px){
  .nexora-icon-editor-panel-v16{inset:6px!important;}
  .nexora-icon-editor-panel-v16 .nexora-icon-editor-shell{grid-template-columns:1fr!important;}
  .nexora-icon-editor-panel-v16 .nexora-icon-editor-side{display:none!important;}
  .nexora-icon-editor-panel-v16 .nexora-icon-editor-main{grid-template-rows:58px minmax(0,1fr) 44px 58px!important;}
  .nexora-icon-editor-panel-v16 .nexora-icon-editor-head{grid-template-columns:minmax(0,1fr) 118px 30px!important;padding:8px!important;}
  .nexora-icon-editor-panel-v16 .nexora-icon-style-filter{width:118px!important;min-width:118px!important;max-width:118px!important;}
}
        /* ============================================================
           RESPONSIVE (Phase A + B) — regroupé en fin de feuille de
           styles pour garantir la priorité en cascade sur TOUTES les
           règles de base ci-dessus, quel que soit leur ordre d'origine
           (une media query n'a pas plus de spécificité qu'une règle
           normale : à spécificité égale, seul l'ordre dans le fichier
           tranche — le déplacer ici évite qu'une règle desktop déclarée
           plus bas ne regagne la main sur un breakpoint actif).
           ============================================================ */
        html, body{ overflow-x:hidden; }
        /* ============================================================
           RESPONSIVE — tokens par palier (Phase A)
           Convention desktop-first (comme le reste du fichier) : la base est
           desktop, chaque palier resserre les tokens dans l'ordre où le CSS
           les lit. min-height:640px sur .lp-app n'a plus de sens sous cette
           hauteur (téléphone en paysage ≈ 380-430px) — désactivé dès 1023px
           de large pour laisser 100dvh gouverner sans forcer de débordement. */
        @media (max-width:1279px){
          .lp-theme, .lp-app, body{ --tablet-padding:18px; }
        }
        @media (max-width:1023px){
          .lp-theme, .lp-app, body{ --touch-target:44px; --tablet-padding:16px; }
          .lp-app{ min-height:0; }
        }
        @media (max-width:767px){
          .lp-theme, .lp-app, body{ --mobile-padding:14px; --mobile-title:17px; --mobile-body:13px; --mobile-gap:10px; --bottom-nav-h:54px; }
        }
        @media (max-width:479px){
          .lp-theme, .lp-app, body{ --mobile-padding:12px; --mobile-title:16px; --mobile-gap:8px; }
        }
        .lp-sync-blocked-banner{ position:fixed; top:0; left:0; right:0; width:100%; box-sizing:border-box; z-index:9999; flex-wrap:wrap; max-height:30dvh; overflow:auto; background:var(--danger); color:#fff; display:flex; align-items:center; gap:12px; padding:12px 20px; font-size:13px; box-shadow:0 4px 16px rgba(10,15,25,0.25); }
        .lp-sync-blocked-banner strong{ font-weight:800; }
        /* Pastille de synchronisation MCP : discrète par construction — elle
           signale une écriture de l'assistant déjà fusionnée sans risque, pas
           un conflit. Elle vit en bas à droite et ne réserve aucune hauteur en
           haut de page, contrairement au bandeau ci-dessus. */
        .lp-mcp-sync-pill{ position:fixed; right:16px; bottom:16px; z-index:9998; display:inline-flex; align-items:center; gap:8px; padding:6px 12px; border:1px solid var(--border); border-radius:999px; background:var(--surface); color:var(--text-muted); font-size:12px; font-weight:600; cursor:pointer; box-shadow:0 2px 10px rgba(10,15,25,0.12); }
        .lp-mcp-sync-pill:hover{ color:var(--text); border-color:var(--accent, #2563eb); }
        .lp-mcp-sync-pill svg{ color:var(--accent, #2563eb); animation:lp-mcp-sync-spin 1.6s linear infinite; }
        .lp-mcp-sync-pill[disabled]{ cursor:default; }
        @keyframes lp-mcp-sync-spin{ to{ transform:rotate(360deg); } }
        @media (prefers-reduced-motion: reduce){ .lp-mcp-sync-pill svg{ animation:none; } }
        .lp-sync-message{flex:1; min-width:180px;} .lp-sync-message p{margin:4px 0;}
        .lp-sync-blocked-detail{font-size:12px;overflow-wrap:anywhere;} .lp-sync-blocked-detail summary{cursor:pointer;text-decoration:underline;text-underline-offset:3px;}
        .lp-modal-host .lp-overlay{z-index:10000;}
        .lp-modal-host :focus-visible{outline:2px solid var(--signal);outline-offset:2px;} .lp-modal[tabindex="-1"]:focus{outline:none;}
        .lp-side-label-toggle{border:0;background:transparent;width:100%;text-align:left;font-family:inherit;}
        button.lp-project-item{width:100%;border:0;background:transparent;text-align:left;font-family:inherit;}
        .lp-project-name{min-width:0;flex:1;border:0;background:transparent;color:inherit;text-align:left;font:inherit;padding:4px 0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
        .lp-project-item:focus-within .lp-project-row-action{opacity:1;}
        .lp-create-row{flex-wrap:wrap;} .lp-create-menu{width:100%;} .lp-create-menu summary{cursor:pointer;padding:8px;border-radius:var(--radius-sm);font-size:13px;}
        .lp-create-options{display:grid;gap:3px;padding:4px;} .lp-create-options button{display:flex;gap:8px;align-items:center;padding:9px;border:0;background:var(--surface);color:var(--text-primary);font:inherit;text-align:left;border-radius:var(--radius-sm);}
        .lp-create-options button:hover{background:var(--quai-elevated);}
        @media(pointer:coarse){.lp-create-row button,.lp-create-menu summary,.lp-create-options button,.lp-project-name,.lp-side-label-toggle,.lp-modal .lp-icon-btn{min-height:44px;}.lp-modal .lp-icon-btn{min-width:44px;}}

        /* ===== Création rapide persistante ===== */
        .lp-global-add-task{
          position:fixed;
          right:24px;
          bottom:24px;
          width:52px;
          height:52px;
          border:0;
          border-radius:50%;
          display:flex;
          align-items:center;
          justify-content:center;
          background:var(--accent);
          color:#fff;
          box-shadow:0 8px 24px rgba(16,21,31,.22), 0 2px 6px rgba(16,21,31,.14);
          cursor:pointer;
          z-index:40;
          transition:transform .14s ease, box-shadow .14s ease, filter .14s ease;
        }
        .lp-global-add-task:hover{
          transform:translateY(-2px);
          filter:brightness(1.03);
          box-shadow:0 12px 30px rgba(16,21,31,.26), 0 3px 8px rgba(16,21,31,.16);
        }
        .lp-global-add-task:active{ transform:translateY(0) scale(.96); }
        .lp-global-add-task svg{ width:23px; height:23px; stroke-width:2.5; }
        .lp-global-add-task-label{
          position:absolute;
          right:calc(100% + 10px);
          top:50%;
          transform:translateY(-50%);
          white-space:nowrap;
          padding:6px 9px;
          border-radius:7px;
          background:var(--ink);
          color:#fff;
          font-size:11.5px;
          font-weight:700;
          pointer-events:none;
          opacity:0;
          visibility:hidden;
          transition:opacity .12s ease, visibility .12s ease;
          box-shadow:0 4px 12px rgba(10,14,26,.18);
        }
        .lp-global-add-task:hover .lp-global-add-task-label,
        .lp-global-add-task:focus-visible .lp-global-add-task-label{
          opacity:1;
          visibility:visible;
        }
        @media (max-width:700px){
          .lp-global-add-task{ right:16px; bottom:16px; width:48px; height:48px; }
        }
        .lp-sync-blocked-banner button{ flex:0 0 auto; background:var(--surface); color:var(--danger-text); border:none; }
        .lp-display{ font-family:var(--font-display); font-size:var(--fs-display); margin:0; line-height:1.2; font-weight:700; }
        .lp-display-xl{ font-family:var(--font-display); font-size:var(--fs-display-xl); font-weight:700; line-height:1.05; letter-spacing:-0.01em; font-variant-numeric:tabular-nums; margin:0; }
        .lp-display-lg{ font-family:var(--font-display); font-size:var(--fs-display-lg); font-weight:700; line-height:1.15; letter-spacing:-.01em; margin:0; }
        .lp-mono{ font-family:var(--font-mono); font-variant-numeric:tabular-nums; }

        .lp-sidebar{ background:var(--surface); color:var(--text-primary); border-right:1px solid var(--border); display:flex; flex-direction:column; padding:12px 10px; overflow-y:auto; overflow-x:hidden; position:relative; }
        /* Scrim + bouton de fermeture du tiroir mobile : invisibles par défaut
           (desktop/tablette large), activés uniquement ≤1023px (voir media
           queries) où la sidebar devient un panneau superposé. */
        .lp-sidebar-scrim{ display:none; }
        .lp-sidebar-mobile-close{
          display:none; position:absolute; top:12px; right:12px; z-index:2;
          width:var(--touch-target); height:var(--touch-target); align-items:center; justify-content:center;
          background:var(--paper-soft); border:1px solid var(--border); border-radius:50%; color:var(--text-secondary); cursor:pointer;
        }
        /* ===== Bandeau des vues enregistrées (bord droit) ===== */

        /* ---- Vue Échéances ---- */
        .lp-deadlines{height:100%;display:flex;flex-direction:column;gap:12px;min-height:0}
        .lp-deadline-hero{display:grid;grid-template-columns:minmax(0,1.5fr) repeat(3,minmax(120px,.5fr));gap:8px}
        .lp-deadline-hero-main,.lp-deadline-kpi{border:1px solid var(--border);background:var(--surface);padding:13px 15px;border-radius:var(--radius)}
        .lp-deadline-hero-main h2{margin:0;font-size:18px;letter-spacing:-.02em}.lp-deadline-hero-main p{margin:5px 0 0;color:var(--text-600);font-size:11.5px}
        .lp-deadline-kpi strong{display:block;font-size:20px;line-height:1}.lp-deadline-kpi span{display:block;margin-top:6px;font-size:9px;font-weight:800;text-transform:uppercase;letter-spacing:.08em;color:var(--text-muted)}
        .lp-deadline-toolbar{display:flex;gap:7px;align-items:center;flex-wrap:wrap}.lp-deadline-toolbar select,.lp-deadline-toolbar input{height:34px}
        .lp-deadline-source-strip{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:7px}
        .lp-deadline-source{border:1px solid var(--border);background:var(--paper-soft);border-radius:var(--radius-sm);padding:9px 10px;display:flex;align-items:center;gap:8px;min-width:0}
        .lp-deadline-source strong{font-size:10.5px;display:block}.lp-deadline-source span{font-size:8.5px;color:var(--text-muted);display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.lp-deadline-source.disabled{opacity:.52}
        .lp-deadline-list{min-height:0;overflow:auto;border-top:1px solid var(--border)}
        .lp-deadline-view-toggle{display:inline-flex;align-items:center;border:1px solid var(--border);border-radius:6px;padding:2px;background:var(--paper-soft);gap:2px}
        .lp-deadline-view-toggle button{height:29px;border:0;background:transparent;color:var(--text-muted);padding:0 9px;border-radius:4px;font-size:9px;font-weight:850;display:flex;align-items:center;gap:5px;cursor:pointer}
        .lp-deadline-view-toggle button.active{background:var(--surface);color:var(--ink);box-shadow:0 1px 3px rgba(10,20,40,.08)}
        .lp-deadline-metro{min-height:0;flex:1;border:1px solid var(--border);border-radius:var(--radius);background:var(--surface);overflow:auto;position:relative}
        .lp-deadline-metro-stage{min-width:980px;position:relative}
        .lp-deadline-metro svg{display:block;width:100%;height:auto;overflow:visible}
        .lp-deadline-metro-label{font-size:10px;font-weight:800;fill:var(--ink)}
        .lp-deadline-metro-sub{font-family:var(--font-mono);font-size:8px;font-weight:700;fill:var(--text-muted)}
        .lp-deadline-metro-cat{font-size:11px;font-weight:850;fill:var(--ink)}
        .lp-deadline-metro-count{font-family:var(--font-mono);font-size:8px;font-weight:800;fill:var(--text-muted)}
        .lp-deadline-metro-today{stroke:var(--signal);stroke-width:1.5;stroke-dasharray:4 4;opacity:.85}
        .lp-deadline-metro-axis{stroke:var(--border);stroke-width:1}
        .lp-deadline-metro-line{stroke-width:5;stroke-linecap:round;opacity:.85}
        .lp-deadline-metro-station{fill:var(--surface);stroke-width:3;cursor:pointer}
        .lp-deadline-metro-station.action{stroke-width:4}
        .lp-deadline-metro-empty{padding:42px 16px;text-align:center;color:var(--text-muted);font-size:12px}
        .lp-deadline-metro-legend{position:sticky;left:0;bottom:0;display:flex;align-items:center;gap:12px;padding:8px 10px;border-top:1px solid var(--border);background:color-mix(in srgb,var(--surface) 94%,transparent);backdrop-filter:blur(8px);font-size:8.5px;color:var(--text-muted)}
        .lp-deadline-metro-legend span{display:flex;align-items:center;gap:5px;white-space:nowrap}
        .lp-deadline-metro-legend i{width:8px;height:8px;border-radius:50%;display:inline-block;border:2px solid currentColor;background:var(--surface)}
        .lp-deadline-month{position:sticky;top:0;z-index:2;padding:9px 0 6px;background:var(--paper);font-family:var(--font-mono);font-size:9px;font-weight:900;text-transform:uppercase;letter-spacing:.12em;color:var(--text-muted)}
        .lp-deadline-row{display:grid;grid-template-columns:72px 10px minmax(0,1fr) 120px 92px 118px;gap:10px;align-items:center;min-height:58px;border-bottom:1px solid var(--border);padding:7px 4px}
        .lp-deadline-date{font-family:var(--font-mono);font-size:10px;font-weight:900}.lp-deadline-dot{width:9px;height:9px;border-radius:50%;border:2px solid currentColor;background:var(--surface)}
        .lp-deadline-title{font-size:12px;font-weight:750}.lp-deadline-desc{margin-top:2px;font-size:9.5px;color:var(--text-muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
        .lp-deadline-tag{font-family:var(--font-mono);font-size:8px;font-weight:800;border:1px solid var(--border);padding:3px 5px;border-radius:3px;width:max-content;max-width:100%;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
        .lp-deadline-days{font-family:var(--font-mono);font-size:9px;font-weight:850;text-align:right}.lp-deadline-days.late{color:var(--danger-text)}
        .lp-deadline-actions{display:flex;justify-content:flex-end;gap:3px}.lp-deadline-empty{padding:36px 12px;text-align:center;color:var(--text-muted);font-size:12px}
        .lp-deadline-modal-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.lp-deadline-modal-grid .wide{grid-column:1/-1}
        .lp-deadline-gmail-card{border:1px solid var(--border);background:var(--surface);border-radius:var(--radius);padding:12px;display:flex;flex-direction:column;gap:9px}
        .lp-deadline-gmail-head{display:flex;align-items:center;gap:9px}.lp-deadline-gmail-head strong{font-size:11.5px}.lp-deadline-gmail-head span{font-size:9px;color:var(--text-muted)}
        .lp-deadline-gmail-badge{margin-left:auto;font-family:var(--font-mono);font-size:8px;font-weight:900;padding:3px 6px;border:1px solid var(--border);border-radius:999px}.lp-deadline-gmail-badge.ok{color:var(--success-text);border-color:color-mix(in srgb,var(--success) 35%,var(--border))}
        .lp-deadline-gmail-controls{display:flex;gap:7px;align-items:center;flex-wrap:wrap}.lp-deadline-gmail-controls select{height:32px}.lp-deadline-gmail-error{font-size:9.5px;color:var(--danger-text);padding:7px 9px;border-radius:4px;background:color-mix(in srgb,var(--danger) 6%,var(--surface));border:1px solid color-mix(in srgb,var(--danger) 18%,var(--border))}
        .lp-gmail-suggestions{display:flex;flex-direction:column;gap:7px;max-height:58vh;overflow:auto}.lp-gmail-suggestion{display:grid;grid-template-columns:82px minmax(320px,1fr) auto;gap:10px;align-items:center;border:1px solid var(--border);border-radius:var(--radius-sm);padding:9px 10px;background:var(--surface)}
        .lp-gmail-suggestion-date{font-family:var(--font-mono);font-size:10px;font-weight:900}.lp-gmail-suggestion-title{font-size:11px;font-weight:800;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.lp-gmail-suggestion-meta{font-size:8.8px;color:var(--text-muted);margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.lp-gmail-suggestion-actions{display:flex;gap:4px}
        .lp-gmail-suggestion-confidence{display:inline-flex;margin-left:5px;font-family:var(--font-mono);font-size:7.5px;padding:2px 4px;border-radius:3px;border:1px solid var(--border)}
        @media(max-width:900px){.lp-deadline-hero{grid-template-columns:1fr 1fr}.lp-deadline-hero-main{grid-column:1/-1}.lp-deadline-source-strip{grid-template-columns:1fr 1fr}.lp-deadline-row{grid-template-columns:58px 8px minmax(0,1fr) 78px}.lp-deadline-row>.lp-deadline-tag:nth-of-type(2){display:none}.lp-deadline-days{display:none}}
        @media(max-width:600px){.lp-deadline-source-strip{grid-template-columns:1fr}.lp-deadline-hero{grid-template-columns:1fr 1fr}.lp-deadline-row{grid-template-columns:52px 8px minmax(0,1fr) 76px;gap:6px}.lp-deadline-tag{display:none}.lp-deadline-modal-grid{grid-template-columns:1fr}}

        .lp-saved-views-rail{
          position:fixed; top:0; right:0; height:100vh; width:14px;
          /* Au-dessus des en-têtes "sticky" de la vue Planning Projets
             (.lp-pm-header-row / .lp-pm-sticky-axis-shell, forcés à
             z-index:999/1000 !important) : sinon leur bandeau blanc restait
             visible par-dessus ce rail, surtout une fois déplié au survol.
             Reste sous les fenêtres modales (.lp-overlay à 1200). */
          z-index:1100;
          display:flex; align-items:stretch; justify-content:flex-end;
          overflow:hidden; transition: width .18s ease;
        }
        .lp-saved-views-rail:hover{ width:64px; }
        .lp-saved-views-rail-inner{
          position:relative; width:64px; flex:0 0 auto; background:var(--ink-soft);
          border-left:1px solid var(--border);
          display:flex; flex-direction:column; align-items:center; gap:14px;
          padding:24px 0; overflow:hidden;
        }
        /* Ligne de métro verticale, en fondu — visible même repliée (dépasse
           légèrement du bord), pour indiquer discrètement que quelque chose
           existe ici avant même le survol. */
        .lp-saved-views-line{
          position:absolute; top:20px; bottom:20px; left:50%; width:3px;
          transform:translateX(-50%); border-radius:3px;
          background:var(--signal);
          opacity:0.6;
        }
        .lp-saved-views-station{
          position:relative; z-index:1; width:34px; height:34px; border-radius:50%;
          background:var(--surface); border:2px solid var(--border-strong); color:var(--text-secondary);
          display:flex; align-items:center; justify-content:center; cursor:pointer;
          flex:0 0 auto; transition:transform .12s ease, border-color .12s ease, color .12s ease;
        }
        .lp-saved-views-station:hover{ border-color:var(--line-blue); color:var(--line-blue); transform:scale(1.1); }
        /* ============================================================
           NAVIGATION MOBILE (≤767px) — Phase B
           La sidebar desktop n'est pas juste compressée : elle devient un
           tiroir plein écran (off-canvas), piloté par le même état
           sidebarCollapsed que sur desktop — seule sa présentation change,
           la logique est identique. Les vues principales vivent dans la
           barre de navigation fixe en bas d'écran (.lp-mobile-tabbar).
           ============================================================ */
        @media (max-width:1023px){
          /* Tablette ET mobile : la sidebar devient un tiroir superposé plutôt
             que de pousser le contenu — évite d'écraser le Gantt/Métro sur un
             écran de 768-1023px de large. Le rail vertical reste, lui, en
             colonne (assez de hauteur en tablette portrait/paysage). */
          .lp-sidebar{
            position:fixed; top:0; left:0; bottom:0; z-index:1300;
            width:min(84vw, 340px) !important; flex:0 0 auto !important;
            max-height:none; overflow-y:auto;
            padding:16px 14px !important;
            transform:translateX(-100%);
            transition:transform .2s cubic-bezier(.2,.8,.3,1);
            box-shadow:2px 0 24px rgba(16,21,31,.16);
          }
          .lp-sidebar.lp-sidebar-open{ transform:translateX(0); }
          .lp-sidebar-resize-wrap{ display:none; }
          .lp-sidebar-mobile-close{ display:flex; }
          .lp-sidebar-scrim{ display:block; position:fixed; inset:0; background:rgba(16,21,31,.35); z-index:1290; }
        }
        @media (max-width:767px){
          .lp-app{ flex-direction:column; }
          .lp-saved-views-rail{ display:none; }

          /* Tiroir plein écran sous 768px (contre 84vw/340px en tablette). */
          .lp-sidebar{ width:88vw !important; padding-top:calc(16px + var(--safe-top)) !important; }

          /* La barre inférieure a besoin de sa hauteur réservée : le contenu
             principal ne doit jamais passer dessous. */
          main{ padding-bottom:0; }
          .lp-content{ padding-bottom:calc(var(--mobile-padding) + var(--bottom-nav-h) + var(--safe-bottom)); }

          .lp-global-add-task{
            bottom:calc(var(--bottom-nav-h) + var(--safe-bottom) + 14px);
            right:calc(14px + var(--safe-right));
            width:50px; height:50px;
          }
        }
        /* Barre de navigation mobile — masquée par défaut (desktop/tablette),
           réapparaît fixe en bas d'écran sous 768px. */
        .lp-mobile-tabbar{ display:none; }
        .lp-mobile-sheet-overlay{ display:none; }
        @media (max-width:767px){
          .lp-mobile-tabbar{
            display:flex; align-items:stretch; position:fixed; left:0; right:0; bottom:0; z-index:1250;
            height:calc(var(--bottom-nav-h) + var(--safe-bottom));
            padding-bottom:var(--safe-bottom);
            padding-left:var(--safe-left); padding-right:var(--safe-right);
            background:var(--surface); border-top:1px solid var(--border);
            box-shadow:0 -2px 16px rgba(16,21,31,.06);
          }
          .lp-mobile-tab{
            flex:1 1 0; min-width:0; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:2px;
            background:none; border:none; cursor:pointer; position:relative;
            color:var(--text-muted); font-size:10px; font-weight:600; padding:4px 2px;
          }
          .lp-mobile-tab span{ overflow:hidden; text-overflow:ellipsis; white-space:nowrap; max-width:100%; }
          .lp-mobile-tab.active{ color:var(--line-blue); }
          .lp-mobile-tab-badge{ top:2px; right:calc(50% - 18px); }
          .lp-mobile-sheet-overlay{ display:block; position:fixed; inset:0; z-index:1260; background:rgba(16,21,31,.32); }
          .lp-mobile-sheet{
            position:fixed; left:0; right:0; bottom:0; z-index:1270;
            max-height:70vh; overflow-y:auto;
            background:var(--surface); border-radius:14px 14px 0 0;
            border:1px solid var(--border); border-bottom:none;
            padding:10px 16px calc(16px + var(--safe-bottom));
            box-shadow:0 -8px 32px rgba(16,21,31,.18);
            animation:lp-mobile-sheet-in .18s cubic-bezier(.2,.8,.3,1) both;
          }
          @keyframes lp-mobile-sheet-in{ from{ transform:translateY(100%); } to{ transform:translateY(0); } }
          .lp-mobile-sheet-handle{ width:36px; height:4px; border-radius:3px; background:var(--border-strong); margin:2px auto 12px; }
          .lp-mobile-sheet-grid{ display:grid; grid-template-columns:repeat(4, 1fr); gap:6px; }
          .lp-mobile-sheet-item{
            display:flex; flex-direction:column; align-items:center; justify-content:center; gap:6px;
            min-height:64px; padding:8px 4px; border:1px solid var(--border); border-radius:var(--radius);
            background:var(--surface); color:var(--text-secondary); font-size:10.5px; font-weight:600;
            cursor:pointer; position:relative; text-align:center;
          }
          .lp-mobile-sheet-item span{ overflow:hidden; text-overflow:ellipsis; white-space:nowrap; max-width:100%; }
          .lp-mobile-sheet-item .lp-tab-badge{ top:4px; right:4px; }
          .lp-mobile-sheet-item-wide{ grid-column:1 / -1; flex-direction:row; min-height:var(--touch-target); justify-content:flex-start; padding:10px 12px; margin-top:6px; }
        }

        /* ============================================================
           MODALES RESPONSIVE (Phase F) — même composant Modal partout,
           seule sa présentation change. Hiérarchie voulue :
             - compact (confirmation)  -> petite feuille ancrée en bas
             - normal/wide (formulaire) -> presque plein écran, ancré en bas
             - extraWide (éditeur complexe, ex. fiche tâche, réglages) -> plein écran
           Le footer (.lp-modal-foot) reste toujours hors du scroll interne
           (.lp-modal garde display:flex/flex-direction:column), donc les
           boutons d'action restent join même avec un contenu long. */
        @media (max-width:1023px){
          .lp-overlay{ align-items:flex-end; padding:0; }
          .lp-modal{ width:100%; max-width:100%; border-radius:14px 14px 0 0; }
          .lp-modal-wide, .lp-modal-extra-wide{ width:100%; max-width:100%; }
          .lp-settings-modal{ width:100%; max-width:100%; }
        }
        @media (max-width:767px){
          .lp-modal{
            width:100%; max-width:100%; max-height:88dvh;
            border-radius:16px 16px 0 0; animation:lp-modal-sheet-in .16s cubic-bezier(.2,.8,.3,1) both;
          }
          @keyframes lp-modal-sheet-in{ from{ transform:translateY(100%); } to{ transform:translateY(0); } }
          .lp-modal-wide{ max-height:92dvh; }
          .lp-modal-foot{ padding-bottom:calc(14px + var(--safe-bottom)); }
          /* Confirmation : feuille compacte, hauteur au contenu, jamais plein écran. */
          .lp-modal-compact{ max-height:60dvh; border-radius:16px 16px 0 0; }
          /* Éditeur complexe (fiche tâche, réglages, générateur d'automatisation…) :
             vrai plein écran, sans coins arrondis ni marge — l'app elle-même. */
          .lp-modal-extra-wide{
            width:100vw; max-width:100vw; height:100dvh; max-height:100dvh;
            border-radius:0; margin:0;
            padding-top:var(--safe-top); padding-bottom:var(--safe-bottom);
          }
          .lp-modal-extra-wide .lp-modal-head{ padding-left:calc(18px + var(--safe-left)); padding-right:calc(18px + var(--safe-right)); }
          .lp-modal-extra-wide .lp-modal-foot{ padding-left:calc(18px + var(--safe-left)); padding-right:calc(18px + var(--safe-right)); padding-bottom:calc(14px + var(--safe-bottom)); }
          .lp-settings-modal{ width:100vw; max-width:100vw; height:100dvh; max-height:100dvh; border-radius:0; }
          .lp-settings-body{ flex-direction:column; }
          .lp-settings-nav{ width:100%; flex-direction:row; overflow-x:auto; padding:6px; gap:4px; border-right:none; border-bottom:1px solid var(--border); }
          .lp-settings-nav-btn{ flex:0 0 auto; white-space:nowrap; }
          .lp-modal-head h3{ font-size:var(--mobile-title); }
        }

        /* ============================================================
           DASHBOARD — pile mobile (Phase C)
           .lp-dashboard-grid-stack est ajoutée en JS (DashboardView) dès que
           gridWidth < 640, quel que soit le breakpoint CSS exact — la mesure
           vient du conteneur réel (ResizeObserver déjà en place), pas d'une
           media query dupliquée. Ici on n'habille que la présentation.
           ============================================================ */
        .lp-dashboard-grid-stack{
          background-image:none; display:flex; flex-direction:column; gap:var(--mobile-gap, 14px);
        }
        .lp-dashboard-grid-stack .lp-widget-card{ position:static !important; width:100% !important; }
        .lp-dashboard-grid-stack .lp-widget-head{ cursor:default; }
        .lp-dashboard-grid-stack .lp-drag-handle{ display:none; }
        .lp-dashboard-grid-stack .lp-widget-resize-handle{ display:none; }

        /* ============================================================
           TABLEUR — colonne "Tâche" collante (Phase E)
           Le Gantt avait déjà sa colonne sticky ; le Tableur non. Sous 768px,
           on garde la sélection + le titre visibles pendant le défilement
           horizontal des colonnes secondaires, sans jamais faire déborder
           l'app elle-même (.lp-table-scroll porte déjà overflow-x:auto).
           ============================================================ */
        @media (max-width:767px){
          .lp-table th.lp-table-th-check, .lp-table td.lp-table-th-check{ position:sticky; left:0; z-index:2; background:var(--surface); }
          .lp-table th.lp-table-th-title, .lp-table td.lp-table-title-cell{ position:sticky; left:34px; z-index:2; background:var(--surface); box-shadow:1px 0 0 var(--border); }
          .lp-table thead th.lp-table-th-check, .lp-table thead th.lp-table-th-title{ z-index:3; background:var(--paper-soft); }
          .lp-table-row-selected td.lp-table-th-check, .lp-table-row-selected td.lp-table-title-cell{ background:color-mix(in srgb, var(--accent) 8%, var(--surface)); }
          .lp-table-title-cell{ max-width:150px; }
        }

        /* ============================================================
           TOUCH (Phase G) — cibles tactiles
           .lp-icon-btn est utilisé massivement, y compris dans des groupes
           denses (en-tête de widget, ligne de tableau) où imposer 44px partout
           ferait déborder ces groupes : on élargit la zone de frappe de façon
           mesurée (28-30px) plutôt que d'atteindre 44px seulement là où c'est
           déjà un contrôle isolé (fermeture de modale, barre du bas, tiroir),
           qui ont chacun leur propre taille explicite ailleurs. */
        @media (max-width:1023px){
          .lp-icon-btn{ padding:8px; }
          .lp-view-order-arrows .lp-icon-btn{ padding:4px; }
          .lp-widget-move-group .lp-icon-btn, .lp-widget-head .lp-icon-btn{ padding:6px; }
          .lp-chip, .lp-filter-chip, .lp-mode-toggle button{ min-height:30px; }
          select, input[type=text], input[type=number], input[type=date], input[type=email], input[type=password]{ min-height:36px; }
        }

        /* ============================================================
           QA MOBILE — alternatives tactiles (passe de finition)
           Certains contrôles n'apparaissaient qu'au :hover (souris) : sur
           tactile (pas de survol), ils restaient invisibles bien qu'ils
           fonctionnent au clic. On les rend visibles en permanence dès
           qu'aucun pointeur fin n'est disponible, sans toucher au
           comportement desktop (qui garde le hover normal).
           ============================================================ */
        @media (hover:none), (max-width:1023px){
          .lp-project-item .lp-project-row-action{ opacity:1; }
          .lp-table-open-btn{ opacity:1; }
          .lp-table tbody td.lp-table-th-actions{ opacity:1; }
        }

        /* Bouton de renommage de page (alternative tactile au double-clic) :
           masqué sur desktop où le double-clic existe déjà, pour ne pas
           surcharger la barre d'onglets qui n'en a pas besoin. */
        .lp-mobile-only-inline{ display:none; }
        @media (hover:none), (max-width:1023px){
          .lp-mobile-only-inline{ display:inline-flex; }
        }

        /* Glisser un bras de Gantt (déplacement / redimensionnement) déclenche
           un scroll de page par défaut au doigt : on neutralise ce geste natif
           uniquement sur les poignées de drag, le JS gère lui-même le suivi
           du doigt (voir startDrag / onMove du moteur Mini Gantt). */
        @media (hover:none){
          .lp-gantt-bar, .lp-gantt-handle{ touch-action:none; }
        }

        /* Idem pour les stations de la Vue Métro (glisser une station = déplacer une
           date ; l'ouverture de la fiche se fait par tap simple, sans glisser réel —
           voir startDragTask/startDragSubtask dans ProjectMetroView). */
        @media (hover:none){
          [data-pm-task-id], [data-pm-task-start-id], .lp-pm-progress-handle, .lp-pm-sub-drag{ touch-action:none; }
        }

        /* =====================================================================
           CENTRE DE PILOTAGE — Control Tower
           Même langage "Le Plan" que la Vue Métro : infrastructure nette,
           lignes de projet, stations, correspondances, signalétique dense.
           ===================================================================== */







        /* ---------------------------------------------------------------------
           Centre de contrôle — Réseau temporel inspiré de Timeline verticale
           --------------------------------------------------------------------- */






        @media (max-width:900px){
        }




        @media (max-width:1100px){
        }
        @media (max-width:767px){
        }


        /* =====================================================================
           LIGNE D'IMPACT — lecture visuelle des dépendances
           ===================================================================== */
        .lp-impact-overlay{
          position:fixed; inset:0; z-index:1200;
          background:rgba(15,23,42,.24);
          backdrop-filter:blur(6px);
          display:flex; align-items:center; justify-content:center;
          padding:24px;
        }
        .lp-impact-shell{
          width:min(1180px,96vw); max-height:92vh;
          background:var(--surface); border:1px solid var(--border);
          border-radius:var(--radius-lg); overflow:hidden;
          box-shadow:0 24px 70px rgba(15,23,42,.20);
          display:flex; flex-direction:column;
        }
        .lp-impact-head{
          display:flex; align-items:center; gap:10px;
          min-height:56px; padding:0 16px;
          border-bottom:1px solid var(--border);
          background:color-mix(in srgb,var(--surface) 96%,var(--paper));
        }
        .lp-impact-title-wrap{ min-width:0; }
        .lp-impact-title{
          font-family:var(--font-display); font-size:18px; font-weight:800;
          color:var(--text-primary); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
        }
        .lp-impact-sub{
          margin-top:2px; font-family:var(--font-mono); font-size:12px;
          color:var(--text-muted); text-transform:uppercase; letter-spacing:.6px;
        }
        .lp-impact-close{
          margin-left:auto; border:0; background:transparent; cursor:pointer;
          width:34px; height:34px; display:flex; align-items:center; justify-content:center;
          border-radius:var(--radius-sm); color:var(--text-secondary);
        }
        .lp-impact-close:hover{ background:var(--paper-soft); color:var(--text-primary); }

        .lp-impact-summary{
          display:grid; grid-template-columns:repeat(6,minmax(0,1fr));
          gap:8px; padding:10px 14px; border-bottom:1px solid var(--border);
          background:var(--paper-soft);
        }
        .lp-impact-kpi{
          padding:8px 9px; background:var(--surface); border:1px solid var(--border);
          border-radius:var(--radius-sm);
        }
        .lp-impact-kpi-value{
          font-family:var(--font-display); font-size:17px; font-weight:800; color:var(--text-primary);
        }
        .lp-impact-kpi-label{
          margin-top:1px; font-family:var(--font-mono); font-size:12px; color:var(--text-muted);
          text-transform:uppercase; letter-spacing:.4px;
        }

        .lp-impact-toolbar{
          display:flex; align-items:center; gap:6px; padding:9px 14px;
          border-bottom:1px solid var(--border);
        }
        .lp-impact-mode{
          border:1px solid var(--border); background:var(--surface);
          color:var(--text-secondary); height:30px; padding:0 10px;
          border-radius:var(--radius-sm); cursor:pointer;
          font-family:var(--font-mono); font-size:12px; font-weight:800; text-transform:uppercase;
        }
        .lp-impact-mode.active{ background:var(--ink); color:white; border-color:var(--ink); }

        .lp-impact-body{
          overflow:auto; padding:16px;
          background:
            linear-gradient(rgba(73,81,102,.04) 1px, transparent 1px),
            linear-gradient(90deg,rgba(73,81,102,.04) 1px, transparent 1px),
            var(--surface);
          background-size:42px 42px;
        }
        .lp-impact-network{
          display:grid; grid-template-columns:minmax(250px,1fr) 330px minmax(250px,1fr);
          gap:28px; align-items:start; min-width:900px;
        }
        .lp-impact-col-title{
          font-family:var(--font-mono); font-size:12px; font-weight:800;
          color:var(--text-muted); text-transform:uppercase; letter-spacing:.55px;
          margin:0 0 10px 4px;
        }
        .lp-impact-stack{ display:flex; flex-direction:column; gap:9px; }
        .lp-impact-node{
          --node-color:var(--line-blue);
          position:relative; display:grid; grid-template-columns:18px minmax(0,1fr) auto;
          gap:8px; align-items:start; padding:9px 10px;
          border:1px solid var(--border); background:var(--surface);
          border-radius:var(--radius); cursor:pointer;
          box-shadow:0 2px 8px rgba(15,23,42,.025);
        }
        .lp-impact-node:hover{ border-color:color-mix(in srgb,var(--node-color) 45%,var(--border)); }
        .lp-impact-node-dot{
          width:13px; height:13px; border-radius:50%;
          background:white; border:2px solid var(--node-color); margin-top:2px;
        }
        .lp-impact-node.milestone .lp-impact-node-dot{
          border-radius:2px; transform:rotate(45deg); width:12px; height:12px;
        }
        .lp-impact-node.late{ border-color:color-mix(in srgb,var(--danger) 32%,var(--border)); }
        .lp-impact-node.critical::after{
          content:""; position:absolute; left:0; top:8px; bottom:8px; width:3px;
          background:var(--danger); border-radius:0 2px 2px 0;
        }
        .lp-impact-node-title{
          font-size:12px; font-weight:760; line-height:1.2; color:var(--text-primary);
        }
        .lp-impact-node-meta{
          margin-top:3px; font-family:var(--font-mono); font-size:12px; line-height:1.45;
          color:var(--text-secondary);
        }
        .lp-impact-badge{
          font-family:var(--font-mono); font-size:12px; font-weight:800;
          padding:2px 4px; border-radius:3px; border:1px solid var(--border);
          background:var(--paper-soft); color:var(--text-secondary); white-space:nowrap;
        }

        .lp-impact-center{
          position:sticky; top:0; align-self:start;
          padding-top:20px;
        }
        .lp-impact-selected{
          --node-color:var(--line-blue);
          position:relative; padding:16px 16px 14px;
          border:2px solid var(--node-color); border-radius:var(--radius-lg);
          background:var(--surface); box-shadow:0 12px 34px rgba(15,23,42,.10);
        }
        .lp-impact-selected::before,
        .lp-impact-selected::after{
          content:""; position:absolute; top:50%; width:28px;
          border-top:3px solid var(--node-color);
        }
        .lp-impact-selected::before{ right:100%; }
        .lp-impact-selected::after{ left:100%; }
        .lp-impact-selected-station{
          width:24px; height:24px; border-radius:50%; background:white;
          border:4px solid var(--node-color); margin-bottom:10px;
        }
        .lp-impact-selected-title{
          font-family:var(--font-display); font-size:17px; font-weight:800; color:var(--text-primary);
        }
        .lp-impact-selected-project{
          margin-top:4px; font-size:12px; font-weight:700; color:var(--node-color);
        }
        .lp-impact-selected-info{
          display:grid; grid-template-columns:1fr 1fr; gap:7px; margin-top:12px;
        }
        .lp-impact-info{
          padding:7px 8px; border:1px solid var(--border); border-radius:var(--radius-sm);
          background:var(--paper-soft);
        }
        .lp-impact-info-label{
          font-family:var(--font-mono); font-size:12px; text-transform:uppercase; color:var(--text-muted);
        }
        .lp-impact-info-value{ margin-top:2px; font-size:12px; font-weight:700; color:var(--text-primary); }

        .lp-impact-empty{
          padding:18px 12px; border:1px dashed var(--border); border-radius:var(--radius);
          color:var(--text-muted); font-size:12px; text-align:center;
        }
        @media (max-width:800px){
          .lp-impact-overlay{ padding:0; align-items:stretch; }
          .lp-impact-shell{ width:100vw; max-height:100dvh; height:100dvh; border-radius:0; }
          .lp-impact-summary{ grid-template-columns:repeat(3,1fr); }
          .lp-impact-body{ overflow:auto; }
          .lp-impact-network{ min-width:860px; }
        }


        /* ================================================================
           ACTION / ACTIVITÉ / JALON — grammaire visuelle Nexora
           ================================================================ */
        .lp-type-selector{
          display:grid; grid-template-columns:repeat(3,1fr); gap:5px;
          padding:4px; background:var(--paper-soft); border:1px solid var(--border);
          border-radius:var(--radius);
        }
        .lp-type-selector button{
          display:flex; align-items:center; justify-content:center; gap:7px;
          min-height:36px; border:1px solid transparent; background:transparent;
          color:var(--text-secondary); cursor:pointer; border-radius:var(--radius-sm);
          font-size:12px; font-weight:720;
        }
        .lp-type-selector button.active{
          background:var(--surface); border-color:var(--border-strong);
          color:var(--text-primary); box-shadow:0 2px 7px rgba(16,21,31,.05);
        }
        .lp-type-selector button:disabled{ opacity:.55; cursor:not-allowed; }
        .lp-type-help{
          margin-top:5px; font-size:10.5px; line-height:1.4; color:var(--text-muted);
        }
        .lp-linked-actions{
          border-left:3px solid var(--line-blue); padding:4px 0 4px 10px;
          display:flex; flex-direction:column; gap:5px;
        }
        .lp-linked-action-row{
          display:grid; grid-template-columns:14px minmax(0,1fr) auto; gap:7px;
          align-items:center; padding:6px 7px; border:1px solid var(--border);
          background:var(--surface); border-radius:var(--radius-sm); cursor:pointer;
        }
        .lp-linked-action-row:hover{ border-color:var(--border-strong); }
        .lp-task-type-badge{
          display:inline-flex; align-items:center; gap:4px; padding:2px 5px;
          border:1px solid var(--border); border-radius:3px;
          font-family:var(--font-mono); font-size:7.8px; font-weight:800;
          text-transform:uppercase; letter-spacing:.25px; color:var(--text-secondary);
          background:var(--paper-soft);
        }
        .lp-task-type-badge.activity{ border-style:solid; }
        .lp-task-type-badge.milestone{ border-width:2px; background:var(--surface); }
        .lp-task-type-badge.blocking{ border-color:color-mix(in srgb,var(--danger) 35%,var(--border)); color:var(--danger-text); }

        .lp-pm-activity-label{
          font-family:Inter,sans-serif; font-size:10.5px; font-weight:800;
          paint-order:stroke fill; stroke:var(--surface); stroke-width:5px; stroke-linejoin:round;
        }
        .lp-pm-activity-actions{
          cursor:pointer; user-select:none;
        }
        .lp-pm-activity-actions text{
          font-family:"Inter",monospace; font-size:8px; font-weight:800;
        }



        .lp-tool-btn.active{
          border-color:color-mix(in srgb,var(--line-blue) 50%,var(--border));
        }
        @media (max-width:700px){
          .lp-pm-toolbar .lp-tool-btn{ white-space:nowrap; }
        }


        @media (max-width:900px){
          .lp-modal-extra-wide .lp-markdown-import-grid{
            grid-template-columns:1fr !important;
          }
        }


        /* ================================================================
           LIGNE D'IMPACT — VERSION MÉTRO PREMIUM
           ================================================================ */
        .lp-impact-overlay{
          background:rgba(16,21,31,.18);
          backdrop-filter:blur(7px) saturate(.92);
          padding:18px;
        }
        .lp-impact-shell{
          width:min(1320px,97vw);
          max-height:94vh;
          border-radius:8px;
          border:1px solid var(--border-strong);
          background:var(--surface);
          box-shadow:0 28px 80px rgba(16,21,31,.20);
        }
        .lp-impact-head{
          min-height:58px;
          padding:0 18px;
          background:var(--surface);
          border-bottom:1px solid var(--border);
        }
        .lp-impact-title{font-size:17px;letter-spacing:-.2px}
        .lp-impact-sub{font-size:12px;letter-spacing:.7px}
        .lp-impact-summary{
          grid-template-columns:repeat(6,minmax(0,1fr));
          gap:0;
          padding:0 14px;
          background:var(--surface);
          border-bottom:1px solid var(--border);
        }
        .lp-impact-kpi{
          border:0;
          border-right:1px solid var(--border);
          border-radius:0;
          padding:9px 12px;
          background:transparent;
        }
        .lp-impact-kpi:last-child{border-right:0}
        .lp-impact-kpi-value{font-family:var(--font-mono);font-size:16px}
        .lp-impact-kpi-label{font-size:12px}
        .lp-impact-toolbar{
          padding:8px 14px;
          flex-wrap:wrap;
          background:color-mix(in srgb,var(--paper) 65%,var(--surface));
        }
        .lp-impact-mode{
          height:auto;
          min-height:36px;
          padding:7px 9px;
          border-radius:3px;
          font-size:12px;
        }
        .lp-impact-body{
          padding:0;
          background:
            linear-gradient(rgba(73,81,102,.035) 1px,transparent 1px),
            linear-gradient(90deg,rgba(73,81,102,.035) 1px,transparent 1px),
            var(--paper);
          background-size:34px 34px;
        }

        .lp-impact-metro{
          position:relative;
          min-width:1050px;
          padding:54px 44px 56px;
        }
        .lp-impact-metro-grid{
          display:grid;
          grid-template-columns:minmax(0,1fr) 220px minmax(0,1fr);
          align-items:center;
          gap:0;
          position:relative;
        }
        .lp-impact-side{
          position:relative;
          min-height:330px;
        }
        .lp-impact-side-label{
          position:absolute;
          top:-34px;
          left:50%;
          transform:translateX(-50%);
          font-family:var(--font-mono);
          font-size:12px;
          font-weight:800;
          letter-spacing:.85px;
          text-transform:uppercase;
          color:var(--text-muted);
          white-space:nowrap;
        }
        .lp-impact-side-label strong{
          color:var(--text-primary);
          font-weight:900;
        }

        .lp-impact-rail{
          position:absolute;
          left:0; right:0; top:50%;
          height:4px;
          transform:translateY(-50%);
          background:linear-gradient(90deg,
            color-mix(in srgb,var(--line-blue) 30%,var(--border)),
            var(--line-blue));
          border-radius:3px;
          z-index:1;
        }
        .lp-impact-side.downstream .lp-impact-rail{
          background:linear-gradient(90deg,
            var(--line-blue),
            color-mix(in srgb,var(--line-blue) 30%,var(--border)));
        }
        .lp-impact-rail::after{
          content:"";
          position:absolute;
          inset:-5px 0;
          border-top:1px solid color-mix(in srgb,var(--line-blue) 12%,transparent);
          border-bottom:1px solid color-mix(in srgb,var(--line-blue) 12%,transparent);
          pointer-events:none;
        }

        .lp-impact-stations{
          position:relative;
          height:330px;
          display:grid;
          grid-template-columns:repeat(var(--count),minmax(164px,1fr));
          align-items:center;
          z-index:2;
        }
        .lp-impact-station-wrap{
          position:relative;
          height:100%;
          display:flex;
          align-items:center;
          justify-content:center;
        }
        .lp-impact-station{
          --station-color:var(--line-blue);
          width:18px;height:18px;
          border-radius:50%;
          border:3px solid var(--station-color);
          background:var(--surface);
          box-shadow:0 0 0 3px var(--surface);
          cursor:pointer;
          position:relative;
          z-index:5;
          transition:transform .14s ease,box-shadow .14s ease;
        }
        .lp-impact-station:hover{
          transform:scale(1.16);
          box-shadow:0 0 0 4px var(--surface),0 0 0 6px color-mix(in srgb,var(--station-color) 24%,transparent);
        }
        .lp-impact-station.activity{
          width:22px;height:14px;border-radius:7px;
        }
        .lp-impact-station.milestone{
          width:21px;height:21px;
          box-shadow:0 0 0 3px var(--surface),0 0 0 5px var(--station-color);
        }
        .lp-impact-station.blocking::after{
          content:"";
          position:absolute;
          inset:-7px;
          border:1.5px dashed var(--danger);
          border-radius:50%;
        }
        .lp-impact-station.critical{
          border-color:var(--danger);
        }
        .lp-impact-station.late{
          box-shadow:0 0 0 3px var(--surface),0 0 0 5px color-mix(in srgb,var(--danger) 45%,transparent);
        }

        .lp-impact-station-label{
          position:absolute;
          width:148px;
          left:50%;
          transform:translateX(-50%);
          text-align:center;
          pointer-events:none;
        }
        .lp-impact-station-wrap:nth-child(odd) .lp-impact-station-label{bottom:54%}
        .lp-impact-station-wrap:nth-child(even) .lp-impact-station-label{top:54%}
        .lp-impact-station-title{
          display:inline-block;
          max-width:148px;
          padding:3px 5px;
          background:color-mix(in srgb,var(--surface) 96%,transparent);
          border-radius:3px;
          font-size:12px;
          line-height:1.2;
          font-weight:760;
          color:var(--text-primary);
          white-space:normal; overflow-wrap:anywhere;
          max-height:4.8em; overflow:auto; pointer-events:auto;
          text-overflow:ellipsis;
        }
        .lp-impact-station-meta{
          margin-top:3px;
          font-family:var(--font-mono);
          font-size:12px;
          line-height:1.35;
          color:var(--text-muted);
        }
        .lp-impact-station-connector{
          position:absolute;
          left:50%;
          width:1px;
          background:color-mix(in srgb,var(--station-color) 35%,var(--border));
          transform:translateX(-50%);
        }
        .lp-impact-station-wrap:nth-child(odd) .lp-impact-station-connector{
          bottom:50%;height:38px;
        }
        .lp-impact-station-wrap:nth-child(even) .lp-impact-station-connector{
          top:50%;height:38px;
        }

        .lp-impact-focus{
          position:relative;
          height:330px;
          display:flex;
          align-items:center;
          justify-content:center;
          z-index:6;
        }
        .lp-impact-focus::before,
        .lp-impact-focus::after{
          content:"";
          position:absolute;
          top:50%;
          height:6px;
          width:50%;
          background:var(--focus-color,var(--line-blue));
          transform:translateY(-50%);
          z-index:-1;
        }
        .lp-impact-focus::before{right:50%}
        .lp-impact-focus::after{left:50%}
        .lp-impact-focus-card{
          --focus-color:var(--line-blue);
          width:236px;
          padding:14px 14px 12px;
          border:1px solid color-mix(in srgb,var(--focus-color) 45%,var(--border));
          border-top:4px solid var(--focus-color);
          border-radius:5px;
          background:var(--surface);
          box-shadow:0 12px 34px rgba(16,21,31,.10);
          position:relative;
        }
        .lp-impact-focus-roundel{
          position:absolute;
          left:50%;top:-18px;
          transform:translateX(-50%);
          width:28px;height:28px;border-radius:50%;
          background:var(--surface);
          border:5px solid var(--focus-color);
          box-shadow:0 0 0 3px var(--surface);
        }
        .lp-impact-focus-title{
          margin-top:6px;
          font-size:14px;
          line-height:1.2;
          font-weight:850;
          color:var(--text-primary);
          text-align:center;
        }
        .lp-impact-focus-project{
          margin-top:4px;
          font-family:var(--font-mono);
          font-size:12px;
          font-weight:800;
          color:var(--focus-color);
          text-align:center;
          text-transform:uppercase;
        }
        .lp-impact-focus-info{
          display:grid;
          grid-template-columns:1fr 1fr;
          gap:5px;
          margin-top:10px;
        }
        .lp-impact-focus-info > div{
          border-top:1px solid var(--border);
          padding-top:5px;
        }
        .lp-impact-focus-info span{
          display:block;
          font-family:var(--font-mono);
          font-size:12px;
          text-transform:uppercase;
          color:var(--text-muted);
        }
        .lp-impact-focus-info strong{
          display:block;
          margin-top:1px;
          font-size:12px;
          color:var(--text-primary);
        }

        .lp-impact-legend{
          display:flex;
          align-items:center;
          justify-content:center;
          gap:16px;
          margin-top:22px;
          padding-top:10px;
          border-top:1px solid var(--border);
          font-family:var(--font-mono);
          font-size:12px;
          color:var(--text-muted);
        }
        .lp-impact-legend span{display:flex;align-items:center;gap:5px}
        .lp-impact-key{width:9px;height:9px;border-radius:50%;border:2px solid var(--line-blue);background:var(--surface)}
        .lp-impact-key.activity{width:13px;height:8px;border-radius:5px}
        .lp-impact-key.milestone{box-shadow:0 0 0 2px var(--line-blue)}
        .lp-impact-key.blocking{border-style:dashed;border-color:var(--danger)}

        .lp-impact-empty-line{
          position:absolute;
          inset:0;
          display:flex;
          align-items:center;
          justify-content:center;
          font-family:var(--font-mono);
          font-size:12px;
          color:var(--text-muted);
          z-index:3;
        }

        @media(max-width:900px){
          .lp-impact-metro{min-width:980px}
          .lp-impact-summary{grid-template-columns:repeat(3,1fr)}
          .lp-impact-kpi:nth-child(3){border-right:0}
        }


        /* ================================================================
           IMPORT MARKDOWN — fenêtre large et champs recadrés
           ================================================================ */
        .lp-modal.lp-markdown-import-modal{
          width:min(1060px,94vw);
          max-width:1060px;
          max-height:90vh;
        }
        .lp-markdown-import-modal .lp-modal-body{
          overflow-x:hidden;
          padding:18px 20px;
        }
        .lp-markdown-import-modal .lp-modal-foot{
          padding:12px 20px;
        }

        .lp-md-common-grid{
          display:grid;
          grid-template-columns:minmax(220px,1.2fr) minmax(180px,.85fr) minmax(220px,1.2fr);
          gap:12px;
          margin-bottom:10px;
          align-items:end;
        }
        .lp-md-common-grid .lp-field > div{
          min-width:0;
        }
        .lp-md-common-grid select{
          min-width:0;
          width:100%;
        }
        .lp-md-common-grid .lp-btn{
          flex:0 0 auto;
          min-width:58px;
        }

        .lp-md-import-list{
          display:flex;
          flex-direction:column;
          gap:8px;
          max-height:46vh;
          overflow-y:auto;
          overflow-x:hidden;
          padding-right:4px;
        }
        .lp-md-import-row{
          display:grid;
          grid-template-columns:minmax(250px,2fr) 145px minmax(155px,1fr) 120px minmax(155px,1fr) 34px;
          gap:9px;
          align-items:end;
          padding:10px;
          border:1px solid var(--border);
          border-radius:var(--radius-sm);
          background:var(--surface);
          min-width:0;
        }
        .lp-md-import-row .lp-field{
          min-width:0;
        }
        .lp-md-import-row input,
        .lp-md-import-row select{
          width:100%;
          min-width:0;
          box-sizing:border-box;
        }
        .lp-md-title-field{
          display:grid;
          grid-template-rows:auto 13px 34px;
        }
        .lp-md-filename{
          min-width:0;
          overflow:hidden;
          text-overflow:ellipsis;
          white-space:nowrap;
          font-family:var(--font-mono);
          font-size:8px;
          color:var(--text-muted);
          line-height:12px;
          margin-top:-1px;
        }
        .lp-md-remove{
          align-self:end;
          justify-self:center;
          margin-bottom:1px;
        }

        @media(max-width:980px){
          .lp-modal.lp-markdown-import-modal{
            width:min(94vw,860px);
          }
          .lp-md-import-row{
            grid-template-columns:minmax(220px,1.7fr) 138px minmax(145px,1fr) 110px minmax(145px,1fr) 32px;
            gap:7px;
          }
        }
        @media(max-width:760px){
          .lp-modal.lp-markdown-import-modal{
            width:96vw;
            max-height:94vh;
          }
          .lp-md-common-grid{
            grid-template-columns:1fr;
          }
          .lp-md-import-row{
            grid-template-columns:1fr 1fr;
            gap:8px;
          }
          .lp-md-title-field{
            grid-column:1 / -1;
          }
          .lp-md-remove{
            grid-column:2;
            justify-self:end;
          }
        }


        .lp-activity-search-select{position:relative;width:100%}.lp-activity-search-trigger{width:100%;min-height:34px;padding:5px 9px;display:flex;align-items:center;justify-content:space-between;gap:8px;border:1px solid var(--border);border-radius:var(--radius-sm);background:var(--surface);color:var(--text-primary);cursor:pointer;text-align:left}.lp-activity-search-trigger:focus{outline:none;border-color:var(--accent);box-shadow:0 0 0 2px color-mix(in srgb,var(--accent) 16%,transparent)}.lp-activity-search-trigger-text{min-width:0;display:flex;flex-wrap:wrap;align-items:baseline;gap:4px 7px;overflow:hidden}.lp-activity-search-trigger-text strong{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:12px}.lp-activity-search-trigger-text>span:not(.lp-activity-empty-value){flex:0 0 auto;font-family:var(--font-mono);font-size:12px;color:var(--text-muted)}.lp-activity-empty-value{font-size:12px}.lp-activity-search-menu.is-up{top:auto;bottom:calc(100% + 4px)}.lp-activity-search-menu{position:absolute;z-index:3000;left:0;right:0;top:calc(100% + 4px);border:1px solid var(--border-strong);border-radius:5px;background:var(--surface);box-shadow:0 14px 34px rgba(16,21,31,.16);overflow:hidden}.lp-activity-search-box{display:flex;align-items:center;gap:7px;padding:7px;border-bottom:1px solid var(--border);background:var(--paper)}.lp-activity-search-box input{flex:1;min-width:0;height:29px;border:0!important;box-shadow:none!important;background:transparent!important;padding:0!important;font-size:12px}.lp-activity-search-box button{border:0;background:transparent;padding:3px;display:flex;cursor:pointer;color:var(--text-muted)}.lp-activity-search-options{max-height:250px;overflow-y:auto;padding:4px}.lp-activity-search-option{width:100%;min-height:36px;padding:6px 7px;display:grid;grid-template-columns:12px minmax(0,1fr) auto 15px;gap:7px;align-items:center;border:0;border-radius:3px;background:transparent;text-align:left;cursor:pointer;color:var(--text-primary)}.lp-activity-search-option.none{grid-template-columns:minmax(0,1fr) auto}.lp-activity-search-option:hover{background:var(--paper)}.lp-activity-search-option.selected{background:color-mix(in srgb,var(--accent) 7%,var(--surface))}.lp-activity-option-dot{width:9px;height:9px;border-radius:50%;border:2px solid var(--line-blue);background:var(--surface)}.lp-activity-option-main{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:12px;font-weight:650}.lp-activity-option-project{max-width:150px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;padding:2px 5px;border:1px solid var(--border);border-radius:3px;font-family:var(--font-mono);font-size:12px;font-weight:700;color:var(--text-muted);background:var(--paper)}.lp-activity-search-empty{padding:16px 10px;text-align:center;font-size:12px;color:var(--text-muted)}


        /* Widget Métro / Échéances */
        .lp-widget-metro-deadline{
          height:100%;min-height:150px;display:flex;flex-direction:column;overflow:hidden;
        }
        .lp-widget-md-caption{
          flex:0 0 auto;display:flex;align-items:center;gap:14px;
          padding:3px 4px 7px;border-bottom:1px solid var(--border);
          font-family:var(--font-mono);font-size:7.5px;font-weight:700;color:var(--text-muted);
        }
        .lp-widget-md-caption span{display:inline-flex;align-items:center;gap:4px}
        .lp-widget-md-svgwrap{
          flex:1;min-height:90px;overflow:auto hidden;
          background:
            linear-gradient(90deg,rgba(73,81,102,.025) 1px,transparent 1px),
            var(--surface);
          background-size:36px 100%;
        }
        .lp-widget-md-svgwrap svg{display:block;min-width:100%}
        .lp-widget-md-station-group circle{
          transition:transform .12s ease,filter .12s ease;
          transform-box:fill-box;transform-origin:center;
        }
        .lp-widget-md-station-group:hover circle:first-of-type{
          transform:scale(1.22);
          filter:drop-shadow(0 1px 2px rgba(16,21,31,.18));
        }
        .lp-widget-md-foot{
          flex:0 0 auto;display:flex;gap:12px;justify-content:flex-end;
          padding:6px 4px 1px;border-top:1px solid var(--border);
          font-family:var(--font-mono);font-size:7px;color:var(--text-muted);
        }
        .lp-widget-metro-deadline-empty{
          height:100%;min-height:130px;display:flex;flex-direction:column;
          align-items:center;justify-content:center;gap:7px;color:var(--text-muted);
          font-size:11px;
        }
        @media(max-width:650px){
          .lp-widget-md-caption{gap:8px;flex-wrap:wrap}
          .lp-widget-md-foot{justify-content:flex-start;flex-wrap:wrap}
        }


        .lp-widget-md-toolbar{
          flex:0 0 auto;display:flex;align-items:center;justify-content:space-between;gap:8px;
          padding:4px 4px 7px;border-bottom:1px solid var(--border);flex-wrap:wrap;
        }
        .lp-widget-md-zoom,.lp-widget-md-scale{display:flex;align-items:center;gap:4px}
        .lp-widget-md-zoom>span{
          font-family:var(--font-mono);font-size:7.5px;font-weight:800;color:var(--text-muted);margin-right:2px;
        }
        .lp-widget-md-zoom button,.lp-widget-md-scale button{
          height:24px;min-width:26px;padding:0 7px;border:1px solid var(--border);border-radius:3px;
          background:var(--surface);color:var(--text-secondary);font-size:8px;font-weight:700;cursor:pointer;
          display:inline-flex;align-items:center;justify-content:center;
        }
        .lp-widget-md-zoom button:hover,.lp-widget-md-scale button:hover{background:var(--paper)}
        .lp-widget-md-scale button.active{
          border-color:color-mix(in srgb,var(--accent) 50%,var(--border));
          background:color-mix(in srgb,var(--accent) 8%,var(--surface));color:var(--accent-text);
        }
        .lp-widget-md-zoom-value{font-family:var(--font-mono);min-width:42px!important}
        .lp-widget-md-svgwrap{
          flex:1;min-height:90px;max-height:100%;
          overflow:auto;
          scrollbar-width:thin;
          background:
            linear-gradient(90deg,rgba(73,81,102,.025) 1px,transparent 1px),
            var(--surface);
          background-size:36px 100%;
        }
        .lp-widget-md-svgwrap svg{display:block;min-width:100%}


        .lp-widget-md-station-group foreignObject,
        .lp-pm-svg foreignObject{
          overflow:visible;
          pointer-events:none;
        }

        .lp-saved-views-station-empty{opacity:.34;cursor:default;pointer-events:none}

        /* ================================================================
           FILTRES PROJETS / STATUTS — composant unique, inspiré des widgets
           ================================================================ */
        .lp-entity-filter{position:relative;width:100%;min-width:0}
        .lp-entity-filter-trigger{
          min-height:32px;width:auto;max-width:100%;padding:5px 9px;
          display:inline-flex;align-items:center;justify-content:space-between;gap:8px;
          border:1px solid var(--border);border-radius:4px;background:var(--surface);
          color:var(--text-primary);font-size:11px;font-weight:650;cursor:pointer;
        }
        .lp-entity-filter.compact .lp-entity-filter-trigger{width:100%}
        .lp-entity-filter-trigger:hover{border-color:var(--border-strong);background:var(--paper)}
        .lp-entity-filter-panel{
          position:absolute;z-index:9999;left:0;top:calc(100% + 4px);
          width:min(340px,calc(100vw - 28px));max-height:390px;
          display:flex;flex-direction:column;
          border:1px solid var(--border-strong);border-radius:5px;background:var(--surface);
          box-shadow:0 12px 30px rgba(16,21,31,.16);overflow:hidden;
        }
        .lp-entity-filter-search{
          flex:0 0 auto;display:flex;align-items:center;gap:7px;padding:7px;
          border-bottom:1px solid var(--border);background:var(--surface);
        }
        .lp-entity-filter-search input{
          flex:1;min-width:0;height:29px;padding:0 4px!important;border:0!important;
          box-shadow:none!important;background:transparent!important;font-size:11px;
        }
        .lp-entity-filter-search button{
          border:0;background:transparent;color:var(--text-muted);display:flex;padding:3px;cursor:pointer
        }
        .lp-entity-filter-actions{
          display:grid;grid-template-columns:1fr 1fr;gap:7px;padding:7px;
          border-bottom:1px solid var(--border);background:var(--paper-soft);
        }
        .lp-entity-filter-actions button{
          height:26px;border:1px solid var(--border);border-radius:4px;background:var(--surface);
          font-size:9px;font-weight:750;color:var(--text-primary);cursor:pointer;
        }
        .lp-entity-filter-actions button:hover{border-color:var(--border-strong)}
        .lp-entity-filter-groups{
          padding:8px;border-bottom:1px solid var(--border);
        }
        .lp-entity-filter-groups-title{
          margin-bottom:6px;font-family:var(--font-mono);font-size:7.5px;font-weight:800;
          text-transform:uppercase;letter-spacing:.3px;color:var(--text-muted);
        }
        .lp-entity-filter-groupchips{display:flex;flex-wrap:wrap;gap:5px}
        .lp-entity-filter-groupchip{
          display:inline-flex;align-items:center;gap:4px;max-width:100%;
          padding:4px 7px;border:1px solid var(--border);border-radius:4px;background:var(--surface);
          font-size:8.5px;font-weight:750;cursor:pointer;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;
        }
        .lp-entity-filter-list{
          flex:1;min-height:0;overflow-y:auto;padding:5px;
          scrollbar-width:thin;
        }
        .lp-entity-filter-option{
          min-height:33px;padding:6px 7px;display:flex;align-items:center;
          border-radius:4px;cursor:pointer;
          font-family:var(--font-body) !important;
          font-size:12px !important;
          font-weight:400 !important;
          line-height:1.35;
          text-transform:none !important;
          letter-spacing:normal !important;
          color:var(--text-primary);
        }
        .lp-entity-filter-option:hover{background:var(--paper-soft)}
        .lp-entity-filter-option input[type="checkbox"]{
          flex:0 0 auto;
          width:14px;height:14px;
          margin:0 10px 0 0;
          box-sizing:border-box;
          vertical-align:middle;
        }
        .lp-entity-filter-dot{
          width:10px;height:10px;border-radius:50%;flex:0 0 auto;
          margin-right:8px;
          box-shadow:0 0 0 1px rgba(16,21,31,.08);
        }
        .lp-entity-filter-name{
          min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;
          font-family:var(--font-body) !important;
          font-size:12px !important;
          font-weight:400 !important;
          text-transform:none !important;
          letter-spacing:normal !important;
        }
        .lp-entity-filter-empty{padding:18px 10px;text-align:center;font-size:10px;color:var(--text-muted)}
        .lp-entity-filter-actions button,
        .lp-entity-filter-search input,
        .lp-entity-filter-groupchip{
          font-family:var(--font-body) !important;
          text-transform:none !important;
          letter-spacing:normal !important;
          font-weight:500 !important;
        }
        .lp-entity-filter-groups-title{
          font-family:var(--font-body) !important;
          text-transform:none !important;
          letter-spacing:normal !important;
          font-weight:600 !important;
        }

        @media(max-width:700px){
          .lp-entity-filter-panel{width:min(92vw,340px)}
          .lp-filter-condition-row{align-items:stretch;flex-wrap:wrap}
          .lp-filter-condition-row .lp-entity-filter{min-width:220px}
        }


        /* ================================================================
           FILTRES — largeur adaptative, aucun scroll horizontal
           ================================================================ */
        .lp-modal.lp-filters-modal{
          width:min(920px,calc(100vw - 32px));
          max-width:min(920px,calc(100vw - 32px));
          max-height:min(90vh,900px);
        }
        .lp-filters-modal .lp-modal-body{
          overflow-y:auto;
          overflow-x:hidden;
          min-width:0;
          padding:16px 18px;
        }
        .lp-filters-modal .lp-modal-foot{
          padding:12px 18px;
        }
        .lp-filters-modal .lp-filter-section,
        .lp-filters-modal .lp-filter-group,
        .lp-filters-modal .lp-filter-subgroup-wrap,
        .lp-filters-modal .lp-filter-group > *,
        .lp-filters-modal .lp-field{
          min-width:0;
          max-width:100%;
          box-sizing:border-box;
        }

        /* Une condition tient proprement sur une seule ligne sur desktop :
           champ | opérateur | valeur | supprimer */
        .lp-filters-modal .lp-filter-condition-row{
          display:grid;
          grid-template-columns:minmax(145px,180px) minmax(105px,128px) minmax(220px,1fr) 32px;
          gap:8px;
          align-items:start;
          min-width:0;
          max-width:100%;
          overflow:visible;
        }
        .lp-filters-modal .lp-filter-condition-row > *{
          min-width:0;
          max-width:100%;
          box-sizing:border-box;
        }
        .lp-filters-modal .lp-filter-cond-select{
          width:100%;
          min-width:0;
        }
        .lp-filters-modal .lp-filter-condition-row > .lp-mode-toggle{
          width:100%;
          min-width:0;
        }
        .lp-filters-modal .lp-filter-condition-row > .lp-mode-toggle button{
          min-width:0;
          padding-left:7px;
          padding-right:7px;
          white-space:nowrap;
        }
        .lp-filters-modal .lp-filter-condition-row > .lp-icon-btn{
          justify-self:end;
          flex:0 0 auto;
        }
        .lp-filters-modal .lp-filter-condition-row .lp-entity-filter{
          width:100%;
          min-width:0;
        }
        .lp-filters-modal .lp-filter-condition-row .lp-entity-filter-trigger{
          width:100%;
          min-width:0;
        }

        /* Le panneau projet/statut reste dans le viewport et ne force jamais
           le contenu de la modale à s'élargir. */
        .lp-filters-modal .lp-entity-filter-panel{
          width:min(340px,calc(100vw - 48px));
          max-width:calc(100vw - 48px);
          left:auto;
          right:0;
        }
        .lp-filters-modal .lp-entity-filter-actions{
          grid-template-columns:minmax(0,1fr) minmax(0,1fr);
        }
        .lp-filters-modal .lp-entity-filter-actions button{
          min-width:0;
          padding:0 6px;
          white-space:normal;
          line-height:1.15;
        }

        /* Les doubles champs (dates, avancement...) occupent toute la largeur
           disponible sans créer de largeur minimale implicite. */
        .lp-filters-modal .lp-row2{
          display:grid;
          grid-template-columns:minmax(0,1fr) minmax(0,1fr);
          gap:10px;
          width:100%;
        }
        .lp-filters-modal .lp-row2 > div,
        .lp-filters-modal .lp-row2 > label{
          min-width:0;
          width:100%;
        }
        .lp-filters-modal input,
        .lp-filters-modal select{
          max-width:100%;
          box-sizing:border-box;
        }

        /* Les sous-groupes ne poussent plus la modale horizontalement. */
        .lp-filters-modal .lp-filter-subgroup-wrap{
          display:grid;
          grid-template-columns:minmax(0,1fr) 32px;
          gap:6px;
          padding-left:8px;
        }

        @media(max-width:760px){
          .lp-modal.lp-filters-modal{
            width:calc(100vw - 16px);
            max-width:calc(100vw - 16px);
            max-height:94vh;
          }
          .lp-filters-modal .lp-modal-body{
            padding:13px 12px;
          }
          .lp-filters-modal .lp-filter-condition-row{
            grid-template-columns:minmax(0,1fr) minmax(96px,120px) 32px;
          }
          .lp-filters-modal .lp-filter-condition-row > .lp-filter-cond-select{
            grid-column:1 / 2;
          }
          .lp-filters-modal .lp-filter-condition-row > .lp-mode-toggle{
            grid-column:2 / 3;
          }
          .lp-filters-modal .lp-filter-condition-row > div:not(.lp-mode-toggle):not(.lp-icon-btn),
          .lp-filters-modal .lp-filter-condition-row > input,
          .lp-filters-modal .lp-filter-condition-row > select:not(.lp-filter-cond-select){
            grid-column:1 / 3;
          }
          .lp-filters-modal .lp-filter-condition-row > .lp-icon-btn{
            grid-column:3 / 4;
            grid-row:1;
          }
          .lp-filters-modal .lp-row2{
            grid-template-columns:minmax(0,1fr);
          }
          .lp-filters-modal .lp-entity-filter-panel{
            left:0;
            right:auto;
            width:min(330px,calc(100vw - 40px));
          }
        }


        /* Widget Échéances — densité verticale adaptative */
        .lp-widget-metro-deadline .lp-widget-md-svgwrap{
          overscroll-behavior:contain;
          scrollbar-gutter:stable;
        }
        .lp-widget-metro-deadline .lp-widget-md-foot{
          padding-top:4px;
          padding-bottom:0;
        }


        /* Échéances : les lignes projet restent compactes mais leur hauteur
           s'adapte automatiquement aux collisions réelles de libellés. */
        .lp-widget-metro-deadline .lp-widget-md-svgwrap{
          overflow-x:auto;
          overflow-y:auto;
        }
        .lp-widget-metro-deadline .lp-widget-md-station-group text{
          paint-order:stroke;
          stroke:var(--surface);
          stroke-width:.35px;
        }



        /* ================================================================
           DÉMARRAGE NEXORA — logo + réseau 2D animé
           ================================================================ */
        .lp-startup-loader{
          position:fixed;
          inset:0;
          z-index:2147480000;
          display:flex;
          flex-direction:column;
          align-items:center;
          justify-content:center;
          gap:16px;
          min-height:100dvh;
          padding:28px;
          box-sizing:border-box;
          background:var(--paper,#f5f6f4);
          color:var(--text-primary,#111827);
          font-family:Inter,Arial,sans-serif;
          overflow:hidden;
        }
        .lp-startup-logo-scene{
          position:relative;
          width:min(420px,78vw);
          aspect-ratio:3/2;
          display:grid;
          place-items:center;
        }
        .lp-startup-logo-core{
          position:absolute;
          z-index:3;
          width:84px;
          height:84px;
          display:grid;
          place-items:center;
          border-radius:22px;
          background:var(--paper,#f5f6f4);
          box-shadow:
            0 0 0 1px color-mix(in srgb,var(--accent,#ff7a3d) 28%,transparent),
            0 12px 30px rgba(16,24,40,.10);
        }
        .lp-startup-logo-core img{
          width:58px;
          height:58px;
          object-fit:contain;
          animation:lp-startup-logo-float 2.4s ease-in-out infinite;
        }
        .lp-startup-logo-network{
          position:absolute;
          inset:0;
          width:100%;
          height:100%;
          overflow:visible;
        }
        .lp-startup-net-line{
          fill:none;
          stroke:color-mix(in srgb,var(--accent,#ff7a3d) 78%,#ffffff 22%);
          stroke-width:3;
          stroke-linecap:round;
          opacity:.78;
          stroke-dasharray:5 8;
          animation:lp-startup-line-flow 2.6s linear infinite;
        }
        .lp-startup-net-line.l2{
          opacity:.56;
          animation-duration:3.1s;
        }
        .lp-startup-net-line.l3{
          opacity:.42;
          animation-duration:3.7s;
        }
        .lp-startup-static-station{
          fill:var(--paper,#f5f6f4);
          stroke:var(--accent,#ff7a3d);
          stroke-width:2.4;
          transform-origin:center;
          animation:lp-startup-station-breathe 1.9s ease-in-out infinite;
        }
        .lp-startup-static-station.s2,
        .lp-startup-static-station.s5{animation-delay:.35s}
        .lp-startup-static-station.s3,
        .lp-startup-static-station.s6{animation-delay:.7s}

        .lp-startup-moving-station{
          fill:var(--accent,#ff7a3d);
          stroke:var(--paper,#f5f6f4);
          stroke-width:3;
          filter:drop-shadow(0 4px 8px rgba(16,24,40,.16));
        }

        .lp-startup-moving-group.g1{
          offset-path:path("M45 120 C90 72, 145 74, 180 120 S270 170, 315 120");
          offset-rotate:0deg;
          animation:lp-startup-orbit-1 2.7s ease-in-out infinite alternate;
        }
        .lp-startup-moving-group.g2{
          offset-path:path("M70 52 C120 92, 142 150, 180 184 S255 160, 300 72");
          offset-rotate:0deg;
          animation:lp-startup-orbit-2 3.3s ease-in-out infinite alternate;
        }
        .lp-startup-moving-group.g3{
          offset-path:path("M85 190 C128 155, 145 118, 180 120 S245 88, 286 48");
          offset-rotate:0deg;
          animation:lp-startup-orbit-3 3.9s ease-in-out infinite alternate;
        }

        .lp-startup-loader-brand{
          font-family:"Inter",Inter,sans-serif;
          font-size:11px;
          font-weight:800;
          letter-spacing:.18em;
        }
        .lp-startup-loader-copy{
          display:flex;
          flex-direction:column;
          align-items:center;
          gap:5px;
          max-width:480px;
          text-align:center;
        }
        .lp-startup-loader-copy strong{
          font-family:"Inter",Inter,sans-serif;
          font-size:14px;
          font-weight:750;
        }
        .lp-startup-loader-copy span{
          font-size:10.5px;
          color:var(--text-muted,#667085);
        }
        .lp-startup-loader-error{
          max-width:620px;
          max-height:110px;
          overflow:auto;
          padding:8px 10px;
          border:1px solid color-mix(in srgb,var(--danger,#dc2626) 35%,transparent);
          background:color-mix(in srgb,var(--danger,#dc2626) 5%,var(--paper,#fff));
          font-family:"Inter",monospace;
          font-size:9px;
          line-height:1.45;
          color:var(--danger,#b42318);
        }

        @keyframes lp-startup-line-flow{
          to{stroke-dashoffset:-26}
        }
        @keyframes lp-startup-logo-float{
          0%,100%{transform:translateY(0) scale(1)}
          50%{transform:translateY(-3px) scale(1.025)}
        }
        @keyframes lp-startup-station-breathe{
          0%,100%{transform:scale(1);opacity:.92}
          50%{transform:scale(1.18);opacity:1}
        }
        @keyframes lp-startup-orbit-1{
          from{offset-distance:6%}
          to{offset-distance:94%}
        }
        @keyframes lp-startup-orbit-2{
          from{offset-distance:10%}
          to{offset-distance:90%}
        }
        @keyframes lp-startup-orbit-3{
          from{offset-distance:4%}
          to{offset-distance:96%}
        }

        @media (prefers-reduced-motion:reduce){
          .lp-startup-logo-core img,
          .lp-startup-net-line,
          .lp-startup-static-station,
          .lp-startup-moving-group{animation:none!important}
          .lp-startup-moving-group.g1{offset-distance:50%}
          .lp-startup-moving-group.g2{offset-distance:42%}
          .lp-startup-moving-group.g3{offset-distance:58%}
        }


        /* Labels keep a readable size even when an activity name is long. */
        .lp-impact-focus-title,.lp-impact-focus-project,.lp-impact-station-meta{overflow-wrap:anywhere;}
        .lp-impact-focus-info{grid-template-columns:1fr;}
        .lp-impact-legend{flex-wrap:wrap;}
        @media(max-width:600px){
          .lp-activity-search-option{grid-template-columns:12px minmax(0,1fr) 15px;}
          .lp-activity-option-project{grid-column:2;grid-row:2;max-width:100%;justify-self:start;}
          .lp-activity-search-option>svg:last-child{grid-column:3;grid-row:1;}
          .lp-impact-head{padding:10px 12px;}
          .lp-impact-summary{padding:0 4px;}
          .lp-impact-kpi{padding:8px 4px;}
          .lp-impact-kpi-label{overflow-wrap:anywhere;}
        }

        /* Synchronisation Firebase manuelle */
        .lp-firebase-refresh{
          gap:5px;
          white-space:nowrap;
        }
        .lp-firebase-refresh:disabled{
          opacity:.62;
          cursor:default;
        }
        .lp-refresh-spin{
          animation:lp-firebase-spin .8s linear infinite;
        }
        @keyframes lp-firebase-spin{
          to{transform:rotate(360deg)}
        }
        @media(max-width:760px){
          .lp-firebase-refresh-label{display:none}
        }

        /* Bouton "Enregistrer maintenant" */
        .lp-save-now{
          gap:5px;
          white-space:nowrap;
        }
        .lp-save-now:disabled{
          opacity:.62;
          cursor:default;
        }
        .lp-save-now-error{
          color:var(--danger-text);
          border-color:var(--danger);
        }


        /* Tableur — alignement vertical/horizontal cohérent des lignes */
        .sheet-table tbody tr,
        .sheet-table thead tr,
        .spreadsheet-table tbody tr,
        .spreadsheet-table thead tr{
          vertical-align:middle;
        }
        .sheet-table th,
        .sheet-table td,
        .spreadsheet-table th,
        .spreadsheet-table td{
          box-sizing:border-box;
          vertical-align:middle !important;
        }
        .sheet-table td > *,
        .spreadsheet-table td > *{
          vertical-align:middle;
        }
        .sheet-table td:first-child,
        .sheet-table th:first-child,
        .spreadsheet-table td:first-child,
        .spreadsheet-table th:first-child{
          text-align:center;
        }
        .sheet-table td:first-child input[type="checkbox"],
        .sheet-table th:first-child input[type="checkbox"],
        .spreadsheet-table td:first-child input[type="checkbox"],
        .spreadsheet-table th:first-child input[type="checkbox"]{
          display:block;
          margin:0 auto;
        }
        .sheet-table input,
        .sheet-table select,
        .sheet-table button,
        .spreadsheet-table input,
        .spreadsheet-table select,
        .spreadsheet-table button{
          box-sizing:border-box;
        }
        .sheet-table tbody td,
        .spreadsheet-table tbody td{
          line-height:1.25;
        }

        /* Module Devis (Quentin Morel Engineering). */
        .lp-quotes-wrap{ padding:18px 22px; overflow-y:auto; height:100%; }
        .lp-quotes-list{ display:flex; flex-direction:column; gap:6px; }
        .lp-quotes-row{ display:flex; align-items:center; gap:10px; padding:9px 12px; border:1px solid var(--border); border-radius:var(--radius-sm); background:var(--surface); flex-wrap:wrap; }
        .lp-quotes-row-main{ display:flex; flex-direction:column; gap:2px; min-width:160px; flex:1 1 160px; }
        .lp-quotes-number{ font-weight:700; font-size:12.5px; color:var(--text-primary); }
        .lp-quotes-client{ font-size:12px; color:var(--text-secondary); }
        .lp-quotes-title{ font-size:11px; color:var(--text-muted); }
        .lp-quote-badge{ display:inline-flex; align-items:center; padding:3px 9px; border-radius:999px; font-size:10.5px; font-weight:700; color:#fff; white-space:nowrap; }
        .lp-quotes-amount{ font-weight:700; font-size:12.5px; min-width:90px; text-align:right; }
        .lp-quotes-date{ font-size:11.5px; color:var(--text-muted); min-width:70px; }
        .lp-quotes-status-select{ font-size:11.5px; border-radius:var(--radius-sm); border:1px solid var(--border); padding:4px 6px; }
        .lp-quote-lines{ display:flex; flex-direction:column; gap:6px; margin-bottom:8px; }
        .lp-quote-line-row{ display:flex; align-items:center; gap:6px; }
        .lp-quote-line-desc{ flex:1; min-width:0; }
        .lp-quote-line-amount{ min-width:80px; text-align:right; font-weight:600; font-size:12px; }
        .lp-quote-total{ text-align:right; font-size:13px; margin:8px 0 14px; }
        .lp-quote-inline-client{ display:flex; flex-direction:column; gap:8px; padding:10px; border:1px solid var(--border); border-radius:var(--radius-sm); background:var(--paper-soft); margin-bottom:10px; }
        .lp-quote-logo-preview{ margin-top:6px; }
        .lp-quote-logo-preview img{ max-height:60px; max-width:160px; object-fit:contain; border:1px solid var(--border); border-radius:var(--radius-sm); padding:4px; background:var(--surface); }

        /* Catalogue de prestations + chips de compétences (#devis-v2). Les
           chips sont UI seulement — jamais dans le PDF (design déjà validé). */
        .lp-quote-chip{ display:inline-flex; align-items:center; padding:2px 8px; border-radius:999px; font-size:10px; font-weight:700; color:#fff; white-space:nowrap; line-height:1.6; }
        .lp-quote-chip-row{ display:flex; flex-wrap:wrap; gap:4px; }
        .lp-quote-chip-picker{ display:flex; flex-wrap:wrap; gap:5px; margin:2px 0 8px; }
        .lp-quote-chip-btn{ border:none; cursor:pointer; opacity:.4; transition:opacity .12s ease; }
        .lp-quote-chip-btn.active{ opacity:1; box-shadow:0 0 0 2px color-mix(in srgb, var(--text-primary) 25%, transparent); }
        .lp-quote-catalog-picker{ display:flex; flex-direction:column; gap:4px; padding:8px; border:1px solid var(--border); border-radius:var(--radius-sm); background:var(--paper-soft); margin-bottom:10px; max-height:220px; overflow-y:auto; }
        .lp-quote-catalog-picker-item{ display:flex; align-items:center; justify-content:space-between; gap:8px; padding:6px 8px; border-radius:var(--radius-sm); cursor:pointer; text-align:left; border:none; background:none; width:100%; font:inherit; color:inherit; }
        .lp-quote-catalog-picker-item:hover{ background:var(--surface); }
        .lp-quote-catalog-picker-label{ font-weight:700; font-size:12px; }
        .lp-quote-catalog-picker-meta{ font-size:11px; color:var(--text-muted); }
        .lp-quote-catalog-row, .lp-quote-skill-row{ display:flex; align-items:center; gap:10px; padding:8px 10px; border:1px solid var(--border); border-radius:var(--radius-sm); background:var(--surface); flex-wrap:wrap; }
        .lp-quote-catalog-main{ display:flex; flex-direction:column; gap:3px; flex:1 1 160px; min-width:140px; }
        .lp-quote-catalog-label{ font-weight:700; font-size:12.5px; }
        .lp-quote-catalog-desc{ font-size:11px; color:var(--text-muted); }
        .lp-quote-catalog-meta{ font-size:11.5px; color:var(--text-secondary); min-width:90px; text-align:right; }
        .lp-quote-skill-name{ flex:1; font-size:12.5px; font-weight:600; }
        .lp-quote-color-swatch{ width:20px; height:20px; border-radius:50%; border:2px solid transparent; cursor:pointer; padding:0; }
        .lp-quote-color-swatch.active{ border-color:var(--text-primary); }
        .lp-quote-settings-tabs{ margin-bottom:12px; }

    `}</style>
  );
}







function ImpactLineModal({ taskId, tasks, ctx, onClose, onOpenTask }) {
  const [mode, setMode] = useState("full");
  const impactBody = useRef(null);
  useLayoutEffect(() => {
    impactBody.current?.querySelector(".lp-impact-focus")?.scrollIntoView({block:"nearest",inline:"center",behavior:"auto"});
  }, [taskId, mode, tasks.length]);
  const task = tasks.find((t) => t.id === taskId);
  const graph = useMemo(() => buildDependencyGraph(tasks, ctx), [tasks, ctx]);
  const criticalIds = useMemo(
    () => computeCriticalIds(tasks.filter((t) => t.start && t.end && !t.milestone)),
    [tasks]
  );

  const ancestorsFor = (id) => {
    const seen = new Set();
    const walk = (cur) => {
      const t = graph.byId[cur];
      (t?.dependsOn || []).forEach((depId) => {
        if (seen.has(depId)) return;
        seen.add(depId);
        walk(depId);
      });
    };
    walk(id);
    return [...seen].map((id) => graph.byId[id]).filter(Boolean);
  };

  const descendantsFor = (id) => {
    const seen = new Set();
    const walk = (cur) => {
      (graph.dependents[cur] || []).forEach((nextId) => {
        if (seen.has(nextId)) return;
        seen.add(nextId);
        walk(nextId);
      });
    };
    walk(id);
    return [...seen].map((id) => graph.byId[id]).filter(Boolean);
  };

  if (!task) return null;

  const directPreds = (task.dependsOn || []).map((id) => graph.byId[id]).filter(Boolean);
  const directSuccs = (graph.dependents[taskId] || []).map((id) => graph.byId[id]).filter(Boolean);
  const allPreds = ancestorsFor(task.id);
  const allSuccs = descendantsFor(task.id);

  const relevantPreds = mode === "direct" ? directPreds : allPreds;
  const relevantSuccs = mode === "direct"
    ? directSuccs
    : mode === "impact"
      ? allSuccs.filter((t) => isTaskLate(t, ctx) || getTaskType(t) === "milestone" || criticalIds.has(t.id) || graph.blockedSetFor(t.id).size > 0)
      : allSuccs;

  const sortUpstream = [...relevantPreds].sort((a,b) =>
    (a.end || a.start || "").localeCompare(b.end || b.start || "")
  );
  const sortDownstream = [...relevantSuccs].sort((a,b) =>
    (a.start || a.end || "").localeCompare(b.start || b.end || "")
  );

  const projectIds = new Set(
    [task, ...allPreds, ...allSuccs].flatMap((t) => [t.projectId, t.secondaryProjectId]).filter(Boolean)
  );
  const chainItems = [task, ...allPreds, ...allSuccs];
  const lateItems = chainItems.filter((t) => isTaskLate(t, ctx));

  const project = ctx.projects.find((p) => p.id === task.projectId);
  const status = ctx.statuses.find((s) => s.id === task.statusId);
  const taskColor = project?.color || "var(--line-blue)";

  const Station = ({ t }) => {
    const p = ctx.projects.find((x) => x.id === t.projectId);
    const color = p?.color || "var(--line-blue)";
    const type = getTaskType(t);
    const late = isTaskLate(t, ctx);
    const critical = criticalIds.has(t.id);
    const blocking = false;
    const st = ctx.statuses.find((x) => x.id === t.statusId);

    return (
      <div className="lp-impact-station-wrap">
        <div className="lp-impact-station-connector" style={{"--station-color":color}} />
        <button
          type="button"
          className={
            "lp-impact-station " + type +
            (late ? " late" : "") +
            (critical ? " critical" : "") +
            (blocking ? " blocking" : "")
          }
          style={{"--station-color":color}}
          onClick={() => onOpenTask(t)}
          aria-label={`${t.title} · ${p?.name || "Projet"}`}
          title={`${t.title} · ${p?.name || ""}`}
        />
        <div className="lp-impact-station-label">
          <div className="lp-impact-station-title" title={t.title}>{t.title}</div>
          <div className="lp-impact-station-meta">
            {p?.name || "Projet"}<br/>
            {t.end ? fmtShort(t.end) : t.start ? fmtShort(t.start) : "—"}
            {st ? ` · ${st.name}` : ""}
            
          </div>
        </div>
      </div>
    );
  };

  return (
    <div className="lp-impact-overlay" onMouseDown={(e) => { if (e.target === e.currentTarget) onClose(); }}>
      <div className="lp-impact-shell">
        <div className="lp-impact-head">
          <Network size={18} />
          <div className="lp-impact-title-wrap">
            <div className="lp-impact-title">Ligne d’impact</div>
            <div className="lp-impact-sub">Lecture du réseau · amont → station active → aval</div>
          </div>
          <button type="button" aria-label="Fermer la ligne d’impact" className="lp-impact-close" onClick={onClose}><X size={18}/></button>
        </div>

        <div className="lp-impact-summary">
          <div className="lp-impact-kpi"><div className="lp-impact-kpi-value">{allPreds.length}</div><div className="lp-impact-kpi-label">Prédécesseurs</div></div>
          <div className="lp-impact-kpi"><div className="lp-impact-kpi-value">{allSuccs.length}</div><div className="lp-impact-kpi-label">Successeurs</div></div>
          <div className="lp-impact-kpi"><div className="lp-impact-kpi-value">{projectIds.size}</div><div className="lp-impact-kpi-label">Projets</div></div>
          <div className="lp-impact-kpi"><div className="lp-impact-kpi-value">{lateItems.length}</div><div className="lp-impact-kpi-label">En retard</div></div>
          <div className="lp-impact-kpi"><div className="lp-impact-kpi-value">{criticalIds.has(task.id) ? "Oui" : "Non"}</div><div className="lp-impact-kpi-label">Critique</div></div>
        </div>

        <div className="lp-impact-toolbar">
          {[["direct","Direct"],["full","Chaîne complète"],["impact","Impact"]].map(([key,label]) => (
            <button key={key} className={"lp-impact-mode" + (mode === key ? " active" : "")} onClick={() => setMode(key)}>{label}</button>
          ))}
          <span style={{marginLeft:"auto",fontFamily:"var(--font-mono)",fontSize:12,color:"var(--text-muted)"}}>
            {allPreds.length} amont · {allSuccs.length} aval · {projectIds.size} projet{projectIds.size>1?"s":""}
          </span>
        </div>

        <div className="lp-impact-body" ref={impactBody}>
          <div className="lp-impact-metro" style={{width:Math.max(220,sortUpstream.length*164)+260+Math.max(220,sortDownstream.length*164)+88}}>
            <div className="lp-impact-metro-grid" style={{gridTemplateColumns:`minmax(220px,${Math.max(1,sortUpstream.length)}fr) 260px minmax(220px,${Math.max(1,sortDownstream.length)}fr)`}}>
              <section className="lp-impact-side upstream">
                <div className="lp-impact-side-label"><strong>AMONT</strong> · prédécesseurs</div>
                <div className="lp-impact-rail"/>
                {sortUpstream.length ? (
                  <div className="lp-impact-stations" style={{"--count":Math.max(1,sortUpstream.length)}}>
                    {sortUpstream.map((t) => <Station key={t.id} t={t}/>)}
                  </div>
                ) : <div className="lp-impact-empty-line">Aucun prédécesseur</div>}
              </section>

              <section className="lp-impact-focus" style={{"--focus-color":taskColor}}>
                <div className="lp-impact-focus-card" style={{"--focus-color":taskColor}}>
                  <div className="lp-impact-focus-roundel"/>
                  <div className="lp-impact-focus-title">{task.title}</div>
                  <div className="lp-impact-focus-project">{project?.name || "Projet"}</div>
                  <div className="lp-impact-focus-info">
                    <div><span>Statut</span><strong>{status?.name || "—"}</strong></div>
                    <div><span>Responsable</span><strong>{task.assignee || "—"}</strong></div>
                    <div><span>Début</span><strong>{task.start ? fmtShort(task.start) : "—"}</strong></div>
                    <div><span>Fin</span><strong>{task.end ? fmtShort(task.end) : "—"}</strong></div>
                    <div><span>Critique</span><strong>{criticalIds.has(task.id) ? "Oui" : "Non"}</strong></div>
                    <div><span>Impact aval</span><strong>{allSuccs.length}</strong></div>
                  </div>
                </div>
              </section>

              <section className="lp-impact-side downstream">
                <div className="lp-impact-side-label"><strong>AVAL</strong> · conséquences</div>
                <div className="lp-impact-rail"/>
                {sortDownstream.length ? (
                  <div className="lp-impact-stations" style={{"--count":Math.max(1,sortDownstream.length)}}>
                    {sortDownstream.map((t) => <Station key={t.id} t={t}/>)}
                  </div>
                ) : <div className="lp-impact-empty-line">Aucun successeur</div>}
              </section>
            </div>

            <div className="lp-impact-legend">
              <span><i className="lp-impact-key"/>Action</span>
              <span><i className="lp-impact-key activity"/>Activité</span>
              <span><i className="lp-impact-key milestone"/>Jalon</span>
              <span><i className="lp-impact-key blocking"/>Action bloquante</span>
              <span>Couleur = projet · rouge = critique / retard</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  );
}

export default function LePlan({ currentUser, onSignOut }) {
  const [projects, setProjects] = useState(seedProjects);
  const [statuses, setStatuses] = useState(seedStatuses);
  const [taskTypes, setTaskTypes] = useState(seedTaskTypes);
  // Types de jalon d'annotation (Réglages > Types de jalon). Ils ne décrivent
  // pas les tâches : ce sont les repères posés sur un Gantt (#94).
  const [milestoneTypes, setMilestoneTypes] = useState(() => MILESTONE_TYPE_SEED.map((type) => ({ ...type })));
  /* Catalogue d'ateliers et affectations du widget « Charge personnel » (#124).
     Deux magasins distincts et volontairement séparés : le catalogue est un
     réglage (rarement modifié, lu partout), les affectations sont des données
     (une entrée par personne × jour). Les mêler aurait fait relire tout
     l'historique d'affectation à chaque renommage d'atelier. */
  const [workshops, setWorkshops] = useState(() => WORKSHOP_SEED.map((w) => ({ ...w })));
  // Catalogue d'équipes (#159) : un regroupement, pas une donnée d'affectation —
  // vide par défaut, contrairement aux ateliers qui doivent toujours en proposer
  // au moins un.
  const [teams, setTeams] = useState([]);
  // Dossiers d'équipes (#215) : entité de regroupement à côté des équipes,
  // même pattern que projectFolders — un tableau plat {id, name, color},
  // les équipes s'y rattachent via team.folderId.
  const [teamFolders, setTeamFolders] = useState([]);
  const [staffing, setStaffing] = useState([]);
  // Habit Tracker (#193) : même partition — le catalogue de Thèmes/Habitudes
  // est un réglage, le journal des coches est une donnée (une entrée par
  // habitude × jour), comme ateliers/affectations juste au-dessus.
  const [habitThemes, setHabitThemes] = useState([]);
  const [habitLog, setHabitLog] = useState([]);
  const [tasks, setTasksRaw] = useState(seedTasks);
  // Setter compatible avec React.useState, mais enrichi : toute tâche réellement
  // créée ou modifiée reçoit automatiquement lastInteraction. Les suppressions
  // n'ont évidemment plus d'objet à horodater.
  const setTasks = useCallback((updater) => {
    setTasksRaw((prev) => {
      const candidate = typeof updater === "function" ? updater(prev) : updater;
      if (!Array.isArray(candidate)) return candidate;

      // CRITIQUE : si l'updater indique qu'aucune modification n'a eu lieu,
      // conserver EXACTEMENT la même référence de tableau. L'ancienne version
      // reconstruisait malgré tout un nouveau tableau, ce qui relançait les
      // useEffect dépendant de `tasks` et pouvait provoquer une boucle
      // d'écritures Firestore continue.
      if (candidate === prev) return prev;
      if (
        candidate.length === prev.length &&
        candidate.every((t, i) => t === prev[i])
      ) return prev;

      const prevById = new Map(prev.map((t) => [t.id, t]));
      const now = new Date().toISOString();
      let realChange = candidate.length !== prev.length;

      const next = candidate.map((t) => {
        const before = prevById.get(t.id);

        // Nouvelle tâche.
        if (!before) {
          realChange = true;
          return { ...t, lastInteraction:t.lastInteraction || now };
        }

        // Référence identique = aucune interaction sur cette tâche.
        if (before === t) return t;

        realChange = true;

        const statusName = (id) => statuses.find((st)=>st.id===id)?.name || "";
        const wasDone = /termin/i.test(statusName(before.statusId));
        const isDone = /termin/i.test(statusName(t.statusId));

        // Source de vérité prospective : chaque transition vers Terminé reçoit
        // désormais son horodatage propre. Une réouverture l'efface afin que la
        // prochaine complétion obtienne une nouvelle date.
        if (!wasDone && isDone) {
          return { ...t, completedAt:now, lastInteraction:now };
        }
        if (wasDone && !isDone) {
          const { completedAt, ...rest } = t;
          return { ...rest, lastInteraction:now };
        }

        return { ...t, lastInteraction:now };
      });

      return realChange ? next : prev;
    });
  }, [statuses]);
  const [projectFolders, setProjectFolders] = useState([]);
  const [viewFolders, setViewFolders] = useState([]);
  const [expenseCategories, setExpenseCategories] = useState(seedExpenseCategories);
  const [gcalSettings, setGcalSettings] = useState({
    calendars: [],
    daysPast: 30,
    daysFuture: 365,
  });
  const [gcalSyncState, setGcalSyncState] = useState({ eventsByTaskId: {} });
  const [metaFilters, setMetaFilters] = useState(defaultMetaFilters());
  const [metaTemporalBlocks, setMetaTemporalBlocks] = useState([]);
  const [notifications, setNotifications] = useState([]);
  const [syncedCalendarSettings, setSyncedCalendarSettings] = useState({
    zone: "A",
    department: "69",
    calendars: [
      { id:"fr-holidays", enabled:true, projectName:"Jours fériés", color:"#2E9B72" },
      { id:"school-holidays", enabled:true, projectName:"Vacances scolaires", color:"#4E7CC7" },
      { id:"clock-changes", enabled:true, projectName:"Changements d’heure", color:"#8A64C5" },
      { id:"taxes", enabled:true, projectName:"Fiscalité", color:"#E5573F" },
    ],
    lastSyncAt: null
  });
  const [startupPref, setStartupPref] = useState({ mode: "view", value: "projects" });
  // Vue ouverte par défaut quand on entre dans un projet. Vide = conserver la
  // vue en cours, le comportement d'avant ce réglage.
  const [projectDefaultView, setProjectDefaultView] = useState("");
  // Valeurs par défaut à la création d'une tâche (#183) : appliquées seulement
  // là où rien de plus précis n'a déjà décidé (contexte d'ouverture, filtre de
  // projet actif) — vide = le comportement d'avant ce réglage. Retour de
  // test : élargi à tous les champs qu'une présélection a du sens de porter
  // (statut, second projet, type de tâche) — champ vide = "Aucun" partout.
  const [taskDefaults, setTaskDefaults] = useState({
    projectId: "", secondaryProjectId: "", taskTypeId: "", statusId: "", assignee: "", criticality: "", milestone: "",
  });
  // Templates de tâche nommés (#183, retour de test) : mêmes champs que les
  // valeurs par défaut ci-dessus, mais nommés et choisis à la volée (clic
  // droit sur un bouton d'ajout) plutôt que systématiquement appliqués.
  const [taskTemplates, setTaskTemplates] = useState([]);
  const [lastOpenedView, setLastOpenedView] = useState("projects");
  const [lastOpenedViewLoaded, setLastOpenedViewLoaded] = useState(false);
  useEffect(() => {
    let cancelled = false;
    (async () => {
      try {
        if (window.storage) {
          const res = await window.storage.get("nexora:lastOpenedView");
          if (res && res.value && !cancelled) {
            const restored = parseStoredValue(res.value);
            if (typeof restored === "string" && ALL_VIEWS_META.some((v)=>v.key===restored)) setLastOpenedView(restored);
          }
        }
      } catch (e) {}
      if (!cancelled) setLastOpenedViewLoaded(true);
    })();
    return () => { cancelled = true; };
  }, []);

  const [favorites, setFavorites] = useState([]); // [{ type: "project"|"view"|"dashboard"|"task", id }]
  const unreadNotificationsCount = useMemo(() => notifications.filter((n) => !n.read).length, [notifications]);
  // Module Devis (Quentin Morel Engineering) : calculs partagés dans
  // NEXORA:QUOTES (part-000). quoteClients est un mini-registre réutilisable
  // d'un devis à l'autre ; quoteSettings est un objet-carte comme
  // gcalSettings ci-dessus (réglages entreprise, pour l'instant en mockup).
  const [quotes, setQuotes] = useState([]);
  const [quoteClients, setQuoteClients] = useState([]);
  const [quoteSettings, setQuoteSettings] = useState(seedQuoteSettings);
  // Catalogue de prestations et chips de compétences/logiciels (#devis-v2) :
  // seedés (part-000) pour être utilisables dès la première ouverture, mais
  // librement éditables/supprimables ensuite — jamais un contenu figé en dur.
  const [quoteCatalog, setQuoteCatalog] = useState(seedQuoteCatalog);
  const [quoteSkills, setQuoteSkills] = useState(seedQuoteSkills);
  // Module Facture (#devis-v2 suite) : mêmes principes de persistance que les
  // devis ci-dessus — une simple liste d'objets identifiables.
  const [invoices, setInvoices] = useState([]);
  const [expenses, setExpenses] = useState([]);
  // Finance PRO (#267) : entités NOUVELLES, distinctes de expenses/
  // expenseCategories/budgetLines ci-dessus (jamais réutilisées — décision de
  // cadrage 2026-09-22, voir docs/finance-pro/AUDIT_CONCEPTION.md). Chaque
  // entité ne référence que des id existants (projects, quoteClients) — pas
  // de duplication de client ou de mission.
  const [proMissions, setProMissions] = useState([]);
  const [proTimeEntries, setProTimeEntries] = useState([]);
  const [proExpenseCategories, setProExpenseCategories] = useState(seedProExpenseCategories);
  const [proExpenses, setProExpenses] = useState([]);
  const [proBillingSchedule, setProBillingSchedule] = useState([]);
  const [proPayments, setProPayments] = useState([]);
  const [financeProSettings, setFinanceProSettings] = useState(seedFinanceProSettings);
  // Base des obligations fiscales/sociales (Urssaf, CFE, assurance pro...) —
  // saisie manuelle, pas encore reliée au widget Échéances (cf. part-003,
  // NEXORA:FINANCEPRO-CORE, PRO_OBLIGATION_TYPES).
  const [proObligations, setProObligations] = useState([]);
  const [budgetLines, setBudgetLines] = useState([]); // budget théorique par catégorie et par projet
  const [teamMembers, setTeamMembers] = useState(seedTeamMembers);
  /* Instantanés quotidiens par projet. Plus personne ne les écrit ni ne les
     affiche depuis la suppression du widget Project Momentum (#99) ; l'état
     reste chargé pour que la sauvegarde complète continue d'emporter ce qui a
     déjà été enregistré, et que le MCP le retrouve inchangé. */
  const [momentumSnapshots, setMomentumSnapshots] = useState([]);
  const [activityLog, setActivityLog] = useState([]); // journal d'activité réel (créations, complétions, réaffectations, échéances modifiées) — alimente "Changements récents" du Daily Briefing
  const [taskBaselines, setTaskBaselines] = useState({}); // { [taskId]: {start,end,capturedAt} } — "plan initial" honnête, capturé une seule fois à la première apparition de chaque tâche, jamais réécrit ensuite. Alimente le widget Time Machine.
  const [taskArchive, setTaskArchive] = useState([]); // tâches archivées (retirées de nexora:tasks pour garder ce document sous la limite Firestore), consultables et restaurables depuis Réglages > Données
  const [dataLoaded, setDataLoaded] = useState(false);
  // { [key]: { revision, source } } — une écriture distante a confirmé une
  // révision différente de celle connue par CETTE session (détectée en temps
  // réel via window.storage.watch, voir plus bas). `source` dit QUI a écrit :
  // « assistant-api » pour la passerelle assistant/MCP, « browser » pour une
  // autre session Nexora, null pour un manifeste antérieur à ce marquage.
  // Purement informatif : grâce à la fusion de conflit consciente
  // (attemptPersist), continuer à travailler ici ne perdra rien — mais recharger
  // permet de voir tout de suite ce que l'autre session a ajouté.
  const [remoteChangeDetected, setRemoteChangeDetected] = useState({});
  const [syncBlocked, setSyncBlocked] = useState(null); // message d'erreur si le CHARGEMENT INITIAL a échoué (bloque tout, à raison : aucune donnée fiable n'est encore en mémoire)
  const [blockedKeys, setBlockedKeys] = useState({}); // { [key]: {message,since} } — clés dont la DERNIÈRE écriture a échoué malgré une tentative de récupération auto. Les autres clés continuent de se synchroniser normalement.
  const [rescueRecovery, setRescueRecovery] = useState(null); // { entries:[{key,savedAt,value}], busy } — modifications trouvées dans la copie de secours locale, jamais confirmées synchronisées lors de la session précédente

  // syncStatus reflète TOUJOURS le dernier enregistrement tenté, quelle que soit la donnée concernée
  // (projets, statuts, tâches, dossiers, vues, apparence) — visible en permanence dans la barre du haut.
  const [syncStatus, setSyncStatus] = useState({ state: "idle", error: "", key: "" });
  const [firebaseRefreshing, setFirebaseRefreshing] = useState(false);

  // Sauvegarde Firestore anti-saturation :
  // 1) une seule écriture à la fois ;
  // 2) plusieurs changements successifs de la même clé sont fusionnés ;
  // 3) les tâches bénéficient en plus d'un debounce plus bas.
  const persistQueueRef = useRef(Promise.resolve());
  const pendingPersistRef = useRef(new Map());
  const persistScheduledRef = useRef(new Set());
  const oversizeWarnedRef = useRef(new Set()); // clés déjà signalées comme proches de la limite Firestore, pour ne prévenir qu'une fois par session
  // Certains effets de sauvegarde sont volontairement déclenchés par le flip
  // d'un flag "XLoaded" (ex. `[value, XLoaded]`) plutôt que par le SEUL
  // changement de `value`, pour capter les migrations douces qui modifient
  // l'état juste après le chargement. Problème : ce même flip déclenche AUSSI
  // l'effet la toute première fois, alors que `value` vient tout juste d'être
  // lu depuis le stockage et n'a donc PAS changé — ce qui produisait un envoi
  // Firestore inutile (et une copie de secours locale immédiate) à CHAQUE
  // ouverture de l'app pour une dizaine de clés, sans que rien n'ait vraiment
  // changé. Symptôme observé : le bandeau "Modifications non synchronisées
  // retrouvées" apparaissant systématiquement au démarrage.
  // Chaque clé chargée s'enregistre ici une fois (juste après sa lecture) ;
  // persistKey consomme ce laissez-passer au tout premier appel qui suit —
  // s'il s'agit bien du flip initial, l'écriture est silencieusement ignorée ;
  // toute écriture ULTÉRIEURE (vraie modification, y compris via une
  // migration qui tourne juste après le chargement) passe normalement.
  const justHydratedKeysRef = useRef(new Set());
  const markJustHydrated = (key) => { justHydratedKeysRef.current.add(key); };

  const RESCUE_PREFIX = "nexora:rescue:";
  const clearRescue = (key) => { try { localStorage.removeItem(RESCUE_PREFIX + key); } catch (_) {} };

  // Liste toutes les copies de secours locales jamais confirmées synchronisées
  // (donc potentiellement plus récentes que ce que Firebase contient). Utilisé
  // au démarrage pour proposer une récupération, et par le bouton "Réessayer"
  // manuel sur une clé bloquée.
  const scanRescueEntries = () => {
    const found = [];
    try {
      for (let i = 0; i < localStorage.length; i++) {
        const k = localStorage.key(i);
        if (!k || !k.startsWith(RESCUE_PREFIX)) continue;
        try {
          const raw = JSON.parse(localStorage.getItem(k));
          found.push({ key: k.slice(RESCUE_PREFIX.length), savedAt: raw.savedAt, value: raw.value });
        } catch (_) {}
      }
    } catch (_) {}
    return found;
  };

  // ---------------------------------------------------------------------
  // Résolution de conflit consciente (remplace l'ancien rattrapage aveugle).
  //
  // AVANT : en cas de conflit de révision (une autre session a sauvegardé
  // entretemps), le code relisait juste la révision distante puis réécrivait
  // la valeur LOCALE par-dessus — écrasant silencieusement ce que l'autre
  // session venait d'enregistrer. C'était la cause principale des pertes de
  // données "d'une session à l'autre" : un onglet resté ouvert en arrière-plan
  // ou un appareil rouvert plus tard, dès sa première sauvegarde, effaçait
  // tout ce qui avait été écrit ailleurs entretemps, sans aucune erreur.
  //
  // MAINTENANT : pour les clés en forme de liste/carte identifiable (tâches,
  // projets, dépenses...), on fusionne élément par élément — les ajouts des
  // deux côtés sont conservés, et pour un même élément modifié des deux
  // côtés, on garde le plus récent selon un horodatage si disponible
  // (lastInteraction/updatedAt/modifiedAt/createdAt). Seul un VRAI conflit
  // (même élément modifié des deux côtés sans horodatage permettant de
  // trancher) est signalé — jamais deviné en silence.
  // === NEXORA:SYNCMERGE:START ===
  const NEXORA_MERGEABLE_KEYS = new Set([
    "nexora:tasks", "nexora:projects", "nexora:statuses",
    "nexora:projectFolders", "nexora:viewFolders",
    "nexora:expenseCategories", "nexora:expenses", "nexora:budgetLines",
    "nexora:teamMembers", "nexora:momentumSnapshots", "nexora:activityLog",
    "nexora:taskBaselines", "nexora:taskArchive",
    "nexora:metaTemporalBlocks",
    "nexora:notifications", "nexora:favorites",
    // Ajoutées après le 409 observé en posant un filtre de criticité sur un
    // Mini-Gantt. Ce sont des listes d'objets identifiables comme les autres,
    // mais elles manquaient ici : un conflit les BLOQUAIT au lieu de les
    // fusionner, et plus aucun réglage ne partait jusqu'au rechargement de
    // l'onglet. nexora:dashboards porte les tableaux de bord et leurs widgets —
    // c'est elle qu'écrit la modification d'un filtre de widget.
    "nexora:dashboards", "nexora:dashboardFolders", "nexora:views", "nexora:taskTypes",
    "nexora:milestoneTypes",
    // Ateliers et affectations (#124) : deux listes d'objets identifiables,
    // fusionnables élément par élément comme les précédentes. L'identifiant
    // d'une affectation étant DÉRIVÉ de la personne et du jour, deux sessions
    // qui touchent la même case produisent la même entrée — la fusion tranche
    // sans jamais fabriquer deux affectations pour un seul jour.
    "nexora:workshops", "nexora:staffing",
    // Catalogue d'équipes (#159) : même forme, même fusion élément par élément.
    "nexora:teams",
    // Dossiers d'équipes (#215) : même forme que les dossiers de projets.
    "nexora:teamFolders",
    // Habit Tracker (#193) : même forme que ateliers/affectations — catalogue
    // et journal fusionnables élément par élément, identifiant du journal
    // DÉRIVÉ (habitude × jour) comme celui d'une affectation.
    "nexora:habitThemes", "nexora:habitLog",
    // Templates de tâche nommés (#183) : liste d'objets identifiables, même
    // fusion élément par élément que les catalogues ci-dessus.
    "nexora:taskTemplates",
    // Google Agenda (#184) : deux objets-cartes (réglages, état de sync), pas
    // des listes, mais mergeKeyedCollections fusionne déjà ce cas (branche
    // "isMap", chaque champ de premier niveau devient l'unité fusionnée) —
    // il manquait juste ici. Sans elles, toute écriture assistant (import
    // Google Agenda via MCP, sans second onglet) déclenchait le bandeau
    // « une autre session a enregistré des changements » alors qu'aucune
    // autre session n'existait.
    "nexora:gcalSettings", "nexora:gcalSyncState",
    // Module Devis : quotes/quoteClients sont des listes d'objets
    // identifiables (même fusion élément par élément) ; quoteSettings est un
    // objet-carte comme gcalSettings juste au-dessus.
    "nexora:quotes", "nexora:quoteClients", "nexora:quoteSettings",
    // Catalogue de prestations et chips de compétences (#devis-v2) : mêmes
    // listes d'objets identifiables, même fusion élément par élément.
    "nexora:quoteCatalog", "nexora:quoteSkills",
    // Module Facture (#devis-v2 suite) : même forme que quotes, même fusion.
    "nexora:invoices",
    // Finance PRO (#267) : proMissions/proTimeEntries/proExpenseCategories/
    // proExpenses/proBillingSchedule/proPayments sont des listes d'objets
    // identifiables (fusion élément par élément) ; financeProSettings est un
    // objet-carte comme quoteSettings juste au-dessus.
    "nexora:proMissions", "nexora:proTimeEntries", "nexora:proExpenseCategories",
    "nexora:proExpenses", "nexora:proBillingSchedule", "nexora:proPayments",
    "nexora:financeProSettings", "nexora:proObligations",
  ]);

  // === NEXORA:MCP-SYNC-SPLIT:START ===
  // Toute écriture distante n'est pas un conflit. Une écriture de la passerelle
  // assistant/MCP sur une clé fusionnable se fond automatiquement dans l'état
  // local (voir attemptPersist : rien n'est jamais écrasé), et l'onglet est
  // souvent le seul ouvert — le bandeau plein écran « Une autre session a
  // enregistré des changements » était donc à la fois faux et bruyant.
  //
  // On ne relâche la vigilance que là où la fusion garantit l'absence de perte :
  // origine « assistant-api » ET clé présente dans NEXORA_MERGEABLE_KEYS. Tout
  // le reste — autre onglet ou autre appareil (« browser »), origine inconnue
  // (manifeste ancien), ou clé non fusionnable quelle que soit l'origine —
  // garde le bandeau d'avant, inchangé.
  const isAssistantMergeableChange = (key, entry, mergeableKeys) =>
    entry?.source === "assistant-api" && mergeableKeys.has(key);

  /* Le bandeau nomme la clé ET l'ORIGINE de l'écriture (#111).

     Il ne disait que « tasks », et un bandeau qui reparaît sans qu'on sache
     d'où vient l'écriture n'est pas diagnosticable : « autre session » désigne
     un vrai second onglet, « origine inconnue » un manifeste antérieur au
     marquage — deux causes opposées derrière le même message.

     Ce n'est pas un correctif : c'est ce qui permettra d'en écrire un. La
     chaîne de l'origine a été relue de bout en bout (écriture MCP inline et
     segmentée, `watch`, `checkRevision` des deux transports, relais REST, état
     React, partition) et elle est juste — la cause est donc dans la DONNÉE, et
     c'est elle qu'il faut voir. */
  const remoteChangeLabel = (key, entry) => {
    const short = String(key).replace("nexora:", "");
    const raw = entry && typeof entry.source === "string" ? entry.source : "";
    if (raw === "browser") return short + " (autre session)";
    if (raw === "assistant-api") return short + " (assistant)";
    return short + (raw ? " (" + raw + ")" : " (origine inconnue)");
  };

  const splitRemoteChanges = (detected, mergeableKeys) => {
    const assistant = [];
    const conflicts = [];
    for (const key of Object.keys(detected || {})) {
      (isAssistantMergeableChange(key, detected[key], mergeableKeys) ? assistant : conflicts).push(key);
    }
    return { assistant, conflicts };
  };
  // === NEXORA:MCP-SYNC-SPLIT:END ===

  // Certaines listes n'ont pas de champ `id` par élément qui identifie
  // vraiment l'élément (ex. favoris = {type,id} où `id` référence une AUTRE
  // entité). On peut donner un identifiant composite par clé ici.
  const NEXORA_MERGE_ID_GETTERS = {
    "nexora:favorites": (item) => `${item?.type ?? ""}:${item?.id ?? ""}`,
  };
  const defaultMergeIdGetter = (item) =>
    (item && typeof item === "object" && item.id != null) ? String(item.id) : JSON.stringify(item);

  const mergeItemTimestamp = (item) => {
    if (!item || typeof item !== "object") return 0;
    const raw = item.lastInteraction || item.updatedAt || item.modifiedAt || item.completedAt || item.capturedAt || item.createdAt;
    const t = raw ? Date.parse(raw) : NaN;
    return Number.isFinite(t) ? t : 0;
  };

  // Horodate les entités RÉELLEMENT modifiées d'une collection, pour que la
  // fusion ci-dessous puisse départager deux sessions ayant touché la même.
  // Sans horodatage elle ne devine pas : elle garde la version déjà enregistrée
  // et signale le conflit — la modification locale est alors perdue.
  //
  // « Modifiée » se lit sur l'identité de l'objet, pas sur son contenu : les
  // mises à jour de React reconstruisent l'objet touché et laissent les autres
  // tels quels (prev.map((d) => (d.id === cible ? { ...d } : d))). Comparer les
  // contenus coûterait une sérialisation complète à chaque frappe.
  //
  // Une entité ABSENTE de l'état précédent n'est jamais horodatée : c'est soit
  // une création — que la fusion conserve de toute façon, personne d'autre ne
  // l'ayant — soit un chargement depuis Firebase, où réhorodater écraserait
  // justement l'information qu'on cherche à garder.
  const stampChangedEntities = (prev, next) => {
    if (!Array.isArray(prev) || !Array.isArray(next)) return next;
    const seen = new Map();
    prev.forEach((item) => { if (item && item.id != null) seen.set(item.id, item); });
    if (!seen.size) return next;
    const at = new Date().toISOString();
    return next.map((item) => {
      if (!item || item.id == null) return item;
      const was = seen.get(item.id);
      return (was !== undefined && was !== item) ? { ...item, updatedAt:at } : item;
    });
  };

  // Fusionne deux collections "indexables" : soit un tableau d'objets
  // identifiables, soit un objet-carte {clé: objet} (ex. nexora:taskBaselines).
  // Retourne null si la forme des deux valeurs ne permet pas une fusion fine
  // et fiable — mieux vaut alors bloquer que deviner.
  const mergeKeyedCollections = (key, localValue, remoteValue, baseValue) => {
    const isArr = Array.isArray(localValue) && Array.isArray(remoteValue);
    const isMap = !isArr
      && localValue && typeof localValue === "object" && !Array.isArray(localValue)
      && remoteValue && typeof remoteValue === "object" && !Array.isArray(remoteValue);
    if (!isArr && !isMap) return null;

    const idGetter = NEXORA_MERGE_ID_GETTERS[key] || defaultMergeIdGetter;
    const toMap = (collection) => {
      const map = new Map();
      if (isArr) {
        collection.forEach((item) => { if (item && typeof item === "object") map.set(idGetter(item), item); });
      } else {
        Object.keys(collection).forEach((k) => map.set(k, collection[k]));
      }
      return map;
    };

    const localMap = toMap(localValue);
    const remoteMap = toMap(remoteValue);
    const baseMap = (() => {
      if (isArr && Array.isArray(baseValue)) return toMap(baseValue);
      if (isMap && baseValue && typeof baseValue === "object" && !Array.isArray(baseValue)) return toMap(baseValue);
      return new Map();
    })();
    const allIds = new Set([...baseMap.keys(), ...localMap.keys(), ...remoteMap.keys()]);
    const unresolved = [];
    const mergedMap = new Map();

    for (const id of allIds) {
      const hasB = baseMap.has(id), hasL = localMap.has(id), hasR = remoteMap.has(id);
      const b = hasB ? baseMap.get(id) : undefined;
      const l = hasL ? localMap.get(id) : undefined;
      const r = hasR ? remoteMap.get(id) : undefined;
      const same = (a, z) => JSON.stringify(a) === JSON.stringify(z);

      // Three-way merge: clean deletions win if the other tab did not edit the
      // entity; concurrent delete/edit keeps the edited content and is flagged.
      if (hasB && !hasL && (!hasR || same(r, b))) continue;
      if (hasB && !hasR && (!hasL || same(l, b))) continue;
      if (hasB && hasL && same(l, b)) { if (hasR) mergedMap.set(id, r); continue; }
      if (hasB && hasR && same(r, b)) { if (hasL) mergedMap.set(id, l); continue; }
      if (hasL && !hasR) {
        mergedMap.set(id, l);
        if (hasB) unresolved.push({ id, local:l, remote:null, base:b });
        continue;
      }
      if (!hasL && hasR) {
        mergedMap.set(id, r);
        if (hasB) unresolved.push({ id, local:null, remote:r, base:b });
        continue;
      }
      if (l !== undefined && r === undefined) { mergedMap.set(id, l); continue; } // ajouté localement
      if (l === undefined && r !== undefined) { mergedMap.set(id, r); continue; } // ajouté à distance
      if (JSON.stringify(l) === JSON.stringify(r)) { mergedMap.set(id, l); continue; } // identique
      const lt = mergeItemTimestamp(l), rt = mergeItemTimestamp(r);
      if (lt !== rt) { mergedMap.set(id, lt > rt ? l : r); continue; } // horodatage disponible : le plus récent gagne
      unresolved.push({ id, local:l, remote:r }); // vrai conflit : on ne devine pas
      mergedMap.set(id, r); // par précaution, on garde la version déjà confirmée en base
    }

    if (isArr) {
      const order = remoteValue.map((x) => idGetter(x)).concat(
        localValue.map((x) => idGetter(x)).filter((id) => !remoteMap.has(id))
      );
      const seenOrder = new Set();
      const merged = order
        .filter((id) => (seenOrder.has(id) ? false : (seenOrder.add(id), true)))
        .map((id) => mergedMap.get(id))
        .filter((x) => x !== undefined);
      return { merged, unresolved };
    }

    const merged = {};
    mergedMap.forEach((v, k) => { merged[k] = v; });
    return { merged, unresolved };
  };
  // === NEXORA:SYNCMERGE:END ===

  // Envoie une clé vers Firebase. En cas de conflit de révision (une autre
  // session a sauvegardé entretemps), tente une fusion consciente plutôt
  // qu'un écrasement aveugle — voir commentaire ci-dessus.
  const attemptPersist = async (key, payload) => {
    try {
      return await window.storage.set(key, payload);
    } catch (e) {
      if (e?.code !== "NEXORA_SYNC_CONFLICT" && e?.code !== "NEXORA_READ_UNSAFE") throw e;

      const baseRaw = window.storage.getKnownValue(key);
      const fresh = await window.storage.refreshRevision(key);
      const remoteRaw = fresh?.value;
      const remoteValue = (remoteRaw !== undefined && remoteRaw !== null) ? parseStoredValue(remoteRaw) : undefined;

      if (remoteValue === undefined) {
        // La clé n'existe plus / toujours introuvable côté distant : rien à
        // fusionner, notre valeur locale peut s'écrire sans rien écraser.
        return await window.storage.set(key, payload);
      }

      let localValue;
      try { localValue = JSON.parse(payload); } catch (_) { localValue = payload; }
      let baseValue;
      try { baseValue = JSON.parse(baseRaw); } catch (_) { baseValue = baseRaw; }

      if (JSON.stringify(remoteValue) === JSON.stringify(localValue)) {
        // Conflit de révision mais contenu strictement identique : rien à
        // perdre, on peut synchroniser tel quel.
        return await window.storage.set(key, payload);
      }

      if (NEXORA_MERGEABLE_KEYS.has(key)) {
        const result = mergeKeyedCollections(key, localValue, remoteValue, baseValue);
        if (result) {
          const mergedPayload = JSON.stringify(result.merged);
          const written = await window.storage.set(key, mergedPayload);
          written.mergedValue = result.merged;
          written.mergeUnresolved = result.unresolved;
          return written;
        }
      }

      // Valeur non fusionnable automatiquement (objet simple, préférence...) :
      // on ne devine pas — on bloque cette clé et on prévient l'utilisateur
      // plutôt que d'écraser silencieusement l'autre session.
      const err = new Error(
        `Conflit de synchronisation sur ${key} : une autre session a enregistré une version différente entretemps. ` +
        `Aucune donnée n'a été écrasée automatiquement — utilise "Récupérer et envoyer" une fois la situation vérifiée.`
      );
      err.code = "NEXORA_SYNC_CONFLICT";
      throw err;
    }
  };

  const rescueQuotaWarnedRef = useRef(false); // n'alerter qu'une fois par session si localStorage est plein — sinon le filet de sécurité échoue en silence, exactement ce qu'on veut éviter

  // Écrit IMMÉDIATEMENT (jamais différé, jamais débounce) la copie de secours
  // locale d'une clé. Séparée de persistKey pour pouvoir être appelée AVANT
  // tout debounce d'envoi réseau (voir nexora:tasks plus bas) : la durabilité
  // locale ne doit jamais dépendre du rythme des écritures Firestore.
  const writeRescueImmediate = (key, serializedValue) => {
    try {
      if (serializedValue.length > 4000000) return; // filet local jusqu'à ~4 Mo ; la copie principale reste sauvegardée en segments dans Firebase
      localStorage.setItem(
        RESCUE_PREFIX + key,
        JSON.stringify({ savedAt:new Date().toISOString(), value:serializedValue })
      );
    } catch (e) {
      // localStorage plein (quota dépassé) ou indisponible (navigation privée) :
      // le filet de sécurité local est hors service. Il faut le savoir tout de
      // suite plutôt que de le découvrir au moment où on en aurait besoin.
      if (!rescueQuotaWarnedRef.current) {
        rescueQuotaWarnedRef.current = true;
        console.error("[Nexora rescue] localStorage indisponible, copie de secours désactivée :", e);
        pushToast({
          message:"Le stockage local est plein ou inaccessible — la copie de secours locale ne fonctionne plus pour cette session. Libère de l'espace ou vérifie le mode navigation privée.",
          duration:15000,
        });
      }
    }
  };

  // Trois causes distinctes atterrissent dans blockedKeys, et les annoncer
  // toutes comme un conflit entre deux ordinateurs a coûté plusieurs
  // allers-retours : on cherchait une seconde session là où une lecture avait
  // simplement échoué. Le bandeau dit maintenant laquelle des trois s'est
  // produite, et ne mélange pas les registres quand il y en a plusieurs.
  const blockedKeysReason = (blocked) => {
    const causes = new Set(Object.values(blocked).map((e) => e?.cause || "conflict"));
    if (causes.size !== 1) return "plusieurs causes distinctes (détail dans la console).";
    const [only] = causes;
    if (only === "read") {
      return "la dernière lecture de cette donnée a échoué : rien n'est écrit tant qu'elle n'a pas été relue, pour ne pas écraser ce que Firebase contient.";
    }
    if (only === "bootstrap") {
      return "cette donnée n'a pas pu être lue au démarrage : ni elle ni ses valeurs par défaut ne seront enregistrées tant que la lecture n'aura pas abouti.";
    }
    return "une autre session a modifié la même donnée entre-temps.";
  };

  const persistKey = (key, value) => {
    // Premier appel juste après le chargement de cette clé (voir
    // justHydratedKeysRef ci-dessus) : rien n'a réellement changé, on ignore
    // silencieusement cet envoi — sans quoi une copie de secours locale est
    // écrite puis (normalement) confirmée et effacée, mais laisse une fenêtre
    // de "faux positif" à chaque démarrage si la session se referme vite.
    if (justHydratedKeysRef.current.has(key)) {
      justHydratedKeysRef.current.delete(key);
      return Promise.resolve();
    }
    const serializedValue = JSON.stringify(value);

    // Le stockage est désormais segmenté automatiquement sous la limite
    // physique Firestore de 1 Mio/document. On ne prévient plus à 950 ko :
    // seules les valeurs LOGIQUES très volumineuses (> 7 Mo UTF‑8) méritent
    // encore une alerte car une transaction Firestore complète devient lourde.
    let serializedBytes = serializedValue.length;
    try { serializedBytes = new TextEncoder().encode(serializedValue).length; } catch (_) {}

    if (serializedBytes > 7000000 && !oversizeWarnedRef.current.has(key)) {
      oversizeWarnedRef.current.add(key);
      console.warn(`[Nexora sync] ${key} est très volumineux (${Math.round(serializedBytes/1024)} Kio) ; stockage segmenté actif.`);
      pushToast({
        message:`« ${key} » dépasse 7 Mo. Les données restent segmentées et sauvegardées, mais pense à archiver les historiques très anciens pour conserver de bonnes performances.`,
        duration:12000,
      });
    }

    // Copie de secours locale avant tout envoi (~1,5 Mo max par clé, pour
    // éviter de saturer localStorage sur de très gros jeux de tâches). Cette
    // copie n'est effacée qu'une fois la sauvegarde CONFIRMÉE par Firebase
    // (voir plus bas) : si la page se ferme ou plante avant confirmation, elle
    // reste disponible et sera proposée en restauration au prochain démarrage
    // (cf. l'effet de chargement initial, plus bas, et rescueRecovery).
    writeRescueImmediate(key, serializedValue);

    pendingPersistRef.current.set(key, serializedValue);
    setSyncStatus({ state:"saving", error:"", key });

    // Une écriture pour cette clé est déjà dans la file : sa valeur pending est
    // simplement remplacée par la plus récente.
    if (persistScheduledRef.current.has(key)) return persistQueueRef.current;
    persistScheduledRef.current.add(key);

    const run = async () => {
      try {
        while (pendingPersistRef.current.has(key)) {
          const payload = pendingPersistRef.current.get(key);
          pendingPersistRef.current.delete(key);

          if (!window.storage) {
            throw new Error("window.storage indisponible dans ce contexte (ouvre le vrai site déployé, pas un aperçu).");
          }

          const written = await attemptPersist(key, payload);

          // Une fusion de conflit a eu lieu (voir attemptPersist) : la valeur
          // réellement enregistrée peut différer de ce que cette session avait
          // localement (ajouts de l'autre session intégrés). On répercute le
          // résultat dans l'état React pour que l'UI et Firebase ne divergent
          // jamais, et on prévient si un VRAI conflit (même élément modifié
          // des deux côtés sans horodatage tranchant) a dû être arbitré.
          if (written && written.mergedValue !== undefined) {
            const setter = firebaseWatchedEntries().find(([, k]) => k === key)?.[2];
            if (setter) setter(written.mergedValue);
            if (written.mergeUnresolved && written.mergeUnresolved.length) {
              pushToast({
                message: `${key.replace("nexora:", "")} : ${written.mergeUnresolved.length} élément(s) modifié(s) simultanément sur deux sessions — la version déjà enregistrée a été conservée, vérifie-la si besoin.`,
                duration: 12000,
              });
            }
          }

          // Écriture CONFIRMÉE : la copie de secours locale n'est plus nécessaire
          // et cette clé n'est plus considérée comme bloquée.
          clearRescue(key);
          setBlockedKeys((prev) => {
            if (!(key in prev)) return prev;
            const next = { ...prev };
            delete next[key];
            return next;
          });

          // Évite une rafale de setDoc après chargement/migration.
          await new Promise((resolve) => setTimeout(resolve, 50));
        }
        setSyncStatus({ state:"saved", error:"", key });
      } catch (e) {
        const message = (e && e.message) || String(e);
        console.error("[Nexora sync]", key, e);
        setSyncStatus({ state:"error", error:message, key });

        // Conflit persistant même après la tentative de récupération auto de
        // attemptPersist : on bloque UNIQUEMENT cette clé (pas toute l'appli).
        // La copie de secours locale reste en place — rien n'est perdu, et le
        // prochain edit sur cette même clé retentera automatiquement.
        if (e?.code === "NEXORA_SYNC_CONFLICT" || e?.code === "NEXORA_READ_UNSAFE") {
          // La cause est portée jusqu'au bandeau : un conflit entre deux
          // sessions et une lecture ratée demandent deux gestes différents, et
          // les annoncer tous les deux comme « une autre session a modifié la
          // même donnée » envoyait chercher un second ordinateur qui n'existait
          // pas.
          const cause = e.code === "NEXORA_READ_UNSAFE" ? "read" : "conflict";
          setBlockedKeys((prev) => ({ ...prev, [key]: { message, cause, since:new Date().toISOString() } }));
        }
      } finally {
        persistScheduledRef.current.delete(key);

        // Si une nouvelle valeur est arrivée exactement pendant la finalisation,
        // elle est remise dans la file sans perdre la donnée.
        if (pendingPersistRef.current.has(key)) {
          const payload = pendingPersistRef.current.get(key);
          pendingPersistRef.current.delete(key);
          try {
            persistKey(key, JSON.parse(payload));
          } catch (_) {}
        }
      }
    };

    persistQueueRef.current = persistQueueRef.current.then(run, run);
    return persistQueueRef.current;
  };

  // ---------------------------------------------------------------------
  // Bouton "Enregistrer maintenant" : force l'envoi immédiat de tout ce qui
  // est en attente (y compris le debounce de 250ms des tâches) et attend une
  // confirmation explicite, plutôt que de faire confiance au petit indicateur
  // discret de la barre du haut. C'est un geste volontaire de l'utilisateur :
  // il doit recevoir une réponse claire, pas juste "ça devrait aller".
  const [saveNowState, setSaveNowState] = useState("idle"); // idle | saving | done | error
  const saveNow = useCallback(async () => {
    if (saveNowState === "saving") return;
    setSaveNowState("saving");
    try {
      if (flushTasksDebounceRef.current) flushTasksDebounceRef.current();

      // Attend que toute écriture en cours ou replanifiée se termine (jusqu'à
      // 20s) — pas juste la file telle qu'elle était au moment du clic : si de
      // nouvelles écritures sont replanifiées pendant l'attente (voir le
      // "finally" de persistKey), on continue d'attendre qu'elles se terminent.
      const deadline = Date.now() + 20000;
      while (
        (persistScheduledRef.current.size > 0 || pendingPersistRef.current.size > 0) &&
        Date.now() < deadline
      ) {
        await persistQueueRef.current;
        await new Promise((r) => setTimeout(r, 60));
      }

      const stillBlocked = Object.keys(blockedKeys).length;
      if (stillBlocked > 0) {
        setSaveNowState("error");
        pushToast({
          message: `Sauvegarde partielle : ${stillBlocked} donnée${stillBlocked > 1 ? "s" : ""} encore en attente de résolution (voir le bandeau ci-dessus).`,
          duration: 9000,
        });
      } else {
        setSaveNowState("done");
        pushToast({ message: `✓ Tout est enregistré — ${new Date().toLocaleTimeString("fr-FR")}` });
      }
    } catch (e) {
      setSaveNowState("error");
      pushToast({ message: "Échec de l'enregistrement : " + ((e && e.message) || String(e)), duration: 9000 });
    } finally {
      setTimeout(() => setSaveNowState((s) => (s === "saving" ? "idle" : s)), 2500);
    }
  }, [saveNowState, blockedKeys]);

  // Envoie manuellement (ou automatiquement au démarrage) les copies de
  // secours locales encore en attente. mode="discard" les efface sans les
  // envoyer (l'utilisateur choisit consciemment d'abandonner ces changements).
  const resolveRescueRecovery = async (mode) => {
    if (!rescueRecovery) return;
    if (mode === "discard") {
      rescueRecovery.entries.forEach((e) => clearRescue(e.key));
      setRescueRecovery(null);
      return;
    }
    setRescueRecovery((r) => r && { ...r, busy:true });
    const failed = [];
    for (const entry of rescueRecovery.entries) {
      // Si l'appli a déjà re-sauvegardé (et donc effacé) cette clé entre-temps
      // — p. ex. via un nettoyage automatique — inutile de retenter avec
      // l'ancienne valeur locale, potentiellement obsolète ou fautive.
      let stillPending = null;
      try { stillPending = localStorage.getItem(RESCUE_PREFIX + entry.key); } catch (_) {}
      if (stillPending === null) continue;

      try {
        await attemptPersist(entry.key, entry.value);
        clearRescue(entry.key);
      } catch (e) {
        const message = (e && e.message) || String(e);
        console.error("[Nexora rescue]", entry.key, e);
        failed.push({ key: entry.key, message });
      }
    }
    if (failed.length) {
      const detail = failed.map((f) => `${f.key} (${f.message})`).join(" · ");
      pushToast({ message:`Récupération partielle : ${detail}`, duration:12000 });
      setRescueRecovery((r) => r && {
        ...r,
        entries: r.entries.filter((e) => failed.some((f) => f.key === e.key)),
        busy:false,
      });
    } else {
      pushToast({ message:"Modifications précédemment non synchronisées récupérées et envoyées à Firebase." });
      setRescueRecovery(null);
      refreshFromFirebase();
    }
  };

  useEffect(() => {
    const onBeforeUnload = (e) => {
      const hasPending = pendingPersistRef.current.size > 0 || persistScheduledRef.current.size > 0;
      const hasBlocked = Object.keys(blockedKeys).length > 0;
      if (!hasPending && !syncBlocked && !hasBlocked) return;
      e.preventDefault();
      e.returnValue = "";
    };
    window.addEventListener("beforeunload", onBeforeUnload);
    return () => window.removeEventListener("beforeunload", onBeforeUnload);
  }, [syncBlocked, blockedKeys]);

  const firebaseStateEntries = () => [
    ["projects", "nexora:projects", setProjects],
    ["statuses", "nexora:statuses", setStatuses],
    ["taskTypes", "nexora:taskTypes", setTaskTypes],
    ["milestoneTypes", "nexora:milestoneTypes", setMilestoneTypes],
    ["workshops", "nexora:workshops", setWorkshops],
    ["teams", "nexora:teams", setTeams],
    ["teamFolders", "nexora:teamFolders", setTeamFolders],
    ["staffing", "nexora:staffing", setStaffing],
    ["habitThemes", "nexora:habitThemes", setHabitThemes],
    ["habitLog", "nexora:habitLog", setHabitLog],
    ["tasks", "nexora:tasks", setTasksRaw],
    ["projectFolders", "nexora:projectFolders", setProjectFolders],
    ["viewFolders", "nexora:viewFolders", setViewFolders],
    ["expenseCategories", "nexora:expenseCategories", setExpenseCategories],
    ["expenses", "nexora:expenses", setExpenses],
    ["budgetLines", "nexora:budgetLines", setBudgetLines],
    ["teamMembers", "nexora:teamMembers", setTeamMembers],
    ["momentumSnapshots", "nexora:momentumSnapshots", setMomentumSnapshots],
    ["activityLog", "nexora:activityLog", setActivityLog],
    ["taskBaselines", "nexora:taskBaselines", setTaskBaselines],
    ["taskArchive", "nexora:taskArchive", setTaskArchive],
    ["gcalSettings", "nexora:gcalSettings", setGcalSettings],
    ["gcalSyncState", "nexora:gcalSyncState", setGcalSyncState],
    ["metaFilters", "nexora:metaFilters", setMetaFilters],
    ["metaTemporalBlocks", "nexora:metaTemporalBlocks", setMetaTemporalBlocks],
    ["notifications", "nexora:notifications", setNotifications],
    ["syncedCalendarSettings", "nexora:syncedCalendarSettings", setSyncedCalendarSettings],
    ["startupPref", "nexora:startupPref", setStartupPref],
    ["projectDefaultView", "nexora:projectDefaultView", setProjectDefaultView],
    ["taskDefaults", "nexora:taskDefaults", setTaskDefaults],
    ["taskTemplates", "nexora:taskTemplates", setTaskTemplates],
    ["favorites", "nexora:favorites", setFavorites],
    ["quotes", "nexora:quotes", setQuotes],
    ["quoteClients", "nexora:quoteClients", setQuoteClients],
    ["quoteSettings", "nexora:quoteSettings", setQuoteSettings],
    ["quoteCatalog", "nexora:quoteCatalog", setQuoteCatalog],
    ["quoteSkills", "nexora:quoteSkills", setQuoteSkills],
    ["invoices", "nexora:invoices", setInvoices],
    // Finance PRO (#267) : mêmes principes de persistance/chargement que le
    // module Devis juste au-dessus.
    ["proMissions", "nexora:proMissions", setProMissions],
    ["proTimeEntries", "nexora:proTimeEntries", setProTimeEntries],
    ["proExpenseCategories", "nexora:proExpenseCategories", setProExpenseCategories],
    ["proExpenses", "nexora:proExpenses", setProExpenses],
    ["proBillingSchedule", "nexora:proBillingSchedule", setProBillingSchedule],
    ["proPayments", "nexora:proPayments", setProPayments],
    ["financeProSettings", "nexora:financeProSettings", setFinanceProSettings],
    ["proObligations", "nexora:proObligations", setProObligations],
  ];

  // === NEXORA:INTERFACE-SYNC:START ===
  // Les clés d'interface sont stockées dans Firebase, écrites par persistKey,
  // et depuis peu fusionnables sur conflit. Mais elles restent absentes de
  // firebaseStateEntries() — la liste qui alimente les écoutes, le contrôle de
  // fraîcheur au retour au premier plan, et l'adoption d'une valeur distante.
  //
  // La fusion ne se déclenche qu'à l'ÉCRITURE : sans détection, une
  // configuration de tableau de bord modifiée sur un poste n'atteint l'autre
  // qu'au rechargement complet. Le rattrapage manquait, pas la fusion.
  //
  // L'hydratation garde son chemin propre — elle doit aboutir avant le premier
  // rendu, avec ses propres drapeaux de chargement — et n'est pas touchée ici.
  const firebaseInterfaceEntries = () => [
    ["dashboards",    "nexora:dashboards",    setDashboards],
    ["dashboardFolders", "nexora:dashboardFolders", setDashboardFolders],
    ["savedViews",    "nexora:views",         setSavedViews],
    ["todayWidgets",  "nexora:todayWidgets",  setTodayData],
    ["viewPrefs",     "nexora:viewPrefs",     setViewPrefs],
    ["viewOrder",     "nexora:viewOrder",     setViewOrder],
    ["enabledViews",  "nexora:enabledViews",  setEnabledViews],
    ["shortcutPrefs", "nexora:shortcutPrefs", setShortcutPrefs],
  ];

  // Toutes les clés dont une modification distante doit être détectée.
  const firebaseWatchedEntries = () => [...firebaseStateEntries(), ...firebaseInterfaceEntries()];
  // === NEXORA:INTERFACE-SYNC:END ===

  const fullBackupLivePayload = () => ({
    "nexora:projects": projects,
    "nexora:statuses": statuses,
    "nexora:taskTypes": taskTypes,
    "nexora:milestoneTypes": milestoneTypes,
    "nexora:workshops": workshops,
    "nexora:teams": teams,
    "nexora:teamFolders": teamFolders,
    "nexora:staffing": staffing,
    "nexora:habitThemes": habitThemes,
    "nexora:habitLog": habitLog,
    "nexora:tasks": tasks,
    "nexora:projectFolders": projectFolders,
    "nexora:viewFolders": viewFolders,
    "nexora:expenseCategories": expenseCategories,
    "nexora:expenses": expenses,
    "nexora:budgetLines": budgetLines,
    "nexora:teamMembers": teamMembers,
    "nexora:momentumSnapshots": momentumSnapshots,
    "nexora:activityLog": activityLog,
    "nexora:taskBaselines": taskBaselines,
    "nexora:taskArchive": taskArchive,
    "nexora:gcalSettings": gcalSettings,
    "nexora:gcalSyncState": gcalSyncState,
    "nexora:metaFilters": metaFilters,
    "nexora:metaTemporalBlocks": metaTemporalBlocks,
    "nexora:notifications": notifications,
    "nexora:syncedCalendarSettings": syncedCalendarSettings,
    "nexora:startupPref": startupPref,
    "nexora:projectDefaultView": projectDefaultView,
    "nexora:taskDefaults": taskDefaults,
    "nexora:taskTemplates": taskTemplates,
    "nexora:favorites": favorites,
    "nexora:quotes": quotes,
    "nexora:quoteClients": quoteClients,
    "nexora:quoteSettings": quoteSettings,
    "nexora:quoteCatalog": quoteCatalog,
    "nexora:quoteSkills": quoteSkills,
    "nexora:invoices": invoices,
    "nexora:appearance": appearance,
    "nexora:enabledViews": enabledViews,
    "nexora:viewOrder": viewOrder,
    "nexora:dashboards": dashboards,
    "nexora:dashboardFolders": dashboardFolders,
    "nexora:activeDashboardId": activeDashboardId,
    "nexora:todayWidgets": todayData,
    "nexora:views": savedViews,
    "nexora:viewPrefs": viewPrefs,
    "nexora:onboardingSeen": true,
    "nexora:lastOpenedView": view,
    "nexora:shortcutPrefs": shortcutPrefs,
  });

  const backupTextDownload = (text, fileName, mime) => {
    const blob = new Blob([text], {type:mime || "application/octet-stream"});
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = fileName;
    document.body.appendChild(a);
    a.click();
    a.remove();
    setTimeout(()=>URL.revokeObjectURL(url),1500);
  };

  const backupSha256 = async (text) => {
    try {
      if (!globalThis.crypto?.subtle) return null;
      const bytes = new TextEncoder().encode(text);
      const hash = await crypto.subtle.digest("SHA-256", bytes);
      return Array.from(new Uint8Array(hash)).map((b)=>b.toString(16).padStart(2,"0")).join("");
    } catch (_) {
      return null;
    }
  };

  const buildFullBackupObject = async () => {
    // On privilégie l'état vivant React : il contient aussi les dernières
    // modifications qui peuvent encore être en attente de Firebase.
    const payload = fullBackupLivePayload();

    // Ajoute toute clé Nexora persistée inconnue du modèle actuel (compatibilité
    // descendante/future), sans jamais remplacer l'état vivant plus récent.
    if (window.storage) {
      try {
        const listing = await window.storage.list("nexora:");
        for (const key of (listing?.keys || [])) {
          if (Object.prototype.hasOwnProperty.call(payload,key)) continue;
          try {
            const res = await window.storage.get(key);
            if (res?.value !== undefined) payload[key] = parseStoredValue(res.value);
          } catch (_) {}
        }
      } catch (_) {}
    }

    const rescueSnapshots = {};
    try {
      for (const entry of scanRescueEntries()) {
        rescueSnapshots[entry.key] = {
          savedAt:entry.savedAt || entry.updatedAt || null,
          value:parseStoredValue(entry.value),
        };
      }
    } catch (_) {}

    const payloadText = JSON.stringify(payload);
    return {
      format:"nexora-full-backup",
      version:1,
      exportedAt:new Date().toISOString(),
      app:"Nexora",
      payload,
      checksum:{
        algorithm:"SHA-256",
        payload:await backupSha256(payloadText),
      },
      rescueSnapshots,
    };
  };

  const fileSafeStamp = () => {
    const d=new Date();
    const pad=(n)=>String(n).padStart(2,"0");
    return `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}_${pad(d.getHours())}-${pad(d.getMinutes())}-${pad(d.getSeconds())}`;
  };

  const exportFullBackup = async (format="json", {silent=false, prefix="nexora-backup"}={}) => {
    try {
      flushTasksDebounceRef.current?.();
      try { await persistQueueRef.current; } catch (_) {}

      const backup = await buildFullBackupObject();
      const stamp = fileSafeStamp();

      if (format === "csv") {
        const rows = [["nexoraKey","nexoraJson"]];
        Object.entries(backup.payload).forEach(([key,value])=>{
          rows.push([key,JSON.stringify(value)]);
        });
        const csv = rows.map((row)=>row.map((cell)=>`"${String(cell ?? "").replace(/"/g,'""')}"`).join(",")).join("\r\n");
        backupTextDownload(csv,`${prefix}_${stamp}.csv`,"text/csv;charset=utf-8");
      } else {
        backupTextDownload(JSON.stringify(backup,null,2),`${prefix}_${stamp}.json`,"application/json;charset=utf-8");
      }

      if (!silent) pushToast({message:`Sauvegarde complète ${format.toUpperCase()} créée · ${Object.keys(backup.payload).length} clés Nexora`});
      return backup;
    } catch (e) {
      const message=(e&&e.message)||String(e);
      if (!silent) pushToast({message:"Échec de la sauvegarde complète : "+message});
      throw e;
    }
  };

  const mergeBackupValue = (backupValue, currentValue) => {
    if (Array.isArray(backupValue) && Array.isArray(currentValue)) {
      const hasIds = [...backupValue,...currentValue].some((x)=>x && typeof x==="object" && x.id != null);
      if (hasIds) {
        const map = new Map();
        backupValue.forEach((x)=>{
          if (x && typeof x==="object" && x.id != null) map.set(String(x.id),x);
          else map.set("backup:"+JSON.stringify(x),x);
        });
        currentValue.forEach((x)=>{
          if (x && typeof x==="object" && x.id != null) map.set(String(x.id),x); // l'actuel gagne
          else map.set("current:"+JSON.stringify(x),x);
        });
        return Array.from(map.values());
      }

      const seen=new Set();
      const merged=[];
      [...backupValue,...currentValue].forEach((x)=>{
        const sig=JSON.stringify(x);
        if (!seen.has(sig)) { seen.add(sig); merged.push(x); }
      });
      return merged;
    }

    if (
      backupValue && currentValue &&
      typeof backupValue==="object" && !Array.isArray(backupValue) &&
      typeof currentValue==="object" && !Array.isArray(currentValue)
    ) {
      return {...backupValue,...currentValue}; // non destructif : l'actuel gagne
    }

    return currentValue !== undefined && currentValue !== null ? currentValue : backupValue;
  };

  const restoreFullBackup = async (backup, mode="merge") => {
    if (!backup || backup.format !== "nexora-full-backup" || !backup.payload || typeof backup.payload !== "object") {
      throw new Error("Sauvegarde Nexora invalide.");
    }
    if (!window.storage) throw new Error("Firebase/storage indisponible.");

    // Vérifie l'intégrité avant d'écrire quoi que ce soit.
    if (backup.checksum?.payload) {
      const computed = await backupSha256(JSON.stringify(backup.payload));
      if (computed && computed !== backup.checksum.payload) {
        throw new Error("La somme de contrôle ne correspond pas : fichier potentiellement incomplet ou modifié.");
      }
    }

    // Sauvegarde de sécurité AUTOMATIQUE avant restauration.
    const preRestore = await buildFullBackupObject();
    const preRestoreText = JSON.stringify(preRestore,null,2);
    backupTextDownload(preRestoreText,`nexora-avant-restauration_${fileSafeStamp()}.json`,"application/json;charset=utf-8");
    try {
      if (preRestoreText.length < 4000000) {
        localStorage.setItem("nexora:preRestoreBackup",preRestoreText);
      }
    } catch (_) {}

    const payload = backup.payload;
    const errors = [];
    setSyncStatus({state:"saving",error:"",key:"full-restore"});

    for (const [key,backupValue] of Object.entries(payload)) {
      if (!String(key).startsWith("nexora:")) continue;

      try {
        let currentValue;
        try {
          const current = await window.storage.get(key);
          currentValue = current?.value !== undefined ? parseStoredValue(current.value) : undefined;
        } catch (e) {
          const msg=(e&&e.message)||String(e);
          if (!msg.includes("Key not found")) throw e;
          currentValue=undefined;
        }

        const nextValue = mode === "merge"
          ? mergeBackupValue(backupValue,currentValue)
          : backupValue;

        await window.storage.set(key,JSON.stringify(nextValue));
      } catch (e) {
        errors.push(`${key} : ${(e&&e.message)||String(e)}`);
      }
    }

    if (errors.length) {
      setSyncStatus({state:"error",error:errors.join(" · "),key:"full-restore"});
      throw new Error(
        `Restauration partielle : ${errors.length} erreur${errors.length>1?"s":""}. ` +
        `La sauvegarde automatique « avant restauration » permet de revenir à l'état précédent. ` +
        errors.slice(0,3).join(" · ")
      );
    }

    setSyncStatus({state:"saved",error:"",key:"full-restore"});
    pushToast({message:mode==="merge" ? "Sauvegarde fusionnée. Rechargement de Nexora…" : "Sauvegarde restaurée. Rechargement de Nexora…"});
    setTimeout(()=>window.location.reload(),700);
  };


  const refreshFromFirebase = useCallback(async () => {
    if (firebaseRefreshing) return;
    if (!window.storage) {
      setSyncStatus({ state:"error", error:"window.storage indisponible.", key:"firebase-refresh" });
      return;
    }

    setFirebaseRefreshing(true);
    setSyncStatus({ state:"saving", error:"", key:"firebase-refresh" });

    try {
      // Termine d'abord les sauvegardes locales déjà engagées, afin que le clic
      // ne perde pas une modification faite juste avant la synchronisation.
      await persistQueueRef.current;

      const errors = [];
      let updated = 0;
      const entries = firebaseStateEntries();

      for (const [, key, setter] of entries) {
        try {
          const result = await window.storage.get(key);
          if (result && result.value !== null && result.value !== undefined) {
            setter(parseStoredValue(result.value));
            updated += 1;
          }
        } catch (error) {
          const message = (error && error.message) || String(error);
          if (!message.includes("Key not found")) {
            errors.push(key + " : " + message);
          }
        }
      }

      if (errors.length) {
        throw new Error(errors.join(" · "));
      }

      setSyncBlocked(null);
      setRemoteChangeDetected({});
      setSyncStatus({ state:"saved", error:"", key:"firebase-refresh" });
      pushToast({
        message: `Firebase synchronisé · ${updated} source${updated > 1 ? "s" : ""} mise${updated > 1 ? "s" : ""} à jour`,
      });
    } catch (error) {
      const message = (error && error.message) || String(error);
      setSyncStatus({ state:"error", error:message, key:"firebase-refresh" });
      pushToast({ message:"Échec de la synchronisation Firebase : " + message });
    } finally {
      setFirebaseRefreshing(false);
    }
  }, [firebaseRefreshing]);


  const storageGetWithTimeout = async (key, timeoutMs = 12000) => {
    if (!window.storage) throw new Error("window.storage indisponible dans ce contexte.");
    return await Promise.race([
      window.storage.get(key),
      new Promise((_, reject) =>
        setTimeout(() => reject(new Error(`Timeout de lecture Firebase (${key}) après ${Math.round(timeoutMs/1000)} s`)), timeoutMs)
      )
    ]);
  };

  useEffect(() => {
    let cancelled = false;

    (async () => {
      const keys = firebaseStateEntries();
      const errors = [];
      let loadedCount = 0;

      if (!window.storage) {
        errors.push("window.storage indisponible dans ce contexte.");
      } else {
        const results = await Promise.all(
          keys.map(async ([name, key, setter]) => {
            try {
              const timeout = key === "nexora:tasks" ? 20000 : 10000;
              const r = await storageGetWithTimeout(key, timeout);
              return { ok:true, key, setter, value:r?.value };
            } catch (e) {
              return { ok:false, key, error:e };
            }
          })
        );

        if (cancelled) return;

        for (const result of results) {
          // Qu'une valeur ait été trouvée ou non, cette clé vient d'être lue :
          // le prochain persistKey() dessus (déclenché par le flip de
          // dataLoaded plus bas) ne doit pas repartir en écriture sans
          // changement réel — voir justHydratedKeysRef.
          if (result.ok) markJustHydrated(result.key);
          if (result.ok) {
            if (result.value !== null && result.value !== undefined) {
              try {
                result.setter(parseStoredValue(result.value));
                loadedCount += 1;
              } catch (e) {
                errors.push(`${result.key} : données illisibles · ${(e&&e.message)||String(e)}`);
              }
            }
          } else {
            const msg = (result.error && result.error.message) || String(result.error);
            if (!msg.includes("Key not found")) {
              errors.push(`${result.key} : ${msg}`);
              console.error("[Nexora bootstrap]", result.key, result.error);
            }
          }
        }
      }

      if (cancelled) return;

      if (errors.length) {
        setSyncBlocked(errors.join(" · "));
        setSyncStatus({ state:"error", error:errors.join(" · "), key:"bootstrap" });
      } else {
        setSyncBlocked(null);
      }

      setDataLoaded(true);
      console.info(`[Nexora bootstrap] ${loadedCount}/${keys.length} sources chargées`, errors);

      // La copie de secours locale (voir persistKey) n'est effacée qu'une fois
      // une écriture confirmée par Firebase. Si des entrées subsistent ici,
      // c'est que la session précédente s'est arrêtée (fermeture, crash,
      // coupure réseau) AVANT cette confirmation : on les propose en
      // restauration plutôt que de les laisser dormir sans jamais s'en servir.
      const leftoverRescue = scanRescueEntries();
      if (leftoverRescue.length && !cancelled) {
        setRescueRecovery({ entries: leftoverRescue, busy:false });
      }
    })();

    return () => { cancelled = true; };
  }, []);

  // Écoute temps réel des deux clés les plus sensibles aux conflits multi-
  // session/multi-appareil. Dès qu'une autre session confirme une révision
  // différente, on le sait immédiatement (pas besoin d'attendre une frappe
  // locale qui déclencherait un conflit). Purement informatif : la fusion
  // consciente (S1) protège déjà les données ; ceci sert juste à prévenir
  // l'utilisateur au plus tôt et lui proposer de recharger.
  useEffect(() => {
    if (!dataLoaded || !window.storage?.watch) return;
    let cancelled = false;

    // Listen to every persisted state key, not only tasks/projects. A remote
    // value is first read as a "peek": its revision is committed locally only
    // after we have verified that no local write appeared during the fetch.
    const unsubs = firebaseWatchedEntries().map(([, key, setter]) =>
      window.storage.watch(key, async (revision, source) => {
        setRemoteChangeDetected((prev) => (prev[key]?.revision === revision
          ? prev
          : { ...prev, [key]: { revision, source: source || null } }));

        const hasLocalWork = () =>
          pendingPersistRef.current.has(key) || persistScheduledRef.current.has(key);
        if (hasLocalWork()) return;

        try {
          const result = await window.storage.get(key, { trackRevision:false });
          if (cancelled || hasLocalWork()) return;

          window.storage.acceptRemote(key, result);
          markJustHydrated(key);
          setter(parseStoredValue(result.value));
          setRemoteChangeDetected((prev) => {
            if (!(key in prev)) return prev;
            const next = { ...prev };
            delete next[key];
            return next;
          });
          setSyncStatus({ state:"saved", error:"", key });
        } catch (error) {
          if (cancelled) return;
          const message = (error && error.message) || String(error);
          setSyncStatus({ state:"error", error:message, key });
        }
      })
    );
    return () => {
      cancelled = true;
      unsubs.forEach((u) => { try { u && u(); } catch (_) {} });
    };
  }, [dataLoaded]);

  // Garde-fou complémentaire pour les onglets mis en veille par l'OS/le
  // navigateur (mobile surtout) : pendant la mise en veille, l'écoute
  // onSnapshot ci-dessus peut être suspendue et manquer un changement
  // distant. Au retour au premier plan, on vérifie explicitement la
  // fraîcheur des deux clés les plus sensibles plutôt que de supposer que
  // tout est toujours à jour.
  useEffect(() => {
    if (!dataLoaded) return;
    const onVisible = async () => {
      if (document.visibilityState !== "visible" || !window.storage?.checkRevision) return;
      for (const [, key] of firebaseWatchedEntries()) {
        try {
          const remote = await window.storage.checkRevision(key);
          const remoteRevision = remote?.revision || null;
          const known = window.storage.getKnownRevision(key);
          if (remoteRevision && remoteRevision !== known) {
            setRemoteChangeDetected((prev) => (prev[key]?.revision === remoteRevision
              ? prev
              : { ...prev, [key]: { revision: remoteRevision, source: remote?.source || null } }));
          }
        } catch (_) { /* vérification best-effort, jamais bloquante */ }
      }
    };
    document.addEventListener("visibilitychange", onVisible);
    window.addEventListener("focus", onVisible);
    return () => {
      document.removeEventListener("visibilitychange", onVisible);
      window.removeEventListener("focus", onVisible);
    };
  }, [dataLoaded]);

  useEffect(() => { if (dataLoaded && !syncBlocked) persistKey("nexora:projectFolders", projectFolders); }, [projectFolders, dataLoaded, syncBlocked]);
  // Garantit l'existence du dossier "À trier" (identifiant fixe, pour pouvoir le
  // cibler de façon fiable ailleurs dans le code sans dépendre de son nom, que
  // l'utilisateur pourrait renommer). Range aussi, une seule fois, tout projet
  // existant sans dossier — plus aucun projet ne doit rester "seul" à la racine.
  useEffect(() => {
    if (!dataLoaded) return;
    setProjectFolders((prev) => (prev.some((f) => f.id === DEFAULT_UNSORTED_FOLDER_ID)
      ? prev
      : [...prev, { id: DEFAULT_UNSORTED_FOLDER_ID, name: "À trier", color: "var(--text-muted)" }]));
    setProjects((prev) => (prev.some((p) => !p.folderId)
      ? prev.map((p) => (p.folderId ? p : { ...p, folderId: DEFAULT_UNSORTED_FOLDER_ID }))
      : prev));
  }, [dataLoaded]);
  // Migration douce : les installations existantes (chargées depuis le stockage
  // persistant, donc sans les nouveaux seeds) reçoivent le type "Information"
  // et son statut "Information" associé s'ils n'existent pas déjà — même
  // logique que la migration des dossiers projet ci-dessus.
  useEffect(() => {
    if (!dataLoaded) return;
    if (taskTypes.some((t) => normalizeForMatch(t.name) === "information")) return;
    const existingStatus = statuses.find((s) => normalizeForMatch(s.name) === "information");
    const infoStatusId = existingStatus?.id || uid();
    if (!existingStatus) {
      setStatuses((prev) => [...prev, { id: infoStatusId, name: "Information", color: "#64748B", icon: null }]);
    }
    setTaskTypes((prev) => [...prev, {
      id: uid(),
      name: "Information",
      color: "#64748B",
      icon: "tabler:info-circle",
      projectId: null,
      locked: true,
      restrictedStatusId: infoStatusId,
    }]);
  }, [dataLoaded]);
  useEffect(() => { if (dataLoaded && !syncBlocked) persistKey("nexora:viewFolders", viewFolders); }, [viewFolders, dataLoaded, syncBlocked]);
  useEffect(() => { if (dataLoaded && !syncBlocked) persistKey("nexora:projects", projects); }, [projects, dataLoaded, syncBlocked]);
  useEffect(() => { if (dataLoaded && !syncBlocked) persistKey("nexora:statuses", statuses); }, [statuses, dataLoaded, syncBlocked]);
  // ---------------------------------------------------------------------
  // Historique de versions : filet de sécurité INDÉPENDANT du moteur de sync
  // en direct. Toutes les ~20 minutes d'activité, un instantané immuable de
  // tâches+projets est écrit à part (jamais écrasé), consultable et
  // restaurable depuis Réglages > Données > Historique de versions — même si
  // un bug de synchronisation venait à réapparaître un jour, il reste
  // toujours un point de retour récent indépendant de sa cause.
  const SNAPSHOT_MIN_INTERVAL_MS = 20 * 60 * 1000;
  const SNAPSHOT_MAX_COUNT = 50;
  const lastSnapshotAtRef = useRef(0);
  const snapshotBusyRef = useRef(false);
  const [taskProjectSnapshotIndex, setTaskProjectSnapshotIndex] = useState([]);
  const [snapshotIndexLoaded, setSnapshotIndexLoaded] = useState(false);
  const [snapshotBusy, setSnapshotBusy] = useState(false);
  useEffect(() => {
    let cancelled = false;
    (async () => {
      try {
        if (window.storage) {
          const res = await storageGetWithTimeout("nexora:snapshotIndex", 10000);
          if (res && res.value && !cancelled) setTaskProjectSnapshotIndex(parseStoredValue(res.value) || []);
        }
      } catch (e) { /* aucun historique de versions pour l'instant */ }
      if (!cancelled) setSnapshotIndexLoaded(true);
    })();
    return () => { cancelled = true; };
  }, []);

  const maybeSnapshotTasksProjects = useCallback(async () => {
    if (!window.storage || snapshotBusyRef.current) return;
    const now = Date.now();
    if (now - lastSnapshotAtRef.current < SNAPSHOT_MIN_INTERVAL_MS) return;
    lastSnapshotAtRef.current = now;
    snapshotBusyRef.current = true;
    try {
      const id = new Date().toISOString().replace(/[:.]/g, "-");
      const at = new Date().toISOString();
      await window.storage.set(`nexora:snapshot:${id}`, JSON.stringify({ tasks, projects, at }));

      let currentIndex = [];
      try {
        const indexRes = await window.storage.get("nexora:snapshotIndex");
        currentIndex = Array.isArray(parseStoredValue(indexRes?.value)) ? parseStoredValue(indexRes.value) : [];
      } catch (_) { /* pas encore d'historique */ }

      const nextIndex = [{ id, at, taskCount: tasks.length, projectCount: projects.length }, ...currentIndex]
        .slice(0, SNAPSHOT_MAX_COUNT);

      // Purge les instantanés qui dépassent la limite, document inclus.
      const removed = currentIndex.slice(SNAPSHOT_MAX_COUNT - 1);
      for (const entry of removed) {
        try { await window.storage.delete(`nexora:snapshot:${entry.id}`); } catch (_) {}
      }

      await window.storage.set("nexora:snapshotIndex", JSON.stringify(nextIndex));
      setTaskProjectSnapshotIndex(nextIndex);
    } catch (e) {
      console.warn("[Nexora snapshot]", e); // filet de sécurité secondaire : un échec ici ne doit jamais interrompre l'appli
    } finally {
      snapshotBusyRef.current = false;
    }
  }, [tasks, projects]);

  // Restaure un instantané en réutilisant le moteur de fusion déjà éprouvé de
  // la restauration de sauvegarde complète (checksum optionnel, fusion non
  // destructive par défaut).
  const restoreSnapshot = useCallback(async (entry, mode = "merge") => {
    setSnapshotBusy(true);
    try {
      const res = await window.storage.get(`nexora:snapshot:${entry.id}`);
      const data = parseStoredValue(res?.value);
      if (!data || !Array.isArray(data.tasks) || !Array.isArray(data.projects)) {
        throw new Error("Instantané introuvable ou corrompu.");
      }
      await restoreFullBackup(
        {
          format: "nexora-full-backup",
          version: 1,
          exportedAt: entry.at,
          payload: { "nexora:tasks": data.tasks, "nexora:projects": data.projects },
        },
        mode
      );
    } finally {
      setSnapshotBusy(false);
    }
  }, [restoreFullBackup]);

  const flushTasksDebounceRef = useRef(null); // permet de forcer l'envoi Firestore immédiat des tâches sans attendre les 250ms (voir l'effet visibilitychange/pagehide plus bas)
  useEffect(() => {
    if (!dataLoaded || syncBlocked) return;
    // Cas particulier : cet effet écrit sa copie de secours locale DIRECTEMENT
    // (avant même persistKey, voir plus bas) pour garantir la durabilité avant
    // le debounce. Il doit donc consommer lui-même le laissez-passer "juste
    // hydraté" — sinon le tout premier déclenchement (au chargement, sans
    // aucun changement réel) écrirait quand même une copie de secours locale
    // qui ne serait jamais nettoyée (persistKey court-circuite sa propre
    // écriture ET son clearRescue dans ce cas précis).
    if (justHydratedKeysRef.current.has("nexora:tasks")) {
      justHydratedKeysRef.current.delete("nexora:tasks");
      return;
    }
    // La copie de secours locale est écrite IMMÉDIATEMENT, à chaque changement,
    // AVANT le debounce ci-dessous. Sans ça, fermer l'onglet dans les 250ms
    // suivant une frappe faisait perdre la modification pour de bon : le
    // debounce ne retardait pas seulement l'envoi réseau, il retardait aussi
    // la durabilité locale — ce qui n'a jamais de sens pour la donnée la plus
    // critique de l'appli. Le debounce lui-même ne sert qu'à limiter le
    // rythme des écritures Firestore, plus coûteuses et sujettes aux quotas.
    writeRescueImmediate("nexora:tasks", JSON.stringify(tasks));
    const timer = setTimeout(() => {
      persistKey("nexora:tasks", tasks).then(() => maybeSnapshotTasksProjects());
      flushTasksDebounceRef.current = null;
    }, 250);
    flushTasksDebounceRef.current = () => {
      clearTimeout(timer);
      persistKey("nexora:tasks", tasks).then(() => maybeSnapshotTasksProjects());
      flushTasksDebounceRef.current = null;
    };
    return () => clearTimeout(timer);
  }, [tasks, dataLoaded, syncBlocked]);

  // beforeunload est peu fiable sur mobile (onglet tué par l'OS, PWA fermée
  // d'un coup) : visibilitychange/pagehide se déclenchent, eux, de façon
  // beaucoup plus systématique au moment où l'appli passe en arrière-plan.
  // On en profite pour envoyer tout de suite le debounce des tâches en
  // attente plutôt que d'attendre ses 250ms — la copie de secours locale
  // protège déjà la donnée dans tous les cas, ceci ne fait que réduire la
  // fenêtre où elle n'est pas encore confirmée par Firebase.
  useEffect(() => {
    const flushOnHide = () => {
      if (document.visibilityState === "hidden" && flushTasksDebounceRef.current) {
        flushTasksDebounceRef.current();
      }
    };
    document.addEventListener("visibilitychange", flushOnHide);
    window.addEventListener("pagehide", flushOnHide);
    return () => {
      document.removeEventListener("visibilitychange", flushOnHide);
      window.removeEventListener("pagehide", flushOnHide);
    };
  }, []);

  // Retour au modèle simple : suppression des métadonnées Action / Activité.
  useEffect(() => {
    if (!dataLoaded) return;
    setTasksRaw((prev) => {
      let changed = false;
      const next = prev.map((t) => {
        if ("type" in t || "linkedActivityId" in t || "activityRelation" in t) {
          changed = true;
          const { type, linkedActivityId, activityRelation, ...rest } = t;
          return rest;
        }
        return t;
      });
      return changed ? next : prev;
    });
  }, [dataLoaded]);


  // Google Calendar : les trois statuts de cycle de vie doivent toujours
  // exister tant qu'au moins un projet Google est présent.
  useEffect(() => {
    if (!dataLoaded || !projects.some((p) => p.gcalSource)) return;
    setStatuses((prev) => {
      let next = prev;
      const hasDone = prev.some((s) => /^termin/i.test((s.name || "").trim()));
      const hasInProgress = prev.some((s) => /^en\s*cours/i.test((s.name || "").trim()));
      const hasPlanned = prev.some((s) => /^planifi/i.test((s.name || "").trim()));

      if (!hasDone) next = [...next, { id: uid(), name: "Terminé", color: "#22B07D", icon: null }];
      if (!hasInProgress) next = [...next, { id: uid(), name: "En cours", color: "#0EA5E9", icon: null }];
      if (!hasPlanned) next = [...next, { id: uid(), name: "Planifié", color: "#64748B", icon: null }];

      return next === prev ? prev : next;
    });
  }, [dataLoaded, projects]);

  // La date de référence se recalcule également si Nexora reste ouvert à minuit.
  const [gcalLifecycleToday, setGcalLifecycleToday] = useState(() => iso(new Date()));
  useEffect(() => {
    const now = new Date();
    const nextMidnight = new Date(now);
    nextMidnight.setHours(24, 0, 2, 0);
    const timer = setTimeout(() => setGcalLifecycleToday(iso(new Date())), Math.max(1000, nextMidnight.getTime() - now.getTime()));
    return () => clearTimeout(timer);
  }, [gcalLifecycleToday]);

  // Source de vérité du statut des tâches Google Calendar.
  // Toute modification de date (fiche tâche, drag & drop, Gantt, Timeline…)
  // entraîne automatiquement un recalcul. Une tentative de modification manuelle
  // du statut est également corrigée au rendu suivant.
  useEffect(() => {
    if (!dataLoaded || !projects.some((p) => p.gcalSource)) return;
    const ids = googleCalendarLifecycleStatusIds(statuses);
    if (!ids.done || !ids.inProgress || !ids.planned) return;

    setTasks((prev) => {
      let changed = false;
      const next = prev.map((t) => {
        if (!isGoogleCalendarProjectId(t.projectId, projects)) return t;
        const computed = googleCalendarComputedStatusId(t, projects, statuses, gcalLifecycleToday);
        const computedType = (t.start && t.end && t.start === t.end) ? "milestone" : "activity";
        const typeChanged = getTaskType(t) !== computedType || !!t.milestone !== (computedType === "milestone");
        const statusChanged = computed && computed !== t.statusId;
        if (!typeChanged && !statusChanged) return t;
        changed = true;
        return { ...t, ...(statusChanged ? { statusId:computed } : {}), type:computedType, milestone:computedType === "milestone", activityRelation:"contributes" };
      });
      return changed ? next : prev;
    });
  }, [dataLoaded, projects, statuses, gcalLifecycleToday]);

  useEffect(() => { if (dataLoaded && !syncBlocked) persistKey("nexora:taskTypes", taskTypes); }, [taskTypes, dataLoaded]);
  useEffect(() => { if (dataLoaded && !syncBlocked) persistKey("nexora:milestoneTypes", milestoneTypes); }, [milestoneTypes, dataLoaded]);
  useEffect(() => { if (dataLoaded && !syncBlocked) persistKey("nexora:workshops", workshops); }, [workshops, dataLoaded]);
  useEffect(() => { if (dataLoaded && !syncBlocked) persistKey("nexora:teams", teams); }, [teams, dataLoaded]);
  useEffect(() => { if (dataLoaded && !syncBlocked) persistKey("nexora:teamFolders", teamFolders); }, [teamFolders, dataLoaded]);
  useEffect(() => { if (dataLoaded && !syncBlocked) persistKey("nexora:staffing", staffing); }, [staffing, dataLoaded]);
  useEffect(() => { if (dataLoaded && !syncBlocked) persistKey("nexora:habitThemes", habitThemes); }, [habitThemes, dataLoaded]);
  useEffect(() => { if (dataLoaded && !syncBlocked) persistKey("nexora:habitLog", habitLog); }, [habitLog, dataLoaded]);
  useEffect(() => { if (dataLoaded && !syncBlocked) persistKey("nexora:expenseCategories", expenseCategories); }, [expenseCategories, dataLoaded]);
  useEffect(() => { if (dataLoaded && !syncBlocked) persistKey("nexora:gcalSettings", gcalSettings); }, [gcalSettings, dataLoaded]);
  useEffect(() => { if (dataLoaded && !syncBlocked) persistKey("nexora:gcalSyncState", gcalSyncState); }, [gcalSyncState, dataLoaded]);
  useEffect(() => { if (dataLoaded && !syncBlocked) persistKey("nexora:metaFilters", metaFilters); }, [metaFilters, dataLoaded]);
  useEffect(() => { if (dataLoaded && !syncBlocked) persistKey("nexora:metaTemporalBlocks", metaTemporalBlocks); }, [metaTemporalBlocks, dataLoaded]);
  // Journal d'exécution plafonné pour ne pas grossir indéfiniment (même logique que activityLog).
  useEffect(() => { if (dataLoaded && !syncBlocked) persistKey("nexora:notifications", notifications); }, [notifications, dataLoaded]);
  useEffect(() => { if (dataLoaded && !syncBlocked) persistKey("nexora:syncedCalendarSettings", syncedCalendarSettings); }, [syncedCalendarSettings, dataLoaded]);
  useEffect(() => { if (dataLoaded && !syncBlocked) persistKey("nexora:startupPref", startupPref); }, [startupPref, dataLoaded]);
  useEffect(() => { if (dataLoaded && !syncBlocked) persistKey("nexora:projectDefaultView", projectDefaultView); }, [projectDefaultView, dataLoaded]);
  useEffect(() => { if (dataLoaded && !syncBlocked) persistKey("nexora:taskDefaults", taskDefaults); }, [taskDefaults, dataLoaded]);
  useEffect(() => { if (dataLoaded && !syncBlocked) persistKey("nexora:taskTemplates", taskTemplates); }, [taskTemplates, dataLoaded]);
  useEffect(() => { if (dataLoaded && !syncBlocked) persistKey("nexora:favorites", favorites); }, [favorites, dataLoaded]);
  useEffect(() => { if (dataLoaded && !syncBlocked) persistKey("nexora:quotes", quotes); }, [quotes, dataLoaded]);
  useEffect(() => { if (dataLoaded && !syncBlocked) persistKey("nexora:quoteClients", quoteClients); }, [quoteClients, dataLoaded]);
  useEffect(() => { if (dataLoaded && !syncBlocked) persistKey("nexora:quoteSettings", quoteSettings); }, [quoteSettings, dataLoaded]);
  useEffect(() => { if (dataLoaded && !syncBlocked) persistKey("nexora:quoteCatalog", quoteCatalog); }, [quoteCatalog, dataLoaded]);
  useEffect(() => { if (dataLoaded && !syncBlocked) persistKey("nexora:quoteSkills", quoteSkills); }, [quoteSkills, dataLoaded]);
  useEffect(() => { if (dataLoaded && !syncBlocked) persistKey("nexora:invoices", invoices); }, [invoices, dataLoaded]);
  useEffect(() => { if (dataLoaded && !syncBlocked) persistKey("nexora:expenses", expenses); }, [expenses, dataLoaded]);
  useEffect(() => { if (dataLoaded && !syncBlocked) persistKey("nexora:proMissions", proMissions); }, [proMissions, dataLoaded]);
  useEffect(() => { if (dataLoaded && !syncBlocked) persistKey("nexora:proTimeEntries", proTimeEntries); }, [proTimeEntries, dataLoaded]);
  useEffect(() => { if (dataLoaded && !syncBlocked) persistKey("nexora:proExpenseCategories", proExpenseCategories); }, [proExpenseCategories, dataLoaded]);
  useEffect(() => { if (dataLoaded && !syncBlocked) persistKey("nexora:proExpenses", proExpenses); }, [proExpenses, dataLoaded]);
  useEffect(() => { if (dataLoaded && !syncBlocked) persistKey("nexora:proBillingSchedule", proBillingSchedule); }, [proBillingSchedule, dataLoaded]);
  useEffect(() => { if (dataLoaded && !syncBlocked) persistKey("nexora:proPayments", proPayments); }, [proPayments, dataLoaded]);
  useEffect(() => { if (dataLoaded && !syncBlocked) persistKey("nexora:financeProSettings", financeProSettings); }, [financeProSettings, dataLoaded]);
  useEffect(() => { if (dataLoaded && !syncBlocked) persistKey("nexora:proObligations", proObligations); }, [proObligations, dataLoaded]);
  useEffect(() => { if (dataLoaded && !syncBlocked) persistKey("nexora:budgetLines", budgetLines); }, [budgetLines, dataLoaded]);
  useEffect(() => { if (dataLoaded && !syncBlocked) persistKey("nexora:teamMembers", teamMembers); }, [teamMembers, dataLoaded]);
  useEffect(() => { if (dataLoaded && !syncBlocked) persistKey("nexora:activityLog", activityLog); }, [activityLog, dataLoaded]);
  useEffect(() => { if (dataLoaded && !syncBlocked) persistKey("nexora:taskBaselines", taskBaselines); }, [taskBaselines, dataLoaded]);
  useEffect(() => { if (dataLoaded && !syncBlocked) persistKey("nexora:taskArchive", taskArchive); }, [taskArchive, dataLoaded]);

  // Migration non destructive : pour les tâches déjà terminées avant cette
  // version, récupère une date de complétion seulement si une preuve existe
  // (Todoist ou journal d'activité). Aucun fallback sur l'échéance prévue.
  useEffect(() => {
    if (!dataLoaded) return;
    if (!Array.isArray(activityLog)) return;

    setTasksRaw((prev) => {
      let changed = false;
      const next = prev.map((t) => {
        if (!isTaskDoneGlobal(t, { statuses })) return t;
        if (t.completedAt) return t;

        const d = taskCompletionDate(t, activityLog);
        if (!d) return t;

        changed = true;
        return { ...t, completedAt:d.toISOString() };
      });
      return changed ? next : prev;
    });
  }, [dataLoaded, activityLog, statuses]);

  // Compatibilité : le type explicite est désormais la source de vérité.
  // Une Action peut parfaitement avoir une date unique ; on ne la transforme
  // donc plus automatiquement en Jalon à chaque rendu.
  useEffect(() => {
    setTasks((prev) => {
      let changed = false;
      const next = prev.map((t) => {
        const type = getTaskType(t);
        const shouldBeMilestone = type === "milestone";
        if (!!t.milestone !== shouldBeMilestone) {
          changed = true;
          return { ...t, milestone:shouldBeMilestone };
        }
        return t;
      });
      return changed ? next : prev;
    });
  }, [dataLoaded]);

  const [view, setView] = useState("projects");
  const [filters, setFilters] = useState(defaultFilters());
  const [appearance, setAppearance] = useState({ gradient: { enabled: true, from: "#FF7A3D", to: "#1FA971" }, ganttBg: "#EAEDF3", barBg: "#C7CED9", progressColorByStatus: false, radiusStyle: "sharp", progressTexture: false, ganttShowSubtasks: false, sharedTrunkStyle: "gradient", ...FROZEN_APPEARANCE });
  const [appearanceLoaded, setAppearanceLoaded] = useState(false);

  useEffect(() => {
    let cancelled = false;
    (async () => {
      try {
        if (window.storage) {
          const res = await storageGetWithTimeout("nexora:appearance", 10000);
          if (res && res.value && !cancelled) {
            const parsed = JSON.parse(res.value);
            setAppearance((a) => ({ ...a, ...parsed, gradient: { ...a.gradient, ...(parsed.gradient || {}) }, ...FROZEN_APPEARANCE }));
          }
        }
      } catch (e) { /* aucune préférence enregistrée pour l'instant */ }
      if (!cancelled) { markJustHydrated("nexora:appearance"); setAppearanceLoaded(true); }
    })();
    return () => { cancelled = true; };
  }, []);

  useEffect(() => { if (appearanceLoaded && !syncBlocked) persistKey("nexora:appearance", appearance); }, [appearance, appearanceLoaded]);

  // Vues affichées dans la barre d'onglets (réglable dans Réglages > Vues affichées)
  const [enabledViews, setEnabledViews] = useState(defaultEnabledViews);
  const [viewOrder, setViewOrder] = useState(() => ALL_VIEWS_META.filter((v) => v.key !== "dashboard").map((v) => v.key));
  const [enabledViewsLoaded, setEnabledViewsLoaded] = useState(false);
  // Indicateur d'onglet qui glisse (Réglages > Apparence) : mesure la position du
  // bouton actif dans la barre d'onglets pour positionner un trait qui se déplace
  // en douceur, plutôt que de sauter d'un onglet à l'autre.
  const detailTabRefs = useRef({});
  const [tabIndicator, setTabIndicator] = useState(null);
  useEffect(() => {
    const el = detailTabRefs.current[view];
    if (el) setTabIndicator({ left: el.offsetLeft, width: el.offsetWidth });
  }, [view, enabledViews]);
  useEffect(() => {
    let cancelled = false;
    (async () => {
      try {
        if (window.storage) {
          const res = await storageGetWithTimeout("nexora:enabledViews", 10000);
          if (res && res.value && !cancelled) setEnabledViews((v) => ({ ...v, ...JSON.parse(res.value) }));
          const resOrder = await storageGetWithTimeout("nexora:viewOrder", 10000);
          if (resOrder && resOrder.value && !cancelled) {
            const saved = JSON.parse(resOrder.value);
            // Fusionne avec l'ordre par défaut pour intégrer proprement toute vue
            // ajoutée depuis l'enregistrement (jamais de vue manquante à l'affichage).
            const allKeys = ALL_VIEWS_META.filter((v) => v.key !== "dashboard").map((v) => v.key);
            const merged = [...saved.filter((k) => allKeys.includes(k)), ...allKeys.filter((k) => !saved.includes(k))];
            setViewOrder(merged);
          }
        }
      } catch (e) { /* aucune préférence enregistrée pour l'instant — toutes les vues restent actives */ }
      if (!cancelled) {
        markJustHydrated("nexora:enabledViews");
        markJustHydrated("nexora:viewOrder");
        setEnabledViewsLoaded(true);
      }
    })();
    return () => { cancelled = true; };
  }, []);
  useEffect(() => { if (enabledViewsLoaded && !syncBlocked) persistKey("nexora:enabledViews", enabledViews); }, [enabledViews, enabledViewsLoaded]);
  useEffect(() => { if (enabledViewsLoaded && !syncBlocked) persistKey("nexora:viewOrder", viewOrder); }, [viewOrder, enabledViewsLoaded]);
  // Si la vue actuellement affichée vient d'être décochée, on bascule automatiquement sur la première vue encore active.
  useEffect(() => {
    if (!enabledViewsLoaded) return;
    if (enabledViews[view] === false) {
      const fallback = ALL_VIEWS_META.find((v) => enabledViews[v.key] !== false);
      if (fallback) setView(fallback.key);
    }
  }, [enabledViews, enabledViewsLoaded]);

  // Tableaux de bord modulables — plusieurs tableaux possibles, organisés en
  // dossiers comme les projets et les vues enregistrées.
  const defaultDashboardWidgets = () => ([
    { id: uid(), type: "customCard", title: "Tâches actives", cardColumns: 1, cardBlocks: [{ id: uid(), kind: "aggregate", metric: "count", emphasis: "hero", showIcon: false, showLabel: false, label: "", icon: "", color: "", bgColor: "", accent: "none" }], layout: { x: 0, y: 0, w: 3, h: 2 }, filter: { projectIds: [], statusIds: [], onlyLate: false, onlyMilestone: false, excludeDone: true } },
    { id: uid(), type: "customCard", title: "Tâches en retard", cardColumns: 1, cardBlocks: [{ id: uid(), kind: "aggregate", metric: "count", emphasis: "hero", showIcon: false, showLabel: false, label: "", icon: "", color: "", bgColor: "", accent: "none" }], layout: { x: 3, y: 0, w: 3, h: 2 }, filter: { projectIds: [], statusIds: [], onlyLate: true, onlyMilestone: false, excludeDone: true } },
    { id: uid(), type: "chart", title: "Répartition par statut", groupBy: "status", chartStyle: "pie", layout: { x: 6, y: 0, w: 6, h: 4 }, filter: { projectIds: [], statusIds: [], onlyLate: false, onlyMilestone: false, excludeDone: false } },
    { id: uid(), type: "list", title: "Prochaines échéances", sortBy: "end", limit: 6, layout: { x: 0, y: 2, w: 6, h: 4 }, filter: { projectIds: [], statusIds: [], onlyLate: false, onlyMilestone: false, excludeDone: true } },
  ]);
  const defaultDashboards = () => ([{ id: uid(), name: "Tableau de bord", folderId: null, widgets: defaultDashboardWidgets() }]);

  const [dashboards, setDashboardsRaw] = useState(defaultDashboards);
  // Voir stampChangedEntities : l'horodatage se pose ici, une fois, plutôt que
  // sur chacun des points d'écriture — dont aucun n'y penserait.
  const setDashboards = (updater) =>
    setDashboardsRaw((prev) => stampChangedEntities(prev, typeof updater === "function" ? updater(prev) : updater));
  const [dashboardsLoaded, setDashboardsLoaded] = useState(false);
  useEffect(() => {
    let cancelled = false;
    (async () => {
      try {
        if (window.storage) {
          const res = await storageGetWithTimeout("nexora:dashboards", 10000);
          if (res && res.value && !cancelled) { markJustHydrated("nexora:dashboards"); setDashboardsLoaded(true); setDashboards(migrateLegacyMiniGanttData(JSON.parse(res.value))); return; }
        }
      } catch (e) {
        const msg = (e && e.message) || String(e);
        if (!msg.includes("Key not found")) {
          // Vraie erreur (timeout, réseau...) : NE PAS retomber sur les valeurs
          // par défaut ni marquer "chargé" — ça écraserait les vrais tableaux de
          // bord au prochain enregistrement. On bloque cette clé et on arrête là.
          setBlockedKeys((prev) => ({ ...prev, "nexora:dashboards": { message: msg, cause:"bootstrap", since: new Date().toISOString() } }));
          if (!cancelled) console.error("[Nexora bootstrap] nexora:dashboards", e);
          return;
        }
        /* pas encore de tableaux de bord au nouveau format — on tente l'ancien format ci-dessous */
      }
      // Migration douce depuis l'ancien format mono-tableau (nexora:dashboardWidgets).
      try {
        if (window.storage) {
          const legacy = await storageGetWithTimeout("nexora:dashboardWidgets", 10000);
          if (legacy && legacy.value && !cancelled) {
            setDashboards([{ id: uid(), name: "Tableau de bord", folderId: null, widgets: JSON.parse(legacy.value) }]);
          }
        }
      } catch (e) { /* aucun ancien tableau de bord non plus — on garde les valeurs par défaut */ }
      if (!cancelled) setDashboardsLoaded(true);
    })();
    return () => { cancelled = true; };
  }, []);
  useEffect(() => { if (dashboardsLoaded && !syncBlocked) persistKey("nexora:dashboards", dashboards); }, [dashboards, dashboardsLoaded]);

  const [dashboardFolders, setDashboardFolders] = useState([]);
  const [dashboardFoldersLoaded, setDashboardFoldersLoaded] = useState(false);
  useEffect(() => {
    let cancelled = false;
    (async () => {
      try {
        if (window.storage) {
          const res = await storageGetWithTimeout("nexora:dashboardFolders", 10000);
          if (res && res.value && !cancelled) setDashboardFolders(JSON.parse(res.value));
        }
      } catch (e) { /* aucun dossier de tableau de bord pour l'instant */ }
      if (!cancelled) { markJustHydrated("nexora:dashboardFolders"); setDashboardFoldersLoaded(true); }
    })();
    return () => { cancelled = true; };
  }, []);
  useEffect(() => { if (dashboardFoldersLoaded && !syncBlocked) persistKey("nexora:dashboardFolders", dashboardFolders); }, [dashboardFolders, dashboardFoldersLoaded]);

  const [activeDashboardId, setActiveDashboardId] = useState(null);
  const [activeDashboardIdLoaded, setActiveDashboardIdLoaded] = useState(false);
  useEffect(() => {
    let cancelled = false;
    (async () => {
      try {
        if (window.storage) {
          const res = await storageGetWithTimeout("nexora:activeDashboardId", 10000);
          if (res && res.value && !cancelled) setActiveDashboardId(JSON.parse(res.value));
        }
      } catch (e) { /* pas de tableau de bord actif mémorisé — on prendra le premier */ }
      if (!cancelled) { markJustHydrated("nexora:activeDashboardId"); setActiveDashboardIdLoaded(true); }
    })();
    return () => { cancelled = true; };
  }, []);
  useEffect(() => { if (activeDashboardIdLoaded && !syncBlocked) persistKey("nexora:activeDashboardId", activeDashboardId); }, [activeDashboardId, activeDashboardIdLoaded]);
  // Si l'identifiant mémorisé ne correspond plus à un tableau existant (supprimé, ou premier lancement), on retombe sur le premier.
  useEffect(() => {
    if (!dashboardsLoaded || !activeDashboardIdLoaded) return;
    if (!dashboards.some((d) => d.id === activeDashboardId)) setActiveDashboardId(dashboards[0]?.id || null);
  }, [dashboards, dashboardsLoaded, activeDashboardId, activeDashboardIdLoaded]);

  const activeDashboard = dashboards.find((d) => d.id === activeDashboardId) || dashboards[0] || null;
  // Système d'onglets/pages à l'intérieur d'un même tableau de bord : chaque
  // tableau garde ses widgets répartis en une ou plusieurs "pages" nommées. Les
  // tableaux créés avant cette fonctionnalité n'ont pas de champ "pages" — on le
  // dérive à la volée de leur ancien tableau "widgets" plat (une seule page),
  // sans jamais migrer/écraser les données tant qu'on n'a pas besoin d'écrire.
  const dashboardPages = (d) => (d?.pages && d.pages.length ? d.pages : [{ id: "default", name: "Page 1", widgets: d?.widgets || [] }]);
  const pages = useMemo(() => dashboardPages(activeDashboard), [activeDashboard]);
  const activePageId = activeDashboard?.activePageId && pages.some((p) => p.id === activeDashboard.activePageId) ? activeDashboard.activePageId : pages[0]?.id;
  const activePage = pages.find((p) => p.id === activePageId) || pages[0];
  const setActiveDashboardWidgets = (updater) => {
    if (!activeDashboard) return;
    setDashboards((prev) => prev.map((d) => {
      if (d.id !== activeDashboard.id) return d;
      const curPages = dashboardPages(d);
      const curActivePageId = d.activePageId && curPages.some((p) => p.id === d.activePageId) ? d.activePageId : curPages[0].id;
      const newPages = curPages.map((p) => (p.id === curActivePageId ? { ...p, widgets: typeof updater === "function" ? updater(p.widgets) : updater } : p));
      return { ...d, pages: newPages, activePageId: curActivePageId };
    }));
  };
  const switchDashboardPage = (pageId) => {
    if (!activeDashboard) return;
    setDashboards((prev) => prev.map((d) => (d.id === activeDashboard.id ? { ...d, pages: dashboardPages(d), activePageId: pageId } : d)));
  };
  const addDashboardPage = () => {
    if (!activeDashboard) return;
    setDashboards((prev) => prev.map((d) => {
      if (d.id !== activeDashboard.id) return d;
      const curPages = dashboardPages(d);
      const newPage = { id: uid(), name: `Page ${curPages.length + 1}`, widgets: [] };
      return { ...d, pages: [...curPages, newPage], activePageId: newPage.id };
    }));
  };
  const renameDashboardPage = (pageId, name) => {
    if (!activeDashboard || !name.trim()) return;
    setDashboards((prev) => prev.map((d) => (d.id !== activeDashboard.id ? d : { ...d, pages: dashboardPages(d).map((p) => (p.id === pageId ? { ...p, name: name.trim() } : p)) })));
  };
  const updateDashboardPageFilter = (pageId, filter) => {
    if (!activeDashboard) return;
    setDashboards((prev) => prev.map((d) => (d.id !== activeDashboard.id ? d : { ...d, pages: dashboardPages(d).map((p) => (p.id === pageId ? { ...p, filter } : p)) })));
  };
  // Filtre projet de TABLEAU DE BORD (retour de test) : contrairement au
  // filtre de page ci-dessus (une page, ses widgets), celui-ci vaut pour
  // TOUTES les pages d'un même tableau de bord — un seul menu déroulant en
  // en-tête, jamais à reconfigurer en changeant d'onglet. Les deux se
  // combinent en ET (voir dashboardFilteredTasks dans DashboardView),
  // jamais l'un à la place de l'autre.
  const setDashboardProjectFilter = (dashboardId, projectIds) => {
    setDashboards((prev) => prev.map((d) => (d.id !== dashboardId ? d : { ...d, projectFilter: projectIds })));
  };
  const updateDashboardPageMeta = (pageId, patch) => {
    if (!activeDashboard) return;
    setDashboards((prev) => prev.map((d) => (d.id !== activeDashboard.id ? d : { ...d, pages: dashboardPages(d).map((p) => (p.id === pageId ? { ...p, ...patch } : p)) })));
  };
  const deleteDashboardPage = (pageId) => {
    if (!activeDashboard) return;
    setDashboards((prev) => prev.map((d) => {
      if (d.id !== activeDashboard.id) return d;
      const curPages = dashboardPages(d);
      if (curPages.length <= 1) return d; // toujours garder au moins une page
      const newPages = curPages.filter((p) => p.id !== pageId);
      const newActive = d.activePageId === pageId ? newPages[0].id : d.activePageId;
      return { ...d, pages: newPages, activePageId: newActive };
    }));
  };
  const duplicateDashboardPage = (pageId) => {
    if (!activeDashboard) return;
    setDashboards((prev) => prev.map((d) => {
      if (d.id !== activeDashboard.id) return d;
      const curPages = dashboardPages(d);
      const source = curPages.find((p) => p.id === pageId);
      if (!source) return d;
      // Copie profonde des widgets avec de nouveaux identifiants — pour que
      // déplacer/redimensionner un widget sur la copie n'affecte jamais l'original.
      // Part de TOUTE la page source (via spread) pour ne perdre aucun réglage
      // futur ajouté à une page (filtre global, icône...), plutôt que de
      // recopier les champs un par un et en oublier silencieusement.
      const newPage = {
        ...source,
        id: uid(),
        name: `${source.name} (copie)`,
        widgets: (source.widgets || []).map((w) => ({ ...w, id: uid() })),
      };
      const idx = curPages.findIndex((p) => p.id === pageId);
      const newPages = [...curPages.slice(0, idx + 1), newPage, ...curPages.slice(idx + 1)];
      return { ...d, pages: newPages, activePageId: newPage.id };
    }));
  };

  // ============================================================================
  // "Aujourd'hui" personnalisable par widgets — même moteur que les tableaux de
  // bord (pages + widgets, glisser/redimensionner/ajout via DashboardView), sur
  // un objet unique (pas de liste de tableaux à choisir : une seule "Aujourd'hui"
  // avec ses propres pages). Persisté à part, jamais mélangé aux tableaux de
  // bord classiques. La sélection par défaut (avant toute personnalisation)
  // recompose l'essentiel de l'ancienne page fixe avec des widgets existants.
  // ============================================================================
  const defaultTodayData = () => ({
    pages: [{
      id: "default",
      name: "Aujourd'hui",
      widgets: packWidgets([
        { id: uid(), type: "dailyBriefing", title: "Point du jour" },
        { id: uid(), type: "nextBestAction", title: "Priorité du moment" },
        { id: uid(), type: "echeances", echeancesOrientation: "verticale", title: "Prochains jalons" },
        { id: uid(), type: "chart", title: "Tâches par projet", groupBy: "project", chartStyle: "pie" },
        { id: uid(), type: "chart", title: "Tâches par statut", groupBy: "status", chartStyle: "pie" },
        { id: uid(), type: "dominoEffect", dominoSortBy: "directImpact", title: "Tâches bloquantes" },
      ]),
    }],
    activePageId: "default",
  });
  const [todayData, setTodayData] = useState(null); // null tant que le chargement (ou le repli par défaut) n'est pas terminé
  const [todayDataLoaded, setTodayDataLoaded] = useState(false);
  useEffect(() => {
    let cancelled = false;
    (async () => {
      try {
        if (window.storage) {
          const res = await storageGetWithTimeout("nexora:todayWidgets", 10000);
          if (res && res.value && !cancelled) { markJustHydrated("nexora:todayWidgets"); setTodayData(migrateLegacyMiniGanttData(JSON.parse(res.value))); setTodayDataLoaded(true); return; }
        }
      } catch (e) {
        const msg = (e && e.message) || String(e);
        if (!msg.includes("Key not found")) {
          // Vraie erreur (timeout, réseau...) : ne pas repartir sur les widgets
          // par défaut, ça écraserait la personnalisation existante au prochain
          // enregistrement. On bloque plutôt cette clé.
          setBlockedKeys((prev) => ({ ...prev, "nexora:todayWidgets": { message: msg, cause:"bootstrap", since: new Date().toISOString() } }));
          console.error("[Nexora bootstrap] nexora:todayWidgets", e);
          return;
        }
        /* pas de widgets "Aujourd'hui" personnalisés — on démarre avec la sélection par défaut */
      }
      if (!cancelled) { setTodayData(defaultTodayData()); setTodayDataLoaded(true); }
    })();
    return () => { cancelled = true; };
  }, []);
  useEffect(() => { if (todayDataLoaded && todayData && !syncBlocked) persistKey("nexora:todayWidgets", todayData); }, [todayData, todayDataLoaded]);
  const TODAY_DATA_FALLBACK = { pages: [{ id: "default", name: "Aujourd'hui", widgets: [] }], activePageId: "default" };
  const todayPages = (todayData?.pages && todayData.pages.length) ? todayData.pages : TODAY_DATA_FALLBACK.pages;
  const todayActivePageId = todayData?.activePageId && todayPages.some((p) => p.id === todayData.activePageId) ? todayData.activePageId : todayPages[0].id;
  const todayActivePage = todayPages.find((p) => p.id === todayActivePageId) || todayPages[0];
  const setActiveTodayWidgets = (updater) => {
    setTodayData((prev) => {
      const base = prev || TODAY_DATA_FALLBACK;
      const curPages = base.pages;
      const curActivePageId = base.activePageId && curPages.some((p) => p.id === base.activePageId) ? base.activePageId : curPages[0].id;
      const newPages = curPages.map((p) => (p.id === curActivePageId ? { ...p, widgets: typeof updater === "function" ? updater(p.widgets) : updater } : p));
      return { ...base, pages: newPages, activePageId: curActivePageId };
    });
  };
  const switchTodayPage = (pageId) => setTodayData((prev) => ({ ...(prev || TODAY_DATA_FALLBACK), activePageId: pageId }));
  const addTodayPage = () => {
    setTodayData((prev) => {
      const base = prev || TODAY_DATA_FALLBACK;
      const newPage = { id: uid(), name: `Page ${base.pages.length + 1}`, widgets: [] };
      return { ...base, pages: [...base.pages, newPage], activePageId: newPage.id };
    });
  };
  const renameTodayPage = (pageId, name) => {
    if (!name.trim()) return;
    setTodayData((prev) => {
      const base = prev || TODAY_DATA_FALLBACK;
      return { ...base, pages: base.pages.map((p) => (p.id === pageId ? { ...p, name: name.trim() } : p)) };
    });
  };
  const updateTodayPageFilter = (pageId, filter) => {
    setTodayData((prev) => {
      const base = prev || TODAY_DATA_FALLBACK;
      return { ...base, pages: base.pages.map((p) => (p.id === pageId ? { ...p, filter } : p)) };
    });
  };
  const updateTodayPageMeta = (pageId, patch) => {
    setTodayData((prev) => {
      const base = prev || TODAY_DATA_FALLBACK;
      return { ...base, pages: base.pages.map((p) => (p.id === pageId ? { ...p, ...patch } : p)) };
    });
  };
  const deleteTodayPage = (pageId) => {
    setTodayData((prev) => {
      const base = prev || TODAY_DATA_FALLBACK;
      if (base.pages.length <= 1) return base;
      const newPages = base.pages.filter((p) => p.id !== pageId);
      const newActive = base.activePageId === pageId ? newPages[0].id : base.activePageId;
      return { ...base, pages: newPages, activePageId: newActive };
    });
  };
  const duplicateTodayPage = (pageId) => {
    setTodayData((prev) => {
      const base = prev || TODAY_DATA_FALLBACK;
      const source = base.pages.find((p) => p.id === pageId);
      if (!source) return base;
      const newPage = { ...source, id: uid(), name: `${source.name} (copie)`, widgets: (source.widgets || []).map((w) => ({ ...w, id: uid() })) };
      const idx = base.pages.findIndex((p) => p.id === pageId);
      const newPages = [...base.pages.slice(0, idx + 1), newPage, ...base.pages.slice(idx + 1)];
      return { ...base, pages: newPages, activePageId: newPage.id };
    });
  };

  /* Changer un widget de tableau de bord (issue #58).

     Les widgets vivent dans DEUX magasins distincts — les tableaux de bord
     (`nexora:dashboards`) et la page « Aujourd'hui » (`nexora:todayWidgets`) —
     et un transfert peut aller de l'un à l'autre. Le calcul est donc fait une
     seule fois sur la liste entière des plans (`widgetTransferApply`, fonction
     pure et éprouvée par tests/widget-transfer.test.mjs), puis réécrit magasin
     par magasin. Traiter le retrait et la pose comme deux gestes séparés
     suffirait à perdre le widget entre les deux. */
  const TODAY_BOARD_ID = "nexora:today";
  const widgetTransferBoards = useMemo(() => ([
    { id: TODAY_BOARD_ID, name: "Aujourd'hui", pages: todayPages },
    ...dashboards.map((d) => ({ id: d.id, name: d.name || "Sans nom", pages: dashboardPages(d) })),
  ]), [todayPages, dashboards]);

  const writeBoardPages = (boardId, nextPages) => {
    if (boardId === TODAY_BOARD_ID) {
      setTodayData((prev) => ({ ...(prev || TODAY_DATA_FALLBACK), pages: nextPages }));
      return;
    }
    setDashboards((prev) => prev.map((d) => {
      if (d.id !== boardId) return d;
      // La page active du tableau de destination ne doit pas changer sous les
      // yeux de son propriétaire ; elle n'est recalculée que si elle a disparu.
      const activeId = d.activePageId && nextPages.some((p) => p.id === d.activePageId) ? d.activePageId : (nextPages[0]?.id || null);
      return { ...d, pages: nextPages, activePageId: activeId };
    }));
  };

  const transferWidget = ({ widgetId, target, mode, patch }) => {
    const before = widgetTransferBoards;
    const after = widgetTransferApply(before, widgetId, target, mode, uid, patch);
    if (after === before) { pushToast({ message: "Le widget est déjà là : rien à déplacer." }); return; }
    // Seuls les plans réellement touchés sont réécrits : recréer les autres
    // relancerait une écriture Firebase par tableau de bord à chaque transfert.
    after.forEach((board, index) => { if (board !== before[index]) writeBoardPages(board.id, board.pages); });
    const destination = widgetTransferTargets(before).find((t) => t.boardId === target?.boardId && t.pageId === target?.pageId);
    const title = (patch && patch.title) || widgetTransferLocate(before, widgetId)?.widget?.title || "Widget";
    const verbe = widgetTransferNormalizeMode(mode) === "duplicate" ? "dupliqué dans" : "déplacé vers";
    pushToast({ message: `Widget « ${title} » ${verbe} « ${destination?.label || "?"} ».` });
  };

  const createDashboard = (name, folderId) => {
    const d = { id: uid(), name: name.trim(), folderId: folderId || null, widgets: [] };
    setDashboards((prev) => [...prev, d]);
    setActiveDashboardId(d.id);
    setView("dashboard");
    setNewDashboardOpen(false);
  };
  const renameDashboard = (id, name) => setDashboards((prev) => prev.map((d) => (d.id === id ? { ...d, name } : d)));
  const updateDashboardMeta = (id, patch) => setDashboards((prev) => prev.map((d) => (d.id === id ? { ...d, ...patch } : d)));
  const duplicateDashboard = (id) => {
    const source = dashboards.find((d) => d.id === id);
    if (!source) return;
    // Copie profonde : nouveaux identifiants pour le tableau, ses pages ET
    // chaque widget — jamais deux tableaux qui partagent le même widget.
    const newPages = dashboardPages(source).map((p) => ({ ...p, id: uid(), widgets: (p.widgets || []).map((w) => ({ ...w, id: uid() })) }));
    const newDashboard = { ...source, id: uid(), name: `${source.name} (copie)`, pages: newPages, activePageId: newPages[0]?.id || null, widgets: undefined };
    setDashboards((prev) => [...prev, newDashboard]);
    pushToast({ message: `Tableau de bord « ${source.name} » dupliqué.` });
  };
  const deleteDashboard = (id) => {
    if (dashboards.length <= 1) { pushToast({ message: "Il doit rester au moins un tableau de bord." }); return; }
    setDashboards((prev) => prev.filter((d) => d.id !== id));
  };
  const [newDashboardOpen, setNewDashboardOpen] = useState(false);
  const [quickEditDashboard, setQuickEditDashboard] = useState(null); // tableau édité via clic droit depuis la sidebar
  const [dashboardFoldersOpen, setDashboardFoldersOpen] = useState(false);
  const [quickEditDashboardFolder, setQuickEditDashboardFolder] = useState(null);
  const [collapsedDashboardFolders, setCollapsedDashboardFolders] = useState({});

  const [savedViews, setSavedViewsRaw] = useState([]);
  const setSavedViews = (updater) =>
    setSavedViewsRaw((prev) => stampChangedEntities(prev, typeof updater === "function" ? updater(prev) : updater));
  const [contextMenu, setContextMenu] = useState(null); // { x, y, type, item }
  const isFavorite = (type, id) => favorites.some((f) => f.type === type && f.id === id);
  const toggleFavorite = (type, id) => setFavorites((prev) => (prev.some((f) => f.type === type && f.id === id) ? prev.filter((f) => !(f.type === type && f.id === id)) : [...prev, { type, id }]));
  const openQuickContextMenu = (e, type, item) => { e.preventDefault(); setContextMenu({ x: e.clientX, y: e.clientY, type, item }); };
  const [savedViewsLoaded, setSavedViewsLoaded] = useState(false);

  useEffect(() => {
    let cancelled = false;
    (async () => {
      try {
        if (window.storage) {
          const res = await storageGetWithTimeout("nexora:views", 10000);
          if (res && res.value && !cancelled) setSavedViews(migrateLegacyMiniGanttData(JSON.parse(res.value)));
        }
      } catch (e) {
        const msg=(e&&e.message)||String(e);
        if (!msg.includes("Key not found")) console.error("[Nexora views load]", e);
      } finally {
        if (!cancelled) { markJustHydrated("nexora:views"); setSavedViewsLoaded(true); }
      }
    })();
    return () => { cancelled = true; };
  }, []);

  useEffect(() => { if (savedViewsLoaded && !syncBlocked) persistKey("nexora:views", savedViews); }, [savedViews, savedViewsLoaded]);

  const [viewPrefs, setViewPrefs] = useState({
    list: { groupBy: "status", visibleFields: ["project", "status", "start", "end", "progress"] },
    gantt: normalizeMiniGanttViewPrefs({ groupBy: "project" }),
    timeline: { minDate: null, maxDate: null, zoom: "month", cardFields: ["project", "status"] },
    radar: { year: new Date().getFullYear(), colorBy: "project" },
    projects: { fields: ["status"], collapsed: {}, zoomKey:"auto", networkMode:false, deadlineMode:false, showRiskBadges:true },
    table: { cols: ["project", "status", "start", "end", "progress", "assignee"] },
  });
  const [viewPrefsLoaded, setViewPrefsLoaded] = useState(false);
  useEffect(() => {
    let cancelled = false;
    (async () => {
      try {
        if (window.storage) {
          const res = await storageGetWithTimeout("nexora:viewPrefs", 10000);
          if (res && res.value && !cancelled) {
            const parsed = JSON.parse(res.value);
            setViewPrefs((v) => ({
              list: { ...v.list, ...parsed.list },
              gantt: normalizeMiniGanttViewPrefs({ ...v.gantt, ...parsed.gantt }),
              timeline: { ...v.timeline, ...parsed.timeline },
              radar: { ...v.radar, ...parsed.radar },
              projects: { ...v.projects, ...parsed.projects },
              table: { ...v.table, ...parsed.table },
            }));
          }
        }
      } catch (e) {
        const msg=(e&&e.message)||String(e);
        if (!msg.includes("Key not found")) console.error("[Nexora viewPrefs load]", e);
      } finally {
        if (!cancelled) { markJustHydrated("nexora:viewPrefs"); setViewPrefsLoaded(true); }
      }
    })();
    return () => { cancelled = true; };
  }, []);
  useEffect(() => { if (viewPrefsLoaded && !syncBlocked) persistKey("nexora:viewPrefs", viewPrefs); }, [viewPrefs, viewPrefsLoaded]);

  const [readmeOpen, setReadmeOpen] = useState(false);
  useEffect(() => {
    let cancelled = false;
    (async () => {
      try {
        if (window.storage) {
          await window.storage.get("nexora:onboardingSeen"); // si trouvé, déjà vu — rien à faire
        }
      } catch (e) {
        // Aucune trace de passage précédent : première connexion, on montre le guide
        if (!cancelled) {
          setReadmeOpen(true);
          persistKey("nexora:onboardingSeen", true);
        }
      }
    })();
    return () => { cancelled = true; };
  }, []);

  // Synchronisation Google Calendar — LECTURE SEULE.
  //
  // Google est la seule source de vérité pour les projets issus des calendriers
  // sélectionnés. À chaque synchronisation :
  //   1. Nexora lit Google Calendar ;
  //   2. toutes les tâches appartenant aux projets Google Nexora sont supprimées ;
  //   3. elles sont recréées intégralement depuis les événements Google récupérés.
  //
  // Aucune tâche Nexora n'est créée/modifiée/supprimée dans Google Calendar.
  // Les tâches Nexora natives éventuellement partagées avec un projet Google sont
  // conservées : seule leur ancienne métadonnée de synchro bidirectionnelle est nettoyée.
  const [gcalSyncing, setGcalSyncing] = useState(false);
  const [gcalError, setGcalError] = useState("");
  const [gcalLastSync, setGcalLastSync] = useState(null);
  const gcalAccessTokenRef = useRef({ token: null, acquiredAt: 0 });

  const getGoogleAccessToken = async () => {
    const cached = gcalAccessTokenRef.current;
    if (cached.token && (Date.now() - cached.acquiredAt) < 45 * 60 * 1000) return cached.token;

    const provider = new GoogleAuthProvider();
    provider.addScope("https://www.googleapis.com/auth/calendar.readonly");

    let result;
    try {
      result = await linkWithPopup(currentUser, provider);
    } catch (linkErr) {
      if (
        linkErr.code === "auth/credential-already-in-use" ||
        linkErr.code === "auth/provider-already-linked"
      ) {
        result = await reauthenticateWithPopup(currentUser, provider);
      } else {
        throw linkErr;
      }
    }

    const cred = GoogleAuthProvider.credentialFromResult(result);
    const accessToken = cred?.accessToken;
    if (!accessToken) throw new Error("Impossible d'obtenir l'autorisation Google Calendar.");
    gcalAccessTokenRef.current = { token: accessToken, acquiredAt: Date.now() };
    return accessToken;
  };



  const [gcalList, setGcalList] = useState(null);
  const [gcalListLoading, setGcalListLoading] = useState(false);
  const [gcalListError, setGcalListError] = useState("");

  const fetchGoogleCalendarList = async () => {
    setGcalListLoading(true);
    setGcalListError("");
    try {
      const accessToken = await getGoogleAccessToken();
      const res = await fetch("https://www.googleapis.com/calendar/v3/users/me/calendarList?maxResults=250", {
        headers: { Authorization: `Bearer ${accessToken}` }
      });
      if (!res.ok) throw new Error(`Google Calendar a répondu ${res.status}`);
      const data = await res.json();
      setGcalList((data.items || []).map((c) => ({
        id: c.id,
        name: c.summaryOverride || c.summary,
        color: c.backgroundColor || "#4285F4"
      })));
    } catch (e) {
      gcalAccessTokenRef.current = { token: null, acquiredAt: 0 };
      setGcalListError((e && e.message) || String(e));
    } finally {
      setGcalListLoading(false);
    }
  };

  const fetchGoogleEvents = async (accessToken, cal, timeMin, timeMax) => {
    const events = [];
    let pageToken = "";

    do {
      const params = new URLSearchParams({
        singleEvents: "true",
        orderBy: "startTime",
        showDeleted: "false",
        maxResults: "2500",
        timeMin: `${timeMin}T00:00:00Z`,
        timeMax: `${timeMax}T23:59:59Z`,
      });
      if (pageToken) params.set("pageToken", pageToken);

      const url = `https://www.googleapis.com/calendar/v3/calendars/${encodeURIComponent(cal.id)}/events?${params.toString()}`;
      const res = await fetch(url, { headers: { Authorization: `Bearer ${accessToken}` } });

      if (!res.ok) {
        let detail = "";
        try {
          const payload = await res.json();
          detail = payload?.error?.message || "";
        } catch (_) {}
        throw new Error(`Google Calendar a répondu ${res.status} pour « ${cal.name} »${detail ? ` — ${detail}` : ""}.`);
      }

      const data = await res.json();
      events.push(...(data.items || []));
      pageToken = data.nextPageToken || "";
    } while (pageToken);

    return events.filter((e) =>
      e.status !== "cancelled" &&
      (e.start?.date || e.start?.dateTime)
    );
  };

  const syncGoogleCalendar = async () => {
    // Le seul chemin d'import est désormais le MCP
    // `import_google_calendar_events`. Cette ancienne synchronisation de
    // l'interface purgeait puis recréait les tâches localement : elle pouvait
    // supprimer une tâche MCP valide entre deux écritures. Elle est conservée
    // temporairement sous ce garde-fou uniquement pour ne pas casser le rendu
    // d'une installation existante ; elle ne peut plus modifier les données.
    setGcalError("L’import Google Calendar est exécuté par l’automatisation MCP ; cette interface ne remplace plus les tâches importées.");
    pushToast({ message: "Synchronisation Google Calendar déléguée à l’import MCP non destructif." });
    return;
    if (gcalSyncing) return;
    setGcalSyncing(true);
    setGcalError("");

    try {
      const accessToken = await getGoogleAccessToken();
      const calendars = (gcalSettings.calendars && gcalSettings.calendars.length)
        ? gcalSettings.calendars
        : [{ id: "primary", name: "Google Calendar", color: "#4285F4" }];

      const timeMin = addDays(iso(new Date()), -(Number(gcalSettings.daysPast) || 30));
      const timeMax = addDays(iso(new Date()), Number(gcalSettings.daysFuture) || 365);

      // Lecture exhaustive des calendriers sélectionnés, avec pagination.
      const results = await Promise.all(calendars.map(async (cal) => ({
        cal,
        events: await fetchGoogleEvents(accessToken, cal, timeMin, timeMax),
      })));

      // Un projet Nexora par calendrier Google sélectionné. Les IDs existants sont
      // réutilisés afin de conserver les dossiers, couleurs, vues et liens visuels.
      const selectedCalIds = new Set(calendars.map((c) => c.id));
      const oldGoogleProjects = projects.filter((p) => p.gcalSource);
      const oldGoogleProjectIds = new Set(oldGoogleProjects.map((p) => p.id));
      const workingProjects = projects
        .filter((p) => !p.gcalSource || selectedCalIds.has(p.gcalCalendarId))
        .map((p) => ({ ...p }));

      const projectIdByCalId = {};
      calendars.forEach((cal) => {
        const displayName = cal.customName?.trim() || cal.name;
        const existingIndex = workingProjects.findIndex(
          (p) => p.gcalSource && p.gcalCalendarId === cal.id
        );

        if (existingIndex >= 0) {
          const existing = workingProjects[existingIndex];
          projectIdByCalId[cal.id] = existing.id;
          workingProjects[existingIndex] = {
            ...existing,
            name: displayName,
            color: cal.color || existing.color,
            gcalSource: true,
            gcalCalendarId: cal.id,
          };
        } else {
          const id = uid();
          projectIdByCalId[cal.id] = id;
          workingProjects.push({
            id,
            name: displayName,
            icon: "📅",
            color: cal.color || "#4285F4",
            gcalSource: true,
            gcalCalendarId: cal.id,
          });
        }
      });

      const selectedGoogleProjectIds = new Set(Object.values(projectIdByCalId));
      const allGoogleProjectIdsToReplace = new Set([
        ...oldGoogleProjectIds,
        ...selectedGoogleProjectIds,
      ]);
      const removedGoogleProjectIds = new Set(
        [...oldGoogleProjectIds].filter((id) => !selectedGoogleProjectIds.has(id))
      );

      // Le statut "Terminé" n'est utilisé que si l'option est activée et qu'un
      // statut correspondant existe réellement dans Nexora.
      const today = iso(new Date());

      // PURGE COMPLÈTE des tâches appartenant aux projets Google puis réécriture.
      // Les tâches Nexora natives restent intactes. On efface toutefois les anciennes
      // métadonnées bidirectionnelles pour garantir qu'aucun code futur ne tente
      // de les renvoyer vers Google.
      const keptTasks = tasks
        .filter((t) => !allGoogleProjectIdsToReplace.has(t.projectId))
        .map((t) => {
          const {
            gcalEventMap,
            gcalManaged,
            gcalImported,
            gcalCalendarId,
            googleEventId,
            ...rest
          } = t;
          return {
            ...rest,
            secondaryProjectId:
              rest.secondaryProjectId && removedGoogleProjectIds.has(rest.secondaryProjectId)
                ? null
                : rest.secondaryProjectId,
          };
        });

      const freshTasks = [];
      let totalEvents = 0;

      results.forEach(({ cal, events }) => {
        const projectId = projectIdByCalId[cal.id];

        events.forEach((ev) => {
          const startDay = ev.start?.date || ev.start?.dateTime?.slice(0, 10);
          if (!startDay) return;

          const rawEnd = ev.end?.date
            ? addDays(ev.end.date, -1)
            : (ev.end?.dateTime ? ev.end.dateTime.slice(0, 10) : startDay);
          const endDay = rawEnd && rawEnd >= startDay ? rawEnd : startDay;
          const importedBase = {
            projectId,
            start: startDay,
            end: endDay,
            statusId: statuses[0]?.id || null,
          };
          const importedStatusId = googleCalendarComputedStatusId(importedBase, workingProjects, statuses, today);

          freshTasks.push({
            id: uid(),
            statusId: importedStatusId,
            // Les tâches importées depuis Google Calendar reçoivent systématiquement
            // le type "Planning", à chaque synchronisation — indépendamment du type
            // par défaut habituel du projet.
            taskTypeId: findTaskTypeByName(taskTypes, "planning")?.id || getDefaultTaskTypeForProject(taskTypes, workingProjects, projectId)?.id || null,
            progress: 0,
            assignee: "",
            checklist: [],
            title: ev.summary || "(Sans titre)",
            start: startDay,
            end: endDay,
            milestone: startDay === endDay,
            desc: ev.description || "",
            googleEventId: ev.id,
            gcalImported: true,
            gcalCalendarId: cal.id,
            projectId,
          });
        });

        totalEvents += events.length;
      });

      setProjects(workingProjects);
      setTasks([...keptTasks, ...carryOverTaskMetaBlocks(tasks, freshTasks)]);

      // Nettoyage complet de l'ancien état de synchronisation bidirectionnelle.
      setGcalSyncState({
        eventsByTaskId: {},
        snapshotsByTaskId: {},
        window: { from: timeMin, to: timeMax },
        lastSyncAt: new Date().toISOString(),
        mode: "readonly-rebuild",
        version: 3,
      });

      setGcalLastSync(new Date());
      pushToast({
        message:
          `${freshTasks.length} événement${freshTasks.length > 1 ? "s" : ""} Google ` +
          `réimporté${freshTasks.length > 1 ? "s" : ""} en lecture seule après remplacement complet ` +
          `des tâches Google dans Nexora.`
      });
    } catch (e) {
      gcalAccessTokenRef.current = { token: null, acquiredAt: 0 };
      setGcalError((e && e.message) || String(e));
    } finally {
      setGcalSyncing(false);
    }
  };

  const setListPrefs = (patch) => setViewPrefs((v) => ({ ...v, list: { ...v.list, ...(typeof patch === "function" ? patch(v.list) : patch) } }));
  const setGanttPrefs = (patch) => setViewPrefs((v) => ({ ...v, gantt: normalizeMiniGanttViewPrefs({ ...v.gantt, ...(typeof patch === "function" ? patch(v.gantt) : patch) }) }));
  const setTimelinePrefs = (patch) => setViewPrefs((v) => ({ ...v, timeline: { ...v.timeline, ...(typeof patch === "function" ? patch(v.timeline) : patch) } }));
  const setRadarPrefs = (patch) => setViewPrefs((v) => ({ ...v, radar: { ...v.radar, ...(typeof patch === "function" ? patch(v.radar) : patch) } }));
  const setProjectsPrefs = (patch) => setViewPrefs((v) => ({ ...v, projects: { ...v.projects, ...(typeof patch === "function" ? patch(v.projects) : patch) } }));
  const setTablePrefs = (patch) => setViewPrefs((v) => ({ ...v, table: { ...v.table, ...(typeof patch === "function" ? patch(v.table) : patch) } }));


  const [saveViewOpen, setSaveViewOpen] = useState(false);
  const [activeSavedViewId, setActiveSavedViewId] = useState(null); // vue enregistrée actuellement affichée, si l'utilisateur en a cliqué une
  // Une vue enregistrée est désormais un véritable "snapshot" de l'interface :
  // vue active, filtres, préférences propres à CHAQUE vue (zoom, groupement,
  // colonnes, mode calendrier, mode Échéances/Réseau du Métro...), et périmètre projets.
  // Les anciennes vues restent compatibles : les propriétés absentes sont simplement ignorées.
  const captureSavedViewState = () => ({
    view,
    // Le périmètre projet fait désormais partie intégrante de filters.advanced.
    // On ne sauvegarde plus activeProjectIds séparément afin d’éviter une
    // seconde source de vérité lors de la restauration d’une vue enregistrée.
    filters: JSON.parse(JSON.stringify(filters)),
    viewPrefs: JSON.parse(JSON.stringify(viewPrefs)),
    activeDashboardId: activeDashboardId || null,
    activePageId: activePageId || null,
    sidebarCollapsed: !!sidebarCollapsed,
  });

  const saveCurrentView = (name, folderId, icon) => {
    const newId = uid();
    const snapshot = captureSavedViewState();
    setSavedViews((prev) => [...prev, {
      id:newId,
      name:name.trim(),
      folderId:folderId || null,
      icon:icon || null,
      ...snapshot,
      snapshotVersion:3,
    }]);
    setActiveSavedViewId(newId);
    setSaveViewOpen(false);
  };

  const normalizeSavedViewFilters = (raw) => {
    const base = defaultFilters();
    const incoming = raw && typeof raw === "object" ? raw : {};
    return {
      ...base,
      ...incoming,
      advanced: incoming.advanced && typeof incoming.advanced === "object"
        ? JSON.parse(JSON.stringify(incoming.advanced))
        : base.advanced,
      // Les champs texte historiques doivent rester des chaînes pour éviter
      // les valeurs undefined dans matchTaskFilters().
      search: typeof incoming.search === "string" ? incoming.search : base.search,
      dueWithinDays: incoming.dueWithinDays ?? base.dueWithinDays,
      pastDays: incoming.pastDays ?? base.pastDays,
      inactivityDays: incoming.inactivityDays ?? incoming.inactivityMinDays ?? base.inactivityDays,
    };
  };

  const updateSavedView = (id, patch) => setSavedViews((prev) => prev.map((v) => {
    if (v.id !== id) return v;
    const next = { ...v, ...patch };
    // Migration silencieuse : activeProjectIds était un ancien snapshot redondant.
    // Il ne doit plus influencer l’application de la vue.
    delete next.activeProjectIds;
    if (patch && patch.filters) next.filters = normalizeSavedViewFilters(patch.filters);
    return next;
  }));

  const applySavedView = (v) => {
    if (!v) return;

    // Préférences AVANT la vue : au montage, le composant reçoit directement
    // le bon zoom/mode sans flash intermédiaire.
    if (v.viewPrefs) {
      setViewPrefs((current) => {
        const restored = {};
        Object.keys(current).forEach((key) => {
          restored[key] = { ...(current[key] || {}), ...((v.viewPrefs && v.viewPrefs[key]) || {}) };
        });
        Object.keys(v.viewPrefs || {}).forEach((key) => {
          if (!(key in restored)) restored[key] = { ...(v.viewPrefs[key] || {}) };
        });
        return { ...restored, gantt: normalizeMiniGanttViewPrefs(restored.gantt) };
      });
    }

    if (v.activeDashboardId) setActiveDashboardId(v.activeDashboardId);
    if (typeof v.sidebarCollapsed === "boolean") setSidebarCollapsed(v.sidebarCollapsed);

    const restoredFilters = normalizeSavedViewFilters(v.filters);
    setFilters(restoredFilters);
    setView(v.view || "projects");
    setActiveSavedViewId(v.id);
    console.info("[Nexora Saved View] Vue appliquée", {
      id:v.id,
      name:v.name,
      view:v.view || "projects",
      matchingTasks: metaFilteredTasks.filter((t) => matchTaskFilters(t, restoredFilters, ctx)).length,
      filters: restoredFilters,
    });
  };

  const updateActiveSavedView = () => {
    if (!activeSavedViewId) return;
    updateSavedView(activeSavedViewId, { ...captureSavedViewState(), snapshotVersion:3 });
    const v = savedViews.find((sv) => sv.id === activeSavedViewId);
    pushToast({ message: `Vue « ${v?.name || ""} » mise à jour avec tous les réglages actuels.` });
  };
  // Applique la page d'ouverture réglée par l'utilisateur — une seule fois, dès
  // que toutes les données nécessaires sont chargées (tâches ET vues enregistrées),
  // jamais à chaque rendu.
  const startupAppliedRef = useRef(false);
  const [startupVisualReady, setStartupVisualReady] = useState(false);

  useEffect(() => {
    if (!dataLoaded || !lastOpenedViewLoaded || !startupAppliedRef.current) return;
    setLastOpenedView(view);
    persistKey("nexora:lastOpenedView", view);
  }, [view, dataLoaded, lastOpenedViewLoaded]);


  // Filet de sécurité absolu : l'écran de chargement ne peut plus rester
  // affiché indéfiniment, même si une préférence secondaire ne répond pas.
  useEffect(() => {
    const timer = setTimeout(() => {
      setStartupVisualReady((ready) => {
        if (!ready) console.warn("[Nexora bootstrap] watchdog: interface révélée après timeout");
        return true;
      });
    }, 15000);
    return () => clearTimeout(timer);
  }, []);



  // La vraie interface reste masquée jusqu'à ce que TOUT ce qui influence la
  // page d'ouverture soit chargé et appliqué. On évite ainsi le "flash" de la
  // vue par défaut, puis les déplacements successifs de filtres/zoom/projets.
  useEffect(() => {
    if (
      startupAppliedRef.current ||
      !dataLoaded ||
      !savedViewsLoaded ||
      !viewPrefsLoaded ||
      (startupPref?.mode === "last" && !lastOpenedViewLoaded)
    ) return;

    startupAppliedRef.current = true;
    const pref = startupPref || { mode: "view", value: "projects" };

    if (pref.mode === "last") {
      setView(lastOpenedView || "projects");
    } else if (pref.mode === "dashboard") {
      setView("dashboard");
      if (pref.value) setActiveDashboardId(pref.value);
    } else if (pref.mode === "savedView") {
      const v = savedViews.find((sv) => sv.id === pref.value);
      if (v) applySavedView(v);
      else setView("projects");
    } else if (pref.mode === "project") {
      if (pref.value) selectOnlyProject(pref.value);
    } else if (pref.mode === "view" && pref.value) {
      setView(pref.value);
    }

    // Le premier écran de chargement reste visuellement présent pendant que
    // la vraie vue est déjà montée derrière lui. Cela laisse les vues complexes
    // (Métro, Échéances, Gantt, dashboards...) effectuer leurs mesures et
    // repositionnements sans jamais les montrer à l'utilisateur.
    //
    // On retire le cache uniquement lorsque la zone principale n'a plus muté
    // pendant 320 ms. Une butée évite qu'un indicateur dynamique mineur
    // (synchronisation, horloge...) ne bloque indéfiniment le démarrage.
    let quietTimer = 0;
    let maxTimer = 0;
    let raf = 0;
    let observer = null;
    let cancelled = false;

    const reveal = () => {
      if (cancelled) return;
      if (observer) observer.disconnect();
      clearTimeout(quietTimer);
      clearTimeout(maxTimer);
      requestAnimationFrame(() => requestAnimationFrame(() => {
        if (!cancelled) setStartupVisualReady(true);
      }));
    };

    const armQuietTimer = () => {
      clearTimeout(quietTimer);
      quietTimer = setTimeout(reveal, 320);
    };

    raf = requestAnimationFrame(() => {
      const target = document.querySelector(".lp-main") || document.querySelector(".lp-app");
      if (target && typeof MutationObserver !== "undefined") {
        observer = new MutationObserver(armQuietTimer);
        observer.observe(target, {
          subtree:true,
          childList:true,
          attributes:true,
          characterData:true,
        });
      }
      armQuietTimer();
      maxTimer = setTimeout(reveal, 2400);
    });

    return () => {
      cancelled = true;
      if (observer) observer.disconnect();
      clearTimeout(quietTimer);
      clearTimeout(maxTimer);
      if (raf) cancelAnimationFrame(raf);
    };
  }, [dataLoaded, savedViewsLoaded, viewPrefsLoaded]);
  const deleteSavedView = (id) => setSavedViews((prev) => prev.filter((v) => v.id !== id));
  const [quickEditView, setQuickEditView] = useState(null); // vue éditée via clic droit depuis la sidebar
  const [quickEditProjectFolder, setQuickEditProjectFolder] = useState(null); // dossier de projet édité via clic droit
  const [quickEditViewFolder, setQuickEditViewFolder] = useState(null); // dossier de vue édité via clic droit

  const [taskModal, setTaskModal] = useState(null);
  const [impactLineTaskId, setImpactLineTaskId] = useState(null);
  const [toasts, setToasts] = useState([]);
  const toastTimers = useRef({});
  const pushToast = ({ message, actionLabel, onAction, duration = 6000 }) => {
    const id = uid();
    setToasts((prev) => [...prev, { id, message, actionLabel, onAction }]);
    toastTimers.current[id] = setTimeout(() => {
      setToasts((prev) => prev.filter((t) => t.id !== id));
      delete toastTimers.current[id];
    }, duration);
  };
  const dismissToast = (id) => {
    setToasts((prev) => prev.filter((t) => t.id !== id));
    if (toastTimers.current[id]) { clearTimeout(toastTimers.current[id]); delete toastTimers.current[id]; }
  };

  const syncPublicCalendarsToProjects = useCallback(() => {
    const configs = normalizedSyncedCalendars(syncedCalendarSettings);
    const enabled = configs.filter(c => c.enabled);
    const enabledIds = new Set(enabled.map(c => c.id));

    const oldProjects = projects.filter(p => p.syncedCalendarSource);
    const oldProjectIds = new Set(oldProjects.map(p => p.id));
    const workingProjects = projects
      .filter(p => !p.syncedCalendarSource || enabledIds.has(p.syncedCalendarId))
      .map(p => ({...p}));

    const projectIdByCalendar = {};
    enabled.forEach(cal => {
      const idx = workingProjects.findIndex(p => p.syncedCalendarSource && p.syncedCalendarId===cal.id);
      if(idx >= 0){
        const p=workingProjects[idx];
        projectIdByCalendar[cal.id]=p.id;
        workingProjects[idx]={...p,name:(cal.projectName||p.name).trim()||p.name,color:cal.color||p.color,syncedCalendarSource:true,syncedCalendarId:cal.id,icon:"tabler:calendar-event"};
      }else{
        const id=uid();
        projectIdByCalendar[cal.id]=id;
        workingProjects.push({
          id,
          name:(cal.projectName||SYNCED_CALENDAR_DEFS.find(d=>d.id===cal.id)?.defaultProjectName||"Calendrier").trim(),
          icon:"tabler:calendar-event",
          color:cal.color||"#4E7CC7",
          syncedCalendarSource:true,
          syncedCalendarId:cal.id,
        });
      }
    });

    const activeProjectIds = new Set(Object.values(projectIdByCalendar));
    const allGeneratedProjectIds = new Set([...oldProjectIds, ...activeProjectIds]);

    // Les tâches générées par ces calendriers sont entièrement reconstruites.
    // Les tâches créées manuellement dans d'autres projets sont intactes.
    const keptTasks = tasks.filter(t => !t.syncedCalendarImported && !allGeneratedProjectIds.has(t.projectId));
    const freshTasks = [];

    enabled.forEach(cal => {
      const projectId = projectIdByCalendar[cal.id];
      const items = syncedCalendarItems(cal.id, syncedCalendarSettings);
      items.forEach(item => {
        freshTasks.push({
          id: uid(),
          title: item.title,
          desc: [item.description, item.provider].filter(Boolean).join("\n"),
          projectId,
          statusId: statuses[0]?.id || null,
          taskTypeId: getDefaultTaskTypeForProject(taskTypes, workingProjects, projectId)?.id || null,
          progress: 0,
          assignee: "",
          checklist: [],
          start: item.date,
          end: item.date,
          milestone: true,
          syncedCalendarImported: true,
          syncedCalendarId: cal.id,
          syncedCalendarKey: item.publicKey || item.id,
          syncedCalendarProvider: item.provider || "",
          // #138 : posé directement à la génération, jamais laissé au report
          // de carryOverTaskMetaBlocks ci-dessous — un bloc auto-généré est
          // reconstruit à l'identique à chaque synchronisation, il ne doit
          // jamais hériter d'un réglage manuel devenu obsolète.
          metaBlock: cal.showAsMetaBlock ? syncedCalendarAutoMetaBlock(cal.color) : null,
        });
      });
    });

    // Le report couvre les tâches dont le calendrier N'IMPOSE PAS de bloc
    // (l'utilisateur a pu en marquer une à la main) ; il ne doit jamais
    // écraser un bloc automatique tout juste posé ci-dessus.
    const carried = carryOverTaskMetaBlocks(tasks, freshTasks);
    const autoBlockCalendarIds = new Set(enabled.filter(c => c.showAsMetaBlock).map(c => c.id));
    const nextGenerated = carried.map((t, i) => (
      autoBlockCalendarIds.has(freshTasks[i].syncedCalendarId) ? { ...t, metaBlock: freshTasks[i].metaBlock } : t
    ));

    setProjects(workingProjects);
    setTasks([...keptTasks, ...nextGenerated]);
    const now = new Date().toISOString();
    setSyncedCalendarSettings(prev => ({...prev, calendars: configs, lastSyncAt: now}));
    pushToast?.({message:`Calendriers synchronisés · ${enabled.length} projet${enabled.length>1?"s":""} · ${freshTasks.length} jalon${freshTasks.length>1?"s":""}`});
  }, [syncedCalendarSettings, projects, tasks, statuses, setTasks, pushToast]);
  const [confirmState, setConfirmState] = useState(null); // { title, message, danger, confirmLabel, onConfirm }
  const askConfirm = (opts) => setConfirmState(opts);
  const [taskModalDefaults, setTaskModalDefaults] = useState(null);
  const [quickEditProject, setQuickEditProject] = useState(null); // projet édité via clic droit depuis la sidebar
  const [filtersOpen, setFiltersOpen] = useState(false);
  const [globalSearchOpen, setGlobalSearchOpen] = useState(false);
  // Réglages — hub unique regroupant projets, statuts, apparence, vues affichées et données
  const [settingsOpen, setSettingsOpen] = useState(false);
  const [settingsTab, setSettingsTab] = useState("project");
  const DEFAULT_SHORTCUTS = {
    addTask: "Ctrl+Alt+N",
    zoomDay: "Ctrl+Alt+J",
    zoomWeek: "Ctrl+Alt+W",
    zoomMonth: "Ctrl+Alt+M",
    zoomAuto: "Ctrl+Alt+A",
    toggleDeadlineMode: "Ctrl+Alt+S",
    goToday: "Ctrl+Alt+T",
    openLocalFilters: "Ctrl+Alt+F",
    openMetaFilters: "Ctrl+Shift+F",
    openGlobalSearch: "Ctrl+Shift+K",
    markdownChecklist: "Ctrl+Space",
    markdownPreviewToggle: "Ctrl+ArrowLeft",
    createWidget: "Ctrl+Shift+W",
    saveNow: "Ctrl+Shift+S",
    addMeetingTask: "Ctrl+Shift+R",
    addPlanningTask: "Ctrl+Shift+P",
  };
  const [shortcutPrefs, setShortcutPrefs] = useState(DEFAULT_SHORTCUTS);
  const [shortcutPrefsLoaded, setShortcutPrefsLoaded] = useState(false);
  const searchInputRef = useRef(null);
  const shortcutMatches = (e, combo) => matchesShortcutCombo(e, combo);
  useEffect(() => {
    let cancelled = false;
    (async () => {
      try {
        if (window.storage) {
          const res = await storageGetWithTimeout("nexora:shortcutPrefs", 10000);
          if (res && res.value && !cancelled) {
            const stored = JSON.parse(res.value);
            // Migration du raccourci historique : Ctrl+Alt+S servait auparavant
            // au zoom semaine. Il devient le raccourci par défaut demandé pour
            // basculer Normal ↔ Échéances ; le zoom semaine passe à Ctrl+Alt+W.
            if (!stored.toggleDeadlineMode && stored.zoomWeek === "Ctrl+Alt+S") {
              stored.zoomWeek = "Ctrl+Alt+W";
              stored.toggleDeadlineMode = "Ctrl+Alt+S";
            }
            setShortcutPrefs((v) => ({ ...v, ...stored }));
          }
        }
      } catch (e) {}
      if (!cancelled) { markJustHydrated("nexora:shortcutPrefs"); setShortcutPrefsLoaded(true); }
    })();
    return () => { cancelled = true; };
  }, []);
  useEffect(() => { if (shortcutPrefsLoaded && !syncBlocked) persistKey("nexora:shortcutPrefs", shortcutPrefs); }, [shortcutPrefs, shortcutPrefsLoaded]);
  // Raccourcis clavier globaux : configurables dans Réglages > Raccourcis
  useEffect(() => {
    const onKeyDown = (e) => {
      const tag = (e.target.tagName || "").toLowerCase();
      const typing = tag === "input" || tag === "textarea" || tag === "select" || e.target.isContentEditable;
      const inWritingMode = !!e.target?.closest?.(".lp-writing-mode-overlay");

      // Dans les champs classiques, les raccourcis globaux restent désactivés
      // pour ne jamais perturber la saisie. Dans le Mode écriture, en revanche,
      // toutes les combinaisons configurées Nexora restent disponibles.
      //
      // Les touches de saisie simples (dont "/") restent du texte normal tant
      // que le curseur est dans l'éditeur.
      if (typing && !inWritingMode) {
        if (e.key === "Escape") e.target.blur();
        return;
      }

      if (!typing && e.key === "/") {
        e.preventDefault();
        searchInputRef.current?.focus();
        return;
      }

      if (shortcutMatches(e, shortcutPrefs.addTask)) { e.preventDefault(); openNewTask({}); return; }
      if (shortcutMatches(e, shortcutPrefs.addMeetingTask)) {
        e.preventDefault();
        const meetingType = findTaskTypeByName(taskTypes, "réunion");
        openNewTask({ milestone: true, ...(meetingType ? { taskTypeId: meetingType.id } : {}) });
        return;
      }
      if (shortcutMatches(e, shortcutPrefs.addPlanningTask)) {
        e.preventDefault();
        const planningType = findTaskTypeByName(taskTypes, "planning");
        openNewTask(planningType ? { taskTypeId: planningType.id } : {});
        return;
      }
      if (shortcutMatches(e, shortcutPrefs.saveNow)) { e.preventDefault(); saveNow(); return; }
      if (shortcutMatches(e, shortcutPrefs.createWidget)) {
        e.preventDefault();
        window.dispatchEvent(new CustomEvent("nexora:create-widget"));
        return;
      }
      if (shortcutMatches(e, shortcutPrefs.toggleDeadlineMode)) {
        e.preventDefault();
        window.dispatchEvent(new CustomEvent("nexora:metro-deadline-toggle"));
        return;
      }
      if (shortcutMatches(e, shortcutPrefs.goToday)) {
        e.preventDefault();
        window.dispatchEvent(new CustomEvent("nexora:go-today"));
        return;
      }
      if (shortcutMatches(e, shortcutPrefs.openLocalFilters)) {
        e.preventDefault();
        setFiltersOpen(true);
        return;
      }
      if (shortcutMatches(e, shortcutPrefs.openMetaFilters)) {
        e.preventDefault();
        setFiltersOpen(false);
        setSettingsTab("meta");
        setSettingsOpen(true);
        return;
      }
      if (shortcutMatches(e, shortcutPrefs.openGlobalSearch)) {
        e.preventDefault();
        setFiltersOpen(false);
        setSettingsOpen(false);
        setGlobalSearchOpen(true);
        return;
      }
      if (shortcutMatches(e, shortcutPrefs.zoomDay)) { e.preventDefault(); window.dispatchEvent(new CustomEvent("nexora:timeline-zoom", { detail: "day" })); return; }
      if (shortcutMatches(e, shortcutPrefs.zoomWeek)) { e.preventDefault(); window.dispatchEvent(new CustomEvent("nexora:timeline-zoom", { detail: "week" })); return; }
      if (shortcutMatches(e, shortcutPrefs.zoomMonth)) { e.preventDefault(); window.dispatchEvent(new CustomEvent("nexora:timeline-zoom", { detail: "month" })); return; }
      if (shortcutMatches(e, shortcutPrefs.zoomAuto)) { e.preventDefault(); window.dispatchEvent(new CustomEvent("nexora:timeline-zoom", { detail: "auto" })); return; }
      if (e.key === "n" || e.key === "N") { e.preventDefault(); openNewTask({}); return; }
      if (e.key === "Escape") {
        const nestedOpen = document.querySelector(".lp-dropdown-panel-portal, .lp-color-select-panel, .lp-quick-context-menu, .lp-activity-search-menu");
        if (!nestedOpen) setFiltersOpen(false);
      }
    };
    window.addEventListener("keydown", onKeyDown);
    return () => window.removeEventListener("keydown", onKeyDown);
  }, [shortcutPrefs, taskTypes]);
  const [importOpen, setImportOpen] = useState(false);
  const [markdownImportOpen, setMarkdownImportOpen] = useState(false);
  const [projectFoldersOpen, setProjectFoldersOpen] = useState(false);
  const [viewFoldersOpen, setViewFoldersOpen] = useState(false);
  const [collapsedProjFolders, setCollapsedProjFolders] = useState({});
  const [sidebarWidth, setSidebarWidth] = useState(272);
  const [sidebarCollapsed, setSidebarCollapsed] = useState(false);
  const [mobileMoreOpen, setMobileMoreOpen] = useState(false); // feuille "Plus" de la barre de navigation mobile (état d'UI pur, non persisté)
  const sidebarResizing = useRef(false);
  const sidebarRef = useRef(null);
  /* Double-clic sur la poignée de redimensionnement : ajuste la largeur au
     contenu réellement affiché (#179), au lieu d'une largeur fixe qui laisse
     du vide ou tronque les noms selon les projets/tableaux du moment. Mesure
     RÉELLE (pas une estimation) : la largeur qu'occuperait le contenu sans
     troncature, en passant temporairement à `width:max-content` — la mise en
     page revient à `sidebarWidth` au prochain rendu, React réappliquant le
     style habituel après ce calcul synchrone. */
  const fitSidebarWidth = () => {
    const el = sidebarRef.current;
    if (!el || sidebarCollapsed) return;
    const previousWidth = el.style.width;
    el.style.width = "max-content";
    const natural = Math.ceil(el.scrollWidth);
    el.style.width = previousWidth;
    setSidebarWidth(Math.max(180, Math.min(440, natural + 4)));
  };
  useEffect(() => {
    function onMove(e) {
      if (!sidebarResizing.current) return;
      setSidebarWidth(Math.max(180, Math.min(440, e.clientX)));
    }
    function onUp() {
      if (!sidebarResizing.current) return;
      sidebarResizing.current = false;
      document.body.style.cursor = "";
      document.body.style.userSelect = "";
    }
    window.addEventListener("mousemove", onMove);
    window.addEventListener("mouseup", onUp);
    return () => { window.removeEventListener("mousemove", onMove); window.removeEventListener("mouseup", onUp); };
  }, []);
  const startSidebarResize = (e) => { e.preventDefault(); sidebarResizing.current = true; document.body.style.cursor = "ew-resize"; document.body.style.userSelect = "none"; };
  const [sidebarOpen, setSidebarOpen] = useState({ projects: true, views: true, dashboards: true });
  const [collapsedViewFolders, setCollapsedViewFolders] = useState({});

  /* `workshops` entre dans le contexte partagé — c'est un catalogue, comme les
     statuts ou les types de jalon, et n'importe quel widget peut avoir à en
     lire le nom et la couleur. Les AFFECTATIONS, elles, n'y entrent pas :
     seul le widget Charge personnel les lit, et les faire transiter par `ctx`
     aurait fait re-rendre tous les autres à chaque case cochée. */
  // activeProjectIds (#137) : le ou les projets actuellement ouverts dans le
  // filtre global — c'est la valeur que "Projet courant" développe dans un
  // filtre de page/widget ou un budgetProjectId (resolveProjectFilterIds).
  const ctx = useMemo(
    () => ({ projects, statuses, taskTypes, milestoneTypes, workshops, teams, teamFolders, habitThemes, tasks, teamMembers, projectFolders, expenses, activeProjectIds: getProjectFilterIds(filters) }),
    [projects, statuses, taskTypes, milestoneTypes, workshops, teams, teamFolders, habitThemes, tasks, teamMembers, projectFolders, expenses, filters]
  );
  // Relie le compte connecté à un utilisateur de l'app via son email, pour
  // activer "Mes tâches" dans certains widgets sans dupliquer de système d'auth.
  const myName = useMemo(() => {
    if (!currentUser?.email) return null;
    const match = teamMembers.find((u) => u.email && u.email.toLowerCase() === currentUser.email.toLowerCase());
    return match?.name || null;
  }, [teamMembers, currentUser]);
  // ctx est un objet simple (non figé) : on y ajoute myName après coup plutôt que
  // de dupliquer un second objet de contexte, puisque myName dépend de currentUser
  // qui n'est disponible qu'après la définition de ctx lui-même.
  ctx.myName = myName;

  /* La capture quotidienne d'instantanés par projet a été retirée (#99). Elle
     alimentait le widget Project Momentum, supprimé par le nettoyage général :
     elle écrivait donc une ligne par projet et par jour, indéfiniment, que plus
     rien ne lisait. Le magasin `nexora:momentumSnapshots` reste au contrat du
     MCP et ses données déjà écrites sont intactes — il est simplement figé :
     l'interface le lit et le sauvegarde, elle ne lui ajoute plus rien. */

  // Journal d'activité réel : compare l'état des tâches avant/après chaque
  // changement et n'enregistre que des événements réellement survenus (jamais
  // d'activité inventée) — sert de base à "Changements récents" du Daily
  // Briefing, qui autrement n'aurait aucune donnée fiable à afficher.
  const prevTasksForActivityRef = useRef(null);
  useEffect(() => {
    if (!dataLoaded) return;
    const prev = prevTasksForActivityRef.current;
    if (prev) {
      const prevById = Object.fromEntries(prev.map((t) => [t.id, t]));
      const nowIds = new Set(tasks.map((t) => t.id));
      const now = new Date().toISOString();
      const entries = [];
      // Détection honnête des blocages/déblocages : une tâche est "bloquée" si au
      // moins une de ses dépendances n'est pas terminée. On compare l'état avant/
      // après pour ne signaler que les VRAIS changements (jamais un statut inventé).
      const unmetDepsSet = (list) => {
        const doneIds = new Set(list.filter((t) => isTaskDoneGlobal(t, ctx)).map((t) => t.id));
        const set = new Set();
        list.forEach((t) => { if ((t.dependsOn || []).some((id) => !doneIds.has(id))) set.add(t.id); });
        return set;
      };
      const prevBlocked = unmetDepsSet(prev);
      const nowBlocked = unmetDepsSet(tasks);
      tasks.forEach((t) => {
        const before = prevById[t.id];
        if (!before) { entries.push({ id: uid(), type: "created", taskId: t.id, taskTitle: t.title, projectId: t.projectId, at: now }); return; }
        if (before.statusId !== t.statusId) {
          const wasDone = isTaskDoneGlobal(before, ctx), isDone = isTaskDoneGlobal(t, ctx);
          entries.push({ id: uid(), type: wasDone === isDone ? "statusChanged" : isDone ? "completed" : "reopened", taskId: t.id, taskTitle: t.title, milestone: !!t.milestone, projectId: t.projectId, at: now });
        }
        if ((before.assignee || "") !== (t.assignee || "")) {
          entries.push({ id: uid(), type: "reassigned", taskId: t.id, taskTitle: t.title, from: before.assignee || null, to: t.assignee || null, projectId: t.projectId, at: now });
        }
        if (before.end !== t.end) {
          entries.push({ id: uid(), type: "deadlineChanged", taskId: t.id, taskTitle: t.title, fromDate: before.end, toDate: t.end, milestone: !!t.milestone, projectId: t.projectId, at: now });
        }
        if (!prevBlocked.has(t.id) && nowBlocked.has(t.id)) entries.push({ id: uid(), type: "blocked", taskId: t.id, taskTitle: t.title, projectId: t.projectId, at: now });
        else if (prevBlocked.has(t.id) && !nowBlocked.has(t.id)) entries.push({ id: uid(), type: "unblocked", taskId: t.id, taskTitle: t.title, projectId: t.projectId, at: now });
      });
      prev.forEach((t) => { if (!nowIds.has(t.id)) entries.push({ id: uid(), type: "deleted", taskId: t.id, taskTitle: t.title, projectId: t.projectId, at: now }); });
      // #142 : plafond porté de 300 à 2 000 — l'onglet Historique de la fiche de
      // tâche lit désormais ce journal, 300 entrées le vidait trop vite pour des
      // tâches actives. `persistKey` segmente déjà toute clé volumineuse
      // (chunked-v1) sous la limite Firestore de 1 Mio : rien à ajouter ici.
      if (entries.length > 0) setActivityLog((log) => [...entries, ...log].slice(0, 2000));
    }
    prevTasksForActivityRef.current = tasks;
  }, [tasks, dataLoaded]);

  // Migration non destructive : les anciennes tâches ne possédaient pas ce champ.
  // Au premier chargement de cette version, on initialise leur référence à l'instant
  // de migration. À partir de là, chaque mutation est suivie automatiquement.
  useEffect(() => {
    if (!dataLoaded) return;
    const migrationStamp = new Date().toISOString();
    setTasksRaw((prev) => {
      let changed = false;
      const next = prev.map((t) => {
        if (t.lastInteraction) return t;
        changed = true;
        return { ...t, lastInteraction:migrationStamp };
      });
      return changed ? next : prev;
    });
  }, [dataLoaded]);

  // Reprise « Urgent » (issue #35). Deux temps, dans cet ordre imposé : réaffecter
  // les tâches D'ABORD, retirer le statut ENSUITE. L'inverse laisserait ces tâches
  // pointant vers un statut inexistant.
  //
  // Les statuts peuvent être propres à un projet : il peut donc exister PLUSIEURS
  // « Urgent », et le « En cours » de remplacement doit être résolu dans la portée
  // de CHAQUE tâche. Quand un projet n'offre pas de « En cours », on ne devine pas :
  // la tâche garde son statut, et le statut « Urgent » correspondant survit — en
  // supprimer un encore référencé casserait ces tâches.
  //
  // Dépend des données plutôt que du seul premier chargement : la reprise est sans
  // effet dès qu'il n'y a plus de statut « Urgent » (sortie immédiate), et se
  // rejoue d'elle-même si la synchronisation entre appareils en ramène un.
  useEffect(() => {
    if (!dataLoaded) return;
    const plan = planUrgentMigration({ tasks, statuses, projects, statusesForProject: getStatusesForProject });
    if (!plan.reassign.length && !plan.removeStatusIds.length && !plan.keptStatusIds.length) return;

    if (plan.reassign.length) {
      const target = new Map(plan.reassign.map((r) => [r.taskId, r.statusId]));
      setTasksRaw((prev) => prev.map((t) => (target.has(t.id) ? { ...t, criticality: "urgent", statusId: target.get(t.id) } : t)));
    }
    if (plan.keptStatusIds.length) {
      console.warn("Criticité : " + plan.keptStatusIds.length + " statut(s) « Urgent » conservés — aucun « En cours » disponible dans le projet de certaines tâches. Créez-le, puis rechargez.");
    }
    if (plan.removeStatusIds.length) {
      const drop = new Set(plan.removeStatusIds);
      setStatuses((prev) => {
        const next = prev.filter((s) => !drop.has(s.id));
        return next.length === prev.length ? prev : next;
      });
    }
  }, [dataLoaded, tasks, statuses, projects]);

  // Capture le "plan initial" (dates de la toute première fois qu'on voit chaque
  // tâche) — jamais réécrit ensuite, jamais reconstruit rétroactivement. Pour les
  // tâches déjà présentes au premier chargement, la baseline reflète honnêtement
  // "le plus tôt qu'on ait pu observer", pas une vraie date de création (donnée
  // absente du modèle actuel) — d'où l'indicateur "Depuis le <date>" affiché dans
  // le widget Time Machine plutôt qu'un vrai "plan initial" pour ces tâches-là.
  useEffect(() => {
    if (!dataLoaded) return;
    setTaskBaselines((prev) => {
      const now = iso(new Date());
      let changed = false;
      const next = { ...prev };
      tasks.forEach((t) => {
        if (!next[t.id] && t.start && t.end) {
          next[t.id] = { start: t.start, end: t.end, capturedAt: now };
          changed = true;
        }
      });
      return changed ? next : prev;
    });
  }, [tasks, dataLoaded]);

  // Purge les baselines orphelines : sans ce nettoyage, une baseline capturée
  // pour une tâche supprimée n'est JAMAIS retirée de nexora:taskBaselines, qui
  // ne fait donc que grossir au fil des années. Au-delà d'environ 9000 tâches
  // (~112 octets par entrée), le document dépasse la limite Firestore de 1 Mio
  // et CHAQUE sauvegarde de cette clé échoue silencieusement depuis — c'est
  // exactement ce qui vient de se produire. Ce nettoyage tourne à chaque
  // chargement et à chaque suppression de tâche, pas seulement une fois.
  useEffect(() => {
    if (!dataLoaded) return;
    setTaskBaselines((prev) => {
      const liveIds = new Set(tasks.map((t) => t.id));
      const staleIds = Object.keys(prev).filter((id) => !liveIds.has(id));
      if (staleIds.length === 0) return prev;
      const next = { ...prev };
      staleIds.forEach((id) => { delete next[id]; });
      console.info(`[Nexora] ${staleIds.length} baseline(s) orpheline(s) purgée(s) de nexora:taskBaselines.`);
      return next;
    });
  }, [tasks, dataLoaded]);

  const [taskSort, setTaskSort] = useState({ field: "none", dir: "asc" });
  const [viewToolbarSlot, setViewToolbarSlot] = useState(null); // nœud DOM où chaque vue "porte" ses propres boutons, dans l'en-tête
  const [dashboardTabsSlot, setDashboardTabsSlot] = useState(null); // nœud DOM à côté du titre, où les onglets de pages du tableau de bord sont "portés" pour gagner la hauteur qu'occupait leur rangée dédiée
  const metaFilteredTasks = useMemo(
    () => tasks.filter((t) => matchTaskFilters(t, metaFilters, ctx)),
    [tasks, metaFilters, ctx]
  );
  // Méta blocs effectifs : ceux des Réglages plus ceux portés par les tâches
  // de projets calendrier. Calculés sur TOUTES les tâches, pas sur celles que
  // laisse passer le filtre global : un congé reste dessiné même si la tâche
  // qui le porte est filtrée.
  const allMetaTemporalBlocks = useMemo(
    () => mergeMetaTemporalBlocks(metaTemporalBlocks, tasks),
    [metaTemporalBlocks, tasks]
  );
  /* Filtre textuel des surfaces « tableau de bord » (issue #72).

     Il vit à part des filtres de vue, et c'est volontaire : ces surfaces
     partent du socle méta-filtré et n'appliquent pas `filters`. Le brancher sur
     `filters.search` l'aurait fait partager son état avec les autres vues, où
     la recherche balaie tout autre chose.

     `boardSearchApplied` est la valeur RETARDÉE. La zone de saisie reste
     pilotée par `boardSearch`, donc la frappe ne rame jamais ; seul le
     recalcul des vues attend la fin de la rafale. */
  const [boardSearch, setBoardSearch] = useState("");
  const [boardSearchApplied, setBoardSearchApplied] = useState("");
  useEffect(() => {
    const id = setTimeout(() => setBoardSearchApplied(boardSearch), 120);
    return () => clearTimeout(id);
  }, [boardSearch]);
  const boardTasks = useMemo(
    () => filterTasksByText(metaFilteredTasks, boardSearchApplied),
    [metaFilteredTasks, boardSearchApplied]
  );
  const boardSearchActive = !!boardSearchApplied.trim();

  const todayPresentationTasks = useMemo(() => {
    const rank = { action:0, activity:1, milestone:2 };
    return [...boardTasks].sort((a,b) => {
      const ta = getTaskType(a), tb = getTaskType(b);
      return (rank[ta] ?? 9) - (rank[tb] ?? 9) || (a.end || "").localeCompare(b.end || "");
    });
  }, [boardTasks]);

  const filteredTasks = useMemo(() => {
    const base = metaFilteredTasks.filter((t) => matchTaskFilters(t, filters, ctx));
    if (taskSort.field === "none") return base;
    const dir = taskSort.dir === "desc" ? -1 : 1;
    const getVal = (t) => {
      switch (taskSort.field) {
        case "title": return (t.title || "").toLowerCase();
        case "start": return t.start || "";
        case "end": return t.end || "";
        case "progress": return t.progress || 0;
        case "project": return (ctx.projects.find((p) => p.id === t.projectId)?.name || "").toLowerCase();
        case "status": return (ctx.statuses.find((s) => s.id === t.statusId)?.name || "").toLowerCase();
        case "assignee": return (t.assignee || "").toLowerCase();
        case "inactivity": return taskInteractionAgeDays(t);
        case "criticality": return CRITICALITIES.findIndex((c) => c.id === t.criticality);
        case "dependsOn": return (t.dependsOn || []).length;
        case "referenceEnd": return miniGanttTaskComparison(t, taskBaselines)?.referenceEnd || "";
        case "delta": return miniGanttTaskComparison(t, taskBaselines)?.endDeltaDays ?? null;
        case "delayRisks": return (t.delayRisks || []).length;
        default: return "";
      }
    };
    return [...base].sort((a, b) => {
      const va = getVal(a), vb = getVal(b);
      if (va < vb) return -1 * dir;
      if (va > vb) return 1 * dir;
      return 0;
    });
  }, [metaFilteredTasks, filters, ctx, taskSort]);
  const projectById = useMemo(() => Object.fromEntries(projects.map((p) => [p.id, p])), [projects]);

  // Cascade automatique : si une tâche dépend d'une ou plusieurs autres, sa date de
  // début est recalée juste après la fin la plus tardive de ses dépendances. Une
  // seule passe (dépendances directes), sans effet sur les dates antérieures.
  useEffect(() => {
    setTasks((prev) => {
      let changed = false;
      const byId = Object.fromEntries(prev.map((t) => [t.id, t]));
      const next = prev.map((t) => {
        if (!t.dependsOn || t.dependsOn.length === 0 || !t.start) return t;
        const depEnds = t.dependsOn.map((id) => byId[id]?.end).filter(Boolean);
        if (depEnds.length === 0) return t;
        const requiredStart = depEnds.reduce((m, d) => (d > m ? d : m), depEnds[0]);
        if (requiredStart > t.start) {
          changed = true;
          const shift = dayIndex(requiredStart) - dayIndex(t.start);
          return { ...t, start: requiredStart, end: t.milestone ? requiredStart : addDays(t.end, shift) };
        }
        return t;
      });
      return changed ? next : prev;
    });
  }, [tasks]);


  const openNewTask = (defaults) => {
    const d = { ...(defaults || {}) };
    // Présélection intelligente : si un seul projet est actif dans le filtre de la barre
    // latérale, et qu'aucun projet n'a été explicitement fourni, on le propose par défaut.
    if (!d.projectId) {
      const activeIds = getProjectFilterIds(filters);
      if (activeIds.length === 1) d.projectId = activeIds[0];
      else if (taskDefaults.projectId) d.projectId = taskDefaults.projectId;
    }
    // Valeurs par défaut des Réglages (#183) : seulement là où rien de plus
    // précis (contexte d'ouverture, présélection ci-dessus, ou template choisi
    // au clic droit — voir openNewTaskFromTemplate) n'a déjà décidé. Retour de
    // test : élargi à tous les champs pour lesquels une présélection a du sens.
    if (!d.secondaryProjectId && taskDefaults.secondaryProjectId) d.secondaryProjectId = taskDefaults.secondaryProjectId;
    if (!d.taskTypeId && taskDefaults.taskTypeId) d.taskTypeId = taskDefaults.taskTypeId;
    if (!d.statusId && taskDefaults.statusId) d.statusId = taskDefaults.statusId;
    if (!d.assignee && taskDefaults.assignee) d.assignee = taskDefaults.assignee;
    if (!d.criticality && taskDefaults.criticality) d.criticality = taskDefaults.criticality;
    if (d.milestone === undefined && taskDefaults.milestone) d.milestone = taskDefaults.milestone === "milestone";
    setTaskModalDefaults(d);
    setTaskModal({});
  };
  const openEditTask = (task) => { setTaskModalDefaults(null); setTaskModal(task); };

  // Templates de tâche nommés (#183, retour de test) : un clic droit sur un
  // bouton d'ajout propose de choisir un template plutôt que d'ouvrir
  // directement le formulaire — les valeurs qu'il porte s'appliquent comme un
  // `defaults` explicite (donc prioritaires sur les Valeurs par défaut des
  // Réglages), mais le CONTEXTE du bouton cliqué (ex. la colonne d'un tableau
  // groupé) reste prioritaire sur le template pour les champs qu'il fixe déjà.
  const templateToDefaults = (tpl) => {
    const v = (tpl && tpl.values) || {};
    const d = {};
    if (v.projectId) d.projectId = v.projectId;
    if (v.secondaryProjectId) d.secondaryProjectId = v.secondaryProjectId;
    if (v.taskTypeId) d.taskTypeId = v.taskTypeId;
    if (v.statusId) d.statusId = v.statusId;
    if (v.assignee) d.assignee = v.assignee;
    if (v.criticality) d.criticality = v.criticality;
    if (v.milestone) d.milestone = v.milestone === "milestone";
    return d;
  };
  const openNewTaskFromTemplate = (template, seed) => openNewTask({ ...templateToDefaults(template), ...(seed || {}) });
  const [addTaskMenu, setAddTaskMenu] = useState(null); // { x, y, seed }
  const openAddTaskMenu = (e, seed) => {
    if (!taskTemplates.length) { openNewTask(seed || {}); return; } // rien à choisir : comportement d'avant
    e.preventDefault();
    setAddTaskMenu({ x: e.clientX, y: e.clientY, seed: seed || {} });
  };

  // Capture externe (ChatGPT, raccourci, lien)
  // La demande est sauvegardée immédiatement en sessionStorage afin de survivre
  // à un rechargement / cycle d'authentification avant que Nexora soit prêt.
  const [pendingExternalCapture, setPendingExternalCapture] = useState(() => {
    const STORAGE_KEY = "nexora:pendingExternalCapture";
    try {
      const params = new URLSearchParams(window.location.search);
      if (params.get("nexoraCapture") === "1") {
        const payload = {
          title: (params.get("title") || "").trim(),
          desc: (params.get("desc") || "").trim(),
          due: (params.get("due") || "").trim(),
          project: (params.get("project") || "Inbox").trim(),
          sourceUrl: (params.get("sourceUrl") || "").trim(),
          sourceMessageId: (params.get("sourceMessageId") || "").trim(),
          sourceSender: (params.get("sourceSender") || "").trim(),
          source: (params.get("source") || "gmail").trim() || "gmail",
          driveUrl: (params.get("driveUrl") || "").trim(),
          driveName: (params.get("driveName") || "").trim(),
          capturedAt: new Date().toISOString(),
        };
        if (payload.title) {
          sessionStorage.setItem(STORAGE_KEY, JSON.stringify(payload));
          return payload;
        }
      }
      const stored = sessionStorage.getItem(STORAGE_KEY);
      return stored ? JSON.parse(stored) : null;
    } catch(e) {
      return null;
    }
  });

  const captureHandledRef = useRef(false);
  useEffect(() => {
    if (!dataLoaded || captureHandledRef.current || !pendingExternalCapture?.title) return;

    captureHandledRef.current = true;
    const requestedProject = (pendingExternalCapture.project || "Inbox").trim().toLowerCase();
    const targetProject =
      projects.find(p => (p.name || "").trim().toLowerCase() === requestedProject) ||
      projects.find(p => (p.name || "").trim().toLowerCase() === "inbox") ||
      projects[0];

    const dueRaw = (pendingExternalCapture.due || "").trim();
    const due = /^\d{4}-\d{2}-\d{2}$/.test(dueRaw) ? dueRaw : "";
    const captureDriveUrl = (pendingExternalCapture.driveUrl || "").trim();
    const captureDriveAttachment = isGoogleDriveUrl(captureDriveUrl) ? [{
      id: uid(),
      type: "link",
      provider: "google-drive",
      driveKind: googleDriveKind(captureDriveUrl),
      name: (pendingExternalCapture.driveName || "").trim() || (googleDriveKind(captureDriveUrl) === "folder" ? "Dossier Google Drive" : "Fichier Google Drive"),
      url: captureDriveUrl,
      addedAt: new Date().toISOString(),
    }] : [];

    setTaskModalDefaults({
      title: pendingExternalCapture.title,
      desc: pendingExternalCapture.desc || "",
      projectId: targetProject?.id || "",
      start: due,
      end: due,
      milestone: !!due,
      source: pendingExternalCapture.source || "gmail",
      sourceUrl: pendingExternalCapture.sourceUrl || "",
      sourceMessageId: pendingExternalCapture.sourceMessageId || "",
      sourceSender: pendingExternalCapture.sourceSender || "",
      attachments: captureDriveAttachment,
    });
    setTaskModal({});
    console.info("[Nexora Capture] Ouverture de la fiche préremplie", { title: pendingExternalCapture.title, project: targetProject?.name || null, due });

    try { sessionStorage.removeItem("nexora:pendingExternalCapture"); } catch(e) {}
    setPendingExternalCapture(null);

    // Une fois la capture mémorisée, on peut nettoyer l'URL sans perdre la demande.
    try {
      const clean = window.location.pathname + window.location.hash;
      window.history.replaceState({}, "", clean || "/");
    } catch(e) {}
  }, [dataLoaded, projects, pendingExternalCapture]);

  const saveTask = (data) => {
    if (data.dependsOn && data.dependsOn.length && data.start) {
      const conflicts = tasks.filter((t) => data.dependsOn.includes(t.id) && t.end && t.end > data.start);
      if (conflicts.length) pushToast({ message: `Attention : « ${data.title} » démarre avant la fin de ${conflicts.map((t) => `« ${t.title} »`).join(", ")}.` });
    }
    if (data.id) setTasks((prev) => prev.map((t) => (t.id === data.id ? { ...t, ...data } : t)));
    else setTasks((prev) => [...prev, { ...data, id: uid(), lastInteraction:new Date().toISOString() }]);
    setTaskModal(null);
  };

  const normalizeProjectName = (value) => String(value || "")
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/[\p{Extended_Pictographic}\p{Emoji_Presentation}]/gu, "")
    .replace(/[^a-zA-Z0-9]+/g, " ")
    .trim()
    .toLowerCase();

  // #129 (retour de test) : « Supprimer » n'efface plus directement — la
  // tâche part dans nexora:taskArchive (corbeille datée, Réglages > Données),
  // exactement comme archiveTasks ci-dessous, avec le même geste "Annuler" de
  // 8 s qu'avant ce changement. Restaurable depuis la corbeille au-delà des
  // 8 s, purgée pour de bon après 30 jours (voir purgeOldArchivedTasks).
  const deleteTask = (id) => {
    const removed = tasks.find((t) => t.id === id);
    setTaskModal(null);
    if (!removed) return;
    const archived = { ...removed, archivedAt: new Date().toISOString() };
    setTasks((prev) => prev.filter((t) => t.id !== id));
    setTaskArchive((prev) => [...prev, archived]);
    pushToast({
      message: `Tâche « ${removed.title} » supprimée.`,
      actionLabel: "Annuler",
      duration: 8000,
      onAction: () => {
        setTaskArchive((prev) => prev.filter((t) => t.id !== removed.id));
        setTasks((prev) => (prev.some((t) => t.id === removed.id) ? prev : [...prev, removed]));
      },
    });
  };
  const markTaskDone = (taskId) => {
    setTasks((prev) => {
      const target = prev.find((t) => t.id === taskId);
      if (!target) return prev;
      if (isGoogleCalendarProjectId(target.projectId, projects)) {
        pushToast({ message: "Le statut d’une tâche Google Calendar est calculé automatiquement à partir de ses dates." });
        return prev;
      }
      if (restrictedStatusForType(taskTypes, statuses, target.taskTypeId)) {
        pushToast({ message: "Le statut de ce type de tâche est automatique — il ne peut pas être marqué terminé." });
        return prev;
      }
      const allowedStatuses = getStatusesForProject(statuses, projects, target.projectId, target.statusId);
      const doneStatus = allowedStatuses.find((s) => /termin/i.test(s.name || ""));
      const inProgressStatus = allowedStatuses.find((s) => /en\s*cours/i.test(s.name || ""));
      const currentlyDone = isTaskDoneGlobal(target, ctx);
      const updated = prev.map((t) => {
        if (t.id !== taskId) return t;
        if (currentlyDone) return { ...t, progress: 50, statusId: inProgressStatus ? inProgressStatus.id : t.statusId };
        return { ...t, progress: 100, statusId: doneStatus ? doneStatus.id : t.statusId };
      });
      // Tâche récurrente : génère automatiquement la prochaine occurrence
      if (!currentlyDone && target.recurrence && target.start && target.end) {
        const { unit, interval } = target.recurrence;
        const shiftDays = unit === "day" ? interval : unit === "week" ? interval * 7 : interval * 30;
        const nextStart = addDays(target.start, shiftDays);
        const nextEnd = target.milestone ? nextStart : addDays(target.end, shiftDays);
        const recurrenceStatuses = getStatusesForProject(statuses, projects, target.projectId);
        const restartStatus = recurrenceStatuses.find((s) => /planifier|nouveau|backlog|attente/i.test(s.name || "")) || recurrenceStatuses[0];
        updated.push({
          ...target, id: uid(), start: nextStart, end: nextEnd, progress: 0,
          statusId: restartStatus ? restartStatus.id : target.statusId,
          checklist: (target.checklist || []).map((i) => ({ ...i, done: false })),
        });
        pushToast({ message: `Prochaine occurrence de « ${target.title} » créée pour le ${fmtShort(nextEnd)}.` });
      }
      return updated;
    });
  };
  const cycleStatus = (taskId) => {
    setTasks((prev) => prev.map((t) => {
      if (t.id !== taskId) return t;
      if (isGoogleCalendarProjectId(t.projectId, projects)) return t;
      if (restrictedStatusForType(taskTypes, statuses, t.taskTypeId)) return t;
      const nonDoneStatuses = getStatusesForProject(statuses, projects, t.projectId)
        .filter((s) => !/termin/i.test(s.name || ""));
      if (!nonDoneStatuses.length) return t;
      const idx = nonDoneStatuses.findIndex((s) => s.id === t.statusId);
      const next = nonDoneStatuses[(idx + 1 + nonDoneStatuses.length) % nonDoneStatuses.length];
      return { ...t, statusId: next.id };
    }));
  };

  // #139 : « Commencer » du widget Next Best Action n'ouvrait que la fiche —
  // il fallait ensuite changer le statut à la main. Même garde-fous que
  // cycleStatus (Google Calendar calculé automatiquement, type restreint à un
  // statut unique) ; ne fait rien si la tâche est déjà « En cours » ou si
  // aucun statut de ce nom n'existe pour son projet.
  const startTask = (task) => {
    setTasks((prev) => prev.map((t) => {
      if (t.id !== task.id) return t;
      if (isGoogleCalendarProjectId(t.projectId, projects)) return t;
      if (restrictedStatusForType(taskTypes, statuses, t.taskTypeId)) return t;
      const inProgress = getStatusesForProject(statuses, projects, t.projectId).find((s) => /en\s*cours/i.test(s.name || ""));
      if (!inProgress || t.statusId === inProgress.id) return t;
      return { ...t, statusId: inProgress.id };
    }));
  };

  const requestDeleteTask = (task) => {
    // deleteTask gère déjà la suppression ET l'unique notification avec Annuler.
    // Ne pas pousser un second toast ici.
    deleteTask(task.id);
  };
  /* Figer la référence en masse (#149) — le geste de fin de revue de projet :
     chaque tâche sélectionnée reçoit ses dates ACTUELLES comme nouvelle
     référence de comparaison, via la même fonction pure que le bouton de la
     fiche (`taskComparisonFromCurrentDates`). Une tâche sans date exploitable
     n'entre simplement pas dans le lot — comme la fiche, qui ne propose rien à
     figer sur une tâche non datée. Annulable, comme la suppression en masse. */
  const requestFreezeReference = (ids, label) => {
    const list = (ids || []).filter(Boolean);
    const eligible = tasks.filter((t) => list.includes(t.id) && taskComparisonFromCurrentDates(t));
    if (eligible.length === 0) { pushToast({ message: "Aucune tâche datée dans la sélection : rien à figer." }); return; }
    askConfirm({
      title: "Figer la référence ?",
      message: `${eligible.length} tâche${eligible.length > 1 ? "s" : ""} ${label || "sélectionnées"} ${eligible.length > 1 ? "recevront" : "recevra"} ses dates actuelles comme nouvelle référence de comparaison. Une référence déjà posée part dans l'historique (#165).`,
      confirmLabel: `Figer la référence (${eligible.length})`,
      onConfirm: () => {
        const before = new Map(eligible.map((t) => [t.id, t.comparison ?? null]));
        setTasks((prev) => prev.map((t) => (before.has(t.id) ? { ...t, comparison: freezeTaskReference(t) } : t)));
        setConfirmState(null);
        pushToast({
          message: `Référence figée pour ${eligible.length} tâche${eligible.length > 1 ? "s" : ""}.`,
          actionLabel: "Annuler",
          onAction: () => setTasks((prev) => prev.map((t) => (before.has(t.id) ? { ...t, comparison: before.get(t.id) } : t))),
        });
      },
    });
  };

  const requestBulkDelete = (ids, label) => {
    const list = (ids || []).filter(Boolean);
    if (list.length === 0) { pushToast({ message: "Aucune tâche à supprimer ici." }); return; }
    askConfirm({
      title: "Supprimer ces tâches ?",
      message: `${list.length} tâche${list.length > 1 ? "s" : ""} ${label} ${list.length > 1 ? "seront supprimées" : "sera supprimée"}.`,
      danger: true,
      confirmLabel: `Supprimer (${list.length})`,
      onConfirm: () => {
        // #129 (retour de test) : même corbeille datée que la suppression
        // unitaire (deleteTask) — voir son commentaire pour le détail.
        const removedSnapshot = tasks.filter((t) => list.includes(t.id));
        const archived = removedSnapshot.map((t) => ({ ...t, archivedAt: new Date().toISOString() }));
        setTasks((prev) => prev.filter((t) => !list.includes(t.id)));
        setTaskArchive((prev) => [...prev, ...archived]);
        setConfirmState(null);
        pushToast({
          message: `${removedSnapshot.length} tâche${removedSnapshot.length > 1 ? "s" : ""} supprimée${removedSnapshot.length > 1 ? "s" : ""}`,
          actionLabel: "Annuler",
          duration: 8000,
          onAction: () => {
            setTaskArchive((prev) => prev.filter((t) => !list.includes(t.id)));
            setTasks((prev) => [...prev, ...removedSnapshot.filter((t) => !prev.some((p) => p.id === t.id))]);
          },
        });
      },
    });
  };

  // Archivage : retire des tâches de nexora:tasks (le document qui approche la
  // limite Firestore) vers nexora:taskArchive, un document séparé. Rien n'est
  // perdu — juste déplacé hors du document "chaud" pour le garder petit et
  // fiable. Consultable/restaurable depuis Réglages > Données.
  const archiveTasks = (ids, { silent = false } = {}) => {
    const list = (ids || []).filter(Boolean);
    if (list.length === 0) return;
    const toArchive = tasks.filter((t) => list.includes(t.id)).map((t) => ({ ...t, archivedAt: new Date().toISOString() }));
    if (toArchive.length === 0) return;
    setTasks((prev) => prev.filter((t) => !list.includes(t.id)));
    setTaskArchive((prev) => [...prev, ...toArchive]);
    if (!silent) {
      pushToast({
        message: `${toArchive.length} tâche${toArchive.length > 1 ? "s" : ""} archivée${toArchive.length > 1 ? "s" : ""}.`,
        actionLabel: "Annuler",
        onAction: () => {
          setTaskArchive((prev) => prev.filter((t) => !list.includes(t.id)));
          setTasks((prev) => [...prev, ...toArchive.map(({ archivedAt, ...t }) => t).filter((t) => !prev.some((p) => p.id === t.id))]);
        },
      });
    }
  };

  const restoreArchivedTasks = (ids) => {
    const list = (ids || []).filter(Boolean);
    if (list.length === 0) return;
    const toRestore = taskArchive.filter((t) => list.includes(t.id)).map(({ archivedAt, ...t }) => t);
    if (toRestore.length === 0) return;
    setTaskArchive((prev) => prev.filter((t) => !list.includes(t.id)));
    setTasks((prev) => [...prev, ...toRestore.filter((t) => !prev.some((p) => p.id === t.id))]);
    pushToast({ message: `${toRestore.length} tâche${toRestore.length > 1 ? "s" : ""} restaurée${toRestore.length > 1 ? "s" : ""}.` });
  };

  const deleteArchivedTasksForever = (ids) => {
    const list = (ids || []).filter(Boolean);
    if (list.length === 0) return;
    askConfirm({
      title: "Supprimer définitivement ?",
      message: `${list.length} tâche${list.length > 1 ? "s" : ""} archivée${list.length > 1 ? "s" : ""} ${list.length > 1 ? "seront supprimées" : "sera supprimée"} pour de bon, sans possibilité de restauration.`,
      danger: true,
      confirmLabel: `Supprimer définitivement (${list.length})`,
      onConfirm: () => {
        setTaskArchive((prev) => prev.filter((t) => !list.includes(t.id)));
        setConfirmState(null);
        pushToast({ message: `${list.length} tâche${list.length > 1 ? "s" : ""} définitivement supprimée${list.length > 1 ? "s" : ""}.` });
      },
    });
  };

  // Purge automatique de la corbeille après 30 jours (#129, retour de test) :
  // une tâche archivée depuis plus longtemps — supprimée depuis l'interface
  // ou archivée manuellement, peu importe l'origine — part pour de bon, sans
  // confirmation (c'est le comportement promis, pas une action ponctuelle).
  // Se déclenche à chaque changement de nexora:taskArchive ; après avoir
  // purgé, le prochain passage ne trouve plus rien d'expiré et ne fait rien —
  // converge en deux passages, jamais de boucle.
  useEffect(() => {
    if (!dataLoaded) return;
    const cutoff = Date.now() - 30 * 24 * 60 * 60 * 1000;
    const expired = taskArchive.filter((t) => t.archivedAt && Date.parse(t.archivedAt) < cutoff);
    if (!expired.length) return;
    const expiredIds = new Set(expired.map((t) => t.id));
    setTaskArchive((prev) => prev.filter((t) => !expiredIds.has(t.id)));
    pushToast({ message: `${expired.length} tâche${expired.length > 1 ? "s" : ""} archivée${expired.length > 1 ? "s" : ""} depuis plus de 30 jours supprimée${expired.length > 1 ? "s" : ""} définitivement.` });
  }, [dataLoaded, taskArchive]);

  // Archive en un clic toutes les tâches terminées depuis plus de daysThreshold
  // jours (basé sur lastInteraction, la meilleure approximation disponible pour
  // "n'a pas bougé depuis"). C'est l'action recommandée par l'alerte de taille
  // Firestore sur nexora:tasks.
  const archiveOldCompletedTasks = (daysThreshold) => {
    const threshold = Math.max(1, Number(daysThreshold) || 1);

    const doneTasks = tasks.filter((t) => isTaskDoneGlobal(t, ctx));

    // Seule la vraie date de complétion compte désormais (le critère de
    // repli sur la dernière interaction a été retiré : une tâche sans date
    // de complétion connue n'est plus archivée automatiquement, même si elle
    // n'a pas été touchée depuis longtemps).
    const assessed = doneTasks.map((t) => {
      const completionAge = taskCompletionAgeDays(t, activityLog);
      return { task:t, age:completionAge };
    });

    const eligible = assessed.filter((x) => x.age != null && x.age >= threshold);
    const candidates = eligible.map((x) => x.task);
    const unknownCount = assessed.filter((x) => x.age == null).length;

    if (candidates.length === 0) {
      pushToast({
        message:
          `Aucune tâche terminée éligible depuis plus de ${threshold} jour${threshold > 1 ? "s" : ""}.` +
          (unknownCount > 0
            ? ` ${unknownCount} tâche${unknownCount > 1 ? "s" : ""} sans date de complétion connue ne ${unknownCount > 1 ? "sont" : "peut"} pas être évaluée${unknownCount > 1 ? "s" : ""} automatiquement.`
            : "")
      });
      return;
    }

    askConfirm({
      title: "Archiver les tâches anciennes ?",
      message:
        `${candidates.length} tâche${candidates.length > 1 ? "s" : ""} ${candidates.length > 1 ? "sont" : "est"} éligible${candidates.length > 1 ? "s" : ""} pour archivage après ${threshold} jour${threshold > 1 ? "s" : ""} depuis leur date de complétion. ` +
        (unknownCount > 0
          ? `${unknownCount} tâche${unknownCount > 1 ? "s" : ""} terminée${unknownCount > 1 ? "s" : ""} sans date de complétion connue ${unknownCount > 1 ? "sont" : "est"} ignorée${unknownCount > 1 ? "s" : ""} par prudence. `
          : "") +
        `Rien n'est supprimé : tout reste restaurable.`,
      confirmLabel: `Archiver (${candidates.length})`,
      onConfirm: () => {
        setConfirmState(null);
        archiveTasks(candidates.map((t) => t.id));
      },
    });
  };

  // ============================================================================
  // Module Devis — création/édition, changement de statut, et proposition de
  // création de projet quand un devis passe en "Accepté" (jamais automatique :
  // l'utilisateur doit valider explicitement, voir quoteToProjectPrompt).
  // ============================================================================
  const addQuoteClient = (data) => {
    const client = { id: uid(), ...data };
    setQuoteClients((prev) => [...prev, client]);
    return client;
  };

  const saveQuoteClient = (id, data) => {
    setQuoteClients((prev) => prev.map((c) => (c.id === id ? { ...c, ...data } : c)));
  };

  const deleteQuoteClient = (id) => setQuoteClients((prev) => prev.filter((c) => c.id !== id));

  // existingId absent -> nouveau devis : numéro attribué à la CRÉATION (voir
  // nextQuoteNumber, part-000), jamais recalculé ensuite même si d'autres
  // devis sont créés après.
  // Renvoie le devis complet (pas juste son id) : QuotesView s'en sert pour
  // lancer l'archivage Drive (PDF) juste après la sauvegarde, sans dépendre
  // du timing de la mise à jour d'état React.
  const saveQuote = (data, existingId) => {
    if (existingId) {
      const now = new Date().toISOString();
      const current = quotes.find((q) => q.id === existingId);
      const merged = { ...(current || {}), ...data, id: existingId, updatedAt: now };
      setQuotes((prev) => prev.map((q) => (q.id === existingId ? merged : q)));
      return merged;
    }
    const id = uid();
    const number = nextQuoteNumber(quotes);
    const now = new Date().toISOString();
    const quote = { id, number, status: "draft", createdAt: now, updatedAt: now, ...data };
    setQuotes((prev) => [...prev, quote]);
    return quote;
  };

  // Duplication : un nouveau numéro, un nouveau statut Brouillon, des lignes
  // avec de nouveaux identifiants — jamais une copie qui partagerait quoi que
  // ce soit avec l'original.
  const duplicateQuote = (quote) => {
    const id = uid();
    const number = nextQuoteNumber(quotes);
    const now = new Date().toISOString();
    setQuotes((prev) => [...prev, {
      ...quote, id, number, status: "draft", createdAt: now, updatedAt: now,
      lines: (quote.lines || []).map((l) => ({ ...l, id: uid() })),
    }]);
  };

  const deleteQuote = (id) => setQuotes((prev) => prev.filter((q) => q.id !== id));

  // Devis dont l'acceptation vient d'être déclarée : la boîte de dialogue de
  // proposition de projet (voir plus bas, rendu JSX) reste ouverte tant que
  // l'utilisateur n'a pas choisi "Créer le projet" ou "Ignorer" — jamais de
  // création silencieuse.
  const [quoteToProjectPrompt, setQuoteToProjectPrompt] = useState(null);
  // Id de la facture à ouvrir automatiquement en arrivant sur la vue Factures
  // — posé par "Facturer ce devis" (QuotesView), consommé puis effacé par
  // InvoicesView (onAutoOpened) : jamais une ouverture silencieuse répétée.
  const [pendingOpenInvoiceId, setPendingOpenInvoiceId] = useState(null);
  const facturerQuote = (quote) => {
    const id = createInvoiceFromQuote(quote);
    setPendingOpenInvoiceId(id);
    setView("invoices");
  };

  const setQuoteStatus = (id, status) => {
    setQuotes((prev) => prev.map((q) => (q.id === id ? { ...q, status } : q)));
    if (status === "accepted") {
      const q = quotes.find((x) => x.id === id);
      if (q) setQuoteToProjectPrompt({ ...q, status });
    }
  };

  // Réutilise le même modèle de données que la création manuelle d'un projet
  // (ProjectManager, part-002 — {id,name,icon,color}) et de tâche (seedTasks,
  // part-000 — {id,projectId,statusId,title,...}) : une ligne de devis devient
  // une tâche dont le titre est la description de la ligne.
  const createProjectFromQuote = (quote) => {
    const client = quoteClients.find((c) => c.id === quote.clientId);
    const projectId = uid();
    const baseName = (quote.title || "").trim() || client?.name || "Devis";
    const name = `${baseName} — devis ${quote.number}`;
    setProjects((prev) => [...prev, { id: projectId, name, icon: "📄", color: "#004AAD" }]);
    const todayIso = iso(new Date());
    const defaultStatusId = statuses[0]?.id || "";
    const newTasks = (quote.lines || []).map((line) => ({
      id: uid(), projectId, statusId: defaultStatusId,
      title: line.description || "Ligne de devis", desc: "",
      start: todayIso, end: addDays(todayIso, 7), progress: 0, milestone: false,
      assignee: "", checklist: [],
    }));
    if (newTasks.length) setTasks((prev) => [...prev, ...newTasks]);
    setQuoteToProjectPrompt(null);
    return projectId;
  };

  // Catalogue de prestations — créer/mettre à jour par id, comme saveQuote.
  // L'insertion d'une entrée dans un devis (QuoteFormModal) en fait une
  // COPIE one-shot dans la ligne : modifier le catalogue ensuite ne touche
  // jamais les devis déjà créés.
  const saveCatalogEntry = (entry) => {
    setQuoteCatalog((prev) => {
      const exists = prev.some((e) => e.id === entry.id);
      return exists ? prev.map((e) => (e.id === entry.id ? { ...e, ...entry } : e)) : [...prev, { ...entry, id: entry.id || uid() }];
    });
  };
  const deleteCatalogEntry = (id) => setQuoteCatalog((prev) => prev.filter((e) => e.id !== id));

  // Chips de compétences/logiciels — créer/mettre à jour par id. La
  // suppression retire aussi l'id de tous les skillIds qui le référencent
  // (lignes de devis ET entrées de catalogue) : jamais de référence orpheline
  // invisible dans les données.
  const saveSkill = (skill) => {
    setQuoteSkills((prev) => {
      const exists = prev.some((s) => s.id === skill.id);
      return exists ? prev.map((s) => (s.id === skill.id ? { ...s, ...skill } : s)) : [...prev, { ...skill, id: skill.id || uid() }];
    });
  };
  const deleteSkill = (id) => {
    setQuoteSkills((prev) => prev.filter((s) => s.id !== id));
    setQuoteCatalog((prev) => prev.map((e) => (e.skillIds?.includes(id) ? { ...e, skillIds: e.skillIds.filter((s) => s !== id) } : e)));
    setQuotes((prev) => prev.map((q) => {
      if (!(q.lines || []).some((l) => l.skillIds?.includes(id))) return q;
      return { ...q, lines: q.lines.map((l) => (l.skillIds?.includes(id) ? { ...l, skillIds: l.skillIds.filter((s) => s !== id) } : l)) };
    }));
  };

  // ============================================================================
  // Module Facture — construit sur le modèle du module Devis ci-dessus.
  // ============================================================================
  // Crée une facture à partir d'un devis accepté : copie client + lignes +
  // titre, statut initial "issued", quoteId renseigné (traçabilité), échéance
  // par défaut +30 jours comme les devis (defaultInvoiceDueDate). Retourne
  // l'id de la facture créée — comme saveQuote, l'appelant (QuotesView →
  // bouton "Facturer ce devis") en a besoin pour basculer vers elle.
  const createInvoiceFromQuote = (quote) => {
    const id = uid();
    const number = nextInvoiceNumber(invoices);
    const now = new Date().toISOString();
    const todayIso = iso(new Date());
    const invoice = {
      id, number, quoteId: quote.id, clientId: quote.clientId, title: quote.title || "",
      issueDate: todayIso, dueDate: defaultInvoiceDueDate(todayIso),
      lines: (quote.lines || []).map((l) => ({ ...l, id: uid() })),
      status: "issued", createdAt: now,
    };
    setInvoices((prev) => [...prev, invoice]);
    // Même archivage Drive automatique que la sauvegarde manuelle d'une
    // facture (voir saveInvoice/InvoicesView.handleSave) — "Facturer ce
    // devis" est aussi une création de facture.
    const client = quoteClients.find((c) => c.id === invoice.clientId);
    archiveInvoicePdfToDrive(invoice, client, quoteSettings, quoteSkills, quote, null);
    return id;
  };

  // Création/édition manuelle libre — comme saveQuote, existingId absent =
  // nouvelle facture (numéro attribué à la CRÉATION, jamais recalculé
  // ensuite). Une facture "payée" ou "annulée" reste techniquement éditable
  // ici (pas de verrou dur) : QuotesView/InvoicesView n'affiche simplement
  // pas le bouton d'édition pour ces statuts (voir InvoiceFormModal, part-003).
  // Renvoie la facture complète (pas juste son id) : InvoicesView s'en sert
  // pour lancer l'archivage Drive (PDF) juste après la sauvegarde, sans
  // dépendre du timing de la mise à jour d'état React — même principe que
  // saveQuote ci-dessus.
  const saveInvoice = (data, existingId) => {
    if (existingId) {
      const now = new Date().toISOString();
      const current = invoices.find((inv) => inv.id === existingId);
      const merged = { ...(current || {}), ...data, id: existingId, updatedAt: now };
      setInvoices((prev) => prev.map((inv) => (inv.id === existingId ? merged : inv)));
      return merged;
    }
    const id = uid();
    const number = nextInvoiceNumber(invoices);
    const now = new Date().toISOString();
    const invoice = { id, number, status: "issued", createdAt: now, ...data };
    setInvoices((prev) => [...prev, invoice]);
    return invoice;
  };

  // Duplication : une NOUVELLE facture, son propre numéro dans la séquence
  // continue (jamais une copie qui réutiliserait un numéro) — même principe
  // que duplicateQuote.
  const duplicateInvoice = (invoice) => {
    const id = uid();
    const number = nextInvoiceNumber(invoices);
    const now = new Date().toISOString();
    setInvoices((prev) => [...prev, {
      ...invoice, id, number, status: "issued", quoteId: invoice.quoteId,
      creditNoteOf: undefined, cancelledByInvoiceId: undefined, paidAt: undefined,
      createdAt: now, updatedAt: undefined,
      lines: (invoice.lines || []).map((l) => ({ ...l, id: uid() })),
    }]);
  };

  // "Payée" est le seul passage de statut manuel qui a un effet de bord :
  // paidAt est renseigné automatiquement (jamais par ailleurs), pour le Livre
  // des recettes (InvoicesView). "cancelled" n'est JAMAIS atteignable depuis
  // ce handler — uniquement via createCreditNote ci-dessous.
  const setInvoiceStatus = (id, status) => {
    if (status === "cancelled") return;
    setInvoices((prev) => prev.map((inv) => {
      if (inv.id !== id) return inv;
      return { ...inv, status, paidAt: status === "paid" ? iso(new Date()) : inv.paidAt };
    }));
  };

  // Avoir — LA seule façon d'annuler une facture émise : jamais de
  // suppression (numérotation continue et sans trou, voir nextInvoiceNumber
  // part-000), jamais de réutilisation de numéro. Crée un nouveau document
  // dans la même séquence, lignes en montants négatifs (le total et chaque
  // ligne s'affichent donc négatifs, dans l'UI comme dans le PDF), et marque
  // la facture d'origine "cancelled" avec une référence croisée dans les deux
  // sens (cancelledByInvoiceId / creditNoteOf).
  const createCreditNote = (invoiceId) => {
    const source = invoices.find((inv) => inv.id === invoiceId);
    if (!source) return;
    const id = uid();
    const number = nextInvoiceNumber(invoices);
    const now = new Date().toISOString();
    const negate = (l) => ({
      ...l, id: uid(),
      amount: -Math.abs(Number(l.amount) || 0),
      unitRate: l.kind === "regie" ? -Math.abs(Number(l.unitRate) || 0) : l.unitRate,
    });
    const creditNote = {
      id, number, quoteId: source.quoteId, clientId: source.clientId,
      title: source.title, issueDate: iso(new Date()), dueDate: iso(new Date()),
      lines: (source.lines || []).map(negate),
      status: "issued", creditNoteOf: source.id, createdAt: now,
    };
    setInvoices((prev) => [
      ...prev.map((inv) => (inv.id === source.id ? { ...inv, status: "cancelled", cancelledByInvoiceId: id } : inv)),
      creditNote,
    ]);
    // Un avoir est un document au même titre qu'une facture : même archivage
    // Drive automatique, fire-and-forget (voir archiveInvoicePdfToDrive,
    // part-003). "original" = la facture qu'il annule, pour le bandeau AVOIR
    // du PDF (originalInvoiceNumber).
    const client = quoteClients.find((c) => c.id === creditNote.clientId);
    const sourceQuote = creditNote.quoteId ? quotes.find((q) => q.id === creditNote.quoteId) : null;
    archiveInvoicePdfToDrive(creditNote, client, quoteSettings, quoteSkills, sourceQuote, source.number);
    return id;
  };

  const [pendingDeleteProject, setPendingDeleteProject] = useState(null);
  const requestDeleteProject = (project) => {
    const hasTasks = tasks.some((t) => t.projectId === project.id);
    if (!hasTasks) {
      askConfirm({
        title: "Supprimer ce projet ?",
        message: `Le projet « ${project.name} » sera supprimé.`,
        danger: true,
        confirmLabel: "Supprimer",
        onConfirm: () => {
          setProjects((prev) => prev.filter((p) => p.id !== project.id));
          setConfirmState(null);
        },
      });
      return;
    }
    setPendingDeleteProject(project);
  };

  // getProjectFilterIds est désormais un helper de portée globale (part-000,
  // partagé avec resolveProjectFilterIds pour #137).
  const setProjectFilterIds = (f, ids) => {
    const currentAdv = f.advanced || { op: "and", items: [] };
    const otherItems = (currentAdv.items || []).filter((it) => it.field !== "project");
    const newItems = ids.length ? [...otherItems, { field: "project", mode: "is", values: ids }] : otherItems;
    return { ...currentAdv, items: newItems };
  };
  const selectOnlyProject = (id) => setFilters((f) => ({ ...f, advanced: setProjectFilterIds(f, id ? [id] : []) }));

  const applyNavigationZoom = (targetView, zoom) => {
    if (!zoom) return;
    setViewPrefs((prev)=>{
      if (targetView==="projects") return {...prev,projects:{...prev.projects,zoomKey:zoom}};
      if (targetView==="gantt") return {...prev,gantt:{...prev.gantt,zoomKey:zoom}};
      if (targetView==="timeline") return {...prev,timeline:{...prev.timeline,zoom}};
      return prev;
    });
  };

  // Détermine automatiquement le niveau temporel le plus lisible pour le ou
  // les projets que l'utilisateur vient de sélectionner.
  const autoTemporalZoomForProjects = (targetView, projectIds=[]) => {
    if (targetView === "projects" || targetView === "timeline") return "auto";

    const scoped = tasks.filter((t)=>
      projectIds.includes(t.projectId) &&
      (t.start || t.end)
    );

    if (!scoped.length) {
      if (targetView === "gantt") return "month";
      return "";
    }

    const dates = [];
    scoped.forEach((t)=>{
      if (t.start) dates.push(t.start);
      if (t.end) dates.push(t.end);
    });
    if (!dates.length) return "";

    const minDate = dates.reduce((a,b)=>a<b?a:b);
    const maxDate = dates.reduce((a,b)=>a>b?a:b);
    const spanDays = Math.max(1, dayIndex(maxDate) - dayIndex(minDate) + 1);

    if (targetView === "gantt") {
      // Chaque seuil vise environ une largeur d'écran utile : plus le projet
      // est long, plus l'échelle choisie est compacte.
      if (spanDays <= 20) return "day";
      if (spanDays <= 45) return "week";
      if (spanDays <= 120) return "month";
      if (spanDays <= 360) return "quarter";
      if (spanDays <= 1200) return "year";
      return "5years";
    }

    return "";
  };

  const applyScopedNavigation = ({ project=null, folder=null, projectIds=[], autoTemporal=false }) => {
    const cfg = project
      ? mergeProjectNavigationDefaults(project, folder, projectDefaultView)
      : { ...(folder?.navigationDefaults || {}), view: folder?.navigationDefaults?.view || normalizeProjectDefaultView(projectDefaultView) };
    const targetView = cfg.view || (PROJECT_TAB_VIEW_KEYS.includes(view) ? view : "projects");

    setFilters((current)=>{
      let base=current;
      if (cfg.filters) {
        base={
          ...defaultFilters(),
          ...cfg.filters,
          advanced:cfg.filters.advanced || defaultFilters().advanced
        };
      }
      return {...base,advanced:setProjectFilterIds(base,projectIds)};
    });

    const temporalZoom = autoTemporal
      ? autoTemporalZoomForProjects(targetView,projectIds)
      : cfg.zoom;

    applyNavigationZoom(targetView,temporalZoom);
    setView(targetView);
  };

  const selectProjectAndNavigate = (id) => {
    const project=projects.find((p)=>p.id===id);
    if (!project) { selectOnlyProject(id); return; }
    const folder=projectFolders.find((f)=>f.id===project.folderId) || null;

    // Un clic direct sur un projet recalcule systématiquement l'échelle
    // temporelle à partir des dates de CE projet, même si la vue précédente
    // était restée sur un zoom manuel.
    applyScopedNavigation({project,folder,projectIds:[id],autoTemporal:true});
  };
  const toggleProjectInFilter = (id) => setFilters((f) => {
    const cur = getProjectFilterIds(f);
    const next = cur.includes(id) ? cur.filter((x) => x !== id) : [...cur, id];
    return { ...f, advanced: setProjectFilterIds(f, next) };
  });
  // Sous-dossiers illimités (#217) : sélectionner un dossier inclut aussi ses
  // sous-dossiers, à toute profondeur — sinon un dossier « parent » vide de
  // projets directs semblerait ne rien contenir.
  const selectProjectFolder = (folderId) => {
    const subtree = folderSubtreeIds(projectFolders, folderId);
    setFilters((f) => ({ ...f, advanced: setProjectFilterIds(f, projects.filter((p) => subtree.includes(p.folderId)).map((p) => p.id)) }));
  };
  const selectProjectFolderAndNavigate = (folderId) => {
    const folder=projectFolders.find((f)=>f.id===folderId);
    const subtree = folderSubtreeIds(projectFolders, folderId);
    const ids=projects.filter((p)=>subtree.includes(p.folderId)).map((p)=>p.id);
    if (!folder) { selectProjectFolder(folderId); return; }
    applyScopedNavigation({folder,projectIds:ids});
  };
  const activeProjectIds = getProjectFilterIds(filters);
  const activeTitle = activeProjectIds.length === 1 ? projectById[activeProjectIds[0]]?.name : "Tous les projets";
  const fCount = activeFilterCount(filters);
  const metaFilterCount = activeFilterCount(metaFilters);
  GLOBAL_MILESTONE_STYLE = appearance.milestoneStyle || "flag";
  GLOBAL_MILESTONE_URL = appearance.milestoneCustomUrl || "";

  // L’interface apparaît directement après le premier écran de chargement statique/animé.


  // Une écriture MCP déjà fusionnée ne mérite pas le même traitement qu'un
  // vrai conflit : on sépare ici les deux populations, le rendu plus bas ne
  // fait que les afficher.
  const { assistant: mcpSyncKeys, conflicts: remoteConflictKeys } =
    splitRemoteChanges(remoteChangeDetected, NEXORA_MERGEABLE_KEYS);

  // Keep every recovery banner above, rather than over, the workspace controls.
  useLayoutEffect(() => {
    const app = document.querySelector(".lp-app");
    const banner = app?.querySelector(":scope > .lp-sync-blocked-banner");
    if (!app || !banner) return;
    const reserve = () => { app.style.paddingTop = banner.getBoundingClientRect().height + "px"; };
    const observer = new ResizeObserver(reserve); observer.observe(banner); reserve();
    return () => { observer.disconnect(); app.style.paddingTop = ""; };
  }, [syncBlocked, rescueRecovery, blockedKeys, remoteChangeDetected]);

  // ---- Rendu récursif des dossiers (sidebar) — sous-dossiers illimités (#217) ----
  // Un dossier peut désormais contenir des sous-dossiers, à toute profondeur ;
  // ces deux fonctions remplacent le simple .map() plat qui n'affichait qu'un
  // seul niveau. Chaque dossier garde son propre état de pli/dépli, et les
  // sous-dossiers s'affichent sous les projets/tableaux directs du dossier,
  // indentés d'un cran supplémentaire par niveau.
  const renderProjectFolderNode = (folder, depth) => {
    const folderProjects = projects.filter((p) => p.folderId === folder.id);
    const childFolders = folderChildren(projectFolders, folder.id);
    // Replié par défaut — sauf le dossier contenant le projet actuellement
    // sélectionné (à toute profondeur), qui reste visible sans action
    // supplémentaire. Un dossier explicitement déplié/replié garde son choix.
    const subtreeIds = folderSubtreeIds(projectFolders, folder.id);
    const folderCollapsed = collapsedProjFolders[folder.id] !== undefined
      ? collapsedProjFolders[folder.id]
      : !projects.some((p) => subtreeIds.includes(p.folderId) && activeProjectIds.includes(p.id));
    return (
      <div key={folder.id}>
        <div
          className="lp-folder-item"
          style={{ paddingLeft: depth * 14 }}
          onClick={() => selectProjectFolderAndNavigate(folder.id)}
          onContextMenu={(e) => { e.preventDefault(); setQuickEditProjectFolder(folder); }}
          {...longPress(() => setQuickEditProjectFolder(folder))}
          onDragOver={(e) => e.preventDefault()}
          onDrop={(e) => { const id = e.dataTransfer.getData("application/x-nexora-project"); if (id) setProjects((prev) => prev.map((p) => (p.id === id ? { ...p, folderId: folder.id } : p))); }}
        >
          <button type="button" aria-label={"Afficher les projets de " + folder.name} aria-expanded={!folderCollapsed} className="lp-group-toggle" onClick={(e) => { e.stopPropagation(); setCollapsedProjFolders((c) => ({ ...c, [folder.id]: !folderCollapsed })); }}>
            {folderCollapsed ? <ChevronRight size={13} /> : <ChevronDown size={13} />}
          </button>
          <span className="lp-folder-dot" style={{ background: folder.color || "var(--text-muted)" }}><Layers size={11} color="#fff" /></span>
          <button type="button" className="lp-project-name" onClick={e => { e.stopPropagation(); selectProjectFolderAndNavigate(folder.id); }}>{folder.name}</button>
          <span className="lp-project-count">{folderProjects.length}</span>
        </div>
        {!folderCollapsed && folderProjects.map((p) => (
          <div
            key={p.id}
            className={"lp-project-item" + (activeProjectIds.includes(p.id) ? " active" : "")}
            style={{ paddingLeft: 28 + depth * 14 }}
            onClick={(e) => (e.ctrlKey || e.metaKey) ? toggleProjectInFilter(p.id) : selectProjectAndNavigate(p.id)}
            onContextMenu={(e) => openQuickContextMenu(e, "project", p)}
            {...longPress((e) => openQuickContextMenu(e, "project", p))}
            onDragOver={(e) => e.preventDefault()}
            onDrop={(e) => { e.stopPropagation(); const id = e.dataTransfer.getData("application/x-nexora-project"); if (id && id !== p.id) setProjects((prev) => reorderArray(prev, id, p.id)); }}
            title="Clic : sélectionner uniquement ce projet · Ctrl/Cmd+clic : ajouter/retirer du filtre"
          >
            <span className="lp-drag-handle" draggable onMouseDown={(e) => e.stopPropagation()} onDragStart={(e) => { e.stopPropagation(); e.dataTransfer.setData("application/x-nexora-project", p.id); }} onClick={(e) => e.stopPropagation()} title="Glisser pour déplacer"><GripVertical size={12} /></span>
            <div className="lp-project-dot" style={{ background: p.color }}><IconGlyph icon={p.icon} size={13} /></div>
            <button type="button" className="lp-project-name" aria-pressed={activeProjectIds.includes(p.id)} onClick={e => { e.stopPropagation(); (e.ctrlKey || e.metaKey) ? toggleProjectInFilter(p.id) : selectProjectAndNavigate(p.id); }}>{p.name}</button>
            <span className="lp-project-count">{tasks.filter((t) => t.projectId === p.id && !isTaskDoneGlobal(t, ctx)).length}</span>
            <button className="lp-icon-btn lp-project-row-action" draggable={false} style={{ color: "#a9b4c9" }} onMouseDown={(e) => e.stopPropagation()} onClick={(e) => { e.stopPropagation(); openNewTask({ projectId: p.id }); }} title="Ajouter une tâche à ce projet"><Plus size={12} /></button><button className="lp-icon-btn lp-project-row-action" draggable={false} style={{ color: "#a9b4c9" }} onMouseDown={(e) => e.stopPropagation()} onClick={(e) => { e.stopPropagation(); requestDeleteProject(p); }} title="Supprimer le projet"><Trash2 size={12} /></button>
          </div>
        ))}
        {!folderCollapsed && childFolders.map((child) => renderProjectFolderNode(child, depth + 1))}
      </div>
    );
  };
  const renderDashboardFolderNode = (folder, depth) => {
    const folderDashboards = dashboards.filter((d) => d.folderId === folder.id);
    const childFolders = folderChildren(dashboardFolders, folder.id);
    const subtreeIds = folderSubtreeIds(dashboardFolders, folder.id);
    const folderCollapsed = collapsedDashboardFolders[folder.id] !== undefined
      ? collapsedDashboardFolders[folder.id]
      : !dashboards.some((d) => subtreeIds.includes(d.folderId) && d.id === activeDashboardId);
    return (
      <div key={folder.id}>
        <div
          className="lp-folder-item"
          style={{ paddingLeft: depth * 14 }}
          onClick={() => setCollapsedDashboardFolders((c) => ({ ...c, [folder.id]: !folderCollapsed }))}
          onContextMenu={(e) => { e.preventDefault(); setQuickEditDashboardFolder(folder); }}
          {...longPress(() => setQuickEditDashboardFolder(folder))}
          onDragOver={(e) => e.preventDefault()}
          onDrop={(e) => { const id = e.dataTransfer.getData("application/x-nexora-dashboard"); if (id) setDashboards((prev) => prev.map((d) => (d.id === id ? { ...d, folderId: folder.id } : d))); }}
        >
          {folderCollapsed ? <ChevronRight size={13} /> : <ChevronDown size={13} />}
          <Layers size={13} color={folder.color || undefined} />
          <button type="button" className="lp-project-name" aria-expanded={!folderCollapsed} onClick={e => { e.stopPropagation(); setCollapsedDashboardFolders(c => ({...c,[folder.id]:!c[folder.id]})); }}>{folder.name}</button>
          <span className="lp-project-count">{folderDashboards.length}</span>
        </div>
        {!folderCollapsed && folderDashboards.map((d) => (
          <div
            key={d.id} className={"lp-project-item" + (view === "dashboard" && activeDashboardId === d.id ? " active" : "")} style={{ paddingLeft: 28 + depth * 14 }}
            onClick={() => { setActiveDashboardId(d.id); setView("dashboard"); }}
            onContextMenu={(e) => openQuickContextMenu(e, "dashboard", d)}
            {...longPress((e) => openQuickContextMenu(e, "dashboard", d))}
            onDragOver={(e) => e.preventDefault()}
            onDrop={(e) => { e.stopPropagation(); const id = e.dataTransfer.getData("application/x-nexora-dashboard"); if (id && id !== d.id) setDashboards((prev) => reorderArray(prev, id, d.id)); }}
          >
            <span className="lp-drag-handle" draggable onMouseDown={(e) => e.stopPropagation()} onDragStart={(e) => { e.stopPropagation(); e.dataTransfer.setData("application/x-nexora-dashboard", d.id); }} onClick={(e) => e.stopPropagation()} title="Glisser pour déplacer"><GripVertical size={12} /></span>
            <div className="lp-project-dot lp-dashboard-transparent-icon" style={{ background: "transparent" }}>{d.icon ? <IconGlyph icon={d.icon} size={13} /> : "📊"}</div>
            <button type="button" className="lp-project-name" aria-pressed={view === "dashboard" && activeDashboardId === d.id} onClick={e => { e.stopPropagation(); setActiveDashboardId(d.id); setView("dashboard"); }}>{d.name}</button>
            <button className="lp-icon-btn lp-project-row-action" draggable={false} style={{ marginLeft: "auto", color: "#a9b4c9" }} onMouseDown={(e) => e.stopPropagation()} onClick={(e) => { e.stopPropagation(); duplicateDashboard(d.id); }} title="Dupliquer"><Copy size={12} /></button>
            <button className="lp-icon-btn lp-project-row-action" draggable={false} style={{ marginLeft: 0, color: "#a9b4c9" }} onMouseDown={(e) => e.stopPropagation()} onClick={(e) => { e.stopPropagation(); deleteDashboard(d.id); }} title="Supprimer"><X size={12} /></button>
          </div>
        ))}
        {!folderCollapsed && childFolders.map((child) => renderDashboardFolderNode(child, depth + 1))}
      </div>
    );
  };

  return (
    <div
      className={"lp-app lp-density-" + (appearance.density || "comfortable") + " lp-anim-cards-on"}
      style={{
        "--accent": appearance.accentColor || "#FF7A3D",
        "--radius": RADIUS_SCALES[appearance.radiusStyle || "sharp"].base,
        "--radius-lg": RADIUS_SCALES[appearance.radiusStyle || "sharp"].lg,
        "--radius-sm": RADIUS_SCALES[appearance.radiusStyle || "sharp"].sm,
      }}
    >
      {!startupVisualReady && (
        <div
          id="boot-screen"
          aria-label="Chargement de Nexora"
          style={{
            position:"fixed",
            inset:0,
            zIndex:999999,
            width:"100vw",
            height:"100vh",
          }}
        >
          <div id="boot-logo-stage">
            <img src={NEXORA_ICON} alt="Nexora" />
          </div>
          <p>{syncBlocked ? "Chargement partiel…" : "Chargement..."}</p>
          {syncBlocked && (
            <div style={{
              width:"min(620px,86vw)",
              margin:"12px auto 0",
              padding:"9px 11px",
              border:"1px solid #fecaca",
              borderRadius:8,
              background:"#fff7f7",
              color:"#991b1b",
              fontSize:10.5,
              lineHeight:1.4,
              textAlign:"left"
            }}>
              {syncBlocked}
            </div>
          )}
          <div id="boot-metro-loader" aria-hidden="true">
            <span className="boot-stop s1"></span>
            <span className="boot-stop s2"></span>
            <span className="boot-stop s3"></span>
            <span className="boot-train"></span>
          </div>
        </div>
      )}
      {appearance.exportHeaderEnabled !== false && (
        <div className="lp-print-header">
          <img src={appearance.logoDataUrl || NEXORA_ICON} alt="" className="lp-print-header-logo" />
          <div className="lp-print-header-text">
            <div className="lp-print-header-title">{appearance.exportHeaderTitle?.trim() || "Nexora"}</div>
            <div className="lp-print-header-sub">
              {ALL_VIEWS_META.find((v) => v.key === view)?.label || view}
              {" · "}
              {new Date().toLocaleDateString("fr-FR", { day: "numeric", month: "long", year: "numeric" })}
            </div>
          </div>
        </div>
      )}
      {syncBlocked && (
        <div className="lp-sync-blocked-banner">
          <AlertTriangle size={16} />
          <div className="lp-sync-message" role="alert">
            <strong>Les données n’ont pas pu être chargées.</strong>
            <p>L’enregistrement est suspendu pour protéger vos données. Rechargez la page avant de modifier votre travail.</p>
            <details className="lp-sync-blocked-detail"><summary>Détails techniques</summary><p>{syncBlocked}</p></details>
          </div>
          <button className="lp-btn lp-btn-primary" onClick={() => window.location.reload()}>Recharger la page</button>
        </div>
      )}
      {!syncBlocked && rescueRecovery && (
        <div className="lp-sync-blocked-banner" style={{background:"var(--accent, #2563eb)"}}>
          <AlertTriangle size={16} />
          <span>
            <strong>Modifications non synchronisées retrouvées</strong> — la session précédente s'est arrêtée avant confirmation de {rescueRecovery.entries.length > 1 ? `${rescueRecovery.entries.length} sauvegardes` : "une sauvegarde"}. Rien n'est perdu : envoyer maintenant vers Firebase ?
            <span className="lp-sync-blocked-detail"> ({rescueRecovery.entries.map((e)=>e.key).join(", ")})</span>
          </span>
          <button className="lp-btn lp-btn-primary" disabled={rescueRecovery.busy} onClick={() => resolveRescueRecovery("send")}>
            {rescueRecovery.busy ? "Envoi…" : "Récupérer et envoyer"}
          </button>
          <button className="lp-btn" disabled={rescueRecovery.busy} onClick={() => resolveRescueRecovery("discard")}>Ignorer</button>
        </div>
      )}
      {!syncBlocked && !rescueRecovery && Object.keys(blockedKeys).length > 0 && (
        <div className="lp-sync-blocked-banner">
          <AlertTriangle size={16} />
          <span>
            <strong>{Object.keys(blockedKeys).length > 1 ? `${Object.keys(blockedKeys).length} données` : "Une donnée"} en attente de synchronisation</strong> — {blockedKeysReason(blockedKeys)} Le reste de l'application continue de se sauvegarder normalement ; ces éléments précis seront retentés automatiquement au prochain changement.
            <span className="lp-sync-blocked-detail"> ({Object.keys(blockedKeys).join(", ")})</span>
          </span>
          <button className="lp-btn lp-btn-primary" onClick={() => {
            setRescueRecovery({ entries: scanRescueEntries().filter((e)=>blockedKeys[e.key]), busy:false });
          }}>Retenter maintenant</button>
        </div>
      )}
      {!syncBlocked && !rescueRecovery && remoteConflictKeys.length > 0 && (
        <div className="lp-sync-blocked-banner" style={{background:"var(--accent, #2563eb)"}}>
          <RefreshCw size={16} />
          <span>
            <strong>Une autre session a enregistré des changements</strong> — {remoteConflictKeys.map((k)=>remoteChangeLabel(k, remoteChangeDetected[k])).join(", ")}. Tes propres modifications ne seront pas perdues (fusion automatique), mais recharge pour voir tout de suite ce qui a changé ailleurs.
          </span>
          <button className="lp-btn lp-btn-primary" disabled={firebaseRefreshing} onClick={refreshFromFirebase}>
            {firebaseRefreshing ? "Rechargement…" : "Recharger"}
          </button>
          <button className="lp-btn" onClick={() => setRemoteChangeDetected({})}>Continuer sans recharger</button>
        </div>
      )}
      {/* L'assistant vient d'écrire une clé fusionnable : la fusion est
          automatique et sans perte, l'onglet est probablement le seul ouvert.
          Une pastille suffit — et elle disparaît d'elle-même dès que la valeur
          distante est adoptée. */}
      {!syncBlocked && !rescueRecovery && mcpSyncKeys.length > 0 && (
        <button
          type="button"
          className="lp-mcp-sync-pill"
          aria-live="polite"
          disabled={firebaseRefreshing}
          title={`Écriture de l'assistant MCP sur : ${mcpSyncKeys.map((k)=>k.replace("nexora:","")).join(", ")}. Clique pour recharger maintenant.`}
          onClick={refreshFromFirebase}
        >
          <RefreshCw size={13} />
          {firebaseRefreshing ? "Rechargement…" : "Synchro MCP…"}
        </button>
      )}


      {/* Bandeau des vues enregistrées — invisible si aucune vue n'existe (pas de
          colonne vide pour ceux qui n'en ont pas). Replié à une fine bande
          discrète sur le bord droit ; le survol le déploie en une vraie ligne de
          métro verticale, avec une station par vue (icône choisie par
          l'utilisateur uniquement — pas de repli générique — et infobulle native
          au survol de chaque station). */}
      <div className="lp-saved-views-rail" title={savedViews.length ? "Vues enregistrées" : "Aucune vue enregistrée"}>
        <div className="lp-saved-views-rail-inner">
          <div className="lp-saved-views-line" />
          {savedViews.length > 0 ? savedViews.map((v) => (
            <button
              key={v.id}
              className="lp-saved-views-station"
              title={v.name}
              onClick={() => applySavedView(v)}
              onContextMenu={(e) => openQuickContextMenu(e, "view", v)}
              {...longPress((e) => openQuickContextMenu(e, "view", v))}
            >
              {v.icon ? <IconGlyph icon={v.icon} size={16} /> : <Star size={13} />}
            </button>
          )) : (
            <div className="lp-saved-views-station lp-saved-views-station-empty" title="Aucune vue enregistrée">
              <Star size={13} />
            </div>
          )}
        </div>
      </div>

      {contextMenu && (
        <QuickContextMenu
          x={contextMenu.x}
          y={contextMenu.y}
          onClose={() => setContextMenu(null)}
          items={[
            {
              label: "Modifier",
              icon: <Pencil size={13} />,
              onClick: () => {
                if (contextMenu.type === "project") setQuickEditProject(contextMenu.item);
                else if (contextMenu.type === "view") setQuickEditView(contextMenu.item);
                else if (contextMenu.type === "dashboard") setQuickEditDashboard(contextMenu.item);
                else if (contextMenu.type === "task") openEditTask(contextMenu.item);
                setContextMenu(null);
              },
            },
            // Le bandeau des vues enregistrées n'a pas son propre concept de
            // "favoris" (contrairement aux projets/tableaux de bord, affichés dans
            // le bandeau gauche) — ce serait une option sans effet visible.
            (contextMenu.type !== "view" || isFavorite("view",contextMenu.item.id)) && {
              label: isFavorite(contextMenu.type, contextMenu.item.id) ? "Retirer des favoris" : "Ajouter aux favoris",
              icon: <Star size={13} />,
              onClick: () => { toggleFavorite(contextMenu.type, contextMenu.item.id); setContextMenu(null); },
            },
            contextMenu.type === "dashboard" && {
              label: "Dupliquer",
              icon: <Copy size={13} />,
              onClick: () => {
                duplicateDashboard(contextMenu.item.id);
                setContextMenu(null);
              },
            },
            {
              label: "Supprimer",
              icon: <Trash2 size={13} />,
              danger: true,
              onClick: () => {
                if (contextMenu.type === "project") requestDeleteProject(contextMenu.item);
                else if (contextMenu.type === "view") deleteSavedView(contextMenu.item.id);
                else if (contextMenu.type === "dashboard") deleteDashboard(contextMenu.item.id);
                else if (contextMenu.type === "task") requestDeleteTask(contextMenu.item);
                setContextMenu(null);
              },
            },
          ].filter(Boolean)}
        />
      )}

      {/* Choix d'un template à la création (#183, retour de test) : clic droit
          sur un bouton d'ajout — sans effet si aucun template n'existe
          (openAddTaskMenu ouvre alors directement le formulaire). */}
      {addTaskMenu && (
        <QuickContextMenu
          x={addTaskMenu.x}
          y={addTaskMenu.y}
          onClose={() => setAddTaskMenu(null)}
          items={[
            ...taskTemplates.map((tpl) => ({
              label: tpl.name || "Sans nom",
              icon: <FileText size={13} />,
              onClick: () => { openNewTaskFromTemplate(tpl, addTaskMenu.seed); setAddTaskMenu(null); },
            })),
            {
              label: "Sans template",
              icon: <Plus size={13} />,
              onClick: () => { openNewTask(addTaskMenu.seed); setAddTaskMenu(null); },
            },
          ]}
        />
      )}

      {/* ---------------- Sidebar ---------------- */}
      {/* Scrim mobile : n'existe visuellement que sous 768px (voir CSS) — sur
          desktop/tablette le tiroir latéral classique n'a pas besoin d'un
          calque de fermeture au clic. */}
      {!sidebarCollapsed && <div className="lp-sidebar-scrim" onClick={() => setSidebarCollapsed(true)} />}
      <aside ref={sidebarRef} className={"lp-sidebar" + (!sidebarCollapsed ? " lp-sidebar-open" : "")} style={{ width: sidebarCollapsed ? 0 : sidebarWidth, flex: `0 0 ${sidebarCollapsed ? 0 : sidebarWidth}px`, overflow: sidebarCollapsed ? "hidden" : "auto", padding: sidebarCollapsed ? 0 : undefined }}>
        <button type="button" className="lp-sidebar-mobile-close" onClick={() => setSidebarCollapsed(true)} aria-label="Fermer le menu" title="Fermer"><X size={18} /></button>
        <div className="lp-logo">
          <img src={NEXORA_LOGO_FULL} alt="Nexora" style={{ width: 140, height: "auto", maxHeight: 32, objectFit: "contain" }} />
        </div>
        <div className="lp-create-row">
          <button type="button" className="lp-btn lp-btn-primary" onClick={() => openNewTask({})} onContextMenu={(e) => openAddTaskMenu(e, {})} title="Clic droit : choisir un template"><Plus size={15} /> Nouvelle tâche</button>
          <details className="lp-create-menu" onKeyDown={e => { if (e.key === "Escape") { e.currentTarget.open = false; e.currentTarget.querySelector("summary").focus(); } }}>
            <summary>Créer</summary>
            <div className="lp-create-options" onClick={e => { if(e.target.closest("button")){const menu=e.currentTarget.closest("details");menu.open=false;menu.querySelector("summary").focus();} }}>
              <button type="button" onClick={() => setQuickEditProject({ __new: true })}><FolderPlus size={15} /> Projet</button>
              <button type="button" onClick={() => setNewDashboardOpen(true)}><LayoutDashboard size={15} /> Tableau de bord</button>
              <button type="button" onClick={() => setProjectFoldersOpen(true)}><Folder size={15} /> Dossier de projets</button>
              <button type="button" onClick={() => setDashboardFoldersOpen(true)}><Layers size={15} /> Dossier de tableaux</button>
            </div>
          </details>
        </div>
        <button type="button" aria-expanded={sidebarOpen.projects} className="lp-side-label lp-side-label-toggle" onClick={() => setSidebarOpen((s) => ({ ...s, projects: !s.projects }))}>
          Projets {sidebarOpen.projects ? <ChevronDown size={12} /> : <ChevronRight size={12} />}
        </button>
        {!dataLoaded && (
          <div style={{ padding: "2px 8px" }}>
            {[0, 1, 2].map((i) => (
              <div key={i} style={{ display: "flex", alignItems: "center", gap: 8, padding: "8px 0" }}>
                <div className="lp-skeleton" style={{ width: 18, height: 18, borderRadius: 6, flex: "0 0 auto" }} />
                <div className="lp-skeleton" style={{ height: 11, width: `${60 - i * 12}%`, borderRadius: 6 }} />
              </div>
            ))}
          </div>
        )}
        {sidebarOpen.projects && (
          <>
            <button type="button" aria-pressed={activeProjectIds.length === 0}
              className={"lp-project-item" + (activeProjectIds.length === 0 ? " active" : "")}
              onClick={() => selectOnlyProject(null)}
              onDragOver={(e) => e.preventDefault()}
              onDrop={(e) => { const id = e.dataTransfer.getData("application/x-nexora-project"); if (id) setProjects((prev) => prev.map((p) => (p.id === id ? { ...p, folderId: null } : p))); }}
            >
              <div className="lp-project-dot" style={{ background: "#334155" }}>∗</div>
              Tous les projets
              <span className="lp-project-count">{tasks.length}</span>
            </button>
            {folderChildren(projectFolders, null).map((folder) => renderProjectFolderNode(folder, 0))}
            {projects.filter((p) => !p.folderId || !projectFolders.some((f) => f.id === p.folderId)).map((p) => (
              <div
                key={p.id}
                className={"lp-project-item" + (activeProjectIds.includes(p.id) ? " active" : "")}
                onClick={(e) => (e.ctrlKey || e.metaKey) ? toggleProjectInFilter(p.id) : selectProjectAndNavigate(p.id)}
                onContextMenu={(e) => openQuickContextMenu(e, "project", p)}
                {...longPress((e) => openQuickContextMenu(e, "project", p))}
                onDragOver={(e) => e.preventDefault()}
                onDrop={(e) => { e.stopPropagation(); const id = e.dataTransfer.getData("application/x-nexora-project"); if (id && id !== p.id) setProjects((prev) => reorderArray(prev, id, p.id)); }}
                title="Clic : sélectionner uniquement ce projet · Ctrl/Cmd+clic : ajouter/retirer du filtre"
              >
                <span className="lp-drag-handle" draggable onMouseDown={(e) => e.stopPropagation()} onDragStart={(e) => { e.stopPropagation(); e.dataTransfer.setData("application/x-nexora-project", p.id); }} onClick={(e) => e.stopPropagation()} title="Glisser pour déplacer"><GripVertical size={12} /></span>
                <div className="lp-project-dot" style={{ background: p.color }}><IconGlyph icon={p.icon} size={13} /></div>
                <button type="button" className="lp-project-name" aria-pressed={activeProjectIds.includes(p.id)} onClick={e => { e.stopPropagation(); (e.ctrlKey || e.metaKey) ? toggleProjectInFilter(p.id) : selectProjectAndNavigate(p.id); }}>{p.name}</button>
                <span className="lp-project-count">{tasks.filter((t) => t.projectId === p.id && !isTaskDoneGlobal(t, ctx)).length}</span>
                <button className="lp-icon-btn lp-project-row-action" draggable={false} style={{ color: "#a9b4c9" }} onMouseDown={(e) => e.stopPropagation()} onClick={(e) => { e.stopPropagation(); openNewTask({ projectId: p.id }); }} title="Ajouter une tâche à ce projet"><Plus size={12} /></button><button className="lp-icon-btn lp-project-row-action" draggable={false} style={{ color: "#a9b4c9" }} onMouseDown={(e) => e.stopPropagation()} onClick={(e) => { e.stopPropagation(); requestDeleteProject(p); }} title="Supprimer le projet"><Trash2 size={12} /></button>
              </div>
            ))}
          </>
        )}


        <button type="button" aria-expanded={sidebarOpen.dashboards} className="lp-side-label lp-side-label-toggle" onClick={() => setSidebarOpen((s) => ({ ...s, dashboards: !s.dashboards }))}>
          Tableaux de bord {sidebarOpen.dashboards ? <ChevronDown size={12} /> : <ChevronRight size={12} />}
        </button>
        {sidebarOpen.dashboards && (
          <>
            {folderChildren(dashboardFolders, null).map((folder) => renderDashboardFolderNode(folder, 0))}
            <div
              className="lp-folder-drop-zone"
              onDragOver={(e) => { if (dashboardFolders.length) e.preventDefault(); }}
              onDrop={(e) => { const id = e.dataTransfer.getData("application/x-nexora-dashboard"); if (id) setDashboards((prev) => prev.map((d) => (d.id === id ? { ...d, folderId: null } : d))); }}
            >
              {dashboards.filter((d) => !d.folderId).map((d) => (
                <div
                  key={d.id} className={"lp-project-item" + (view === "dashboard" && activeDashboardId === d.id ? " active" : "")}
                  onClick={() => { setActiveDashboardId(d.id); setView("dashboard"); }}
                  onContextMenu={(e) => openQuickContextMenu(e, "dashboard", d)}
                  {...longPress((e) => openQuickContextMenu(e, "dashboard", d))}
                  onDragOver={(e) => e.preventDefault()}
                  onDrop={(e) => { e.stopPropagation(); const id = e.dataTransfer.getData("application/x-nexora-dashboard"); if (id && id !== d.id) setDashboards((prev) => reorderArray(prev, id, d.id)); }}
                >
                  <span className="lp-drag-handle" draggable onMouseDown={(e) => e.stopPropagation()} onDragStart={(e) => { e.stopPropagation(); e.dataTransfer.setData("application/x-nexora-dashboard", d.id); }} onClick={(e) => e.stopPropagation()} title="Glisser pour déplacer"><GripVertical size={12} /></span>
                  <div className="lp-project-dot lp-dashboard-transparent-icon" style={{ background: "transparent" }}>{d.icon ? <IconGlyph icon={d.icon} size={13} /> : "📊"}</div>
                  <button type="button" className="lp-project-name" aria-pressed={view === "dashboard" && activeDashboardId === d.id} onClick={e => { e.stopPropagation(); setActiveDashboardId(d.id); setView("dashboard"); }}>{d.name}</button>
                  <button className="lp-icon-btn lp-project-row-action" draggable={false} style={{ marginLeft: "auto", color: "#a9b4c9" }} onMouseDown={(e) => e.stopPropagation()} onClick={(e) => { e.stopPropagation(); duplicateDashboard(d.id); }} title="Dupliquer"><Copy size={12} /></button>
                  <button className="lp-icon-btn lp-project-row-action" draggable={false} style={{ marginLeft: 0, color: "#a9b4c9" }} onMouseDown={(e) => e.stopPropagation()} onClick={(e) => { e.stopPropagation(); deleteDashboard(d.id); }} title="Supprimer"><X size={12} /></button>
                </div>
              ))}
            </div>
          </>
        )}


        <div className="lp-sidebar-footer">
          {/* Même langage que la rangée de création en haut : trois icônes
              accolées, pas trois liens texte pleine largeur. */}
          <div className="lp-create-row" style={{ margin: "0 0 4px" }}>
            <button className="lp-create-icon-btn" onClick={() => setReadmeOpen(true)} title="Guide de démarrage"><BookOpen size={15} /></button>
            {/* #143 : l'import Google Calendar est exécuté par le MCP
                (import_google_calendar_events), plus par un bouton de sync
                manuelle ici — voir le bandeau de fraîcheur dans Réglages >
                Google Calendar (GcalSettingsManager). */}
            <button className="lp-create-icon-btn" onClick={() => { setSettingsTab("project"); setSettingsOpen(true); }} title="Réglages"><Settings size={15} /></button>
          </div>
          {currentUser && (
            <div className="lp-account-row">
              <span className="lp-account-email" title={currentUser.email}>{currentUser.email}</span>
              <button className="lp-icon-btn" onClick={onSignOut} title="Se déconnecter"><X size={13} /></button>
            </div>
          )}
        </div>
      </aside>
      <div
        className={"lp-sidebar-resize-wrap" + (sidebarCollapsed ? " lp-sidebar-resize-wrap-collapsed" : "")}
        onMouseDown={sidebarCollapsed ? undefined : startSidebarResize}
        onDoubleClick={sidebarCollapsed ? undefined : fitSidebarWidth}
        title={sidebarCollapsed ? undefined : "Glisser pour redimensionner · double-clic pour ajuster au contenu"}
      >
        <button
          className="lp-sidebar-collapse-btn"
          onClick={(e) => { e.stopPropagation(); setSidebarCollapsed((c) => !c); }}
          title={sidebarCollapsed ? "Afficher le menu" : "Réduire le menu"}
        >
          {sidebarCollapsed ? "›" : "‹"}
        </button>
        {!sidebarCollapsed && <div className="lp-sidebar-resize-handle" />}
      </div>

      {/* ---------------- Main ---------------- */}
      <main className="lp-main">
        <div className="lp-topbar">
          <div className="lp-topbar-title-group">
            {view === "dashboard" ? (
              // Pas de sous-titre ici : le nom de la page active est déjà porté par
              // l'onglet en surbrillance juste à côté (dashboardTabsSlot), l'afficher
              // deux fois ne fait que grignoter la largeur.
              <h2 className="lp-display">{activeDashboard?.icon && <IconGlyph icon={activeDashboard.icon} size={18} />} {activeDashboard?.name || "Tableau de bord"}</h2>
            ) : (
              <>
                <h2 className="lp-display">{activeTitle}</h2>
                <span className={"lp-topbar-sub" + (fCount > 0 ? " lp-topbar-sub-filtered" : "")}>{filteredTasks.length}{fCount > 0 ? ` · ${fCount} filtre${fCount > 1 ? "s" : ""} actif${fCount > 1 ? "s" : ""}` : ""}</span>
              </>
            )}
          </div>
          {(view === "dashboard" || view === "today") && (
            <div className="lp-topbar-dashboard-tabs-slot" ref={setDashboardTabsSlot} />
          )}
          <div style={{ marginLeft: "auto" }}>
          <DropdownButton
            label="Accès rapide"
            icon={<Grid3x3 size={13} />}
            title="Vues et favoris accessibles en un clic"
          >
            <div className="lp-dropdown-group-label">Vues</div>
            {QUICK_ACCESS_VIEW_KEYS.filter((key) => enabledViews[key] !== false).map((key) => {
              const meta = ALL_VIEWS_META.find((v) => v.key === key);
              if (!meta) return null;
              const isActive = PROJECT_TAB_VIEW_KEYS.includes(view) ? key === "projects" : view === key;
              return (
                <button
                  key={key}
                  type="button"
                  className={"lp-quick-access-item" + (isActive ? " active" : "")}
                  onClick={() => setView(key)}
                >
                  <IconGlyph icon={appearance.viewIcons?.[meta.key] || meta.iconKey} size={14} />
                  {meta.label}
                  {key === "notifications" && unreadNotificationsCount > 0 && (
                    <span className="lp-filter-badge" style={{ background: "var(--danger)", color: "#fff" }}>{unreadNotificationsCount > 9 ? "9+" : unreadNotificationsCount}</span>
                  )}
                </button>
              );
            })}
            {favorites.length > 0 && (
              <>
                <div className="lp-dropdown-group-label">Favoris</div>
                {favorites.map((f) => {
                  if (f.type === "project") {
                    const p = projects.find((x) => x.id === f.id);
                    if (!p) return null;
                    return (
                      <button key={f.type + f.id} type="button" className="lp-quick-access-item" onClick={() => selectProjectAndNavigate(p.id)}>
                        <IconGlyph icon={p.icon} size={14} /> {p.name}
                      </button>
                    );
                  }
                  if (f.type === "view") {
                    const v = savedViews.find((x) => x.id === f.id);
                    if (!v) return null;
                    return (
                      <button key={f.type + f.id} type="button" className="lp-quick-access-item" onClick={() => applySavedView(v)}>
                        {v.icon ? <IconGlyph icon={v.icon} size={14} /> : <Star size={13} />} {v.name}
                      </button>
                    );
                  }
                  if (f.type === "dashboard") {
                    const d = dashboards.find((x) => x.id === f.id);
                    if (!d) return null;
                    return (
                      <button key={f.type + f.id} type="button" className="lp-quick-access-item" onClick={() => { setView("dashboard"); setActiveDashboardId(d.id); }}>
                        {d.icon ? <IconGlyph icon={d.icon} size={14} /> : <LayoutDashboard size={13} />} {d.name}
                      </button>
                    );
                  }
                  if (f.type === "task") {
                    const t = tasks.find((x) => x.id === f.id);
                    if (!t) return null;
                    return (
                      <button key={f.type + f.id} type="button" className="lp-quick-access-item" onClick={() => openEditTask(t)}>
                        {t.milestone
                          ? <MilestoneTypeGlyph types={ctx.milestoneTypes} type={t.milestoneTypeId} icon={resolveMilestoneIcon(t, ctx)} size={14} />
                          : (t.milestoneIcon ? <IconGlyph icon={t.milestoneIcon} size={14} /> : <List size={13} />)}
                        {t.title || "Tâche"}
                      </button>
                    );
                  }
                  return null;
                })}
              </>
            )}
          </DropdownButton>
          </div>
          <button
            type="button"
            className={"lp-filter-btn" + (metaFilterCount > 0 ? " lp-filter-btn-active" : "")}
            onClick={() => { setSettingsTab("meta"); setSettingsOpen(true); }}
            title="Méta-filtres : socle global appliqué partout dans Nexora"
            style={{ marginLeft: 6, marginRight: 6 }}
          >
            <Filter size={13} />
            Méta
            {metaFilterCount > 0 && <span className="lp-filter-badge">{metaFilterCount}</span>}
          </button>
          {/* Filtre textuel des surfaces « tableau de bord » (issue #72).
              Il ne s'ajoute pas au champ de recherche des autres vues : il le
              REMPLACE là où celui-ci était masqué, faute de pouvoir filtrer
              quoi que ce soit. La barre du haut porte donc toujours un champ de
              recherche, quelle que soit la vue. */}
          {["dashboard", "today"].includes(view) && (
            <div className="lp-search-wrap lp-board-search-wrap">
              <span className="lp-search-icon">⌕</span>
              <input
                type="text"
                className="lp-search-input"
                placeholder="Nom ou description…"
                value={boardSearch}
                onChange={(e) => setBoardSearch(e.target.value)}
                aria-label="Filtrer les tâches sur leur nom ou leur description"
              />
              {boardSearch && (
                <button className="lp-search-clear" onClick={() => setBoardSearch("")} title="Effacer le filtre"><X size={13} /></button>
              )}
            </div>
          )}
          {["dashboard", "today"].includes(view) && boardSearchActive && (
            /* Sans ce compte, un filtre qui ne ramène rien donne des widgets
               vides sans qu'on sache si c'est la recherche ou les données. */
            <span className={"lp-board-search-count" + (boardTasks.length === 0 ? " is-empty" : "")}>
              {boardTasks.length === 0 ? "Aucune tâche" : `${boardTasks.length} tâche${boardTasks.length > 1 ? "s" : ""}`}
            </span>
          )}
          {!["dashboard", "today"].includes(view) && (
          <>
          <div className="lp-search-wrap">
            <span className="lp-search-icon">⌕</span>
            <input
              type="text"
              className="lp-search-input"
              placeholder="…"
              value={filters.search}
              ref={searchInputRef}
              onChange={(e) => setFilters((f) => ({ ...f, search: e.target.value }))}
            />
            {filters.search && (
              <button className="lp-search-clear" onClick={() => setFilters((f) => ({ ...f, search: "" }))} title="Effacer la recherche"><X size={13} /></button>
            )}
          </div>
          <button
            className={"lp-urgent-toggle-btn" + (filters.showDone !== false ? " active" : "")}
            onClick={() => setFilters((f) => ({ ...f, showDone: f.showDone === false }))}
            title="Montrer les tâches terminées"
          >
            <CheckCircle2 size={13} />
          </button>
          <button
            className={"lp-urgent-toggle-btn" + (filters.urgentOnly ? " active" : "")}
            onClick={() => setFilters((f) => ({ ...f, urgentOnly: !f.urgentOnly }))}
            title="N'afficher que les tâches de criticité urgente"
          >
            <AlertTriangle size={13} />
          </button>
          <button className={"lp-filter-btn" + (fCount > 0 ? " lp-filter-btn-active" : "")} onClick={() => setFiltersOpen(true)} title="Filtres">
            <SlidersHorizontal size={14} /> {fCount > 0 && <span className="lp-filter-badge">{fCount}</span>}
          </button>
          <DropdownButton label="" icon={<CalendarClock size={14} />} title={filters.quickDatePreset ? `Échéance : ${DATE_FILTER_PRESETS.find((p) => p.key === filters.quickDatePreset)?.label}` : "Filtre rapide par échéance"}>
            <label className="lp-checkbox-line"><input type="radio" name="lp-quickdate" checked={!filters.quickDatePreset} onChange={() => setFilters((f) => ({ ...f, quickDatePreset: "" }))} /> Aucun</label>
            <label className="lp-checkbox-line"><input type="radio" name="lp-quickdate" checked={filters.quickDatePreset === "before_today"} onChange={() => setFilters((f) => ({ ...f, quickDatePreset: "before_today" }))} /> En retard (avant aujourd'hui)</label>
            {DATE_FILTER_PRESETS.filter((p) => p.key !== "before_today" && p.key !== "after_today").map((p) => (
              <label className="lp-checkbox-line" key={p.key}><input type="radio" name="lp-quickdate" checked={filters.quickDatePreset === p.key} onChange={() => setFilters((f) => ({ ...f, quickDatePreset: p.key }))} /> {p.label}</label>
            ))}
          </DropdownButton>
          {fCount > 0 && (
            <button
              className="lp-filter-btn"
              onClick={() => setFilters(defaultFilters())}
              title="Réinitialiser tous les filtres"
            >
              <X size={14} />
            </button>
          )}
          <DropdownButton label="" icon={<RefreshCw size={14} style={{ transform: "rotate(90deg)" }} />} title="Trier les tâches">
            {[
              ["none", "Ordre manuel"],
              ["title", "Titre"],
              ["start", "Date de début"],
              ["end", "Date de fin"],
              ["progress", "Avancement"],
              ["project", "Projet"],
              ["status", "Statut"],
              ["assignee", "Responsable"],
              ["inactivity", "Durée d’inactivité"],
              ["criticality", "Criticité"],
              ["dependsOn", "Nombre de dépendances"],
              ["referenceEnd", "Référence"],
              ["delta", "Écart à la référence"],
              ["delayRisks", "Nombre de risques"],
            ].map(([key, label]) => (
              <label className="lp-checkbox-line" key={key}>
                <input type="radio" name="lp-sort-field" checked={taskSort.field === key} onChange={() => { setTaskSort((s) => ({ ...s, field: key })); }} />
                {label}
              </label>
            ))}
            {taskSort.field !== "none" && (
              <>
                <hr className="lp-divider" style={{ margin: "6px 0" }} />
                <label className="lp-checkbox-line"><input type="radio" name="lp-sort-dir" checked={taskSort.dir === "asc"} onChange={() => setTaskSort((s) => ({ ...s, dir: "asc" }))} /> Croissant</label>
                <label className="lp-checkbox-line"><input type="radio" name="lp-sort-dir" checked={taskSort.dir === "desc"} onChange={() => setTaskSort((s) => ({ ...s, dir: "desc" }))} /> Décroissant</label>
              </>
            )}
          </DropdownButton>
          </>
          )}
          <div className="lp-sync-status" title={syncStatus.state === "error" ? syncStatus.error : undefined}>
            {syncStatus.state === "saving" && <span className="lp-sync-saving"><span className="lp-sync-dot" /></span>}
            {syncStatus.state === "saved" && <span className="lp-sync-saved"><Check size={12} /></span>}
            {syncStatus.state === "error" && <span className="lp-sync-error"><AlertTriangle size={12} /></span>}
          </div>
          <button
            type="button"
            className={"lp-tool-btn lp-save-now" + (saveNowState === "saving" ? " active" : "") + (saveNowState === "error" ? " lp-save-now-error" : "")}
            onClick={saveNow}
            disabled={saveNowState === "saving"}
            title="Forcer l'enregistrement immédiat de toutes les modifications en attente"
          >
            {saveNowState === "saving" && <RefreshCw size={14} className="lp-refresh-spin" />}
            {saveNowState === "done" && <Check size={14} />}
            {saveNowState === "error" && <AlertTriangle size={14} />}
            {saveNowState === "idle" && <Save size={14} />}
            <span className="lp-firebase-refresh-label">
              {saveNowState === "saving" ? "Enregistrement…" : saveNowState === "done" ? "Enregistré" : saveNowState === "error" ? "Incomplet" : "Enregistrer"}
            </span>
          </button>
          <button
            type="button"
            className={"lp-tool-btn lp-firebase-refresh" + (firebaseRefreshing ? " active" : "")}
            onClick={refreshFromFirebase}
            disabled={firebaseRefreshing}
            title="Synchroniser maintenant depuis Firebase sans recharger Nexora"
          >
            <RefreshCw size={14} className={firebaseRefreshing ? "lp-refresh-spin" : ""} />
            <span className="lp-firebase-refresh-label">Firebase</span>
          </button>
          <div className="lp-view-toolbar-slot" ref={setViewToolbarSlot} />
          <button className="lp-tool-btn" onClick={() => { setSettingsTab("views"); setSettingsOpen(true); }} title="Réglages"><Settings size={14} /></button>
          <button className="lp-tool-btn" onClick={() => window.print()} title="Exporter la vue actuelle en PDF (impression du navigateur)"><FileUp size={14} /></button>
        </div>

        <div className="lp-content">
          {PROJECT_TAB_VIEW_KEYS.includes(view) && (
            <div className="lp-detail-tabbar">
              {PROJECT_TAB_VIEW_KEYS.filter((k) => enabledViews[k] !== false).map((k) => {
                const meta = ALL_VIEWS_META.find((v) => v.key === k);
                return (
                  <button key={k} ref={(el) => { detailTabRefs.current[k] = el; }} className={"lp-detail-tab" + (view === k ? " active" : "")} onClick={() => setView(k)}>
                    <IconGlyph icon={appearance.viewIcons?.[meta.key] || meta.iconKey} size={14} /> {meta.label}
                  </button>
                );
              })}
              {tabIndicator && (
                <div className="lp-anim-tab-indicator" style={{ left: tabIndicator.left, width: tabIndicator.width }} />
              )}
              <div className="lp-detail-tab-spacer" />
              <DropdownButton label="Filtres enregistrés" icon={<Bookmark size={13} />} title="Vues enregistrées pour ce type d'affichage">
                {savedViews.filter((v) => v.view === view).length === 0 && (
                  <p style={{ fontSize: 12, color: "var(--text-600)", margin: "2px 4px 8px", maxWidth: 200 }}>Aucun filtre enregistré pour cette vue.</p>
                )}
                {savedViews.filter((v) => v.view === view).map((v) => (
                  <button key={v.id} type="button" className="lp-dropdown-action-row" onClick={() => applySavedView(v)} onContextMenu={(e) => openQuickContextMenu(e, "view", v)} {...longPress((e) => openQuickContextMenu(e, "view", v))}>
                    {v.icon ? <IconGlyph icon={v.icon} size={13} /> : <Bookmark size={13} />} {v.name}
                  </button>
                ))}
                <hr className="lp-divider" style={{ margin: "6px 0" }} />
                <button type="button" className="lp-dropdown-action-row" onClick={() => setSaveViewOpen(true)}><Plus size={13} /> Enregistrer les filtres actuels</button>
              </DropdownButton>
            </div>
          )}
          {view === "gantt" && <MiniGanttView tasks={filteredTasks} ctx={ctx} onOpen={openEditTask} setTasks={setTasks} prefs={viewPrefs.gantt} setPrefs={setGanttPrefs} metaBlocks={allMetaTemporalBlocks} toolbarSlot={viewToolbarSlot} pushToast={pushToast} taskBaselines={taskBaselines} />}
          {view === "heatmap" && <HeatmapView tasks={filteredTasks} ctx={ctx} onOpen={openEditTask} toolbarSlot={viewToolbarSlot} appearance={appearance} />}
          {view === "timeline" && <TimelineView tasks={filteredTasks} ctx={ctx} onOpen={openEditTask} prefs={viewPrefs.timeline} setPrefs={setTimelinePrefs} gradient={appearance.gradient} progressColorByStatus={appearance.progressColorByStatus} setTasks={setTasks} onAdd={openNewTask} onDelete={requestDeleteTask} onMarkDone={markTaskDone} onCycleStatus={cycleStatus} onBulkDelete={requestBulkDelete} onFreezeReference={requestFreezeReference} listPrefs={viewPrefs.list} setListPrefs={setListPrefs} toolbarSlot={viewToolbarSlot} />}
          {view === "radar" && <RadarView tasks={filteredTasks} ctx={ctx} onOpen={openEditTask} appearance={appearance} prefs={viewPrefs.radar} setPrefs={setRadarPrefs} toolbarSlot={viewToolbarSlot} />}
          {view === "today" && <DashboardView onOpenProject={selectProjectAndNavigate} onEditProject={setQuickEditProject} metaTemporalBlocks={allMetaTemporalBlocks} dashboardId={null} boardId={TODAY_BOARD_ID} tasksBeforeSearch={metaFilteredTasks} transferBoards={widgetTransferBoards} onTransferWidget={transferWidget} tasks={todayPresentationTasks} ctx={ctx} widgets={todayActivePage?.widgets || []} setWidgets={setActiveTodayWidgets} onOpen={openEditTask} toolbarSlot={viewToolbarSlot} tabsSlot={dashboardTabsSlot} expenses={expenses} expenseCategories={expenseCategories} financeProQuotes={quotes} financeProBillingSchedule={proBillingSchedule} financeProPayments={proPayments} financeProMissions={proMissions} financeProClients={quoteClients} dashboardName="Aujourd'hui" appearance={appearance} onViewDay={() => setView("today")} activityLog={activityLog} myName={myName} pages={todayPages} activePageId={todayActivePageId} onSwitchPage={switchTodayPage} onAddPage={addTodayPage} onRenamePage={renameTodayPage} onDeletePage={deleteTodayPage} onDuplicatePage={duplicateTodayPage} onUpdatePageFilter={updateTodayPageFilter} onUpdatePageMeta={updateTodayPageMeta} taskBaselines={taskBaselines} setTasks={setTasks} setTaskArchive={setTaskArchive} pushToast={pushToast} shortcutPrefs={shortcutPrefs} staffing={staffing} setStaffing={setStaffing} setWorkshops={setWorkshops} setTeamMembers={setTeamMembers} setTeams={setTeams} setTeamFolders={setTeamFolders} habitLog={habitLog} setHabitLog={setHabitLog} onOpenGanttView={(filter) => { setGanttPrefs({ filter }); setView("gantt"); }} onOpenMetaFilters={() => { setSettingsTab("meta"); setSettingsOpen(true); }} onOpenHabitThemes={() => { setSettingsTab("habitThemes"); setSettingsOpen(true); }} onOpenTeamsSettings={() => { setSettingsTab("peopleTeams"); setSettingsOpen(true); }} onMarkDone={markTaskDone} onStartTask={startTask} />}
          {view === "table" && <TableView tasks={filteredTasks} ctx={ctx} setTasks={setTasks} onOpen={openEditTask} onAdd={openNewTask} onDelete={requestDeleteTask} onBulkDelete={requestBulkDelete} toolbarSlot={viewToolbarSlot} prefs={viewPrefs.table} setPrefs={setTablePrefs} taskBaselines={taskBaselines} />}
          {view === "notifications" && <NotificationsView notifications={notifications} setNotifications={setNotifications} toolbarSlot={viewToolbarSlot} />}
          {view === "quotes" && <QuotesView quotes={quotes} clients={quoteClients} settings={quoteSettings} setSettings={setQuoteSettings} catalog={quoteCatalog} skills={quoteSkills} onSaveCatalogEntry={saveCatalogEntry} onDeleteCatalogEntry={deleteCatalogEntry} onSaveSkill={saveSkill} onDeleteSkill={deleteSkill} onSaveQuote={saveQuote} onDuplicateQuote={duplicateQuote} onDeleteQuote={deleteQuote} onSetStatus={setQuoteStatus} onAddClient={addQuoteClient} onSaveClient={saveQuoteClient} onDeleteClient={deleteQuoteClient} onFacturer={facturerQuote} toolbarSlot={viewToolbarSlot} />}
          {view === "invoices" && <InvoicesView invoices={invoices} quotes={quotes} clients={quoteClients} settings={quoteSettings} setSettings={setQuoteSettings} catalog={quoteCatalog} skills={quoteSkills} onSaveCatalogEntry={saveCatalogEntry} onDeleteCatalogEntry={deleteCatalogEntry} onSaveSkill={saveSkill} onDeleteSkill={deleteSkill} onSaveInvoice={saveInvoice} onDuplicateInvoice={duplicateInvoice} onSetStatus={setInvoiceStatus} onCreateCreditNote={createCreditNote} onAddClient={addQuoteClient} autoOpenId={pendingOpenInvoiceId} onAutoOpened={() => setPendingOpenInvoiceId(null)} toolbarSlot={viewToolbarSlot} />}
          {view === "financePro" && <FinanceProView
            projects={projects} quoteClients={quoteClients} quotes={quotes}
            proMissions={proMissions} setProMissions={setProMissions}
            proTimeEntries={proTimeEntries} setProTimeEntries={setProTimeEntries}
            proExpenseCategories={proExpenseCategories} setProExpenseCategories={setProExpenseCategories}
            proExpenses={proExpenses} setProExpenses={setProExpenses}
            proBillingSchedule={proBillingSchedule} setProBillingSchedule={setProBillingSchedule}
            proPayments={proPayments} setProPayments={setProPayments}
            financeProSettings={financeProSettings} setFinanceProSettings={setFinanceProSettings}
            proObligations={proObligations} setProObligations={setProObligations}
            toolbarSlot={viewToolbarSlot}
          />}
          {view === "cockpit" && <CockpitView tasks={metaFilteredTasks} ctx={ctx} onOpen={openEditTask} toolbarSlot={viewToolbarSlot} onOpenWeek={() => setView("weekFlow")} />}
          {view === "weekFlow" && <WeekFlowView tasks={metaFilteredTasks} ctx={ctx} onOpen={openEditTask} toolbarSlot={viewToolbarSlot} />}

          {view === "projects" && <ProjectMetroView metaTemporalBlocks={allMetaTemporalBlocks} tasks={filteredTasks} ctx={ctx} onOpen={openEditTask} toolbarSlot={viewToolbarSlot} appearance={appearance} prefs={viewPrefs.projects} setPrefs={setProjectsPrefs} setTasks={setTasks} setTaskArchive={setTaskArchive} pushToast={pushToast} expenses={expenses} isHomepage={activeProjectIds.length === 0} onSelectProject={selectProjectAndNavigate} selectedProjectIds={activeProjectIds} onToggleProject={toggleProjectInFilter} />}
          {view === "dashboard" && <DashboardView onOpenProject={selectProjectAndNavigate} onEditProject={setQuickEditProject} metaTemporalBlocks={allMetaTemporalBlocks} dashboardId={activeDashboard?.id || null} boardId={activeDashboard?.id || null} tasksBeforeSearch={metaFilteredTasks} transferBoards={widgetTransferBoards} onTransferWidget={transferWidget} tasks={boardTasks} ctx={ctx} widgets={activePage?.widgets || []} setWidgets={setActiveDashboardWidgets} onOpen={openEditTask} toolbarSlot={viewToolbarSlot} tabsSlot={dashboardTabsSlot} expenses={expenses} expenseCategories={expenseCategories} financeProQuotes={quotes} financeProBillingSchedule={proBillingSchedule} financeProPayments={proPayments} financeProMissions={proMissions} financeProClients={quoteClients} dashboardName={activeDashboard?.name} dashboardProjectFilter={activeDashboard?.projectFilter || []} onUpdateDashboardProjectFilter={(ids) => setDashboardProjectFilter(activeDashboard.id, ids)} appearance={appearance} onViewDay={() => setView("today")} activityLog={activityLog} myName={myName} pages={pages} activePageId={activePageId} onSwitchPage={switchDashboardPage} onAddPage={addDashboardPage} onRenamePage={renameDashboardPage} onDeletePage={deleteDashboardPage} onDuplicatePage={duplicateDashboardPage} onUpdatePageFilter={updateDashboardPageFilter} onUpdatePageMeta={updateDashboardPageMeta} taskBaselines={taskBaselines} setTasks={setTasks} setTaskArchive={setTaskArchive} pushToast={pushToast} shortcutPrefs={shortcutPrefs} staffing={staffing} setStaffing={setStaffing} setWorkshops={setWorkshops} setTeamMembers={setTeamMembers} setTeams={setTeams} setTeamFolders={setTeamFolders} habitLog={habitLog} setHabitLog={setHabitLog} onOpenGanttView={(filter) => { setGanttPrefs({ filter }); setView("gantt"); }} onOpenMetaFilters={() => { setSettingsTab("meta"); setSettingsOpen(true); }} onOpenHabitThemes={() => { setSettingsTab("habitThemes"); setSettingsOpen(true); }} onOpenTeamsSettings={() => { setSettingsTab("peopleTeams"); setSettingsOpen(true); }} onMarkDone={markTaskDone} onStartTask={startTask} />}
        </div>
      </main>

      {taskModal !== null && (
        <TaskModal task={taskModal} defaults={taskModalDefaults} projects={projects} dashboards={dashboards || []} statuses={statuses} taskTypes={taskTypes} tasks={tasks} teamMembers={teamMembers} setTeamMembers={setTeamMembers} gradient={appearance.gradient} progressColorByStatus={appearance.progressColorByStatus} shortcutPrefs={shortcutPrefs} onClose={() => setTaskModal(null)} onSave={saveTask} onDelete={requestDeleteTask} onMarkDone={markTaskDone} onCycleStatus={cycleStatus} onOpenImpactLine={setImpactLineTaskId} isFavoriteTask={!!taskModal?.id && isFavorite("task",taskModal.id)} onToggleFavoriteTask={(id)=>toggleFavorite("task",id)} onOpenRelatedTask={(t) => { setTaskModalDefaults(null); setTaskModal(t); }} taskBaselines={taskBaselines} milestoneTypes={milestoneTypes} activityLog={activityLog} />
      )}
      {impactLineTaskId && (
        <ImpactLineModal
          taskId={impactLineTaskId}
          tasks={tasks}
          ctx={ctx}
          onClose={() => setImpactLineTaskId(null)}
          onOpenTask={(t) => { setImpactLineTaskId(null); openEditTask(t); }}
        />
      )}
      {quoteToProjectPrompt && (
        <Modal
          title="Créer un projet à partir de ce devis ?"
          onClose={() => setQuoteToProjectPrompt(null)}
          footer={
            <>
              <button className="lp-btn" onClick={() => setQuoteToProjectPrompt(null)}>Ignorer</button>
              <button className="lp-btn lp-btn-primary" onClick={() => createProjectFromQuote(quoteToProjectPrompt)}>Créer le projet</button>
            </>
          }
        >
          <p style={{ fontSize: 13, color: "var(--text-600)", lineHeight: 1.5, margin: 0 }}>
            Le devis <strong>{quoteToProjectPrompt.number}</strong> vient de passer en « Accepté ». Créer un nouveau
            projet pré-rempli à partir de ce devis, avec une tâche par ligne ? Cette création n'est jamais automatique —
            rien n'est créé tant que tu ne l'as pas validé.
          </p>
        </Modal>
      )}
      {settingsOpen && (
        <SettingsModal
          activeTab={settingsTab}
          setActiveTab={setSettingsTab}
          onClose={() => setSettingsOpen(false)}
          gcalSyncState={gcalSyncState}
          projects={projects} setProjects={setProjects} projectFolders={projectFolders} setProjectFolders={setProjectFolders} tasks={tasks} setTasks={setTasks}
          onDeleteProject={requestDeleteProject} onBulkDelete={requestBulkDelete}
          palette={PROJECT_PALETTES[appearance.projectPalette] || PROJECT_PALETTES.default}
          statuses={statuses} setStatuses={setStatuses}
          milestoneTypes={milestoneTypes} setMilestoneTypes={setMilestoneTypes}
          workshops={workshops} setWorkshops={setWorkshops} staffing={staffing} setStaffing={setStaffing} setWorkshops={setWorkshops}
          teams={teams} setTeams={setTeams} teamFolders={teamFolders} setTeamFolders={setTeamFolders}
          habitThemes={habitThemes} setHabitThemes={setHabitThemes} habitLog={habitLog} setHabitLog={setHabitLog}
          taskDefaults={taskDefaults} setTaskDefaults={setTaskDefaults}
          taskTemplates={taskTemplates} setTaskTemplates={setTaskTemplates}
          tas