}
.nexora-icon-editor-panel-v16 .nexora-icon-footer .nexora-icon-save-bottom{
  display:inline-flex!important;visibility:visible!important;opacity:1!important;
  min-width:130px!important;height:38px!important;padding:0 18px!important;
  align-items:center!important;justify-content:center!important;
  background:var(--nexora-icon-accent,#FF7A3D)!important;
  border:1px solid var(--nexora-icon-accent,#FF7A3D)!important;
  color:#fff!important;font-weight:800!important;border-radius:9px!important;
