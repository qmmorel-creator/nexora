@media(max-width:760px){
  .nexora-icon-editor-panel-v16 .nexora-icon-editor-head{grid-template-columns:minmax(0,1fr)!important;}
  .nexora-icon-style-filter{min-width:112px!important;}
  .nexora-icon-editor-panel-v16 .nexora-icon-editor-grid{grid-template-rows:repeat(8,40px)!important;grid-auto-flow:column!important;grid-auto-columns:40px!important;gap:5px!important;padding:8px!important;}
