.nexora-icon-style-filter{
  height:40px!important;min-width:132px!important;padding:0 30px 0 11px!important;
  border:1px solid #cfd6e2!important;border-radius:7px!important;background:var(--surface,#fff)!important;
  color:var(--text-900,#0B1526)!important;font-size:12px!important;font-weight:700!important;
  cursor:pointer!important;outline:none!important;
}
.nexora-icon-style-filter:focus{border-color:var(--accent)!important;box-shadow:0 0 0 3px color-mix(in srgb,var(--accent) 12%,transparent)!important;}
.nexora-icon-editor-panel-v16 .nexora-icon-editor-count{font-size:9px!important;white-space:nowrap!important;}
.nexora-icon-editor-panel-v16 .nexora-icon-editor-grid{
  display:grid!important;
  grid-template-rows:repeat(12,48px)!important;
  grid-auto-columns:48px!important;
  grid-auto-flow:column!important;
  grid-template-columns:none!important;
  width:max-content!important;min-width:100%!important;
  height:100%!important;
  gap:8px!important;padding:10px 34px 10px 14px!important;box-sizing:border-box!important;
  overflow-x:auto!important;overflow-y:hidden!important;
  overscroll-behavior-y:none!important;
  scrollbar-width:thin!important;
  scrollbar-color:color-mix(in srgb,var(--accent) 60%,#cbd5e1) transparent!important;
}
.nexora-icon-editor-panel-v16 .nexora-icon-editor-grid::-webkit-scrollbar{height:7px!important;width:0!important;}
.nexora-icon-editor-panel-v16 .nexora-icon-editor-grid::-webkit-scrollbar-track{background:transparent!important;}
.nexora-icon-editor-panel-v16 .nexora-icon-editor-grid::-webkit-scrollbar-thumb{background:color-mix(in srgb,var(--accent) 60%,#cbd5e1)!important;border-radius:99px!important;}
.nexora-icon-editor-panel-v16 .nexora-icon-option{
  width:46px!important;height:46px!important;min-height:46px!important;padding:0!important;
  border:1px solid transparent!important;border-radius:8px!important;
  background:transparent!important;color:#64748b!important;
  display:flex!important;align-items:center!important;justify-content:center!important;
  transition:transform .14s cubic-bezier(.2,.8,.2,1),background .14s ease,border-color .14s ease,box-shadow .14s ease!important;
}
.nexora-icon-editor-panel-v16 .nexora-icon-option svg{width:20px!important;height:20px!important;transition:transform .14s cubic-bezier(.2,.8,.2,1)!important;}
.nexora-icon-editor-panel-v16 .nexora-icon-option:hover{
  transform:scale(1.16)!important;z-index:5!important;
  background:color-mix(in srgb,var(--accent) 9%,white)!important;
  border-color:color-mix(in srgb,var(--accent) 45%,#e3e6ec)!important;
  box-shadow:0 6px 16px rgba(15,23,42,.10)!important;
}
.nexora-icon-editor-panel-v16 .nexora-icon-option:hover svg{transform:scale(1.28)!important;}
.nexora-icon-editor-panel-v16 .nexora-icon-option.active{
  transform:none!important;background:var(--accent)!important;border-color:var(--accent)!important;color:#fff!important;
  box-shadow:0 0 0 2px color-mix(in srgb,var(--accent) 20%,transparent),0 5px 12px color-mix(in srgb,var(--accent) 18%,transparent)!important;
}
.nexora-icon-editor-panel-v16 .nexora-icon-option.active:hover{transform:scale(1.10)!important;}
.nexora-icon-editor-panel-v16 .nexora-icon-option span,.nexora-icon-editor-panel-v16 .nexora-icon-option small{display:none!important;}
.nexora-icon-editor-panel-v16 .nexora-icon-footer{
