:root[data-nexora-theme] .lp-ptx-band-card.is-done { background-color: var(--nx-rm-1u); }
:root[data-nexora-theme] .lp-ptx-band-title { color: var(--nx-rm-1v); }
:root[data-nexora-theme] .lp-ptx-band-progress { background-color: var(--nx-rm-1w); }
:root[data-nexora-theme] .lp-ptx-cap-row.is-current span { color: var(--nx-rm-1r); }
:root[data-nexora-theme] .lp-ptx-closure-bar span { background-color: var(--nx-rm-1x); }
:root[data-nexora-theme] .lp-ptx-closure-card { border-top-color: var(--nx-rm-1p); border-right-color: var(--nx-rm-1p); border-bottom-color: var(--nx-rm-1p); border-left-color: var(--nx-rm-1p); }
:root[data-nexora-theme] .lp-ptx-closure-do { color: var(--nx-rm-1y); border-top-color: var(--nx-rm-1z); border-right-color: var(--nx-rm-1z); border-bottom-color: var(--nx-rm-1z); border-left-color: var(--nx-rm-1z); background-color: var(--nx-rm-1u); }
:root[data-nexora-theme] .lp-ptx-closure-next { color: var(--nx-rm-1r); border-top-color: var(--nx-rm-20); border-right-color: var(--nx-rm-20); border-bottom-color: var(--nx-rm-20); border-left-color: var(--nx-rm-20); background-color: var(--nx-rm-1o); }
