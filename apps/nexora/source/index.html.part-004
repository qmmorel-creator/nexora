:root[data-nexora-theme] #boot-screen { background-color: var(--nx-rm-0); }
:root[data-nexora-theme] #boot-screen p { color: var(--nx-rm-1); }
:root[data-nexora-theme] #boot-metro-loader::before { background-color: var(--nx-rm-2); }
:root[data-nexora-theme] #boot-metro-loader .boot-stop { background-color: var(--nx-rm-0); border-top-color: var(--nx-rm-3); border-right-color: var(--nx-rm-3); border-bottom-color: var(--nx-rm-3); border-left-color: var(--nx-rm-3); }
:root[data-nexora-theme] #boot-metro-loader .boot-train { background-color: var(--nx-rm-4); border-top-color: var(--nx-rm-5); border-right-color: var(--nx-rm-5); border-bottom-color: var(--nx-rm-5); border-left-color: var(--nx-rm-5); }
:root[data-nexora-theme] .lp-writing-mode-overlay { background-color: var(--nx-rm-6); }
:root[data-nexora-theme] .lp-writing-mode-shell { box-shadow: var(--nx-rm-7); }
:root[data-nexora-theme] .lp-writing-mode-textarea { box-shadow: var(--nx-rm-8); }
:root[data-nexora-theme] .lp-sidebar::-webkit-scrollbar-thumb { background-color: var(--nx-rm-9); }
:root[data-nexora-theme] .lp-sidebar::-webkit-scrollbar-thumb:hover { background-color: var(--nx-rm-a); }
:root[data-nexora-theme] .lp-sidebar-resize-handle { background-color: var(--nx-rm-b); }
:root[data-nexora-theme] .lp-side-btn { background-color: var(--nx-rm-c); }
:root[data-nexora-theme] .lp-create-icon-btn { background-color: var(--nx-rm-c); }
:root[data-nexora-theme] .lp-create-icon-btn:hover { background-color: var(--nx-rm-d); }
:root[data-nexora-theme] .lp-side-btn:hover { background-color: var(--nx-rm-d); }
:root[data-nexora-theme] .lp-folder-item:hover { background-color: var(--nx-rm-e); }
:root[data-nexora-theme] .lp-project-item:hover { background-color: var(--nx-rm-f); }
:root[data-nexora-theme] .lp-project-dot { box-shadow: var(--nx-rm-g); }
:root[data-nexora-theme] .lp-auth-card { box-shadow: var(--nx-rm-h); }
:root[data-nexora-theme] .lp-auth-submit { box-shadow: var(--nx-rm-i); }
:root[data-nexora-theme] .lp-auth-submit:hover:not(:disabled) { box-shadow: var(--nx-rm-j); }
:root[data-nexora-theme] .lp-hero-line-2 { stroke: var(--nx-rm-k); }
:root[data-nexora-theme] .lp-hero-line-3 { stroke: var(--nx-rm-l); }
:root[data-nexora-theme] .lp-hero-station { fill: var(--nx-rm-m); }
:root[data-nexora-theme] .lp-ghost-btn:hover { background-color: var(--nx-rm-e); }
:root[data-nexora-theme] .lp-tab-badge { border-top-color: var(--nx-rm-n); border-right-color: var(--nx-rm-n); border-bottom-color: var(--nx-rm-n); border-left-color: var(--nx-rm-n); }
:root[data-nexora-theme] .lp-urgent-toggle-btn:hover { background-color: var(--nx-rm-o); }
:root[data-nexora-theme] .lp-filter-btn-danger { border-top-color: var(--nx-rm-p); border-right-color: var(--nx-rm-p); border-bottom-color: var(--nx-rm-p); border-left-color: var(--nx-rm-p); }
:root[data-nexora-theme] .lp-filter-btn-danger:hover { background-color: var(--nx-rm-o); }
:root[data-nexora-theme] .lp-filter-badge { color: var(--nx-rm-q); }
:root[data-nexora-theme] .lp-filter-btn-active { color: var(--nx-rm-q); }
:root[data-nexora-theme] .lp-filter-btn-active .lp-filter-badge { background-color: var(--nx-rm-r); }
:root[data-nexora-theme] .lp-quick-context-menu { box-shadow: var(--nx-rm-s); }
:root[data-nexora-theme] .lp-quick-context-item-danger:hover { background-color: var(--nx-rm-t); }
:root[data-nexora-theme] .lp-dropdown-panel { box-shadow: var(--nx-rm-u); }
:root[data-nexora-theme] .lp-row:hover { background-color: var(--nx-rm-v); }
:root[data-nexora-theme] .lp-inline-edit-input { box-shadow: var(--nx-rm-w); }
:root[data-nexora-theme] .lp-chip-editable:hover { box-shadow: var(--nx-rm-x); }
:root[data-nexora-theme] input[type="range"].lp-gradient-slider::-webkit-slider-thumb { box-shadow: var(--nx-rm-y); }
:root[data-nexora-theme] .lp-card { box-shadow: var(--nx-rm-z); }
:root[data-nexora-theme] .lp-card:hover { border-top-color: var(--nx-rm-10); border-right-color: var(--nx-rm-10); border-bottom-color: var(--nx-rm-10); border-left-color: var(--nx-rm-10); }
:root[data-nexora-theme] .lp-progress-fill { box-shadow: var(--nx-rm-11); }
:root[data-nexora-theme] .lp-gantt-bar { border-top-color: var(--nx-rm-12); border-right-color: var(--nx-rm-12); border-bottom-color: var(--nx-rm-12); border-left-color: var(--nx-rm-12); }
:root[data-nexora-theme] .lp-gantt-metro-station { box-shadow: var(--nx-rm-13); }
:root[data-nexora-theme] .lp-gantt-bar-toggle { box-shadow: var(--nx-rm-14); }
:root[data-nexora-theme] .lp-gantt-done-badge { box-shadow: var(--nx-rm-13); }
:root[data-nexora-theme] .lp-gantt-group-milestone { border-top-color: var(--nx-rm-n); border-right-color: var(--nx-rm-n); border-bottom-color: var(--nx-rm-n); border-left-color: var(--nx-rm-n); box-shadow: var(--nx-rm-15); }
:root[data-nexora-theme] .lp-gantt-frame-label { box-shadow: var(--nx-rm-13); }
:root[data-nexora-theme] .lp-radar-tooltip { box-shadow: var(--nx-rm-16); }
:root[data-nexora-theme] .lp-pie-tooltip { box-shadow: var(--nx-rm-17); }
:root[data-nexora-theme] .lp-widget-card-dragging { box-shadow: var(--nx-rm-18); }
:root[data-nexora-theme] .lp-custom-card-warning { background-color: var(--nx-rm-19); color: var(--nx-rm-1a); }
:root[data-nexora-theme] .lp-task-detail-sticky-head { box-shadow: var(--nx-rm-1b); }
:root[data-nexora-theme] .lp-hpx-wire.is-na { stroke: var(--nx-rm-1c); }
:root[data-nexora-theme] .lp-hpx-px.is-done { box-shadow: var(--nx-rm-1d); }
:root[data-nexora-theme] .lp-hpx-px.is-done .lp-hpx-px-val { text-shadow: var(--nx-rm-1e); }
:root[data-nexora-theme] .lp-hpx-week-day.is-active { box-shadow: var(--nx-rm-1f); }
:root[data-nexora-theme] .lp-ptx-px.is-horizon .lp-ptx-ring-outline path { stroke: var(--nx-rm-1g); }
:root[data-nexora-theme] .lp-ptx-badge.is-late { color: var(--nx-rm-1h); background-color: var(--nx-rm-1i); }
:root[data-nexora-theme] .lp-ptx-badge.is-milestone { background-color: var(--nx-rm-1j); }
:root[data-nexora-theme] .lp-ptx-ok { color: var(--nx-rm-1k); }
:root[data-nexora-theme] .lp-ptx-late { color: var(--nx-rm-1h); }
:root[data-nexora-theme] .lp-ptx-pack.is-tinted { box-shadow: var(--nx-rm-1l); }
:root[data-nexora-theme] .lp-ptx-add { color: var(--nx-rm-1m); border-top-color: var(--nx-rm-1n); border-right-color: var(--nx-rm-1n); border-bottom-color: var(--nx-rm-1n); border-left-color: var(--nx-rm-1n); }
:root[data-nexora-theme] .lp-ptx-add:hover,
:root[data-nexora-theme] .lp-ptx-add.is-on { background-color: var(--nx-rm-1o); }
:root[data-nexora-theme] .lp-ptx-quickadd { border-top-color: var(--nx-rm-1p); border-right-color: var(--nx-rm-1p); border-bottom-color: var(--nx-rm-1p); border-left-color: var(--nx-rm-1p); box-shadow: var(--nx-rm-1q); }
:root[data-nexora-theme] .lp-hpx-side.is-drop,
:root[data-nexora-theme] .lp-hpx-week-day.is-drop { outline-color: var(--nx-rm-1p); background-color: var(--nx-rm-1o); }
:root[data-nexora-theme] .lp-ptx-drop-hint { color: var(--nx-rm-1m); }
:root[data-nexora-theme] .lp-ptx-menu .lp-quick-context-item.is-active { background-color: var(--nx-rm-1o); color: var(--nx-rm-1r); }
:root[data-nexora-theme] .lp-ptx-band-card { background-color: var(--nx-rm-1s); }
