  --c-signal-text: #9C3B26;
  --c-success: #4E7A45;
  --c-warning: #9A6A1C;
  --c-danger: #B5462E;
  --c-success-text: #46713d;
  --c-warning-text: #8e5e07;
  --c-danger-text: #b2432b;
