00; }
body[data-life-app="nexora"] #boot-screen { background: var(--life-bg); }
body[data-life-app="nexora"] #boot-screen p { font-family: var(--life-font); font-size: 13px; }

/* Keep the existing mobile drawers, grids and resize handles in charge. */
@media (max-width: 767px) {
  body[data-life-app="health"] .header { padding: 14px; gap: 14px; }
  body[data-life-app="health"] .header-title,
  body[data-life-app="budget"] .brand h1 { font-size: 21px; }
  body[data-life-app="health"] .tab-btn { min-height: 44px; padding: 10px 12px; }
  body[data-life-app="health"] .cq-widget { padding: 16px; }
  body[data-life-app="health"] .cq-body { min-width: 0; }
  body[data-life-app="health"] .cq-stat-row { grid-template-columns: 18px 86px minmax(12px,1fr) 44px 20px; gap: 5px; }
  body[data-life-app="health"] :is(.header-icon-btn, .reglages-save-btn) { min-height: 44px; }
  body[data-life-app="budget"] .brandbar { gap: 10px; padding-bottom: 10px; }
  body[data-life-app="budget"] .tab { min-height: 44px; }
}
@media (prefers-reduced-motion: reduce) {
  body[data-life-app] *, body[data-life-app] *::before, body[data-life-app] *::after {
    animation-duration: .01ms !important; animation-iteration-count: 1 !important;
    transition-duration: .01ms !important; scroll-behavior: auto !important;
  }
}

</style>
</body>
</html>
