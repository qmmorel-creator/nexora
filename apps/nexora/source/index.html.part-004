:root[data-nexora-theme="dessau"][data-nexora-mode="clair"],
:root[data-nexora-theme="dessau"][data-nexora-mode="clair"] body,
:root[data-nexora-theme="dessau"][data-nexora-mode="clair"] body[data-life-app],
:root[data-nexora-theme="dessau"][data-nexora-mode="clair"] body[data-life-app="nexora"] :is(.lp-theme, .lp-app),
:root[data-nexora-theme="dessau"][data-nexora-mode="clair"] :is(.lp-theme, .lp-app) {
  --c-bg: #ECE6DA;
  --c-surface: #FAF7F0;
  --c-soft: #F2EDE3;
  --c-border: #D5CBB8;
  --c-border-strong: #3A3631;
