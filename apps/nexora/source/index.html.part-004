:root[data-nexora-theme="bauhaus"][data-nexora-mode="sombre"],
:root[data-nexora-theme="bauhaus"][data-nexora-mode="sombre"] body,
:root[data-nexora-theme="bauhaus"][data-nexora-mode="sombre"] body[data-life-app],
:root[data-nexora-theme="bauhaus"][data-nexora-mode="sombre"] body[data-life-app="nexora"] :is(.lp-theme, .lp-app),
:root[data-nexora-theme="bauhaus"][data-nexora-mode="sombre"] :is(.lp-theme, .lp-app) {
  --c-bg: #16150F;
  --c-surface: #1F1E19;
  --c-soft: #2A2822;
  --c-border: #3D3A32;
  --c-border-strong: #E8E4DA;
  --c-text: #F0EDE6;
  --c-secondary: #C9C3B6;
  --c-muted: #A8A296;
  --c-accent: #F26A5D;
  --c-accent-hover: #F58579;
  --c-accent-soft: #3A3218;
  --c-on-accent: #141414;
  --c-accent-text: #F27B6F;
  --c-signal: #F26A5D;
  --c-signal-text: #F27B6F;
  --c-success: #6CC28A;
  --c-warning: #E0B45C;
  --c-danger: #F26A5D;
  --c-success-text: #6cc28a;
  --c-warning-text: #e0b45c;
  --c-danger-text: #f26a5d;
  --c-sidebar: #16150F;
  --c-sidebar-text: #F0EDE6;
  --c-sidebar-muted: #A8A296;
  --c-sidebar-active: #F0EDE6;
  --c-sidebar-active-text: #16150F;
  --c-sidebar-border: #E8E4DA;
  --c-tooltip: #2A2822;
  --c-shadow: none;
  --c-menu-shadow: 0 0 0 2px #E8E4DA, 6px 6px 0 2px #000000;
  --c-focus: #F5C242;
  --c-selection: #5A4A10;
  --c-font: 'Outfit', system-ui, sans-serif;
  --c-display: 'Outfit', system-ui, sans-serif;
  --c-mono: 'JetBrains Mono', ui-monospace, monospace;
  --c-label: 'Outfit', system-ui, sans-serif;
  --c-r-control: 0px;
  --c-r-card: 0px;
  --c-r-chip: 0px;
  --c-r-modal: 0px;
  --c-base: 14.5px;
  --life-font: var(--c-font);
  --life-mono: var(--c-mono);
  --life-bg: var(--c-bg);
  --life-surface: var(--c-surface);
  --life-soft: var(--c-soft);
  --life-border: var(--c-border);
  --life-border-strong: var(--c-border-strong);
  --life-text: var(--c-text);
  --life-secondary: var(--c-secondary);
  --life-muted: var(--c-muted);
  --life-blue: var(--c-accent);
  --life-blue-hover: var(--c-accent-hover);
  --life-blue-soft: var(--c-accent-soft);
  --life-card-radius: var(--c-r-card);
  --life-control-radius: var(--c-r-control);
  --life-shadow: var(--c-shadow);
  --life-menu-shadow: var(--c-menu-shadow);
  --bg: var(--c-bg);
  --surface: var(--c-surface);
  --surface-elevated: var(--c-surface);
  --border: var(--c-border);
  --border-strong: var(--c-border-strong);
  --text-primary: var(--c-text);
  --text-secondary: var(--c-secondary);
  --text-muted: var(--c-muted);
  --graphite: var(--c-secondary);
  --line-blue: var(--c-accent);
  --quai: var(--c-bg);
  --quai-clair: var(--c-soft);
  --quai-elevated: var(--c-accent-soft);
  --craie: var(--c-text);
  --brume: var(--c-muted);
  --rail: var(--c-secondary);
  --accent: var(--c-accent);
  --signal: var(--c-signal);
  --success: var(--c-success);
  --warning: var(--c-warning);
  --danger: var(--c-danger);
  --accent-text: var(--c-signal-text);
  --success-text: var(--c-success-text);
  --warning-text: var(--c-warning-text);
  --danger-text: var(--c-danger-text);
  --font-display: var(--c-display);
  --font-body: var(--c-font);
  --font-mono: var(--c-mono);
  --ink: var(--c-text);
  --ink-soft: var(--c-soft);
  --ink-hover: var(--c-accent-hover);
  --paper: var(--c-bg);
  --paper-soft: var(--c-soft);
  --blueprint: var(--c-secondary);
  --blueprint-line: color-mix(in srgb, var(--c-text) 10%, transparent);
  --text-900: var(--c-text);
  --text-600: var(--c-secondary);
  --radius: var(--c-r-card);
  --radius-sm: var(--c-r-control);
  --radius-lg: var(--c-r-card);
  --c-red: #F26A5D;
  --c-on-red: #141414;
  --c-yellow: #F5C242;
  --c-on-yellow: #141414;
  --c-blue: #2B5F9E;
  --c-on-blue: #FFFFFF;
  --c-frame: #E8E4DA;
}
