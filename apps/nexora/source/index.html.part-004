:root[data-nexora-theme] :is([style^="background: rgb(51, 65, 85)"], [style*="; background: rgb(51, 65, 85)"]):not(.lp-widget-treemap-tile) { background-color: var(--nx-rm-eo) !important; }
:root[data-nexora-theme] :is([style^="background: rgb(59, 111, 216)"], [style*="; background: rgb(59, 111, 216)"]):not(.lp-widget-treemap-tile) { background-color: var(--nx-rm-ep) !important; }
:root[data-nexora-theme] :is([style^="background: rgb(100, 116, 139)"], [style*="; background: rgb(100, 116, 139)"]):not(.lp-widget-treemap-tile) { background-color: var(--nx-rm-eq) !important; }
:root[data-nexora-theme] :is([style^="background: rgb(226, 72, 62)"], [style*="; background: rgb(226, 72, 62)"]):not(.lp-widget-treemap-tile) { background-color: var(--nx-rm-er) !important; }
:root[data-nexora-theme] :is([style^="background: rgba(100, 116, 139, 0.133)"], [style*="; background: rgba(100, 116, 139, 0.133)"]):not(.lp-widget-treemap-tile) { background-color: var(--nx-rm-es) !important; }
:root[data-nexora-theme] :is([style^="background: rgba(226, 72, 62, 0.133)"], [style*="; background: rgba(226, 72, 62, 0.133)"]):not(.lp-widget-treemap-tile) { background-color: var(--nx-rm-et) !important; }
:root[data-nexora-theme] :is([style^="background: rgba(79, 106, 245, 0.133)"], [style*="; background: rgba(79, 106, 245, 0.133)"]):not(.lp-widget-treemap-tile) { background-color: var(--nx-rm-eu) !important; }
:root[data-nexora-theme] :is([style^="background: rgb(79, 106, 245)"], [style*="; background: rgb(79, 106, 245)"]):not(.lp-widget-treemap-tile) { background-color: var(--nx-rm-ev) !important; }
:root[data-nexora-theme] :is([style^="background: rgb(44, 107, 224)"], [style*="; background: rgb(44, 107, 224)"]):not(.lp-widget-treemap-tile) { background-color: var(--nx-rm-ew) !important; }
:root[data-nexora-theme] :is([style^="background: rgb(122, 90, 248)"], [style*="; background: rgb(122, 90, 248)"]):not(.lp-widget-treemap-tile) { background-color: var(--nx-rm-ex) !important; }
:root[data-nexora-theme] :is([style^="background: rgb(255, 122, 61)"], [style*="; background: rgb(255, 122, 61)"]):not(.lp-widget-treemap-tile) { background-color: var(--nx-rm-ey) !important; }
:root[data-nexora-theme] :is([style^="background: rgb(31, 169, 113)"], [style*="; background: rgb(31, 169, 113)"]):not(.lp-widget-treemap-tile) { background-color: var(--nx-rm-ez) !important; }
:root[data-nexora-theme] :is([style^="background: rgb(226, 166, 59)"], [style*="; background: rgb(226, 166, 59)"]):not(.lp-widget-treemap-tile) { background-color: var(--nx-rm-f0) !important; }
:root[data-nexora-theme] :is([style^="background: rgb(122, 130, 144)"], [style*="; background: rgb(122, 130, 144)"]):not(.lp-widget-treemap-tile) { background-color: var(--nx-rm-f1) !important; }
:root[data-nexora-theme] :is([style^="background: rgb(225, 236, 235)"], [style*="; background: rgb(225, 236, 235)"]):not(.lp-widget-treemap-tile) { background-color: var(--nx-rm-f2) !important; }
:root[data-nexora-theme] :is([style^="background: rgb(246, 227, 184)"], [style*="; background: rgb(246, 227, 184)"]):not(.lp-widget-treemap-tile) { background-color: var(--nx-rm-f3) !important; }
:root[data-nexora-theme] :is([style^="border-color: rgb(100, 116, 139)"], [style*="; border-color: rgb(100, 116, 139)"]):not(.lp-widget-treemap-tile) { border-color: var(--nx-rm-f4) !important; }
:root[data-nexora-theme] :is([style^="border-color: rgb(226, 72, 62)"], [style*="; border-color: rgb(226, 72, 62)"]):not(.lp-widget-treemap-tile) { border-color: var(--nx-rm-f5) !important; }
:root[data-nexora-theme] .lp-dashboard-central-btn.active { background: var(--c-accent) !important; color: var(--c-on-accent) !important; border-color: var(--c-accent) !important; }
:root[data-nexora-theme] .lp-primary-btn { background: var(--c-accent) !important; color: var(--c-on-accent) !important; border-color: var(--c-accent) !important; }
:root[data-nexora-theme] .lp-primary-btn:hover { background: var(--c-accent) !important; color: var(--c-on-accent) !important; border-color: var(--c-accent) !important; }
:root[data-nexora-theme] .lp-tool-btn.active { background: var(--c-accent) !important; color: var(--c-on-accent) !important; border-color: var(--c-accent) !important; }
:root[data-nexora-theme] .lp-zoom-btn.active { background: var(--c-accent) !important; color: var(--c-on-accent) !important; border-color: var(--c-accent) !important; }
:root[data-nexora-theme] .lp-gantt-month { background: var(--nx-ink-fill) !important; color: var(--nx-ink-on) !important; }
:root[data-nexora-theme] .lp-gantt-weeks { background: var(--nx-ink-fill) !important; color: var(--nx-ink-on) !important; }
:root[data-nexora-theme] .lp-pie-tooltip { background: var(--nx-ink-fill) !important; color: var(--nx-ink-on) !important; }
:root[data-nexora-theme] .lp-task-detail-metro-today { background: var(--nx-ink-fill) !important; color: var(--nx-ink-on) !important; }
:root[data-nexora-theme] .lp-task-detail-metro-today::before { background: var(--nx-ink-fill) !important; color: var(--nx-ink-on) !important; }
:root[data-nexora-theme] .lp-habit-chip-kind.active { background: var(--c-accent) !important; color: var(--c-on-accent) !important; border-color: var(--c-accent) !important; }
:root[data-nexora-theme] .lp-widget-nba-scorebar-fill { background: var(--c-accent) !important; color: var(--c-on-accent) !important; border-color: var(--c-accent) !important; }
:root[data-nexora-theme] .lp-widget-domino-count { background: var(--c-accent) !important; color: var(--c-on-accent) !important; border-color: var(--c-accent) !important; }
:root[data-nexora-theme] .lp-widget-tm-bar-current { background: var(--c-accent) !important; color: var(--c-on-accent) !important; border-color: var(--c-accent) !important; }
:root[data-nexora-theme] .lp-pm-selection-bar { background: var(--c-accent) !important; color: var(--c-on-accent) !important; border-color: var(--c-accent) !important; }
:root[data-nexora-theme] .lp-table-bulkbar { background: var(--c-accent) !important; color: var(--c-on-accent) !important; border-color: var(--c-accent) !important; }
:root[data-nexora-theme] .lp-settings-nav-btn.active { background: var(--c-accent) !important; color: var(--c-on-accent) !important; border-color: var(--c-accent) !important; }
:root[data-nexora-theme] .lp-widget-type-card.active { background: var(--c-accent) !important; color: var(--c-on-accent) !important; border-color: var(--c-accent) !important; }
:root[data-nexora-theme] .lp-btn-primary { background: var(--c-accent) !important; color: var(--c-on-accent) !important; border-color: var(--c-accent) !important; }
:root[data-nexora-theme] .lp-btn-primary:hover { background: var(--c-accent) !important; color: var(--c-on-accent) !important; border-color: var(--c-accent) !important; }
:root[data-nexora-theme] .lp-toast { background: var(--nx-ink-fill) !important; color: var(--nx-ink-on) !important; }
:root[data-nexora-theme] .lp-cal-month-tag { background: var(--nx-ink-fill) !important; color: var(--nx-ink-on) !important; }
:root[data-nexora-theme] .lp-mode-toggle button.active { background: var(--c-accent) !important; color: var(--c-on-accent) !important; border-color: var(--c-accent) !important; }
:root[data-nexora-theme] .lp-filter-chip.active { background: var(--c-accent) !important; color: var(--c-on-accent) !important; border-color: var(--c-accent) !important; }
:root[data-nexora-theme] .lp-global-add-task-label { background: var(--nx-ink-fill) !important; color: var(--nx-ink-on) !important; }
:root[data-nexora-theme] .lp-saved-views-rail-inner { background: var(--nx-ink-fill) !important; color: var(--nx-ink-on) !important; }
:root[data-nexora-theme] .lp-impact-mode.active { background: var(--c-accent) !important; color: var(--c-on-accent) !important; border-color: var(--c-accent) !important; }
/* ---- Socle commun à toutes les chartes (tokens --c-*) ---- */
:root[data-nexora-theme="bauhaus"] body[data-life-app] { background: var(--c-bg) !important; color: var(--c-text); font-family: var(--c-font) !important; font-size: var(--c-base); }
:root[data-nexora-theme="bauhaus"] body[data-life-app] :where(button, input, select, textarea, summary) { font-family: var(--c-font) !important; }
:root[data-nexora-theme="bauhaus"] body[data-life-app] :where(h1, h2, h3, h4) { font-family: var(--c-display) !important; }
:root[data-nexora-theme="bauhaus"] body[data-life-app] svg text { font-family: var(--c-font) !important; }
:root[data-nexora-theme="bauhaus"] body[data-life-app] :where(pre, code, kbd, .lp-mono) { font-family: var(--c-mono) !important; }
:root[data-nexora-theme="bauhaus"] body[data-life-app] :where(button, a, input, select, textarea, summary, [tabindex]):focus-visible { outline: 2px solid var(--c-focus) !important; outline-offset: 2px !important; }
:root[data-nexora-theme="bauhaus"] body[data-life-app] ::selection { background: var(--c-selection) !important; color: var(--c-text) !important; }
:root[data-nexora-theme="bauhaus"] body[data-life-app] :where(input[type=checkbox], input[type=radio], input[type=range]) { accent-color: var(--c-accent); }
:root[data-nexora-theme="bauhaus"] .lp-app { background: var(--c-bg); }
/* Navigation latérale */
:root[data-nexora-theme="bauhaus"] .lp-sidebar { background: var(--c-sidebar) !important; color: var(--c-sidebar-text); border-right: 1px solid var(--c-sidebar-border) !important; }
:root[data-nexora-theme="bauhaus"] .lp-sidebar :is(.lp-project-item, .lp-folder-item, .lp-project-name, .lp-create-row button:not(.lp-btn-primary)) { color: var(--c-sidebar-text); }
:root[data-nexora-theme="bauhaus"] .lp-sidebar :is(.lp-side-label, .lp-project-count) { color: var(--c-sidebar-muted) !important; }
:root[data-nexora-theme="bauhaus"] .lp-sidebar :is(.lp-project-item, .lp-folder-item):hover { background: color-mix(in srgb, var(--c-sidebar-text) 7%, transparent); }
:root[data-nexora-theme="bauhaus"] .lp-sidebar .lp-project-item.active, :root[data-nexora-theme="bauhaus"] .lp-sidebar .lp-project-item[aria-pressed="true"] { background: var(--c-sidebar-active) !important; color: var(--c-sidebar-active-text) !important; }
:root[data-nexora-theme="bauhaus"] .lp-sidebar .lp-project-item.active :is(.lp-project-name, .lp-project-count) { color: var(--c-sidebar-active-text) !important; }
:root[data-nexora-theme="bauhaus"] .lp-sidebar .lp-logo { border-bottom-color: var(--c-sidebar-border) !important; }
:root[data-nexora-theme="bauhaus"] .lp-sidebar :is(.lp-icon-btn, .lp-create-icon-btn) { color: var(--c-sidebar-muted); border-color: var(--c-sidebar-border) !important; background: transparent !important; }
:root[data-nexora-theme="bauhaus"] .lp-sidebar-resize-wrap-collapsed { border-right-color: var(--c-sidebar-border); }
/* Barre supérieure et onglets de vues */
:root[data-nexora-theme="bauhaus"] .lp-topbar { background: var(--c-surface) !important; border-bottom: 1px solid var(--c-border) !important; }
:root[data-nexora-theme="bauhaus"] .lp-topbar h2 { font-family: var(--c-display) !important; color: var(--c-text); }
:root[data-nexora-theme="bauhaus"] .lp-detail-tabbar { background: var(--c-surface) !important; border-bottom-color: var(--c-border) !important; }
:root[data-nexora-theme="bauhaus"] .lp-detail-tab { color: var(--c-secondary); }
:root[data-nexora-theme="bauhaus"] .lp-detail-tab:hover { color: var(--c-text); }
:root[data-nexora-theme="bauhaus"] .lp-detail-tab.active { color: var(--c-text) !important; border-bottom-color: var(--c-accent) !important; }
/* Commandes */
:root[data-nexora-theme="bauhaus"] :is(.lp-tool-btn, .lp-filter-btn) { background: var(--c-surface); border-color: var(--c-border); color: var(--c-text); border-radius: var(--c-r-control) !important; }
:root[data-nexora-theme="bauhaus"] :is(.lp-tool-btn, .lp-filter-btn):hover { background: var(--c-soft); border-color: var(--c-border-strong); }
:root[data-nexora-theme="bauhaus"] .lp-tool-btn.active { background: var(--c-accent) !important; color: var(--c-on-accent) !important; border-color: var(--c-accent) !important; }
:root[data-nexora-theme="bauhaus"] .lp-icon-btn { color: var(--c-secondary); border-radius: var(--c-r-control); }
:root[data-nexora-theme="bauhaus"] .lp-icon-btn:hover { background: var(--c-soft); color: var(--c-text); }
:root[data-nexora-theme="bauhaus"] .lp-btn { border-radius: var(--c-r-control) !important; }
:root[data-nexora-theme="bauhaus"] :is(.lp-btn-primary, .lp-global-add-task) { background: var(--c-accent) !important; border-color: var(--c-accent) !important; color: var(--c-on-accent) !important; }
:root[data-nexora-theme="bauhaus"] :is(.lp-btn-primary, .lp-global-add-task):hover { background: var(--c-accent-hover) !important; border-color: var(--c-accent-hover) !important; }
:root[data-nexora-theme="bauhaus"] :is(.lp-search-input, .lp-search-wrap) { background: var(--c-surface); color: var(--c-text); border-color: var(--c-border); border-radius: var(--c-r-control) !important; }
/* Tableaux de bord et widgets */
:root[data-nexora-theme="bauhaus"] .lp-dashboard-grid { background-color: var(--c-bg); }
:root[data-nexora-theme="bauhaus"] .lp-widget-card { background: var(--c-surface) !important; border-color: var(--c-border) !important; border-radius: var(--c-r-card) !important; box-shadow: var(--c-shadow) !important; }
:root[data-nexora-theme="bauhaus"] .lp-widget-head { background: var(--c-surface); border-bottom-color: var(--c-border) !important; }
:root[data-nexora-theme="bauhaus"] .lp-widget-title { font-family: var(--c-display) !important; }
:root[data-nexora-theme="bauhaus"] .lp-widget-title:not([style*="color"]) { color: var(--c-text) !important; }
:root[data-nexora-theme="bauhaus"] .lp-widget-resize-handle { opacity: 0; }
:root[data-nexora-theme="bauhaus"] .lp-widget-card:hover .lp-widget-resize-handle { opacity: 1; }
:root[data-nexora-theme="bauhaus"] .lp-custom-card-value { font-family: var(--c-display) !important; font-variant-numeric: tabular-nums; color: var(--c-text); }
/* Champs, menus, fenêtres */
:root[data-nexora-theme="bauhaus"] .lp-field label { color: var(--c-secondary) !important; }
:root[data-nexora-theme="bauhaus"] .lp-field :is(input[type=text], input[type=date], input[type=time], input[type=number], select, textarea) { background: var(--c-surface) !important; color: var(--c-text) !important; border-color: var(--c-border) !important; border-radius: var(--c-r-control) !important; }
:root[data-nexora-theme="bauhaus"] .lp-field :is(input, textarea):focus { border-color: var(--c-accent) !important; box-shadow: 0 0 0 3px color-mix(in srgb, var(--c-accent) 22%, transparent) !important; }
:root[data-nexora-theme="bauhaus"] .lp-modal { background: var(--c-surface) !important; color: var(--c-text); border-radius: var(--c-r-modal) !important; box-shadow: var(--c-menu-shadow) !important; }
:root[data-nexora-theme="bauhaus"] .lp-modal-head, :root[data-nexora-theme="bauhaus"] .lp-modal-foot { border-color: var(--c-border) !important; background: var(--c-surface); }
:root[data-nexora-theme="bauhaus"] :is(.lp-dropdown-panel, .lp-dropdown-panel-portal, .lp-create-menu) { background: var(--c-surface) !important; border-color: var(--c-border) !important; box-shadow: var(--c-menu-shadow) !important; color: var(--c-text); }
/* Tableaux */
:root[data-nexora-theme="bauhaus"] .lp-table thead th { background: var(--c-soft) !important; color: var(--c-secondary) !important; border-color: var(--c-border) !important; }
:root[data-nexora-theme="bauhaus"] .lp-table td { border-color: color-mix(in srgb, var(--c-border) 70%, transparent) !important; }
:root[data-nexora-theme="bauhaus"] .lp-table tbody tr:hover td { background: var(--c-soft); }
/* Fil « Aujourd'hui » des frises et calendriers */
:root[data-nexora-theme="bauhaus"] :is(.lp-pm-today-line, .lp-widget-minigantt-todayline) { background: var(--c-signal) !important; border-color: var(--c-signal) !important; }
:root[data-nexora-theme="bauhaus"] .lp-widget-minigantt-axis-today { color: var(--c-signal-text) !important; }
/* Barres de défilement */
:root[data-nexora-theme="bauhaus"] body[data-life-app] * { scrollbar-color: color-mix(in srgb, var(--c-text) 22%, transparent) transparent; }
:root[data-nexora-theme="bauhaus"] .lp-sidebar :is(details, summary) { background: transparent !important; color: var(--c-sidebar-text) !important; border-color: var(--c-sidebar-border) !important; }
/* Curseurs en thème sombre : la piste suit la palette (la valeur reste portée par la poignée et le libellé). */
:root[data-nexora-theme="bauhaus"][data-nexora-mode="sombre"] input[type=range] { -webkit-appearance: none; appearance: none; height: 6px; border-radius: 3px; background: var(--c-border) !important; border: 0 !important; }
:root[data-nexora-theme="bauhaus"][data-nexora-mode="sombre"] input[type=range].lp-gradient-slider { height: 10px; }
:root[data-nexora-theme="bauhaus"][data-nexora-mode="sombre"] input[type=range]::-webkit-slider-runnable-track { background: transparent; height: inherit; }
:root[data-nexora-theme="bauhaus"][data-nexora-mode="sombre"] input[type=range]::-webkit-slider-thumb { -webkit-appearance: none; width: 14px; height: 14px; margin-top: 0; border-radius: 50%; background: var(--c-accent); border: 2px solid var(--c-surface); box-shadow: 0 0 0 1px var(--c-accent); }
:root[data-nexora-theme="bauhaus"][data-nexora-mode="sombre"] .lp-sidebar .lp-logo img { filter: invert(1) hue-rotate(180deg); }
/* ---- Thèmes sombres : graphiques et données (corrections issues de l'audit de contraste) ---- */
/* Fenêtres : le voile qui les entoure assombrit, il n'éclaircit jamais. */
:root[data-nexora-theme="bauhaus"][data-nexora-mode="sombre"] .lp-overlay { background: rgba(0, 0, 0, .62) !important; backdrop-filter: blur(2px); }
/* Heat map (vue) : l'échelle calculée en clair (vide = crème, plein = foncé) est inversée en luminance,
   teinte conservée : vide = presque noir, beaucoup = vert ou rouge lumineux. Le nombre est ré-inversé. */
:root[data-nexora-theme="bauhaus"][data-nexora-mode="sombre"] .lp-heatmap-cell { filter: invert(1) hue-rotate(180deg); }
:root[data-nexora-theme="bauhaus"][data-nexora-mode="sombre"] .lp-heatmap-cell.today { border-color: #000 !important; }
:root[data-nexora-theme="bauhaus"][data-nexora-mode="sombre"] :is(.lp-heatmap-cell:hover, .lp-heatmap-cell.selected) { border-color: #000 !important; box-shadow: 0 0 0 1px #000 !important; }
:root[data-nexora-theme="bauhaus"][data-nexora-mode="sombre"] .lp-heatmap-count { filter: invert(1) hue-rotate(180deg); color: #fff !important; text-shadow: none !important; background: rgba(0,0,0,.62); border-radius: 4px; padding: 0 4px; line-height: 1.35; font-size: 12.5px !important; }
/* Aplats de données portant du texte blanc (calendrier, heat map mensuelle, avatars, treemap) :
   assombris pour que le texte atteigne le contraste, sans changer la teinte. */
:root[data-nexora-theme="bauhaus"][data-nexora-mode="sombre"] .lp-cal-span { background-image: linear-gradient(rgba(0,0,0,.42), rgba(0,0,0,.42)) !important; color: #fff !important; }
:root[data-nexora-theme="bauhaus"][data-nexora-mode="sombre"] .lp-widget-heatmap-cell[style*="background"] { background-image: linear-gradient(rgba(0,0,0,.38), rgba(0,0,0,.38)) !important; }
:root[data-nexora-theme="bauhaus"][data-nexora-mode="sombre"] .lp-widget-heatmap-cell[style*="background"] .lp-widget-heatmap-daynum { color: #fff !important; }
:root[data-nexora-theme="bauhaus"][data-nexora-mode="sombre"] .lp-widget-heatmap-cell:not([style*="background"]) { background-color: color-mix(in srgb, var(--c-text) 7%, var(--c-surface)) !important; }
:root[data-nexora-theme="bauhaus"][data-nexora-mode="sombre"] .lp-cp-avatar { background-image: linear-gradient(rgba(0,0,0,.5), rgba(0,0,0,.5)) !important; color: #fff !important; }
:root[data-nexora-theme="bauhaus"][data-nexora-mode="sombre"] .lp-widget-treemap-tile { background-image: linear-gradient(rgba(0,0,0,.28), rgba(0,0,0,.28)) !important; }
:root[data-nexora-theme="bauhaus"][data-nexora-mode="sombre"] .lp-widget-treemap-ring circle:first-of-type { stroke: rgba(255,255,255,.32) !important; }
:root[data-nexora-theme="bauhaus"][data-nexora-mode="sombre"] .lp-mark-done svg :is(circle, path) { stroke: var(--c-muted) !important; }
:root[data-nexora-theme="bauhaus"][data-nexora-mode="sombre"] .lp-mark-done:hover svg :is(circle, path) { stroke: var(--c-success) !important; }
:root[data-nexora-theme="bauhaus"][data-nexora-mode="sombre"] .lp-cal-cell.is-today .lp-cal-daynum { color: var(--c-on-accent) !important; background: var(--c-accent) !important; }
/* Repères de graphiques : pistes d'anneaux, cases vides de la charge personnel. */
:root[data-nexora-theme="bauhaus"][data-nexora-mode="sombre"] svg circle[stroke="var(--paper-soft)"] { stroke: color-mix(in srgb, var(--c-text) 20%, transparent) !important; }
:root[data-nexora-theme="bauhaus"][data-nexora-mode="sombre"] .lp-cp-cell { background-color: color-mix(in srgb, var(--c-text) 4%, var(--c-surface)); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--c-text) 7%, transparent); }
/* Textes de graphiques : chiffres de pied, séparateurs, textes à la couleur d'un projet. */
:root[data-nexora-theme="bauhaus"][data-nexora-mode="sombre"] :is(.lp-cp-foot, .lp-pm-header-sep) { color: var(--c-muted) !important; }
:root[data-nexora-theme="bauhaus"][data-nexora-mode="sombre"] .lp-pm-project-name { -webkit-text-fill-color: color-mix(in oklab, currentColor 62%, #ffffff); }
:root[data-nexora-theme="bauhaus"][data-nexora-mode="sombre"] .lp-pm-scroll svg text { filter: brightness(1.4); }
:root[data-nexora-theme="bauhaus"][data-nexora-mode="sombre"] .lp-widget-treemap-tile .lp-widget-treemap-chip { background: rgba(0,0,0,.42) !important; -webkit-text-fill-color: #fff !important; color: #fff !important; box-shadow: none !important; }
/* Élément actif de la navigation : ses icônes et son repère suivent la couleur du texte actif. */
:root[data-nexora-theme="bauhaus"] .lp-sidebar .lp-project-item.active :is(.lp-icon-btn, .lp-project-row-action) { color: var(--c-sidebar-active-text) !important; }
:root[data-nexora-theme="bauhaus"][data-nexora-mode="sombre"] .lp-sidebar .lp-project-dot { color: #fff !important; }
/* Gantt, bulles, pistes : en sombre, la teinte pâle d'une barre posée sur la surface devient une boue noire.
   La partie non remplie garde la teinte de la tâche, sur un fond éclairci ; les poignées redeviennent claires. */
:root[data-nexora-theme="bauhaus"][data-nexora-mode="sombre"] .lp-widget-minigantt-bar { background-color: color-mix(in srgb, var(--c-text) 26%, var(--c-surface)) !important; box-shadow: 0 0 0 1px color-mix(in srgb, var(--c-text) 24%, transparent); }
:root[data-nexora-theme="bauhaus"][data-nexora-mode="sombre"] .lp-widget-minigantt-bar.is-compared { box-shadow: 0 0 0 1px var(--c-text); }
:root[data-nexora-theme="bauhaus"][data-nexora-mode="sombre"] .lp-widget-minigantt-bar-fill { opacity: 1; }
:root[data-nexora-theme="bauhaus"][data-nexora-mode="sombre"] :is(.lp-widget-minigantt-progress-handle:not(.is-done), .lp-bubble-progress-handle:not(.is-done)) { background: var(--c-text) !important; border-color: transparent !important; box-shadow: 0 0 0 1.5px rgba(0,0,0,.7), 0 1px 3px rgba(0,0,0,.6) !important; }
:root[data-nexora-theme="bauhaus"][data-nexora-mode="sombre"] .lp-widget-minigantt-progress-handle.is-done { box-shadow: 0 0 0 1.5px rgba(0,0,0,.7) !important; }
:root[data-nexora-theme="bauhaus"][data-nexora-mode="sombre"] :is(.lp-widget-minigantt-track, .lp-widget-minigantt-group-summary-track) { background: color-mix(in srgb, var(--c-text) 6%, transparent) !important; }
:root[data-nexora-theme="bauhaus"][data-nexora-mode="sombre"] .lp-widget-minigantt-group-summary-span { opacity: .55; }
:root[data-nexora-theme="bauhaus"][data-nexora-mode="sombre"] .lp-widget-minigantt-milestone { box-shadow: 0 0 0 1.5px rgba(0,0,0,.7), 0 0 0 2.5px color-mix(in srgb, var(--c-text) 30%, transparent) !important; }
:root[data-nexora-theme="bauhaus"][data-nexora-mode="sombre"] :is(.lp-widget-barv-track, .lp-cp-load-track, .lp-progress-track) { background-color: color-mix(in srgb, var(--c-text) 12%, var(--c-surface)) !important; }
:root[data-nexora-theme="bauhaus"][data-nexora-mode="sombre"] .lp-widget-critpath-line { background: color-mix(in srgb, var(--c-text) 38%, transparent) !important; }

/* ===== 01 · BAUHAUS — d'après la page « Budget prévisionnel » ===== */
:root[data-nexora-theme="bauhaus"] :is(.lp-tool-btn, .lp-filter-btn, .lp-search-wrap, .lp-search-input, .lp-btn, .lp-icon-btn, .lp-widget-card, .lp-modal, .lp-chip, .lp-inline-chip-select, .lp-project-item, .lp-folder-item, .lp-dashboard-page-tab, .lp-custom-card-item, .lp-field input, .lp-field select, .lp-field textarea, .lp-dropdown-panel, .lp-dropdown-panel-portal, .lp-zoom-btn, .lp-date-badge) { border-radius: 0 !important; }
:root[data-nexora-theme="bauhaus"] .lp-topbar { border-bottom: 2px solid var(--c-frame) !important; }
:root[data-nexora-theme="bauhaus"] .lp-topbar h2 { font-size: 27px !important; font-weight: 800 !important; letter-spacing: -0.02em !important; }
:root[data-nexora-theme="bauhaus"] .lp-sidebar { border-right: 2px solid var(--c-frame) !important; }
:root[data-nexora-theme="bauhaus"] .lp-sidebar .lp-side-label { text-transform: uppercase !important; font-size: 11px !important; font-weight: 700 !important; letter-spacing: .09em !important; }
:root[data-nexora-theme="bauhaus"] .lp-sidebar .lp-project-item.active { font-weight: 700; }
:root[data-nexora-theme="bauhaus"] .lp-sidebar .lp-btn-primary { font-weight: 700 !important; box-shadow: 4px 4px 0 var(--c-frame) !important; }
:root[data-nexora-theme="bauhaus"] :is(.lp-tool-btn, .lp-filter-btn) { border: 1.5px solid var(--c-frame) !important; font-weight: 600 !important; }
:root[data-nexora-theme="bauhaus"] :is(.lp-tool-btn, .lp-filter-btn):not(.active):hover { background: var(--c-yellow) !important; color: var(--c-on-yellow) !important; }
:root[data-nexora-theme="bauhaus"] .lp-search-wrap { border: 1.5px solid var(--c-frame) !important; }
:root[data-nexora-theme="bauhaus"] .lp-detail-tabbar { border-bottom: 2px solid var(--c-frame) !important; }
:root[data-nexora-theme="bauhaus"] .lp-detail-tab { font-size: 14px !important; font-weight: 600 !important; border-bottom-width: 4px !important; }
:root[data-nexora-theme="bauhaus"] .lp-detail-tab.active { border-bottom-color: var(--c-red) !important; }
:root[data-nexora-theme="bauhaus"] .lp-dashboard-page-tab { border-bottom: 4px solid transparent; }
/* Widgets : cadre noir de 2 px, en-tête fermé par un filet de 2 px */
:root[data-nexora-theme="bauhaus"] .lp-widget-card { border: 2px solid var(--c-frame) !important; box-shadow: none !important; }
:root[data-nexora-theme="bauhaus"] .lp-widget-head { border-bottom: 2px solid var(--c-frame) !important; }
:root[data-nexora-theme="bauhaus"] .lp-widget-title { font-size: 15px !important; font-weight: 700 !important; letter-spacing: -0.01em !important; }
/* Indicateurs : tuiles en aplats rouge, jaune, bleu puis papier, comme le résumé du budget */
:root[data-nexora-theme="bauhaus"] .lp-custom-card-item { border: 0 !important; background: transparent !important; box-shadow: none !important; }
:root[data-nexora-theme="bauhaus"] .lp-custom-card-item.hero .lp-custom-card-value { font-size: 46px !important; font-weight: 800 !important; letter-spacing: -0.035em !important; line-height: 1 !important; color: inherit !important; }
:root[data-nexora-theme="bauhaus"] .lp-dashboard-grid > .lp-widget-card:has(.lp-custom-card-item.hero):nth-child(4n+1) { --tile: var(--c-red); --on-tile: var(--c-on-red); }
:root[data-nexora-theme="bauhaus"] .lp-dashboard-grid > .lp-widget-card:has(.lp-custom-card-item.hero):nth-child(4n+2) { --tile: var(--c-yellow); --on-tile: var(--c-on-yellow); }
:root[data-nexora-theme="bauhaus"] .lp-dashboard-grid > .lp-widget-card:has(.lp-custom-card-item.hero):nth-child(4n+3) { --tile: var(--c-blue); --on-tile: var(--c-on-blue); }
:root[data-nexora-theme="bauhaus"] .lp-dashboard-grid > .lp-widget-card:has(.lp-custom-card-item.hero):is(:nth-child(4n+1), :nth-child(4n+2), :nth-child(4n+3)),
:root[data-nexora-theme="bauhaus"] .lp-dashboard-grid > .lp-widget-card:has(.lp-custom-card-item.hero):is(:nth-child(4n+1), :nth-child(4n+2), :nth-child(4n+3)) :is(.lp-widget-head, .lp-widget-body, .lp-custom-card) { background: var(--tile) !important; color: var(--on-tile) !important; }
:root[data-nexora-theme="bauhaus"] .lp-dashboard-grid > .lp-widget-card:has(.lp-custom-card-item.hero):is(:nth-child(4n+1), :nth-child(4n+2), :nth-child(4n+3)) :is(.lp-widget-title, .lp-icon-btn, .lp-drag-handle, .lp-custom-card-value) { color: var(--on-tile) !important; }
:root[data-nexora-theme="bauhaus"] .lp-dashboard-grid > .lp-widget-card:has(.lp-custom-card-item.hero) .lp-widget-head { border-bottom-color: transparent !important; }
/* Tableaux : en-tête bleu plein, capitales blanches */
:root[data-nexora-theme="bauhaus"] .lp-table thead th { background: var(--c-blue) !important; color: var(--c-on-blue) !important; text-transform: uppercase !important; letter-spacing: .06em !important; font-size: 11.5px !important; font-weight: 600 !important; border-color: var(--c-blue) !important; }
:root[data-nexora-theme="bauhaus"] .lp-table td { border-bottom: 1px solid var(--c-border) !important; }
/* Puces : carré de couleur de donnée, texte d'encre */
:root[data-nexora-theme="bauhaus"] :is(.lp-chip, .lp-inline-chip-select, .lp-widget-treemap-chip) { background: color-mix(in srgb, currentColor 18%, var(--c-surface)) !important; -webkit-text-fill-color: var(--c-text); font-weight: 600; }
/* Actions */
:root[data-nexora-theme="bauhaus"] .lp-btn-primary { font-weight: 700 !important; }
:root[data-nexora-theme="bauhaus"] .lp-global-add-task { border-radius: 0 !important; border: 2px solid var(--c-frame) !important; box-shadow: 5px 5px 0 var(--c-frame) !important; }
:root[data-nexora-theme="bauhaus"] .lp-modal { border: 2px solid var(--c-frame) !important; }
:root[data-nexora-theme="bauhaus"] .lp-modal-head { border-bottom: 2px solid var(--c-frame) !important; }
:root[data-nexora-theme="bauhaus"] .lp-modal-head h3 { font-size: 22px !important; font-weight: 800 !important; }
:root[data-nexora-theme="bauhaus"] .lp-field label { letter-spacing: .07em !important; color: var(--c-text) !important; }
:root[data-nexora-theme="bauhaus"] .lp-field :is(input[type=text], input[type=date], input[type=number], select, textarea) { background: var(--c-soft) !important; border: 1.5px solid color-mix(in srgb, var(--c-frame) 55%, transparent) !important; }
/* Aujourd'hui : barre jaune cernée d'encre */
:root[data-nexora-theme="bauhaus"] :is(.lp-pm-today-line, .lp-widget-minigantt-todayline) { width: 3px !important; background: var(--c-yellow) !important; box-shadow: 0 0 0 1px var(--c-frame) !important; }
:root[data-nexora-theme="bauhaus"] .lp-widget-minigantt-axis-today { color: var(--c-on-yellow) !important; background: var(--c-yellow); padding: 0 4px; }
:root[data-nexora-theme="bauhaus"] .lp-dashboard-grid > .lp-widget-card:has(.lp-custom-card-item.hero):nth-child(4n) .lp-custom-card-value { color: var(--c-text) !important; }
/* ---- Socle commun à toutes les chartes (tokens --c-*) ---- */
:root[data-nexora-theme="dessau"] body[data-life-app] { background: var(--c-bg) !important; color: var(--c-text); font-family: var(--c-font) !important; font-size: var(--c-base); }
:root[data-nexora-theme="dessau"] body[data-life-app] :where(button, input, select, textarea, summary) { font-family: var(--c-font) !important; }
:root[data-nexora-theme="dessau"] body[data-life-app] :where(h1, h2, h3, h4) { font-family: var(--c-display) !important; }
:root[data-nexora-theme="dessau"] body[data-life-app] svg text { font-family: var(--c-font) !important; }
:root[data-nexora-theme="dessau"] body[data-life-app] :where(pre, code, kbd, .lp-mono) { font-family: var(--c-mono) !important; }
:root[data-nexora-theme="dessau"] body[data-life-app] :where(button, a, input, select, textarea, summary, [tabindex]):focus-visible { outline: 2px solid var(--c-focus) !important; outline-offset: 2px !important; }
:root[data-nexora-theme="dessau"] body[data-life-app] ::selection { background: var(--c-selection) !important; color: var(--c-text) !important; }
:root[data-nexora-theme="dessau"] body[data-life-app] :where(input[type=checkbox], input[type=radio], input[type=range]) { accent-color: var(--c-accent); }
:root[data-nexora-theme="dessau"] .lp-app { background: var(--c-bg); }
/* Navigation latérale */
:root[data-nexora-theme="dessau"] .lp-sidebar { background: var(--c-sidebar) !important; color: var(--c-sidebar-text); border-right: 1px solid var(--c-sidebar-border) !important; }
:root[data-nexora-theme="dessau"] .lp-sidebar :is(.lp-project-item, .lp-folder-item, .lp-project-name, .lp-create-row button:not(.lp-btn-primary)) { color: var(--c-sidebar-text); }
:root[data-nexora-theme="dessau"] .lp-sidebar :is(.lp-side-label, .lp-project-count) { color: var(--c-sidebar-muted) !important; }
:root[data-nexora-theme="dessau"] .lp-sidebar :is(.lp-project-item, .lp-folder-item):hover { background: color-mix(in srgb, var(--c-sidebar-text) 7%, transparent); }
:root[data-nexora-theme="dessau"] .lp-sidebar .lp-project-item.active, :root[data-nexora-theme="dessau"] .lp-sidebar .lp-project-item[aria-pressed="true"] { background: var(--c-sidebar-active) !important; color: var(--c-sidebar-active-text) !important; }
:root[data-nexora-theme="dessau"] .lp-sidebar .lp-project-item.active :is(.lp-project-name, .lp-project-count) { color: var(--c-sidebar-active-text) !important; }
:root[data-nexora-theme="dessau"] .lp-sidebar .lp-logo { border-bottom-color: var(--c-sidebar-border) !important; }
:root[data-nexora-theme="dessau"] .lp-sidebar :is(.lp-icon-btn, .lp-create-icon-btn) { color: var(--c-sidebar-muted); border-color: var(--c-sidebar-border) !important; background: transparent !important; }
:root[data-nexora-theme="dessau"] .lp-sidebar-resize-wrap-collapsed { border-right-color: var(--c-sidebar-border); }
/* Barre supérieure et onglets de vues */
:root[data-nexora-theme="dessau"] .lp-topbar { background: var(--c-surface) !important; border-bottom: 1px solid var(--c-border) !important; }
:root[data-nexora-theme="dessau"] .lp-topbar h2 { font-family: var(--c-display) !important; color: var(--c-text); }
:root[data-nexora-theme="dessau"] .lp-detail-tabbar { background: var(--c-surface) !important; border-bottom-color: var(--c-border) !important; }
:root[data-nexora-theme="dessau"] .lp-detail-tab { color: var(--c-secondary); }
:root[data-nexora-theme="dessau"] .lp-detail-tab:hover { color: var(--c-text); }
:root[data-nexora-theme="dessau"] .lp-detail-tab.active { color: var(--c-text) !important; border-bottom-color: var(--c-accent) !important; }
/* Commandes */
:root[data-nexora-theme="dessau"] :is(.lp-tool-btn, .lp-filter-btn) { background: var(--c-surface); border-color: var(--c-border); color: var(--c-text); border-radius: var(--c-r-control) !important; }
:root[data-nexora-theme="dessau"] :is(.lp-tool-btn, .lp-filter-btn):hover { background: var(--c-soft); border-color: var(--c-border-strong); }
:root[data-nexora-theme="dessau"] .lp-tool-btn.active { background: var(--c-accent) !important; color: var(--c-on-accent) !important; border-color: var(--c-accent) !important; }
:root[data-nexora-theme="dessau"] .lp-icon-btn { color: var(--c-secondary); border-radius: var(--c-r-control); }
:root[data-nexora-theme="dessau"] .lp-icon-btn:hover { background: var(--c-soft); color: var(--c-text); }
:root[data-nexora-theme="dessau"] .lp-btn { border-radius: var(--c-r-control) !important; }
:root[data-nexora-theme="dessau"] :is(.lp-btn-primary, .lp-global-add-task) { background: var(--c-accent) !important; border-color: var(--c-accent) !important; color: var(--c-on-accent) !important; }
:root[data-nexora-theme="dessau"] :is(.lp-btn-primary, .lp-global-add-task):hover { background: var(--c-accent-hover) !important; border-color: var(--c-accent-hover) !important; }
:root[data-nexora-theme="dessau"] :is(.lp-search-input, .lp-search-wrap) { background: var(--c-surface); color: var(--c-text); border-color: var(--c-border); border-radius: var(--c-r-control) !important; }
/* Tableaux de bord et widgets */
:root[data-nexora-theme="dessau"] .lp-dashboard-grid { background-color: var(--c-bg); }
:root[data-nexora-theme="dessau"] .lp-widget-card { background: var(--c-surface) !important; border-color: var(--c-border) !important; border-radius: var(--c-r-card) !important; box-shadow: var(--c-shadow) !important; }
:root[data-nexora-theme="dessau"] .lp-widget-head { background: var(--c-surface); border-bottom-color: var(--c-border) !important; }
:root[data-nexora-theme="dessau"] .lp-widget-title { font-family: var(--c-display) !important; }
:root[data-nexora-theme="dessau"] .lp-widget-title:not([style*="color"]) { color: var(--c-text) !important; }
:root[data-nexora-theme="dessau"] .lp-widget-resize-handle { opacity: 0; }
:root[data-nexora-theme="dessau"] .lp-widget-card:hover .lp-widget-resize-handle { opacity: 1; }
:root[data-nexora-theme="dessau"] .lp-custom-card-value { font-family: var(--c-display) !important; font-variant-numeric: tabular-nums; color: var(--c-text); }
/* Champs, menus, fenêtres */
:root[data-nexora-theme="dessau"] .lp-field label { color: var(--c-secondary) !important; }
:root[data-nexora-theme="dessau"] .lp-field :is(input[type=text], input[type=date], input[type=time], input[type=number], select, textarea) { background: var(--c-surface) !important; color: var(--c-text) !important; border-color: var(--c-border) !important; border-radius: var(--c-r-control) !important; }
:root[data-nexora-theme="dessau"] .lp-field :is(input, textarea):focus { border-color: var(--c-accent) !important; box-shadow: 0 0 0 3px color-mix(in srgb, var(--c-accent) 22%, transparent) !important; }
:root[data-nexora-theme="dessau"] .lp-modal { background: var(--c-surface) !important; color: var(--c-text); border-radius: var(--c-r-modal) !important; box-shadow: var(--c-menu-shadow) !important; }
:root[data-nexora-theme="dessau"] .lp-modal-head, :root[data-nexora-theme="dessau"] .lp-modal-foot { border-color: var(--c-border) !important; background: var(--c-surface); }
:root[data-nexora-theme="dessau"] :is(.lp-dropdown-panel, .lp-dropdown-panel-portal, .lp-create-menu) { background: var(--c-surface) !important; border-color: var(--c-border) !important; box-shadow: var(--c-menu-shadow) !important; color: var(--c-text); }
/* Tableaux */
:root[data-nexora-theme="dessau"] .lp-table thead th { background: var(--c-soft) !important; color: var(--c-secondary) !important; border-color: var(--c-border) !important; }
:root[data-nexora-theme="dessau"] .lp-table td { border-color: color-mix(in srgb, var(--c-border) 70%, transparent) !important; }
:root[data-nexora-theme="dessau"] .lp-table tbody tr:hover td { background: var(--c-soft); }
/* Fil « Aujourd'hui » des frises et calendriers */
:root[data-nexora-theme="dessau"] :is(.lp-pm-today-line, .lp-widget-minigantt-todayline) { background: var(--c-signal) !important; border-color: var(--c-signal) !important; }
:root[data-nexora-theme="dessau"] .lp-widget-minigantt-axis-today { color: var(--c-signal-text) !important; }
/* Barres de défilement */
:root[data-nexora-theme="dessau"] body[data-life-app] * { scrollbar-color: color-mix(in srgb, var(--c-text) 22%, transparent) transparent; }
:root[data-nexora-theme="dessau"] .lp-sidebar :is(details, summary) { background: transparent !important; color: var(--c-sidebar-text) !important; border-color: var(--c-sidebar-border) !important; }
/* Curseurs en thème sombre : la piste suit la palette (la valeur reste portée par la poignée et le libellé). */
:root[data-nexora-theme="dessau"][data-nexora-mode="sombre"] input[type=range] { -webkit-appearance: none; appearance: none; height: 6px; border-radius: 3px; background: var(--c-border) !important; border: 0 !important; }
:root[data-nexora-theme="dessau"][data-nexora-mode="sombre"] input[type=range].lp-gradient-slider { height: 10px; }
:root[data-nexora-theme="dessau"][data-nexora-mode="sombre"] input[type=range]::-webkit-slider-runnable-track { background: transparent; height: inherit; }
:root[data-nexora-theme="dessau"][data-nexora-mode="sombre"] input[type=range]::-webkit-slider-thumb { -webkit-appearance: none; width: 14px; height: 14px; margin-top: 0; border-radius: 50%; background: var(--c-accent); border: 2px solid var(--c-surface); box-shadow: 0 0 0 1px var(--c-accent); }
:root[data-nexora-theme="dessau"][data-nexora-mode="sombre"] .lp-sidebar .lp-logo img { filter: invert(1) hue-rotate(180deg); }
/* ---- Thèmes sombres : graphiques et données (corrections issues de l'audit de contraste) ---- */
/* Fenêtres : le voile qui les entoure assombrit, il n'éclaircit jamais. */
:root[data-nexora-theme="dessau"][data-nexora-mode="sombre"] .lp-overlay { background: rgba(0, 0, 0, .62) !important; backdrop-filter: blur(2px); }
/* Heat map (vue) : l'échelle calculée en clair (vide = crème, plein = foncé) est inversée en luminance,
   teinte conservée : vide = presque noir, beaucoup = vert ou rouge lumineux. Le nombre est ré-inversé. */
:root[data-nexora-theme="dessau"][data-nexora-mode="sombre"] .lp-heatmap-cell { filter: invert(1) hue-rotate(180deg); }
:root[data-nexora-theme="dessau"][data-nexora-mode="sombre"] .lp-heatmap-cell.today { border-color: #000 !important; }
:root[data-nexora-theme="dessau"][data-nexora-mode="sombre"] :is(.lp-heatmap-cell:hover, .lp-heatmap-cell.selected) { border-color: #000 !important; box-shadow: 0 0 0 1px #000 !important; }
:root[data-nexora-theme="dessau"][data-nexora-mode="sombre"] .lp-heatmap-count { filter: invert(1) hue-rotate(180deg); color: #fff !important; text-shadow: none !important; background: rgba(0,0,0,.62); border-radius: 4px; padding: 0 4px; line-height: 1.35; font-size: 12.5px !important; }
/* Aplats de données portant du texte blanc (calendrier, heat map mensuelle, avatars, treemap) :
   assombris pour que le texte atteigne le contraste, sans changer la teinte. */
:root[data-nexora-theme="dessau"][data-nexora-mode="sombre"] .lp-cal-span { background-image: linear-gradient(rgba(0,0,0,.42), rgba(0,0,0,.42)) !important; color: #fff !important; }
:root[data-nexora-theme="dessau"][data-nexora-mode="sombre"] .lp-widget-heatmap-cell[style*="background"] { background-image: linear-gradient(rgba(0,0,0,.38), rgba(0,0,0,.38)) !important; }
:root[data-nexora-theme="dessau"][data-nexora-mode="sombre"] .lp-widget-heatmap-cell[style*="background"] .lp-widget-heatmap-daynum { color: #fff !important; }
:root[data-nexora-theme="dessau"][data-nexora-mode="sombre"] .lp-widget-heatmap-cell:not([style*="background"]) { background-color: color-mix(in srgb, var(--c-text) 7%, var(--c-surface)) !important; }
:root[data-nexora-theme="dessau"][data-nexora-mode="sombre"] .lp-cp-avatar { background-image: linear-gradient(rgba(0,0,0,.5), rgba(0,0,0,.5)) !important; color: #fff !important; }
:root[data-nexora-theme="dessau"][data-nexora-mode="sombre"] .lp-widget-treemap-tile { background-image: linear-gradient(rgba(0,0,0,.28), rgba(0,0,0,.28)) !important; }
:root[data-nexora-theme="dessau"][data-nexora-mode="sombre"] .lp-widget-treemap-ring circle:first-of-type { stroke: rgba(255,255,255,.32) !important; }
:root[data-nexora-theme="dessau"][data-nexora-mode="sombre"] .lp-mark-done svg :is(circle, path) { stroke: var(--c-muted) !important; }
:root[data-nexora-theme="dessau"][data-nexora-mode="sombre"] .lp-mark-done:hover svg :is(circle, path) { stroke: var(--c-success) !important; }
:root[data-nexora-theme="dessau"][data-nexora-mode="sombre"] .lp-cal-cell.is-today .lp-cal-daynum { color: var(--c-on-accent) !important; background: var(--c-accent) !important; }
/* Repères de graphiques : pistes d'anneaux, cases vides de la charge personnel. */
:root[data-nexora-theme="dessau"][data-nexora-mode="sombre"] svg circle[stroke="var(--paper-soft)"] { stroke: color-mix(in srgb, var(--c-text) 20%, transparent) !important; }
:root[data-nexora-theme="dessau"][data-nexora-mode="sombre"] .lp-cp-cell { background-color: color-mix(in srgb, var(--c-text) 4%, var(--c-surface)); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--c-text) 7%, transparent); }
/* Textes de graphiques : chiffres de pied, séparateurs, textes à la couleur d'un projet. */
:root[data-nexora-theme="dessau"][data-nexora-mode="sombre"] :is(.lp-cp-foot, .lp-pm-header-sep) { color: var(--c-muted) !important; }
:root[data-nexora-theme="dessau"][data-nexora-mode="sombre"] .lp-pm-project-name { -webkit-text-fill-color: color-mix(in oklab, currentColor 62%, #ffffff); }
:root[data-nexora-theme="dessau"][data-nexora-mode="sombre"] .lp-pm-scroll svg text { filter: brightness(1.4); }
:root[data-nexora-theme="dessau"][data-nexora-mode="sombre"] .lp-widget-treemap-tile .lp-widget-treemap-chip { background: rgba(0,0,0,.42) !important; -webkit-text-fill-color: #fff !important; color: #fff !important; box-shadow: none !important; }
/* Élément actif de la navigation : ses icônes et son repère suivent la couleur du texte actif. */
:root[data-nexora-theme="dessau"] .lp-sidebar .lp-project-item.active :is(.lp-icon-btn, .lp-project-row-action) { color: var(--c-sidebar-active-text) !important; }
:root[data-nexora-theme="dessau"][data-nexora-mode="sombre"] .lp-sidebar .lp-project-dot { color: #fff !important; }
/* Gantt, bulles, pistes : en sombre, la teinte pâle d'une barre posée sur la surface devient une boue noire.
   La partie non remplie garde la teinte de la tâche, sur un fond éclairci ; les poignées redeviennent claires. */
:root[data-nexora-theme="dessau"][data-nexora-mode="sombre"] .lp-widget-minigantt-bar { background-color: color-mix(in srgb, var(--c-text) 26%, var(--c-surface)) !important; box-shadow: 0 0 0 1px color-mix(in srgb, var(--c-text) 24%, transparent); }
:root[data-nexora-theme="dessau"][data-nexora-mode="sombre"] .lp-widget-minigantt-bar.is-compared { box-shadow: 0 0 0 1px var(--c-text); }
:root[data-nexora-theme="dessau"][data-nexora-mode="sombre"] .lp-widget-minigantt-bar-fill { opacity: 1; }
:root[data-nexora-theme="dessau"][data-nexora-mode="sombre"] :is(.lp-widget-minigantt-progress-handle:not(.is-done), .lp-bubble-progress-handle:not(.is-done)) { background: var(--c-text) !important; border-color: transparent !important; box-shadow: 0 0 0 1.5px rgba(0,0,0,.7), 0 1px 3px rgba(0,0,0,.6) !important; }
:root[data-nexora-theme="dessau"][data-nexora-mode="sombre"] .lp-widget-minigantt-progress-handle.is-done { box-shadow: 0 0 0 1.5px rgba(0,0,0,.7) !important; }
:root[data-nexora-theme="dessau"][data-nexora-mode="sombre"] :is(.lp-widget-minigantt-track, .lp-widget-minigantt-group-summary-track) { background: color-mix(in srgb, var(--c-text) 6%, transparent) !important; }
:root[data-nexora-theme="dessau"][data-nexora-mode="sombre"] .lp-widget-minigantt-group-summary-span { opacity: .55; }
:root[data-nexora-theme="dessau"][data-nexora-mode="sombre"] .lp-widget-minigantt-milestone { box-shadow: 0 0 0 1.5px rgba(0,0,0,.7), 0 0 0 2.5px color-mix(in srgb, var(--c-text) 30%, transparent) !important; }
:root[data-nexora-theme="dessau"][data-nexora-mode="sombre"] :is(.lp-widget-barv-track, .lp-cp-load-track, .lp-progress-track) { background-color: color-mix(in srgb, var(--c-text) 12%, var(--c-surface)) !important; }
:root[data-nexora-theme="dessau"][data-nexora-mode="sombre"] .lp-widget-critpath-line { background: color-mix(in srgb, var(--c-text) 38%, transparent) !important; }

/* ===== 05 · DESSAU — Bauhaus tempéré ===== */
:root[data-nexora-theme="dessau"] .lp-topbar { border-bottom: 1.5px solid var(--c-frame) !important; }
:root[data-nexora-theme="dessau"] .lp-topbar h2 { font-size: 25px !important; font-weight: 500 !important; letter-spacing: -0.005em !important; }
:root[data-nexora-theme="dessau"] .lp-sidebar { border-right: 1.5px solid var(--c-frame) !important; }
:root[data-nexora-theme="dessau"] .lp-sidebar .lp-side-label { text-transform: uppercase !important; font-size: 11px !important; font-weight: 500 !important; letter-spacing: .14em !important; }
:root[data-nexora-theme="dessau"] .lp-sidebar .lp-project-item.active { font-weight: 600; }
:root[data-nexora-theme="dessau"] .lp-sidebar .lp-btn-primary { border-radius: 999px !important; }
:root[data-nexora-theme="dessau"] :is(.lp-tool-btn, .lp-filter-btn) { border: 1.5px solid color-mix(in srgb, var(--c-frame) 70%, transparent) !important; font-weight: 500 !important; }
:root[data-nexora-theme="dessau"] .lp-detail-tabbar { border-bottom: 1.5px solid var(--c-frame) !important; }
:root[data-nexora-theme="dessau"] .lp-detail-tab { font-size: 14px !important; font-weight: 500 !important; border-bottom-width: 3px !important; }
:root[data-nexora-theme="dessau"] .lp-detail-tab.active { border-bottom-color: var(--c-ocre) !important; }
:root[data-nexora-theme="dessau"] .lp-widget-card { border: 1.5px solid var(--c-frame) !important; box-shadow: none !important; }
:root[data-nexora-theme="dessau"] .lp-widget-head { border-bottom: 1.5px solid var(--c-frame) !important; }
:root[data-nexora-theme="dessau"] .lp-widget-title { font-size: 15.5px !important; font-weight: 500 !important; letter-spacing: .005em !important; }
:root[data-nexora-theme="dessau"] .lp-widget-head > :is(.lp-icon-btn, button):not(.lp-drag-handle) { opacity: .4; }
:root[data-nexora-theme="dessau"] .lp-widget-card:is(:hover, :focus-within) .lp-widget-head > :is(.lp-icon-btn, button) { opacity: 1; }
:root[data-nexora-theme="dessau"] .lp-custom-card-item { border: 0 !important; background: transparent !important; box-shadow: none !important; }
:root[data-nexora-theme="dessau"] .lp-custom-card-item.hero .lp-custom-card-value { font-size: 44px !important; font-weight: 500 !important; letter-spacing: -0.02em !important; line-height: 1 !important; color: inherit !important; }
:root[data-nexora-theme="dessau"] .lp-dashboard-grid > .lp-widget-card:has(.lp-custom-card-item.hero):nth-child(4n+1) { --tile: var(--c-ocre); --on-tile: var(--c-on-ocre); }
:root[data-nexora-theme="dessau"] .lp-dashboard-grid > .lp-widget-card:has(.lp-custom-card-item.hero):nth-child(4n+2) { --tile: var(--c-brique); --on-tile: var(--c-on-brique); }
:root[data-nexora-theme="dessau"] .lp-dashboard-grid > .lp-widget-card:has(.lp-custom-card-item.hero):nth-child(4n+3) { --tile: var(--c-ardoise); --on-tile: var(--c-on-ardoise); }
:root[data-nexora-theme="dessau"] .lp-dashboard-grid > .lp-widget-card:has(.lp-custom-card-item.hero):is(:nth-child(4n+1), :nth-child(4n+2), :nth-child(4n+3)),
:root[data-nexora-theme="dessau"] .lp-dashboard-grid > .lp-widget-card:has(.lp-custom-card-item.hero):is(:nth-child(4n+1), :nth-child(4n+2), :nth-child(4n+3)) :is(.lp-widget-head, .lp-widget-body, .lp-custom-card) { background: var(--tile) !important; color: var(--on-tile) !important; }
:root[data-nexora-theme="dessau"] .lp-dashboard-grid > .lp-widget-card:has(.lp-custom-card-item.hero):is(:nth-child(4n+1), :nth-child(4n+2), :nth-child(4n+3)) :is(.lp-widget-title, .lp-icon-btn, .lp-drag-handle, .lp-custom-card-value) { color: var(--on-tile) !important; }
:root[data-nexora-theme="dessau"] .lp-dashboard-grid > .lp-widget-card:has(.lp-custom-card-item.hero) .lp-widget-head { border-bottom-color: transparent !important; }
:root[data-nexora-theme="dessau"] .lp-table thead th { background: var(--c-ardoise) !important; color: var(--c-on-ardoise) !important; text-transform: uppercase !important; letter-spacing: .1em !important; font-size: 11px !important; font-weight: 500 !important; }
:root[data-nexora-theme="dessau"] .lp-table td { border-bottom: 1px solid var(--c-border) !important; }
:root[data-nexora-theme="dessau"] :is(.lp-chip, .lp-inline-chip-select, .lp-widget-treemap-chip) { background: color-mix(in srgb, currentColor 16%, var(--c-surface)) !important; -webkit-text-fill-color: color-mix(in oklab, currentColor 42%, var(--c-text)); font-weight: 500; }
:root[data-nexora-theme="dessau"] .lp-global-add-task { background: var(--c-ocre) !important; border: 1.5px solid var(--c-frame) !important; color: var(--c-on-ocre) !important; border-radius: 50% !important; box-shadow: 4px 4px 0 var(--c-frame) !important; }
:root[data-nexora-theme="dessau"] .lp-modal { border: 1.5px solid var(--c-frame) !important; }
:root[data-nexora-theme="dessau"] .lp-modal-head { border-bottom: 1.5px solid var(--c-frame) !important; }
:root[data-nexora-theme="dessau"] .lp-modal-head h3 { font-weight: 500 !important; font-size: 22px !important; }
:root[data-nexora-theme="dessau"] .lp-field label { letter-spacing: .12em !important; font-weight: 500 !important; }
:root[data-nexora-theme="dessau"] :is(.lp-pm-today-line, .lp-widget-minigantt-todayline) { background: var(--c-brique) !important; }
:root[data-nexora-theme="dessau"] .lp-dashboard-grid > .lp-widget-card:has(.lp-custom-card-item.hero):nth-child(4n) .lp-custom-card-value { color: var(--c-text) !important; }
</style><!-- /nexora-themes -->
</body>
</html>
