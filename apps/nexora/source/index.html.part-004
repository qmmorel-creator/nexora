// Réglages Finance PRO — objet-carte comme quoteSettings/gcalSettings.
// Régime TVA : franchise en base confirmée par Quentin (2026-09-22, CA réel
// < 37 500 €, seuil 2026 prestations de services) — HT = TTC, comme le
// module Devis. Décision non bloquante (§12.1) : trésorerie disponible en
// saisie manuelle, pas d'import bancaire dans cette phase.
const seedFinanceProSettings = {
  tvaFranchiseEnBase: true,
  tresorerieDisponible: 0,
  tresorerieDisponibleMiseAJour: "",
  seuilTresorerieSecurite: 0,
  bornesYPrevisionnel: { min: null, max: null },
  // Laissé vide par défaut (§12.6) : aucun taux de provision imposé, à
