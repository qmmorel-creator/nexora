// ---------------------------------------------------------------------------
// Utilitaires
// ---------------------------------------------------------------------------

function proEuros(n) {
  return Number.isFinite(Number(n)) ? Number(n) : 0;
}

function proActive(list) {
  return (list || []).filter((x) => x && !x.archivedAt);
}

// Détection de doublon d'import (§4.5) : hash déterministe fournisseur +
// montant + date, jamais d'aléatoire — un import répété produit le même hash.
function proExpenseDedupeHash(expense) {
  const parts = [
    (expense?.fournisseur || "").trim().toLowerCase(),
    proEuros(expense?.montantTTC).toFixed(2),
    expense?.dateAchat || "",
  ];
  return parts.join("|");
}

// ---------------------------------------------------------------------------
// Indicateurs — fonctions pures et déterministes (docs/finance-pro/
// AUDIT_CONCEPTION.md §5). Chacune ne lit QUE les tableaux/objets qu'on lui
// passe : aucun état global, aucun effet de bord, testable isolément.
// ---------------------------------------------------------------------------

// CA signé : somme des devis acceptés (quotes réel, cf. NEXORA:QUOTES). Un
// devis remplacé par un avenant est une nouvelle version du même devis, pas
// une entrée séparée — donc aucun double comptage tant que `quotes` reste la
// source unique (pas de duplication ici).
function proCaSigne(quotes) {
  return (quotes || [])
    .filter((q) => q && q.status === "accepted")
    .reduce((sum, q) => sum + quoteTotal(q), 0);
}

// CA planifié : lignes de planning non encore facturées, hors annulées.
function proCaPlanifie(billingSchedule) {
  return proActive(billingSchedule)
    .filter((l) => l.statut === "prevu" || l.statut === "a_facturer")
    .reduce((sum, l) => sum + proEuros(l.montantPrevu), 0);
}

// CA facturé : lignes facturées ou encaissées ; un avoir (montant négatif)
// vient TOUJOURS en déduction de l'écriture d'origine, jamais en suppression.
function proCaFacture(billingSchedule) {
  return proActive(billingSchedule)
    .filter((l) => l.statut === "facture" || l.statut === "encaisse" || l.type === "avoir")
    .reduce((sum, l) => sum + proEuros(l.montantPrevu), 0);
}

// CA encaissé : somme des paiements rapprochés — un paiement partiel est la
// somme réelle des paiements liés, jamais le montant de la facture entière.
function proCaEncaisse(payments) {
  return proActive(payments)
    .filter((p) => p.statutRapprochement === "rapproche")
    .reduce((sum, p) => sum + proEuros(p.montant), 0);
}

// Travail réalisé non facturé : temps facturable non encore facturé, valorisé
// au taux appliqué, + dépenses refacturables non encore liées à une ligne de
// planning facturée.
function proTravailRealiseNonFacture(timeEntries, expenses) {
  const temps = proActive(timeEntries)
    .filter((t) => t.billable && t.status !== "facturee")
    .reduce((sum, t) => {
      const heures = proEuros(t.durationMinutes) / 60;
      const taux = proEuros(t.rateApplied);
      const montant = t.rateType === "journalier" ? (heures / 8) * taux : heures * taux;
      return sum + montant;
    }, 0);
  const depenses = proActive(expenses)
    .filter((e) => e.refacturable && e.statutRemboursement === "a_refacturer")
    .reduce((sum, e) => sum + proEuros(e.montantTTC), 0);
  return temps + depenses;
}

// Factures en retard : lignes à facturer/facturées dont l'échéance est
// dépassée sans encaissement (même principe qu'effectiveInvoiceStatus :
// jamais persisté, calculé à l'affichage).
function proFacturesEnRetard(billingSchedule, today = iso(new Date())) {
  return proActive(billingSchedule).filter(
    (l) => (l.statut === "a_facturer" || l.statut === "facture") && l.dateCible && l.dateCible < today
  );
}

// Délai moyen d'encaissement (jours) : moyenne pondérée par montant entre la
// date cible d'une ligne et la date des paiements qui la soldent.
function proDelaiMoyenEncaissement(billingSchedule, payments) {
  const soldees = proActive(billingSchedule).filter((l) => l.statut === "encaisse" && l.dateCible);
  if (!soldees.length) return null;
  let sommeJours = 0;
  let sommeMontants = 0;
  soldees.forEach((l) => {
    const paiementsLies = proActive(payments).filter((p) => p.billingScheduleId === l.id);
    const montantPaye = paiementsLies.reduce((s, p) => s + proEuros(p.montant), 0);
    if (!paiementsLies.length || !montantPaye) return;
    const dateMoyenne = paiementsLies.reduce((s, p) => s + new Date(p.date).getTime() * proEuros(p.montant), 0) / montantPaye;
    const jours = (dateMoyenne - new Date(l.dateCible).getTime()) / 86400000;
    sommeJours += jours * montantPaye;
    sommeMontants += montantPaye;
  });
  return sommeMontants ? Math.round(sommeJours / sommeMontants) : null;
}

// Marge par mission : CA facturé de la mission moins ses dépenses NON
// refacturées (une dépense refacturée sort des charges : elle a été récupérée
// via le client, donc ne doit jamais être comptée deux fois).
function proMargeParMission(missionId, billingSchedule, expenses) {
  const ca = proActive(billingSchedule)
    .filter((l) => l.missionId === missionId && (l.statut === "facture" || l.statut === "encaisse" || l.type === "avoir"))
    .reduce((sum, l) => sum + proEuros(l.montantPrevu), 0);
  const charges = proActive(expenses)
    .filter((e) => e.missionId === missionId && e.statutRemboursement !== "refacture")
    .reduce((sum, e) => sum + proEuros(e.montantTTC), 0);
  if (!ca) return { ca: 0, charges, marge: -charges, tauxMarge: null };
  const marge = ca - charges;
  return { ca, charges, marge, tauxMarge: marge / ca };
}

// TJM vendu (déclaré au niveau de la mission) et TJM réellement obtenu (CA
// facturé / jours réellement passés, déduits du temps saisi).
function proTjmVendu(mission) {
  if (!mission) return null;
  if (mission.billingMode === "regie_journaliere") return proEuros(mission.soldDayRate) || null;
  if (mission.billingMode === "regie_horaire") return proEuros(mission.soldHourlyRate) * 8 || null;
  return null;
}

function proTjmObtenu(missionId, billingSchedule, timeEntries) {
  const ca = proActive(billingSchedule)
    .filter((l) => l.missionId === missionId && (l.statut === "facture" || l.statut === "encaisse"))
    .reduce((sum, l) => sum + proEuros(l.montantPrevu), 0);
  const joursPasses = proActive(timeEntries)
    .filter((t) => t.missionId === missionId)
    .reduce((sum, t) => sum + proEuros(t.durationMinutes) / 60 / 8, 0);
  if (!joursPasses) return null;
  return ca / joursPasses;
}

// Temps facturable / non facturable (minutes), et taux d'occupation sur une
// période : temps facturable / capacité théorique (jours ouvrés déclarés,
// jours fériés/congés déjà exclus par construction — la capacité vient d'une
// déclaration, jamais d'un calcul de calendrier ici pour rester pur).
function proTempsParFacturabilite(timeEntries) {
  const actives = proActive(timeEntries);
  const facturable = actives.filter((t) => t.billable).reduce((s, t) => s + proEuros(t.durationMinutes), 0);
  const nonFacturable = actives.filter((t) => !t.billable).reduce((s, t) => s + proEuros(t.durationMinutes), 0);
  return { facturableMinutes: facturable, nonFacturableMinutes: nonFacturable };
}

function proTauxOccupation(timeEntries, capaciteMinutesPeriode) {
  if (!capaciteMinutesPeriode) return null;
  const { facturableMinutes } = proTempsParFacturabilite(timeEntries);
  return facturableMinutes / capaciteMinutesPeriode;
}

// Reste à facturer / reste à encaisser.
function proResteAFacturer(quotes, billingSchedule) {
  return proCaSigne(quotes) - proCaFacture(billingSchedule);
}

function proResteAEncaisser(billingSchedule, payments) {
  return proCaFacture(billingSchedule) - proCaEncaisse(payments);
}

// Trésorerie disponible : décision non bloquante (§12.1) — saisie manuelle du
// solde dans les réglages, pas d'import bancaire dans cette phase.
function proTresorerieDisponible(settings) {
  return proEuros(settings?.tresorerieDisponible);
}

// Trésorerie prévisionnelle à horizon `jours` : disponible + encaissements
// attendus dans la fenêtre − dépenses prévues dans la fenêtre − provisions
// calculées sur ces encaissements. Un encaissement DÉJÀ rapproché n'est
// jamais recompté ici (proCaEncaisse n'entre pas dans cette formule — seules
// les lignes encore ouvertes comptent comme "attendues").
function proTresoreriePrevisionnelle(settings, billingSchedule, expenses, jours, today = iso(new Date())) {
  const limite = addDays(today, jours);
  const attendus = proActive(billingSchedule)
    .filter((l) => (l.statut === "prevu" || l.statut === "a_facturer") && l.dateCible && l.dateCible <= limite)
    .reduce((sum, l) => sum + proEuros(l.montantPrevu), 0);
  const provisionsAttendues = proProvisions(attendus, settings);
  return proTresorerieDisponible(settings) + attendus - provisionsAttendues;
}

// Provisions sociales/fiscales : taux paramétrable, laissé vide/nul par
// défaut (§12.6) — aucun barème imposé tant que Quentin ne l'a pas fourni.
function proProvisions(caEncaisse, settings) {
  const taux = settings?.tauxProvisionSocialesFiscales;
  if (taux == null) return 0;
  return caEncaisse * Number(taux);
}

// Concentration du CA par client (facturé), triée décroissante.
function proConcentrationCA(billingSchedule, missions) {
  const parClient = {};
  proActive(billingSchedule)
    .filter((l) => l.statut === "facture" || l.statut === "encaisse")
    .forEach((l) => {
      const mission = (missions || []).find((m) => m.id === l.missionId);
      const clientId = mission?.clientId || "inconnu";
      parClient[clientId] = (parClient[clientId] || 0) + proEuros(l.montantPrevu);
    });
  const total = Object.values(parClient).reduce((s, v) => s + v, 0);
  return Object.entries(parClient)
    .map(([clientId, montant]) => ({ clientId, montant, part: total ? montant / total : 0 }))
    .sort((a, b) => b.montant - a.montant);
}

// Carnet de commandes : CA signé non encore facturé, missions non closes.
function proCarnetCommandes(quotes, billingSchedule, missions) {
  const missionsOuvertes = new Set((missions || []).filter((m) => m.status !== "cloturee" && m.status !== "archivee").map((m) => m.id));
  const signe = (quotes || []).filter((q) => q.status === "accepted").reduce((sum, q) => sum + quoteTotal(q), 0);
  const factureMissionsOuvertes = proActive(billingSchedule)
    .filter((l) => (l.statut === "facture" || l.statut === "encaisse") && missionsOuvertes.has(l.missionId))
    .reduce((sum, l) => sum + proEuros(l.montantPrevu), 0);
  return signe - factureMissionsOuvertes;
}

// Revenu mensuel récurrent : missions en abonnement actives (non closes).
function proRevenuMensuelRecurrent(missions) {
  return proActive(missions)
    .filter((m) => m.billingMode === "abonnement" && m.status !== "cloturee" && m.status !== "archivee")
    .reduce((sum, m) => sum + proEuros(m.soldDayRate || m.soldHourlyRate), 0);
}

// Écart prévision/réalisé sur une période close : CA planifié théorique vs
// CA réellement facturé, uniquement sur les lignes dont dateCible est dans la
// période (bornes incluses).
function proEcartPrevisionRealise(billingSchedule, periodeDebut, periodeFin) {
  const dansLaPeriode = proActive(billingSchedule).filter(
    (l) => l.dateCible && l.dateCible >= periodeDebut && l.dateCible <= periodeFin
  );
  const prevu = dansLaPeriode.reduce((sum, l) => sum + proEuros(l.montantPrevu), 0);
  const realise = dansLaPeriode
    .filter((l) => l.statut === "facture" || l.statut === "encaisse")
    .reduce((sum, l) => sum + proEuros(l.montantPrevu), 0);
  return { prevu, realise, ecart: realise - prevu };
}
// === NEXORA:FINANCEPRO-CORE:END ===

// ---------------------------------------------------------------------------
// Lot 10 — Politique de confirmation/audit des écritures financières.
// CONÇUE MAIS NON ACTIVÉE (voir issue #277) : ces fonctions ne sont appelées
// nulle part dans l'application ni dans le MCP à ce stade. Elles reprennent
// le PATTERN déjà en place pour KDM360 (finance-transactions.ts,
// confirmationPolicy/recordAuditEvent), dupliqué en CODE uniquement — aucun
// partage d'infrastructure ni de données avec Supabase/KDM360.
// ---------------------------------------------------------------------------

// === NEXORA:FINANCEPRO-CONFIRM:START ===
const PRO_AUTO_COMMIT_AMOUNT_THRESHOLD = 200; // €
const PRO_AUTO_COMMIT_CONFIDENCE_THRESHOLD = 0.85;

// Actions qui ne peuvent JAMAIS s'exécuter automatiquement, quel que soit le
// montant ou la confiance — paiements, virements, suppressions, annulations.
const PRO_NEVER_AUTO_ACTIONS = new Set(["payment", "transfer", "delete", "cancel"]);

function proConfirmationPolicy({ action, amount, confidence, confirmed, allowAutoCommit }) {
  if (PRO_NEVER_AUTO_ACTIONS.has(action)) {
    return { committed: false, requiresConfirmation: true, reason: "action_never_automatic" };
  }
  const amountOk = proEuros(amount) <= PRO_AUTO_COMMIT_AMOUNT_THRESHOLD;
  const confidenceOk = (confidence == null ? 0 : Number(confidence)) >= PRO_AUTO_COMMIT_CONFIDENCE_THRESHOLD;
  if (confirmed === true) {
    return { committed: true, requiresConfirmation: false, reason: "explicit_confirmation" };
  }
  // `allowAutoCommit` reste désactivé par défaut (Lot 10, non activé) — même
  // quand amount/confidence seraient éligibles, aucune écriture n'est validée
  // sans qu'un lot ultérieur active explicitement ce chemin.
  if (allowAutoCommit === true && amountOk && confidenceOk) {
    return { committed: true, requiresConfirmation: false, reason: "auto_commit_eligible" };
  }
  const reason = !amountOk ? "unusual_amount_over_200_eur" : !confidenceOk ? "low_category_confidence" : "confirmation_required";
  return { committed: false, requiresConfirmation: true, reason };
}

// Journal d'audit — chaque écriture financière tracée (qui/quand/quoi),
// jamais un écrasement silencieux : `idempotencyKey` réutilisée sur retry.
function proRecordAuditEvent({ type, entityId, actor, idempotencyKey, before, after, at = new Date().toISOString() }) {
  return { type, entityId, actor: actor || "unknown", idempotencyKey, before: before || null, after: after || null, at };
}
// === NEXORA:FINANCEPRO-CONFIRM:END ===

// ============================================================================
// Interface — Finance PRO (destination de haut niveau, comme Devis/Factures).
// Composants UI : pas de duplication du moteur de tableau de bord (les KPI
// sont rendus ici en tuiles + barres simples, pas un second système de
// graphiques) — un widget dédié dans le moteur existant complète cette vue
// (voir WidgetFinanceProSynthese plus bas).
// ============================================================================

function proId() {
  return "pro" + Math.random().toString(36).slice(2, 10) + Date.now().toString(36);
}

function proNowIso() {
  return new Date().toISOString();
}

function proMissionLabel(mission, projects, quoteClients) {
  const project = (projects || []).find((p) => p.id === mission?.projectId);
  const client = (quoteClients || []).find((c) => c.id === mission?.clientId);
  return {
    projectName: project?.name || "Mission sans projet lié",
    clientName: client?.name || "Client non renseigné",
  };
}

function FinanceProStatTile({ label, value, sub, tone }) {
  return (
    <div className="lp-card" style={{ padding: "13px 14px", display: "flex", flexDirection: "column", gap: 6 }}>
      <div style={{ fontSize: 11, fontWeight: 700, color: "var(--text-muted)", textTransform: "uppercase", letterSpacing: ".04em" }}>{label}</div>
      <div style={{ fontSize: 21, fontWeight: 800 }}>{value}</div>
      {sub && <div style={{ fontSize: 11.5, fontWeight: 700, color: tone === "bad" ? "var(--danger)" : tone === "good" ? "var(--success)" : "var(--text-muted)" }}>{sub}</div>}
    </div>
  );
}

function FinanceProBarRow({ label, value, max, fmt }) {
  const pct = max > 0 ? Math.min(100, Math.round((value / max) * 100)) : 0;
  return (
    <div style={{ display: "grid", gridTemplateColumns: "140px 1fr 90px", alignItems: "center", gap: 8, fontSize: 12.5 }}>
      <span style={{ color: "var(--text-600)", fontWeight: 600 }}>{label}</span>
      <div style={{ height: 8, borderRadius: 4, background: "var(--border)", overflow: "hidden" }}>
        <div style={{ height: "100%", width: pct + "%", borderRadius: 4, background: "var(--accent)" }} />
      </div>
      <span style={{ textAlign: "right", fontWeight: 700 }}>{fmt ? fmt(value) : value}</span>
    </div>
  );
}

function fmtProEuros(n) {
  return proEuros(n).toLocaleString("fr-FR", { maximumFractionDigits: 0 }) + " €";
}

// ---------------------------------------------------------------------------
// Onglet 1 — Synthèse
// ---------------------------------------------------------------------------

function FinanceProSynthese({ quotes, proMissions, proBillingSchedule, proPayments, proTimeEntries, proExpenses, financeProSettings, projects, quoteClients }) {
  const caSigne = proCaSigne(quotes);
  const caFacture = proCaFacture(proBillingSchedule);
  const caEncaisse = proCaEncaisse(proPayments);
  const travailNonFacture = proTravailRealiseNonFacture(proTimeEntries, proExpenses);
  const enRetard = proFacturesEnRetard(proBillingSchedule);
  const resteAEncaisser = proResteAEncaisser(proBillingSchedule, proPayments);
  const { facturableMinutes, nonFacturableMinutes } = proTempsParFacturabilite(proTimeEntries);
  const totalMinutes = facturableMinutes + nonFacturableMinutes;
  const concentration = proConcentrationCA(proBillingSchedule, proMissions).slice(0, 5);

  return (
    <div style={{ display: "flex", flexDirection: "column", gap: 16 }}>
      <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fit, minmax(150px, 1fr))", gap: 12 }}>
        <FinanceProStatTile label="CA signé" value={fmtProEuros(caSigne)} sub={`Reste à facturer ${fmtProEuros(proResteAFacturer(quotes, proBillingSchedule))}`} />
        <FinanceProStatTile label="CA facturé" value={fmtProEuros(caFacture)} sub={caSigne ? `${Math.round((caFacture / caSigne) * 100)} % du signé` : null} tone="good" />
        <FinanceProStatTile label="CA encaissé" value={fmtProEuros(caEncaisse)} sub={`Reste à encaisser ${fmtProEuros(resteAEncaisser)}`} />
        <FinanceProStatTile label="Travail réalisé non facturé" value={fmtProEuros(travailNonFacture)} tone={travailNonFacture > 0 ? "bad" : "good"} />
        <FinanceProStatTile label="Factures en retard" value={enRetard.length} sub={enRetard.length ? fmtProEuros(enRetard.reduce((s, l) => s + proEuros(l.montantPrevu), 0)) + " en souffrance" : "Aucune"} tone={enRetard.length ? "bad" : "good"} />
        <FinanceProStatTile label="Temps facturable" value={totalMinutes ? Math.round((facturableMinutes / totalMinutes) * 100) + " %" : "—"} sub={totalMinutes ? null : "Aucune saisie"} />
      </div>

      <div className="lp-card" style={{ padding: 16, display: "flex", flexDirection: "column", gap: 10 }}>
        <div style={{ fontSize: 14.5, fontWeight: 700 }}>Concentration du chiffre d'affaires (facturé)</div>
        {concentration.length === 0 ? (
          <div className="lp-empty" style={{ padding: 16 }}>Aucune ligne facturée pour l'instant.</div>
        ) : (
          <div style={{ display: "flex", flexDirection: "column", gap: 8 }}>
            {concentration.map((c) => {
              const client = (quoteClients || []).find((cl) => cl.id === c.clientId);
              return (
                <FinanceProBarRow
                  key={c.clientId}
                  label={client?.name || "Non renseigné"}
                  value={c.montant}
                  max={concentration[0].montant}
                  fmt={() => `${fmtProEuros(c.montant)} (${Math.round(c.part * 100)} %)`}
                />
              );
            })}
          </div>
        )}
      </div>

      {enRetard.length > 0 && (
        <div className="lp-card" style={{ padding: 16, display: "flex", flexDirection: "column", gap: 10 }}>
          <div style={{ fontSize: 14.5, fontWeight: 700 }}>Factures en retard</div>
          <div className="lp-table-wrap"><table className="lp-table"><tbody>
            {enRetard.map((l) => {
              const mission = (proMissions || []).find((m) => m.id === l.missionId);
              const { projectName } = mission ? proMissionLabel(mission, projects, quoteClients) : { projectName: "—" };
              return (
                <tr key={l.id}>
                  <td>{l.dateCible}</td>
                  <td>{projectName} — {l.libelle}</td>
                  <td style={{ textAlign: "right", fontWeight: 700 }}>{fmtProEuros(l.montantPrevu)}</td>
                </tr>
              );
            })}
          </tbody></table></div>
        </div>
      )}
    </div>
  );
}

// ---------------------------------------------------------------------------
// Onglet 2 — Clients, missions et rentabilité (+ suivi du temps, Lot 2)
// ---------------------------------------------------------------------------

function FinanceProMissionFormModal({ mission, projects, quoteClients, onSave, onClose }) {
  const [form, setForm] = useState(() => mission && mission !== "new" ? { ...mission } : {
    id: proId(), projectId: "", clientId: "", quoteId: "", billingMode: "regie_journaliere",
    soldDayRate: "", soldHourlyRate: "", status: "prospect", createdAt: proNowIso(), updatedAt: proNowIso(),
    revision: 1, archivedAt: null, source: "manual",
  });
  const set = (patch) => setForm((f) => ({ ...f, ...patch }));
  return (
    <Modal title={mission && mission !== "new" ? "Modifier la mission" : "Nouvelle mission Finance PRO"} onClose={onClose} footer={
      <>
        <button className="lp-btn" onClick={onClose}>Annuler</button>
        <button className="lp-btn lp-btn-primary" onClick={() => { onSave({ ...form, updatedAt: proNowIso(), revision: (form.revision || 1) + 1 }); onClose(); }} disabled={!form.projectId || !form.clientId}>Enregistrer</button>
      </>
    }>
      <div style={{ display: "flex", flexDirection: "column", gap: 10 }}>
        <label className="lp-field">
          <span>Projet Nexora (mission)</span>
          <select className="lp-input" value={form.projectId} onChange={(e) => set({ projectId: e.target.value })}>
            <option value="">— Choisir un projet —</option>
            {(projects || []).map((p) => <option key={p.id} value={p.id}>{p.name}</option>)}
          </select>
        </label>
        <label className="lp-field">
          <span>Client</span>
          <select className="lp-input" value={form.clientId} onChange={(e) => set({ clientId: e.target.value })}>
            <option value="">— Choisir un client —</option>
            {(quoteClients || []).map((c) => <option key={c.id} value={c.id}>{c.name}</option>)}
          </select>
        </label>
        <label className="lp-field">
          <span>Mode de facturation</span>
          <select className="lp-input" value={form.billingMode} onChange={(e) => set({ billingMode: e.target.value })}>
            {PRO_BILLING_MODES.map((m) => <option key={m.key} value={m.key}>{m.label}</option>)}
          </select>
        </label>
        {form.billingMode === "regie_journaliere" && (
          <label className="lp-field"><span>TJM vendu (€/j)</span><input className="lp-input" type="number" value={form.soldDayRate} onChange={(e) => set({ soldDayRate: e.target.value })} /></label>
        )}
        {form.billingMode === "regie_horaire" && (
          <label className="lp-field"><span>Taux horaire vendu (€/h)</span><input className="lp-input" type="number" value={form.soldHourlyRate} onChange={(e) => set({ soldHourlyRate: e.target.value })} /></label>
        )}
        {form.billingMode === "abonnement" && (
          <label className="lp-field"><span>Montant mensuel (€)</span><input className="lp-input" type="number" value={form.soldDayRate} onChange={(e) => set({ soldDayRate: e.target.value })} /></label>
        )}
        <label className="lp-field">
          <span>Statut</span>
          <select className="lp-input" value={form.status} onChange={(e) => set({ status: e.target.value })}>
            {PRO_MISSION_STATUSES.map((s) => <option key={s.key} value={s.key}>{s.label}</option>)}
          </select>
        </label>
      </div>
    </Modal>
  );
}

function FinanceProTimeEntryFormModal({ entry, proMissions, projects, quoteClients, onSave, onClose }) {
  const [form, setForm] = useState(() => entry && entry !== "new" ? { ...entry } : {
    id: proId(), date: iso(new Date()), durationMinutes: 60, clientId: "", missionId: "", taskId: null,
    natureTemps: "production", billable: true, rateApplied: "", rateType: "horaire", comment: "",
    status: "brouillon", invoiceLineId: null, createdAt: proNowIso(), updatedAt: proNowIso(), revision: 1, archivedAt: null,
  });
  const set = (patch) => setForm((f) => ({ ...f, ...patch }));
  return (
    <Modal title={entry && entry !== "new" ? "Modifier la saisie de temps" : "Nouvelle saisie de temps"} onClose={onClose} footer={
      <>
        <button className="lp-btn" onClick={onClose}>Annuler</button>
        <button className="lp-btn lp-btn-primary" onClick={() => { const mission = (proMissions || []).find((m) => m.id === form.missionId); onSave({ ...form, clientId: mission?.clientId || form.clientId, updatedAt: proNowIso(), revision: (form.revision || 1) + 1 }); onClose(); }} disabled={!form.missionId}>Enregistrer</button>
      </>
    }>
      <div style={{ display: "flex", flexDirection: "column", gap: 10 }}>
        <label className="lp-field"><span>Date</span><input className="lp-input" type="date" value={form.date} onChange={(e) => set({ date: e.target.value })} /></label>
        <label className="lp-field">
          <span>Mission</span>
          <select className="lp-input" value={form.missionId} onChange={(e) => set({ missionId: e.target.value })}>
            <option value="">— Choisir une mission —</option>
            {(proMissions || []).map((m) => { const l = proMissionLabel(m, projects, quoteClients); return <option key={m.id} value={m.id}>{l.projectName} — {l.clientName}</option>; })}
          </select>
        </label>
        <label className="lp-field"><span>Durée (minutes)</span><input className="lp-input" type="number" value={form.durationMinutes} onChange={(e) => set({ durationMinutes: e.target.value })} /></label>
        <label className="lp-field">
          <span>Nature</span>
          <select className="lp-input" value={form.natureTemps} onChange={(e) => set({ natureTemps: e.target.value })}>
            {PRO_TIME_NATURES.map((n) => <option key={n.key} value={n.key}>{n.label}</option>)}
          </select>
        </label>
        <label className="lp-field" style={{ flexDirection: "row", alignItems: "center", gap: 8 }}>
          <input type="checkbox" checked={form.billable} onChange={(e) => set({ billable: e.target.checked })} /><span>Facturable</span>
        </label>
        {form.billable && (
          <>
            <label className="lp-field">
              <span>Type de taux</span>
              <select className="lp-input" value={form.rateType} onChange={(e) => set({ rateType: e.target.value })}>
                <option value="horaire">Horaire</option>
                <option value="journalier">Journalier</option>
              </select>
            </label>
            <label className="lp-field"><span>Taux appliqué (€)</span><input className="lp-input" type="number" value={form.rateApplied} onChange={(e) => set({ rateApplied: e.target.value })} /></label>
          </>
        )}
        <label className="lp-field">
          <span>Statut</span>
          <select className="lp-input" value={form.status} onChange={(e) => set({ status: e.target.value })} disabled={form.status === "facturee"}>
            {PRO_TIME_ENTRY_STATUSES.filter((s) => s.key !== "facturee").map((s) => <option key={s.key} value={s.key}>{s.label}</option>)}
          </select>
        </label>
        <label className="lp-field"><span>Commentaire</span><input className="lp-input" value={form.comment} onChange={(e) => set({ comment: e.target.value })} /></label>
      </div>
    </Modal>
  );
}

function FinanceProClientsView({ projects, quoteClients, quotes, proMissions, setProMissions, proTimeEntries, setProTimeEntries, proBillingSchedule, proExpenses }) {
  const [missionForm, setMissionForm] = useState(null);
  const [timeForm, setTimeForm] = useState(null);
  const [tab, setTab] = useState("missions");

  const saveMission = (m) => setProMissions((prev) => {
    const exists = prev.some((x) => x.id === m.id);
    return exists ? prev.map((x) => (x.id === m.id ? m : x)) : [...prev, m];
  });
  const archiveMission = (id) => setProMissions((prev) => prev.map((m) => (m.id === id ? { ...m, archivedAt: proNowIso() } : m)));

  const saveTimeEntry = (t) => setProTimeEntries((prev) => {
    const exists = prev.some((x) => x.id === t.id);
    return exists ? prev.map((x) => (x.id === t.id ? t : x)) : [...prev, t];
  });
  const archiveTimeEntry = (id) => setProTimeEntries((prev) => prev.map((t) => (t.id === id ? { ...t, archivedAt: proNowIso() } : t)));

  const missions = proActive(proMissions);
  const timeEntries = proActive(proTimeEntries).sort((a, b) => (b.date || "").localeCompare(a.date || ""));

  return (
    <div style={{ display: "flex", flexDirection: "column", gap: 16 }}>
      <div className="lp-toolbar" style={{ gap: 8 }}>
        <button className={"lp-btn" + (tab === "missions" ? " lp-btn-primary" : "")} onClick={() => setTab("missions")}>Missions</button>
        <button className={"lp-btn" + (tab === "temps" ? " lp-btn-primary" : "")} onClick={() => setTab("temps")}>Suivi du temps</button>
        <div style={{ flex: 1 }} />
        {tab === "missions" && <button className="lp-btn lp-btn-primary" onClick={() => setMissionForm("new")}><Plus size={13} style={{ marginRight: 4, verticalAlign: -2 }} />Nouvelle mission</button>}
        {tab === "temps" && <button className="lp-btn lp-btn-primary" onClick={() => setTimeForm("new")} disabled={!missions.length}><Plus size={13} style={{ marginRight: 4, verticalAlign: -2 }} />Nouvelle saisie</button>}
      </div>

      {tab === "missions" && (
        missions.length === 0 ? (
          <div className="lp-empty" style={{ padding: 30 }}>Aucune mission Finance PRO pour l'instant.</div>
        ) : (
          <div className="lp-table-wrap"><table className="lp-table"><thead><tr>
            <th>Mission</th><th>Client</th><th>Mode</th><th style={{ textAlign: "right" }}>CA facturé</th><th style={{ textAlign: "right" }}>Marge</th><th>Statut</th><th></th>
          </tr></thead><tbody>
            {missions.map((m) => {
              const { projectName, clientName } = proMissionLabel(m, projects, quoteClients);
              const marge = proMargeParMission(m.id, proBillingSchedule, proExpenses);
              const statusMeta = PRO_MISSION_STATUSES.find((s) => s.key === m.status) || PRO_MISSION_STATUSES[0];
              return (
                <tr key={m.id}>
                  <td style={{ fontWeight: 700 }}>{projectName}</td>
                  <td>{clientName}</td>
                  <td>{(PRO_BILLING_MODES.find((b) => b.key === m.billingMode) || {}).label}</td>
                  <td style={{ textAlign: "right" }}>{fmtProEuros(marge.ca)}</td>
                  <td style={{ textAlign: "right" }}>{marge.tauxMarge != null ? Math.round(marge.tauxMarge * 100) + " %" : "—"}</td>
                  <td><span style={{ color: statusMeta.color, fontWeight: 700 }}>{statusMeta.label}</span></td>
                  <td style={{ textAlign: "right" }}>
                    <button className="lp-icon-btn" title="Modifier" onClick={() => setMissionForm(m)}><Pencil size={14} /></button>
                    <button className="lp-icon-btn" title="Archiver" onClick={() => archiveMission(m.id)}><Trash2 size={14} /></button>
                  </td>
                </tr>
              );
            })}
          </tbody></table></div>
        )
      )}

      {tab === "temps" && (
        timeEntries.length === 0 ? (
          <div className="lp-empty" style={{ padding: 30 }}>Aucune saisie de temps pour l'instant.</div>
        ) : (
          <div className="lp-table-wrap"><table className="lp-table"><thead><tr>
            <th>Date</th><th>Mission</th><th>Nature</th><th style={{ textAlign: "right" }}>Durée</th><th>Facturable</th><th>Statut</th><th></th>
          </tr></thead><tbody>
            {timeEntries.map((t) => {
              const mission = missions.find((m) => m.id === t.missionId);
              const { projectName } = mission ? proMissionLabel(mission, projects, quoteClients) : { projectName: "Mission supprimée" };
              return (
                <tr key={t.id}>
                  <td>{t.date}</td>
                  <td>{projectName}</td>
                  <td>{(PRO_TIME_NATURES.find((n) => n.key === t.natureTemps) || {}).label}</td>
                  <td style={{ textAlign: "right" }}>{Math.round(proEuros(t.durationMinutes) / 60 * 10) / 10} h</td>
                  <td>{t.billable ? "Oui" : "Non"}</td>
                  <td>{(PRO_TIME_ENTRY_STATUSES.find((s) => s.key === t.status) || {}).label}</td>
                  <td style={{ textAlign: "right" }}>
                    <button className="lp-icon-btn" title="Modifier" onClick={() => setTimeForm(t)} disabled={t.status === "facturee"}><Pencil size={14} /></button>
                    <button className="lp-icon-btn" title="Archiver" onClick={() => archiveTimeEntry(t.id)} disabled={t.status === "facturee"}><Trash2 size={14} /></button>
                  </td>
                </tr>
              );
            })}
          </tbody></table></div>
        )
      )}

      {missionForm && <FinanceProMissionFormModal mission={missionForm} projects={projects} quoteClients={quoteClients} onSave={saveMission} onClose={() => setMissionForm(null)} />}
      {timeForm && <FinanceProTimeEntryFormModal entry={timeForm} proMissions={missions} projects={projects} quoteClients={quoteClients} onSave={saveTimeEntry} onClose={() => setTimeForm(null)} />}
    </div>
  );
}

// ---------------------------------------------------------------------------
// Onglet 3 — Factures et encaissements (planning de facturation)
// ---------------------------------------------------------------------------

function FinanceProBillingFormModal({ line, proMissions, projects, quoteClients, onSave, onClose }) {
  const [form, setForm] = useState(() => line && line !== "new" ? { ...line } : {
    id: proId(), missionId: "", quoteId: "", type: "jalon", libelle: "", montantPrevu: "",
    dateCible: iso(new Date()), statut: "prevu", invoiceId: null, createdAt: proNowIso(), updatedAt: proNowIso(),
    revision: 1, archivedAt: null,
  });
  const set = (patch) => setForm((f) => ({ ...f, ...patch }));
  return (
    <Modal title={line && line !== "new" ? "Modifier la ligne de facturation" : "Nouvelle ligne de facturation"} onClose={onClose} footer={
      <>
        <button className="lp-btn" onClick={onClose}>Annuler</button>
        <button className="lp-btn lp-btn-primary" onClick={() => { onSave({ ...form, updatedAt: proNowIso(), revision: (form.revision || 1) + 1 }); onClose(); }} disabled={!form.missionId || !form.libelle}>Enregistrer</button>
      </>
    }>
      <div style={{ display: "flex", flexDirection: "column", gap: 10 }}>
        <label className="lp-field">
          <span>Mission</span>
          <select className="lp-input" value={form.missionId} onChange={(e) => set({ missionId: e.target.value })}>
            <option value="">— Choisir une mission —</option>
            {(proMissions || []).map((m) => { const l = proMissionLabel(m, projects, quoteClients); return <option key={m.id} value={m.id}>{l.projectName} — {l.clientName}</option>; })}
          </select>
        </label>
        <label className="lp-field">
          <span>Type</span>
          <select className="lp-input" value={form.type} onChange={(e) => set({ type: e.target.value })}>
            {PRO_BILLING_LINE_TYPES.map((t) => <option key={t.key} value={t.key}>{t.label}</option>)}
          </select>
        </label>
        <label className="lp-field"><span>Libellé</span><input className="lp-input" value={form.libelle} onChange={(e) => set({ libelle: e.target.value })} /></label>
        <label className="lp-field"><span>Montant prévu (€) — négatif pour un avoir</span><input className="lp-input" type="number" value={form.montantPrevu} onChange={(e) => set({ montantPrevu: e.target.value })} /></label>
        <label className="lp-field"><span>Date cible</span><input className="lp-input" type="date" value={form.dateCible} onChange={(e) => set({ dateCible: e.target.value })} /></label>
        <label className="lp-field">
          <span>Statut</span>
          <select className="lp-input" value={form.statut} onChange={(e) => set({ statut: e.target.value })}>
            {PRO_BILLING_LINE_STATUSES.map((s) => <option key={s.key} value={s.key}>{s.label}</option>)}
          </select>
        </label>
      </div>
    </Modal>
  );
}

function FinanceProPaymentFormModal({ payment, proBillingSchedule, onSave, onClose }) {
  const [form, setForm] = useState(() => payment && payment !== "new" ? { ...payment } : {
    id: proId(), billingScheduleId: "", invoiceId: null, montant: "", date: iso(new Date()),
    moyen: "virement", statutRapprochement: "non_rapproche", partiel: false, createdAt: proNowIso(),
    updatedAt: proNowIso(), revision: 1, archivedAt: null,
  });
  const set = (patch) => setForm((f) => ({ ...f, ...patch }));
  return (
    <Modal title={payment && payment !== "new" ? "Modifier l'encaissement" : "Nouvel encaissement"} onClose={onClose} footer={
      <>
        <button className="lp-btn" onClick={onClose}>Annuler</button>
        <button className="lp-btn lp-btn-primary" onClick={() => { onSave({ ...form, updatedAt: proNowIso(), revision: (form.revision || 1) + 1 }); onClose(); }} disabled={!form.billingScheduleId || !proEuros(form.montant)}>Enregistrer</button>
      </>
    }>
      <div style={{ display: "flex", flexDirection: "column", gap: 10 }}>
        <label className="lp-field">
          <span>Ligne de facturation</span>
          <select className="lp-input" value={form.billingScheduleId} onChange={(e) => set({ billingScheduleId: e.target.value })}>
            <option value="">— Choisir —</option>
            {(proBillingSchedule || []).map((l) => <option key={l.id} value={l.id}>{l.libelle} ({fmtProEuros(l.montantPrevu)})</option>)}
          </select>
        </label>
        <label className="lp-field"><span>Montant (€)</span><input className="lp-input" type="number" value={form.montant} onChange={(e) => set({ montant: e.target.value })} /></label>
        <label className="lp-field"><span>Date</span><input className="lp-input" type="date" value={form.date} onChange={(e) => set({ date: e.target.value })} /></label>
        <label className="lp-field">
          <span>Moyen de paiement</span>
          <select className="lp-input" value={form.moyen} onChange={(e) => set({ moyen: e.target.value })}>
            {PRO_PAYMENT_METHODS.map((m) => <option key={m.key} value={m.key}>{m.label}</option>)}
          </select>
        </label>
        <label className="lp-field" style={{ flexDirection: "row", alignItems: "center", gap: 8 }}>
          <input type="checkbox" checked={form.statutRapprochement === "rapproche"} onChange={(e) => set({ statutRapprochement: e.target.checked ? "rapproche" : "non_rapproche" })} /><span>Rapproché</span>
        </label>
      </div>
    </Modal>
  );
}

function FinanceProBillingView({ projects, quoteClients, proMissions, proBillingSchedule, setProBillingSchedule, proPayments, setProPayments }) {
  const [lineForm, setLineForm] = useState(null);
  const [paymentForm, setPaymentForm] = useState(null);

  const saveLine = (l) => setProBillingSchedule((prev) => {
    const exists = prev.some((x) => x.id === l.id);
    return exists ? prev.map((x) => (x.id === l.id ? l : x)) : [...prev, l];
  });
  const archiveLine = (id) => setProBillingSchedule((prev) => prev.map((l) => (l.id === id ? { ...l, archivedAt: proNowIso() } : l)));
  const savePayment = (p) => setProPayments((prev) => {
    const exists = prev.some((x) => x.id === p.id);
    return exists ? prev.map((x) => (x.id === p.id ? p : x)) : [...prev, p];
  });

  const lines = proActive(proBillingSchedule).sort((a, b) => (a.dateCible || "").localeCompare(b.dateCible || ""));
  const missions = proActive(proMissions);
  const today = iso(new Date());
  const delaiMoyen = proDelaiMoyenEncaissement(proBillingSchedule, proPayments);

  return (
    <div style={{ display: "flex", flexDirection: "column", gap: 16 }}>
      <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fit, minmax(150px, 1fr))", gap: 12 }}>
        <FinanceProStatTile label="Reste à encaisser" value={fmtProEuros(proResteAEncaisser(proBillingSchedule, proPayments))} />
        <FinanceProStatTile label="Délai moyen d'encaissement" value={delaiMoyen != null ? delaiMoyen + " j" : "—"} />
        <FinanceProStatTile label="Factures en retard" value={proFacturesEnRetard(proBillingSchedule, today).length} />
      </div>

      <div className="lp-toolbar" style={{ gap: 8 }}>
        <div style={{ flex: 1, fontSize: 14.5, fontWeight: 700 }}>Planning de facturation</div>
        <button className="lp-btn" onClick={() => setPaymentForm("new")} disabled={!lines.length}><Plus size={13} style={{ marginRight: 4, verticalAlign: -2 }} />Encaissement</button>
        <button className="lp-btn lp-btn-primary" onClick={() => setLineForm("new")} disabled={!missions.length}><Plus size={13} style={{ marginRight: 4, verticalAlign: -2 }} />Ligne de facturation</button>
      </div>

      {lines.length === 0 ? (
        <div className="lp-empty" style={{ padding: 30 }}>{missions.length ? "Aucune ligne de facturation pour l'instant." : "Crée d'abord une mission (onglet Clients & missions)."}</div>
      ) : (
        <div className="lp-table-wrap"><table className="lp-table"><thead><tr>
          <th>Échéance</th><th>Mission</th><th>Libellé</th><th>Type</th><th style={{ textAlign: "right" }}>Montant</th><th>Statut</th><th></th>
        </tr></thead><tbody>
          {lines.map((l) => {
            const mission = missions.find((m) => m.id === l.missionId);
            const { projectName } = mission ? proMissionLabel(mission, projects, quoteClients) : { projectName: "Mission supprimée" };
            const statusMeta = PRO_BILLING_LINE_STATUSES.find((s) => s.key === l.statut) || PRO_BILLING_LINE_STATUSES[0];
            const late = (l.statut === "a_facturer" || l.statut === "facture") && l.dateCible && l.dateCible < today;
            return (
              <tr key={l.id}>
                <td style={{ color: late ? "var(--danger)" : "inherit", fontWeight: late ? 700 : 400 }}>{l.dateCible}</td>
                <td>{projectName}</td>
                <td>{l.libelle}</td>
                <td>{(PRO_BILLING_LINE_TYPES.find((t) => t.key === l.type) || {}).label}</td>
                <td style={{ textAlign: "right", fontWeight: 700 }}>{fmtProEuros(l.montantPrevu)}</td>
                <td><span style={{ color: statusMeta.color, fontWeight: 700 }}>{statusMeta.label}</span></td>
                <td style={{ textAlign: "right" }}>
                  <button className="lp-icon-btn" title="Modifier" onClick={() => setLineForm(l)}><Pencil size={14} /></button>
                  <button className="lp-icon-btn" title="Annuler" onClick={() => archiveLine(l.id)}><Trash2 size={14} /></button>
                </td>
              </tr>
            );
          })}
        </tbody></table></div>
      )}

      {lineForm && <FinanceProBillingFormModal line={lineForm} proMissions={missions} projects={projects} quoteClients={quoteClients} onSave={saveLine} onClose={() => setLineForm(null)} />}
      {paymentForm && <FinanceProPaymentFormModal payment={paymentForm} proBillingSchedule={lines} onSave={savePayment} onClose={() => setPaymentForm(null)} />}
    </div>
  );
}

// ---------------------------------------------------------------------------
// Onglet 4 — Dépenses et justificatifs
// ---------------------------------------------------------------------------

function FinanceProExpenseFormModal({ expense, proExpenseCategories, proMissions, projects, quoteClients, onSave, onClose }) {
  const [form, setForm] = useState(() => expense && expense !== "new" ? { ...expense } : {
    id: proId(), dateAchat: iso(new Date()), dateBancaire: null, fournisseur: "", montantHT: "", tva: 0,
    montantTTC: "", devise: "EUR", categoryId: "", moyenPaiement: "cb_pro", clientId: null, missionId: null,
    refacturable: false, justificatifUrl: "", statutRapprochement: "non_rapproche", statutRemboursement: "na",
    notes: "", externalId: null, createdAt: proNowIso(), updatedAt: proNowIso(), revision: 1, archivedAt: null,
  });
  const set = (patch) => setForm((f) => ({ ...f, ...patch }));
  const duplicateHash = proExpenseDedupeHash(form);
  return (
    <Modal title={expense && expense !== "new" ? "Modifier la dépense" : "Nouvelle dépense pro"} onClose={onClose} footer={
      <>
        <button className="lp-btn" onClick={onClose}>Annuler</button>
        <button className="lp-btn lp-btn-primary" onClick={() => { onSave({ ...form, dedupeHash: duplicateHash, updatedAt: proNowIso(), revision: (form.revision || 1) + 1 }); onClose(); }} disabled={!form.fournisseur || !proEuros(form.montantTTC)}>Enregistrer</button>
      </>
    }>
      <div style={{ display: "flex", flexDirection: "column", gap: 10 }}>
        <label className="lp-field"><span>Fournisseur</span><input className="lp-input" value={form.fournisseur} onChange={(e) => set({ fournisseur: e.target.value })} /></label>
        <label className="lp-field"><span>Date d'achat</span><input className="lp-input" type="date" value={form.dateAchat} onChange={(e) => set({ dateAchat: e.target.value })} /></label>
        <label className="lp-field"><span>Montant TTC (€)</span><input className="lp-input" type="number" value={form.montantTTC} onChange={(e) => set({ montantTTC: e.target.value, montantHT: e.target.value })} /></label>
        <label className="lp-field">
          <span>Catégorie</span>
          <select className="lp-input" value={form.categoryId} onChange={(e) => set({ categoryId: e.target.value })}>
            <option value="">— Choisir —</option>
            {proActive(proExpenseCategories).map((c) => <option key={c.id} value={c.id}>{c.label}</option>)}
          </select>
        </label>
        <label className="lp-field">
          <span>Moyen de paiement</span>
          <select className="lp-input" value={form.moyenPaiement} onChange={(e) => set({ moyenPaiement: e.target.value })}>
            {PRO_PAYMENT_METHODS.map((m) => <option key={m.key} value={m.key}>{m.label}</option>)}
          </select>
        </label>
        <label className="lp-field">
          <span>Mission liée (optionnel)</span>
          <select className="lp-input" value={form.missionId || ""} onChange={(e) => set({ missionId: e.target.value || null })}>
            <option value="">— Aucune —</option>
            {proActive(proMissions).map((m) => { const l = proMissionLabel(m, projects, quoteClients); return <option key={m.id} value={m.id}>{l.projectName} — {l.clientName}</option>; })}
          </select>
        </label>
        <label className="lp-field" style={{ flexDirection: "row", alignItems: "center", gap: 8 }}>
          <input type="checkbox" checked={form.refacturable} onChange={(e) => set({ refacturable: e.target.checked, statutRemboursement: e.target.checked ? "a_refacturer" : "na" })} /><span>Refacturable au client</span>
        </label>
        <label className="lp-field"><span>Justificatif (lien Drive)</span><input className="lp-input" value={form.justificatifUrl} onChange={(e) => set({ justificatifUrl: e.target.value })} /></label>
        <label className="lp-field" style={{ flexDirection: "row", alignItems: "center", gap: 8 }}>
          <input type="checkbox" checked={form.statutRapprochement === "rapproche"} onChange={(e) => set({ statutRapprochement: e.target.checked ? "rapproche" : "non_rapproche" })} /><span>Rapprochée</span>
        </label>
      </div>
    </Modal>
  );
}

function FinanceProExpensesView({ proExpenses, setProExpenses, proExpenseCategories, proMissions, projects, quoteClients }) {
  const [form, setForm] = useState(null);
  const [dupWarning, setDupWarning] = useState(null);

  const saveExpense = (e) => setProExpenses((prev) => {
    const hash = proExpenseDedupeHash(e);
    const duplicate = prev.find((x) => x.id !== e.id && !x.archivedAt && proExpenseDedupeHash(x) === hash);
    if (duplicate && !e.__confirmedDuplicate) {
      setDupWarning({ entry: e, duplicate });
      return prev;
    }
    const exists = prev.some((x) => x.id === e.id);
    return exists ? prev.map((x) => (x.id === e.id ? e : x)) : [...prev, e];
  });
  const archiveExpense = (id) => setProExpenses((prev) => prev.map((e) => (e.id === id ? { ...e, archivedAt: proNowIso() } : e)));

  const expenses = proActive(proExpenses).sort((a, b) => (b.dateAchat || "").localeCompare(a.dateAchat || ""));
  const total = expenses.reduce((s, e) => s + proEuros(e.montantTTC), 0);

  return (
    <div style={{ display: "flex", flexDirection: "column", gap: 16 }}>
      <div className="lp-toolbar" style={{ gap: 8 }}>
        <div style={{ flex: 1, fontSize: 14.5, fontWeight: 700 }}>Dépenses professionnelles — {fmtProEuros(total)} sur la période</div>
        <button className="lp-btn lp-btn-primary" onClick={() => setForm("new")}><Plus size={13} style={{ marginRight: 4, verticalAlign: -2 }} />Nouvelle dépense</button>
      </div>

      {expenses.length === 0 ? (
        <div className="lp-empty" style={{ padding: 30 }}>Aucune dépense pro pour l'instant.</div>
      ) : (
        <div className="lp-table-wrap"><table className="lp-table"><thead><tr>
          <th>Date</th><th>Fournisseur</th><th>Catégorie</th><th style={{ textAlign: "right" }}>TTC</th><th>Refacturable</th><th>Rapprochement</th><th></th>
        </tr></thead><tbody>
          {expenses.map((e) => {
            const cat = (proExpenseCategories || []).find((c) => c.id === e.categoryId);
            return (
              <tr key={e.id}>
                <td>{e.dateAchat}</td>
                <td style={{ fontWeight: 700 }}>{e.fournisseur}</td>
                <td>{cat?.label || "—"}</td>
                <td style={{ textAlign: "right" }}>{fmtProEuros(e.montantTTC)}</td>
                <td>{e.refacturable ? "Oui" : "Non"}</td>
                <td>{e.statutRapprochement === "rapproche" ? "Rapprochée" : "À rapprocher"}</td>
                <td style={{ textAlign: "right" }}>
                  <button className="lp-icon-btn" title="Modifier" onClick={() => setForm(e)}><Pencil size={14} /></button>
                  <button className="lp-icon-btn" title="Archiver" onClick={() => archiveExpense(e.id)}><Trash2 size={14} /></button>
                </td>
              </tr>
            );
          })}
        </tbody></table></div>
      )}

      {form && <FinanceProExpenseFormModal expense={form} proExpenseCategories={proExpenseCategories} proMissions={proMissions} projects={projects} quoteClients={quoteClients} onSave={saveExpense} onClose={() => setForm(null)} />}
      {dupWarning && (
        <Modal title="Doublon probable" onClose={() => setDupWarning(null)} footer={
          <>
            <button className="lp-btn" onClick={() => setDupWarning(null)}>Annuler</button>
            <button className="lp-btn lp-btn-primary" onClick={() => { saveExpense({ ...dupWarning.entry, __confirmedDuplicate: true }); setDupWarning(null); }}>Enregistrer quand même</button>
          </>
        }>
          <p style={{ fontSize: 13, color: "var(--text-600)" }}>
            Une dépense avec le même fournisseur, le même montant et la même date existe déjà
            ({dupWarning.duplicate.fournisseur}, {fmtProEuros(dupWarning.duplicate.montantTTC)}, {dupWarning.duplicate.dateAchat}).
            Confirmer pour l'enregistrer quand même.
          </p>
        </Modal>
      )}
    </div>
  );
}

// ---------------------------------------------------------------------------
// Onglet 5 — Trésorerie et prévisions
// ---------------------------------------------------------------------------

function FinanceProTreasuryView({ financeProSettings, setFinanceProSettings, proBillingSchedule, proExpenses, proPayments }) {
  const disponible = proTresorerieDisponible(financeProSettings);
  const prev30 = proTresoreriePrevisionnelle(financeProSettings, proBillingSchedule, proExpenses, 30);
  const prev60 = proTresoreriePrevisionnelle(financeProSettings, proBillingSchedule, proExpenses, 60);
  const prev90 = proTresoreriePrevisionnelle(financeProSettings, proBillingSchedule, proExpenses, 90);
  const provisions = proProvisions(proCaEncaisse(proPayments), financeProSettings);
  const seuil = proEuros(financeProSettings?.seuilTresorerieSecurite);
  const alerte = seuil > 0 && prev90 < seuil;

  return (
    <div style={{ display: "flex", flexDirection: "column", gap: 16 }}>
      <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fit, minmax(160px, 1fr))", gap: 12 }}>
        <FinanceProStatTile label="Trésorerie disponible" value={fmtProEuros(disponible)} />
        <FinanceProStatTile label="Prévisionnelle 30 j" value={fmtProEuros(prev30)} />
        <FinanceProStatTile label="Prévisionnelle 60 j" value={fmtProEuros(prev60)} />
        <FinanceProStatTile label="Prévisionnelle 90 j" value={fmtProEuros(prev90)} tone={alerte ? "bad" : "good"} sub={alerte ? `Sous le seuil de sécurité (${fmtProEuros(seuil)})` : (seuil > 0 ? "Au-dessus du seuil de sécurité" : null)} />
        <FinanceProStatTile label="Provisions (CA encaissé)" value={fmtProEuros(provisions)} sub={financeProSettings?.tauxProvisionSocialesFiscales == null ? "Taux non renseigné (réglages)" : `${Math.round(financeProSettings.tauxProvisionSocialesFiscales * 100)} % du CA encaissé`} />
      </div>

      <div className="lp-card" style={{ padding: 16, display: "flex", flexDirection: "column", gap: 10 }}>
        <div style={{ fontSize: 14.5, fontWeight: 700 }}>Réglages trésorerie</div>
        <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fit, minmax(200px, 1fr))", gap: 10 }}>
          <label className="lp-field"><span>Trésorerie disponible (€, saisie manuelle)</span>
            <input className="lp-input" type="number" value={financeProSettings?.tresorerieDisponible ?? 0}
              onChange={(e) => setFinanceProSettings((s) => ({ ...s, tresorerieDisponible: e.target.value, tresorerieDisponibleMiseAJour: proNowIso() }))} />
          </label>
          <label className="lp-field"><span>Seuil de sécurité (€)</span>
            <input className="lp-input" type="number" value={financeProSettings?.seuilTresorerieSecurite ?? 0}
              onChange={(e) => setFinanceProSettings((s) => ({ ...s, seuilTresorerieSecurite: e.target.value }))} />
          </label>
          <label className="lp-field"><span>Taux de provisions (%, optionnel)</span>
            <input className="lp-input" type="number" value={financeProSettings?.tauxProvisionSocialesFiscales != null ? Math.round(financeProSettings.tauxProvisionSocialesFiscales * 100) : ""}
              placeholder="Non renseigné"
              onChange={(e) => setFinanceProSettings((s) => ({ ...s, tauxProvisionSocialesFiscales: e.target.value === "" ? null : Number(e.target.value) / 100 }))} />
          </label>
        </div>
      </div>
    </div>
  );
}

// ---------------------------------------------------------------------------
// Vue racine — 5 onglets (docs/finance-pro/maquettes/finance-pro-maquettes.html)
// ---------------------------------------------------------------------------

const FINANCE_PRO_TABS = [
  { key: "synthese", label: "Synthèse" },
  { key: "clients", label: "Clients & missions" },
  { key: "factures", label: "Factures & encaissements" },
  { key: "depenses", label: "Dépenses & justificatifs" },
  { key: "tresorerie", label: "Trésorerie & prévisions" },
];

function FinanceProView(props) {
  const {
    projects, quoteClients, quotes,
    proMissions, setProMissions, proTimeEntries, setProTimeEntries,
    proExpenseCategories, setProExpenseCategories, proExpenses, setProExpenses,
    proBillingSchedule, setProBillingSchedule, proPayments, setProPayments,
    financeProSettings, setFinanceProSettings, toolbarSlot,
  } = props;
  const [tab, setTab] = useState("synthese");

  return (
    <div className="lp-quotes-wrap">
      <ViewToolbarPortal slot={toolbarSlot}>
        <div style={{ display: "flex", gap: 4 }}>
          {FINANCE_PRO_TABS.map((t) => (
            <button key={t.key} className={"lp-btn" + (tab === t.key ? " lp-btn-primary" : "")} onClick={() => setTab(t.key)}>{t.label}</button>
          ))}
        </div>
      </ViewToolbarPortal>

      {tab === "synthese" && (
        <FinanceProSynthese quotes={quotes} proMissions={proMissions} proBillingSchedule={proBillingSchedule} proPayments={proPayments} proTimeEntries={proTimeEntries} proExpenses={proExpenses} financeProSettings={financeProSettings} projects={projects} quoteClients={quoteClients} />
      )}
      {tab === "clients" && (
        <FinanceProClientsView projects={projects} quoteClients={quoteClients} quotes={quotes} proMissions={proMissions} setProMissions={setProMissions} proTimeEntries={proTimeEntries} setProTimeEntries={setProTimeEntries} proBillingSchedule={proBillingSchedule} proExpenses={proExpenses} />
      )}
      {tab === "factures" && (
        <FinanceProBillingView projects={projects} quoteClients={quoteClients} proMissions={proMissions} proBillingSchedule={proBillingSchedule} setProBillingSchedule={setProBillingSchedule} proPayments={proPayments} setProPayments={setProPayments} />
      )}
      {tab === "depenses" && (
        <FinanceProExpensesView proExpenses={proExpenses} setProExpenses={setProExpenses} proExpenseCategories={proExpenseCategories} proMissions={proMissions} projects={projects} quoteClients={quoteClients} />
      )}
      {tab === "tresorerie" && (
        <FinanceProTreasuryView financeProSettings={financeProSettings} setFinanceProSettings={setFinanceProSettings} proBillingSchedule={proBillingSchedule} proExpenses={proExpenses} proPayments={proPayments} />
      )}
    </div>
  );
}

// ---------------------------------------------------------------------------
// Widget de tableau de bord — synthèse Finance PRO dans le moteur existant
// (WIDGET_TYPE_META, part-003), sans créer de second système de dashboard.
// ---------------------------------------------------------------------------

function WidgetFinanceProSynthese({ quotes, proBillingSchedule, proPayments }) {
  const caSigne = proCaSigne(quotes);
  const caFacture = proCaFacture(proBillingSchedule);
  const caEncaisse = proCaEncaisse(proPayments);
  if (!caSigne && !caFacture && !caEncaisse) {
    return <div className="lp-empty" style={{ padding: 16 }}>Aucune donnée Finance PRO pour l'instant.</div>;
  }
  return (
    <div style={{ padding: 12, display: "flex", flexDirection: "column", gap: 8 }}>
      <FinanceProBarRow label="CA signé" value={caSigne} max={Math.max(caSigne, 1)} fmt={fmtProEuros} />
      <FinanceProBarRow label="CA facturé" value={caFacture} max={Math.max(caSigne, 1)} fmt={fmtProEuros} />
      <FinanceProBarRow label="CA encaissé" value={caEncaisse} max={Math.max(caSigne, 1)} fmt={fmtProEuros} />
    </div>
  );
}

// Widget Échéances Finance PRO — décision non bloquante (2026-09-22) : le
// widget `echeances` existant (WidgetEcheances/WidgetMetroDeadline, part-003)
// n'a pas de notion de catégorie et ne lit QUE le tableau `tasks` de
// l'application ; y injecter des échéances financières aurait exigé de
// modifier le pipeline de tâches partagé par toutes les vues, pour un widget
// qui n'a pas de concept de catégorie. Choix retenu : un widget dédié dans le
// MÊME moteur de dashboard existant (pas un second système), qui liste les
// échéances dérivées du planning de facturation — jamais un second calendrier
// séparé de l'application.
function WidgetFinanceProEcheances({ proBillingSchedule, proMissions, projects, quoteClients }) {
  const today = iso(new Date());
  const upcoming = proActive(proBillingSchedule)
    .filter((l) => l.statut !== "encaisse" && l.statut !== "annule" && l.dateCible)
    .sort((a, b) => (a.dateCible || "").localeCompare(b.dateCible || ""))
    .slice(0, 8);
  if (!upcoming.length) return <div className="lp-empty" style={{ padding: 16 }}>Aucune échéance de facturation à venir.</div>;
  return (
    <div className="lp-table-wrap" style={{ padding: 8 }}><table className="lp-table"><tbody>
      {upcoming.map((l) => {
        const mission = (proMissions || []).find((m) => m.id === l.missionId);
        const { projectName } = mission ? proMissionLabel(mission, projects, quoteClients) : { projectName: "—" };
        const late = l.dateCible < today;
        return (
          <tr key={l.id}>
            <td style={{ color: late ? "var(--danger)" : "inherit", fontWeight: late ? 700 : 400 }}>{l.dateCible}</td>
            <td>{projectName} — {l.libelle}</td>
            <td style={{ textAlign: "right", fontWeight: 700 }}>{fmtProEuros(l.montantPrevu)}</td>
          </tr>
        );
      })}
    </tbody></table></div>
  );
}
