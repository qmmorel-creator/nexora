:root[data-nexora-theme] #boot-screen { background-color: var(--nx-rm-0); }
:root[data-nexora-theme] #boot-screen p { color: var(--nx-rm-1); }
:root[data-nexora-theme] #boot-metro-loader::before { background-color: var(--nx-rm-2); }
:root[data-nexora-theme] #boot-metro-loader .boot-stop { background-color: var(--nx-rm-0); border-top-color: var(--nx-rm-3); border-right-color: var(--nx-rm-3); border-bottom-color: var(--nx-rm-3); border-left-color: var(--nx-rm-3); }
:root[data-nexora-theme] #boot-metro-loader .boot-train { background-color: var(--nx-rm-4); border-top-color: var(--nx-rm-5); border-right-color: var(--nx-rm-5); border-bottom-color: var(--nx-rm-5); border-left-color: var(--nx-rm-5); }
:root[data-nexora-theme] .lp-writing-mode-overlay { background-color: var(--nx-rm-6); }
:root[data-nexora-theme] .lp-writing-mode-shell { box-shadow: var(--nx-rm-7); }
:root[data-nexora-theme] .lp-writing-mode-textarea { box-shadow: var(--nx-rm-8); }
:root[data-nexora-theme] .b360-flow-label { stroke: var(--nx-rm-9); }
:root[data-nexora-theme] .b360-flow-name { fill: var(--nx-rm-a); }
:root[data-nexora-theme] .b360-flow-value { fill: var(--nx-rm-b); }
:root[data-nexora-theme] .b360-flow-node:focus > rect { stroke: var(--nx-rm-c); }
:root[data-nexora-theme] .b360-flow-ribbon:focus { stroke: var(--nx-rm-c); }
:root[data-nexora-theme] .nx-sankey-tools { color: var(--nx-rm-d); }
:root[data-nexora-theme] .nx-sankey-group { border-left: var(--nx-rm-e); }
:root[data-nexora-theme] .nx-sankey-tools button,
:root[data-nexora-theme] .nx-sankey-tools select,
:root[data-nexora-theme] .nx-sankey-tools input[type="month"],
:root[data-nexora-theme] .nx-sankey-tools input[type="number"] { border-top-color: var(--nx-rm-f); border-right-color: var(--nx-rm-f); border-bottom-color: var(--nx-rm-f); border-left-color: var(--nx-rm-f); background-color: var(--nx-rm-4); color: var(--nx-rm-d); }
:root[data-nexora-theme] .nx-sankey-tools button.active { background-color: var(--nx-rm-g); border-top-color: var(--nx-rm-h); border-right-color: var(--nx-rm-h); border-bottom-color: var(--nx-rm-h); border-left-color: var(--nx-rm-h); color: var(--nx-rm-i); }
:root[data-nexora-theme] .nx-sankey .sankey-footer { color: var(--nx-rm-j); }
:root[data-nexora-theme] .nx-sankey .sankey-footer button { border-top-color: var(--nx-rm-f); border-right-color: var(--nx-rm-f); border-bottom-color: var(--nx-rm-f); border-left-color: var(--nx-rm-f); background-color: var(--nx-rm-4); color: var(--nx-rm-d); }
:root[data-nexora-theme] .nx-sankey .sankey-data th,
