const iconCategory = (name) => {
  const n = String(name || "").toLowerCase();
  if (NEXORA_ICON_CATEGORY_OVERRIDES[name]) return NEXORA_ICON_CATEGORY_OVERRIDES[name];
  if (/calendar|clock|hourglass|history|alarm|timer|watch|sun|moon|week|month|date|time|stopwatch/.test(n)) return "temps";
  if (/alert|warning|danger|shield|bug|flame|skull|lock|ban|exclamation|report/.test(n)) return "alerte";
  if (/user|users|people|team|friends|man|woman|human|mood|face|person/.test(n)) return "personnes";
  if (/mail|message|chat|phone|brand|share|send|at|link|message|social|rss/.test(n)) return "communication";
  if (/file|folder|book|archive|clipboard|note|paper|document|file|files|forms/.test(n)) return "documents";
  if (/chart|graph|dashboard|report|analytics|presentation|activity|trend|gauge|report/.test(n)) return "pilotage";
  if (/map|pin|route|road|building|home|bridge|car|truck|plane|train|ship|bus|taxi|bike|motorcycle/.test(n)) return "transport & lieux";
  if (/mountain|hill|tree|forest|leaf|flower|plant|sun|cloud|snow|rain|wind|wave|water|droplet|earth|world|globe|volcano|camp|tent|palm|island|beach/.test(n)) return "nature";
  if (/dog|cat|fish|bird|bug|horse|cow|sheep|rabbit|paw|animal|bear|deer|duck|frog|turtle|whale|shark|butterfly/.test(n)) return "animaux";
  if (/football|soccer|basketball|tennis|golf|bike|bicycle|run|walk|swim|sport|trophy|medal|dumbbell|skate|ski|hockey|baseball|volleyball|rugby/.test(n)) return "sport";
  if (/camera|photo|image|film|video|music|microphone|speaker|headphone|radio|movie|tv|play|podcast|book|game|dice|cards/.test(n)) return "médias & loisirs";
  if (/shopping|cart|bag|store|shop|tag|barcode|qrcode|gift|cash|coin|wallet|credit|invoice|receipt|currency|bank|finance|chart|percent/.test(n)) return "commerce & finance";
  if (/food|restaurant|coffee|pizza|burger|cake|cookie|apple|bread|beer|wine|bottle|utensils|chef|fork|spoon|drink/.test(n)) return "alimentation";
  if (/heart|medical|health|hospital|pill|medicine|stethoscope|tooth|thermometer|first-aid|activity-heart|lungs|bone/.test(n)) return "santé";
  if (/hammer|wrench|tool|tools|saw|screw|drill|ruler|construction|crane|brick|paint|bucket|bolt|gear|settings|engine|machine|factory/.test(n)) return "construction & technique";
  if (/cpu|server|database|code|terminal|device|computer|laptop|phone|wifi|bluetooth|usb|cloud|network|api|binary|chip|memory|router/.test(n)) return "technologie";
  if (/microscope|flask|atom|dna|test|experiment|math|calculator|school|book|school|science/.test(n)) return "science & éducation";
  if (/house|home|bed|sofa|chair|lamp|door|key|bath|toilet|shower|kitchen|fridge|washing|plant|garden/.test(n)) return "maison";
  if (/git|branch|arrows|network|nodes|hierarchy|sitemap|join|split|route|workflow|dependency/.test(n)) return "réseau";
  if (/settings|tool|database|server|code|terminal|device|cpu|cloud|adjustments|filter|sort|search|menu/.test(n)) return "système";
  return "objets";
};
