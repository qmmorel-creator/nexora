const expandFrenchQuery = (q) => {
  const n = normalizeIconSearch(q);
  const words = n.split(/\s+/).filter(Boolean);
  const expansions = words.flatMap(w => [w, NEXORA_FR_SYNONYMS[w] || ""]);
  return normalizeIconSearch(expansions.join(" "));
};
const iconAliasForName = (name) => {
  const kebab = String(name || "");
  const camel = kebab.replace(/-([a-z])/g, (_, c) => c.toUpperCase());
  const parts = kebab.split("-");
  const base = parts[0];
  return [NEXORA_ICON_SEARCH_ALIASES[kebab], NEXORA_ICON_SEARCH_ALIASES[camel], NEXORA_ICON_SEARCH_ALIASES[base]].filter(Boolean).join(" ");
};
const iconSearchText = (name, label, cat) => normalizeIconSearch([name, label, cat, iconAliasForName(name)].join(" "));

