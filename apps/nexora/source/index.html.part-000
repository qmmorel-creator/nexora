// ============================================================================
// UI génériques
// ============================================================================
// Shared modal: nested dialogs restore the preceding dialog and its focus.
const nexoraModalStack = [];
function Modal({ title, onClose, children, footer, wide, extraWide, compact, className = "" }) {
  const titleId = React.useId();
  const panel = useRef(null);
  const close = useRef(onClose); close.current = onClose;
  const [host] = useState(() => { const el = document.createElement("div"); el.className = "lp-theme lp-modal-host"; return el; });
  useLayoutEffect(() => {
    const previous = document.activeElement;
    const theme = getComputedStyle(previous?.closest?.(".lp-modal-host, .lp-app") || document.querySelector(".lp-app") || document.body);
    for (const key of theme) if (key.startsWith("--")) host.style.setProperty(key, theme.getPropertyValue(key));
    document.body.appendChild(host);
    const siblings = [...document.body.children].filter(el => el !== host && !["SCRIPT", "STYLE", "LINK"].includes(el.tagName));
    const oldInert = siblings.map(el => [el, el.inert]);
    oldInert.forEach(([el]) => { el.inert = true; });
    nexoraModalStack.push(host);
    const oldOverflow = document.body.style.overflow;
    document.body.style.overflow = "hidden";
    const focusable = () => [...panel.current.querySelectorAll('button:not([disabled]), a[href], input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex="0"]')].filter(el => el.getClientRects().length && !el.closest('[inert]'));
    const initial = panel.current.querySelector('[autofocus]') || panel.current;
    initial.focus({ preventScroll: true });
    const onKey = e => {
      if (nexoraModalStack.at(-1) !== host || e.defaultPrevented) return;
      const nestedOpen = document.querySelector(".lp-dropdown-panel-portal, .lp-color-select-panel, .lp-quick-context-menu, .lp-activity-search-menu");
      if (nestedOpen) return;
      if (e.key === "Escape") { e.preventDefault(); e.stopImmediatePropagation(); close.current(); }
      if (e.key === "Tab") {
        const nodes = focusable(), first = nodes[0], last = nodes.at(-1);
        if (!first) { e.preventDefault(); panel.current.focus(); }
        else if (e.shiftKey && (document.activeElement === first || !nodes.includes(document.activeElement))) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && (document.activeElement === last || !nodes.includes(document.activeElement))) { e.preventDefault(); first.focus(); }
      }
    };
    document.addEventListener("keydown", onKey);
    return () => {
      document.removeEventListener("keydown", onKey);
      nexoraModalStack.splice(nexoraModalStack.indexOf(host), 1);
      oldInert.forEach(([el, value]) => { el.inert = value; });
      document.body.style.overflow = oldOverflow;
      host.remove();
      if (previous?.isConnected && !previous.closest('[inert]')) previous.focus({ preventScroll: true });
    };
  }, [host]);
  return createPortal(
    <div className="lp-overlay" onMouseDown={e => e.target === e.currentTarget && onClose()}>
      <div ref={panel} tabIndex={-1} role="dialog" aria-modal="true" aria-labelledby={titleId} className={"lp-modal" + (wide ? " lp-modal-wide" : "") + (extraWide ? " lp-modal-extra-wide" : "") + (compact ? " lp-modal-compact" : "") + (className ? " " + className : "")}>
        <div className="lp-modal-head">
          <h3 id={titleId}>{title}</h3>
          <button type="button" className="lp-icon-btn" aria-label="Fermer" onClick={onClose}><X size={18} /></button>
        </div>
        <div className="lp-modal-body">{children}</div>
        {footer && <div className="lp-modal-foot">{footer}</div>}
      </div>
    </div>, host
  );
}
function ConfirmModal({ title, message, danger, confirmLabel, onConfirm, onClose }) {
  return (
    <Modal
      title={title || "Confirmer"}
      onClose={onClose}
      compact
      footer={
        <>
          <button className="lp-btn" onClick={onClose}>Annuler</button>
          <button className={"lp-btn" + (danger ? " lp-btn-danger" : " lp-btn-primary")} onClick={onConfirm}>{confirmLabel || "Confirmer"}</button>
        </>
      }
    >
      <p style={{ margin: 0, fontSize: 13.5, color: "var(--text-900)", lineHeight: 1.5 }}>{message}</p>
    </Modal>
  );
}
function ToastStack({ toasts, onDismiss }) {
  if (!toasts.length) return null;
  return (
    <div className="lp-toast-stack">
      {toasts.map((t) => (
        <div className="lp-toast" key={t.id}>
          <span className="lp-toast-msg">{t.message}</span>
          {t.actionLabel && (
            <button className="lp-toast-action" onClick={() => { t.onAction && t.onAction(); onDismiss(t.id); }}>{t.actionLabel}</button>
          )}
          <button className="lp-toast-close" onClick={() => onDismiss(t.id)}><X size={13} /></button>
        </div>
      ))}
    </div>
  );
}
function ColorPicker({ value, onChange, palette }) {
  const swatches = palette || PALETTE;
  const isCustom = !swatches.includes(value);
  return (
    <div className="lp-color-row">
      {swatches.map((c) => (
        <button key={c} className={"lp-swatch" + (value === c ? " active" : "")} style={{ background: c }} onClick={() => onChange(c)} aria-label={c}>
          {value === c && <Check size={13} color={textOn(c)} />}
        </button>
      ))}
      <label className={"lp-swatch lp-swatch-custom-picker" + (isCustom ? " active" : "")} style={isCustom ? { background: value } : undefined} title="Choisir une couleur libre">
        {isCustom ? (value && <Check size={13} color={textOn(value)} />) : <Palette size={13} />}
        <input type="color" value={value} onChange={(e) => onChange(e.target.value)} />
      </label>
    </div>
  );
}
// Champ "Nom" réutilisable avec validation visuelle explicite (bordure rouge +
// message) plutôt qu'un échec silencieux au clic sur Enregistrer — utilisé par
// tous les petits formulaires de création/renommage (vues, dossiers, statuts…).
function NamedField({ label, value, onChange, error, onEnter, placeholder, autoFocus }) {
  return (
    <div className="lp-field">
      <label>{label}</label>
      <input
        type="text"
        value={value}
        onChange={(e) => onChange(e.target.value)}
        onKeyDown={(e) => e.key === "Enter" && onEnter && onEnter()}
        placeholder={placeholder}
        autoFocus={autoFocus}
        style={error ? { borderColor: "var(--danger)", boxShadow: "0 0 0 3px color-mix(in srgb, var(--danger) 14%, transparent)" } : undefined}
      />
      {error && <p style={{ fontSize: 11.5, color: "var(--danger)", margin: "5px 0 0", fontWeight: 600 }}>Ce champ est obligatoire.</p>}
    </div>
  );
}

function EmojiPicker({ value, onChange }) {
  return (
    <div className="lp-emoji-row">
      {EMOJIS.map((e) => <button key={e} className={"lp-emoji-btn" + (value === e ? " active" : "")} onClick={() => onChange(e)}>{e}</button>)}
    </div>
  );
}
// ============================================================================
// Bibliothèque d'icônes Nexora — 50 icônes Tabler sélectionnées pour les
// tâches, projets, vues, statuts, tableaux de bord, widgets et jalons.
// Les valeurs persistées utilisent uniquement le préfixe "tabler:" + le nom
// de l'icône ; aucun SVG n'est stocké dans Firebase. Tabler est MIT et ses SVG
// sont conçus pour être intégrés inline et stylés via currentColor.
// ============================================================================
const NEXORA_ICON_PRIORITY = [
  ["layout-dashboard", "Tableau de bord", "pilotage"], ["route", "Projet / réseau", "pilotage"],
  ["chart-gantt", "Gantt", "pilotage"], ["calendar", "Calendrier", "temps"], ["timeline", "Timeline", "temps"],
  ["radar", "Radar", "pilotage"], ["table", "Tableau", "pilotage"], ["calculator", "Chiffrage", "pilotage"],
  ["automation", "Automatisation", "pilotage"], ["bell", "Notification", "pilotage"], ["checklist", "Tâches", "travail"],
