const iconifySpec = (prefix, name, color = "") => `iconify:${prefix}/${name}${/^#[0-9a-fA-F]{6}$/.test(color || "") ? `|${color}` : ""}`;
const parseIconifySpec = (icon) => {
  if (typeof icon !== "string" || !icon.startsWith("iconify:")) return { prefix: "", name: "", color: "" };
  const raw = icon.slice(8);
  const [path, color] = raw.split("|");
  const slash = path.indexOf("/");
  return { prefix: slash > 0 ? path.slice(0, slash) : "", name: slash > 0 ? path.slice(slash + 1) : "", color: /^#[0-9a-fA-F]{6}$/.test(color || "") ? color : "" };
};
const iconifyUrl = (prefix, name, color = "", size = 64) => {
  const params = new URLSearchParams({ width: String(size), height: String(size) });
  if (/^#[0-9a-fA-F]{6}$/.test(color || "")) params.set("color", color);
  return `${NEXORA_ICONIFY_API}/${encodeURIComponent(prefix)}/${encodeURIComponent(name)}.svg?${params.toString()}`;
};
const humanizeIconifyName = (name) => String(name || "").replace(/-(16|20|24|28|32|48)$/, "").split("-").map(p => p ? p[0].toUpperCase() + p.slice(1) : "").join(" ");
const iconifySearchWords = (value) => {
  const normalized = normalizeIconSearch(value).trim();
  if (!normalized) return [];
  const words = normalized.split(/\s+/).filter(Boolean);
  return Array.from(new Set(words.flatMap(w => [w, ...(NEXORA_ICONIFY_SEARCH_ALIASES[w] || "").split(/\s+/)]).filter(Boolean))).slice(0, 12);
};

const parseTablerIconSpec = (icon) => {
  if (typeof icon !== "string" || !icon.startsWith("tabler:")) return { name: "", color: "" };
  const raw = icon.slice(7);
  const [name, color] = raw.split("|");
  return { name: name || "", color: /^#[0-9a-fA-F]{6}$/.test(color || "") ? color : "" };
};
const makeTablerIconSpec = (name, color) => `tabler:${name}${/^#[0-9a-fA-F]{6}$/.test(color || "") ? `|${color}` : ""}`;

// === NEXORA:ICON-URL:START ===
/* Icônes données par URL (issue #70).

   Le défaut réel : la fiche d'icône ACCEPTE l'URL avec une expression
   insensible à la casse, alors que le rendu la reconnaissait par
   startsWith("https://"), sensible à la casse. Une URL collée en « HTTPS:// »,
   ce que produisent certains presse-papiers et certains gestionnaires de liens,
   était donc enregistrée sans broncher puis rendue comme du TEXTE par le menu
   latéral. D'où des icônes qui marchent et d'autres non, sans motif apparent —
   « intermittent ou dépendant du format ».

   Les espaces autour comptent pour la même raison : un copier-coller depuis un
   document en ramène très souvent, et une URL précédée d'une espace ne
   commençait par rien de reconnu.

   Rend null quand ce n'est pas une URL d'image : c'est ce qui laisse les
   spécifications tabler:/iconify: et les emojis suivre leur propre chemin. */
function normalizeIconUrl(icon) {
  if (typeof icon !== "string") return null;
  const trimmed = icon.trim();
  if (!trimmed) return null;
  // data: restreint aux IMAGES : c'est une icône, et un data:text/html n'aurait
  // ici aucun sens qu'un repli ne traite déjà mieux.
  if (/^data:image\//i.test(trimmed)) return trimmed;
  if (/^https?:\/\//i.test(trimmed)) return trimmed;
  /* Protocole implicite : « //cdn.exemple/logo.png » est une URL parfaitement
     valide en HTML, et le menu latéral l'affichait en toutes lettres. */
  if (trimmed.startsWith("//")) return "https:" + trimmed;
  return null;
}

/* Ce que « Enregistrer » doit retenir de la fiche d'icône.

   La fiche garde le choix en cours dans un brouillon, et l'URL saisie a son
   propre champ. Une URL collée sans toucher la coche de validation n'entrait
   jamais dans le brouillon : « Enregistrer » l'enregistrait donc SANS elle, et
   l'entrée retombait sur son icône par défaut sans le moindre message. C'est
   l'autre moitié de #70, celle que la normalisation d'URL ne pouvait pas voir.

   Une URL en attente prime, parce que le champ est vidé dès que le choix vient
   d'ailleurs (une icône de la grille, « Retirer l'icône ») : son contenu est
   donc toujours la dernière chose que la personne a exprimée. */
function resolveIconChoice(draftIcon, customUrl) {
  if (normalizeIconUrl(customUrl)) return String(customUrl).trim();
  return draftIcon || null;
}
// === NEXORA:ICON-URL:END ===

/* Une icône d'URL, avec repli quand le chargement échoue VRAIMENT.

   L'échec est mémorisé PAR URL, et non par un simple booléen : changer l'URL
   d'une entrée doit retenter aussitôt, pas rester bloqué sur l'échec de la
   précédente. L'état vit dans ce composant, donc une icône cassée n'affecte
   aucune autre entrée du menu. Et rien n'est jamais réécrit dans les données :
   l'URL enregistrée survit à l'échec et sera retentée au prochain chargement. */
function IconUrlImage({ src, size, style }) {
  const [failedSrc, setFailedSrc] = useState(null);
  if (failedSrc === src) {
    /* Même encombrement que l'image attendue : le menu ne bouge pas d'un pixel.
       Et le repli se distingue d'une icône ordinaire — savoir que l'URL est en
       cause est plus utile qu'un trou. */
    return <ImageIcon size={size} style={{ flex: "0 0 auto", color: "var(--text-muted)", ...style }} aria-hidden="true" />;
  }
  return (
    <img
      src={src}
      alt=""
      onError={() => setFailedSrc(src)}
      referrerPolicy="no-referrer"
      style={{ width: size, height: size, borderRadius: 4, objectFit: "cover", ...style }}
    />
  );
}

// Résout un identifiant Tabler kebab-case (ex. alert-triangle)
// vers le composant React exporté par @tabler/icons-react (IconAlertTriangle).
// Cette fonction est volontairement définie avant IconGlyph : elle est appelée
// lors du rendu de toutes les icônes personnalisées.
function tablerComponent(name) {
  const pascal = String(name || "")
    .split("-")
    .filter(Boolean)
    .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
    .join("");
  return TablerIcons["Icon" + pascal] || null;
}

function IconGlyph
