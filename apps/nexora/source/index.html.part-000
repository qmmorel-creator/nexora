<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>Nexora</title>
  <link rel="icon" type="image/png" href="data:image/png;base64," />
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>

<script src="https://unpkg.com/@babel/standalone@7.24.7/babel.min.js"></script>
<style>
html,body,#root{height:100%;margin:0;}
#boot-screen{
  height:100%;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  gap:12px;
  font-family:'Inter',ui-sans-serif,system-ui,sans-serif;
  background:#F4F6FA;
  overflow:hidden;
}
#boot-logo-stage{
  width:190px;
  height:190px;
  display:grid;
  place-items:center;
}
#boot-logo-stage img{
  width:180px;
  height:180px;
  object-fit:contain;
}
#boot-screen p{
  color:#4B5567;
  font-size:11px;
  font-family:'Inter',ui-monospace,monospace;
  letter-spacing:.025em;
  margin:0;
}
#boot-metro-loader{
  position:relative;
  width:118px;
  height:14px;
  margin-top:2px;
}
#boot-metro-loader::before{
  content:"";
  position:absolute;
  left:0;
  right:0;
  top:6px;
  height:2px;
  border-radius:2px;
  background:#CBD3DF;
}
#boot-metro-loader .boot-stop{
  position:absolute;
  top:3px;
  width:8px;
  height:8px;
  box-sizing:border-box;
  border-radius:50%;
  background:#F4F6FA;
  border:2px solid #7C8798;
}
#boot-metro-loader .s1{left:0}
#boot-metro-loader .s2{left:55px}
#boot-metro-loader .s3{right:0}
#boot-metro-loader .boot-train{
  position:absolute;
  z-index:2;
  top:2px;
  left:-1px;
  width:10px;
  height:10px;
  border-radius:50%;
  background:#fff;
  border:2px solid #111827;
  box-sizing:border-box;
  animation:bootMetroTravel 1.8s ease-in-out infinite alternate;
}
@keyframes bootMetroTravel{
  from{transform:translateX(0)}
  to{transform:translateX(110px)}
}
@media (prefers-reduced-motion:reduce){
  #boot-metro-loader .boot-train{animation:none}
}

        .lp-callout-foldable{ overflow:hidden; }
        .lp-callout-summary{ cursor:pointer; list-style:none; user-select:none; }
        .lp-callout-summary::-webkit-details-marker{ display:none; }
        .lp-callout-summary::marker{ display:none; content:""; }
        .lp-callout-summary .lp-callout-chevron{
          margin-left:auto; font-size:16px; line-height:1; transform:rotate(0deg);
          transition:transform .14s ease; opacity:.65;
        }
        .lp-callout-foldable[open] .lp-callout-summary .lp-callout-chevron{ transform:rotate(90deg); }
        .lp-callout-foldable > .lp-callout-body{ padding-top:2px; }
        .lp-callout-task{
          display:flex;
          align-items:flex-start;
          margin:6px 0;
          cursor:pointer;
          color:var(--text-900);
          font-family:inherit;
          font-size:12.5px;
          font-weight:400;
          line-height:1.45;
          text-transform:none;
          letter-spacing:normal;
        }
        .lp-callout-task input[type="checkbox"]{
          width:15px;
          height:15px;
          margin:2px 10px 0 0;
          flex:0 0 15px;
          box-sizing:border-box;
          cursor:pointer;
        }
        .lp-callout-task span{
          flex:1;
          min-width:0;
          font-family:inherit;
          font-size:inherit;
          font-weight:400;
          text-transform:none;
          letter-spacing:normal;
        }
        .lp-callout-task.is-done span{
          text-decoration:line-through;
          color:var(--text-muted);
        }

        /* Menus déroulants : les résultats reviennent à la typographie de lecture
           standard, sans capitales ni espacement "signalétique". */
        .lp-color-select-option,
        .lp-task-picker-option,
        .lp-select-empty,
        .lp-checkbox-line,
        .cs-option,
        .lp-status-option,
        .lp-inline-chip-select .lp-color-select-panel button,
        .lp-filter-popover button,
        .lp-multi-select-panel button,
        .lp-multiselect-panel button{
          font-family:var(--font-body) !important;
          text-transform:none !important;
          letter-spacing:normal !important;
          font-weight:500 !important;
        }
        .lp-color-select-option *,
        .lp-task-picker-option *,
        .lp-checkbox-line *,
        .cs-option *,
        .lp-status-option *{
          text-transform:none !important;
          letter-spacing:normal !important;
        }

        /* Fiche tâche : actions plus compactes */
        .lp-task-modal-actions-compact{
          display:flex;
          align-items:center;
          gap:5px;
          flex-wrap:wrap;
        }
        .lp-task-modal-actions-compact .lp-btn{
          min-height:29px;
          padding:5px 8px;
          font-size:10.5px;
          border-radius:6px;
          white-space:nowrap;
        }
        .lp-task-modal-actions-compact .lp-btn svg{
          width:12px;
          height:12px;
        }
        .lp-task-modal-actions-primary{margin-left:auto}

        .lp-writing-mode-launch{
          display:inline-flex;
          align-items:center;
          gap:5px;
          min-height:27px;
          padding:4px 7px;
          border:1px solid var(--border);
          border-radius:6px;
          background:var(--surface);
          color:var(--text-700);
          font-family:var(--font-body);
          font-size:10.5px;
          font-weight:650;
          cursor:pointer;
        }
        .lp-writing-mode-launch:hover{
          background:var(--paper-soft);
          border-color:var(--text-500);
        }

        /* Mode écriture dédié */
        .lp-writing-mode-overlay{
          position:fixed;
          inset:0;
          z-index:100000;
          display:flex;
          align-items:stretch;
          justify-content:stretch;
          padding:6px;
          background:rgba(15,23,42,.46);
          backdrop-filter:blur(3px);
        }
        .lp-writing-mode-shell{
          width:100%;
          height:100%;
          min-width:0;
          min-height:0;
          display:grid;
          grid-template-rows:auto auto minmax(0,1fr);
          background:var(--surface);
          border:1px solid var(--border);
          border-radius:10px;
          box-shadow:0 18px 60px rgba(15,23,42,.22);
          overflow:hidden;
        }
        .lp-writing-mode-head{
          display:grid;
          grid-template-columns:minmax(220px,1fr) auto auto;
          gap:14px;
          align-items:center;
          padding:12px 16px;
          border-bottom:1px solid var(--border);
          background:var(--surface);
        }
        .lp-writing-mode-titleblock{min-width:0}
        .lp-writing-mode-kicker{
          display:flex;align-items:center;gap:6px;
          font-size:9.5px;font-weight:750;color:var(--text-muted);
          text-transform:uppercase;letter-spacing:.04em;
        }
        .lp-writing-mode-title{
          margin-top:2px;
          font-size:17px;font-weight:760;color:var(--text-primary);
          white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
        }
        .lp-writing-mode-meta{
          display:flex;align-items:center;justify-content:center;
          gap:5px;flex-wrap:wrap;max-width:520px;
        }
        .lp-writing-mode-chip{
          display:inline-flex;align-items:center;gap:5px;
          min-height:24px;padding:3px 7px;
          border:1px solid var(--border);
          border-radius:999px;
          background:var(--paper-soft);
          color:var(--text-700);
          font-family:var(--font-body);
          font-size:9.5px;font-weight:550;
          white-space:nowrap;
        }
        .lp-writing-mode-dot{width:7px;height:7px;border-radius:50%;flex:0 0 auto}
        .lp-writing-mode-actions{display:flex;align-items:center;gap:7px}
        .lp-writing-mode-toolbar{
          display:flex;align-items:center;gap:5px;flex-wrap:wrap;
          padding:7px 16px;
          border-bottom:1px solid var(--border);
          background:var(--paper-soft);
        }
        .lp-writing-mode-editor{
          min-width:0;
          min-height:0;
          padding:12px 14px 14px;
          overflow:hidden;
          background:var(--surface);
        }
        .lp-writing-mode-textarea,
        .lp-writing-mode-preview{
          width:100%;
          height:100%;
          min-height:0;
          box-sizing:border-box;
          border:0;
          outline:none;
          resize:none;
          background:var(--surface);
          color:var(--text-primary);
          font-family:var(--font-body);
          font-size:15px;
          line-height:1.7;
          padding:18px 22px;
          border-radius:9px;
        }
        .lp-writing-mode-textarea{
          border:1px solid var(--border);
          box-shadow:inset 0 1px 1px rgba(15,23,42,.02);
        }
        .lp-writing-mode-preview{
          overflow:auto;
          border:1px solid var(--border);
        }

        /* Accès rapide depuis le widget Tâche détaillée */
        .lp-task-detail-writing-btn{
          width:28px;height:28px;flex:0 0 28px;
          display:inline-flex;align-items:center;justify-content:center;
          border:1px solid var(--border);
          border-radius:7px;
          background:var(--surface);
          color:var(--text-600);
          cursor:pointer;
        }
        .lp-task-detail-writing-btn:hover{
          color:var(--line-blue);
          border-color:color-mix(in srgb,var(--line-blue) 45%,var(--border));
          background:color-mix(in srgb,var(--line-blue) 5%,var(--surface));
        }

        @media(max-width:820px){
          .lp-writing-mode-overlay{padding:2px}
          .lp-writing-mode-shell{
            width:100%;
            height:100%;
            min-height:0;
            border-radius:7px;
          }
          .lp-writing-mode-head{
            grid-template-columns:1fr auto;
          }
          .lp-writing-mode-meta{
            grid-column:1/-1;
            grid-row:2;
            justify-content:flex-start;
            max-width:none;
          }
          .lp-writing-mode-actions{grid-column:2;grid-row:1}
          .lp-writing-mode-editor{padding:10px}
          .lp-writing-mode-textarea,.lp-writing-mode-preview{font-size:14px;padding:12px}
        }

        .lp-full-backup-pane{display:flex;flex-direction:column;gap:12px}
        .lp-full-backup-intro{
          margin:-6px 0 2px;
          color:var(--text-600);
          font-size:12px;
          line-height:1.55;
        }
        .lp-full-backup-grid{
          display:grid;
          grid-template-columns:repeat(2,minmax(0,1fr));
          gap:10px;
        }
        .lp-full-backup-card{
          display:flex;
          flex-direction:column;
          gap:9px;
          min-width:0;
          padding:12px;
          border:1px solid var(--border);
          border-radius:10px;
          background:var(--surface);
        }
        .lp-full-backup-card-title{
          display:flex;align-items:center;gap:7px;
          font-size:12.5px;font-weight:780;color:var(--text-900);
        }
        .lp-full-backup-card-copy{
          color:var(--text-600);
          font-size:11px;
          line-height:1.5;
        }
        .lp-full-backup-actions{display:flex;gap:7px;flex-wrap:wrap}
        .lp-full-backup-preview{
          padding:8px 9px;
          border:1px solid var(--border);
          border-radius:7px;
          background:var(--paper-soft);
          font-size:10.5px;
          color:var(--text-600);
          line-height:1.45;
        }
        .lp-full-backup-preview strong{color:var(--text-900)}
        .lp-full-backup-mode{display:flex;flex-direction:column;gap:6px}
        .lp-full-backup-mode label{
          display:flex;align-items:flex-start;gap:8px;
          padding:8px;
          border:1px solid var(--border);
          border-radius:7px;
          cursor:pointer;
          background:var(--surface);
        }
        .lp-full-backup-mode label:has(input:checked){
          border-color:color-mix(in srgb,var(--line-blue) 45%,var(--border));
          background:color-mix(in srgb,var(--line-blue) 4%,var(--surface));
        }
        .lp-full-backup-mode span{display:flex;flex-direction:column;gap:2px}
        .lp-full-backup-mode strong{font-size:11px}
        .lp-full-backup-mode small{font-size:9.5px;color:var(--text-600);line-height:1.4}
        .lp-full-backup-error{
          padding:8px 9px;
          border:1px solid color-mix(in srgb,var(--danger) 35%,var(--border));
          border-radius:7px;
          color:var(--danger-text);
          background:color-mix(in srgb,var(--danger) 5%,var(--surface));
          font-size:10.5px;
          line-height:1.45;
        }
        .lp-full-backup-note{
          padding:9px 11px;
          border-left:3px solid var(--line-blue);
          background:color-mix(in srgb,var(--line-blue) 5%,var(--surface));
          color:var(--text-600);
          font-size:10.5px;
          line-height:1.5;
        }
        .lp-snapshot-list{
          display:flex;
          flex-direction:column;
          gap:6px;
          max-height:260px;
          overflow-y:auto;
        }
        .lp-snapshot-row{
          display:flex;
          align-items:center;
          justify-content:space-between;
          gap:10px;
          padding:7px 9px;
          border:1px solid var(--border);
          border-radius:7px;
          background:var(--paper-soft);
        }
        .lp-snapshot-row-info{
          display:flex;
          flex-direction:column;
          gap:2px;
          font-size:11px;
        }
        .lp-snapshot-row-info span{
          color:var(--text-600);
          font-size:10px;
        }
        .lp-snapshot-confirm{
          display:flex;
          align-items:center;
          gap:6px;
        }
        .lp-snapshot-confirm select{
          font-size:10.5px;
          padding:3px 5px;
          border-radius:6px;
          border:1px solid var(--border);
        }
        @media(max-width:900px){
          .lp-full-backup-grid{grid-template-columns:1fr}
        }

        .lp-widget.dragging,
        .lp-widget.is-dragging{
          transition:none !important;
        }
        .lp-widget-resize-handle{
          touch-action:none;
          user-select:none;
        }
        body:has(.lp-widget.dragging),
        body:has(.lp-widget.is-dragging){
          user-select:none;
        }

        .lp-widget-resize-handle{
          width:22px !important;
          height:22px !important;
          z-index:40 !important;
          touch-action:none !important;
        }
        .lp-widget-resize-tl{left:-2px !important;top:-2px !important}
        .lp-widget-resize-tr{right:-2px !important;top:-2px !important}
        .lp-widget-resize-bl{left:-2px !important;bottom:-2px !important}
        .lp-widget-resize-br{right:-2px !important;bottom:-2px !important}
        .lp-widget-card-dragging .lp-widget-body{
          pointer-events:none;
        }

        .lp-widget-head{
          touch-action:none;
        }
        .lp-widget-card-dragging{
          transition:none !important;
        }

        .lp-widget-note-rich{
          height:100%;
          min-height:0;
          display:grid;
          grid-template-rows:auto auto minmax(0,1fr);
          gap:7px;
          outline:none;
        }
        .lp-widget-note-toolbar{
          display:flex;
          align-items:center;
          justify-content:space-between;
          gap:7px;
          flex-wrap:wrap;
        }
        .lp-widget-note-markdown-tools{
          display:flex;
          align-items:center;
          gap:5px;
          flex-wrap:wrap;
          padding:5px 0 1px;
        }
        .lp-widget-note-editor{
          min-height:0;
          overflow:hidden;
        }
        .lp-widget-note-markdown-edit{
          width:100% !important;
          height:100% !important;
          min-height:0 !important;
          box-sizing:border-box;
          resize:none;
          font-family:var(--font-body);
          line-height:1.55;
        }
        .lp-widget-note-preview{
          width:100%;
          height:100%;
          min-height:0;
          overflow:auto;
          box-sizing:border-box;
          padding:9px 10px;
          border:1px solid var(--border);
          border-radius:8px;
          background:var(--surface);
          color:var(--text-primary);
          line-height:1.55;
        }
        .lp-widget-note-preview p:first-child{margin-top:0}
        .lp-widget-note-preview p:last-child{margin-bottom:0}
</style>

<style id="nexora-icon-picker-v24-layout">
/* v24 — conteneur du sélecteur d'icônes : aucune zone ne déborde */
.nexora-icon-editor-panel-v16.lp-dropdown-panel-portal{
  position:fixed!important;
  top:10px!important;
  left:50%!important;
  right:auto!important;
  bottom:auto!important;
  transform:translateX(-50%)!important;
  width:min(1320px,calc(100vw - 28px))!important;
  max-width:calc(100vw - 28px)!important;
  height:calc(100vh - 20px)!important;
  max-height:calc(100vh - 20px)!important;
  min-height:0!important;
  box-sizing:border-box!important;
  padding:0!important;
  overflow:hidden!important;
}
.nexora-icon-editor-panel-v16 .nexora-icon-editor-shell{
  height:100%!important;
  min-height:0!important;
  max-height:none!important;
  box-sizing:border-box!important;
  overflow:hidden!important;
  grid-template-columns:250px minmax(0,1fr)!important;
}
.nexora-icon-editor-panel-v16 .nexora-icon-editor-main{
  height:100%!important;
  min-height:0!important;
  max-height:none!important;
  box-sizing:border-box!important;
  overflow:hidden!important;
  display:grid!important;
  grid-template-rows:58px minmax(0,1fr) 42px 58px!important;
}
.nexora-icon-editor-panel-v16 .nexora-icon-editor-head{
  min-height:0!important;
  height:58px!important;
  box-sizing:border-box!important;
  overflow:hidden!important;
  padding:9px 14px!important;
}
.nexora-icon-editor-panel-v16 .nexora-icon-editor-grid{
  box-sizing:border-box!important;
  min-width:0!important;
  min-height:0!important;
  width:100%!important;
  height:100%!important;
  max-height:100%!important;
  display:grid!important;
  grid-template-rows:repeat(14,42px)!important;
  grid-auto-flow:column!important;
  grid-auto-columns:42px!important;
  grid-template-columns:none!important;
  align-content:start!important;
  justify-content:start!important;
  gap:6px!important;
  padding:10px 14px!important;
  overflow-x:auto!important;
  overflow-y:hidden!important;
  flex:none!important;
}
.nexora-icon-editor-panel-v16 .nexora-icon-option{
  width:40px!important;
  height:40px!important;
  min-width:40px!important;
  min-height:40px!important;
  padding:0!important;
  margin:0!important;
  border-radius:8px!important;
}
.nexora-icon-editor-panel-v16 .nexora-icon-option svg{width:22px!important;height:22px!important;}
.nexora-icon-editor-panel-v16 .nexora-icon-pagination{
  height:42px!important;
  min-height:42px!important;
  max-height:42px!important;
  box-sizing:border-box!important;
  overflow:hidden!important;
  display:flex!important;
  align-items:center!important;
  justify-content:center!important;
  padding:5px 12px!important;
  gap:4px!important;
  white-space:nowrap!important;
}
.nexora-icon-editor-panel-v16 .nexora-icon-page-btn{
  flex:0 0 auto!important;
  width:27px!important;
  min-width:27px!important;
  height:27px!important;
}
.nexora-icon-editor-panel-v16 .nexora-icon-footer{
  height:58px!important;
  min-height:58px!important;
  max-height:58px!important;
  box-sizing:border-box!important;
  overflow:hidden!important;
  display:flex!important;
  align-items:center!important;
  justify-content:flex-end!important;
  padding:9px 14px!important;
}
.nexora-icon-editor-panel-v16 .nexora-icon-footer > div{
  flex:0 0 auto!important;
  display:flex!important;
  align-items:center!important;
  gap:8px!important;
}
.nexora-icon-editor-panel-v16 .nexora-icon-footer .nexora-icon-save-bottom{
  display:inline-flex!important;
  visibility:visible!important;
  opacity:1!important;
  min-width:130px!important;
  height:36px!important;
  flex:0 0 auto!important;
  background:var(--nexora-icon-accent,var(--accent))!important;
  border-color:var(--nexora-icon-accent,var(--accent))!important;
  color:#fff!important;
}
.nexora-icon-editor-panel-v16 .nexora-icon-editor-side{
  min-height:0!important;
  max-height:100%!important;
  overflow:hidden!important;
  box-sizing:border-box!important;
}
@media(max-height:820px) and (min-width:761px){
  .nexora-icon-editor-panel-v16 .nexora-icon-editor-grid{
    grid-template-rows:repeat(12,42px)!important;
  }
}
@media(max-height:700px) and (min-width:761px){
  .nexora-icon-editor-panel-v16 .nexora-icon-editor-grid{
    grid-template-rows:repeat(10,42px)!important;
  }
}
@media(max-width:760px){
  .nexora-icon-editor-panel-v16.lp-dropdown-panel-portal{
    top:6px!important;
    width:calc(100vw - 12px)!important;
    max-width:calc(100vw - 12px)!important;
    height:calc(100vh - 12px)!important;
    max-height:calc(100vh - 12px)!important;
  }
  .nexora-icon-editor-panel-v16 .nexora-icon-editor-shell{grid-template-columns:150px minmax(0,1fr)!important;}
  .nexora-icon-editor-panel-v16 .nexora-icon-editor-main{grid-template-rows:54px minmax(0,1fr) 40px 54px!important;}
  .nexora-icon-editor-panel-v16 .nexora-icon-editor-head{height:54px!important;}
  .nexora-icon-editor-panel-v16 .nexora-icon-editor-grid{grid-template-rows:repeat(10,40px)!important;grid-auto-columns:40px!important;gap:5px!important;padding:8px!important;}
  .nexora-icon-editor-panel-v16 .nexora-icon-option{width:38px!important;height:38px!important;min-width:38px!important;min-height:38px!important;}
  .nexora-icon-editor-panel-v16 .nexora-icon-footer{height:54px!important;min-height:54px!important;max-height:54px!important;}
}
</style>
<style>
/* Icon picker v28 — la grille doit rester entièrement visible sans recherche */
