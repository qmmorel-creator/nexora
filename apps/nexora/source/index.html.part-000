<script type="text/babel" data-type="module" data-presets="react">
import React, { useState, useRef, useEffect, useLayoutEffect, useMemo, useCallback } from 'https://esm.sh/react@18.2.0';
import { createRoot } from 'https://esm.sh/react-dom@18.2.0/client';
import { createPortal } from 'https://esm.sh/react-dom@18.2.0';
import * as TablerIcons from 'https://esm.sh/@tabler/icons-react@3.46.0?deps=react@18.2.0';
import Papa from 'https://esm.sh/papaparse@5.4.1';
import {
  Plus, X, ChevronDown, ChevronUp, ChevronRight, List, Columns3, BarChart3,
  Milestone, Trash2, Settings, FolderPlus, Check, Pencil,
  SlidersHorizontal, Layers, Palette, Crosshair, Upload, Image as ImageIcon,
  Maximize2, ChevronsDown, ChevronsUp, Bookmark, FileUp, AlertTriangle,
  Folder, GripVertical, CheckCircle2, Lock, Eraser, RefreshCw, User, CalendarClock,
  Wand2, Search, SearchCheck, SearchX, Download, Zap, Network, Copy, Smile,
  Hash, StickyNote, Wallet, Scale, GanttChartSquare, TrainTrack, GitBranch,
  Activity, Sunrise, TrendingUp, ShieldAlert, Grid3x3, Users, History, Flame,
  LayoutDashboard, GripHorizontal, Rows3, Waypoints, Filter,
  Link as LinkIcon, Paperclip, AlertOctagon, ShieldCheck, Save, PanelLeftClose, MoreHorizontal, Star, ChevronLeft, Bell, BookOpen, FileText, CircleDot, Minus,
  Archive, RotateCcw, Tag, ExternalLink, Printer, Presentation
} from 'https://esm.sh/lucide-react@0.383.0?deps=react@18.2.0';
import { initializeApp } from 'https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js';
import {
  getFirestore, doc, getDoc, setDoc, deleteDoc, runTransaction,
  collection, query, orderBy, startAt, endAt, getDocs, onSnapshot
} from 'https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js';
import {
  getAuth, onAuthStateChanged, signInWithEmailAndPassword, createUserWithEmailAndPassword,
  signOut, sendPasswordResetEmail, GoogleAuthProvider, linkWithPopup, signInWithPopup, reauthenticateWithPopup
} from 'https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js';

const firebaseApp = initializeApp(window.__FIREBASE_CONFIG__);
const db = getFirestore(firebaseApp);
const auth = getAuth(firebaseApp);

// Synchronisation protégée contre les écrasements inter-session.
//
// Chaque lecture mémorise la "révision" exacte du document. Une écriture est
// ensuite faite dans une transaction Firestore et n'est acceptée que si la
// révision distante n'a pas changé depuis la dernière lecture de CETTE session.
// Ainsi, un onglet / PC / iPhone plus ancien ne peut plus écraser silencieusement
// des données enregistrées entre-temps par une autre session.
const __nexoraKnownRevisions = new Map(); // key -> revision token | null (doc absent)
const __nexoraKnownValues = new Map();    // key -> last Firebase-confirmed value
const __nexoraReadErrors = new Map();     // key -> dernière erreur de lecture

const storageRevisionToken = (data) => data?.revision || data?.updatedAt || null;
// === NEXORA:SYNC-SOURCE:START ===
// Toute écriture manifeste porte son origine. « assistant-api » : passerelle
// assistant/MCP (create_task, update_task, complete_task, archive_task...),
// écrite par les fonctions Netlify. « browser » : une session Nexora ouverte,
// qu'elle écrive en direct ou via le relais REST. Sans ce champ les deux sont
// indiscernables, et une écriture de l'assistant dans l'onglet resté seul
// ouvert déclenche le bandeau plein écran « Une autre session a enregistré
// des changements » alors qu'aucun conflit n'existe.
const NEXORA_SOURCE_ASSISTANT = "assistant-api";
const NEXORA_SOURCE_BROWSER = "browser";
// Un manifeste écrit avant cette version n'a pas de champ `source` : on
// renvoie null, jamais une origine devinée — l'inconnu reste traité comme un
// vrai conflit, le comportement d'avant.
const storageSourceTag = (data) => {
  const raw = data?.source;
  return typeof raw === "string" && raw ? raw : null;
};
// === NEXORA:SYNC-SOURCE:END ===

// Stockage Firestore segmenté.
//
// Firestore limite physiquement chaque document à 1 Mio. Nexora conserve donc
// le document historique <key> comme MANIFESTE et découpe automatiquement les
// gros payloads en documents frères. L'appelant continue à manipuler une seule
// valeur logique : aucune migration manuelle des tâches n'est nécessaire.
//
// 150 000 caractères par segment => même avec des caractères UTF‑8 sur 4 octets,
// un document de segment reste largement sous 1 Mio.
const NEXORA_CHUNK_CHAR_LIMIT = 150000;
const NEXORA_CHUNK_MARKER = "--nexora-chunk--";
const NEXORA_CHUNK_MODE = "chunked-v1";

const makeStorageRevision = () => {
  const now = new Date().toISOString();
  const id =
    (globalThis.crypto && typeof globalThis.crypto.randomUUID === "function")
      ? globalThis.crypto.randomUUID()
      : `${Date.now()}-${Math.random().toString(36).slice(2)}`;
  return { now, revision:id };
};

const splitStorageValue = (value) => {
  const text = String(value ?? "");
  const chunks = [];
  for (let i = 0; i < text.length; i += NEXORA_CHUNK_CHAR_LIMIT) {
    chunks.push(text.slice(i, i + NEXORA_CHUNK_CHAR_LIMIT));
  }
  return chunks.length ? chunks : [""];
};

const chunkDocIdFor = (key, revision, index) =>
  `${key}${NEXORA_CHUNK_MARKER}${revision}-${String(index).padStart(4,"0")}`;

const nexoraDirectStorage = {
  async get(key, options = {}) {
    const uid = auth.currentUser?.uid;
    const trackRevision = options.trackRevision !== false;
    if (!uid) throw new Error("Non authentifié");

    try {
      const ref = doc(db, "users", uid, "kv_store", key);
      const snap = await getDoc(ref);

      if (!snap.exists()) {
        if (trackRevision) {
          __nexoraKnownRevisions.set(key, null);
          __nexoraKnownValues.delete(key);
        }
        __nexoraReadErrors.delete(key);
        throw new Error("Key not found: " + key);
      }

      const data = snap.data();
      let value = data.value;

      if (data.storageMode === NEXORA_CHUNK_MODE) {
        const chunkIds = Array.isArray(data.chunkIds) ? data.chunkIds : [];
        if (!chunkIds.length && Number(data.chunkCount || 0) > 0) {
          throw new Error(`Stockage segmenté incomplet pour ${key} : manifeste sans segments.`);
        }

        const chunkSnaps = await Promise.all(
          chunkIds.map((chunkId) => getDoc(doc(db, "users", uid, "kv_store", chunkId)))
        );

        const missing = chunkSnaps.findIndex((chunkSnap) => !chunkSnap.exists());
        if (missing >= 0) {
          throw new Error(`Stockage segmenté incomplet pour ${key} : segment ${missing + 1}/${chunkIds.length} absent.`);
        }

        value = chunkSnaps
          .map((chunkSnap, index) => {
            const chunkData = chunkSnap.data();
            if (chunkData.parentKey !== key || chunkData.revision !== data.revision) {
              throw new Error(`Stockage segmenté incohérent pour ${key} : segment ${index + 1} d'une autre révision.`);
            }
            return String(chunkData.chunk ?? "");
          })
          .join("");

        if (Number.isFinite(Number(data.totalLength)) && value.length !== Number(data.totalLength)) {
          throw new Error(
            `Stockage segmenté incomplet pour ${key} : ${value.length}/${data.totalLength} caractères récupérés.`
          );
        }
      }

      __nexoraReadErrors.delete(key);
      if (trackRevision) {
        __nexoraKnownRevisions.set(key, storageRevisionToken(data));
        __nexoraKnownValues.set(key, value);
      }

      return {
        key,
        value,
        updatedAt: data.updatedAt || null,
        revision: data.revision || null,
        storageMode: data.storageMode || "inline",
        chunkCount: data.chunkCount || 0,
      };
    } catch (error) {
      const message = (error && error.message) || String(error);
      if (!message.includes("Key not found")) {
        __nexoraReadErrors.set(key, message);
      }
      throw error;
    }
  },

  async set(key, value) {
    const uid = auth.currentUser?.uid;
    if (!uid) throw new Error("Non authentifié");

    if (__nexoraReadErrors.has(key)) {
      const err = new Error(
        `Synchronisation bloquée pour ${key} : la dernière lecture Firebase a échoué (${__nexoraReadErrors.get(key)}). Recharge ou synchronise avant d'écrire.`
      );
      err.code = "NEXORA_READ_UNSAFE";
      throw err;
    }

    const payload = String(value ?? "");
    const chunks = splitStorageValue(payload);
    const useChunks = chunks.length > 1;

    const ref = doc(db, "users", uid, "kv_store", key);
    const hasKnownRevision = __nexoraKnownRevisions.has(key);
    const expectedRevision = hasKnownRevision ? __nexoraKnownRevisions.get(key) : undefined;
    const { now, revision } = makeStorageRevision();

    const result = await runTransaction(db, async (tx) => {
      const snap = await tx.get(ref);
      const remoteExists = snap.exists();
      const remoteData = remoteExists ? snap.data() : null;
      const remoteRevision = storageRevisionToken(remoteData);

      if (!hasKnownRevision && remoteExists) {
        const err = new Error(
          `Conflit de synchronisation sur ${key} : cette session n'a pas chargé la version Firebase actuelle.`
        );
        err.code = "NEXORA_SYNC_CONFLICT";
        throw err;
      }

      if (hasKnownRevision && remoteRevision !== expectedRevision) {
        const err = new Error(
          `Conflit de synchronisation sur ${key} : Firebase contient une version plus récente. Aucune donnée n'a été écrasée.`
        );
        err.code = "NEXORA_SYNC_CONFLICT";
        throw err;
      }

      // Nettoie atomiquement les segments de l'ancienne génération.
      const oldChunkIds =
        remoteData?.storageMode === NEXORA_CHUNK_MODE && Array.isArray(remoteData.chunkIds)
          ? remoteData.chunkIds
          : [];

      oldChunkIds.forEach((chunkId) => {
        tx.delete(doc(db, "users", uid, "kv_store", chunkId));
      });

      if (!useChunks) {
        tx.set(ref, {
          value:payload,
          updatedAt:now,
          revision,
          source:NEXORA_SOURCE_BROWSER,
          storageMode:"inline",
          chunkCount:0,
          totalLength:payload.length,
        });

        return {
          key,
          value:payload,
          updatedAt:now,
          revision,
          storageMode:"inline",
          chunkCount:0,
        };
      }

      const chunkIds = chunks.map((_, index) => chunkDocIdFor(key, revision, index));

      chunks.forEach((chunk, index) => {
        const chunkRef = doc(db, "users", uid, "kv_store", chunkIds[index]);
        tx.set(chunkRef, {
          parentKey:key,
          revision,
          index,
          chunk,
          updatedAt:now,
        });
      });

      // Le document principal reste minuscule : il référence la génération
      // exacte des segments qui constituent la valeur logique.
      tx.set(ref, {
        value:null,
        updatedAt:now,
        revision,
        source:NEXORA_SOURCE_BROWSER,
        storageMode:NEXORA_CHUNK_MODE,
        chunkIds,
        chunkCount:chunkIds.length,
        totalLength:payload.length,
      });

      return {
        key,
        value:payload,
        updatedAt:now,
        revision,
        storageMode:NEXORA_CHUNK_MODE,
        chunkCount:chunkIds.length,
      };
    });

    __nexoraKnownRevisions.set(key, result.revision);
    __nexoraKnownValues.set(key, result.value);
    __nexoraReadErrors.delete(key);
    return result;
  },

  async delete(key) {
    const uid = auth.currentUser?.uid;
    if (!uid) throw new Error("Non authentifié");

    if (__nexoraReadErrors.has(key)) {
      const err = new Error(`Suppression bloquée pour ${key} : lecture Firebase non fiable.`);
      err.code = "NEXORA_READ_UNSAFE";
      throw err;
    }

    const ref = doc(db, "users", uid, "kv_store", key);
    const hasKnownRevision = __nexoraKnownRevisions.has(key);
    const expectedRevision = hasKnownRevision ? __nexoraKnownRevisions.get(key) : undefined;

    await runTransaction(db, async (tx) => {
      const snap = await tx.get(ref);
      if (!snap.exists()) return;

      const remoteData = snap.data();
      const remoteRevision = storageRevisionToken(remoteData);

      if (!hasKnownRevision || remoteRevision !== expectedRevision) {
        const err = new Error(`Conflit de synchronisation sur ${key} : suppression refusée.`);
        err.code = "NEXORA_SYNC_CONFLICT";
        throw err;
      }

      if (remoteData?.storageMode === NEXORA_CHUNK_MODE && Array.isArray(remoteData.chunkIds)) {
        remoteData.chunkIds.forEach((chunkId) => {
          tx.delete(doc(db, "users", uid, "kv_store", chunkId));
        });
      }

      tx.delete(ref);
    });

    __nexoraKnownRevisions.set(key, null);
    __nexoraKnownValues.delete(key);
    __nexoraReadErrors.delete(key);
    return { key, deleted:true };
  },

  async refreshRevision(key) {
    try {
      return await this.get(key);
    } catch (error) {
      const message = (error && error.message) || String(error);
      if (message.includes("Key not found")) {
        // Absence CONSTATÉE, pas ignorance : la révision connue doit suivre,
        // sinon la réécriture qui suit repart avec une révision périmée et se
        // fait refuser une seconde fois.
        __nexoraKnownRevisions.set(key, null);
        __nexoraKnownValues.delete(key);
        return null;
      }
      throw error;
    }
  },

  async list(prefix) {
    const uid = auth.currentUser?.uid;
    if (!uid) throw new Error("Non authentifié");

    const col = collection(db, "users", uid, "kv_store");
    const q = prefix
      ? query(col, orderBy("__name__"), startAt(prefix), endAt(prefix + "\uf8ff"))
      : query(col, orderBy("__name__"));

    const snap = await getDocs(q);

    // Les segments sont un détail d'implémentation et ne doivent jamais
    // apparaître comme des clés Nexora ordinaires.
    return {
      keys:snap.docs
        .map((d) => d.id)
        .filter((id) => !id.includes(NEXORA_CHUNK_MARKER))
    };
  },

  // Écoute en temps réel les changements d'une clé (document manifeste
  // uniquement — pas les segments), pour détecter qu'une AUTRE session vient
  // d'enregistrer une révision différente de celle connue par cette session.
  // N'appelle onChange que pour de vrais changements distants confirmés
  // (jamais pour nos propres écritures locales en attente).
  watch(key, onChange) {
    const uid = auth.currentUser?.uid;
    if (!uid) return () => {};
    const ref = doc(db, "users", uid, "kv_store", key);
    return onSnapshot(ref, { includeMetadataChanges: false }, (snap) => {
      if (snap.metadata.hasPendingWrites) return; // écriture locale pas encore confirmée : pas pertinent
      if (!snap.exists()) return;
      const remoteRevision = storageRevisionToken(snap.data());
      const known = __nexoraKnownRevisions.get(key);
      // L'origine accompagne la révision : elle décide, côté React, entre la
      // pastille discrète de synchronisation MCP et le bandeau de conflit.
      if (remoteRevision && remoteRevision !== known) onChange(remoteRevision, storageSourceTag(snap.data()));
    }, () => { /* écoute interrompue (réseau, permissions) : silencieux, le polling au focus prend le relais */ });
  },

  // Vérifie la révision distante d'une clé sans télécharger tout son contenu
  // (utile pour un simple contrôle de fraîcheur, ex. au retour au premier
  // plan d'un onglet mis en veille par l'OS/le navigateur — voir plus bas).
  async checkRevision(key) {
    const uid = auth.currentUser?.uid;
    if (!uid) return null;
    try {
      const ref = doc(db, "users", uid, "kv_store", key);
      const snap = await getDoc(ref);
      if (!snap.exists()) return null;
      const data = snap.data();
      return { revision:storageRevisionToken(data), source:storageSourceTag(data) };
    } catch (e) {
      return null; // simple vérification de fraîcheur, jamais critique : échec silencieux
    }
  },

  getKnownRevision(key) {
    return __nexoraKnownRevisions.has(key) ? __nexoraKnownRevisions.get(key) : undefined;
  },

  getKnownValue(key) {
    return __nexoraKnownValues.get(key);
  },

  // Commit a peeked remote value only when the React state is ready to adopt it.
  acceptRemote(key, result) {
    if (!result) return;
    __nexoraKnownRevisions.set(key, result.revision || result.updatedAt || null);
    __nexoraKnownValues.set(key, result.value);
    __nexoraReadErrors.delete(key);
  },

  syncDiagnostics() {
    return {
      knownRevisionKeys:[...__nexoraKnownRevisions.keys()],
      readErrors:Object.fromEntries(__nexoraReadErrors.entries()),
      chunking:{
        enabled:true,
        chunkCharLimit:NEXORA_CHUNK_CHAR_LIMIT,
        mode:NEXORA_CHUNK_MODE,
      },
    };
  },
};

// Passerelle serveur Nexora.
//
// Le SDK Firestore conserve son rôle pour l'authentification Firebase, mais les
// documents applicatifs passent par une fonction Netlify. Le jeton Firebase
// courant est transmis à l'API REST Firestore : les règles de sécurité restent
// donc appliquées exactement comme pour une lecture directe depuis le navigateur.
// === NEXORA:UNLOAD-FLUSH:START ===
// L'effet visibilitychange/pagehide plus bas force l'envoi sans attendre le
// debounce. Il ne suffit pas : la requête ainsi partie est ELLE AUSSI annulée
// par le déchargement de la page, le navigateur abandonnant ce qui est en vol.
// Le tampon nexora:rescue: conserve alors la valeur et la propose en
// restauration au démarrage suivant — rien n'est perdu, mais il faut une action
// de l'utilisateur, et il découvre le problème le lendemain, sur l'autre poste.
//
// keepalive demande au navigateur de mener la requête à terme malgré le
// déchargement. La spécification fetch plafonne le corps d'une telle requête à
// 64 Kio, toutes requêtes en vol confondues ; au-delà le navigateur la refuse.
// On reste donc sous 60 Kio et on repasse en envoi normal sinon — moins sûr,
// mais qui n'échoue pas, et le tampon rescue couvre ce dernier cas.
//
// La taille est mesurée en octets UTF-8 : compter les caractères
// sous-estimerait un texte accentué et laisserait passer un corps rejeté.
const NEXORA_KEEPALIVE_MAX_BYTES = 60 * 1024;
const nexoraBodyBytes = (body) => {
  if (body == null) return 0;
  if (typeof body === "string") return new TextEncoder().encode(body).length;
  return Infinity; // forme inconnue : on ne prend pas le risque
};
const nexoraUseKeepalive = (bytes) => Number.isFinite(bytes) && bytes <= NEXORA_KEEPALIVE_MAX_BYTES;

// Vrai dès que la page cesse d'être visible. On ne met pas keepalive sur TOUTES
// les requêtes : le quota de 64 Kio est partagé, et le gaspiller sur des
// lectures de premier plan ferait échouer l'écriture qui compte.
let nexoraPageLeaving = false;
if (typeof document !== "undefined") {
  document.addEventListener("visibilitychange", () => {
    nexoraPageLeaving = document.visibilityState === "hidden";
  });
  // freeze complète pagehide sur les navigateurs mobiles, qui ne l'émettent pas toujours.
  document.addEventListener("freeze", () => { nexoraPageLeaving = true; });
}
if (typeof window !== "undefined") window.addEventListener("pagehide", () => { nexoraPageLeaving = true; });
// === NEXORA:UNLOAD-FLUSH:END ===

const nexoraServerStorageRequest = async (action, payload = {}) => {
  const user = auth.currentUser;
  if (!user) throw new Error("Non authentifié");
  const token = await user.getIdToken();
  const requestBody = JSON.stringify({ action, uid:user.uid, ...payload });
  const response = await fetch("/api/nexora-storage", {
    method:"POST",
    headers:{
      "content-type":"application/json",
      "authorization":`Bearer ${token}`,
    },
    body:requestBody,
    // Voir NEXORA:UNLOAD-FLUSH : survivre au déchargement de la page, sans
    // dépasser le plafond au-delà duquel le navigateur refuserait la requête.
    keepalive: nexoraPageLeaving && nexoraUseKeepalive(nexoraBodyBytes(requestBody)),
  });
  const data = await response.json().catch(() => ({}));
  if (!response.ok || !data?.ok) {
    const error = new Error(data?.error || `Passerelle Nexora indisponible (${response.status}).`);
    error.code = data?.code || "NEXORA_SERVER_ERROR";
    throw error;
  }
  return data.result;
};

const nexoraServerStorage = {
  // === NEXORA:GATEWAY-READ-GUARD:START ===
  // L'adaptateur Firestore direct note toute lecture ratée dans
  // __nexoraReadErrors et REFUSE d'écrire une clé dans cet état. Cette
  // passerelle — la seule qui tourne sur le site déployé — ne faisait ni l'un
  // ni l'autre.
  //
  // Conséquence observée après un Ctrl+R (un rechargement lance plus de vingt
  // lectures de front, dont une peut expirer) : la clé n'a pas de révision
  // connue, l'écriture suivante part donc SANS expectedRevision, le serveur la
  // refuse par un 409, et comme une préférence scalaire ne se fusionne pas,
  // la clé atterrit dans blockedKeys — le bandeau rouge « en attente de
  // synchronisation », alors qu'aucune autre session n'est en cause.
  //
  // En notant la lecture ratée, l'écriture lève NEXORA_READ_UNSAFE, que
  // attemptPersist rattrape déjà : il relit la clé (ce qui efface l'erreur) et
  // réécrit ou fusionne. Le bandeau disparaît, et surtout l'écrasement muet
  // d'une clé jamais relue n'est plus possible en production.
  async get(key, options = {}) {
    let result;
    try {
      result = await nexoraServerStorageRequest("get", { key });
    } catch (error) {
      const message = (error && error.message) || String(error);
      // « Key not found » n'est pas une lecture ratée : la clé n'existe pas
      // encore, et l'écrire est parfaitement sûr.
      if (!message.includes("Key not found")) {
        __nexoraReadErrors.set(key, message);
      }
      throw error;
    }
    if (options.trackRevision !== false) {
      __nexoraKnownRevisions.set(key, result.revision || null);
      __nexoraKnownValues.set(key, result.value);
    }
    __nexoraReadErrors.delete(key);
    return result;
  },

  async set(key, value) {
    if (__nexoraReadErrors.has(key)) {
      const err = new Error(
        `Synchronisation bloquée pour ${key} : la dernière lecture Firebase a échoué (${__nexoraReadErrors.get(key)}). Recharge ou synchronise avant d'écrire.`
      );
      err.code = "NEXORA_READ_UNSAFE";
      throw err;
    }
    const payload = { key, value:String(value ?? "") };
    if (__nexoraKnownRevisions.has(key)) {
      payload.expectedRevision = __nexoraKnownRevisions.get(key);
    }
    const result = await nexoraServerStorageRequest("set", payload);
    __nexoraKnownRevisions.set(key, result.revision || null);
    __nexoraKnownValues.set(key, result.value);
    __nexoraReadErrors.delete(key);
    return result;
  },
  // === NEXORA:GATEWAY-READ-GUARD:END ===

  async delete(key) {
    const payload = { key };
    if (__nexoraKnownRevisions.has(key)) {
      payload.expectedRevision = __nexoraKnownRevisions.get(key);
    }
    const result = await nexoraServerStorageRequest("delete", payload);
    __nexoraKnownRevisions.set(key, null);
    __nexoraKnownValues.delete(key);
    __nexoraReadErrors.delete(key);
    return result;
  },

  async refreshRevision(key) {
    try {
      return await this.get(key);
    } catch (error) {
      if (((error && error.message) || String(error)).includes("Key not found")) {
        // Voir l'adaptateur direct : sans cette mise à jour, une clé effacée
        // depuis un autre appareil reste inécrivable jusqu'au rechargement.
        __nexoraKnownRevisions.set(key, null);
        __nexoraKnownValues.delete(key);
        return null;
      }
      throw error;
    }
  },

  async list(prefix = "") {
    return nexoraServerStorageRequest("list", { key:"nexora:list", prefix });
  },

  watch() {
    // Le contrôle de fraîcheur au retour au premier plan remplace l'écoute
    // WebChannel, précisément le canal bloqué dans certains environnements.
    return () => {};
  },

  async checkRevision(key) {
    try {
      const result = await nexoraServerStorageRequest("checkRevision", { key });
      if (!result?.revision) return null;
      return { revision:result.revision, source:storageSourceTag(result) };
    } catch (_) {
      return null;
    }
  },

  getKnownRevision(key) {
    return __nexoraKnownRevisions.has(key) ? __nexoraKnownRevisions.get(key) : undefined;
  },

  getKnownValue(key) {
    return __nexoraKnownValues.get(key);
  },

  acceptRemote(key, result) {
    if (!result) return;
    __nexoraKnownRevisions.set(key, result.revision || result.updatedAt || null);
    __nexoraKnownValues.set(key, result.value);
    __nexoraReadErrors.delete(key);
  },

  syncDiagnostics() {
    return {
      transport:"netlify-firestore-rest",
      knownRevisionKeys:[...__nexoraKnownRevisions.keys()],
      readErrors:Object.fromEntries(__nexoraReadErrors.entries()),
      chunking:{ enabled:true, chunkCharLimit:NEXORA_CHUNK_CHAR_LIMIT, mode:NEXORA_CHUNK_MODE },
    };
  },
};


// Un fichier ouvert depuis le disque ne dispose pas de la fonction Netlify
// /api/nexora-storage. Réutiliser dans ce seul contexte l'adaptateur Firebase
// authentifié ci-dessus, avec ses contrôles de révision, ses segments et son
// blocage des écritures après une lecture en erreur. Sur HTTP(S), conserver la
// passerelle existante ; aucune erreur serveur ne déclenche de bascule implicite.
window.storage = window.location.protocol === "file:"
  ? nexoraDirectStorage
  : nexoraServerStorage;

// ============================================================================
// Constantes & helpers de dates
// ============================================================================
const RADIUS_SCALES = {
  sharp:  { sm: "5px",  base: "7px",  lg: "8px" },
  normal: { sm: "6px",  base: "10px", lg: "14px" },
  round:  { sm: "10px", base: "16px", lg: "22px" },
};
// Signal (accent) en tête, puis un jeu de couleurs franches et saturées façon
// signalétique de réseau ferré — plus les tons pastel Tailwind par défaut.
const ACCENT_PRESETS = ["#FF7A3D", "#4F6AF5", "#1FA971", "#E2483E", "#8B5CF6", "#00B4D8", "#E2A63B", "#EDEFF4"];
const PROJECT_PALETTES = {
  default:  ["#E2483E", "#1FA971", "#4F6AF5", "#E2A63B", "#8B5CF6", "#00B4D8", "#EC4899", "#F97316", "#64748B", "#14B8A6"],
  pastel:   ["#B4C6FC", "#F9C6C6", "#FBE0A6", "#A7E3D0", "#C9B8F0", "#F6C6E0", "#A9D8F5", "#D6C7A1", "#B7E4C7", "#C6D2F5"],
  vivid:    ["#7C3AED", "#DC2626", "#EA580C", "#0891B2", "#059669", "#DB2777", "#2563EB", "#CA8A04", "#16A34A", "#E11D48"],
  corporate:["#334155", "#1E3A5F", "#475569", "#0F766E", "#374151", "#1F2937", "#4B5563", "#0C4A6E", "#3F3F46", "#27272A"],
};
const MILESTONE_STYLES = {
  flag: { icon: "tabler:flag", label: "Drapeau" },
  star: { icon: "tabler:star", label: "Étoile" },
  diamond: { icon: "tabler:diamond", label: "Losange" },
  rocket: { icon: "tabler:rocket", label: "Fusée" },
  trophy: { icon: "tabler:trophy", label: "Trophée" },
  bell: { icon: "tabler:bell", label: "Cloche" },
  pin: { icon: "tabler:map-pin", label: "Épingle" },
  target: { icon: "tabler:target", label: "Cible" },
  fire: { icon: "tabler:flame", label: "Feu" },
  bulb: { icon: "tabler:bulb", label: "Idée" },
  check: { icon: "tabler:circle-check", label: "Coche" },
  gem: { icon: "tabler:diamond", label: "Diamant" },
};
let GLOBAL_MILESTONE_STYLE = "flag"; // mis à jour à chaque rendu de l'App depuis appearance.milestoneStyle
let GLOBAL_MILESTONE_URL = ""; // utilisé si GLOBAL_MILESTONE_STYLE === "custom"
// Icône de jalon à utiliser pour UNE tâche donnée : priorité à une icône propre
// au jalon lui-même, puis à celle définie pour son projet, puis au style
// global (Réglages > Apparence). Centralise la résolution pour que tous les
// endroits qui affichent un jalon restent cohérents entre eux.
function resolveMilestoneIcon(t, ctx) {
  if (!t) return null;
  if (t.milestoneIcon) return t.milestoneIcon;
  const proj = ctx?.projects?.find((p) => p.id === t.projectId);
  if (proj?.milestoneIcon) return proj.milestoneIcon;
  return null;
}
function ProjectDeadlineStationGlyph({ x, y, project, task = null, ctx = null, color, done = false, radius = 8.5, iconSize = 11 }) {
  const milestoneIcon = task?.milestone ? resolveMilestoneIcon(task, ctx) : null;
  const projectIcon = milestoneIcon || project?.icon || null;
  return (
    <g pointerEvents="none">
      <circle cx={x} cy={y} r={radius} fill="var(--surface)" stroke={color} strokeWidth="2" />
      {projectIcon ? (
        <>
          <foreignObject
            x={x - iconSize/2}
            y={y - iconSize/2}
            width={iconSize}
            height={iconSize}
            style={{ overflow:"visible", pointerEvents:"none" }}
          >
            <div
              xmlns="http://www.w3.org/1999/xhtml"
              style={{
                width:iconSize, height:iconSize,
                display:"flex", alignItems:"center", justifyContent:"center",
                color,
                lineHeight:1,
                pointerEvents:"none"
              }}
            >
              <IconGlyph icon={projectIcon} size={iconSize} />
            </div>
          </foreignObject>
          {done && (
            <circle
              cx={x + radius * .62}
              cy={y + radius * .62}
              r="2.7"
              fill="var(--success)"
              stroke="var(--surface)"
              strokeWidth="1.2"
            />
          )}
        </>
      ) : (
        <circle
          cx={x}
          cy={y}
          r={done ? "4.2" : "2.6"}
          fill={done ? "var(--success)" : color}
          opacity={done ? 1 : .9}
        />
      )}
    </g>
  );
}
const ROW_H = 34;

// === NEXORA:DATE-UTILS:START ===
/* Les trois briques de date de tout Nexora. Elles vivent derrière des
   sentinelles pour une raison précise : les blocs testés qui les appellent
   (NEXORA:STAFFING, par exemple) doivent être éprouvés avec les VRAIES, et non
   avec des copies écrites dans un fichier de test — qui finiraient par ne plus
   dire la même chose que l'application. */
const iso = (d) => {
  const dt = typeof d === "string" ? new Date(d + "T00:00:00") : d;
  const y = dt.getFullYear();
  const m = String(dt.getMonth() + 1).padStart(2, "0");
  const day = String(dt.getDate()).padStart(2, "0");
  return `${y}-${m}-${day}`;
};
const addDays = (dateStr, n) => {
  const dt = new Date(dateStr + "T00:00:00");
  dt.setDate(dt.getDate() + n);
  return iso(dt);
};
const DAY_MS = 86400000;
const dayIndex = (dateStr) => Math.round((new Date(dateStr + "T00:00:00") - new Date("2020-01-01T00:00:00")) / DAY_MS);
// === NEXORA:DATE-UTILS:END ===
// === NEXORA:MARKDOWN:START ===
// Les guillemets et apostrophes DOIVENT être échappés, pas seulement les chevrons :
// le rendu Markdown interpole l'URL d'un lien dans un attribut entre guillemets
// (`<a href="$2" …>`), et la classe de caractères de l'URL accepte le guillemet.
// Sans cet échappement, `[c](https://x"onmouseover=…)` referme href et pose un
// attribut arbitraire sur la balise — le résultat part en dangerouslySetInnerHTML.
const escapeHtml = (s) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#39;");
// Callouts façon Obsidian : "> [!type] Titre" suivi de lignes "> contenu" —
// syntaxe reprise à l'identique pour rester familière sans rien apprendre de
// nouveau. Palette volontairement fixe (5 types) pour rester cohérente
// partout dans l'app plutôt que de suivre les dizaines de variantes Obsidian.
const CALLOUT_TYPES = {
  note: { label: "Note", color: "#3B82F6", bg: "#EFF6FF", icon: "📝" },
  info: { label: "Info", color: "#0EA5E9", bg: "#F0F9FF", icon: "ℹ️" },
  tip: { label: "Astuce", color: "#22B07D", bg: "#ECFDF5", icon: "💡" },
  warning: { label: "Attention", color: "#D97706", bg: "#FFFBEB", icon: "⚠️" },
  danger: { label: "Danger", color: "#DC2626", bg: "#FEF2F2", icon: "🔥" },
};
/* Tableaux GitHub Flavored Markdown (issue #71).

   Le rendu n'en connaissait aucun : chaque ligne d'un tableau collé depuis
   ChatGPT ou Claude devenait un paragraphe, barres verticales comprises, et
   l'aperçu donnait l'impression que les séparateurs s'étaient déplacés. Le
   texte source, lui, n'avait jamais bougé — la zone de saisie ne le transforme
   pas — c'était bien le seul aperçu qui était en cause.

   Tout ce qui suit travaille sur des lignes DÉJÀ échappées par escapeHtml :
   les barres, les tirets et les deux-points traversent l'échappement intacts,
   donc l'analyse reste exacte sans jamais rouvrir l'injection de balises. */

// Une cellule de la ligne de séparation : « --- », « :--- », « ---: », « :---: ».
const MD_TABLE_DELIM = /^\s*:?-+:?\s*$/;

/* Découpe une ligne de tableau en cellules.

   Les barres de bord sont facultatives en GFM, et une barre ÉCHAPPÉE (\|)
   appartient au texte de la cellule : la couper créerait une colonne fantôme
   et décalerait toutes les colonnes suivantes de cette ligne. */
function mdTableCells(line) {
  let s = String(line == null ? "" : line).trim();
  if (s.startsWith("|")) s = s.slice(1);
  if (/(^|[^\\])\|$/.test(s)) s = s.slice(0, -1);
  const cells = [];
  let cur = "";
  for (let i = 0; i < s.length; i++) {
    if (s[i] === "\\" && s[i + 1] === "|") { cur += "|"; i++; continue; }
    if (s[i] === "|") { cells.push(cur.trim()); cur = ""; continue; }
    cur += s[i];
  }
  cells.push(cur.trim());
  return cells;
}

/* L'alignement de chaque colonne, lu sur la ligne de séparation — ou null si
   ce n'en est pas une. C'est ce null qui distingue un vrai tableau d'une phrase
   qui contient des barres verticales : sans lui, « a | b » deviendrait un
   tableau d'une ligne. */
function mdTableAligns(line) {
  if (!/\|/.test(String(line == null ? "" : line))) return null;
  const cells = mdTableCells(line);
  if (!cells.length || cells.some((c) => !MD_TABLE_DELIM.test(c))) return null;
  return cells.map((c) => {
    const left = c.startsWith(":");
    const right = c.endsWith(":");
    if (left && right) return "center";
    if (right) return "right";
    if (left) return "left";
    return "";
  });
}

/* Reconnaît un tableau à partir de la ligne `start`, et rend où il s'arrête.

   Deux lignes sont nécessaires pour le reconnaître — l'en-tête et la
   séparation — et GFM exige qu'elles aient le MÊME nombre de colonnes. */
function mdTableParse(lines, start) {
  const head = lines[start];
  if (!head || !/\|/.test(head)) return null;
  const aligns = mdTableAligns(lines[start + 1]);
  if (!aligns) return null;
  const header = mdTableCells(head);
  if (header.length !== aligns.length) return null;
  const body = [];
  let i = start + 2;
  while (i < lines.length && lines[i].trim() !== "" && /\|/.test(lines[i])) {
    const cells = mdTableCells(lines[i]);
    /* Une ligne plus courte se complète, une plus longue se tronque — c'est ce
       que fait GFM, et c'est ce qui empêche une cellule mal comptée de décaler
       la colonne suivante sur toutes les lignes en dessous. */
    body.push(Array.from({ length: header.length }, (_, c) => cells[c] || ""));
    i++;
  }
  return { aligns, header, body, next: i };
}

function mdTableHtml(parsed, inline) {
  const style = (a) => (a ? ' style="text-align:' + a + '"' : "");
  const head = parsed.header.map((c, i) => `<th${style(parsed.aligns[i])}>${inline(c)}</th>`).join("");
  const body = parsed.body
    .map((row) => `<tr>${row.map((c, i) => `<td${style(parsed.aligns[i])}>${inline(c)}</td>`).join("")}</tr>`)
    .join("");
  /* Le défilement appartient au TABLEAU, pas à la fiche : sans cette
     enveloppe, un tableau large élargit toute la modale de tâche. */
  return `<div class="lp-md-table-wrap"><table class="lp-md-table"><thead><tr>${head}</tr></thead><tbody>${body}</tbody></table></div>`;
}

const mdInline = (s) => s
  .replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>")
  .replace(/\*(.+?)\*/g, "<em>$1</em>")
  .replace(/`(.+?)`/g, "<code>$1</code>")
  .replace(/\[(.+?)\]\((https?:\/\/[^\s)]+)\)/g, '<a href="$2" target="_blank" rel="noopener">$1</a>');

/* Cœur du rendu, partagé par le document entier ET par l'intérieur d'un
   callout (#178) : un callout n'acceptait jusque-là que du texte en ligne
   (gras, italique, liens) — une liste, un titre ou un tableau écrit dedans
   restait du texte brut, faute d'un second passage par ce même moteur.

   `entries` porte `{ text, lineIndex }` plutôt que des chaînes nues : `text`
   est DÉJÀ échappé (une seule passe HTML, au tout début de `renderMarkdown`),
   `lineIndex` reste le numéro de ligne dans le texte ORIGINAL, y compris
   pour les lignes recopiées à l'intérieur d'un callout — c'est ce qui permet
   à une case à cocher, aussi profondément imbriquée soit-elle, de continuer à
   se retrouver par `toggleMarkdownTaskLine`. */
const renderMarkdownBlocks = (entries, interactive) => {
  let html = "";
  let inList = false;
  const closeList = () => { if (inList) { html += "</ul>"; inList = false; } };
  const rawLines = entries.map((e) => e.text);
  let i = 0;
  while (i < entries.length) {
    const line = entries[i].text.trimEnd();
    const lineIndex = entries[i].lineIndex;
    // Callout : "> [!type] Titre facultatif" puis des lignes "> ..." qui suivent.
    const calloutStart = line.match(/^&gt;\s*\[!(\w+)\]([+-])?\s*(.*)$/);
    if (calloutStart) {
      closeList();
      const type = CALLOUT_TYPES[calloutStart[1].toLowerCase()] ? calloutStart[1].toLowerCase() : "note";
      const meta = CALLOUT_TYPES[type];
      // Tous les callouts sont pliables :
      //   aucun marqueur ou "+" = ouvert par défaut
      //   "-" = fermé par défaut
      const foldMode = calloutStart[2] || "+";
      const title = calloutStart[3].trim();
      const bodyEntries = [];
      i++;

      while (i < entries.length && /^&gt;\s?/.test(entries[i].text)) {
        bodyEntries.push({ text: entries[i].text.replace(/^&gt;\s?/, ""), lineIndex: entries[i].lineIndex });
        i++;
      }

      const bodyHtml = renderMarkdownBlocks(bodyEntries, interactive);
      const headingHtml = `<span>${meta.icon}</span><span>${title ? mdInline(title) : meta.label}</span>`;
      html += `<details class="lp-callout lp-callout-foldable" ${foldMode === "+" ? "open" : ""} style="border-color:${meta.color};background:${meta.bg}">`;
      html += `<summary class="lp-callout-head lp-callout-summary" style="color:${meta.color}">${headingHtml}<span class="lp-callout-chevron">›</span></summary>`;
      if (bodyEntries.length > 0) html += `<div class="lp-callout-body">${bodyHtml}</div>`;
      html += `</details>`;
      continue;
    }
    // Callout "à balises" : ":::callout-type[-] Titre" ... ":::" — tout ce qui
    // est écrit entre les deux balises appartient au callout, sans avoir à
    // répéter "> " en début de chaque ligne. Coexiste avec la syntaxe "> [!type]"
    // ci-dessus (les callouts déjà écrits continuent de fonctionner).
    const calloutFenceStart = line.match(/^:::callout-(\w+)([+-])?\s*(.*)$/);
    if (calloutFenceStart) {
      closeList();
      const type = CALLOUT_TYPES[calloutFenceStart[1].toLowerCase()] ? calloutFenceStart[1].toLowerCase() : "note";
      const meta = CALLOUT_TYPES[type];
      const foldMode = calloutFenceStart[2] || "+";
      const title = calloutFenceStart[3].trim();
      const bodyEntries = [];
      i++;

      while (i < entries.length && entries[i].text.trim() !== ":::") {
        bodyEntries.push({ text: entries[i].text, lineIndex: entries[i].lineIndex });
        i++;
      }
      if (i < entries.length) i++; // consomme la balise de fermeture ":::"

      const bodyHtml = renderMarkdownBlocks(bodyEntries, interactive);
      const headingHtml = `<span>${meta.icon}</span><span>${title ? mdInline(title) : meta.label}</span>`;
      html += `<details class="lp-callout lp-callout-foldable" ${foldMode === "+" ? "open" : ""} style="border-color:${meta.color};background:${meta.bg}">`;
      html += `<summary class="lp-callout-head lp-callout-summary" style="color:${meta.color}">${headingHtml}<span class="lp-callout-chevron">›</span></summary>`;
      if (bodyEntries.length > 0) html += `<div class="lp-callout-body">${bodyHtml}</div>`;
      html += `</details>`;
      continue;
    }
    // Tableau GFM. Placé AVANT les listes et le paragraphe par défaut, qui
    // avaleraient chaque ligne du tableau une par une.
    const table = mdTableParse(rawLines, i);
    if (table) {
      closeList();
      html += mdTableHtml(table, mdInline);
      i = table.next;
      continue;
    }
    // Listes de tâches Markdown : "- [ ] ..." et "- [x] ..."
    const taskMatch = line.match(/^[-*]\s+\[([ xX])\]\s+(.*)$/);
    if (taskMatch) {
      if (!inList) { html += '<ul class="lp-md-task-list">'; inList = true; }
      const checked = taskMatch[1].toLowerCase() === "x";
      html += `<li class="lp-md-task-item${checked ? " is-done" : ""}">` +
        `<input class="lp-md-task-checkbox" type="checkbox" ${checked ? "checked" : ""} ${interactive ? `data-md-line="${lineIndex}"` : "disabled"} aria-label="${checked ? "Terminé" : "À faire"}" />` +
        `<span>${mdInline(taskMatch[2])}</span>` +
        `</li>`;
      i++;
      continue;
    }

    const listMatch = line.match(/^[-*]\s+(.*)/);
    if (listMatch) {
      if (!inList) { html += "<ul>"; inList = true; }
      html += `<li>${mdInline(listMatch[1])}</li>`;
      i++;
      continue;
    }
    closeList();
    if (/^###\s+/.test(line)) html += `<h4>${mdInline(line.replace(/^###\s+/, ""))}</h4>`;
    else if (/^##\s+/.test(line)) html += `<h3>${mdInline(line.replace(/^##\s+/, ""))}</h3>`;
    else if (/^#\s+/.test(line)) html += `<h2>${mdInline(line.replace(/^#\s+/, ""))}</h2>`;
    else if (line === "") html += "<br/>";
    else html += `<p>${mdInline(line)}</p>`;
    i++;
  }
  closeList();
  return html;
};

const renderMarkdown = (text, interactive = false) => {
  if (!text) return "";
  const entries = escapeHtml(text).split("\n").map((t, lineIndex) => ({ text: t, lineIndex }));
  return renderMarkdownBlocks(entries, interactive);
};
// === NEXORA:MARKDOWN:END ===



const matchesShortcutCombo = (e, combo) => {
  if (!combo) return false;
  const parts = String(combo).split("+").map((x)=>x.trim().toLowerCase()).filter(Boolean);
  const rawKey = String(e.key || "").toLowerCase();
  const key = rawKey === " " ? "space" : rawKey;
  const main = parts.find((x)=>!["ctrl","cmd","meta","alt","shift"].includes(x));
  const wantsMeta = parts.includes("cmd") || parts.includes("meta");
  return (!!parts.includes("ctrl") === !!e.ctrlKey) &&
    (wantsMeta ? !!e.metaKey : !e.metaKey) &&
    (!!parts.includes("alt") === !!e.altKey) &&
    (!!parts.includes("shift") === !!e.shiftKey) &&
    key === main;
};

const insertMarkdownAtCursor = ({ textarea, value, insert, onChange, cursorOffset = null }) => {
  const current = String(value || "");
  if (!textarea) {
    const prefix = current && !current.endsWith("\n") ? "\n" : "";
    const next = current + prefix + insert;
    onChange(next);
    return;
  }

  const start = textarea.selectionStart ?? current.length;
  const end = textarea.selectionEnd ?? start;
  const before = current.slice(0,start);
  const after = current.slice(end);
  const prefix = before && !before.endsWith("\n") ? "\n" : "";
  const payload = prefix + insert;
  const next = before + payload + after;
  onChange(next);

  requestAnimationFrame(()=>{
    textarea.focus();
    const fallback = before.length + payload.length;
    const cursor = cursorOffset == null ? fallback : before.length + payload.length + cursorOffset;
    textarea.setSelectionRange(cursor,cursor);
  });
};

const toggleMarkdownTaskLine = (text, lineIndex, checked = null) => {
  const lines = String(text || "").split("\n");
  const idx = Number(lineIndex);
  if (!Number.isInteger(idx) || idx < 0 || idx >= lines.length) return text;

  // Supporte les checkbox normales et celles à l'intérieur d'un ou plusieurs
  // niveaux de citation/callout :
  // - [ ] ...
  // > - [ ] ...
  // > > - [x] ...
  const m = lines[idx].match(/^(\s*(?:>\s*)*[-*]\s+\[)([ xX])(\]\s*.*)$/);
  if (!m) return text;

  const currentChecked = m[2].toLowerCase() === "x";
  const nextChecked = checked == null ? !currentChecked : !!checked;
  lines[idx] = `${m[1]}${nextChecked ? "x" : " "}${m[3]}`;
  return lines.join("\n");
};

/* #145 : une seule mécanique de liste à cocher — les `- [ ]` tapés dans une
   description ne sont comptés nulle part (ni le Tableur, ni aucun widget),
   contrairement à `task.checklist`. Cette fonction PURE isole les lignes
   « case à cocher » de NIVEAU RACINE (jamais celles à l'intérieur d'un
   callout — `> - [ ]` — qui restent une mise en forme de la description, pas
   une sous-tâche) pour une conversion explicite, jamais silencieuse. */
function extractMarkdownChecklistItems(text) {
  const lines = String(text || "").split("\n");
  const items = [];
  const remaining = [];
  lines.forEach((line) => {
    const m = line.match(/^[-*]\s+\[([ xX])\]\s*(.*)$/);
    if (m) items.push({ text: m[2].trim(), done: m[1].toLowerCase() === "x" });
    else remaining.push(line);
  });
  return { items, remainingText: remaining.join("\n") };
}

const toggleMarkdownTaskFromClick = (e, text, onChange) => {
  const input = e.target?.closest?.(".lp-md-task-checkbox[data-md-line]");
  if (!input) return;
  e.preventDefault();
  e.stopPropagation();
  const lineIndex = Number(input.dataset.mdLine);
  onChange(toggleMarkdownTaskLine(text, lineIndex, null));
};

const fmtShort = (dateStr) => {
  const dt = new Date(dateStr + "T00:00:00");
  return `${String(dt.getDate()).padStart(2, "0")}/${String(dt.getMonth() + 1).padStart(2, "0")}/${dt.getFullYear()}`;
};
const fmtFull = fmtShort;
const monthLabel = (dateStr) => {
  const dt = new Date(dateStr + "T00:00:00");
  return dt.toLocaleDateString("fr-FR", { month: "long", year: "numeric" });
};
// === NEXORA:WEEK-UTILS:START ===
const getMonday = (dateStr) => {
  const dt = new Date(dateStr + "T00:00:00");
  const day = dt.getDay() || 7;
  if (day !== 1) dt.setDate(dt.getDate() - (day - 1));
  return iso(dt);
};
const isoWeek = (dateStr) => {
  const d = new Date(Date.UTC(new Date(dateStr).getFullYear(), new Date(dateStr).getMonth(), new Date(dateStr).getDate()));
  const dayNum = d.getUTCDay() || 7;
  d.setUTCDate(d.getUTCDate() + 4 - dayNum);
  const yearStart = new Date(Date.UTC(d.getUTCFullYear(), 0, 1));
  return Math.ceil((((d - yearStart) / DAY_MS) + 1) / 7);
};
// === NEXORA:WEEK-UTILS:END ===
// === NEXORA:COMPLETED-PER-WEEK:START ===
/* #141 : vraie vélocité — tâches TERMINÉES par semaine calendaire
   (lundi→dimanche, jamais une fenêtre glissante de 7 jours qui découperait
   le calendrier autrement que le reste de l'app), fondée sur `completedAt`.
   `tasks` est déjà le lot filtré du widget : respecter son filtre ne
   demande donc rien de plus ici. */
function completedPerWeekSeries(tasks, weeksCount, todayIso) {
  const span = Number.isFinite(weeksCount) && weeksCount > 0 ? Math.floor(weeksCount) : 12;
  const today = todayIso || iso(new Date());
  const thisMonday = getMonday(today);
  const weeks = Array.from({ length: span }, (_, i) => {
    const monday = addDays(thisMonday, -7 * (span - 1 - i));
    return { monday, sunday: addDays(monday, 6) };
  });
  const counts = weeks.map((w) => (tasks || []).filter((t) => {
    const d = String(t.completedAt || "").slice(0, 10);
    return d && d >= w.monday && d <= w.sunday;
  }).length);
  const average = counts.length ? counts.reduce((s, v) => s + v, 0) / counts.length : 0;
  const data = weeks.map((w, i) => ({ label: "S" + isoWeek(w.monday), value: counts[i], weekStart: w.monday }));
  return { data, average };
}
// === NEXORA:COMPLETED-PER-WEEK:END ===
// Certaines données ont pu être enregistrées sans JSON.stringify (bug de l'outil
// de saisie rapide iPhone, corrigé depuis) : Firestore accepte alors un tableau/objet
// natif au lieu d'un texte JSON. On tolère les deux formats pour s'auto-réparer au
// prochain chargement sans intervention manuelle.
function parseStoredValue(raw) {
  if (raw === null || raw === undefined) return null;
  if (typeof raw === "string") return JSON.parse(raw);
  return raw; // déjà un objet/tableau natif : on le récupère tel quel
}

const uid = () => Math.random().toString(36).slice(2, 10);
const clamp = (n, min, max) => Math.min(Math.max(n, min), max);
const isGoogleDriveUrl = (value) => {
  try {
    const url = new URL(String(value || "").trim());
    return url.protocol === "https:" && (
      url.hostname === "drive.google.com" ||
      url.hostname === "docs.google.com"
    );
  } catch (_) {
    return false;
  }
};
const googleDriveKind = (value) => /\/folders\//i.test(String(value || "")) ? "folder" : "file";
const isGoogleDriveAttachment = (attachment) => !!attachment && (
  attachment.provider === "google-drive" || isGoogleDriveUrl(attachment.url)
);
const getGoogleDriveAttachments = (task) => (task?.attachments || []).filter(isGoogleDriveAttachment);
const getPrimaryGoogleDriveAttachment = (task) => getGoogleDriveAttachments(task)[0] || null;
// Tri alphabétique partagé, utilisé par tous les menus déroulants listant des
// éléments nommés par l'utilisateur (projets, statuts, catégories, tâches…).
const byName = (a, b) => (a.name || a.label || a.title || "").localeCompare(b.name || b.label || b.title || "", "fr");
const sortedByName = (list) => [...list].sort(byName);

// ============================================================================
// Import CSV
// ============================================================================
const IMPORT_FIELD_OPTIONS = [
  { key: "ignore", label: "Ignorer" },
  { key: "title", label: "Titre" },
  { key: "project", label: "Projet" },
  { key: "status", label: "Statut" },
  { key: "criticality", label: "Criticité" },
  { key: "taskType", label: "Type de tâche" },
  { key: "assignee", label: "Responsable" },
  { key: "milestone", label: "Jalon (oui/non)" },
  { key: "start", label: "Début" },
  { key: "end", label: "Fin" },
  { key: "progress", label: "Avancement (%)" },
  { key: "desc", label: "Description" },
];
function guessImportField(header) {
  const h = (header || "").toLowerCase().trim();
  if (/titre|title|^nom$|t[aâ]che|task|[ée]ph[ée]m[ée]ride/.test(h)) return "title";
  if (/projet|project/.test(h)) return "project";
  if (/statut|status/.test(h)) return "status";
  if (/type/.test(h)) return "taskType";
  if (/responsable|assign/.test(h)) return "assignee";
  if (/jalon|milestone/.test(h)) return "milestone";
  if (/d[ée]but|start|^jour$|^date$/.test(h)) return "start";
  if (/^fin$|end/.test(h)) return "end";
  if (/avanc|progress|%/.test(h)) return "progress";
  if (/desc/.test(h)) return "desc";
  return "ignore";
}
function parseFlexibleDate(str) {
  if (!str) return null;
  const s = String(str).trim();
  let m = s.match(/^(\d{4})-(\d{2})-(\d{2})/);
  if (m) return `${m[1]}-${m[2]}-${m[3]}`;
  m = s.match(/^(\d{1,2})[\/\-.](\d{1,2})[\/\-.](\d{4})$/);
  if (m) return `${m[3]}-${String(m[2]).padStart(2, "0")}-${String(m[1]).padStart(2, "0")}`;
  return null;
}
function parseImportBool(str) {
  return /^(oui|yes|true|1|vrai|x)$/i.test(String(str || "").trim());
}
function parseImportProgress(str) {
  if (str === undefined || str === null || str === "") return 0;
  const n = parseFloat(String(str).replace(",", ".").replace("%", "").trim());
  if (isNaN(n)) return 0;
  return Math.max(0, Math.min(100, Math.round(n)));
}
function getMappedValue(row, mapping, fieldKey) {
  const header = Object.keys(mapping).find((h) => mapping[h] === fieldKey);
  return header !== undefined ? row[header] : undefined;
}


// Répartit une liste de tâches en "voies" horizontales : deux tâches qui ne se
// chevauchent pas dans le temps (avec une marge minimale pour laisser la place
// aux étiquettes de dates) peuvent partager la même voie (même ligne visuelle).
// Déplace l'élément d'id "fromId" juste avant l'élément d'id "toId" dans un tableau.
function reorderArray(arr, fromId, toId) {
  const fromIdx = arr.findIndex((x) => x.id === fromId);
  const toIdx = arr.findIndex((x) => x.id === toId);
  if (fromIdx === -1 || toIdx === -1 || fromIdx === toIdx) return arr;
  const copy = [...arr];
  const [item] = copy.splice(fromIdx, 1);
  const insertAt = copy.findIndex((x) => x.id === toId);
  copy.splice(insertAt, 0, item);
  return copy;
}

// Équivalent tactile du clic droit : un appui long déclenche le même handler
// que onContextMenu, avec un pseudo-event (currentTarget/clientX/clientY figés
// au moment du touchstart, car React vide currentTarget après le dispatch).
function longPress(handler, ms = 500) {
  let timer = null;
  let startX = 0, startY = 0;
  const TOLERANCE = 10;
  const cancel = () => { if (timer) { clearTimeout(timer); timer = null; } };
  return {
    onTouchStart: (e) => {
      const touch = e.touches && e.touches[0];
      startX = touch ? touch.clientX : 0;
      startY = touch ? touch.clientY : 0;
      const currentTarget = e.currentTarget;
      cancel();
      timer = setTimeout(() => {
        timer = null;
        if (navigator.vibrate) navigator.vibrate(8);
        handler({ preventDefault: () => {}, stopPropagation: () => {}, currentTarget, clientX: startX, clientY: startY });
      }, ms);
    },
    onTouchMove: (e) => {
      const touch = e.touches && e.touches[0];
      if (touch && (Math.abs(touch.clientX - startX) > TOLERANCE || Math.abs(touch.clientY - startY) > TOLERANCE)) cancel();
    },
    onTouchEnd: cancel,
    onTouchCancel: cancel,
  };
}


const luminance = (hex) => {
  const c = (hex || "#999999").replace("#", "");
  const r = parseInt(c.substr(0, 2), 16) / 255, g = parseInt(c.substr(2, 2), 16) / 255, b = parseInt(c.substr(4, 2), 16) / 255;
  const a = [r, g, b].map((v) => (v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4)));
  return 0.2126 * a[0] + 0.7152 * a[1] + 0.0722 * a[2];
};
const textOn = (hex) => (luminance(hex) > 0.5 ? "#151313" : "#ffffff");

// Redimensionne une image uploadée en icône carrée (data URL)
function fileToIcon(file, size = 64) {
  return new Promise((resolve, reject) => {
    const reader = new FileReader();
    reader.onload = () => {
      const img = new Image();
      img.onload = () => {
        const canvas = document.createElement("canvas");
        canvas.width = size; canvas.height = size;
        const ctx = canvas.getContext("2d");
        const scale = Math.max(size / img.width, size / img.height);
        const w = img.width * scale, h = img.height * scale;
        ctx.drawImage(img, (size - w) / 2, (size - h) / 2, w, h);
        resolve(canvas.toDataURL("image/png"));
      };
      img.onerror = reject;
      img.src = reader.result;
    };
    reader.onerror = reject;
    reader.readAsDataURL(file);
  });
}

// ============================================================================
// Modèle de champs génériques (pour filtres, groupements, colonnes, règles...)
// ============================================================================


const periodOf = (endDateStr) => {
  const d = new Date(endDateStr + "T00:00:00");
  return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-01`;
};
// Période d'une tâche : le 1er du mois de sa date de fin, au format "01/MM/YYYY"
// demandé pour l'affichage — mais la valeur utilisée pour le tri/groupement
// reste au format ISO ("YYYY-MM-01") afin de rester chronologiquement triable
// (un format jour/mois/année ne trie pas correctement en chaîne de caractères).
function periodKeyOf(dateStr) {
  if (!dateStr) return null;
  return dateStr.slice(0, 7) + "-01";
}
function periodLabelOf(key) {
  if (!key) return "";
  const [yyyy, mm] = key.split("-");
  return `01/${mm}/${yyyy}`;
}

// Criticité (issue #35) : à quel point une tâche presse, indépendamment de son
// avancement. « Urgent » était un statut, ce qui obligeait à choisir entre dire OÙ
// EN EST une tâche et dire À QUEL POINT elle presse : la mettre urgente effaçait
// son avancement. Les deux dimensions sont désormais séparées.
//
// Liste fermée plutôt qu'entités éditables comme les statuts : trois valeurs
// suffisent, et une table de plus se paierait en réglages à maintenir. L'ordre du
// tableau est l'ordre d'affichage — un tri alphabétique placerait « Urgent » au
// milieu, entre « Bas » et « Moyen ».
// === NEXORA:CRITICALITY:START ===
/* Les trois niveaux, du plus bas au plus haut. Cet ordre est celui de lecture
   des listes ; la heat map le retourne exprès (voir heatmapOrderCriticalities).

   Les couleurs forment un feu tricolore : vert, orange, rouge (#69). « Bas »
   était gris ardoise, ce qui le rendait indistinguable de « sans criticité »
   partout où la couleur porte l'information — pastille de la fiche de tâche,
   tuile de Treemap, case de heat map. Le vert vient de --success, la palette de
   Nexora, plutôt que d'une teinte inventée pour l'occasion. */
const CRITICALITIES = [
  { id: "bas", name: "Bas", color: "#1FA971" },
  { id: "moyen", name: "Moyen", color: "#D97706" },
  { id: "urgent", name: "Urgent", color: "#DC2626" },
];
const criticalityOf = (task) => CRITICALITIES.find((c) => c.id === task?.criticality) || null;

// Décide de la reprise, sans rien exécuter : quelles tâches réaffecter, quels
// statuts « Urgent » retirer, lesquels conserver faute de remplacement. Fonction
// pure, sans React ni état — c'est elle que les tests couvrent, extraite de
// l'interface réellement construite.
//
// statusesForProject est passé en paramètre plutôt que capturé : la portée d'un
// statut (global, ou propre à un projet) est une règle de l'application, et ce bloc
// doit rester évaluable seul.
function planUrgentMigration({ tasks, statuses, projects, statusesForProject }) {
  const plan = { reassign: [], removeStatusIds: [], keptStatusIds: [] };
  const urgentIds = new Set((statuses || []).filter((s) => /urgent/i.test(String(s?.name || ""))).map((s) => s.id));
  if (!urgentIds.size) return plan;

  const kept = new Set();
  (tasks || []).forEach((t) => {
    if (!t || !urgentIds.has(t.statusId)) return;
    const scoped = statusesForProject(statuses, projects, t.projectId) || [];
    // Le remplacement se cherche dans la portée de CETTE tâche : un « En cours »
    // appartenant à un autre projet ne lui est pas proposable.
    const target = scoped.find((s) => /en\s*cours/i.test(String(s?.name || "")) && !urgentIds.has(s.id)) || null;
    if (!target) { kept.add(t.statusId); return; }
    plan.reassign.push({ taskId: t.id, statusId: target.id });
  });

  plan.keptStatusIds = [...kept];
  // Un statut encore référencé n'est jamais retiré : le supprimer laisserait ses
  // tâches pointant vers un statut inexistant.
  plan.removeStatusIds = [...urgentIds].filter((id) => !kept.has(id));
  return plan;
}
// === NEXORA:CRITICALITY:END ===

// « Urgent » ne figure plus ici : le statut est supprimé (issue #35). Le laisser
// protégé le rendrait indestructible et toujours proposé dans tous les projets —
// la reprise ci-dessous ne ferait alors que déplacer le problème.
const isProtectedStatus = (status) => {
  const name = String(status?.name || "");
  return /termin/i.test(name) || /en\s*cours/i.test(name);
};

const getStatusesForProject = (statuses, projects, projectId, currentStatusId = null) => {
  const project = (projects || []).find((p) => p.id === projectId);
  const disabled = new Set(project?.disabledStatusIds || []);

  const allowed = (statuses || []).filter((status) => {
    // Statut spécifique : uniquement dans son projet.
    if (status.projectId) return status.projectId === projectId;

    // Les statuts protégés globaux restent toujours disponibles.
    if (isProtectedStatus(status)) return true;

    // Statut global désactivé pour ce projet.
    return !disabled.has(status.id);
  });

  // Si une tâche existante utilise encore un statut désormais masqué,
  // on le conserve dans son sélecteur pour éviter une perte silencieuse.
  if (currentStatusId && !allowed.some((status) => status.id === currentStatusId)) {
    const current = (statuses || []).find((status) => status.id === currentStatusId);
    if (current) return [...allowed, current];
  }

  return allowed;
};

const getDefaultStatusForProject = (statuses, projects, projectId) => {
  const allowed = getStatusesForProject(statuses, projects, projectId);
  return (
    allowed.find((s) => /planifier|nouveau|backlog|attente/i.test(s.name || "")) ||
    allowed.find((s) => /en\s*cours/i.test(s.name || "")) ||
    allowed[0] ||
    null
  );
};

// ============================================================================
// Types de tâche — même mécanique que les Statuts : liste globale + types
// spécifiques à un projet + possibilité de désactiver certains types globaux
// par projet (project.disabledTaskTypeIds). Les 3 types par défaut (Tâches,
// Planning, Réunions) sont verrouillés (impossible de les supprimer ou de
// changer leur portée), au lieu de se baser sur un nom comme les statuts
// protégés — plus explicite et sans dépendre du texte.
// ============================================================================
const isLockedTaskType = (type) => !!type?.locked;

const getTaskTypesForProject = (taskTypes, projects, projectId, currentTaskTypeId = null) => {
  const project = (projects || []).find((p) => p.id === projectId);
  const disabled = new Set(project?.disabledTaskTypeIds || []);

  const allowed = (taskTypes || []).filter((type) => {
    // Type spécifique : uniquement dans son projet.
    if (type.projectId) return type.projectId === projectId;

    // Les types verrouillés globaux restent toujours disponibles.
    if (isLockedTaskType(type)) return true;

    // Type global désactivé pour ce projet.
    return !disabled.has(type.id);
  });

  // Si une tâche existante utilise encore un type désormais masqué, on le
  // conserve dans son sélecteur pour éviter une perte silencieuse.
  if (currentTaskTypeId && !allowed.some((type) => type.id === currentTaskTypeId)) {
    const current = (taskTypes || []).find((type) => type.id === currentTaskTypeId);
    if (current) return [...allowed, current];
  }

  return allowed;
};

const getDefaultTaskTypeForProject = (taskTypes, projects, projectId) => {
  const allowed = getTaskTypesForProject(taskTypes, projects, projectId);
  return (
    allowed.find((t) => isLockedTaskType(t) && /^t[âa]ches?$/i.test(t.name || "")) ||
    allowed.find((t) => isLockedTaskType(t)) ||
    allowed[0] ||
    null
  );
};

// Recherche un type de tâche par son nom (insensible à la casse, aux accents
// et au singulier/pluriel) — utilisé par les raccourcis clavier "créer une
// tâche de type X" qui doivent retrouver le type même s'il a été renommé
// légèrement ou si son id diffère des seeds par défaut ("tt2", "tt3"...).
// === NEXORA:TEXT-MATCH:START ===
const normalizeForMatch = (s) =>
  String(s || "").normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase().trim();
// === NEXORA:TEXT-MATCH:END ===
const findTaskTypeByName = (taskTypes, name) => {
  const target = normalizeForMatch(name);
  const list = taskTypes || [];
  return (
    list.find((t) => normalizeForMatch(t.name) === target) ||
    list.find((t) => normalizeForMatch(t.name) === target + "s") ||
    list.find((t) => normalizeForMatch(t.name).startsWith(target)) ||
    null
  );
};

// Un type de tâche peut restreindre les tâches qui le portent à un UNIQUE
// statut automatique (ex. le type "Information", dont le seul statut possible
// est "Information") via `type.restrictedStatusId` — cette restriction prime
// sur les statuts habituellement autorisés par le projet.
const restrictedStatusForType = (taskTypes, statuses, taskTypeId) => {
  const type = (taskTypes || []).find((t) => t.id === taskTypeId);
  if (!type?.restrictedStatusId) return null;
  return (statuses || []).find((s) => s.id === type.restrictedStatusId) || null;
};

// Équivalents de getStatusesForProject/getDefaultStatusForProject, mais qui
// tiennent compte en plus d'une éventuelle restriction posée par le type de
// la tâche (voir restrictedStatusForType ci-dessus).
const getStatusesForTask = (statuses, projects, taskTypes, projectId, taskTypeId, currentStatusId = null) => {
  const restricted = restrictedStatusForType(taskTypes, statuses, taskTypeId);
  if (restricted) return [restricted];
  return getStatusesForProject(statuses, projects, projectId, currentStatusId);
};
const getDefaultStatusForTask = (statuses, projects, taskTypes, projectId, taskTypeId) => {
  const restricted = restrictedStatusForType(taskTypes, statuses, taskTypeId);
  if (restricted) return restricted;
  return getDefaultStatusForProject(statuses, projects, projectId);
};

const FIELD_DEFS = [
  { key: "project", label: "Projet", kind: "select", getValue: (t) => t.projectId, optionsFn: (ctx) => sortedByName(ctx.projects).map((p) => ({ value: p.id, label: p.name, color: p.color, icon: p.icon })) },
  { key: "status", label: "Statut", kind: "select", getValue: (t) => t.statusId, optionsFn: (ctx) => sortedByName(ctx.statuses).map((s) => ({ value: s.id, label: s.name, color: s.color, icon: s.icon })) },
  // Même forme que « status » : tout ce qui consomme FIELD_DEFS — groupement, tri,
  // filtres, filtres avancés — traite donc la criticité sans code spécifique.
  // optionsFn ne trie pas : l'ordre de CRITICALITIES est l'ordre voulu.
  { key: "criticality", label: "Criticité", kind: "select", getValue: (t) => t.criticality || "", optionsFn: () => CRITICALITIES.map((c) => ({ value: c.id, label: c.name, color: c.color })) },
  { key: "taskType", label: "Type", kind: "select", getValue: (t) => t.taskTypeId, optionsFn: (ctx) => sortedByName(ctx.taskTypes || []).map((s) => ({ value: s.id, label: s.name, color: s.color, icon: s.icon })) },
  { key: "assignee", label: "Responsable", kind: "select", getValue: (t) => t.assignee || "", optionsFn: (ctx) => sortedByName(ctx.teamMembers || []).map((u) => ({ value: u.name, label: u.name, color: u.color, icon: u.avatarDataUrl })) },
  // Dérivé de l'équipe du responsable (#159) : aucun champ propre sur la tâche,
  // c'est teamMembers.teamId qui porte la donnée. `getValue` reçoit `ctx` en
  // second argument pour cette seule raison — tous les autres champs l'ignorent.
  { key: "team", label: "Équipe", kind: "select",
    getValue: (t, ctx) => teamIdForAssignee(t?.assignee, ctx),
    optionsFn: (ctx) => sortedByName(normalizeTeams(ctx?.teams)).map((tm) => ({ value: tm.id, label: tm.name, color: tm.color })) },
  { key: "milestone", label: "Jalon", kind: "boolean", getValue: (t) => getTaskType(t) === "milestone" },
  { key: "progress", label: "Avancement", kind: "number", getValue: (t) => t.progress },
  { key: "start", label: "Début", kind: "date", getValue: (t) => t.start },
  { key: "end", label: "Fin", kind: "date", getValue: (t) => t.end },
  { key: "inactivity", label: "Inactivité (jours)", kind: "number", getValue: (t) => taskInteractionAgeDays(t) },
  { key: "period", label: "Période", kind: "date", getValue: (t) => periodKeyOf(t.end), formatLabel: (v) => periodLabelOf(v) },
  { key: "title", label: "Titre", kind: "text", getValue: (t) => t.title },
];
const fieldDef = (key, ctx) => FIELD_DEFS.find((f) => f.key === key);
const fieldLabel = (key, ctx) => (key === "checklist" ? "Sous-tâches" : key === "desc" ? "Description" : key === "none" ? "Aucun" : fieldDef(key, ctx)?.label || key);

// ============================================================================
// Registre des vues (pour les onglets + les cases à cocher "Vues affichées")
// ============================================================================
// Icônes lucide-react (traits fins et cohérents) plutôt que des emoji, qui
// rendent différemment selon OS/navigateur et cassaient l'unité du système
// d'icônes de la navigation.
const ALL_VIEWS_META = [
  { key: "dashboard", label: "Tableau de bord", iconKey: "tabler:layout-dashboard" },
  { key: "projects", label: "Planning Projets", iconKey: "tabler:route" },
  // La clé historique reste volontairement `gantt` : elle maintient les vues
  // sauvegardées et la dernière vue ouverte, mais ne désigne plus le moteur
  // classique. Son unique rendu est désormais le Mini Gantt.
  { key: "gantt", label: "Gantt", iconKey: "tabler:chart-gantt" },
  { key: "heatmap", label: "Heat map", iconKey: "tabler:flame" },
  { key: "timeline", label: "Timeline + Liste", iconKey: "tabler:timeline" },
  { key: "radar", label: "Radar", iconKey: "tabler:radar" },
  { key: "today", label: "Aujourd'hui", iconKey: "tabler:sun" },
  // Pages fixes, sans widget (#193 suite) : Cockpit du jour reprend l'esprit
  // d'« Aujourd'hui » mais priorisé plutôt qu'exhaustif ; Semaine fusionne le
  // radar de la semaine et les alertes en une seule page (retenue : option C,
  // flux chronologique).
  { key: "cockpit", label: "Cockpit", iconKey: "tabler:gauge" },
  { key: "weekFlow", label: "Semaine", iconKey: "tabler:calendar-week" },
  { key: "table", label: "Tableur", iconKey: "tabler:table" },
  { key: "notifications", label: "Notifications", iconKey: "tabler:bell" },
];
// === NEXORA:VIEW-RAIL-COUNT:START ===
/* Badge d'une bulle du rail vertical (issue #65).

   « Le nombre d'éléments concernés » n'a de sens que là où il est SANS
   AMBIGUÏTÉ : des projets pour le planning, des tableaux pour les tableaux de
   bord, des notifications non lues, et les échéances du jour pour
   « Aujourd'hui ».

   Rend 0 pour « aucun badge » : l'issue ne veut un badge que si le compteur
   dépasse zéro, et un « 0 » affiché ne dit rien d'utile. */
function viewRailBadgeCount(key, counts) {
  const c = counts || {};
  const n = (v) => (Number.isFinite(v) && v > 0 ? Math.floor(v) : 0);
  switch (key) {
    case "projects": return n(c.projects);
    case "dashboard": return n(c.dashboards);
    case "notifications": return n(c.unreadNotifications);
    case "today": return n(c.dueToday);
    case "cockpit": return n(c.overdue);
    case "weekFlow": return n(c.overdue);
    default: return 0;
  }
}

/* Le badge doit rester lisible jusqu'à trois chiffres (issue #65). Au-delà, un
   quatrième élargirait la bulle : « 999+ » borne la largeur sans mentir sur
   l'ordre de grandeur. */
function viewRailBadgeLabel(count) {
  const n = Number.isFinite(count) ? Math.floor(count) : 0;
  if (n <= 0) return "";
  return n > 999 ? "999+" : String(n);
}
// === NEXORA:VIEW-RAIL-COUNT:END ===

// Destinations de haut niveau — seules celles-ci restent dans le bandeau vertical.
// Les autres (les "vues" de détail sur les tâches) deviennent des onglets affichés
// une fois un contexte projet actif, plutôt que des destinations indépendantes.
const TOP_LEVEL_VIEW_KEYS = ["projects", "today", "cockpit", "weekFlow", "dashboard", "notifications"];
// Vues de détail — apparaissent en onglets horizontaux, jamais dans le bandeau.
const PROJECT_TAB_VIEW_KEYS = ["projects", "gantt", "heatmap", "timeline", "radar", "table"];

const PROJECT_DEFAULT_VIEW_OPTIONS = [
  { key:"projects", label:"Métro" },
  { key:"gantt", label:"Gantt" },
  { key:"heatmap", label:"Heat map" },
  { key:"timeline", label:"Timeline + Liste" },
  { key:"radar", label:"Radar" },
  { key:"table", label:"Tableur" },
  // #137 : ouvre la vue Tableau de bord au lieu d'une vue de tâches — utile
  // avec une page dont le filtre porte sur "Projet courant" (CURRENT_PROJECT_FILTER) :
  // ses widgets se scopent alors automatiquement au projet ouvert.
  { key:"dashboard", label:"Tableau de bord contextuel" },
];

const projectNavigationZoomOptions = (viewKey) => {
  if (viewKey === "projects") return [
    { key:"auto", label:"Auto" }, { key:"day", label:"Jour" }, { key:"week", label:"Semaine" },
    { key:"month", label:"Mois" }, { key:"quarter", label:"Trimestre" }, { key:"year", label:"Année" }
  ];
  if (viewKey === "gantt") return [
    { key:"day", label:"Jour" }, { key:"week", label:"Semaine" }, { key:"month", label:"Mois" },
    { key:"quarter", label:"Trimestre" }, { key:"year", label:"Année" }, { key:"5years", label:"5 ans" }
  ];
  if (viewKey === "timeline") return [
    { key:"day", label:"Jour" }, { key:"week", label:"Semaine" }, { key:"month", label:"Mois" }, { key:"auto", label:"Auto" }
  ];
  return [];
};

// === NEXORA:PROJECT-DEFAULT-VIEW:START ===
/* Vue par défaut à l'ouverture d'un projet, réglée dans Réglages > Vues
   affichées. C'est le SOCLE : un dossier, puis un projet, peuvent la
   remplacer depuis leur propre « Ouverture par défaut ». Vide = ne rien
   imposer, et donc conserver la vue en cours, comme avant ce réglage. */
const normalizeProjectDefaultView = (value) =>
  PROJECT_DEFAULT_VIEW_OPTIONS.some((v) => v.key === value) ? value : "";

const mergeProjectNavigationDefaults = (project, folder, globalView = "") => {
  const folderPrefs = folder?.navigationDefaults || {};
  const projectPrefs = project?.navigationDefaults || {};
  return {
    view: projectPrefs.view || folderPrefs.view || normalizeProjectDefaultView(globalView),
    zoom: projectPrefs.zoom || folderPrefs.zoom || "",
    filters: projectPrefs.filters !== undefined ? projectPrefs.filters : folderPrefs.filters
  };
};
// === NEXORA:PROJECT-DEFAULT-VIEW:END ===

const defaultEnabledViews = () => Object.fromEntries(ALL_VIEWS_META.map((v) => [v.key, true]));

const FIELD_PROP = { project: "projectId", status: "statusId", taskType: "taskTypeId", assignee: "assignee", milestone: "milestone", progress: "progress", start: "start", end: "end", title: "title" };

function groupTasks(tasks, fieldKey, ctx) {
  if (!fieldKey || fieldKey === "none") return [{ key: "all", label: "Toutes les tâches", color: "var(--text-muted)", icon: null, tasks }];
  const def = fieldDef(fieldKey, ctx);
  if (!def) return [{ key: "all", label: "Toutes les tâches", color: "var(--text-muted)", tasks }];
  if (def.kind === "boolean") {
    return [
      { key: "true", label: "Oui", color: "var(--success)", tasks: tasks.filter((t) => def.getValue(t, ctx)) },
      { key: "false", label: "Non", color: "var(--text-muted)", tasks: tasks.filter((t) => !def.getValue(t, ctx)) },
    ];
  }
  if (def.kind === "select") {
    const opts = def.optionsFn(ctx);
    const groups = opts.map((o) => ({ key: String(o.value), label: o.label, color: o.color, icon: o.icon, tasks: tasks.filter((t) => String(def.getValue(t, ctx)) === String(o.value)) }));
    const rest = tasks.filter((t) => !opts.some((o) => String(o.value) === String(def.getValue(t, ctx))));
    if (rest.length) groups.push({ key: "__none", label: "Non défini", color: "#CBD5E1", tasks: rest });
    return groups;
  }
  const map = new Map();
  tasks.forEach((t) => {
    const v = def.getValue(t, ctx);
    const k = v === undefined || v === null || v === "" ? "__none" : String(v);
    if (!map.has(k)) map.set(k, []);
    map.get(k).push(t);
  });
  return Array.from(map.entries()).sort((a, b) => (a[0] < b[0] ? -1 : 1))
    .map(([k, ts]) => ({ key: k, label: k === "__none" ? "Non défini" : (def.formatLabel ? def.formatLabel(k) : (def.kind === "date" ? fmtShort(k) : k)), color: "var(--text-muted)", tasks: ts }));
}

function matchesGroupKey(task, fieldKey, key, ctx) {
  if (!fieldKey || fieldKey === "none") return true;
  const def = fieldDef(fieldKey, ctx);
  if (!def) return true;
  if (def.kind === "boolean") return String(!!def.getValue(task, ctx)) === key;
  if (key === "__none") {
    if (def.kind === "select") { const opts = def.optionsFn(ctx); return !opts.some((o) => String(o.value) === String(def.getValue(task, ctx))); }
    const v = def.getValue(task, ctx);
    return v === undefined || v === null || v === "";
  }
  return String(def.getValue(task, ctx)) === String(key);
}

function setTaskField(setTasks, taskId, fieldKey, key) {
  if (!fieldKey || fieldKey === "none" || key === "__none") return;
  const prop = FIELD_PROP[fieldKey];
  if (!prop) return;
  let value = key;
  if (fieldKey === "milestone") value = key === "true";
  if (fieldKey === "progress") value = Number(key);
  setTasks((prev) => prev.map((t) => {
    if (t.id !== taskId) return t;
    if (fieldKey === "type") {
      const nextType = value;
      return { ...t, type:nextType, milestone:nextType === "milestone", end:nextType === "milestone" ? (t.start || t.end) : t.end, linkedActivityId:nextType === "action" ? (t.linkedActivityId || null) : null };
    }
    if (fieldKey === "milestone") return { ...t, milestone:value, type:value ? "milestone" : "action" };
    return { ...t, [prop]: value };
  }));
}


const getTaskType = (task) => task?.milestone ? "milestone" : "action";
const taskTypeLabel = (task) => task?.milestone ? "Jalon" : "Tâche";


const ADVANCED_FILTER_FIELDS = ["title", "project", "status", "criticality", "taskType", "assignee", "milestone", "start", "end", "inactivity"];

const NO_PROJECT_FILTER = "__nexora_without_project__";
// === NEXORA:CURRENT-PROJECT-FILTER:START ===
// #137 : sentinelle "Projet courant" — résolue à l'ÉVALUATION du filtre avec
// le(s) projet(s) actuellement ouvert(s) (ctx.activeProjectIds), jamais figée
// dans la donnée du filtre elle-même (voir resolveProjectFilterIds).
const CURRENT_PROJECT_FILTER = "__nexora_current_project__";
// Aucune tâche ne porte jamais cet id : utilisé quand "Projet courant" est
// demandé sans qu'aucun projet ne soit ouvert, pour que le filtre ne matche
// explicitement RIEN plutôt que de retomber sur tout le portefeuille.
const CURRENT_PROJECT_FILTER_NONE = "__nexora_current_project_none__";

// Aide partagée : la ou les valeurs de la condition "project" au premier
// niveau du filtre avancé — utilisée par les raccourcis de la sidebar et par
// resolveProjectFilterIds ci-dessous.
function getProjectFilterIds(f) {
  const items = (f && f.advanced && f.advanced.items) || [];
  const cond = items.find((it) => it.field === "project" && it.mode !== "isnot");
  return cond ? (cond.values || []) : [];
}

// Développe la sentinelle "Projet courant" dans une liste projectIds — à
// l'évaluation seulement, jamais dans la donnée persistée d'un filtre de
// page/widget ou de budgetProjectId.
function resolveProjectFilterIds(ids, ctx) {
  if (!Array.isArray(ids) || !ids.includes(CURRENT_PROJECT_FILTER)) return ids;
  const current = (ctx && ctx.activeProjectIds) || [];
  const rest = ids.filter((id) => id !== CURRENT_PROJECT_FILTER);
  if (current.length) return [...new Set([...rest, ...current])];
  return rest.length ? rest : [CURRENT_PROJECT_FILTER_NONE];
}
// === NEXORA:CURRENT-PROJECT-FILTER:END ===

const defaultFilters = () => ({
  search: "",
  milestone: "all", progressMin: 0, progressMax: 100, startFrom: "", startTo: "", endFrom: "", endTo: "", lateOnly: false,
  dueWithinDays: "", pastDays: "", inactivityDays: "",
  quickDatePreset: "", // préréglage rapide sur la date de fin, depuis la barre du haut
  showDone: false,
  urgentOnly: false,
  advanced: { op: "and", items: [] },
});
// Méta-filtres = socle global appliqué avant tous les filtres de vue/widget.
// Contrairement aux filtres usuels, leur valeur par défaut est neutre : aucune
// tâche n'est exclue tant que l'utilisateur n'a rien configuré.
const defaultMetaFilters = () => ({
  ...defaultFilters(),
  showDone: true,
});
// L'urgence se lit désormais sur la criticité, plus sur le nom du statut (issue
// #35). Tout ce qui s'appuie sur cette fonction suit sans changer : filtre
// « urgentes », liseré et hachures des lignes, barres du Gantt, bulles de la vue
// Métro, bloc « Tâches urgentes » d'Aujourd'hui, poids du treemap, métriques.
//
// Le repli sur le nom du statut couvre deux fenêtres réelles : entre le chargement
// des données et la reprise, et le temps qu'un appareil encore servi par une
// version antérieure ait rechargé l'application.
function isTaskUrgent(task, ctx) {
  if (task?.criticality) return task.criticality === "urgent";
  const st = ctx.statuses.find((s) => s.id === task.statusId);
  return !!(st && /urgent/i.test(st.name || ""));
}
// Dernière interaction : horodatage ISO mis à jour à chaque mutation réelle d'un
// objet tâche/action/activité/jalon. L'âge d'inactivité est calculé à la volée.
function taskInteractionAgeDays(task, now = new Date()) {
  if (!task || !task.lastInteraction) return Infinity;
  const d = new Date(task.lastInteraction);
  if (Number.isNaN(d.getTime())) return Infinity;
  return Math.max(0, Math.floor((now.getTime() - d.getTime()) / 86400000));
}

// Date réelle de complétion d'une tâche.
// Priorité : horodatage explicite > journal d'activité.
// `todoistCompletedAt` n'est plus jamais écrit depuis la suppression de la
// liaison Todoist, mais reste LU : les tâches terminées à l'époque par cette
// synchronisation gardent ainsi leur vraie date de complétion.
// On ne retombe PAS sur lastInteraction : une synchro ou une simple édition
// ne doit jamais faire croire qu'une tâche vient d'être terminée.
function taskCompletionDate(task, activityLog = []) {
  if (!task) return null;

  const explicit = [
    task.completedAt,
    task.todoistCompletedAt,
    task.doneAt,
    task.closedAt,
  ].filter(Boolean);

  for (const raw of explicit) {
    const d = new Date(raw);
    if (!Number.isNaN(d.getTime())) return d;
  }

  const events = (activityLog || [])
    .filter((e) => e?.type === "completed" && e?.taskId === task.id && e?.at)
    .map((e) => new Date(e.at))
    .filter((d) => !Number.isNaN(d.getTime()))
    .sort((a,b) => b.getTime() - a.getTime());

  return events[0] || null;
}

function taskCompletionAgeDays(task, activityLog = [], now = new Date()) {
  const d = taskCompletionDate(task, activityLog);
  if (!d) return null;
  return Math.max(0, Math.floor((now.getTime() - d.getTime()) / 86400000));
}
// #142 : mêmes types que ceux collectés dans `activityLog` (part-001) — les
// libellés y étaient jusqu'ici recopiés à la main dans le Daily Briefing pour
// les 4 types qu'il agrège ; l'onglet Historique de la fiche en a besoin pour
// les 9, d'où ce catalogue unique.
const ACTIVITY_LOG_ENTRY_META = {
  created: { icon: "✦", label: "Tâche créée" },
  statusChanged: { icon: "↻", label: "Statut modifié" },
  completed: { icon: "✓", label: "Marquée terminée" },
  reopened: { icon: "↺", label: "Rouverte" },
  reassigned: { icon: "→", label: "Réaffectée" },
  deadlineChanged: { icon: "⚠", label: "Échéance modifiée" },
  blocked: { icon: "🔒", label: "Bloquée (dépendance non terminée)" },
  unblocked: { icon: "🔓", label: "Débloquée" },
  deleted: { icon: "✕", label: "Supprimée" },
};
function activityLogEntryDetail(entry) {
  if (!entry) return "";
  if (entry.type === "reassigned") return `${entry.from || "Personne non assignée"} → ${entry.to || "Personne non assignée"}`;
  if (entry.type === "deadlineChanged") return `${entry.fromDate ? fmtShort(entry.fromDate) : "—"} → ${entry.toDate ? fmtShort(entry.toDate) : "—"}`;
  return "";
}
function formatLastInteraction(task) {
  if (!task || !task.lastInteraction) return "Jamais";
  const d = new Date(task.lastInteraction);
  if (Number.isNaN(d.getTime())) return "Jamais";
  return d.toLocaleString("fr-FR", { day:"2-digit", month:"2-digit", year:"numeric", hour:"2-digit", minute:"2-digit" });
}
function formatInteractionAge(task) {
  const n = taskInteractionAgeDays(task);
  if (!Number.isFinite(n)) return "Jamais";
  if (n === 0) return "Aujourd’hui";
  if (n === 1) return "1 jour";
  return `${n} jours`;
}

// ---------------------------------------------------------------------------
// Google Calendar — statut calculé automatiquement à partir des dates.
// Cette règle ne s'applique QU'aux tâches dont le projet principal provient
// de Google Calendar (project.gcalSource === true).
//
// Règles :
// - fin < aujourd'hui                         => Terminé
// - début <= aujourd'hui <= fin              => En cours
// - début > aujourd'hui                      => Planifié
//
// Le statut n'est jamais une donnée éditable pour ces tâches : il est dérivé.
// ---------------------------------------------------------------------------
function isGoogleCalendarProjectId(projectId, projects) {
  return !!projects.find((p) => p.id === projectId && p.gcalSource);
}

// Projets adossés à un calendrier : Google Calendar (gcalSource) et les
// calendriers publics synchronisés (syncedCalendarSource). Leurs tâches sont
// des événements datés par le calendrier — c'est ce qui leur permet de devenir
// un méta bloc temporel dont les dates suivent l'événement.
function isCalendarBackedProjectId(projectId, projects) {
  const p = (projects || []).find((x) => x.id === projectId);
  return !!p && (!!p.gcalSource || !!p.syncedCalendarSource);
}

function googleCalendarLifecycleStatusIds(statuses) {
  return {
    done: statuses.find((s) => /^termin/i.test((s.name || "").trim()))?.id || null,
    inProgress: statuses.find((s) => /^en\s*cours/i.test((s.name || "").trim()))?.id || null,
    planned:
      statuses.find((s) => /^planifi/i.test((s.name || "").trim()))?.id ||
      statuses.find((s) => /planifier/i.test((s.name || "").trim()))?.id ||
      null,
  };
}

function googleCalendarComputedStatusId(taskLike, projects, statuses, today = iso(new Date())) {
  if (!taskLike || !isGoogleCalendarProjectId(taskLike.projectId, projects)) return taskLike?.statusId || null;
  if (!taskLike.start || !taskLike.end) return taskLike.statusId || null;

  const ids = googleCalendarLifecycleStatusIds(statuses);
  if (taskLike.end < today) return ids.done || taskLike.statusId || null;
  if (taskLike.start > today) return ids.planned || taskLike.statusId || null;
  return ids.inProgress || taskLike.statusId || null;
}

// === NEXORA:COLOR-UTILS:START ===
// Interpolation linéaire entre deux couleurs hex, selon un pourcentage 0–1 — sert
// au dégradé de la Heat map (min/max personnalisables dans Apparence) et aux
// palettes du Treemap projets.
function lerpColor(hexA, hexB, pct) {
  const p = Math.max(0, Math.min(1, pct));
  const a = hexA.replace("#", ""), b = hexB.replace("#", "");
  const ar = parseInt(a.slice(0, 2), 16), ag = parseInt(a.slice(2, 4), 16), ab = parseInt(a.slice(4, 6), 16);
  const br = parseInt(b.slice(0, 2), 16), bg = parseInt(b.slice(2, 4), 16), bb = parseInt(b.slice(4, 6), 16);
  const r = Math.round(ar + (br - ar) * p), gCh = Math.round(ag + (bg - ag) * p), bl = Math.round(ab + (bb - ab) * p);
  return `#${[r, gCh, bl].map((v) => Math.max(0, Math.min(255, v)).toString(16).padStart(2, "0")).join("")}`;
}
// === NEXORA:COLOR-UTILS:END ===
// === NEXORA:TASK-STATUS:START ===
function isTaskDoneGlobal(task, ctx) {
  const st = ctx.statuses.find((s) => s.id === task.statusId);
  return !!(st && /termin/i.test(st.name || ""));
}
function isTaskLate(task, ctx) {
  if (isTaskDoneGlobal(task, ctx)) return false;
  return dayIndex(task.end) < dayIndex(iso(new Date()));
}
// Une "réunion" est un type de tâche explicite, jamais deviné sur le titre
// (une tâche "Préparer la réunion" n'en est pas une) — même définition que
// `meetingsOnly` côté MCP (apps/nexora-mcp/src/nexora.mts), pour que
// l'interface et l'assistant s'accordent sur ce qu'est une réunion.
function isMeetingTask(task, ctx) {
  const type = (ctx?.taskTypes || []).find((t) => t.id === task?.taskTypeId);
  return !!type && ["reunion", "reunions"].includes(normalizeForMatch(type.name));
}
// === NEXORA:TASK-STATUS:END ===
// Chemin critique d'un ensemble de tâches (typiquement toutes celles d'un même
// projet) : part de la tâche qui termine le plus tard, puis remonte les
// dépendances en choisissant à chaque étape celle(s) qui terminent le plus tard —
// s'il y a égalité entre deux prédécesseurs, les DEUX branches sont conservées en
// parallèle plutôt que d'en écarter une arbitrairement. Retourne un ensemble
// d'identifiants (peu importe l'organisation en branches) pour un usage simple
// comme mise en évidence (vue Planning Projets). Utiliser computeCriticalLevels
// pour une restitution structurée par générations (widget).
function computeCriticalIds(tasksArr) {
  if (tasksArr.length === 0) return new Set();
  const byId = Object.fromEntries(tasksArr.map((t) => [t.id, t]));
  const maxEnd = Math.max(...tasksArr.map((t) => dayIndex(t.end)));
  const ids = new Set(tasksArr.filter((t) => dayIndex(t.end) === maxEnd).map((t) => t.id));
  let frontier = [...ids];
  let guard = 0;
  while (frontier.length && guard < 5000) {
    const next = [];
    frontier.forEach((id) => {
      const t = byId[id];
      if (!t) return;
      const deps = (t.dependsOn || []).map((d) => byId[d]).filter(Boolean);
      if (deps.length === 0) return;
      const maxDepEnd = Math.max(...deps.map((d) => dayIndex(d.end)));
      deps.forEach((d) => {
        if (dayIndex(d.end) === maxDepEnd && !ids.has(d.id)) {
          ids.add(d.id);
          next.push(d.id);
        }
      });
      guard++;
    });
    frontier = next;
  }
  return ids;
}
// Même parcours que computeCriticalIds, mais organisé par générations
// (profondeur depuis la fin) pour une restitution structurée : chaque génération
// est un tableau de tâches — plusieurs tâches dans une même génération signifient
// des branches parallèles à égalité. Ordre chronologique : la génération la plus
// ancienne en premier, la tâche finale en dernier.
function computeCriticalLevels(tasksArr) {
  if (tasksArr.length === 0) return [];
  const byId = Object.fromEntries(tasksArr.map((t) => [t.id, t]));
  const maxEnd = Math.max(...tasksArr.map((t) => dayIndex(t.end)));
  const anchors = tasksArr.filter((t) => dayIndex(t.end) === maxEnd);
  const depthOf = new Map();
  anchors.forEach((t) => depthOf.set(t.id, 0));
  let frontier = anchors;
  let guard = 0;
  while (frontier.length && guard < 5000) {
    const next = [];
    frontier.forEach((t) => {
      const deps = (t.dependsOn || []).map((d) => byId[d]).filter(Boolean);
      if (deps.length === 0) return;
      const maxDepEnd = Math.max(...deps.map((d) => dayIndex(d.end)));
      deps.forEach((d) => {
        if (dayIndex(d.end) === maxDepEnd && !depthOf.has(d.id)) {
          depthOf.set(d.id, depthOf.get(t.id) + 1);
          next.push(d);
        }
      });
      guard++;
    });
    frontier = next;
  }
  const maxDepth = Math.max(...[...depthOf.values()]);
  const levels = [];
  for (let d = maxDepth; d >= 0; d--) {
    const tasksAtLevel = [...depthOf.entries()].filter(([, dep]) => dep === d).map(([id]) => byId[id]);
    if (tasksAtLevel.length) levels.push(tasksAtLevel);
  }
  return levels;
}
// ============================================================================
// Moteur "Next Best Action" — détermine, parmi toutes les tâches éligibles,
// celle qui aurait le plus d'impact à réaliser maintenant. Déterministe, basé
// uniquement sur des données réellement présentes dans l'app (dépendances,
// dates, chemin critique, jalons) — aucune donnée de priorité ou d'estimation
// n'existant dans le modèle actuel, ces deux facteurs ne sont volontairement
// PAS utilisés plutôt que d'être inventés (voir limites connues).
// Coefficients centralisés ici : c'est le seul endroit à modifier pour ajuster
// le comportement du moteur.
const NBA_WEIGHTS = {
  urgency: { overdue: 40, dueToday: 35, dueTomorrow: 28, within3: 20, within7: 10, beyond: 0 },
  overdueBonus: 15,
  dependencyImpact: { none: 0, low: 10, medium: 25, high: 40, veryHigh: 55 }, // 0 / 1-2 / 3-5 / 6-9 / 10+
  criticalPath: 25,
  milestoneImpact: 20,
  quickWinBonus: 10,
  effortPenalty: { small: 0, medium: 5, large: 10, veryLarge: 18 }, // ≤1j / 2-3j / 4-7j / >7j
  projectImportance: { high: 15, normal: 0, low: -10 }, // priorité du projet, réglable dans sa fiche
  noHighImpactThreshold: 20, // score en dessous duquel on affiche "aucune action ne se distingue"
};

function nbaDurationDays(t) {
  return Math.max(0, dayIndex(t.end) - dayIndex(t.start));
}
function nbaUrgencyScore(t, todayIdx) {
  const daysUntil = dayIndex(t.end) - todayIdx;
  if (daysUntil < 0) return NBA_WEIGHTS.urgency.overdue;
  if (daysUntil === 0) return NBA_WEIGHTS.urgency.dueToday;
  if (daysUntil === 1) return NBA_WEIGHTS.urgency.dueTomorrow;
  if (daysUntil <= 3) return NBA_WEIGHTS.urgency.within3;
  if (daysUntil <= 7) return NBA_WEIGHTS.urgency.within7;
  return NBA_WEIGHTS.urgency.beyond;
}
function nbaDependencyImpactScore(count) {
  if (count === 0) return NBA_WEIGHTS.dependencyImpact.none;
  if (count <= 2) return NBA_WEIGHTS.dependencyImpact.low;
  if (count <= 5) return NBA_WEIGHTS.dependencyImpact.medium;
  if (count <= 9) return NBA_WEIGHTS.dependencyImpact.high;
  return NBA_WEIGHTS.dependencyImpact.veryHigh;
}
function nbaEffortPenalty(days) {
  if (days <= 1) return NBA_WEIGHTS.effortPenalty.small;
  if (days <= 3) return NBA_WEIGHTS.effortPenalty.medium;
  if (days <= 7) return NBA_WEIGHTS.effortPenalty.large;
  return NBA_WEIGHTS.effortPenalty.veryLarge;
}

// Calcule le score et les raisons d'UNE tâche (isolé pour rester testable
// indépendamment du pipeline complet).
function calculateNextBestActionScore(t, ctx, todayIdx, criticalIds, blockedSet, milestoneUnlocked) {
  const late = isTaskLate(t, ctx);
  const urgency = nbaUrgencyScore(t, todayIdx);
  const overdueBonus = late ? NBA_WEIGHTS.overdueBonus : 0;
  const dependencyImpact = nbaDependencyImpactScore(blockedSet.size);
  const onCriticalPath = criticalIds.has(t.id);
  const criticalPathScore = onCriticalPath ? NBA_WEIGHTS.criticalPath : 0;
  const milestoneScore = milestoneUnlocked ? NBA_WEIGHTS.milestoneImpact : 0;
  const days = nbaDurationDays(t);
  const effortPenalty = nbaEffortPenalty(days);
  const isQuickWin = days <= 1 && blockedSet.size >= 3;
  const quickWinBonus = isQuickWin ? NBA_WEIGHTS.quickWinBonus : 0;
  const project = ctx.projects.find((p) => p.id === t.projectId);
  const projectImportanceScore = NBA_WEIGHTS.projectImportance[project?.priority || "normal"] ?? 0;
  const totalScore = Math.max(0, Math.min(100, urgency + overdueBonus + dependencyImpact + criticalPathScore + milestoneScore + quickWinBonus + projectImportanceScore - effortPenalty));

  const daysUntil = dayIndex(t.end) - todayIdx;
  const reasons = [];
  if (late) reasons.push({ icon: "late", text: `En retard de ${todayIdx - dayIndex(t.end)} jour${todayIdx - dayIndex(t.end) > 1 ? "s" : ""}` });
  else if (daysUntil === 0) reasons.push({ icon: "due", text: "Échéance aujourd'hui" });
  else if (daysUntil === 1) reasons.push({ icon: "due", text: "Échéance demain" });
  else if (daysUntil <= 7) reasons.push({ icon: "due", text: `Échéance dans ${daysUntil} jours` });
  if (blockedSet.size > 0) reasons.push({ icon: "block", text: `Bloque ${blockedSet.size} tâche${blockedSet.size > 1 ? "s" : ""}` });
  if (onCriticalPath) reasons.push({ icon: "critical", text: "Sur le chemin critique" });
  if (milestoneUnlocked) reasons.push({ icon: "milestone", text: `Débloque le jalon « ${milestoneUnlocked.title} »` });
  if (isQuickWin) reasons.push({ icon: "quick", text: "Quick win : faible effort, fort impact" });
  if (project?.priority === "high") reasons.push({ icon: "priority", text: `Projet prioritaire (${project.name})` });

  return {
    task: t,
    totalScore,
    isQuickWin,
    factors: { urgency, overdueBonus, dependencyImpact, criticalPathScore, milestoneScore, quickWinBonus, projectImportanceScore, effortPenalty },
    blockedCount: blockedSet.size,
    effortDays: days,
    onCriticalPath,
    unblocksMilestone: milestoneUnlocked,
    reasons,
  };
}

// Pipeline complet : filtrage des tâches éligibles → scoring → classement.
// Sépare volontairement le moteur de décision de l'interface (§20 de la
// demande), pour rester testable et réutilisable indépendamment du widget.
// Graphe de dépendances partagé : construit le graphe inverse (qui dépend de
// qui) une seule fois, et expose des fonctions pour mesurer l'impact réel de
// blocage de n'importe quelle tâche — réutilisé par Next Best Action ET par
// le widget Domino Effect, pour ne jamais dupliquer cette logique.
function buildDependencyGraph(tasks, ctx) {
  const dated = tasks.filter((t) => t.start && t.end);
  const byId = Object.fromEntries(dated.map((t) => [t.id, t]));
  const dependents = {}; // qui dépend DIRECTEMENT de chaque tâche
  dated.forEach((t) => {
    (t.dependsOn || []).forEach((depId) => {
      (dependents[depId] = dependents[depId] || []).push(t.id);
    });
  });
  const notDoneIds = new Set(dated.filter((t) => !isTaskDoneGlobal(t, ctx)).map((t) => t.id));

  // Impact direct + indirect : toutes les tâches NON terminées qui dépendent,
  // directement ou en cascade, de la tâche donnée.
  function blockedSetFor(taskId) {
    const seen = new Set();
    let frontier = dependents[taskId] || [];
    let guard = 0;
    while (frontier.length && guard < 3000) {
      const next = [];
      frontier.forEach((id) => {
        if (seen.has(id) || !notDoneIds.has(id)) return;
        seen.add(id);
        next.push(...(dependents[id] || []));
      });
      frontier = next;
      guard++;
    }
    return seen;
  }
  // Impact direct uniquement (premier niveau) — utile pour distinguer "bloque
  // directement" de "impact en cascade" dans l'affichage détaillé.
  function directBlockedFor(taskId) {
    return (dependents[taskId] || []).filter((id) => notDoneIds.has(id)).map((id) => byId[id]).filter(Boolean);
  }
  function milestoneUnlockedBy(taskId) {
    const seen = new Set();
    let frontier = dependents[taskId] || [];
    let guard = 0;
    while (frontier.length && guard < 3000) {
      const next = [];
      for (const id of frontier) {
        if (seen.has(id)) continue;
        seen.add(id);
        const t = byId[id];
        if (!t) continue;
        if (t.milestone && notDoneIds.has(t.id)) return t;
        next.push(...(dependents[id] || []));
      }
      frontier = next;
      guard++;
    }
    return null;
  }
  return { dated, byId, dependents, notDoneIds, blockedSetFor, directBlockedFor, milestoneUnlockedBy };
}

// ============================================================================
// Moteur "Domino Effect" — identifie les tâches dont la réalisation aurait le
// plus d'effet d'entraînement, en s'appuyant sur le même graphe de dépendances
// que Next Best Action (buildDependencyGraph), sans dupliquer cette logique.
// "Certaines tâches sont importantes non pas parce qu'elles sont urgentes,
// mais parce qu'elles débloquent beaucoup d'autres tâches."
// ============================================================================
const DOMINO_WEIGHTS = {
  perDirect: 8, // points par tâche bloquée directement
  perIndirect: 3, // points par tâche impactée en cascade (au-delà des directes)
  criticalPath: 20,
  milestoneUnlock: 15,
  deadline: { overdue: 15, dueToday: 12, dueTomorrow: 9, within7: 5, beyond: 0 },
};

function calculateDominoScore(t, ctx, todayIdx, onCriticalPath, directList, indirectSet, milestoneUnlocked) {
  const directImpact = directList.length;
  const indirectImpact = Math.max(0, indirectSet.size - directImpact);
  const daysUntil = dayIndex(t.end) - todayIdx;
  let deadlinePressure = 0;
  if (daysUntil < 0) deadlinePressure = DOMINO_WEIGHTS.deadline.overdue;
  else if (daysUntil === 0) deadlinePressure = DOMINO_WEIGHTS.deadline.dueToday;
  else if (daysUntil === 1) deadlinePressure = DOMINO_WEIGHTS.deadline.dueTomorrow;
  else if (daysUntil <= 7) deadlinePressure = DOMINO_WEIGHTS.deadline.within7;
  const score = directImpact * DOMINO_WEIGHTS.perDirect
    + indirectImpact * DOMINO_WEIGHTS.perIndirect
    + (onCriticalPath ? DOMINO_WEIGHTS.criticalPath : 0)
    + (milestoneUnlocked ? DOMINO_WEIGHTS.milestoneUnlock : 0)
    + deadlinePressure;
  return {
    task: t, score, directImpact, indirectImpact, totalImpact: directImpact + indirectImpact,
    onCriticalPath, milestoneUnlocked, directTasks: directList, deadlinePressure,
  };
}

// Pipeline complet : ne retient que les tâches non terminées ayant un effet
// domino réel (au moins une tâche qui en dépend, directement ou en cascade).
function getDominoEffect({ tasks, ctx }) {
  const graph = buildDependencyGraph(tasks, ctx);
  const todayIdx = dayIndex(iso(new Date()));
  const nonMilestoneDated = graph.dated.filter((t) => !t.milestone);
  const criticalIds = computeCriticalIds(nonMilestoneDated);
  const results = [];
  graph.dated.forEach((t) => {
    if (t.milestone) return;
    if (isTaskDoneGlobal(t, ctx)) return;
    const direct = graph.directBlockedFor(t.id);
    const indirectSet = graph.blockedSetFor(t.id);
    if (direct.length === 0 && indirectSet.size === 0) return; // aucun effet domino
    const ms = graph.milestoneUnlockedBy(t.id);
    results.push(calculateDominoScore(t, ctx, todayIdx, criticalIds.has(t.id), direct, indirectSet, ms));
  });
  results.sort((a, b) => b.score - a.score || b.totalImpact - a.totalImpact || a.task.id.localeCompare(b.task.id));
  return results;
}

function getNextBestAction({ tasks, ctx }) {
  const { dated, byId, notDoneIds, blockedSetFor, milestoneUnlockedBy } = buildDependencyGraph(tasks, ctx);
  const todayIdx = dayIndex(iso(new Date()));
  const nonMilestoneDated = dated.filter((t) => !t.milestone);
  const criticalIds = computeCriticalIds(nonMilestoneDated);

  const candidates = [];
  const blocked = [];
  dated.forEach((t) => {
    if (t.milestone) return; // un jalon est un repère, pas une action à réaliser
    if (isTaskDoneGlobal(t, ctx)) return;
    const unmet = (t.dependsOn || []).filter((id) => notDoneIds.has(id));
    if (unmet.length > 0) {
      blocked.push({ task: t, waitingFor: unmet.map((id) => byId[id]).filter(Boolean) });
      return;
    }
    candidates.push(calculateNextBestActionScore(t, ctx, todayIdx, criticalIds, blockedSetFor(t.id), milestoneUnlockedBy(t.id)));
  });

  // Classement : score décroissant, puis nombre de tâches bloquées (départage),
  // puis échéance la plus proche, puis identifiant — déterministe de bout en bout.
  candidates.sort((a, b) => {
    if (b.totalScore !== a.totalScore) return b.totalScore - a.totalScore;
    if (b.blockedCount !== a.blockedCount) return b.blockedCount - a.blockedCount;
    const endDiff = (a.task.end || "").localeCompare(b.task.end || "");
    if (endDiff !== 0) return endDiff;
    return a.task.id.localeCompare(b.task.id);
  });

  return { candidates, blocked };
}

// ============================================================================
// Moteur "Daily Briefing" — synthèse du jour à partir des données réelles :
// échéances du jour, retards, projets à surveiller, tâches bloquées, la
// meilleure action à mener (réutilise le moteur Next Best Action, aucun
// second système de priorisation), et désormais les changements récents
// (grâce au journal d'activité réel — voir prevTasksForActivityRef dans
// LePlan). Avant sa mise en place, cette section était volontairement omise
// plutôt que d'inventer une activité fictive.
const DB_RISK_OVERDUE_THRESHOLD = 2; // nb de tâches en retard à partir duquel un projet est "à surveiller"

// #170 : ce que le Daily Briefing dit de demain côté effectifs — combien de
// personnes sur quel atelier, et qui d'entre elles a des tâches ouvertes qui
// vont manquer de bras. Repose entièrement sur `staffing` (le widget Charge
// personnel, #124) : sans affectation posée pour demain, ces deux lignes ne
// s'affichent simplement pas, plutôt que d'annoncer un silence comme un fait.
function dailyBriefingStaffingSignals({ staffing, ctx, tasks, tomorrowIso }) {
  const entries = normalizeStaffingEntries(staffing).filter((e) => e.date === tomorrowIso);
  if (!entries.length) return { workshopCounts: [], absentAssignees: [], tasksForAbsent: [] };
  const workshops = normalizeWorkshops(ctx.workshops);
  const workshopById = new Map(workshops.map((w) => [w.id, w]));
  const absenceId = staffingAbsenceWorkshopId(ctx.workshops);
  const membersByWorkshop = new Map();
  entries.forEach((e) => {
    e.workshops.forEach((wId) => {
      if (!membersByWorkshop.has(wId)) membersByWorkshop.set(wId, new Set());
      membersByWorkshop.get(wId).add(e.member);
    });
  });
  // Comptée par PERSONNE, pas par poste : une personne sur deux ateliers le
  // même jour ne doit pas compter double dans « N personnes en Chantier ».
  const workshopCounts = [...membersByWorkshop.entries()]
    .map(([id, members]) => ({ id, name: workshopById.get(id)?.name || "Atelier", count: members.size }))
    .sort((a, b) => b.count - a.count);
  const absentAssignees = [...(membersByWorkshop.get(absenceId) || [])];
  const tasksForAbsent = absentAssignees.length
    ? tasks.filter((t) => t.assignee && absentAssignees.includes(t.assignee) && !isTaskDoneGlobal(t, ctx))
    : [];
  return { workshopCounts, absentAssignees, tasksForAbsent };
}

function getDailyBriefing({ tasks, ctx, activityLog, staffing }) {
  const dated = tasks.filter((t) => t.start && t.end);
  const today = iso(new Date());
  const tomorrow = addDays(today, 1);
  const notDone = dated.filter((t) => !isTaskDoneGlobal(t, ctx));
  const staffingTomorrow = staffing ? dailyBriefingStaffingSignals({ staffing, ctx, tasks, tomorrowIso: tomorrow }) : null;

  const overdue = notDone.filter((t) => t.end < today);
  const dueToday = notDone.filter((t) => t.end === today);
  const dueTomorrow = notDone.filter((t) => t.end === tomorrow);
  // #136 : réunions passées depuis 48h (~2 jours, granularité jour comme le
  // reste de Nexora) sans compte rendu — signal explicite, jamais déduit
  // d'une réunion "probablement tenue" sur la seule date.
  const meetingsWithoutReport = dated.filter((t) => (
    isMeetingTask(t, ctx) && t.end >= addDays(today, -2) && t.end <= today && !String(t.meetingReport || "").trim()
  ));

  const { candidates, blocked } = getNextBestAction({ tasks, ctx });
  const nextBestAction = candidates[0] || null;

  // Projet "à surveiller" : au moins DB_RISK_OVERDUE_THRESHOLD tâches en retard.
  // Heuristique simple et déterministe — aucune donnée de "santé projet" n'existe
  // par ailleurs dans l'app pour affiner ce signal.
  const overdueByProject = {};
  overdue.forEach((t) => { overdueByProject[t.projectId] = (overdueByProject[t.projectId] || 0) + 1; });
  const atRiskProjects = ctx.projects.filter((p) => (overdueByProject[p.id] || 0) >= DB_RISK_OVERDUE_THRESHOLD);

  const todayItems = dueToday.slice().sort((a, b) => (a.milestone === b.milestone ? 0 : a.milestone ? -1 : 1));

  const alerts = [];
  if (dueToday.length > 0) alerts.push({ key: "dueToday", icon: "🔴", label: `${dueToday.length} échéance${dueToday.length > 1 ? "s" : ""} aujourd'hui`, tasks: dueToday });
  if (overdue.length > 0) alerts.push({ key: "overdue", icon: "🟠", label: `${overdue.length} tâche${overdue.length > 1 ? "s" : ""} en retard`, tasks: overdue });
  if (atRiskProjects.length > 0) alerts.push({ key: "atRisk", icon: "⚠️", label: `${atRiskProjects.length} projet${atRiskProjects.length > 1 ? "s" : ""} à surveiller`, projects: atRiskProjects });
  if (blocked.length > 0) alerts.push({ key: "blocked", icon: "🔒", label: `${blocked.length} tâche${blocked.length > 1 ? "s" : ""} bloquée${blocked.length > 1 ? "s" : ""}`, tasks: blocked.map((b) => b.task) });

  const totalSignals = dueToday.length + overdue.length + atRiskProjects.length + blocked.length;
  let priorityLevel;
  if (totalSignals === 0) priorityLevel = "none";
  else if (overdue.length >= 3 || atRiskProjects.length > 0) priorityLevel = "critical";
  else if (totalSignals >= 4) priorityLevel = "busy";
  else priorityLevel = "calm";

  // Changements récents (dernières 24h) : uniquement les catégories réellement
  // significatives (§9-10 : nouveauté + impact, jamais du bruit). Les créations
  // et suppressions ne sont volontairement pas remontées ici — trop fréquentes
  // pour être "intéressantes" au sens du briefing.
  const recentChanges = [];
  if (activityLog && activityLog.length > 0) {
    const cutoff = Date.now() - 24 * 3600 * 1000;
    const recent = activityLog.filter((e) => new Date(e.at).getTime() >= cutoff);
    const completed = recent.filter((e) => e.type === "completed");
    const reassigned = recent.filter((e) => e.type === "reassigned");
    const deadlineChanged = recent.filter((e) => e.type === "deadlineChanged");
    const reopened = recent.filter((e) => e.type === "reopened");
    if (completed.length > 0) recentChanges.push({ key: "completed", icon: "✓", text: `${completed.length} tâche${completed.length > 1 ? "s" : ""} terminée${completed.length > 1 ? "s" : ""}`, entries: completed });
    if (reassigned.length > 0) recentChanges.push({ key: "reassigned", icon: "→", text: `${reassigned.length} tâche${reassigned.length > 1 ? "s" : ""} réaffectée${reassigned.length > 1 ? "s" : ""}`, entries: reassigned });
    if (deadlineChanged.length > 0) recentChanges.push({ key: "deadlineChanged", icon: "⚠", text: `${deadlineChanged.length} échéance${deadlineChanged.length > 1 ? "s" : ""} modifiée${deadlineChanged.length > 1 ? "s" : ""}`, entries: deadlineChanged });
    if (reopened.length > 0) recentChanges.push({ key: "reopened", icon: "↺", text: `${reopened.length} tâche${reopened.length > 1 ? "s" : ""} rouverte${reopened.length > 1 ? "s" : ""}`, entries: reopened });
  }

  return { date: today, priorityLevel, alerts, todayItems, dueTomorrowCount: dueTomorrow.length, nextBestAction, atRiskProjects, recentChanges, staffingTomorrow, meetingsWithoutReport };
}

// Préréglages de filtre temporel, réutilisés PARTOUT (filtre général et
// filtres de widgets) — un seul calcul de plage, jamais dupliqué.
const DATE_FILTER_PRESETS = [
  { key: "today", label: "Aujourd'hui" },
  { key: "before_today", label: "Avant aujourd'hui" },
  { key: "after_today", label: "Après aujourd'hui" },
  { key: "this_week", label: "Cette semaine" },
  { key: "next_week", label: "Semaine prochaine" },
  { key: "this_month", label: "Ce mois-ci" },
  { key: "next_month", label: "Mois prochain" },
  { key: "this_year", label: "Cette année" },
];
function dateRangeForPreset(preset) {
  const today = iso(new Date());
  const now = new Date();
  const dow = now.getDay(); // 0 = dimanche
  const diffToMonday = dow === 0 ? -6 : 1 - dow;
  switch (preset) {
    case "today": return { from: today, to: today };
    case "before_today": return { from: null, to: addDays(today, -1) };
    case "after_today": return { from: addDays(today, 1), to: null };
    case "this_week": { const monday = addDays(today, diffToMonday); return { from: monday, to: addDays(monday, 6) }; }
    case "next_week": { const nextMonday = addDays(today, diffToMonday + 7); return { from: nextMonday, to: addDays(nextMonday, 6) }; }
    case "this_month": { const y = now.getFullYear(), m = now.getMonth(); return { from: iso(new Date(y, m, 1)), to: iso(new Date(y, m + 1, 0)) }; }
    case "next_month": { const y = now.getFullYear(), m = now.getMonth(); return { from: iso(new Date(y, m + 1, 1)), to: iso(new Date(y, m + 2, 0)) }; }
    case "this_year": { const y = now.getFullYear(); return { from: `${y}-01-01`, to: `${y}-12-31` }; }
    default: return { from: null, to: null };
  }
}
function matchesDatePreset(dateStr, preset) {
  if (!dateStr || !preset) return false;
  const { from, to } = dateRangeForPreset(preset);
  if (from && dateStr < from) return false;
  if (to && dateStr > to) return false;
  return true;
}

function matchSelectFilter(list, mode, value) {
  if (!list.length) return true;
  const inList = list.includes(value);
  return mode === "isnot" ? !inList : inList;
}
function taskAdvancedFieldValue(task, field) {
  if (field === "project") return task.projectId || NO_PROJECT_FILTER;
  if (field === "status") return task.statusId;
  if (field === "criticality") return task.criticality || "";
  if (field === "taskType") return task.taskTypeId;
  if (field === "assignee") return task.assignee || "";
  if (field === "milestone") return getTaskType(task) === "milestone" ? "yes" : "no";
  return "";
}
function evalFilterCondition(task, cond) {
  if ((cond.field === "start" || cond.field === "end") && cond.datePreset) {
    const matches = matchesDatePreset(task[cond.field], cond.datePreset);
    return cond.mode === "isnot" ? !matches : matches;
  }
  if (cond.field === "title") {
    const needle = (cond.textValue || "").trim().toLowerCase();
    if (!needle) return true; // rien saisi = condition neutre, ne filtre rien
    const contains = (task.title || "").toLowerCase().includes(needle);
    return cond.mode === "not_contains" ? !contains : contains;
  }
  if (cond.field === "inactivity") {
    const threshold = Number(cond.numberValue);
    if (cond.numberValue === "" || cond.numberValue == null || Number.isNaN(threshold)) return true;
    return taskInteractionAgeDays(task) > threshold;
  }
  if (cond.field === "project") {
    // Un seul moteur pour principal, secondaire et "Sans projet".
    const list = cond.values || [], mode = cond.mode || "is";
    if (!list.length) return true;
    const hasNoProject = !task.projectId && !task.secondaryProjectId;
    const inList =
      (hasNoProject && list.includes(NO_PROJECT_FILTER)) ||
      (!!task.projectId && list.includes(task.projectId)) ||
      (!!task.secondaryProjectId && list.includes(task.secondaryProjectId));
    return mode === "isnot" ? !inList : inList;
  }
  return matchSelectFilter(cond.values || [], cond.mode || "is", taskAdvancedFieldValue(task, cond.field));
}
function evalFilterGroup(task, group) {
  if (!group || !group.items || group.items.length === 0) return true;
  const results = group.items.map((item) => (item.items ? evalFilterGroup(task, item) : evalFilterCondition(task, item)));
  return group.op === "or" ? results.some(Boolean) : results.every(Boolean);
}
function countFilterGroup(group) {
  if (!group || !group.items) return 0;
  return group.items.reduce((n, item) => n + (item.items ? countFilterGroup(item) : 1), 0);
}
function taskSearchHaystack(task, ctx) {
  const proj = ctx.projects.find((p) => p.id === task.projectId);
  const st = ctx.statuses.find((s) => s.id === task.statusId);
  const tt = (ctx.taskTypes || []).find((s) => s.id === task.taskTypeId);
  const parts = [
    task.title,
    task.desc,
    task.assignee,
    proj?.name,
    st?.name,
    tt?.name,
    taskTypeLabel(task),
    getTaskType(task) === "milestone" ? "jalon" : "",
    fmtShort(task.start),
    fmtShort(task.end),
    String(task.progress),
    ...(task.checklist || []).map((i) => i.text),
  ];
  return parts.filter(Boolean).join(" \u241F ").toLowerCase();
}
// === NEXORA:BOARD-SEARCH:START ===
/* Filtre textuel des surfaces « tableau de bord » (issue #72).

   Les vues Tableau de bord, Aujourd'hui et Centre de pilotage partent du socle
   méta-filtré et n'appliquent PAS les filtres de vue — c'est voulu, et c'est
   pour cela que le champ de recherche de la barre du haut y était masqué : il
   n'aurait rien filtré du tout. Elles n'avaient donc aucun filtre textuel.

   Ce filtre-ci est délibérément plus étroit que `matchTaskFilters` : le nom et
   la description, rien d'autre. Chercher « Dupont » ne doit pas ramener toutes
   les tâches d'un projet dont Dupont est responsable — c'est ce que fait la
   recherche des autres vues, qui balaie tout le foin (`taskSearchHaystack`), et
   ce n'est pas ce qu'on demande ici. */

/* Insensible à la casse ET aux accents : « réserve » doit trouver « Reserve »,
   et réciproquement. La décomposition NFD sépare la lettre de son accent, que
   l'on retire ensuite. */
function normalizeSearchText(value) {
  return String(value == null ? "" : value)
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .toLowerCase();
}

/* Tous les mots doivent être présents, dans n'importe quel ordre : taper
   « plan mars » trouve « Plan de charge — mars », ce qu'une recherche de la
   chaîne entière manquerait. Une requête vide ne filtre rien — un filtre qui
   masquerait tout tant qu'on n'a pas fini de taper serait inutilisable. */
function taskMatchesTextQuery(task, query) {
  const mots = normalizeSearchText(query).split(/\s+/).filter(Boolean);
  if (!mots.length) return true;
  const foin = normalizeSearchText(`${task?.title || ""} \u241F ${task?.desc || ""}`);
  return mots.every((mot) => foin.includes(mot));
}

function filterTasksByText(tasks, query) {
  const list = Array.isArray(tasks) ? tasks : [];
  // Rendre LE MÊME tableau quand il n'y a rien à filtrer : les vues qui
  // dépendent de cette liste ne se recalculent pas pour rien.
  if (!normalizeSearchText(query).trim()) return list;
  return list.filter((t) => taskMatchesTextQuery(t, query));
}
// === NEXORA:BOARD-SEARCH:END ===

function matchTaskFilters(task, f, ctx) {
  if (f.search.trim()) {
    const q = f.search.trim().toLowerCase();
    if (!taskSearchHaystack(task, ctx).includes(q)) return false;
  }
  if (f.milestone === "yes" && getTaskType(task) !== "milestone") return false;
  if (f.milestone === "no" && getTaskType(task) === "milestone") return false;
  if (task.progress < f.progressMin || task.progress > f.progressMax) return false;
  if (f.startFrom && task.start < f.startFrom) return false;
  if (f.startTo && task.start > f.startTo) return false;
  if (f.endFrom && task.end < f.endFrom) return false;
  if (f.endTo && task.end > f.endTo) return false;
  if (f.lateOnly && !isTaskLate(task, ctx)) return false;
  {
    const inactivityThreshold = f.inactivityDays !== "" && f.inactivityDays != null
      ? Number(f.inactivityDays)
      : (f.inactivityMinDays !== "" && f.inactivityMinDays != null ? Number(f.inactivityMinDays) : null);
    if (inactivityThreshold != null && !Number.isNaN(inactivityThreshold) && taskInteractionAgeDays(task) <= inactivityThreshold) return false;
  }
  if (f.dueWithinDays !== "" && f.dueWithinDays != null) {
    const days = Number(f.dueWithinDays);
    if (!Number.isNaN(days)) {
      const todayIdx = dayIndex(iso(new Date()));
      const endIdx = dayIndex(task.end);
      if (endIdx < todayIdx || endIdx > todayIdx + days) return false;
    }
  }
  // Historique : X jours dans le passé.
  // Vide = aucune limite : tout l'historique reste visible.
  // Une valeur N masque seulement les éléments terminés avant aujourd'hui - N jours ;
  // les éléments d'aujourd'hui et futurs restent visibles.
  if (f.pastDays !== "" && f.pastDays != null) {
    const days = Number(f.pastDays);
    if (!Number.isNaN(days) && days >= 0 && task.end) {
      const todayIdx = dayIndex(iso(new Date()));
      const endIdx = dayIndex(task.end);
      if (endIdx < todayIdx - days) return false;
    }
  }
  if (f.quickDatePreset && !matchesDatePreset(task.end, f.quickDatePreset)) return false;
  if (f.showDone === false && isTaskDoneGlobal(task, ctx)) return false;
  if (f.urgentOnly && !isTaskUrgent(task, ctx)) return false;
  if (!evalFilterGroup(task, f.advanced)) return false;
  return true;
}
function activeFilterCount(f) {
  let n = 0;
  if (f.search.trim()) n++;
  if (f.milestone !== "all") n++;
  if (f.progressMin > 0 || f.progressMax < 100) n++;
  if (f.startFrom || f.startTo) n++;
  if (f.endFrom || f.endTo) n++;
  if (f.lateOnly) n++;
  if (f.dueWithinDays !== "" && f.dueWithinDays != null) n++;
  if (f.pastDays !== "" && f.pastDays != null) n++;
  if (
    (f.inactivityDays !== "" && f.inactivityDays != null) ||
    (f.inactivityMinDays !== "" && f.inactivityMinDays != null)
  ) n++;
  if (f.quickDatePreset) n++;
  if (f.showDone === false) n++;
  if (f.urgentOnly) n++;
  n += countFilterGroup(f.advanced);
  return n;
}

