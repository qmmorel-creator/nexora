body[data-life-app] :where(button, a, summary) { -webkit-tap-highlight-color: transparent; }
body[data-life-app] :where(button:disabled, input:disabled, select:disabled) { cursor: not-allowed; }

/* Budget360 — aliases retain the existing rendering and layout engine. */
body[data-life-app="budget"] {
  --paper: var(--life-bg); --surface: var(--life-surface); --ink: var(--life-text);
  --muted: var(--life-secondary); --line: var(--life-border); --blue: var(--life-blue);
  --shadow: var(--life-shadow);
  --b360-bg: var(--life-bg); --b360-surface: var(--life-surface); --b360-surface-soft: var(--life-soft);
  --b360-text: var(--life-text); --b360-muted: var(--life-secondary); --b360-border: var(--life-border);
