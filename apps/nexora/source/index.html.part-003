      if (hiddenDone) out.push({ key: "d:" + p.id, kind: "group", id: p.id, tier: 1, n: hiddenDone, pos: new THREE.Vector3(p.world.x + p.reach, planetY(p), p.world.z), prio: 2000, sides: ["right", "top", "bottom"], off: 10 });
