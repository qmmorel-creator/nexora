      const u = c.u || { urgent: 0, late: 0 };
      const chips = (u.urgent ? '<span class="lp-cosmos-chip is-urgent">' + plural(u.urgent, "urgente") + "</span>" : "") + (u.late ? '<span class="lp-cosmos-chip is-late">' + u.late + " en retard</span>" : "");
      return '<b><i style="background:' + esc(p.color) + '"></i>' + esc(p.name) + "</b><em>" + (p.taskIds.length ? plural(p.taskIds.length, "tâche") + " · " + p.stats.pct + " %" : "Aucune tâche") + (p.amasName && c.id !== S.planetId ? " · " + esc(p.amasName) : "") + "</em>" + (chips ? '<span class="lp-cosmos-chips">' + chips + "</span>" : "");
    }
    if (c.kind === "amas") return esc(c.name) + " <small>· amas</small>";
    if (c.kind === "group") return '<i style="background:#22B07D"></i>' + plural(c.n, "terminée") + " · regroupées";
