  function boxAlong(a, b, w, h, y, m, cast) {
    const dx = b.x - a.x, dz = b.z - a.z, len = Math.hypot(dx, dz);
    if (len < 1e-4) return null;
    const mesh = new THREE.Mesh(own(new THREE.BoxGeometry(len, h, w)), m);
    mesh.position.set((a.x + b.x) / 2, y, (a.z + b.z) / 2); mesh.rotation.y = -Math.atan2(dz, dx);
    mesh.receiveShadow = true; if (cast && S.quality === "high") mesh.castShadow = true;
    S.scene.add(mesh); return mesh;
  }
  function tube(points, r, m) {
    const pts = points.filter((p, i) => i === 0 || p.distanceTo(points[i - 1]) > 1e-4);
    if (pts.length < 2) return null;
    const path = new THREE.CurvePath();
    for (let i = 1; i < pts.length; i++) path.add(new THREE.LineCurve3(pts[i - 1], pts[i]));
    const mesh = new THREE.Mesh(own(new THREE.TubeGeometry(path, Math.max(4, pts.length * 3), r, 10, false)), m);
    S.scene.add(mesh); return mesh;
  }
  const rng = (seed) => () => { seed = seed + 0x6D2B79F5 | 0; let t = Math.imul(seed ^ seed >>> 15, 1 | seed); t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t; return ((t ^ t >>> 14) >>> 0) / 4294967296; };
  const hashStr = (str) => { let h = 2166136261; for (let i = 0; i < str.length; i++) { h ^= str.charCodeAt(i); h = Math.imul(h, 16777619); } return h >>> 0; };
  const dateOf = (d) => { const x = new Date(); x.setHours(0, 0, 0, 0); x.setDate(x.getDate() + d); return x; };
  const fmtShort = (d) => dateOf(d).toLocaleDateString("fr-FR", { day: "numeric", month: "short" });

  // ---------- Placement ----------
  // #461 : la voie d'une bifurcation est posée à 2,2 unités de l'axe de sa
  // ligne (1,05 auparavant, la largeur du ballast : les deux voies se
  // touchaient). Les lignes s'écartent d'autant pour que les bifurcations de
  // deux lignes voisines, et leurs gares, ne se chevauchent pas.
  const T3D_RAIL_BRANCH_LAT = 2.2, T3D_RAIL_LANE = 6.6;
  const lineOf = (id) => S.model.lineById[id];
  function pos(l, d, lat) {
    if (S.mode === "cabine") {
      const a = S.ang[l.id], r = S.R + (lat || 0) * 1.2;
      return V(Math.cos(a) * r, Math.sin(a) * r, -d * S.s);
    }
    return V(d * S.s, 0.25, S.lane[l.id] + (lat || 0) * T3D_RAIL_BRANCH_LAT);
  }
  function layout() {
    const M = S.model;
    S.r0 = M.range.min - 3; S.r1 = M.range.max + 6;
    if (S.mode === "rail") {
      S.s = 0.45; S.lane = {};
      let z = 0, prev = null;
      M.lines.forEach((l) => { if (prev !== null && prev !== l.folderId) z += 3.6; S.lane[l.id] = z; z += T3D_RAIL_LANE; prev = l.folderId; });
      const mid = (z - T3D_RAIL_LANE) / 2; Object.keys(S.lane).forEach((k) => { S.lane[k] -= mid; });
    } else {
      S.s = 0.55; S.ang = {};
      const n = M.lines.length, gap = 0.9, units = n + M.groups.length * gap, step = TAU / Math.max(1, units);
      S.R = Math.max(5, n * 0.62);
      let a = PI / 2 + 0.25 + step * gap / 2, prev = null;
      M.lines.forEach((l) => { if (prev !== null && prev !== l.folderId) a += step * gap; S.ang[l.id] = a + step / 2; a += step; prev = l.folderId; });
    }
  }

  // ---------- Libellés HTML ----------
  function addLabel(cls, build, p, extra) {
    const el = document.createElement("div");
    el.className = "lp-t3d-lbl " + cls;
    build(el);
    labelsEl.appendChild(el);
    const L = Object.assign({ el, pos: p, prio: 0, w: 0, h: 0, anchor: "above", shown: false }, extra || {});
    S.labels.push(L); return L;
  }
  const text = (tag, t, cls) => { const e = document.createElement(tag); e.textContent = t; if (cls) e.className = cls; return e; };
  const badge = (l) => { const b = text("span", String(l.n), "lp-t3d-badge"); b.style.setProperty("--c", l.color); return b; };

  // ---------- Grande Ligne ----------
  function railTrack(pts, past, color) {
    for (let i = 1; i < pts.length; i++) {
      const a = pts[i - 1], b = pts[i];
      const dx = b.x - a.x, dz = b.z - a.z, len = Math.hypot(dx, dz); if (len < 1e-4) continue;
      const ux = dx / len, uz = dz / len, nx = -uz, nz = ux;
      const A = V(a.x - ux * 0.1, 0, a.z - uz * 0.1), B = V(b.x + ux * 0.1, 0, b.z + uz * 0.1);
      const off = (q, k) => V(q.x + nx * k, 0, q.z + nz * k);
      boxAlong(A, B, 1.0, 0.14, 0.07, std(past ? "#b9a988" : "#a29d93"));
      boxAlong(off(A, 0.53), off(B, 0.53), 0.07, 0.05, 0.1, past ? std("#8f969e") : std(color, { roughness: 0.45, metalness: 0.1 }));
      const railM = past ? std("#8a5a3c", { roughness: 0.75, metalness: 0.2 }) : std("#98a2ad", { roughness: 0.3, metalness: 0.65 });
      boxAlong(off(A, -0.2), off(B, -0.2), 0.05, 0.06, 0.22, railM, true);
      boxAlong(off(A, 0.2), off(B, 0.2), 0.05, 0.06, 0.22, railM, true);
      const n = Math.max(1, Math.floor(len / 0.34)), ang = -Math.atan2(dz, dx);
      for (let k = 0; k < n; k++) { const t = (k + 0.5) / n; S.sleepers.push([a.x + dx * t, a.z + dz * t, ang, past]); }
    }
  }
  function flushSleepers() {
    const g = own(new THREE.BoxGeometry(0.12, 0.05, 0.78));
    [false, true].forEach((past) => {
      const list = S.sleepers.filter((q) => q[3] === past); if (!list.length) return;
      const im = new THREE.InstancedMesh(g, std(past ? "#6e5a47" : "#5a4535"), list.length);
      const ob = new THREE.Object3D();
      list.forEach((q, i) => { ob.position.set(q[0], 0.165, q[1]); ob.rotation.set(0, q[2], 0); ob.updateMatrix(); im.setMatrixAt(i, ob.matrix); });
      im.receiveShadow = true; S.scene.add(im);
    });
    S.sleepers = [];
  }
  function prism(r, len, m) {
    const g = own(new THREE.CylinderGeometry(r, r, len, 3)); g.rotateZ(PI / 2); g.rotateX(-PI / 2);
    const mesh = new THREE.Mesh(g, m); if (S.quality === "high") mesh.castShadow = true; return mesh;
  }
  function railStation(x) {
    const l = lineOf(x.lineId), st = x.late ? "late" : x.st;
    const out = x.branch ? x.side : 1;
    const base = pos(l, x.e, x.branch ? x.side : 0);
    const g = new THREE.Group(); g.position.set(base.x, 0, base.z); S.scene.add(g);
    const done = st === "done", big = x.type === "m", halt = x.type === "r";
    const roofM = done ? std("#8f969e") : std(l.color, { roughness: 0.45, metalness: 0.1 });
    const wall = std(done ? "#cfc8bc" : "#f1e7d5");
    const qLen = big ? 2.0 : 1.25;
    box(qLen, 0.3, 0.52, std("#d8d2c6"), 0, 0.15, out * 0.8, g);
    box(qLen, 0.02, 0.07, std("#fbfaf6"), 0, 0.31, out * 0.57, g, false);
    const R = S.st[x.id];
    R.out = out; R.pax = []; R.boarded = false;
    if (!done && !x.info && x.e >= 0 && x.e <= 60 && S.quality === "high") {
      const r = rng(hashStr(String(x.id))), n = 2 + Math.floor(r() * 3);
      const cols = ["#e64a3c", "#2f7de1", "#f2b705", "#35a86b", "#8e5bd6", "#ef7fb0", "#3b3f46"];
      for (let k = 0; k < n; k++) {
        const f = new THREE.Group();
        const body = new THREE.Mesh(geo("pax-b", () => new THREE.CylinderGeometry(0.042, 0.055, 0.17, 8)), std(cols[Math.floor(r() * cols.length)]));
        body.position.y = 0.085; f.add(body);
        const head = new THREE.Mesh(geo("pax-h", () => new THREE.SphereGeometry(0.04, 10, 8)), std("#f1c9a5")); head.position.y = 0.21; f.add(head);
        f.position.set(-qLen / 2 + 0.2 + r() * (qLen - 0.4), 0.3, out * (0.78 + (r() - 0.5) * 0.24));
        f.rotation.y = r() * TAU; g.add(f);
        R.pax.push({ f, home: f.position.clone() });
      }
    }
    if (halt) {
      box(0.8, 0.05, 0.38, roofM, 0, 0.84, out * 0.86, g);
      [-0.32, 0.32].forEach((px) => box(0.04, 0.52, 0.04, std("#46505b", { roughness: 0.5, metalness: 0.4 }), px, 0.57, out * 0.95, g));
      box(0.5, 0.12, 0.04, std("#7b4e2d", { roughness: 0.7 }), 0, 0.45, out * 1.0, g);
    } else {
      const bw = big ? 1.55 : 0.8, bh = big ? 0.72 : 0.48, bd = 0.52, bz = out * 1.34;
      box(bw, bh, bd, wall, 0, 0.3 + bh / 2, bz, g);
      const r = bd * 0.64, roof = prism(r, bw + 0.14, roofM);
      roof.position.set(0, 0.3 + bh + r / 2 - 0.02, bz); g.add(roof);
      const winM = st === "doing" || st === "late" ? std("#ffd98a", { emissive: col("#ffb13d"), emissiveIntensity: 0.85 }) : done ? std("#8f969e") : std("#34475c", { roughness: 0.25 });
      box(bw * 0.72, bh * 0.34, 0.03, winM, 0, 0.3 + bh * 0.52, bz - out * (bd / 2 + 0.01), g, false);
      if (big) {
        const tx = -bw / 2 + 0.2;
        box(0.36, 1.45, 0.36, wall, tx, 0.3 + 0.725, bz, g);
        const cap = new THREE.Mesh(geo("cap", () => new THREE.ConeGeometry(0.3, 0.4, 4)), roofM); cap.rotation.y = PI / 4;
        cap.position.set(tx, 0.3 + 1.45 + 0.2, bz); g.add(cap);
        const clock = new THREE.Mesh(geo("clock", () => new THREE.CylinderGeometry(0.13, 0.13, 0.03, 24)), std("#f4f6f9"));
        clock.rotation.x = PI / 2; clock.position.set(tx, 0.3 + 1.2, bz - out * 0.19); g.add(clock);
        const pv = new THREE.Group(); pv.position.set(tx, 0.3 + 1.2, bz - out * 0.215); g.add(pv);
        const hg = new THREE.Group(), mg = new THREE.Group(); pv.add(hg, mg);
        box(0.025, 0.075, 0.012, std("#262b31"), 0, 0.035, 0, hg, false);
        box(0.016, 0.11, 0.012, std("#c8322f"), 0, 0.05, -out * 0.004, mg, false);
        S.hands.push({ hg, mg, sgn: out });
      }
    }
    // Signal : sa couleur porte le statut.
    const sx = -qLen / 2 - 0.2, sz = out * 0.5;
    box(0.05, 1.1, 0.05, std("#46505b", { roughness: 0.5, metalness: 0.4 }), sx, 0.55, sz, g);
    box(0.13, 0.3, 0.1, std("#262b31"), sx, 1.18, sz, g);
    const lamp = new THREE.Group(); lamp.position.set(sx - 0.07, 1.22, sz); g.add(lamp);
    lamp.add(new THREE.Mesh(geo("lamp", () => new THREE.SphereGeometry(0.05, 12, 8)), basic(SIG[st])));
    if (!done) lamp.add(glow(SIG[st], 0.9, 0.95, true));
    if (st === "doing") S.anims.push({ o: lamp, kind: "blink", f: 2.2 });
    if (st === "late") S.anims.push({ o: lamp, kind: "blink", f: 6 });
    if (x.branch) box(0.26, 0.3, 0.6, std("#c8322f"), pos(l, x.e + 1.8, x.side).x - base.x, 0.3, 0, g);
    const hit = new THREE.Mesh(geo("hit-r", () => new THREE.SphereGeometry(1.0, 8, 6)), basic("#000", { colorWrite: false, depthWrite: false }));
    hit.position.set(0, 0.6, out * 1.0); hit.userData.id = x.id; g.add(hit); S.hits.push(hit);
    R.obj = g; R.p = V(base.x, 0.31, base.z + out * 0.8);
    R.labelY = big ? 2.05 : halt ? 1.0 : 1.35;
  }
  function railTrain(l) {
    if (l.end < 0) return;
    const g = new THREE.Group(), wheels = [];
    const body = std(l.color, { roughness: 0.45, metalness: 0.1 }), coachM = std(mix(l.color, "#ffffff", 0.32).getStyle(), { roughness: 0.45 });
    const brass = std("#c9a13b", { roughness: 0.3, metalness: 0.6 }), rod = std("#d6d9de", { roughness: 0.3, metalness: 0.7 }), dark = std("#262b31"), win = std("#34475c", { roughness: 0.25 });
    const wheel = (px, z, r) => {
      const w = new THREE.Group(); w.position.set(px, RT + r, z);
      const c = new THREE.Mesh(geo("wh" + r, () => new THREE.CylinderGeometry(r, r, 0.045, 16)), dark); c.rotation.z = PI / 2; w.add(c);
      const sp = new THREE.Mesh(geo("sp" + r, () => new THREE.BoxGeometry(0.05, r * 1.7, 0.035)), rod); sp.position.x = px > 0 ? 0.026 : -0.026; w.add(sp);
      g.add(w); wheels.push({ w, r });
    };
    box(0.34, 0.08, 1.22, dark, 0, RT + 0.2, 0.02, g);
    const boiler = new THREE.Mesh(geo("boiler", () => new THREE.CylinderGeometry(0.17, 0.17, 0.8, 20)), body);
    boiler.rotation.x = PI / 2; boiler.position.set(0, RT + 0.41, 0.2); if (S.quality === "high") boiler.castShadow = true; g.add(boiler);
    [0.02, 0.3].forEach((z) => { const b = new THREE.Mesh(geo("band", () => new THREE.CylinderGeometry(0.176, 0.176, 0.03, 20)), brass); b.rotation.x = PI / 2; b.position.set(0, RT + 0.41, z); g.add(b); });
    const smoke = new THREE.Mesh(geo("smokebox", () => new THREE.CylinderGeometry(0.178, 0.178, 0.12, 20)), dark);
    smoke.rotation.x = PI / 2; smoke.position.set(0, RT + 0.41, 0.63); g.add(smoke);
    const chim = new THREE.Mesh(geo("chim", () => new THREE.CylinderGeometry(0.06, 0.045, 0.22, 12)), dark);
    chim.position.set(0, RT + 0.67, 0.5); g.add(chim);
    const top = new THREE.Object3D(); top.position.set(0, 0.14, 0); chim.add(top);
    const dome = new THREE.Mesh(geo("dome", () => new THREE.SphereGeometry(0.075, 14, 10)), brass); dome.position.set(0, RT + 0.58, 0.16); g.add(dome);
    box(0.4, 0.44, 0.4, body, 0, RT + 0.44, -0.37, g);
    box(0.47, 0.045, 0.5, dark, 0, RT + 0.685, -0.37, g);
    box(0.41, 0.13, 0.22, win, 0, RT + 0.53, -0.32, g, false);
    box(0.38, 0.07, 0.04, std("#c8322f"), 0, RT + 0.2, 0.65, g);
    const lampG = glow("#fff1c4", 0.7, 0.75, true); lampG.position.set(0, RT + 0.43, 0.72); g.add(lampG);
    [0.44, 0.16].forEach((z) => [-0.19, 0.19].forEach((px) => wheel(px, z, 0.1)));
    [-0.19, 0.19].forEach((px) => wheel(px, -0.3, 0.14));
    [-1.18, -2.3].forEach((zc) => {
      box(0.4, 0.36, 1.0, coachM, 0, RT + 0.4, zc, g);
      box(0.36, 0.06, 1.02, std("#f4f6f9"), 0, RT + 0.61, zc, g);
      box(0.41, 0.1, 0.82, win, 0, RT + 0.47, zc, g, false);
      box(0.3, 0.06, 0.9, dark, 0, RT + 0.19, zc, g);
      [zc + 0.33, zc - 0.33].forEach((z) => [-0.19, 0.19].forEach((px) => wheel(px, z, 0.08)));
    });
    g.rotation.y = PI / 2;
    const tr = { g, l, lz: S.lane[l.id], vel: 0, wheels, top, nextPuff: Math.random() * 1.5, arrived: null,
      max: (l.end + 1.3) * S.s - 0.2, min: (l.start - 0.6) * S.s + 3.1 };
    tr.rest = Math.min(tr.max, Math.max(REST, tr.min));
    tr.front = tr.target = tr.rest;
    placeTrain(tr); S.scene.add(g); S.trains.push(tr);
  }
  const placeTrain = (tr) => { tr.g.position.set(tr.front - 0.65, 0, tr.lz); };
  const trainStop = (tr, xx) => Math.max(Math.min(xx, tr.max), Math.min(tr.rest, tr.min));
  const playFront = (sim) => sim * S.s + REST + 1.45 * Math.min(1, Math.max(0, sim));
  const trainDay = (tr) => (tr.front - REST - 1.45) / S.s;
  function railLink(a, b) {
    const h = 1.55, wm = std("#f4f6f9"), gm = std("#9aa3ad", { roughness: 0.5, metalness: 0.3 });
    const A = a.clone().add(V(0.5, 0, 0)), B = b.clone().add(V(0.5, 0, 0));
    [A, B].forEach((q) => { box(0.3, h, 0.3, wm, q.x, 0.3 + h / 2, q.z); box(0.36, 0.06, 0.36, std("#46505b"), q.x, 0.3 + h + 0.03, q.z); });
    boxAlong(A, B, 0.34, 0.12, 0.3 + h + 0.1, wm, true);
    boxAlong(V(A.x - 0.17, 0, A.z), V(B.x - 0.17, 0, B.z), 0.03, 0.22, 0.3 + h + 0.27, gm, false);
    boxAlong(V(A.x + 0.17, 0, A.z), V(B.x + 0.17, 0, B.z), 0.03, 0.22, 0.3 + h + 0.27, gm, false);
  }
  function decorRail() {
    const M = S.model, s = S.s, x0 = S.r0 * s - 4, x1 = S.r1 * s + 5;
    const zs = M.lines.map((l) => S.lane[l.id]);
    const z0 = Math.min.apply(null, zs) - 4.2, z1 = Math.max.apply(null, zs) + 4.2;
    const cx = (x0 + x1) / 2, cz = (z0 + z1) / 2, W = x1 - x0, Dp = z1 - z0;
    S.bounds = { x0, x1, z0, z1 };
    const sc = S.scene;
    sc.background = col("#cfe2ee");
    sc.fog = new THREE.Fog("#cfe2ee", 90, 220);
    sc.add(new THREE.HemisphereLight(0xeaf2ff, 0x5a6a3c, 0.62 * LI));
    const sun = new THREE.DirectionalLight(0xfff0d8, 0.9 * LI); sun.position.set(cx - 25, 50, cz + 32);
    if (S.quality === "high") {
      sun.castShadow = true; sun.shadow.mapSize.set(2048, 2048); sun.shadow.bias = -0.0004;
      Object.assign(sun.shadow.camera, { left: -W / 2 - 6, right: W / 2 + 6, top: Dp / 2 + 10, bottom: -Dp / 2 - 10, near: 1, far: 200 });
    }
    sun.target.position.set(cx, 0, cz); sc.add(sun, sun.target);
    box(W + 1.4, 1.3, Dp + 1.4, std("#7b4e2d", { roughness: 0.7 }), cx, -0.66, cz, null, false);
    box(W, 0.1, Dp, std("#7ea45a", { roughness: 1 }), cx, -0.05, cz, null, false);
    const past = new THREE.Mesh(own(new THREE.PlaneGeometry(Math.max(0.1, -x0), Dp)), basic("#e0c486", { transparent: true, opacity: 0.22, depthWrite: false }));
    past.rotation.x = -PI / 2; past.position.set(x0 / 2, 0.004, cz); sc.add(past);
    // Passage à niveau d'aujourd'hui
    box(1.3, 0.05, Dp, std("#474b52"), 0, 0.025, cz, null, false);
    for (let z = z0 + 0.4; z < z1 - 0.4; z += 1.3) box(0.07, 0.01, 0.6, std("#f4f6f9"), 0, 0.056, z, null, false);
    S.zones = zs.map((lz) => [lz - 0.8, lz + 0.8]);
    const redLamp = () => { const q = new THREE.Group(); q.add(new THREE.Mesh(geo("rl", () => new THREE.SphereGeometry(0.045, 10, 8)), basic("#ff2a1f"))); q.add(glow("#ff3b30", 0.7, 0.9, true)); q.visible = false; return q; };
    [z0 + 0.75, z1 - 0.75].forEach((z, i) => {
      const x = i ? 0.85 : -0.85, dir = i ? -1 : 1;
      box(0.08, 0.9, 0.08, std("#f4f6f9"), x, 0.45, z);
      box(0.16, 0.16, 0.16, std("#262b31"), x, 0.84, z);
      const pivot = new THREE.Group(); pivot.position.set(x, 0.84, z); sc.add(pivot);
      for (let k = 0; k < 6; k++) box(0.05, 0.05, 0.22, std(k % 2 ? "#f4f6f9" : "#c8322f"), 0, 0, dir * (0.12 + k * 0.22), pivot);
      S.barriers.push({ pivot, up: -dir * PI / 2 * 0.94 });
    });
    zs.forEach((lz) => [[0.85, lz - 0.95], [-0.85, lz + 0.95]].forEach(([x, z]) => {
      box(0.05, 0.62, 0.05, std("#f4f6f9"), x, 0.31, z, null, false);
      box(0.26, 0.08, 0.06, std("#262b31"), x, 0.62, z, null, false);
      const a = redLamp(), b = redLamp(); a.position.set(x, 0.62, z - 0.1); b.position.set(x, 0.62, z + 0.1); sc.add(a, b);
      S.xlights.push([a, b]);
    }));
    [z0 + 0.25, z1 - 0.25].forEach((z) => {
      const stone = std("#b8ad9c");
      box(0.35, 0.7, 0.5, stone, -0.82, 0.35, z); box(0.35, 0.7, 0.5, stone, 0.82, 0.35, z); box(2.0, 0.3, 0.5, stone, 0, 0.82, z);
      box(1.3, 0.62, 0.46, std("#262b31"), 0, 0.31, z, null, false);
    });
    const carCols = ["#e64a3c", "#2f7de1", "#f2b705", "#ffffff", "#35a86b", "#8e5bd6"];
    const nCars = Math.min(9, 3 + Math.round(Dp / 10));
    for (let k = 0; k < nCars; k++) {
      const dir = k % 2 ? -1 : 1, g = new THREE.Group();
      box(0.3, 0.14, 0.52, std(carCols[k % carCols.length], { roughness: 0.35, metalness: 0.2 }), 0, 0.14, 0, g);
      box(0.26, 0.12, 0.28, std("#34475c", { roughness: 0.25 }), 0, 0.26, -0.02, g);
      g.position.set(dir > 0 ? -0.3 : 0.3, 0, 0); if (dir < 0) g.rotation.y = PI; sc.add(g);
      const zmin = z0 + 0.2, zmax = z1 - 0.2, z = zmin + ((k * 0.37) % 1) * (zmax - zmin);
      S.cars.push({ g, dir, z, v: 0, speed: 1.0 + (k % 3) * 0.25, zmin, zmax });
    }
    addLabel("lp-t3d-lbl--today", (el) => { el.textContent = "Passage à niveau · aujourd'hui " + fmtShort(0); }, V(0, 1.2, z1 - 0.7), { prio: 120 });
    // Portiques mensuels, bornes hebdomadaires
    const gm = std("#9aa3ad", { roughness: 0.5, metalness: 0.3 });
    for (let d = Math.ceil(S.r0); d <= S.r1; d++) {
      const dt = dateOf(d); const month = dt.getDate() === 1, week = dt.getDay() === 1;
      if (month) {
        const x = d * s;
        box(0.08, 2.4, 0.08, gm, x, 1.2, z0 + 0.9); box(0.08, 2.4, 0.08, gm, x, 1.2, z1 - 0.9);
        box(0.06, 0.06, Dp - 1.8, gm, x, 2.4, cz, null, false); box(0.05, 0.05, Dp - 1.8, gm, x, 2.2, cz, null, false);
        addLabel("lp-t3d-lbl--time", (el) => { el.textContent = dt.toLocaleDateString("fr-FR", { month: "long", year: dt.getFullYear() !== new Date().getFullYear() ? "numeric" : undefined }); }, V(x, 2.55, z1 - 0.9), { prio: 45, d });
      } else if (week) box(0.09, 0.32, 0.09, std("#f4f6f9"), d * s, 0.16, z1 - 0.45);
    }
    // Champs entre les groupes, bosquets hors des emprises de voies
    const Rf = rng(99), crops = ["#e2cd7e", "#c9dd8a", "#b9a7da", "#9cc26d", "#e8b96a"];
    const fields = [];
    const sorted = zs.slice().sort((a, b) => a - b);
    for (let k = 1; k < sorted.length; k++) {
      const gap = sorted[k] - sorted[k - 1]; if (gap < 6) continue;
      const zc = (sorted[k] + sorted[k - 1]) / 2, zw = gap - 5.6;
      for (let x = x0 + 1; x < x1 - 2;) {
        const w = 3 + Rf() * 5;
        if (Rf() < 0.6 && (x > 1.6 || x + w < -1.6)) {
          const f = new THREE.Mesh(own(new THREE.PlaneGeometry(w, zw)), std(crops[Math.floor(Rf() * crops.length)], { roughness: 1 }));
          f.rotation.x = -PI / 2; f.position.set(x + w / 2, 0.006, zc); f.receiveShadow = true; sc.add(f);
          fields.push([x, x + w, zc - zw / 2, zc + zw / 2]);
        }
        x += w + 0.4;
      }
    }
    const R = rng(20260925), pts = [];
    const maxTrees = S.quality === "high" ? Math.min(700, Math.round(W * Dp / 9)) : 120;
    for (let i = 0; i < maxTrees * 5 && pts.length < maxTrees; i++) {
      const x = x0 + 0.5 + R() * (W - 1), z = z0 + 0.4 + R() * (Dp - 0.8);
      if (Math.abs(x) < 1.4) continue;
      if (zs.some((lz) => Math.abs(z - lz) < 2.7)) continue;
      if (fields.some(([a, b, c, d]) => x > a - 0.3 && x < b + 0.3 && z > c - 0.3 && z < d + 0.3)) continue;
      pts.push([x, z, 0.7 + R() * 0.8, R()]);
    }
    if (pts.length) {
      const trunkM = new THREE.InstancedMesh(own(new THREE.CylinderGeometry(0.04, 0.06, 0.36, 6)), std("#6b4a2f"), pts.length);
      const crownM = new THREE.InstancedMesh(own(new THREE.IcosahedronGeometry(0.34, 0)), std("#ffffff", { roughness: 0.9, flatShading: true }), pts.length);
      const greens = ["#4d7b36", "#5f9043", "#3e6a31", "#6f9c49", "#58833d"].map(col);
      const ob = new THREE.Object3D();
      pts.forEach(([x, z, sc2, r], i) => {
        ob.position.set(x, 0.18 * sc2, z); ob.rotation.set(0, 0, 0); ob.scale.set(sc2, sc2, sc2); ob.updateMatrix(); trunkM.setMatrixAt(i, ob.matrix);
        ob.position.set(x, 0.62 * sc2, z); ob.rotation.set(0, r * 6, 0); ob.scale.set(sc2, sc2 * (r > 0.7 ? 1.7 : 1.05), sc2); ob.updateMatrix(); crownM.setMatrixAt(i, ob.matrix);
        crownM.setColorAt(i, greens[Math.floor(r * greens.length) % greens.length]);
      });
      if (S.quality === "high") trunkM.castShadow = crownM.castShadow = true;
      sc.add(trunkM, crownM);
    }
    // Nuages derrière la table
    const cloudM = std("#ffffff", { roughness: 1, flatShading: true, emissive: col("#dde8f2"), emissiveIntensity: 0.4 });
    const Rc = rng(4242);
    for (let k = 0; k < 9; k++) {
      const g = new THREE.Group();
      for (let q = 0; q < 4; q++) { const m = new THREE.Mesh(geo("cloud" + q, () => new THREE.IcosahedronGeometry(0.9 + q * 0.25, 1)), cloudM); m.position.set(q * 1.1 - 1.6, Rc() * 0.5, Rc() * 0.8); m.scale.y = 0.6; g.add(m); }
      g.position.set(x0 - 10 + Rc() * (W + 20), 5 + Rc() * 4, z0 - 7 - Rc() * 12); sc.add(g);
      S.clouds.push({ g, v: 0.25 + Rc() * 0.3, xmin: x0 - 14, xmax: x1 + 14 });
    }
    M.groups.forEach((gr) => {
      const zz = gr.lineIds.map((id) => S.lane[id]);
      addLabel("lp-t3d-lbl--folder", (el) => { el.textContent = gr.name; }, V(x0 + 0.6, 0.02, (Math.min.apply(null, zz) + Math.max.apply(null, zz)) / 2), { prio: 30, anchor: "right" });
    });
    M.lines.forEach((l) => {
      addLabel("lp-t3d-lbl--badge", (el) => { el.appendChild(badge(l)); el.appendChild(text("span", l.name)); }, pos(l, l.start, 0), { prio: 90, anchor: "left" });
      addLabel("lp-t3d-lbl--badge", (el) => { el.appendChild(badge(l)); el.appendChild(text("span", "Terminus")); }, pos(l, l.end + 1.4, 0), { prio: 70, anchor: "right" });
    });
  }
  function buildRail() {
    const M = S.model;
    S.sleepers = [];
    M.lines.forEach((l) => {
      if (l.start < 0) railTrack([pos(l, l.start - 0.6, 0), pos(l, Math.min(0, l.end), 0)], true, l.color);
      if (l.end > 0) railTrack([pos(l, Math.max(0, l.start), 0), pos(l, l.end + 1.3, 0)], false, l.color);
      const e = pos(l, l.end + 1.3, 0); box(0.26, 0.32, 0.62, std("#c8322f"), e.x, 0.32, e.z);
      l.stations.forEach((id) => {
        const x = M.stationById[id]; if (!x.branch) return;
        const k = Math.min(T3D_RAIL_BRANCH_LAT / (S.s * 0.5), (x.e - x.s) / 2);
        railTrack([pos(l, x.s, 0), pos(l, x.s + k, x.side), pos(l, x.e + 1.7, x.side)], x.st === "done", l.color);
      });
      railTrain(l);
    });
    flushSleepers();
    M.stations.forEach(railStation);
    M.links.forEach(([a, b]) => { if (S.st[a].p && S.st[b].p) railLink(S.st[a].p, S.st[b].p); });
  }

  // ---------- Cabine ----------
  function lineMat(c, dim) {
    return std(dim ? mix(c, "#d3dae3", 0.65).getStyle() : c, { roughness: 0.45, emissive: dim ? col("#000") : col(c).multiplyScalar(0.18) });
  }
  function decorCabine() {
    const s = S.s, sc = S.scene, M = S.model;
    const bg = document.createElement("canvas"); bg.width = 2; bg.height = 256;
    const bctx = bg.getContext("2d"); const lg = bctx.createLinearGradient(0, 0, 0, 256);
    [[0, "#c3d8f0"], [0.5, "#e8f0f9"], [1, "#fbfcfe"]].forEach(([k, v]) => lg.addColorStop(k, v)); bctx.fillStyle = lg; bctx.fillRect(0, 0, 2, 256);
    const bgTex = own(new THREE.CanvasTexture(bg)); bgTex.colorSpace = THREE.SRGBColorSpace; sc.background = bgTex;
    sc.fog = new THREE.FogExp2("#edf3f9", 0.024);
    sc.add(new THREE.HemisphereLight(0xffffff, 0xd3dce7, 1.05 * LI));
    const sun = new THREE.DirectionalLight(0xffffff, 0.55 * LI); sun.position.set(6, 12, 6); sc.add(sun);
    const gateR = S.R + 3.2;
    const ringM = std("#98aecb", { roughness: 0.6 }), weekM = std("#d4deea", { roughness: 0.8 });
    const len = (S.r1 - S.r0) * s + 60, zc = -((S.r0 + S.r1) / 2) * s;
    const floor = new THREE.Mesh(own(new THREE.PlaneGeometry(gateR * 8, len)), std("#e4ebf3", { roughness: 1 }));
    floor.rotation.x = -PI / 2; floor.position.set(0, -gateR - 1, zc); sc.add(floor);
    for (let d = Math.ceil(S.r0); d <= S.r1; d++) {
      const dt = dateOf(d); const month = dt.getDate() === 1, week = dt.getDay() === 1;
      if (!month && !week) continue;
      const r = new THREE.Mesh(geo("gate" + month, () => new THREE.TorusGeometry(gateR, month ? 0.07 : 0.03, 8, 96)), month ? ringM : weekM);
      r.position.z = -d * s; sc.add(r);
      const ln = new THREE.Mesh(geo("fl" + month, () => new THREE.PlaneGeometry(gateR * 8, month ? 0.12 : 0.05)), basic(month ? "#b3c3d8" : "#d3dde9"));
      ln.rotation.x = -PI / 2; ln.position.set(0, -gateR - 0.99, -d * s); sc.add(ln);
      if (month) addLabel("lp-t3d-lbl--time", (el) => { el.textContent = dt.toLocaleDateString("fr-FR", { month: "long", year: "numeric" }); }, V(0, gateR + 0.4, -d * s), { prio: 45, d });
    }
    const today = new THREE.Mesh(own(new THREE.TorusGeometry(gateR, 0.12, 10, 120)), std("#245edb", { emissive: col("#245edb").multiplyScalar(0.35) }));
    sc.add(today); sc.add(glow("#245edb", gateR * 2.4, 0.1));
    addLabel("lp-t3d-lbl--today", (el) => { el.textContent = "Aujourd'hui · " + fmtShort(0); }, V(0, -gateR - 0.5, 0), { prio: 120, anchor: "below", d: 0 });
    const n = 1400, arr = new Float32Array(n * 3), R = rng(7);
    for (let i = 0; i < n; i++) {
      const a = R() * TAU, r = 1.5 + R() * (gateR + 1);
      arr[i * 3] = Math.cos(a) * r; arr[i * 3 + 1] = Math.sin(a) * r; arr[i * 3 + 2] = -(S.r0 + R() * (S.r1 - S.r0)) * s;
    }
    const gd = own(new THREE.BufferGeometry()); gd.setAttribute("position", new THREE.BufferAttribute(arr, 3));
    sc.add(new THREE.Points(gd, own(new THREE.PointsMaterial({ color: col("#8fa8c9"), size: 0.05, transparent: true, opacity: 0.65 }))));
    M.lines.forEach((l) => {
      const L = addLabel("lp-t3d-lbl--badge", (el) => { el.appendChild(badge(l)); el.appendChild(text("span", l.name)); }, V(), { prio: 90 });
      L.dyn = () => pos(l, Math.min(Math.max(cam.day + 12, l.start), l.end), 0);
    });
  }
  function buildCabine() {
    const M = S.model;
    M.lines.forEach((l) => {
      const pastM = lineMat(l.color, true), futM = lineMat(l.color, false);
      if (l.start < 0) tube([pos(l, l.start, 0), pos(l, Math.min(0, l.end), 0)], 0.07, pastM);
      if (l.end > 0) tube([pos(l, Math.max(0, l.start), 0), pos(l, l.end, 0)], 0.07, futM);
      const term = new THREE.Mesh(geo("term", () => new THREE.CircleGeometry(0.7, 32)), basic(l.color, { side: THREE.DoubleSide }));
      term.position.copy(pos(l, l.end, 0)); S.scene.add(term);
      l.stations.forEach((id) => {
        const x = M.stationById[id]; if (!x.branch) return;
        const k = Math.min(1.2 / S.s, (x.e - x.s) / 2);
        tube([pos(l, x.s, 0), pos(l, x.s + k, x.side), pos(l, x.e, x.side)], 0.05, x.st === "done" ? pastM : futM);
        const j = new THREE.Mesh(geo("junc", () => new THREE.SphereGeometry(0.1, 12, 10)), x.st === "done" || x.s < 0 ? pastM : futM);
        j.position.copy(pos(l, x.s, 0)); S.scene.add(j);
      });
    });
    M.stations.forEach((x) => {
      const l = lineOf(x.lineId), st = x.late ? "late" : x.st, dim = st === "done";
      const p = pos(l, x.e, x.branch ? x.side : 0);
      const g = new THREE.Group(); g.position.copy(p);
      const core = st === "done" ? DONE : st === "late" ? RED : st === "wait" ? AMBER : "#ffffff";
      const ringC = dim ? mix(l.color, DONE, 0.65).getStyle() : l.color;
      const sm = (c) => std(c, { roughness: 0.4, emissive: col(c).multiplyScalar(0.15) });
      const ring = new THREE.Mesh(x.type === "m" ? geo("pm", () => new THREE.TorusGeometry(0.95, 0.08, 8, 4)) : geo("pr", () => new THREE.TorusGeometry(0.6, 0.06, 10, 40)), sm(ringC));
      g.add(ring);
      g.add(new THREE.Mesh(geo("core" + x.type, () => new THREE.SphereGeometry(x.type === "m" ? 0.2 : 0.15, 16, 12)), sm(core)));
      if (!dim) g.add(glow(l.color, x.type === "m" ? 3.0 : 2.2, 0.22));
      if (x.links.length) g.add(new THREE.Mesh(geo("dbl", () => new THREE.TorusGeometry(0.82, 0.04, 8, 36)), basic("#ffffff")));
      if (st === "late") { const h = glow(RED, 3.0, 0.55); g.add(h); S.anims.push({ o: h, kind: "halo", base: 3.0 }); }
      if (st === "doing") S.anims.push({ o: ring, kind: "pulse" });
      const hit = new THREE.Mesh(geo("hit-c", () => new THREE.SphereGeometry(0.9, 8, 6)), basic("#000", { colorWrite: false, depthWrite: false }));
      hit.userData.id = x.id; g.add(hit); S.hits.push(hit);
      S.scene.add(g);
      const R = S.st[x.id]; R.obj = g; R.p = p; R.labelY = 0.9;
    });
    M.links.forEach(([a, b]) => tube([S.st[a].p, S.st[b].p], 0.035, basic("#6f86a6", { transparent: true, opacity: 0.85 })));
    M.lines.forEach((l) => {
      if (0 < l.start || 0 > l.end) return;
      const g = new THREE.Group();
      const body = new THREE.Mesh(geo("cab-train", () => new THREE.BoxGeometry(0.46, 0.4, 1.35)), std(l.color, { roughness: 0.35, emissive: col(l.color).multiplyScalar(0.15) })); g.add(body);
      const nose = new THREE.Mesh(geo("cab-nose", () => new THREE.BoxGeometry(0.4, 0.2, 0.08)), basic("#ffffff")); nose.position.set(0, 0.06, 0.69); g.add(nose);
      const p = pos(l, 0, 0); g.position.copy(p); g.lookAt(p.clone().add(V(0, 0, -1)));
      S.scene.add(g);
    });
  }

  // ---------- Construction ----------
  function disposeScene() {
    S.owned.forEach((x) => x.dispose && x.dispose()); S.owned = [];
    geoCache.forEach((g) => g.dispose()); geoCache.clear();
    matCache.forEach((m) => m.dispose()); matCache.clear();
    S.puffs.forEach((p) => p.sp.material.dispose());
    S.ripples.forEach((r) => { r.m.geometry.dispose(); r.m.material.dispose(); });
    S.labels.forEach((L) => L.el.remove());
    Object.assign(S, { labels: [], hits: [], anims: [], trains: [], barriers: [], xlights: [], cars: [], clouds: [], puffs: [], ripples: [], boarding: [], hands: [], zones: [], st: {}, selRing: null, lastCab: null });
  }
  function rebuild() {
    disposeScene();
    S.scene = new THREE.Scene();
    if (!S.model || !S.model.lines.length) { S.stateKey = ""; return; }
    S.quality = timeline3dResolveQuality(S.qualityPref, S.model.stations.length);
    renderer.shadowMap.enabled = S.quality === "high" && S.mode === "rail";
    S.driver = null; S.playing = false; S.sim = 0; S.dwell = 0; S.down = 0;
    layout();
    S.model.stations.forEach((x) => { S.st[x.id] = {}; });
    if (S.mode === "rail") { decorRail(); buildRail(); } else { decorCabine(); buildCabine(); }
    S.model.stations.forEach((x) => {
      const R = S.st[x.id];
      const cls = "lp-t3d-lbl--st" + (x.type === "m" ? " is-ms" : "") + (x.st === "done" ? " is-done" : "") + (x.late ? " is-late" : "");
      R.label = addLabel(cls, (el) => {
        el.style.setProperty("--lc", lineOf(x.lineId).color);
        el.appendChild(text("b", x.title));
        el.appendChild(text("small", timeline3dRel(x.e) + " · " + fmtShort(x.e)));
      }, R.p.clone().add(V(0, R.labelY, 0)), { task: x });
    });
    S.selRing = new THREE.Mesh(own(new THREE.TorusGeometry(S.mode === "cabine" ? 1.1 : 0.95, 0.06, 8, 48)), basic("#ffc043"));
    if (S.mode !== "cabine") S.selRing.rotation.x = PI / 2;
    S.selRing.visible = false; S.scene.add(S.selRing);
    applyVisibility();
    measureLabels();
    resetCamera(true);
    if (S.mode === "rail" && !RM) { Object.assign(cam, { tx: goal.tx + 6, yaw: -1.25, pitch: 1.2, dist: 88 }); S.intro = true; }
    if (S.selectedId && S.st[S.selectedId]) select(S.selectedId, false); else S.selectedId = null;
    emit(true);
  }
  function applyVisibility() {
    if (!S.model) return;
    S.model.stations.forEach((x) => {
      const R = S.st[x.id]; if (!R || !R.obj) return;
      const on = !S.visible || S.visible.has(x.id);
      R.obj.visible = on; R.hidden = !on;
    });
    S.hits = S.hits.filter(() => true);
  }
  function measureLabels() {
    S.labels.forEach((L) => { L.el.style.transform = "translate(-9999px,0)"; L.el.style.visibility = "hidden"; });
    S.labels.forEach((L) => { L.w = L.el.offsetWidth; L.h = L.el.offsetHeight; });
  }

  // ---------- Caméras ----------
  function resetCamera(instant) {
    if (S.mode === "rail") Object.assign(goal, { tx: 14 * S.s, ty: 0, tz: 0, yaw: -0.5, pitch: 0.7, dist: 40 });
    else Object.assign(goal, { day: -4, yaw: 0, pitch: 0.02 });
    S.focus = 0;
    if (instant) Object.assign(cam, goal);
  }
  function focusDay(d, move) {
    if (!S.model) return;
    S.focus = Math.max(Math.floor(S.r0), Math.min(Math.ceil(S.r1), d));
    if (move === false) return;
    if (S.mode === "rail") goal.tx = S.focus * S.s; else goal.day = S.focus - 4;
    if (RM) Object.assign(cam, goal);
  }
  function applyCamera() {
    if (S.mode === "rail" && S.driver) {
      const tr = S.driver, dl = S.dl;
      camera.fov = 60; camera.near = 0.05;
      camera.position.set(tr.front - 0.95, 1.14, tr.lz);
      const f = V(Math.cos(dl.y) * Math.cos(dl.p), Math.sin(dl.p), -Math.sin(dl.y) * Math.cos(dl.p));
      camera.lookAt(camera.position.clone().add(f));
    } else if (S.mode === "cabine") {
      camera.fov = 64; camera.near = 0.1;
      camera.position.set(0, 0, -cam.day * S.s);
      const f = V(-Math.sin(cam.yaw) * Math.cos(cam.pitch), Math.sin(cam.pitch), -Math.cos(cam.yaw) * Math.cos(cam.pitch));
      camera.lookAt(camera.position.clone().add(f));
    } else {
      camera.fov = 40; camera.near = 0.1;
      const cp = Math.cos(cam.pitch);
      camera.position.set(cam.tx + cam.dist * cp * Math.sin(cam.yaw), cam.ty + cam.dist * Math.sin(cam.pitch), cam.tz + cam.dist * cp * Math.cos(cam.yaw));
      camera.lookAt(cam.tx, cam.ty, cam.tz);
    }
    camera.updateProjectionMatrix();
  }
  function flyTo(id) {
    const x = S.model.stationById[id], R = S.st[id]; if (!x || !R || !R.p) return;
    if (S.mode === "cabine") {
      goal.day = x.e - 9;
      const cp = V(0, 0, -goal.day * S.s), rel = R.p.clone().sub(cp);
      goal.yaw = Math.atan2(-rel.x, -rel.z); goal.pitch = Math.atan2(rel.y, Math.hypot(rel.x, rel.z)) * 0.8;
      while (goal.yaw - cam.yaw > PI) goal.yaw -= TAU;
      while (goal.yaw - cam.yaw < -PI) goal.yaw += TAU;
    } else if (!S.driver) Object.assign(goal, { tx: R.p.x, ty: R.p.y, tz: R.p.z, dist: 14 });
    focusDay(x.e, false);
    if (RM) Object.assign(cam, goal);
  }

  // ---------- Animations Grande Ligne ----------
  const _v = new THREE.Vector3();
  function puff(p, big) {
    let q = S.puffs.find((z) => !z.alive);
    if (!q) {
      if (S.puffs.length > 240) return;
      const sp = new THREE.Sprite(new THREE.SpriteMaterial({ map: puffTex, color: col("#f4f6f8"), transparent: true, depthWrite: false }));
      S.scene.add(sp); q = { sp }; S.puffs.push(q);
    }
    Object.assign(q, { alive: true, life: 0, max: 1.5 + Math.random() * 0.9, vx: (Math.random() - 0.5) * 0.2, vy: 0.55 + Math.random() * 0.35, vz: (Math.random() - 0.5) * 0.2, s0: big ? 0.26 : 0.17 });
    q.sp.visible = true; q.sp.position.copy(p);
  }
  function board(id) {
    const R = S.st[id];
    if (!R || !R.pax || !R.pax.length || R.boarded) return;
    R.boarded = true; S.boarding.push({ id, life: 0 });
  }
  function resetPax() {
    S.boarding = [];
    Object.keys(S.st).forEach((id) => { const R = S.st[id]; if (!R.pax) return; R.boarded = false; R.pax.forEach((q) => { q.f.visible = true; q.f.position.copy(q.home); q.f.scale.set(1, 1, 1); }); });
  }
  function ripple(id) {
    const R = S.st[id], x = S.model.stationById[id];
    if (!R || !R.p || R.hidden) return;
    board(id);
    if (!anim()) return;
    const cab = S.mode === "cabine";
    const m = new THREE.Mesh(cab ? new THREE.TorusGeometry(x.type === "m" ? 0.95 : 0.62, 0.05, 8, 40) : new THREE.RingGeometry(0.34, 0.44, 40),
      new THREE.MeshBasicMaterial({ color: col(lineOf(x.lineId).color), transparent: true, opacity: 0.95, depthWrite: false, side: THREE.DoubleSide }));
    if (!cab) m.rotation.x = -PI / 2;
    m.position.copy(R.p); if (!cab) m.position.y += 0.03;
    S.scene.add(m); S.ripples.push({ m, life: 0, id, cab });
  }
  function speedDays() { return S.speed; }
  function updateRail(dt, tt) {
    const s = S.s;
    if (S.playing) {
      if (S.dwell > 0) S.dwell -= dt;
      else {
        const prev = S.sim; let next = Math.min(S.simEnd, S.sim + dt * speedDays());
        if (S.driver) {
          const stop = S.driver.l.stations.map((id) => S.model.stationById[id]).find((x) => x.e > prev && x.e <= next && x.st !== "done" && !S.st[x.id].hidden);
          if (stop) { next = stop.e; S.dwell = 1.4; }
        }
        S.sim = next;
        S.model.stations.forEach((x) => { if (x.e > prev && x.e <= S.sim && x.st !== "done") ripple(x.id); });
      }
      S.trains.forEach((tr) => { tr.target = trainStop(tr, playFront(S.sim) - (tr === S.driver ? 1.6 : 0)); });
      if (!S.driver) goal.tx = S.sim * s + 5;
      focusDay(S.sim, false);
      S.clockUntil = tt + 2.5;
      if (S.sim >= S.simEnd && S.dwell <= 0) { S.playing = false; S.ended = true; }
    }
    const k = RM ? 1 : 1 - Math.exp(-dt * 6);
    S.dl.y += (S.dl.gy - S.dl.y) * k; S.dl.p += (S.dl.gp - S.dl.p) * k;
    let moving = false;
    S.trains.forEach((tr) => {
      const diff = tr.target - tr.front;
      if (!anim()) { tr.front = tr.target; tr.vel = 0; }
      else {
        const want = Math.max(-5, Math.min(5, diff * 2.2));
        tr.vel += (want - tr.vel) * Math.min(1, dt * 2.6);
        if (Math.abs(diff) < 0.004 && Math.abs(tr.vel) < 0.03) { tr.vel = 0; tr.front = tr.target; } else tr.front += tr.vel * dt;
      }
      placeTrain(tr);
      const sp = Math.abs(tr.vel);
      if (sp > 0.05) moving = true;
      tr.wheels.forEach((w) => { w.w.rotation.x += tr.vel * dt / w.r; });
      if (anim()) {
        tr.nextPuff -= dt;
        if (tr.nextPuff <= 0) {
          tr.top.getWorldPosition(_v); puff(_v, sp > 0.3 && tr !== S.driver);
          tr.nextPuff = (sp > 0.1 ? Math.max(0.07, 0.3 / sp) : 1.2 + Math.random() * 0.8) * (tr === S.driver ? 2.2 : 1);
        }
      }
      if (tr.arrived && Math.abs(tr.target - tr.front) < 0.06 && sp < 0.06) { ripple(tr.arrived); tr.arrived = null; }
    });
    const down = moving || S.playing;
    S.down += ((down ? 1 : 0) - S.down) * Math.min(1, dt * (anim() ? 3 : 60));
    S.barriers.forEach((b) => { b.pivot.rotation.x = b.up * (1 - S.down); });
    const blink = Math.sin(tt * 7) > 0;
    S.xlights.forEach(([a, b]) => { a.visible = down && blink; b.visible = down && !blink; });
    if (anim()) {
      S.cars.forEach((c) => {
        let want = c.speed;
        const front = c.z + c.dir * 0.28;
        const inZone = S.zones.some(([a, b]) => front > a && front < b);
        if (S.down > 0.3 && !inZone) {
          const ahead = S.zones.map(([a, b]) => (c.dir > 0 ? a - front : front - b)).filter((d) => d > -0.01);
          if (ahead.length && Math.min.apply(null, ahead) < 0.35) want = 0;
        }
        S.cars.forEach((q) => { if (q !== c && q.dir === c.dir) { const gap = (q.z - c.z) * c.dir; if (gap > 0 && gap < 0.85) want = 0; } });
        c.v += (want - c.v) * Math.min(1, dt * 3);
        c.z += c.dir * c.v * dt;
        if (c.dir > 0 && c.z > c.zmax) c.z = c.zmin;
        if (c.dir < 0 && c.z < c.zmin) c.z = c.zmax;
        c.g.position.z = c.z;
      });
      S.clouds.forEach((c) => { c.g.position.x += c.v * dt; if (c.g.position.x > c.xmax) c.g.position.x = c.xmin; });
    }
    const now = new Date(), mins = now.getHours() * 60 + now.getMinutes() + now.getSeconds() / 60;
    S.hands.forEach((h) => { h.mg.rotation.z = -h.sgn * (mins % 60) / 60 * TAU; h.hg.rotation.z = -h.sgn * (mins % 720) / 720 * TAU; });
    S.puffs.forEach((p) => {
      if (!p.alive) return;
      p.life += dt; const q = p.life / p.max;
      if (q >= 1) { p.alive = false; p.sp.visible = false; return; }
      p.sp.position.x += p.vx * dt; p.sp.position.y += p.vy * dt; p.sp.position.z += p.vz * dt; p.vy *= 0.985;
      const sc = p.s0 + q * 0.95; p.sp.scale.set(sc, sc, 1); p.sp.material.opacity = 0.9 * (1 - q);
    });
    S.boarding = S.boarding.filter((b) => {
      b.life += dt; const q = Math.min(1, b.life / 1.1), R = S.st[b.id];
      R.pax.forEach((p, i) => {
        const kk = Math.max(0, Math.min(1, q * 1.4 - i * 0.12));
        p.f.position.z = p.home.z + (R.out * 0.6 - p.home.z) * Math.min(1, kk * 1.6);
        const sh = kk > 0.6 ? Math.max(0, 1 - (kk - 0.6) / 0.4) : 1;
        p.f.scale.set(sh, sh, sh); p.f.visible = sh > 0.02;
      });
      return q < 1;
    });
  }
  function updateCab(dt) {
    if (S.playing) {
      S.sim = Math.min(S.simEnd, S.sim + dt * speedDays());
      goal.day = S.sim - 4; focusDay(S.sim, false);
      if (S.sim >= S.simEnd) { S.playing = false; S.ended = true; }
    }
    const probe = cam.day + 3.5;
    if (S.lastCab != null && probe > S.lastCab) S.model.stations.forEach((x) => { if (x.e > S.lastCab && x.e <= probe && x.st !== "done") ripple(x.id); });
    S.lastCab = probe;
  }
  function updateEffects(dt, tt) {
    S.anims.forEach((a) => {
      if (!anim()) { if (a.kind === "blink") a.o.visible = true; return; }
      if (a.kind === "pulse") { const q = 1 + 0.18 * (0.5 + 0.5 * Math.sin(tt * 3.2)); a.o.scale.set(q, q, q); }
      else if (a.kind === "blink") a.o.visible = Math.sin(tt * a.f) > -0.2;
      else { const q = a.base * (0.85 + 0.3 * (0.5 + 0.5 * Math.sin(tt * 4.2))); a.o.scale.set(q, q, 1); }
    });
    S.ripples = S.ripples.filter((r) => {
      r.life += dt; const q = r.life / (r.cab ? 1.0 : 1.2), R = S.st[r.id];
      if (q >= 1) { S.scene.remove(r.m); r.m.geometry.dispose(); r.m.material.dispose(); if (R && R.obj) R.obj.scale.set(1, 1, 1); return false; }
      const sc = 1 + q * (r.cab ? 2.6 : 3.2);
      if (r.cab) r.m.scale.set(sc, sc, sc); else r.m.scale.set(sc, sc, 1);
      r.m.material.opacity = 0.95 * (1 - q);
      if (R && R.obj) { if (r.cab) { const b = 1 + 0.45 * Math.sin(Math.min(1, q * 2) * PI); R.obj.scale.set(b, b, b); } else R.obj.scale.y = 1 + 0.14 * Math.sin(Math.min(1, q * 2.2) * PI); }
      return true;
    });
    if (S.selRing && S.selRing.visible && anim()) S.selRing.rotation.z = tt;
  }

  // ---------- État remonté à l'interface ----------
  function hudState(tt) {
    const M = S.model; if (!M) return null;
    if (S.mode === "cabine") {
      const day = cam.day + 4, next = timeline3dNextStop(M, cam.day + 3.5, null, S.visible);
      return { day, nextId: next ? next.id : null, nextIn: next ? Math.max(0, Math.ceil(next.e - day)) : null };
    }
    if (S.driver) {
      const tr = S.driver, day = S.playing ? S.sim : Math.max(tr.l.start, trainDay(tr));
      const next = tr.l.stations.map((id) => M.stationById[id]).find((x) => x.e * S.s + 0.7 > tr.front + 0.05 && x.st !== "done" && !S.st[x.id].hidden);
      return { day, nextId: next ? next.id : null, nextIn: next ? Math.max(0, Math.ceil(next.e - day)) : null };
    }
    if (S.playing || tt < S.clockUntil) {
      const next = timeline3dNextStop(M, S.sim, null, S.visible);
      return { day: S.sim, nextId: next ? next.id : null, nextIn: next ? Math.max(0, Math.ceil(next.e - S.sim)) : null };
    }
    return null;
  }
  function emit(force, tt) {
    if (!o.onState) return;
    const hud = hudState(tt || 0);
    const st = { playing: S.playing, ended: !!S.ended, driverLineId: S.driver ? S.driver.l.id : null, focus: Math.round(S.focus), hud: hud ? { day: Math.floor(hud.day), frac: hud.day - Math.floor(hud.day), nextId: hud.nextId, nextIn: hud.nextIn } : null };
    const key = JSON.stringify([st.playing, st.ended, st.driverLineId, st.focus, hud ? [st.hud.day, st.hud.nextId, st.hud.nextIn] : null]);
    const now = performance.now();
    if (!force && key === S.stateKey && now - S.lastEmit < 250) return;
    if (!force && key === S.stateKey && !hud) return;
    S.stateKey = key; S.lastEmit = now;
    o.onState(st);
  }

  // ---------- Libellés : projection et placement glouton ----------
  const tmp = new THREE.Vector3();
  function placeLabels() {
    const w = S.W, h = S.H, cands = [];
    const crect = container.getBoundingClientRect();
    const obstacles = (o.obstacles ? o.obstacles() : []).map((r) => ({ x1: r.left - crect.left, y1: r.top - crect.top, x2: r.right - crect.left, y2: r.bottom - crect.top }));
    const camDay = S.mode === "cabine" ? cam.day : S.focus;
    const drv = S.mode === "rail" && S.driver;
    S.labels.forEach((L) => {
      const p = L.dyn ? L.dyn() : L.pos;
      tmp.copy(p).project(camera);
      let ok = tmp.z < 1 && tmp.z > -1 && Math.abs(tmp.x) < 1.2 && Math.abs(tmp.y) < 1.2;
      let prio = L.prio;
      const dist = camera.position.distanceTo(p);
      if (ok && L.task && S.st[L.task.id] && S.st[L.task.id].hidden) ok = false;
      if (ok && drv) {
        if (L.el.classList.contains("lp-t3d-lbl--folder")) ok = false;
        else if (L.task) { ok = S.st[L.task.id].p.x > camera.position.x + 0.5 && dist < 42; prio = 90 - dist + (L.task.lineId === S.driver.l.id ? 60 : 0) + (L.task.id === S.selectedId ? 300 : 0); }
        else if (dist > 50) ok = false;
      } else if (ok && L.task) {
        const t = L.task, dd = t.e - camDay;
        if (S.mode === "cabine") ok = dd > 0.5 && dd < 42;
        else ok = Math.abs(t.e - S.focus) < 40 || t.type === "m";
        prio = 60 - Math.abs(t.e - (S.mode === "cabine" ? camDay + 8 : S.focus)) * 0.6 + (t.type === "m" ? 12 : 0) + (t.late ? 25 : 0) + (t.st === "done" ? -20 : 0) + (t.id === S.selectedId ? 300 : 0);
      }
      if (ok && L.d != null && S.mode === "cabine") ok = L.d - camDay > 0 && L.d - camDay < 70;
      if (ok && !drv && dist > (S.mode === "cabine" ? 38 : 95)) ok = false;
      if (!ok) { if (L.shown) { L.el.style.visibility = "hidden"; L.shown = false; } return; }
      const sx = (tmp.x + 1) / 2 * w, sy = (1 - tmp.y) / 2 * h;
      let x = sx - L.w / 2, y = sy - L.h - 6;
      if (L.anchor === "below") y = sy + 6;
      if (L.anchor === "left") { x = sx - L.w - 10; y = sy - L.h / 2; }
      if (L.anchor === "right") { x = sx + 10; y = sy - L.h / 2; }
      cands.push({ L, x, y, prio });
    });
    cands.sort((a, b) => b.prio - a.prio);
    const placed = obstacles.slice();
    let count = 0;
    const max = w < 600 ? 22 : 46;
    cands.forEach((c) => {
      const r = { x1: c.x - 3, y1: c.y - 2, x2: c.x + c.L.w + 3, y2: c.y + c.L.h + 2 };
      const clash = r.x2 < 0 || r.x1 > w || r.y2 < 0 || r.y1 > h || placed.some((q) => !(r.x2 < q.x1 || q.x2 < r.x1 || r.y2 < q.y1 || q.y2 < r.y1));
      if (clash || count >= max) { if (c.L.shown) { c.L.el.style.visibility = "hidden"; c.L.shown = false; } return; }
      placed.push(r); count++;
      c.L.el.style.transform = "translate(" + Math.round(c.x) + "px," + Math.round(c.y) + "px)";
      if (!c.L.shown) { c.L.el.style.visibility = "visible"; c.L.shown = true; }
    });
  }

  // ---------- Boucle ----------
  function frame(now) {
    if (S.disposed) return;
    S.raf = requestAnimationFrame(frame);
    const dt = Math.min(0.05, (now - S.last) / 1000); S.last = now;
    if (!S.model || !S.model.lines.length) { renderer.render(S.scene, camera); return; }
    const tt = now / 1000;
    const k = RM ? 1 : 1 - Math.exp(-dt * (S.intro ? 1.6 : 6));
    if (S.intro && cam.dist < 50) S.intro = false;
    Object.keys(goal).forEach((key) => { cam[key] += (goal[key] - cam[key]) * k; });
    if (S.mode === "rail") updateRail(dt, tt); else updateCab(dt);
    updateEffects(dt, tt);
    applyCamera();
    renderer.render(S.scene, camera);
    placeLabels();
    emit(false, tt);
  }
  function resize() {
    const r = container.getBoundingClientRect();
    S.W = Math.max(1, Math.round(r.width)); S.H = Math.max(1, Math.round(r.height));
    renderer.setSize(S.W, S.H, false); camera.aspect = S.W / S.H; camera.updateProjectionMatrix();
  }
  const ro = new ResizeObserver(resize); ro.observe(container); resize();

  // ---------- Entrées ----------
  const ptrs = new Map(); let dragMode = null, moved = 0, pinch0 = 0, down = false;
  const ray = new THREE.Raycaster(), ndc = new THREE.Vector2();
  function hitAt(e) {
    const r = canvas.getBoundingClientRect();
    ndc.set(((e.clientX - r.left) / r.width) * 2 - 1, -((e.clientY - r.top) / r.height) * 2 + 1);
    ray.setFromCamera(ndc, camera);
    const hits = ray.intersectObjects(S.hits.filter((m) => m.parent && m.parent.visible), false);
    return hits[0] ? hits[0].object.userData.id : null;
  }
  function moveDays(n) {
    if (!S.model) return;
    if (S.playing) pause();
    if (S.mode === "rail" && S.driver) {
      const tr = S.driver; tr.target = trainStop(tr, tr.target + n * S.s); tr.arrived = null;
      focusDay(trainDay(tr) + n, false); return;
    }
    if (S.mode === "cabine") { goal.day = Math.max(S.r0 - 6, Math.min(S.r1, goal.day + n)); focusDay(goal.day + 4, false); if (RM) Object.assign(cam, goal); return; }
    focusDay(S.focus + n);
  }
  function zoom(dy) {
    if (S.mode === "rail" && S.driver) { moveDays(dy * 0.01); return; }
    if (S.mode === "cabine") { moveDays(dy * 0.02); return; }
    goal.dist = Math.max(6, Math.min(110, goal.dist * Math.exp(dy * 0.0012)));
    if (RM) Object.assign(cam, goal);
  }
  const onDown = (e) => {
    canvas.setPointerCapture(e.pointerId); ptrs.set(e.pointerId, { x: e.clientX, y: e.clientY });
    moved = 0; down = true;
    dragMode = (e.button === 2 || e.shiftKey) ? "pan" : "rot";
    if (ptrs.size === 2) { const [a, b] = [...ptrs.values()]; pinch0 = Math.hypot(a.x - b.x, a.y - b.y); dragMode = "pinch"; }
    canvas.classList.add("is-drag");
  };
  let lastHover = 0;
  const onMove = (e) => {
    const p = ptrs.get(e.pointerId);
    if (!p) {
      const now = performance.now(); if (now - lastHover < 60) return; lastHover = now;
      canvas.classList.toggle("is-hot", !!hitAt(e)); return;
    }
    const dx = e.clientX - p.x, dy = e.clientY - p.y; p.x = e.clientX; p.y = e.clientY;
    moved += Math.abs(dx) + Math.abs(dy);
    S.intro = false;
    if (dragMode === "pinch" && ptrs.size === 2) {
      const [a, b] = [...ptrs.values()]; const d = Math.hypot(a.x - b.x, a.y - b.y);
      if (pinch0) zoom((pinch0 - d) * 4); pinch0 = d; return;
    }
    if (S.mode === "rail" && S.driver) {
      if (dragMode === "pan") moveDays(-dy * 0.05);
      else { S.dl.gy = Math.max(-1.4, Math.min(1.4, S.dl.gy + dx * 0.004)); S.dl.gp = Math.max(-0.6, Math.min(0.5, S.dl.gp + dy * 0.004)); }
      if (RM) { S.dl.y = S.dl.gy; S.dl.p = S.dl.gp; }
      return;
    }
    if (S.mode === "cabine") {
      if (dragMode === "pan") moveDays(-dy * 0.08);
      else { goal.yaw += dx * 0.004; goal.pitch = Math.max(-1.2, Math.min(1.2, goal.pitch + dy * 0.004)); }
    } else if (dragMode === "pan") {
      const kk = cam.dist * 0.0016, cy = Math.cos(cam.yaw), sy = Math.sin(cam.yaw);
      goal.tx -= (dx * cy + dy * sy) * kk; goal.tz -= (-dx * sy + dy * cy) * kk;
      focusDay(goal.tx / S.s, false);
    } else {
      goal.yaw -= dx * 0.005; goal.pitch = Math.max(0.12, Math.min(1.45, goal.pitch + dy * 0.005));
    }
    if (RM) Object.assign(cam, goal);
  };
  const onUp = (e) => {
    ptrs.delete(e.pointerId); canvas.classList.remove("is-drag");
    if (ptrs.size === 0 && down && moved < 6) { const id = hitAt(e); if (id) select(id, true); }
    if (ptrs.size === 0) down = false;
    if (ptrs.size < 2) pinch0 = 0;
  };
  const onCancel = (e) => { ptrs.delete(e.pointerId); if (!ptrs.size) down = false; };
  const onWheel = (e) => { e.preventDefault(); S.intro = false; zoom(e.deltaY); };
  const onCtx = (e) => e.preventDefault();
  const onKey = (e) => {
    if (e.target && /^(INPUT|SELECT|TEXTAREA|BUTTON)$/.test(e.target.tagName)) return;
    if (e.key === "ArrowRight" || e.key === "ArrowUp") { moveDays(e.shiftKey ? 1 : 7); e.preventDefault(); }
    else if (e.key === "ArrowLeft" || e.key === "ArrowDown") { moveDays(e.shiftKey ? -1 : -7); e.preventDefault(); }
    else if (e.key === " ") { e.preventDefault(); togglePlay(); }
    else if (e.key === "Escape") { if (S.driver) driver(null); else select(null); }
  };
  canvas.addEventListener("pointerdown", onDown);
  canvas.addEventListener("pointermove", onMove);
  canvas.addEventListener("pointerup", onUp);
  canvas.addEventListener("pointercancel", onCancel);
  canvas.addEventListener("wheel", onWheel, { passive: false });
  canvas.addEventListener("contextmenu", onCtx);
  const keyTarget = o.keyTarget || container;
  keyTarget.addEventListener("keydown", onKey);

  // ---------- API ----------
  function select(id, fly) {
    if (!S.model) return;
    S.selectedId = id && S.model.stationById[id] ? id : null;
    const R = S.selectedId ? S.st[S.selectedId] : null;
    if (S.selRing) {
      S.selRing.visible = !!(R && R.p);
      if (R && R.p) { S.selRing.position.copy(R.p); if (S.mode !== "cabine") S.selRing.position.y += 0.02; }
    }
    S.labels.forEach((L) => { if (L.task) L.el.classList.toggle("is-selected", L.task.id === S.selectedId); });
    if (o.onSelect) o.onSelect(S.selectedId);
    if (!S.selectedId || !fly) return;
    flyTo(S.selectedId);
    if (S.mode === "rail") {
      const x = S.model.stationById[S.selectedId];
      const tr = S.trains.find((q) => q.l.id === x.lineId);
      if (tr) {
        if (S.playing) pause();
        if (S.driver && S.driver !== tr) driver(tr.l.id);
        tr.target = trainStop(tr, x.e * S.s + (S.driver === tr ? -0.9 : 0.7)); tr.arrived = S.selectedId;
      }
    }
  }
  function play() {
    if (!S.model || !S.model.lines.length) return;
    S.ended = false;
    if (S.mode === "cabine") {
      S.simEnd = S.r1 - 2; S.sim = cam.day + 4; if (S.sim >= S.simEnd - 0.5) S.sim = 0;
    } else {
      S.simEnd = Math.min(S.r1, 90);
      if (S.sim >= S.simEnd - 0.01 || S.sim < 0) { S.sim = 0; resetPax(); }
      S.trains.forEach((tr) => { tr.arrived = null; });
      S.dwell = 0;
      if (!S.driver) Object.assign(goal, { dist: Math.min(goal.dist, 22), pitch: Math.min(goal.pitch, 0.58), tz: 0 });
    }
    select(null);
    S.playing = true; emit(true);
  }
  function pause() { S.playing = false; emit(true); }
  function togglePlay() { if (S.playing) pause(); else play(); }
  function today() {
    S.playing = false; S.ended = false; S.sim = 0; S.dwell = 0; S.clockUntil = 0;
    if (S.mode === "rail") { resetPax(); S.trains.forEach((tr) => { tr.target = tr.rest; tr.arrived = null; }); }
    if (!S.driver) resetCamera(RM);
    select(null); emit(true);
  }
  function driver(lineId) {
    if (S.mode !== "rail") return;
    const tr = lineId ? S.trains.find((q) => q.l.id === lineId) : null;
    if (!tr) {
      const was = S.driver; S.driver = null;
      if (was) Object.assign(goal, { tx: was.front, tz: was.lz, dist: 18, pitch: 0.6 });
    } else { S.driver = tr; S.dl = { y: 0, p: -0.07, gy: 0, gp: -0.07 }; }
    emit(true);
  }
  const api = {
    setData(d) {
      const modelChanged = d.model !== S.model;
      S.model = d.model; S.visible = d.visible || null;
      if (modelChanged) rebuild(); else { applyVisibility(); emit(true); }
    },
    setMode(m) { const next = m === "cabine" ? "cabine" : "rail"; if (next === S.mode) return; S.mode = next; rebuild(); },
    setAnimate(b) { S.animate = b !== false; },
    setSpeed(v) { S.speed = v > 0 ? v : 2.4; },
    setQuality(q) { if (q === S.qualityPref) return; S.qualityPref = q; rebuild(); },
    select, play, pause, togglePlay, today, driver,
    step: moveDays,
    zoomBy(f) { if (S.mode === "rail" && !S.driver) { goal.dist = Math.max(6, Math.min(110, goal.dist * f)); if (RM) Object.assign(cam, goal); } else moveDays(f < 1 ? 7 : -7); },
    trainLines() { return S.trains.map((tr) => tr.l.id); },
    dispose() {
      S.disposed = true; cancelAnimationFrame(S.raf); ro.disconnect();
      canvas.removeEventListener("pointerdown", onDown); canvas.removeEventListener("pointermove", onMove);
      canvas.removeEventListener("pointerup", onUp); canvas.removeEventListener("pointercancel", onCancel);
      canvas.removeEventListener("wheel", onWheel); canvas.removeEventListener("contextmenu", onCtx);
      keyTarget.removeEventListener("keydown", onKey);
      disposeScene(); glowTex.dispose(); puffTex.dispose(); renderer.dispose();
      canvas.remove(); labelsEl.remove();
    },
  };
  S.scene = new THREE.Scene();
  S.raf = requestAnimationFrame(frame);
  return api;
}
// === NEXORA:TIMELINE3D-ENGINE:END ===

// Vue Cosmos (#402) : exploration des dossiers (galaxies), projets (planètes)
// et tâches (satellites) sur trois échelles. Même règle que la Carte :
// explorer ne modifie rien ; seules les actions explicites du volet de tâche
// (CarteTaskDetail, réutilisé tel quel) passent par les mécanismes Nexora.
const COSMOS_MEMORY_KEY = "nexora:cosmos:layout";
function readCosmosMemory() {
  try { const raw = window.localStorage && window.localStorage.getItem(COSMOS_MEMORY_KEY); return raw ? JSON.parse(raw) : {}; } catch (e) { return {}; }
}
function writeCosmosMemory(mem) {
  try { window.localStorage && window.localStorage.setItem(COSMOS_MEMORY_KEY, JSON.stringify(mem)); } catch (e) { /* stockage indisponible : l'univers reste déterministe */ }
}
const COSMOS_LEVELS = [["universe", "Univers"], ["galaxy", "Galaxie"], ["planet", "Planète"]];
const cosmosPlural = (n, w) => n + " " + w + (n > 1 ? "s" : "");

// Répartition des tâches par famille d'état (mêmes libellés que la Carte).
function CosmosStateBar({ stats }) {
  const keys = COSMOS_STATE_KEYS.filter((k) => stats[k]);
  const colors = { todo: "#64748B", waiting: "#8B5CF6", doing: "#0EA5E9", done: "#22B07D", info: "#94A3B8" };
  if (!stats.total) return <p className="lp-carte-muted lp-cosmos-small">Aucune tâche.</p>;
  return (
    <>
      <div className="lp-cosmos-stack" role="img" aria-label={keys.map((k) => stats[k] + " " + COSMOS_STATE_LABELS[k].toLowerCase()).join(", ")}>
        {keys.map((k) => <i key={k} style={{ flex: stats[k], background: colors[k] }} />)}
      </div>
      <p className="lp-cosmos-small lp-carte-muted">{keys.map((k) => stats[k] + " " + COSMOS_STATE_LABELS[k].toLowerCase()).join(" · ")}</p>
    </>
  );
}

// Panneau de synthèse (droite) : dossier, projet ou univers selon la cible.
function CosmosSummary({ model, norm, visible, target, level, onReveal, onEnter, onSelectTask, onClose }) {
  const g = target.kind === "galaxy" ? model.galaxyById[target.id] : null;
  const p = target.kind === "planet" ? model.planets[target.id] : null;
  const planetRow = (pid) => {
    const q = model.planets[pid];
    return (
      <li key={pid}>
        <button type="button" className="lp-cosmos-row" onClick={() => onReveal("planet", pid)}>
          <span className="lp-cosmos-orb" style={{ "--c": q.color }} />
          <span className="lp-cosmos-row-main"><b>{q.name}</b><small>{q.taskIds.length ? cosmosPlural(q.taskIds.length, "tâche") + " · " + q.stats.pct + " %" : "Aucune tâche"}{q.stats.overdue ? <em> · {q.stats.overdue} en retard</em> : null}</small></span>
          <span className="lp-carte-bar"><span style={{ width: q.stats.pct + "%", background: q.color }} /></span>
        </button>
      </li>
    );
  };
  let body;
  if (g) {
    body = (
      <>
        <div className="lp-cosmos-kicker"><Folder size={13} /> {g.unsorted ? "Projets sans dossier" : level === "universe" ? "Dossier sélectionné" : "Galaxie"}</div>
        <h3 className="lp-cosmos-title">{g.name}</h3>
        <div className="lp-cosmos-kpis">
          <div><b>{g.stats.projects}</b><span>projet{g.stats.projects > 1 ? "s" : ""}</span></div>
          <div><b>{g.stats.total}</b><span>tâche{g.stats.total > 1 ? "s" : ""}</span></div>
          <div className={g.stats.overdue ? "is-late" : ""}><b>{g.stats.overdue}</b><span>en retard</span></div>
        </div>
        <div className="lp-carte-section-title">Répartition des tâches</div>
        <CosmosStateBar stats={g.stats} />
        {g.projectIds.length === 0 && <p className="lp-carte-muted lp-cosmos-small">Ce dossier ne contient encore aucun projet : sa galaxie reste vide.</p>}
        {g.direct.length > 0 && <ul className="lp-cosmos-list">{g.direct.slice(0, 60).map(planetRow)}</ul>}
        {g.amas.map((a) => (
          <div key={a.id}>
            <div className="lp-carte-section-title">Amas · {a.name}</div>
            {a.projectIds.length ? <ul className="lp-cosmos-list">{a.projectIds.slice(0, 40).map(planetRow)}</ul> : <p className="lp-carte-muted lp-cosmos-small">Sous-dossier vide.</p>}
          </div>
        ))}
        {g.projectIds.length > 100 && <p className="lp-carte-muted lp-cosmos-small">Liste abrégée : utilisez « Aller à… » pour rejoindre un projet.</p>}
        {level === "universe" && <div className="lp-cosmos-cta"><button type="button" className="lp-btn lp-btn-primary" onClick={() => onEnter("galaxy", g.id)}><Orbit size={14} /> Entrer dans la galaxie</button></div>}
      </>
    );
  } else if (p) {
    const tasks = cosmosLabelOrder(p.taskIds.map((id) => norm.taskById[id]).filter(Boolean), null);
    const g2 = model.galaxyById[p.galaxyId];
    body = (
      <>
        <div className="lp-cosmos-kicker"><span className="lp-carte-dot" style={{ background: p.color }} />{p.orphan ? "Tâches sans projet" : "Projet"} · {g2.name}{p.amasName ? " · " + p.amasName : ""}</div>
        <h3 className="lp-cosmos-title">{p.name}</h3>
        <div className="lp-cosmos-kpis">
          <div><b>{p.taskIds.length}</b><span>tâche{p.taskIds.length > 1 ? "s" : ""}</span></div>
          <div><b>{p.stats.pct} %</b><span>terminé</span></div>
          <div className={p.stats.overdue ? "is-late" : ""}><b>{p.stats.overdue}</b><span>en retard</span></div>
        </div>
        <CosmosStateBar stats={p.stats} />
        <ul className="lp-cosmos-list">
          {tasks.slice(0, 150).map((t) => (
            <li key={t.id}>
              <button type="button" className={"lp-cosmos-row" + (visible && !visible.has(t.id) ? " is-dim" : "")} disabled={!!visible && !visible.has(t.id)} title={visible && !visible.has(t.id) ? "Masquée par les filtres" : undefined} onClick={() => onSelectTask(t.id)}>
                <span className="lp-carte-state" style={{ background: t.statusColor }} />
                <span className="lp-cosmos-row-main"><span className="lp-cosmos-ellipsis">{t.milestone ? "◆ " : ""}{t.title}</span><small className={t.overdue ? "is-late" : ""}>{t.state === "done" ? "Terminée" : carteDueText(t)}</small></span>
              </button>
            </li>
          ))}
        </ul>
        {tasks.length > 150 && <p className="lp-carte-muted lp-cosmos-small">… et {tasks.length - 150} autres.</p>}
        {level !== "planet" && <div className="lp-cosmos-cta"><button type="button" className="lp-btn lp-btn-primary" onClick={() => onEnter("planet", p.id)}><Crosshair size={14} /> Aller sur la planète</button></div>}
      </>
    );
  } else {
    body = (
      <>
        <div className="lp-cosmos-kicker"><Layers size={13} /> Univers</div>
        <h3 className="lp-cosmos-title">{cosmosPlural(model.galaxies.length, "galaxie")}</h3>
        <ul className="lp-cosmos-list">
          {model.galaxies.map((x) => (
            <li key={x.id}>
              <button type="button" className="lp-cosmos-row" onClick={() => onReveal("galaxy", x.id)}>
                <span className="lp-cosmos-orb is-sun" />
                <span className="lp-cosmos-row-main"><b>{x.name}</b><small>{x.projectIds.length ? cosmosPlural(x.projectIds.length, "projet") + " · " + cosmosPlural(x.stats.total, "tâche") : "Aucun projet"}</small></span>
              </button>
            </li>
          ))}
        </ul>
      </>
    );
  }
  return (
    <aside className="lp-cosmos-panel" aria-label="Synthèse">
      <button type="button" className="lp-icon-btn lp-cosmos-panel-close" aria-label="Masquer la synthèse" onClick={onClose}><X size={16} /></button>
      <div className="lp-cosmos-panel-body">{body}</div>
      <p className="lp-cosmos-hint"><CircleDot size={13} /> Clic : sélectionner · re-clic ou double-clic : entrer · molette : zoomer · Échap : remonter</p>
    </aside>
  );
}

// Tiroir du rail : Dossiers (index complet), Favoris Nexora, Récents (cette visite).
function CosmosDrawer({ mode, model, favorites, recents, onReveal, onClose }) {
  let items = [];
  if (mode === "folders") {
    model.galaxies.forEach((g) => {
      items.push({ key: "g" + g.id, kind: "galaxy", id: g.id, label: g.name, sub: g.projectIds.length ? cosmosPlural(g.projectIds.length, "projet") : "Aucun projet", color: g.color, depth: 0 });
      g.direct.forEach((pid) => items.push({ key: "p" + pid, kind: "planet", id: pid, label: model.planets[pid].name, sub: cosmosPlural(model.planets[pid].taskIds.length, "tâche"), color: model.planets[pid].color, depth: 1 }));
      g.amas.forEach((a) => {
        items.push({ key: "a" + a.id, kind: "galaxy", id: g.id, label: a.name, sub: "Amas", color: a.color, depth: 1 });
        a.projectIds.forEach((pid) => items.push({ key: "p" + pid, kind: "planet", id: pid, label: model.planets[pid].name, sub: cosmosPlural(model.planets[pid].taskIds.length, "tâche"), color: model.planets[pid].color, depth: 2 }));
      });
    });
  } else if (mode === "favorites") {
    items = (favorites || []).map((f) => {
      if (f.type === "project" && model.planets[f.id]) return { key: "p" + f.id, kind: "planet", id: f.id, label: model.planets[f.id].name, sub: "Projet", color: model.planets[f.id].color, depth: 0 };
      if (f.type === "task" && model.satellites[f.id]) return { key: "t" + f.id, kind: "task", id: f.id, label: f.label, sub: "Tâche", color: f.color, depth: 0 };
      return null;
    }).filter(Boolean);
  } else items = recents;
  const title = { folders: "Dossiers", favorites: "Favoris", recents: "Récents" }[mode];
  return (
    <div className="lp-cosmos-drawer" role="dialog" aria-label={title}>
      <div className="lp-cosmos-drawer-head"><strong>{title}</strong><button type="button" className="lp-icon-btn" aria-label="Fermer" onClick={onClose}><X size={15} /></button></div>
      {items.length === 0 && <p className="lp-carte-muted lp-cosmos-small" style={{ padding: "0 12px" }}>{mode === "favorites" ? "Aucun projet ni tâche en favori. Ajoutez-en depuis la barre latérale ou une fiche." : "Rien pour l'instant : les objets visités pendant cette exploration s'affichent ici."}</p>}
      <ul className="lp-cosmos-list">
        {items.slice(0, 400).map((it) => (
          <li key={it.key}>
            <button type="button" className="lp-cosmos-row" style={{ paddingLeft: 10 + it.depth * 14 }} onClick={() => onReveal(it.kind, it.id)}>
              <span className={"lp-cosmos-orb" + (it.kind === "galaxy" && it.depth === 0 ? " is-sun" : "")} style={{ "--c": it.color }} />
              <span className="lp-cosmos-row-main"><span className="lp-cosmos-ellipsis">{it.label}</span><small>{it.sub}</small></span>
            </button>
          </li>
        ))}
      </ul>
    </div>
  );
}

function CosmosFallback({ reason, model, norm, onOpen, onRetry }) {
  return (
    <div className="lp-carte-fallback lp-cosmos-fallback">
      <p className="lp-carte-fallback-lead"><AlertTriangle size={16} /> {reason === "nowebgl"
        ? "L'univers 3D n'est pas disponible sur cet appareil (WebGL désactivé ou non pris en charge). Voici les mêmes dossiers, projets et tâches sous forme de liste."
        : "L'univers 3D n'a pas pu être chargé (connexion interrompue ?). Voici les mêmes dossiers, projets et tâches sous forme de liste."}
        {onRetry && <button type="button" className="lp-btn" onClick={onRetry}><RefreshCw size={13} /> Réessayer</button>}
      </p>
      {model.galaxies.map((g) => (
        <details key={g.id} className="lp-carte-fallback-proj" open={model.galaxies.length <= 3}>
          <summary><Folder size={13} /> {g.name}<span className="lp-carte-muted"> · {g.projectIds.length ? cosmosPlural(g.projectIds.length, "projet") : "aucun projet"}</span></summary>
          {g.projectIds.map((pid) => {
            const p = model.planets[pid];
            return (
              <details key={pid} className="lp-cosmos-fallback-planet">
                <summary><span className="lp-carte-dot" style={{ background: p.color }} />{p.name}<span className="lp-carte-muted"> · {p.stats.pct} % terminé{p.amasName ? " · " + p.amasName : ""}</span></summary>
                <ul>{p.taskIds.map((id) => norm.taskById[id]).filter(Boolean).map((t) => <li key={t.id}><button type="button" className="lp-carte-link-inline" onClick={() => onOpen(t.id)}>{t.title}</button> <span className="lp-carte-muted">{t.statusName}{t.overdue ? " · en retard" : ""}</span></li>)}</ul>
              </details>
            );
          })}
        </details>
      ))}
    </div>
  );
}

// Widget « Cosmos (complet) » (#439) : la vue Cosmos intégrale dans un tableau
// de bord (trois échelles, recherche, tiroir, filtres, fiche de tâche). Ses
// réglages (Affichage, filtres, criticité, synthèse) vivent dans la
// configuration DU widget : ils survivent au rechargement et suivent le widget
// quand on le duplique. En dessous de ~520 × 380 px, un bandeau invite à
// agrandir le widget.
const COSMOS_WIDGET_MIN_W = 520;
const COSMOS_WIDGET_MIN_H = 380;
function WidgetEmbedCosmos({ widget, tasks, ctx, onOpen, onUpdateWidget, onUpdateTask, onToggleDone, favorites }) {
  // La synthèse est repliée par défaut : la place est comptée.
  const stored = widget && widget.cosmosPrefs && typeof widget.cosmosPrefs === "object" ? widget.cosmosPrefs : { panel: false };
  const [local, setLocal] = useState(stored);
  useEffect(() => { setLocal(stored); }, [JSON.stringify(stored)]); // eslint-disable-line react-hooks/exhaustive-deps
  const setPrefs = (patch) => {
    const next = { ...local, ...(typeof patch === "function" ? patch(local) : patch) };
    setLocal(next);
    if (onUpdateWidget) onUpdateWidget({ cosmosPrefs: next });
  };
  return (
    <div className="lp-widget-embed lp-widget-embed-cosmos">
      <CosmosView tasks={tasks} tasksWithDone={tasks} ctx={ctx} onOpen={onOpen} prefs={local} setPrefs={setPrefs}
        onUpdateTask={onUpdateTask} onToggleDone={onToggleDone} favorites={favorites} embedded />
    </div>
  );
}

function CosmosView({ tasks, tasksWithDone, ctx, onOpen, prefs, setPrefs, onUpdateTask, onToggleDone, favorites, toolbarSlot, embedded }) {
  const cfg = normalizeCosmosViewPrefs(prefs);
  const stageRef = useRef(null);
  const glRef = useRef(null);
  const engineRef = useRef(null);
  const searchRef = useRef(null);
  const [status, setStatus] = useState("loading");
  const [attempt, setAttempt] = useState(0);
  const [nav, setNav] = useState({ level: "universe", galaxyId: null, planetId: null });
  const [selected, setSelected] = useState(null);
  const [quality, setQualityLabel] = useState("");
  const [query, setQuery] = useState("");
  const [filtersOpen, setFiltersOpen] = useState(false);
  const [drawer, setDrawer] = useState(null);
  const [recents, setRecents] = useState([]);
  const [preview, setPreview] = useState(null);
  const [yaw, setYaw] = useState(0.35);
  const [narrowScreen] = useState(() => !!(window.matchMedia && window.matchMedia("(max-width: 767px)").matches));
  // Intégrée dans un widget (#439), la vue se règle sur la taille DU widget.
  const [box, setBox] = useState({ w: 0, h: 0 });
  const narrow = embedded ? (box.w > 0 && box.w < 768) : narrowScreen;
  const small = embedded && box.w > 0 && (box.w < COSMOS_WIDGET_MIN_W || box.h < COSMOS_WIDGET_MIN_H);
  const [panelMobile, setPanelMobile] = useState(false);
  const panelOn = narrow ? panelMobile : cfg.panel;
  const setPanelOn = (on) => (narrow ? setPanelMobile(on) : setPrefs({ panel: on }));

  // Toutes les tâches servent à la disposition (un filtre ne déplace rien) ;
  // les filtres décident seulement de ce qui est dessiné.
  const allTasks = ctx.tasks || tasks || [];
  const norm = useMemo(() => {
    const n = carteNormalize(ctx, allTasks);
    n.taskById = {};
    n.tasks.forEach((t) => { n.taskById[t.id] = t; });
    return n;
  }, [allTasks, ctx.projects, ctx.projectFolders, ctx.statuses, ctx.taskTypes, ctx.teamMembers, ctx.milestoneTypes]);
  const themeOverrides = carteThemeOverrides(ctx.projectFolders, {});
  const model = useMemo(() => cosmosBuild(ctx, norm, { memory: readCosmosMemory(), themeOverrides }),
    // eslint-disable-next-line react-hooks/exhaustive-deps
    [norm, ctx.projectFolders, JSON.stringify(themeOverrides)]);
  useEffect(() => { writeCosmosMemory(model.memory); }, [model]);
  const generalFilter = cfg.filter ? { ...widgetDefaultFilter(), ...cfg.filter } : null;
  const filterCount = generalFilter ? activeWidgetFilterCount(generalFilter) : 0;
  const visible = useMemo(() => {
    const pageScope = tasksWithDone || tasks || [];
    const scoped = generalFilter ? applyWidgetFilter(pageScope, generalFilter, ctx) : pageScope;
    const scope = new Set(scoped.map((t) => t.id));
    const set = new Set();
    norm.tasks.forEach((t) => { if (scope.has(t.id) && carteMatches(t, cfg)) set.add(t.id); });
    return set;
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [norm, tasks, tasksWithDone, cfg.crit, cfg.hideOldDone, JSON.stringify(cfg.filter), ctx]);
  const dimmed = useMemo(() => {
    const d = carteDimmedProjects(norm.tasks, visible);
    if (d.has("__terre-inconnue__")) { d.delete("__terre-inconnue__"); d.add(COSMOS_ORPHAN_PROJECT); }
    return d;
  }, [norm, visible]);

  // Hauteur : tout l'espace sous la barre d'outils, sans défilement de page.
  useLayoutEffect(() => {
    const el = stageRef.current;
    if (!el) return undefined;
    if (embedded) {
      const ro = new ResizeObserver(() => { const r = el.getBoundingClientRect(); setBox((b) => (Math.round(r.width) === b.w && Math.round(r.height) === b.h ? b : { w: Math.round(r.width), h: Math.round(r.height) })); });
      ro.observe(el);
      return () => ro.disconnect();
    }
    const fit = () => {
      const top = el.getBoundingClientRect().top;
      const bar = document.querySelector(".lp-mobile-tabbar");
      const barH = bar && bar.getBoundingClientRect().height && getComputedStyle(bar).display !== "none" ? bar.getBoundingClientRect().height : 0;
      el.style.height = Math.max(380, window.innerHeight - Math.max(0, top) - barH - 12) + "px";
    };
    fit();
    window.addEventListener("resize", fit);
    return () => window.removeEventListener("resize", fit);
  }, []);

  const remember = useCallback((kind, id) => {
    setRecents((prev) => {
      const key = kind + ":" + id;
      const label = kind === "galaxy" ? (model.galaxyById[id] || {}).name : kind === "planet" ? (model.planets[id] || {}).name : (norm.taskById[id] || {}).title;
      const color = kind === "galaxy" ? (model.galaxyById[id] || {}).color : kind === "planet" ? (model.planets[id] || {}).color : (norm.taskById[id] || {}).statusColor;
      if (!label) return prev;
      return [{ key, kind, id, label, sub: { galaxy: "Dossier", planet: "Projet", task: "Tâche" }[kind], color, depth: 0 }, ...prev.filter((r) => r.key !== key)].slice(0, 15);
    });
  }, [model, norm]);

  useEffect(() => {
    if (!carteWebglAvailable()) { setStatus("nowebgl"); return undefined; }
    let cancelled = false;
    setStatus("loading");
    loadCarteThree().then((THREE) => {
      if (cancelled || !glRef.current) return;
      try {
        engineRef.current = createCosmosEngine(THREE, glRef.current, {
          keyTarget: stageRef.current,
          quality: cfg.quality,
          animate: cfg.animate,
          obstacles: () => (stageRef.current ? [...stageRef.current.querySelectorAll(".lp-cosmos-hud > *, .lp-cosmos-rail, .lp-cosmos-drawer, .lp-cosmos-panel, .lp-carte-detail, .lp-cosmos-legend, .lp-cosmos-ctrls, .lp-cosmos-compass, .lp-cosmos-panel-toggle, .lp-cosmos-quality, .lp-cosmos-recenter, .lp-carte-small-hint")].map((e) => e.getBoundingClientRect()) : []),
          onSelect: (sel) => setSelected(sel),
          onLevel: (n) => setNav(n),
          onQuality: (q) => setQualityLabel(q),
        });
        setStatus("ready");
      } catch (e) {
        console.error("[Nexora Cosmos]", e);
        setStatus("nowebgl");
      }
    }).catch((e) => { console.error("[Nexora Cosmos] three.js", e); if (!cancelled) setStatus("error"); });
    return () => { cancelled = true; if (engineRef.current) { engineRef.current.dispose(); engineRef.current = null; } };
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [attempt]);
  useEffect(() => {
    if (status === "ready" && engineRef.current) engineRef.current.setData({ model, norm, visible, dimmed });
  }, [status, model, norm, visible, dimmed]);
  useEffect(() => { if (status === "ready" && engineRef.current) engineRef.current.setPreview(preview); }, [status, preview]);
  useEffect(() => { if (status === "ready" && engineRef.current) engineRef.current.setQuality(cfg.quality); }, [status, cfg.quality]);
  useEffect(() => { if (status === "ready" && engineRef.current) engineRef.current.setAnimate(cfg.animate); }, [status, cfg.animate]);
  useEffect(() => { if (selected) remember(selected.kind, selected.id); }, [selected, remember]);
  useEffect(() => { if (nav.planetId) remember("planet", nav.planetId); else if (nav.galaxyId) remember("galaxy", nav.galaxyId); }, [nav, remember]);
  // Boussole : suit l'orientation de la caméra (lecture seule, 4 fois par seconde).
  useEffect(() => {
    if (status !== "ready") return undefined;
    const id = setInterval(() => { const e = engineRef.current; if (e && e.yaw) setYaw(e.yaw()); }, 250);
    return () => clearInterval(id);
  }, [status]);
  // La scène se décale pour que l'objet visé ne passe pas sous le panneau.
  useEffect(() => {
    const e = engineRef.current, stage = stageRef.current;
    if (status !== "ready" || !e || !stage) return undefined;
    const update = () => {
      const side = stage.querySelector(".lp-carte-detail, .lp-cosmos-panel");
      if (!side) { e.setViewOffset(0, 0); return; }
      const sr = stage.getBoundingClientRect(), r = side.getBoundingClientRect();
      if (r.width >= sr.width * 0.8) e.setViewOffset(0, Math.min(r.height, sr.height * 0.6) / 2);
      else e.setViewOffset(r.width / 2, 0);
    };
    update();
    const ro = new ResizeObserver(update);
    ro.observe(stage);
    const side = stage.querySelector(".lp-carte-detail, .lp-cosmos-panel");
    if (side) ro.observe(side);
    return () => ro.disconnect();
  });

  const engine = () => engineRef.current;
  const openFiche = (id) => { const raw = allTasks.find((t) => t.id === id); if (raw) onOpen(raw); };
  const reveal = (kind, id) => { const e = engine(); if (e) e.reveal(kind, id); setQuery(""); setDrawer(null); if (stageRef.current) stageRef.current.focus({ preventScroll: true }); };
  const enter = (kind, id) => { const e = engine(); if (!e) return; if (kind === "galaxy") e.enterGalaxy(id); else e.enterPlanet(id); };
  const suggestions = useMemo(() => cosmosSearch(model, norm, query, 10), [model, norm, query]);
  const favItems = useMemo(() => (favorites || []).map((f) => (f.type === "task" && norm.taskById[f.id] ? { ...f, label: norm.taskById[f.id].title, color: norm.taskById[f.id].statusColor } : f)), [favorites, norm]);

  const empty = model.galaxies.length === 0;
  const selTask = selected && selected.kind === "task" ? norm.taskById[selected.id] : null;
  const selRaw = selTask ? allTasks.find((t) => t.id === selTask.id) : null;
  // Tâche d'un calendrier public synchronisé : reconstruite à chaque
  // synchronisation, une modification locale serait perdue.
  const lockReason = selRaw && selRaw.syncedCalendarImported ? CARTE_SYNCED_LOCK_REASON : null;
  const projectIndex = useMemo(() => {
    const out = {};
    Object.keys(model.planets).forEach((pid) => { const p = model.planets[pid]; out[pid === COSMOS_ORPHAN_PROJECT ? "__terre-inconnue__" : pid] = { id: pid, name: p.name, color: p.color, folderName: (model.galaxyById[p.galaxyId] || {}).name }; });
    return { projectById: out, themes: {} };
  }, [model]);
  const summaryTarget = selected && selected.kind !== "task" ? selected
    : nav.level === "planet" ? { kind: "planet", id: nav.planetId }
    : nav.level === "galaxy" ? { kind: "galaxy", id: nav.galaxyId } : { kind: "universe" };
  const g = nav.galaxyId && model.galaxyById[nav.galaxyId];
  const pNav = nav.planetId && model.planets[nav.planetId];
  const legendStatuses = useMemo(() => {
    const seen = new Set(), out = [];
    norm.tasks.forEach((t) => { if (!seen.has(t.statusName)) { seen.add(t.statusName); out.push([t.statusName, t.statusColor]); } });
    return out.slice(0, 7);
  }, [norm]);

  return (
    <section className={"lp-carte-view lp-cosmos-view" + (embedded ? " is-embedded" : "")} aria-label="Cosmos">
      <ViewToolbarPortal slot={toolbarSlot} />
      <div className="lp-carte-toolbar">
        <div className="lp-carte-search lp-cosmos-search" ref={searchRef}>
          <Search size={14} />
          <input type="search" value={query} placeholder="Aller à…" aria-label="Rechercher un dossier, un projet ou une tâche dans Cosmos" onChange={(e) => setQuery(e.target.value)}
            onKeyDown={(e) => { if (e.key === "Enter" && suggestions[0]) reveal(suggestions[0].kind, suggestions[0].id); if (e.key === "Escape") setQuery(""); }} />
          {suggestions.length > 0 && (
            <ul className="lp-carte-sugg lp-cosmos-sugg" role="listbox" aria-label="Résultats" style={searchRef.current ? (() => { const r = searchRef.current.getBoundingClientRect(); return { position: "fixed", left: Math.max(8, Math.min(r.left, window.innerWidth - 328)), top: r.bottom + 4 }; })() : undefined}>
              {suggestions.map((s) => (
                <li key={s.kind + s.id + s.label}><button type="button" onClick={() => reveal(s.kind, s.id)}>
                  <span className={"lp-cosmos-orb" + (s.kind === "galaxy" ? " is-sun" : s.kind === "task" ? " is-sat" : "")} style={{ "--c": s.color }} />
                  <span className="lp-cosmos-row-main"><span className="lp-cosmos-ellipsis">{s.label}</span><small>{s.sub}</small></span>
                </button></li>
              ))}
            </ul>
          )}
        </div>
        <button type="button" className={"lp-btn" + (filterCount ? " lp-btn-primary" : "")} onClick={() => setFiltersOpen(true)}><Filter size={13} /> Filtres{filterCount > 0 ? " (" + filterCount + ")" : ""}</button>
        <select className="lp-carte-select" aria-label="Criticité" value={cfg.crit} onChange={(e) => setPrefs({ crit: e.target.value })}>
          <option value="all">Toute criticité</option><option value="urgent">Urgentes</option><option value="moyen">Moyennes</option><option value="bas">Basses</option>
        </select>
        <DropdownButton label="Affichage" icon={<SlidersHorizontal size={13} />} title="Qualité graphique, animation et historique">
          <label className="lp-checkbox-line"><input type="checkbox" checked={cfg.animate} onChange={(e) => setPrefs({ animate: e.target.checked })} /> Orbites animées (effet visuel seulement)</label>
          <label className="lp-checkbox-line"><input type="checkbox" checked={cfg.hideOldDone} onChange={(e) => setPrefs({ hideOldDone: e.target.checked })} /> Masquer les tâches terminées depuis plus de 30 jours</label>
          <hr className="lp-divider" style={{ margin: "6px 0" }} />
          <div className="lp-carte-quality" role="group" aria-label="Qualité graphique">
            {COSMOS_QUALITIES.map((q) => <button key={q} type="button" className={"lp-btn" + (cfg.quality === q ? " lp-btn-primary" : "")} onClick={() => setPrefs({ quality: q })}>{{ auto: "Auto", high: "Haute", medium: "Moyenne", low: "Basse" }[q]}</button>)}
          </div>
        </DropdownButton>
        <button type="button" className="lp-btn" onClick={() => { const e = engine(); if (e) e.universe(); }} disabled={status !== "ready"}><Maximize2 size={13} /> Vue d'ensemble</button>
        <button type="button" className="lp-btn lp-btn-primary" onClick={() => { const e = engine(); if (e) e.recenter(); }} disabled={status !== "ready"}><Crosshair size={13} /> Recentrer</button>
      </div>

      <div ref={stageRef} className={"lp-cosmos-stage" + (selTask || (panelOn && status === "ready") ? " has-panel" : "")} tabIndex={0}
        data-cosmos-status={status} data-cosmos-level={nav.level} data-cosmos-galaxy={nav.galaxyId || ""} data-cosmos-planet={nav.planetId || ""}
        data-cosmos-selected={selected ? selected.kind + ":" + selected.id : ""} data-cosmos-quality={quality}
        aria-label="Univers Cosmos. Cliquer pour sélectionner, re-cliquer ou double-cliquer pour entrer, molette pour zoomer, Échap pour remonter, flèches pour pivoter, C pour recentrer.">
        {small && status === "ready" && !empty && <div className="lp-carte-small-hint" role="note">Agrandissez le widget pour explorer l'univers confortablement.</div>}
        {empty ? (
          <div className="lp-empty lp-carte-empty">
            <strong>L'univers est vide.</strong>
            <span>Créez un dossier ou un projet : chaque dossier deviendra une galaxie, chaque projet une planète et chaque tâche un satellite.</span>
          </div>
        ) : (status === "nowebgl" || status === "error") ? (
          <CosmosFallback reason={status} model={model} norm={norm} onOpen={openFiche} onRetry={status === "error" ? () => setAttempt((a) => a + 1) : null} />
        ) : (
          <>
            <div ref={glRef} className="lp-cosmos-gl" />
            {status === "loading" && <div className="lp-carte-loading lp-cosmos-loading" role="status"><div className="lp-skeleton lp-carte-skeleton" />Chargement de l'univers 3D…</div>}
            {status === "ready" && (
              <>
                <nav className="lp-cosmos-rail" aria-label="Explorer">
                  {[["explore", "Explorer", <Orbit size={19} key="i" />], ["folders", "Dossiers", <Folder size={19} key="i" />], ["favorites", "Favoris", <Star size={19} key="i" />], ["recents", "Récents", <History size={19} key="i" />]].map(([k, label, icon]) => (
                    <button key={k} type="button" className={(k === "explore" ? !drawer : drawer === k) ? "is-on" : ""} aria-pressed={k === "explore" ? !drawer : drawer === k} onClick={() => setDrawer(k === "explore" || drawer === k ? null : k)}>{icon}<span>{label}</span></button>
                  ))}
                </nav>
                {drawer && <CosmosDrawer mode={drawer} model={model} favorites={favItems} recents={recents} onReveal={reveal} onClose={() => setDrawer(null)} />}
                <div className="lp-cosmos-hud">
                  <nav className="lp-cosmos-crumbs" aria-label="Fil d'Ariane">
                    {nav.level !== "universe" && <button type="button" className="lp-cosmos-back" onClick={() => engine() && engine().levelUp()} aria-label="Remonter d'une échelle"><ChevronLeft size={15} /></button>}
                    <button type="button" onClick={() => engine() && engine().universe()} aria-current={nav.level === "universe" ? "page" : undefined}><Layers size={13} /> Univers</button>
                    {g && <><ChevronRight size={13} aria-hidden="true" /><button type="button" onClick={() => engine() && engine().enterGalaxy(g.id)} aria-current={nav.level === "galaxy" ? "page" : undefined}>{g.name}</button></>}
                    {pNav && <><ChevronRight size={13} aria-hidden="true" /><button type="button" aria-current="page" onClick={() => engine() && engine().enterPlanet(pNav.id)}>{pNav.name}</button></>}
                  </nav>
                  <div className="lp-cosmos-scale" role="group" aria-label="Échelle">
                    {COSMOS_LEVELS.map(([k, label]) => {
                      const target = k === "galaxy" ? (nav.galaxyId || (selected && selected.kind === "galaxy" ? selected.id : null)) : k === "planet" ? (nav.planetId || (selected && selected.kind === "planet" ? selected.id : null)) : "u";
                      const icon = k === "universe" ? <Layers size={14} /> : k === "galaxy" ? <Orbit size={14} /> : <Crosshair size={14} />;
                      return <button key={k} type="button" aria-pressed={nav.level === k} disabled={!target} title={!target ? "Sélectionnez d'abord " + (k === "galaxy" ? "un dossier" : "un projet") : undefined}
                        onClick={() => { const e = engine(); if (!e) return; if (k === "universe") e.universe(); else if (k === "galaxy") e.enterGalaxy(target); else e.enterPlanet(target); }}>{icon}{label}</button>;
                    })}
                  </div>
                </div>
                <div className="lp-cosmos-compass" aria-hidden="true">
                  <div className="lp-cosmos-rose"><span className="is-n">N</span><span className="is-s">S</span><span className="is-o">O</span><span className="is-e">E</span><i style={{ transform: "translate(-50%,-50%) rotate(" + Math.round(-yaw * 57.3) + "deg)" }} /></div>
                </div>
                <button type="button" className="lp-btn lp-cosmos-recenter" onClick={() => engine() && engine().recenter()}><Crosshair size={14} /> Recentrer</button>
                <div className="lp-cosmos-ctrls" role="group" aria-label="Zoom">
                  <button type="button" className="lp-icon-btn" aria-label="Recentrer" onClick={() => engine().recenter()}><Target size={16} /></button>
                  <button type="button" className="lp-icon-btn" aria-label="Zoomer" onClick={() => engine().zoomBy(0.8)}><Plus size={16} /></button>
                  <button type="button" className="lp-icon-btn" aria-label="Dézoomer" onClick={() => engine().zoomBy(1.25)}><Minus size={16} /></button>
                </div>
                <div className="lp-cosmos-legend" aria-label="Légende">
                  <span><i className="is-sun" />Dossier = galaxie</span>
                  <span><i className="is-planet" />Projet = planète</span>
                  {legendStatuses.map(([name, color]) => <span key={name}><i className="is-cube" style={{ background: color }} />{name}</span>)}
                  <span><i className="is-urgent" />Urgente</span>
                  <span><i className="is-late" />En retard</span>
                </div>
                {quality && <span className="lp-cosmos-quality">Qualité {({ high: "haute", medium: "moyenne", low: "basse" })[quality]}{cfg.quality === "auto" ? " (auto)" : ""}</span>}
              </>
            )}
            {status === "ready" && !selTask && panelOn && (
              <CosmosSummary model={model} norm={norm} visible={visible} target={summaryTarget} level={nav.level}
                onReveal={reveal} onEnter={enter} onSelectTask={(id) => reveal("task", id)} onClose={() => setPanelOn(false)} />
            )}
            {status === "ready" && !selTask && !panelOn && (
              <button type="button" className="lp-cosmos-panel-toggle" onClick={() => setPanelOn(true)}>Synthèse</button>
            )}
            {selTask && (
              <CarteTaskDetail task={preview && preview.id === selTask.id ? { ...selTask, progress: preview.progress } : selTask} raw={selRaw} norm={norm} layout={projectIndex} ctx={ctx} onOpen={openFiche}
                onGo={(id) => reveal("task", id)} onWalk={(id) => reveal("task", id)} walkLabel="Centrer"
                worldText={"Dans Cosmos : satellite de « " + ((model.planets[model.satellites[selTask.id] ? model.satellites[selTask.id].planetId : ""] || {}).name || "") + " ». Sa couleur suit le statut ; ses panneaux se déploient avec l'avancement."}
                lockReason={lockReason}
                onUpdate={onUpdateTask && !lockReason ? (patch) => onUpdateTask(selTask.id, patch) : null} onPreview={setPreview} onToggleDone={lockReason ? null : onToggleDone}
                onClose={() => engine() && engine().select(null)} />
            )}
          </>
        )}
      </div>
      {filtersOpen && (
        <Modal title="Filtrer Cosmos" onClose={() => setFiltersOpen(false)} wide footer={<>
          <button type="button" className="lp-btn" onClick={() => setPrefs({ filter: null })} disabled={!filterCount}>Tout afficher</button>
          <button type="button" className="lp-btn lp-btn-primary" onClick={() => setFiltersOpen(false)}>Terminé</button>
        </>}>
          <p className="lp-carte-muted" style={{ marginTop: 0 }}>Le même filtre que partout ailleurs dans Nexora. Les tâches écartées disparaissent de l'univers ; les galaxies et les planètes ne bougent pas.</p>
          <TaskFilterFields filter={generalFilter || widgetDefaultFilter()} setFilter={(next) => setPrefs({ filter: typeof next === "function" ? next(generalFilter || widgetDefaultFilter()) : next })} ctx={ctx} />
        </Modal>
      )}
    </section>
  );
}

// Widget « Timeline 3D (complet) » (#454) : la vue Timeline 3D intégrale dans
// un tableau de bord, avec son propre choix Grande Ligne / Cabine. Ses
// réglages vivent dans la configuration DU widget : ils survivent au
// rechargement et suivent le widget quand on le duplique.
const T3D_WIDGET_MIN_W = 520;
const T3D_WIDGET_MIN_H = 380;
function WidgetEmbedTimeline3d({ widget, tasks, ctx, onOpen, onUpdateWidget, onUpdateTask, onToggleDone }) {
  // Le tableau des départs est replié par défaut : la place est comptée.
  const stored = widget && widget.timeline3dPrefs && typeof widget.timeline3dPrefs === "object" ? widget.timeline3dPrefs : { board: false };
  const [local, setLocal] = useState(stored);
  useEffect(() => { setLocal(stored); }, [JSON.stringify(stored)]); // eslint-disable-line react-hooks/exhaustive-deps
  const setPrefs = (patch) => {
    const next = { ...local, ...(typeof patch === "function" ? patch(local) : patch) };
    setLocal(next);
    if (onUpdateWidget) onUpdateWidget({ timeline3dPrefs: next });
  };
  return (
    <div className="lp-widget-embed lp-widget-embed-t3d">
      <Timeline3DView tasks={tasks} tasksWithDone={tasks} ctx={ctx} onOpen={onOpen} prefs={local} setPrefs={setPrefs}
        onUpdateTask={onUpdateTask} onToggleDone={onToggleDone} embedded />
    </div>
  );
}

const t3dDate = (d) => { const x = new Date(); x.setHours(0, 0, 0, 0); x.setDate(x.getDate() + d); return x.toLocaleDateString("fr-FR", { weekday: "short", day: "numeric", month: "short" }); };
const T3D_SIGNALS = [["#2fd36b", "Signal vert : à venir"], ["#eaf6ff", "Blanc clignotant : en cours"], ["#ffab2e", "Orange : attente d'un tiers"], ["#ff3b30", "Rouge clignotant : en retard"], ["#555b63", "Éteint : terminée"]];

function Timeline3dBadge({ line }) {
  return <span className="lp-t3d-badge" style={{ "--c": line.color }} aria-hidden="true">{line.n}</span>;
}

// Repli sans WebGL : le même réseau en liste, ligne par ligne.
function Timeline3dFallback({ reason, model, onOpen, onRetry }) {
  return (
    <div className="lp-t3d-fallback" role="region" aria-label="Réseau en liste">
      <p className="lp-carte-muted" style={{ marginTop: 0 }}>
        {reason === "error" ? "Le moteur 3D n'a pas pu être chargé." : "La 3D n'est pas disponible sur cet appareil."} Voici le même réseau, ligne par ligne.
        {onRetry && <> <button type="button" className="lp-btn" onClick={onRetry}><RefreshCw size={13} /> Réessayer</button></>}
      </p>
      {model.lines.map((l) => (
        <details key={l.id} open={l.n <= 3}>
          <summary><Timeline3dBadge line={l} />{l.name}<span className="lp-carte-muted"> · {l.folderName}</span></summary>
          <ul>
            {l.stations.map((id) => { const x = model.stationById[id]; return (
              <li key={id}><button type="button" onClick={() => onOpen(id)}>{timeline3dRel(x.e)} · {x.title}{x.late ? " · en retard" : x.st === "done" ? " · terminée" : ""}</button></li>
            ); })}
          </ul>
        </details>
      ))}
    </div>
  );
}

// Vue Timeline 3D (#454) : projets en lignes, tâches en stations posées à leur
// échéance, échelle de temps linéaire. Deux rendus au choix, « Grande Ligne »
// et « Cabine ». Lecture seule, comme la Carte et le Cosmos : les
// modifications passent par la fiche Nexora ou le volet de détail partagé.
function Timeline3DView({ tasks, tasksWithDone, ctx, onOpen, prefs, setPrefs, onUpdateTask, onToggleDone, toolbarSlot, embedded }) {
  const cfg = normalizeTimeline3dViewPrefs(prefs);
  const stageRef = useRef(null);
  const glRef = useRef(null);
  const engineRef = useRef(null);
  const [status, setStatus] = useState("loading");
  const [attempt, setAttempt] = useState(0);
  const [selectedId, setSelectedId] = useState(null);
  const [eng, setEng] = useState({ playing: false, ended: false, driverLineId: null, focus: 0, hud: null });
  const [filtersOpen, setFiltersOpen] = useState(false);
  const [preview, setPreview] = useState(null);
  const [driverLine, setDriverLine] = useState("");
  const [box, setBox] = useState({ w: 0, h: 0 });
  const small = embedded && box.w > 0 && (box.w < T3D_WIDGET_MIN_W || box.h < T3D_WIDGET_MIN_H);

  const allTasks = ctx.tasks || tasks || [];
  const norm = useMemo(() => {
    const n = carteNormalize(ctx, allTasks);
    n.taskById = {};
    n.tasks.forEach((t) => { n.taskById[t.id] = t; });
    return n;
  }, [allTasks, ctx.projects, ctx.projectFolders, ctx.statuses, ctx.taskTypes, ctx.teamMembers, ctx.milestoneTypes]);
  const generalFilter = cfg.filter ? { ...widgetDefaultFilter(), ...cfg.filter } : null;
  const filterCount = generalFilter ? activeWidgetFilterCount(generalFilter) : 0;
  // Tâches retenues par les filtres (bandeau, filtres de la page et de la vue,
  // criticité).
  const visible = useMemo(() => {
    const pageScope = tasksWithDone || tasks || [];
    const scoped = generalFilter ? applyWidgetFilter(pageScope, generalFilter, ctx) : pageScope;
    const scope = new Set(scoped.map((t) => t.id));
    const set = new Set();
    norm.tasks.forEach((t) => { if (scope.has(t.id) && carteMatches(t, cfg)) set.add(t.id); });
    return set;
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [norm, tasks, tasksWithDone, cfg.crit, cfg.hideOldDone, JSON.stringify(cfg.filter), ctx]);
  // #460 : le réseau suit les filtres. Il n'est construit qu'avec les tâches
  // retenues : une ligne sans tâche visible disparaît, et le réseau se recadre
  // sur ce qui reste (auparavant, les filtres masquaient seulement les gares
  // d'un réseau toujours complet, ce qui semblait sans effet).
  const visibleKey = useMemo(() => [...visible].sort().join("|"), [visible]);
  const model = useMemo(() => timeline3dBuild(ctx, { ...norm, tasks: norm.tasks.filter((t) => visible.has(t.id)) }), [norm, visibleKey, ctx.projectFolders]); // eslint-disable-line react-hooks/exhaustive-deps
  // Toutes les tâches placées, filtres ou non : sert au compteur « x sur y ».
  const placeable = useMemo(() => timeline3dBuild(ctx, norm).stations.length, [norm, ctx.projectFolders]); // eslint-disable-line react-hooks/exhaustive-deps

  // Hauteur : tout l'espace sous la barre d'outils, sans défilement de page.
  useLayoutEffect(() => {
    const el = stageRef.current;
    if (!el) return undefined;
    if (embedded) {
      const ro = new ResizeObserver(() => { const r = el.getBoundingClientRect(); setBox((b) => (Math.round(r.width) === b.w && Math.round(r.height) === b.h ? b : { w: Math.round(r.width), h: Math.round(r.height) })); });
      ro.observe(el);
      return () => ro.disconnect();
    }
    const fit = () => {
      const top = el.getBoundingClientRect().top;
      const bar = document.querySelector(".lp-mobile-tabbar");
      const barH = bar && bar.getBoundingClientRect().height && getComputedStyle(bar).display !== "none" ? bar.getBoundingClientRect().height : 0;
      el.style.height = Math.max(380, window.innerHeight - Math.max(0, top) - barH - 12) + "px";
    };
    fit();
    window.addEventListener("resize", fit);
    return () => window.removeEventListener("resize", fit);
  }, []);

  const empty = model.lines.length === 0;
  useEffect(() => {
    if (empty) return undefined;
    if (!carteWebglAvailable()) { setStatus("nowebgl"); return undefined; }
    let cancelled = false;
    setStatus("loading");
    loadCarteThree().then((THREE) => {
      if (cancelled || !glRef.current) return;
      try {
        engineRef.current = createTimeline3dEngine(THREE, glRef.current, {
          keyTarget: stageRef.current,
          mode: cfg.mode, animate: cfg.animate, speed: T3D_SPEEDS[cfg.speed], quality: cfg.quality,
          obstacles: () => (stageRef.current ? [...stageRef.current.querySelectorAll(".lp-t3d-board, .lp-t3d-hud, .lp-t3d-transport, .lp-carte-detail, .lp-carte-small-hint")].map((e) => e.getBoundingClientRect()) : []),
          onSelect: (id) => setSelectedId(id),
          onState: (st) => setEng(st),
        });
        setStatus("ready");
      } catch (e) {
        console.error("[Nexora Timeline 3D]", e);
        setStatus("nowebgl");
      }
    }).catch((e) => { console.error("[Nexora Timeline 3D] three.js", e); if (!cancelled) setStatus("error"); });
    return () => { cancelled = true; if (engineRef.current) { engineRef.current.dispose(); engineRef.current = null; } };
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [attempt, empty]);
  useEffect(() => { if (status === "ready" && engineRef.current) engineRef.current.setData({ model, visible }); }, [status, model, visible]);
  useEffect(() => { if (status === "ready" && engineRef.current) engineRef.current.setMode(cfg.mode); }, [status, cfg.mode]);
  useEffect(() => { if (status === "ready" && engineRef.current) engineRef.current.setAnimate(cfg.animate); }, [status, cfg.animate]);
  useEffect(() => { if (status === "ready" && engineRef.current) engineRef.current.setSpeed(T3D_SPEEDS[cfg.speed]); }, [status, cfg.speed]);
  useEffect(() => { if (status === "ready" && engineRef.current) engineRef.current.setQuality(cfg.quality); }, [status, cfg.quality]);

  const engine = () => engineRef.current;
  const openFiche = (id) => { const raw = allTasks.find((t) => t.id === id); if (raw) onOpen(raw); };
  const goTo = (id) => { const e = engine(); if (e) e.select(id, true); if (stageRef.current) stageRef.current.focus({ preventScroll: true }); };
  const departures = useMemo(() => timeline3dNextDepartures(model, visible, 8), [model, visible]);
  const trainLines = useMemo(() => model.lines.filter((l) => l.end >= 0), [model]);
  const driveLine = driverLine && model.lineById[driverLine] ? driverLine : (trainLines[0] ? trainLines[0].id : "");

  const sel = selectedId ? model.stationById[selectedId] : null;
  const selTask = sel ? norm.taskById[sel.id] : null;
  const selRaw = selTask ? allTasks.find((t) => t.id === selTask.id) : null;
  const lockReason = selRaw && selRaw.syncedCalendarImported ? CARTE_SYNCED_LOCK_REASON : null;
  const nb = sel ? timeline3dNeighbours(model, sel.id) : { prev: null, next: null };
  const projectIndex = useMemo(() => {
    const out = {};
    model.lines.forEach((l) => { out[l.orphan ? "__terre-inconnue__" : l.id] = { id: l.id, name: l.name, color: l.color, folderName: l.folderName }; });
    return { projectById: out, themes: {} };
  }, [model]);
  const hud = eng.hud;
  const hudNext = hud && hud.nextId ? model.stationById[hud.nextId] : null;
  const rail = cfg.mode === "rail";
  const playLabel = eng.playing ? "Pause" : eng.ended ? "Rejouer" : rail ? "Lecture" : "Rouler";
  // #459 : combien de tâches sont réellement posées sur le réseau, sur combien
  // de placables (échéance dans la fenêtre) — un réseau vide se comprend alors
  // d'un coup d'œil (filtres, dates).
  const shownCount = model.stations.length;
  const note = [placeable ? (shownCount === placeable ? shownCount + (shownCount > 1 ? " tâches" : " tâche") : shownCount + " sur " + placeable + " tâches") + " sur le réseau" : "", model.undated ? model.undated + (model.undated > 1 ? " tâches sans échéance" : " tâche sans échéance") : "", model.outside ? model.outside + " hors de la fenêtre (−90 j à +1 an)" : ""].filter(Boolean).join(" · ");

  return (
    <section className={"lp-carte-view lp-t3d-view" + (embedded ? " is-embedded" : "")} aria-label="Timeline 3D">
      <ViewToolbarPortal slot={toolbarSlot} />
      <div className="lp-carte-toolbar">
        <div className="lp-t3d-modes" role="group" aria-label="Rendu">
          {T3D_MODES.map((m) => (
            <button key={m} type="button" aria-pressed={cfg.mode === m} onClick={() => setPrefs({ mode: m })}>
              {m === "rail" ? <TrainFront size={14} /> : <Crosshair size={14} />}{T3D_MODE_LABELS[m]}
            </button>
          ))}
        </div>
        <button type="button" className={"lp-btn" + (filterCount ? " lp-btn-primary" : "")} onClick={() => setFiltersOpen(true)}><Filter size={13} /> Filtres{filterCount > 0 ? " (" + filterCount + ")" : ""}</button>
        <select className="lp-carte-select" aria-label="Criticité" value={cfg.crit} onChange={(e) => setPrefs({ crit: e.target.value })}>
          <option value="all">Toute criticité</option><option value="urgent">Urgentes</option><option value="moyen">Moyennes</option><option value="bas">Basses</option>
        </select>
        <DropdownButton label="Affichage" icon={<SlidersHorizontal size={13} />} title="Animations, tableau des départs, qualité et légende">
          <label className="lp-checkbox-line"><input type="checkbox" checked={cfg.animate} onChange={(e) => setPrefs({ animate: e.target.checked })} /> Animations (trains, fumée, voitures, nuages)</label>
          <label className="lp-checkbox-line"><input type="checkbox" checked={cfg.board} onChange={(e) => setPrefs({ board: e.target.checked })} /> Tableau « Prochains départs »</label>
          <label className="lp-checkbox-line"><input type="checkbox" checked={cfg.hideOldDone} onChange={(e) => setPrefs({ hideOldDone: e.target.checked })} /> Masquer les tâches terminées depuis plus de 30 jours</label>
          <hr className="lp-divider" style={{ margin: "6px 0" }} />
          <div className="lp-carte-quality" role="group" aria-label="Qualité graphique">
            {T3D_QUALITIES.map((q) => <button key={q} type="button" className={"lp-btn" + (cfg.quality === q ? " lp-btn-primary" : "")} onClick={() => setPrefs({ quality: q })}>{{ auto: "Auto", high: "Haute", low: "Basse" }[q]}</button>)}
          </div>
          <hr className="lp-divider" style={{ margin: "6px 0" }} />
          <div className="lp-t3d-legend" aria-label="Légende">
            <span><Timeline3dBadge line={{ n: 1, color: "#245edb" }} /> Ligne = projet, station = tâche à son échéance</span>
            {rail ? T3D_SIGNALS.map(([c, t]) => <span key={t}><i style={{ background: c }} />{t}</span>)
              : <><span><i style={{ background: "#fff" }} />Portique = station à venir</span><span><i style={{ background: "#e5484d" }} />Halo rouge : en retard</span><span><i style={{ background: "#9aa5b4" }} />Portique grisé : terminée</span></>}
            <span>{rail ? "Grande gare : jalon · voie de garage : action longue · passerelle : dépendance entre projets · passage à niveau : aujourd'hui" : "Losange : jalon · dérivation : action longue · trait fin : dépendance entre projets · porte bleue : aujourd'hui"}</span>
          </div>
        </DropdownButton>
        {note && <span className="lp-t3d-note">{note}</span>}
      </div>

      <div ref={stageRef} className={"lp-t3d-stage" + (rail ? "" : " is-cabine")} tabIndex={0}
        data-t3d-status={status} data-t3d-mode={cfg.mode} data-t3d-selected={selectedId || ""} data-t3d-playing={eng.playing ? "1" : ""} data-t3d-driver={eng.driverLineId || ""}
        aria-label="Réseau du temps en 3D. Glisser pour tourner, molette pour zoomer ou avancer, flèches pour avancer d'une semaine, espace pour lancer la lecture, Échap pour revenir.">
        {small && status === "ready" && !empty && <div className="lp-carte-small-hint" role="note">Agrandissez le widget pour parcourir le réseau confortablement.</div>}
        {empty ? (
          <div className="lp-empty lp-carte-empty">
            {placeable > 0 ? (
              <>
                <strong>Aucune tâche ne correspond aux filtres.</strong>
                <span>{placeable} {placeable > 1 ? "tâches datées sont masquées" : "tâche datée est masquée"} par les filtres (bandeau, filtres de la page ou de la vue, criticité).</span>
              </>
            ) : (
              <>
                <strong>Aucune tâche datée à placer sur le réseau.</strong>
                <span>Chaque projet devient une ligne et chaque tâche avec une échéance une station, placée à sa date.</span>
              </>
            )}
          </div>
        ) : (status === "nowebgl" || status === "error") ? (
          <Timeline3dFallback reason={status} model={model} onOpen={openFiche} onRetry={status === "error" ? () => setAttempt((a) => a + 1) : null} />
        ) : (
          <>
            <div ref={glRef} className="lp-t3d-gl" />
            {status === "loading" && <div className="lp-carte-loading" role="status"><div className="lp-skeleton lp-carte-skeleton" />Chargement du réseau 3D…</div>}
            {status === "ready" && (
              <>
                {cfg.board && departures.length > 0 && (
                  <aside className="lp-t3d-board" aria-label="Prochains départs">
                    <header><span>Prochains départs</span><span>{new Date().toLocaleTimeString("fr-FR", { hour: "2-digit", minute: "2-digit" })}</span></header>
                    <ol>
                      {departures.map((x) => { const l = model.lineById[x.lineId]; return (
                        <li key={x.id}><button type="button" onClick={() => goTo(x.id)} aria-current={x.id === selectedId ? "true" : undefined}>
                          <span className={"lp-t3d-when" + (x.late ? " is-late" : "")}>{x.late ? "retard" : x.e === 0 ? "auj." : "J+" + x.e}</span>
                          <Timeline3dBadge line={l} />
                          <span className="lp-t3d-ttl">{x.title}</span>
                        </button></li>
                      ); })}
                    </ol>
                  </aside>
                )}
                {hud && (
                  <div className="lp-t3d-hud" role="status" aria-live="polite">
                    <svg width="30" height="30" viewBox="0 0 30 30" aria-hidden="true">
                      <circle cx="15" cy="15" r="13" fill="#fff" stroke="#ffd200" strokeWidth="2" />
                      <path d="M15 15V8" stroke="#0d2b66" strokeWidth="2.4" strokeLinecap="round" transform={"rotate(" + ((((hud.day % 12) + 12) % 12) * 30 + hud.frac * 30) + " 15 15)"} />
                      <path d="M15 15V5" stroke="#c62828" strokeWidth="1.6" strokeLinecap="round" transform={"rotate(" + (hud.frac * 360) + " 15 15)"} />
                    </svg>
                    <div style={{ minWidth: 0 }}>
                      <b>{timeline3dRel(hud.day)}</b><span className="lp-t3d-hud-date">{t3dDate(hud.day)}</span>
                      {hudNext && <div className="lp-t3d-hud-next">Prochain arrêt <Timeline3dBadge line={model.lineById[hudNext.lineId]} /><span>{hudNext.title}</span><em>· {hud.nextIn === 0 ? "à quai" : "dans " + hud.nextIn + " j"}</em></div>}
                    </div>
                  </div>
                )}
                <div className="lp-t3d-transport" role="group" aria-label="Parcourir le temps">
                  <button type="button" className="lp-btn" onClick={() => engine() && engine().step(-7)} aria-label="Reculer d'une semaine"><ChevronLeft size={14} /> 7 j</button>
                  <button type="button" className="lp-btn lp-btn-primary" onClick={() => engine() && engine().today()}>Aujourd'hui</button>
                  <button type="button" className="lp-btn" onClick={() => engine() && engine().step(7)} aria-label="Avancer d'une semaine">7 j <ChevronRight size={14} /></button>
                  <span className="lp-t3d-sep" aria-hidden="true" />
                  <button type="button" className="lp-btn lp-t3d-play" onClick={() => engine() && engine().togglePlay()}>{eng.playing ? <Pause size={14} /> : <Play size={14} />} {playLabel}</button>
                  <select className="lp-t3d-opt" aria-label="Vitesse" value={cfg.speed} onChange={(e) => setPrefs({ speed: e.target.value })}>
                    {Object.keys(T3D_SPEEDS).map((k) => <option key={k} value={k}>{T3D_SPEED_LABELS[k]}</option>)}
                  </select>
                  {rail && trainLines.length > 0 && (
                    <>
                      <span className="lp-t3d-sep" aria-hidden="true" />
                      <button type="button" className="lp-btn" aria-pressed={!!eng.driverLineId}
                        onClick={() => { const e = engine(); if (!e) return; e.driver(eng.driverLineId ? null : (sel && model.lineById[sel.lineId] && sel.lineId) || driveLine); }}>
                        <TrainFront size={14} /> {eng.driverLineId ? "Vue d'ensemble" : "Vue conducteur"}
                      </button>
                      <select className="lp-t3d-opt" aria-label="Train à conduire" value={eng.driverLineId || driveLine}
                        onChange={(e) => { setDriverLine(e.target.value); if (eng.driverLineId && engine()) engine().driver(e.target.value); }}>
                        {trainLines.map((l) => <option key={l.id} value={l.id}>Ligne {l.n} · {l.name}</option>)}
                      </select>
                    </>
                  )}
                  {sel && (
                    <>
                      <span className="lp-t3d-sep lp-t3d-opt" aria-hidden="true" />
                      <button type="button" className="lp-btn lp-t3d-opt" disabled={!nb.prev} onClick={() => nb.prev && goTo(nb.prev)}>← Station précédente</button>
                      <button type="button" className="lp-btn lp-t3d-opt" disabled={!nb.next} onClick={() => nb.next && goTo(nb.next)}>Station suivante →</button>
                    </>
                  )}
                </div>
              </>
            )}
            {selTask && (
              <CarteTaskDetail task={preview && preview.id === selTask.id ? { ...selTask, progress: preview.progress } : selTask} raw={selRaw} norm={norm} layout={projectIndex} ctx={ctx} onOpen={openFiche}
                onGo={goTo} onWalk={goTo} walkLabel="Y aller"
                worldText={"Sur la Timeline 3D : station de la ligne " + (model.lineById[sel.lineId] || {}).n + " « " + ((model.lineById[sel.lineId] || {}).name || "") + " », " + timeline3dRel(sel.e) + (sel.links.length ? ", avec correspondance." : ".")}
                lockReason={lockReason}
                onUpdate={onUpdateTask && !lockReason ? (patch) => onUpdateTask(selTask.id, patch) : null} onPreview={setPreview} onToggleDone={lockReason ? null : onToggleDone}
                onClose={() => engine() && engine().select(null)} />
            )}
          </>
        )}
      </div>
      {filtersOpen && (
        <Modal title="Filtrer la Timeline 3D" onClose={() => setFiltersOpen(false)} wide footer={<>
          <button type="button" className="lp-btn" onClick={() => setPrefs({ filter: null })} disabled={!filterCount}>Tout afficher</button>
          <button type="button" className="lp-btn lp-btn-primary" onClick={() => setFiltersOpen(false)}>Terminé</button>
        </>}>
          <p className="lp-carte-muted" style={{ marginTop: 0 }}>Le même filtre que partout ailleurs dans Nexora. Les tâches écartées disparaissent du réseau ; les lignes ne bougent pas.</p>
          <TaskFilterFields filter={generalFilter || widgetDefaultFilter()} setFilter={(next) => setPrefs({ filter: typeof next === "function" ? next(generalFilter || widgetDefaultFilter()) : next })} ctx={ctx} />
        </Modal>
      )}
    </section>
  );
}

function CalendarViewSettings({ prefs, setPrefs, ctx, onClose }) {
  const filter = { ...widgetDefaultFilter(), ...(prefs.filter || {}) };
  return (
    <Modal title="Réglages de la vue Calendrier" onClose={onClose} wide footer={<button className="lp-btn lp-btn-primary" onClick={onClose}>Terminé</button>}>
      <div className="lp-widget-config-section">
        <div className="lp-widget-config-title"><Settings size={12} /> Affichage</div>
        <div className="lp-field" style={{ maxWidth: 260 }}>
          <label htmlFor="lp-cal-rows">Tâches visibles par case</label>
          <input
            id="lp-cal-rows"
            type="number"
            min={CALENDAR_MIN_ROWS}
            max={CALENDAR_MAX_ROWS}
            value={prefs.rowsPerCell}
            onChange={(e) => setPrefs({ rowsPerCell: normalizeCalendarRows(e.target.value) })}
          />
        </div>
        <label className="lp-checkbox-row">
          <input type="checkbox" checked={prefs.showTimes} onChange={(e) => setPrefs({ showTimes: e.target.checked })} />
          <span style={{ textTransform: "none", fontWeight: 500 }}>Afficher l'heure devant les tâches dans la grille</span>
        </label>
      </div>
      <div className="lp-widget-config-section">
        <div className="lp-widget-config-title"><Search size={12} /> Filtrer les tâches prises en compte</div>
        <p style={{ fontSize: 12, color: "var(--text-600)", marginTop: -6, marginBottom: 8 }}>
          Le même filtre que partout ailleurs. Dans le calendrier, les tâches terminées sont toujours masquées de la grille et toujours visibles dans la frise du jour.
        </p>
        <TaskFilterFields
          filter={filter}
          setFilter={(next) => setPrefs({ filter: typeof next === "function" ? next(filter) : next })}
          ctx={ctx}
        />
      </div>
    </Modal>
  );
}

// La vue n'ajoute qu'une persistance de réglages et le filtre propre à la vue,
// qui resserre ce que la page laisse passer sans s'y substituer. « Exclure les
// terminées » n'y a pas de sens : la grille les masque déjà, la frise doit
// les montrer.
function CalendarView({ tasks, ctx, onOpen, onAdd, prefs, setPrefs, toolbarSlot }) {
  const cfg = normalizeCalendarViewPrefs(prefs);
  const [settingsOpen, setSettingsOpen] = useState(false);
  const viewFilter = cfg.filter ? { ...cfg.filter, excludeDone: false } : null;
  const scoped = useMemo(
    () => (viewFilter ? applyWidgetFilter(tasks || [], viewFilter, ctx) : (tasks || [])),
    // eslint-disable-next-line react-hooks/exhaustive-deps
    [tasks, cfg.filter, ctx]
  );
  const filterCount = viewFilter ? activeWidgetFilterCount(viewFilter) : 0;
  return (
    <section className="lp-cal-view" aria-label="Calendrier">
      <ViewToolbarPortal slot={toolbarSlot} />
      <CalendarBoard
        tasks={scoped}
        ctx={ctx}
        onOpen={onOpen}
        onAdd={onAdd ? (date) => onAdd({ start: date, end: date }) : undefined}
        prefs={cfg}
        headerExtra={(
          <>
            <button type="button" className={"lp-cal-btn" + (filterCount ? " is-active" : "")} onClick={() => setSettingsOpen(true)}>
              <Filter size={14} /><span className="lp-cal-btn-label">Filtres</span>{filterCount > 0 && <span className="lp-cal-badge">{filterCount}</span>}
            </button>
            <button type="button" className="lp-cal-btn lp-cal-btn-icon" aria-label="Réglages de la vue Calendrier" onClick={() => setSettingsOpen(true)}>
              <SlidersHorizontal size={15} />
            </button>
          </>
        )}
      />
      {settingsOpen && <CalendarViewSettings prefs={cfg} setPrefs={setPrefs} ctx={ctx} onClose={() => setSettingsOpen(false)} />}
    </section>
  );
}

// Widget : la même grille en version dense (pastilles par jour) et une frise
// compacte, dans la hauteur de son cadre.
function WidgetCalendar({ tasks, ctx, onOpen }) {
  return <CalendarBoard tasks={tasks} ctx={ctx} onOpen={onOpen} compact />;
}

/* Focus Journée (#333) : le panneau détaillé d'UN SEUL jour, sans la grille
   semaine/mois du Calendrier au-dessus. Il réutilise CalendarDayTimeline TEL
   QUEL — en-tête récap, chips « Journée », hachures des heures creuses et
   frise horaire complète (heure + durée + ligne statut/échéance sous le
   titre) — pour que le Calendrier et Focus Journée ne portent jamais deux
   rendus du même panneau. `compact` (qui allège aussi ces détails visuels
   pour la mini-grille du widget Calendrier) n'a donc rien à faire ici : Focus
   Journée n'a pas de grille à alléger, seul `fit` s'applique, pour que la
   frise se contente de la hauteur du cadre du widget au lieu d'ajouter SON
   PROPRE défilement vertical par-dessus le défilement horizontal déjà porté
   par la frise (retour de test, #333) — une seule barre de défilement à la
   fois. Seule différence de contenu : la date vient de la CONFIGURATION DE
   CE WIDGET (widget.focusDayDate), pas d'une case cliquée dans une grille —
   exactement comme staffingOffset pour Charge personnel. Le bouton
   « Aujourd'hui » et le sélecteur de date sont posés dans l'en-tête du
   widget (barre d'outils fournie par WidgetFrame), à côté des icônes
   d'action déjà existantes. */
function WidgetFocusDay({ widget, tasks, ctx, onOpen, onUpdateWidget, externalToolbarSlot }) {
  const todayIso = iso(new Date());
  const dateIso = normalizeFocusDayDate(widget.focusDayDate);
  const setDate = (next) => onUpdateWidget({ focusDayDate: normalizeFocusDayDate(next) });
  return (
    <>
      <ViewToolbarPortal slot={externalToolbarSlot}>
        <button
          type="button"
          className="lp-tool-btn"
          disabled={dateIso === todayIso}
          onClick={() => setDate(todayIso)}
        >
          Aujourd'hui
        </button>
        <button type="button" className="lp-icon-btn" aria-label="Jour précédent" onClick={() => setDate(addDays(dateIso, -1))}>
          <ChevronLeft size={14} />
        </button>
        <input
          type="date"
          className="lp-focusday-date-input"
          value={dateIso}
          onChange={(e) => e.target.value && setDate(e.target.value)}
          aria-label="Choisir un jour"
        />
        <button type="button" className="lp-icon-btn" aria-label="Jour suivant" onClick={() => setDate(addDays(dateIso, 1))}>
          <ChevronRight size={14} />
        </button>
      </ViewToolbarPortal>
      <CalendarDayTimeline dateIso={dateIso} tasks={tasks} ctx={ctx} onOpen={onOpen} fit />
    </>
  );
}
// ============================================================================
// Module Devis — Quentin Morel Engineering (auto-entrepreneur, prestations
// intellectuelles). Les calculs (numérotation, total, statut effectif) vivent
// derrière NEXORA:QUOTES (part-000, testés en isolation) ; ce fichier ne
// porte que le rendu et la génération du PDF.
// ============================================================================

/* Charte graphique du PDF — palette imposée par le guide de personnalisation
   de Quentin (Bleu QM / Anthracite / Gris de support), indépendante du thème
   d'affichage de l'app (GlobalStyles, part-001) — jsPDF ne peut de toute
   façon pas lire les variables CSS. */
const QUOTE_PDF_COLORS = {
  brand: [0, 74, 173],         // #004AAD — Bleu QM
  ink: [47, 52, 55],           // #2F3437 — Anthracite
  textStrong: [16, 21, 31],    // #10151F
  textMuted: [73, 81, 102],    // #495166
  border: [219, 223, 219],     // #DBDFDB
  white: [255, 255, 255],
  surfaceMuted: [241, 245, 250], // #F1F5FA — gris de support (encadrés)
  tableAlt: [248, 250, 252],     // fond alterné du tableau, proche du gris de support
};

// Mentions légales obligatoires (auto-entrepreneur, franchise en base de TVA,
// prestations B2B) — texte fixe, jamais éditable depuis l'interface : c'est
// une obligation réglementaire, pas un réglage.
const QUOTE_LEGAL_MENTIONS = [
  "TVA non applicable, art. 293 B du CGI.",
  "Devis valable jusqu'au {validUntil}. Passé ce délai, un nouveau devis pourra être établi sur demande.",
  "Conditions de règlement : paiement à réception de facture, par virement bancaire.",
  "Pénalités de retard : en cas de paiement après la date d'échéance, des pénalités sont exigibles de plein droit, au taux de refinancement de la BCE applicable au début du semestre majoré de 10 points, sans qu'un rappel soit nécessaire.",
  "Une indemnité forfaitaire de recouvrement de 40 € est due de plein droit en cas de retard de paiement (art. L441-10 du Code de commerce, relations entre professionnels).",
  "SIRET : {siret}",
];

function quoteLegalMentionsText(quote, settings) {
  return QUOTE_LEGAL_MENTIONS.map((line) =>
    line
      .replace("{validUntil}", quote.validUntil ? fmtShort(quote.validUntil) : "—")
      .replace("{siret}", settings?.siret || "—")
  );
}

// Mentions légales obligatoires FACTURE — reprend l'essentiel du devis (TVA
// non applicable, conditions de règlement, pénalités de retard, indemnité
// 40 €, SIRET) ET AJOUTE la mention RCS/RM (obligatoire sur une facture,
// absente du devis) + l'assurance professionnelle SI settings.insurance est
// renseigné (mention conditionnelle, jamais affichée si vide).
const INVOICE_LEGAL_MENTIONS_BASE = [
  "TVA non applicable, art. 293 B du CGI.",
  "Conditions de règlement : paiement à réception de facture, par virement bancaire. Échéance : {dueDate}.",
  "Pénalités de retard : en cas de paiement après la date d'échéance, des pénalités sont exigibles de plein droit, au taux de refinancement de la BCE applicable au début du semestre majoré de 10 points, sans qu'un rappel soit nécessaire.",
  "Une indemnité forfaitaire de recouvrement de 40 € est due de plein droit en cas de retard de paiement (art. L441-10 du Code de commerce, relations entre professionnels).",
  "Dispensé d'immatriculation au registre du commerce et des sociétés (RCS) et au répertoire des métiers (RM).",
  "SIRET : {siret}",
];

function invoiceLegalMentionsText(invoice, settings) {
  const lines = INVOICE_LEGAL_MENTIONS_BASE.map((line) =>
    line
      .replace("{dueDate}", invoice.dueDate ? fmtShort(invoice.dueDate) : "—")
      .replace("{siret}", settings?.siret || "—")
  );
  // Assurance professionnelle — texte libre, ajoutée EN PLUS uniquement si
  // renseignée (jamais une ligne vide sinon).
  if ((settings?.insurance || "").trim()) lines.push(`Assurance professionnelle : ${settings.insurance.trim()}`);
  return lines;
}

// CGV : la version affichée ("v.JJ/MM/AAAA") se déduit à chaque rendu de
// settings.cgvUpdatedAt (date de dernière modification RÉELLE du texte) —
// jamais une chaîne pré-formatée dupliquée en base. "" tant que les CGV
// n'ont jamais été renseignées.
function quoteCgvVersionLabel(settings) {
  return settings?.cgvUpdatedAt ? fmtShort(settings.cgvUpdatedAt) : "";
}

// Chargement best-effort d'un logo hébergé sur Google Drive : jsPDF a besoin
// d'un data-URL, jamais d'une URL distante. Un lien Drive privé ou une
// restriction CORS fait simplement échouer silencieusement ce chargement —
// le PDF retombe alors sur le texte seul, comme demandé par la spec.
async function loadQuoteLogoDataUrl(url) {
  if (!url) return null;
  try {
    const res = await fetch(url, { mode: "cors" });
    if (!res.ok) return null;
    const blob = await res.blob();
    if (!/^image\//.test(blob.type || "")) return null;
    return await new Promise((resolve) => {
      const reader = new FileReader();
      reader.onload = () => resolve(reader.result);
      reader.onerror = () => resolve(null);
      reader.readAsDataURL(blob);
    });
  } catch (e) {
    return null;
  }
}

// Chips de compétences dans le PDF (#facture — revirement de la décision
// initiale « UI seulement ») : Quentin les veut visibles, mais PAS reproduits
// en badges colorés pleins — autoTable ne permet pas facilement du texte
// multi-styles dans une cellule sans un rendu custom, et des badges pleins en
// cellule de tableau seraient fragiles. On se contente donc de libellés texte
// compacts, séparés par « · », résolus depuis skillIds -> quoteSkills — un id
// qui ne correspond plus à aucun chip existant est silencieusement ignoré
// (cohérent avec deleteSkill, qui nettoie déjà les références ailleurs).
function quoteLineSkillsLabel(line, skills) {
  const ids = line?.skillIds || [];
  if (!ids.length) return "";
  const labels = ids.map((id) => (skills || []).find((s) => s.id === id)?.label).filter(Boolean);
  return labels.length ? `Compétences : ${labels.join(" · ")}` : "";
}

// Construit les lignes du tableau des prestations (colonne "Désignation" en
// premier) — partagé entre le PDF devis et le PDF facture, mêmes colonnes.
// Une ligne AVEC compétences porte un retour à la ligne (" ") réservant la
// place nécessaire dans la cellule (autoTable calcule sa hauteur depuis le
// contenu texte) ; le libellé réel est redessiné par-dessus en petit texte
// gris par attachQuoteSkillsCellDrawer ci-dessous (jamais affiché tel quel —
// le "\n " n'est qu'un espace réservé invisible).
function buildQuoteLinesTableRows(lines, skills) {
  return (lines || []).map((l) => [
    quoteLineSkillsLabel(l, skills) ? `${l.description || ""}\n ` : (l.description || ""),
    l.kind === "regie" ? String(l.quantity ?? 0) : "—",
    l.kind === "regie" ? (QUOTE_REGIE_UNITS.find((u) => u.key === l.unit)?.label || "") : "Forfait",
    l.kind === "regie" ? fmtQuoteAmount(l.unitRate) : "—",
    fmtQuoteAmount(quoteLineAmount(l)),
  ]);
}

// Hook autoTable didDrawCell : dessine, sous le texte de chaque ligne de la
// colonne "Désignation", ses libellés de compétences en petit texte gris
// (7pt, QUOTE_PDF_COLORS.textMuted) — PAS de badges colorés pleins. Rien
// n'est dessiné pour une ligne sans skillIds (pas de ligne vide).
function attachQuoteSkillsCellDrawer(doc, lines, skills) {
  return (data) => {
    if (data.section !== "body" || data.column.index !== 0) return;
    const line = (lines || [])[data.row.index];
    const label = quoteLineSkillsLabel(line, skills);
    if (!label) return;
    doc.setFont("helvetica", "normal");
    doc.setFontSize(7);
    doc.setTextColor(...QUOTE_PDF_COLORS.textMuted);
    doc.text(label, data.cell.x + data.cell.padding("left"), data.cell.y + data.cell.height - data.cell.padding("bottom") - 1, {
      maxWidth: data.cell.width - data.cell.padding("left") - data.cell.padding("right"),
    });
  };
}

// Bandeau plein bleu en tout haut de chaque page (charte graphique) — dessiné
// à même le bord de la page, hors de la zone de marge de 15mm.
const QUOTE_PDF_BAND_H = 5; // mm

function drawQuoteBand(doc, pageWidth) {
  doc.setFillColor(...QUOTE_PDF_COLORS.brand);
  doc.rect(0, 0, pageWidth, QUOTE_PDF_BAND_H, "F");
}

// En-tête léger, identique en principe sur les deux pages : logo (ou nom de
// l'entreprise à défaut) à gauche, libellé fixe "PROPOSITION COMMERCIALE" à
// droite, puis une ligne de séparation fine. Retourne le Y juste sous cette
// ligne, point de départ du contenu propre à la page.
// Boîte maximale d'affichage du logo — le lockup réel de la charte QM est
// horizontal (icône + raison sociale, ratio large ~3.5:1), pas carré :
// object-fit "contain" dans cette boîte pour ne jamais l'écraser/déformer,
// quel que soit le format uploadé.
const QUOTE_LOGO_MAX_W = 55; // mm
const QUOTE_LOGO_MAX_H = 16; // mm

function drawQuoteHeader(doc, { marginX, pageWidth, top, logoDataUrl, settings }) {
  let textX = marginX;
  if (logoDataUrl) {
    try {
      // getImageProperties donne les dimensions RÉELLES (px) du fichier —
      // on en déduit une taille d'affichage qui respecte le ratio naturel
      // (object-fit: contain), au lieu d'une case carrée fixe qui déformait
      // tout logo non carré (voir charte graphique QM).
      const props = doc.getImageProperties(logoDataUrl);
      const ratio = props.width / props.height;
      let logoW = QUOTE_LOGO_MAX_W, logoH = QUOTE_LOGO_MAX_W / ratio;
      if (logoH > QUOTE_LOGO_MAX_H) { logoH = QUOTE_LOGO_MAX_H; logoW = QUOTE_LOGO_MAX_H * ratio; }
      doc.addImage(logoDataUrl, undefined, marginX, top, logoW, logoH);
      textX += logoW + 6;
    } catch (e) { /* logo illisible (format non supporté) : repli sur le texte seul */ }
  }
  if (!logoDataUrl) {
    doc.setFont("helvetica", "bold");
    doc.setFontSize(15);
    doc.setTextColor(...QUOTE_PDF_COLORS.ink);
    doc.text(settings?.companyName || "Quentin Morel Engineering", textX, top + 9);
  }

  doc.setFont("helvetica", "normal");
  doc.setFontSize(8);
  doc.setTextColor(...QUOTE_PDF_COLORS.textMuted);
  doc.text("PROPOSITION COMMERCIALE", pageWidth - marginX, top + 5, { align: "right", charSpace: 0.5 });

  const lineY = top + 20;
  doc.setDrawColor(...QUOTE_PDF_COLORS.border);
  doc.setLineWidth(0.3);
  doc.line(marginX, lineY, pageWidth - marginX, lineY);
  return lineY + 8;
}

// Pied de page — identique sur toutes les pages, écrit dans une passe finale
// une fois le nombre total de pages connu (pattern standard jsPDF).
function drawQuoteFooter(doc, { marginX, pageWidth, pageHeight, settings, pageNum, totalPages }) {
  const y = pageHeight - 10;
  doc.setFont("helvetica", "normal");
  doc.setFontSize(7.5);
  doc.setTextColor(...QUOTE_PDF_COLORS.textMuted);
  doc.text(settings?.companyName || "Quentin Morel Engineering", marginX, y);
  doc.text(
    `${String(pageNum).padStart(2, "0")} / ${String(totalPages).padStart(2, "0")}`,
    pageWidth - marginX,
    y,
    { align: "right" }
  );
}

// Petit encadré gris (fond #F1F5FA, coins arrondis) avec un eyebrow bleu en
// tête — brique commune aux blocs "Votre interlocuteur" / "Préparé pour" et
// au bloc "Bon pour accord".
function drawQuoteMutedBox(doc, { x, y, width, height }) {
  doc.setFillColor(...QUOTE_PDF_COLORS.surfaceMuted);
  doc.roundedRect(x, y, width, height, 2, 2, "F");
}

function drawQuoteEyebrow(doc, text, x, y) {
  doc.setFont("helvetica", "bold");
  doc.setFontSize(8.5);
  doc.setTextColor(...QUOTE_PDF_COLORS.brand);
  doc.text(text.toUpperCase(), x, y, { charSpace: 0.3 });
}

// Génère et télécharge le PDF d'un devis. Aucun binaire n'est jamais stocké
// dans Firestore : le document est entièrement reconstruit à la demande à
// partir des données du devis, du client et des réglages entreprise. Mise en
// page en millimètres, format A4, marges de 15mm (guide de personnalisation).
// `asBase64` (voir buildQuotePdfBase64 plus bas, pour l'archivage automatique
// sur Google Drive) rend le PDF en base64 pur au lieu de déclencher le
// téléchargement navigateur — même mise en page, jamais dupliquée.
async function downloadQuotePdf(quote, client, settings, quoteSkills, { asBase64 = false } = {}) {
  const doc = new jsPDF({ unit: "mm", format: "a4" });
  const pageWidth = doc.internal.pageSize.getWidth();
  const pageHeight = doc.internal.pageSize.getHeight();
  const marginX = 15;
  const contentWidth = pageWidth - marginX * 2;

  // Source de vérité principale : un data-URL déjà stocké dans les réglages
  // (upload direct depuis QuoteSettingsModal, cf. FileReader.readAsDataURL) —
  // jsPDF peut l'utiliser tel quel, sans fetch réseau. Le fetch cross-origin
  // (loadQuoteLogoDataUrl) n'est qu'un repli pour une URL http(s) classique
  // saisie à la main (lien Google Drive), qui échoue silencieusement si le
  // lien n'est pas en accès direct public (CORS, authentification, etc.).
  const rawLogoUrl = settings?.logoUrl || "";
  const logoDataUrl = rawLogoUrl.startsWith("data:image/")
    ? rawLogoUrl
    : await loadQuoteLogoDataUrl(rawLogoUrl);

  // ------------------------------------------------------------------ PAGE 1
  drawQuoteBand(doc, pageWidth);
  let y = drawQuoteHeader(doc, { marginX, pageWidth, top: marginX, logoDataUrl, settings });

  if (settings?.activity) {
    drawQuoteEyebrow(doc, settings.activity, marginX, y);
    y += 10;
  }

  // Titre "Devis" (38pt) à gauche, numéro + dates à droite, sur la même ligne
  // de base approximative.
  const titleBaseline = y + 13;
  doc.setFont("helvetica", "bold");
  doc.setFontSize(38);
  doc.setTextColor(...QUOTE_PDF_COLORS.ink);
  doc.text("Devis", marginX, titleBaseline);

  doc.setFont("helvetica", "bold");
  doc.setFontSize(14);
  doc.setTextColor(...QUOTE_PDF_COLORS.brand);
  doc.text(`Devis ${quote.number}`, pageWidth - marginX, y + 2, { align: "right" });
  doc.setFont("helvetica", "normal");
  doc.setFontSize(8.5);
  doc.setTextColor(...QUOTE_PDF_COLORS.textMuted);
  doc.text(
    `Émis le ${quote.issueDate ? fmtShort(quote.issueDate) : "—"}  •  Valable jusqu'au ${quote.validUntil ? fmtShort(quote.validUntil) : "—"}`,
    pageWidth - marginX,
    y + 8,
    { align: "right" }
  );
  y = titleBaseline + 10;

  // Deux encadrés côte à côte, largeur égale, même hauteur (la plus grande
  // des deux, pour rester alignés visuellement).
  const boxGap = 6;
  const boxWidth = (contentWidth - boxGap) / 2;
  const companyLines = [
    settings?.companyName || "Quentin Morel Engineering",
    settings?.address,
    [settings?.email, settings?.phone, settings?.website].filter(Boolean).join("  •  "),
  ].filter(Boolean);
  const clientLines = [client?.name, client?.address, client?.email].filter(Boolean);
  const boxLineH = 5;
  const boxTextTop = 13; // eyebrow + marge avant la 1re ligne
  const boxPad = 6;
  const boxHeight = boxTextTop + Math.max(companyLines.length, clientLines.length) * boxLineH + boxPad;

  const leftX = marginX;
  const rightX = marginX + boxWidth + boxGap;
  drawQuoteMutedBox(doc, { x: leftX, y, width: boxWidth, height: boxHeight });
  drawQuoteMutedBox(doc, { x: rightX, y, width: boxWidth, height: boxHeight });

  drawQuoteEyebrow(doc, "Votre interlocuteur", leftX + boxPad, y + 8);
  drawQuoteEyebrow(doc, "Préparé pour", rightX + boxPad, y + 8);

  const writeBoxLines = (lines, x) => {
    let ly = y + boxTextTop;
    lines.forEach((line, i) => {
      doc.setFont("helvetica", i === 0 ? "bold" : "normal");
      doc.setFontSize(9.5);
      doc.setTextColor(...(i === 0 ? QUOTE_PDF_COLORS.textStrong : QUOTE_PDF_COLORS.textMuted));
      doc.text(String(line), x + boxPad, ly, { maxWidth: boxWidth - boxPad * 2 });
      ly += boxLineH;
    });
  };
  writeBoxLines(companyLines, leftX);
  writeBoxLines(clientLines, rightX);
  y += boxHeight + 12;

  // Section "01 / Votre projet" — eyebrow + titre du devis, pas de paragraphe
  // de description (le champ n'existe pas dans le modèle de données).
  drawQuoteEyebrow(doc, "01 / Votre projet", marginX, y);
  y += 8;
  if (quote.title) {
    doc.setFont("helvetica", "bold");
    doc.setFontSize(13.5);
    doc.setTextColor(...QUOTE_PDF_COLORS.textStrong);
    doc.text(quote.title, marginX, y);
    y += 9;
  }
  y += 3;

  // Tableau des lignes — Forfait ou Régie (quantité/unité + taux). Style
  // épuré (thème "striped", pas de grille lourde), en-tête anthracite, lignes
  // en bandes alternées blanc / gris de support clair.
  const rows = buildQuoteLinesTableRows(quote.lines, quoteSkills);
  autoTable(doc, {
    startY: y,
    head: [["Désignation", "Qté", "Unité", "PU HT", "Total HT"]],
    body: rows,
    theme: "striped",
    styles: { font: "helvetica", fontSize: 9, textColor: QUOTE_PDF_COLORS.textStrong, fillColor: QUOTE_PDF_COLORS.white, lineWidth: 0 },
    alternateRowStyles: { fillColor: QUOTE_PDF_COLORS.tableAlt },
    headStyles: { fillColor: QUOTE_PDF_COLORS.ink, textColor: QUOTE_PDF_COLORS.white, fontStyle: "bold", lineWidth: 0 },
    columnStyles: {
      0: { cellWidth: 70 },
      1: { cellWidth: 20, halign: "right" },
      2: { cellWidth: 25 },
      3: { cellWidth: 30, halign: "right" },
      4: { cellWidth: 35, halign: "right" },
    },
    margin: { left: marginX, right: marginX },
    // Pages supplémentaires générées par un tableau trop long : on redessine
    // au moins le bandeau de marque pour rester cohérent visuellement.
    didDrawPage: () => drawQuoteBand(doc, pageWidth),
    // Chips de compétences sous chaque désignation (texte compact, pas de
    // badges pleins) — voir attachQuoteSkillsCellDrawer ci-dessus.
    didDrawCell: attachQuoteSkillsCellDrawer(doc, quote.lines, quoteSkills),
  });

  // Bloc totaux, à droite sous le tableau — "Total HT" en texte simple, puis
  // un bandeau plein bleu "TOTAL HT (= TTC)" (pas de TVA, franchise en base).
  const totalsWidth = 75;
  const totalsX = pageWidth - marginX - totalsWidth;
  let totalsY = doc.lastAutoTable.finalY + 8;
  doc.setFont("helvetica", "normal");
  doc.setFontSize(9.5);
  doc.setTextColor(...QUOTE_PDF_COLORS.textStrong);
  doc.text("Total HT", totalsX, totalsY);
  doc.text(fmtQuoteAmount(quoteTotal(quote)), pageWidth - marginX, totalsY, { align: "right" });
  totalsY += 4;

  const bandH = 12;
  doc.setFillColor(...QUOTE_PDF_COLORS.brand);
  doc.roundedRect(totalsX, totalsY, totalsWidth, bandH, 1.5, 1.5, "F");
  doc.setFont("helvetica", "bold");
  doc.setFontSize(9);
  doc.setTextColor(...QUOTE_PDF_COLORS.white);
  doc.text("TOTAL HT (= TTC)", totalsX + 4, totalsY + bandH / 2 + 3);
  doc.setFontSize(12);
  doc.text(fmtQuoteAmount(quoteTotal(quote)), pageWidth - marginX - 4, totalsY + bandH / 2 + 3, { align: "right" });

  // ------------------------------------------------------------------ PAGE 2
  doc.addPage();
  drawQuoteBand(doc, pageWidth);
  y = drawQuoteHeader(doc, { marginX, pageWidth, top: marginX, logoDataUrl, settings });

  drawQuoteEyebrow(doc, `${quote.number} / Conditions de la proposition`, marginX, y);
  y += 12;
  doc.setFont("helvetica", "bold");
  doc.setFontSize(26);
  doc.setTextColor(...QUOTE_PDF_COLORS.ink);
  doc.text("Conditions & mentions légales", marginX, y);
  y += 14;

  const legal = quoteLegalMentionsText(quote, settings);
  const legalSections = [
    { number: "02", title: "Validité & règlement", text: `${legal[0]} ${legal[1]} ${legal[2]}` },
    { number: "03", title: "Pénalités & indemnités", text: `${legal[3]} ${legal[4]}` },
    { number: "04", title: "Identification", text: legal[5] },
  ];
  const sectionTextWidth = contentWidth - 14;
  legalSections.forEach((section) => {
    doc.setFont("helvetica", "bold");
    doc.setFontSize(12);
    doc.setTextColor(...QUOTE_PDF_COLORS.brand);
    doc.text(section.number, marginX, y);
    doc.setTextColor(...QUOTE_PDF_COLORS.textStrong);
    doc.text(section.title, marginX + 14, y);
    y += 7;
    doc.setFont("helvetica", "normal");
    doc.setFontSize(9.5);
    doc.setTextColor(...QUOTE_PDF_COLORS.textMuted);
    const wrapped = doc.splitTextToSize(section.text, sectionTextWidth);
    doc.text(wrapped, marginX + 14, y);
    y += wrapped.length * 5 + 10;
  });

  // Bloc "05 / Bon pour accord" — ancré en bas de page, purement visuel (pas
  // de signature électronique, pas de nouveau champ de données).
  const acceptBoxH = 38;
  const acceptBoxY = pageHeight - 15 - acceptBoxH - 8;
  drawQuoteMutedBox(doc, { x: marginX, y: acceptBoxY, width: contentWidth, height: acceptBoxH });
  drawQuoteEyebrow(doc, "05 / Bon pour accord", marginX + 6, acceptBoxY + 9);
  doc.setFont("helvetica", "normal");
  doc.setFontSize(9.5);
  doc.setTextColor(...QUOTE_PDF_COLORS.textStrong);
  // Référence la version des CGV quand elles sont renseignées — phrase simple
  // sinon, comme avant leur ajout.
  const acceptCgvVersion = quoteCgvVersionLabel(settings);
  const acceptText = acceptCgvVersion
    ? `J'accepte le devis ${quote.number}, ses conditions et ses CGV (v.${acceptCgvVersion}).`
    : `J'accepte le devis ${quote.number}.`;
  doc.text(acceptText, marginX + 6, acceptBoxY + 17);
  doc.text("Nom et qualité : ________________________", marginX + 6, acceptBoxY + 26);
  doc.text("Lieu et date : ________________________", marginX + 6, acceptBoxY + 33);
  doc.setFont("helvetica", "bold");
  doc.text("Signature du client", pageWidth - marginX - 6, acceptBoxY + 17, { align: "right" });

  // ------------------------------------------------------------------ PAGE 3
  // CGV — uniquement si renseignées dans les réglages (QuoteSettingsModal) :
  // pas de page vide inutile si settings.cgvText est resté vide. Répartition
  // en paragraphes (double saut de ligne dans le texte source), avec repli
  // sur une ou plusieurs pages supplémentaires si le texte est long — mêmes
  // bandeau/en-tête/pied que la page 2, redessinés à chaque nouvelle page.
  if ((settings?.cgvText || "").trim()) {
    const drawCgvPageHead = () => {
      drawQuoteBand(doc, pageWidth);
      let hy = drawQuoteHeader(doc, { marginX, pageWidth, top: marginX, logoDataUrl, settings });
      drawQuoteEyebrow(doc, `${quote.number} / Conditions générales de vente`, marginX, hy);
      hy += 12;
      doc.setFont("helvetica", "bold");
      doc.setFontSize(26);
      doc.setTextColor(...QUOTE_PDF_COLORS.ink);
      doc.text("Conditions générales de vente", marginX, hy);
      hy += 6;
      const cgvVersion = quoteCgvVersionLabel(settings);
      if (cgvVersion) {
        doc.setFont("helvetica", "normal");
        doc.setFontSize(8.5);
        doc.setTextColor(...QUOTE_PDF_COLORS.textMuted);
        doc.text(`CGV v.${cgvVersion}`, marginX, hy + 5);
      }
      return hy + 16;
    };

    doc.addPage();
    y = drawCgvPageHead();

    const cgvBottomLimit = pageHeight - 22; // hors zone du pied de page
    const cgvLineH = 5;
    doc.setFont("helvetica", "normal");
    doc.setFontSize(9.5);
    doc.setTextColor(...QUOTE_PDF_COLORS.textMuted);
    const paragraphs = settings.cgvText.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
    paragraphs.forEach((paragraph) => {
      const wrapped = doc.splitTextToSize(paragraph, contentWidth);
      wrapped.forEach((line) => {
        if (y > cgvBottomLimit) {
          doc.addPage();
          y = drawCgvPageHead();
          doc.setFont("helvetica", "normal");
          doc.setFontSize(9.5);
          doc.setTextColor(...QUOTE_PDF_COLORS.textMuted);
        }
        doc.text(line, marginX, y);
        y += cgvLineH;
      });
      y += 4; // espace entre paragraphes
    });
  }

  // ---------------------------------------------------------- Pagination finale
  const totalPages = doc.internal.getNumberOfPages();
  for (let p = 1; p <= totalPages; p++) {
    doc.setPage(p);
    drawQuoteFooter(doc, { marginX, pageWidth, pageHeight, settings, pageNum: p, totalPages });
  }

  if (asBase64) {
    const dataUri = doc.output("datauristring");
    return dataUri.slice(dataUri.indexOf(",") + 1);
  }
  doc.save(`Devis-${quote.number}.pdf`);
}

// PDF en base64 pur (sans le préfixe data:...;base64,), pour l'envoyer tel
// quel à /api/nexora/drive-archive — jamais de téléchargement déclenché ni de
// duplication de la mise en page (voir downloadQuotePdf, option asBase64).
async function buildQuotePdfBase64(quote, client, settings, quoteSkills) {
  return downloadQuotePdf(quote, client, settings, quoteSkills, { asBase64: true });
}

// Archivage automatique sur Google Drive (dossier Clients/{Nom client}),
// appelé en fire-and-forget après chaque sauvegarde de devis/facture — voir
// netlify/functions/nexora-drive-archive.ts et _shared/drive.ts. Ne bloque
// JAMAIS la sauvegarde : toute erreur (réseau, config Drive absente côté
// Netlify tant que Quentin n'a pas terminé son setup...) est avalée en
// console.warn, jamais en alert ni en blocage de l'UI. Un flag localStorage
// (best-effort, pas une source de vérité) retient si l'archivage n'est pas
// encore configuré, pour un discret rappel dans les réglages — voir
// QuoteSettingsModal.
async function archivePdfToDrive({ clientName, filename, pdfBase64 }) {
  try {
    const user = auth.currentUser;
    if (!user) return;
    const token = await user.getIdToken();
    const response = await fetch("/api/nexora/drive-archive", {
      method: "POST",
      headers: { "content-type": "application/json", authorization: `Bearer ${token}` },
      body: JSON.stringify({ clientName, filename, pdfBase64 }),
    });
    const data = await response.json().catch(() => ({}));
    if (data?.archived === false && data?.reason === "not_configured") {
      try { localStorage.setItem("nexora:driveArchiveNotConfigured", "1"); } catch (_) {}
    } else if (data?.archived) {
      try { localStorage.removeItem("nexora:driveArchiveNotConfigured"); } catch (_) {}
    } else {
      console.warn("Archivage Drive : échec", data?.detail || data?.reason || response.status);
    }
  } catch (error) {
    console.warn("Archivage Drive : erreur réseau", error);
  }
}

async function archiveQuotePdfToDrive(quote, client, settings, quoteSkills) {
  try {
    const pdfBase64 = await buildQuotePdfBase64(quote, client, settings, quoteSkills);
    await archivePdfToDrive({
      clientName: client?.name || "Client sans nom",
      filename: `Devis-${quote.number}.pdf`,
      pdfBase64,
    });
  } catch (error) {
    console.warn("Archivage Drive (devis) : erreur de génération PDF", error);
  }
}

// Génère et télécharge le PDF d'une facture. Réutilise au maximum le code du
// PDF devis (drawQuoteBand/Header/Footer/MutedBox/Eyebrow, buildQuoteLinesTableRows
// + attachQuoteSkillsCellDrawer pour les chips) — une fonction séparée plutôt
// qu'un paramètre de "mode" sur buildQuotePdfDoc/downloadQuotePdf : les
// différences de contenu (mentions légales, absence de "Bon pour accord",
// bandeau avoir, deux dates) sont assez nombreuses pour qu'un mode unique
// tourne vite en accumulation de conditionnels moins lisible qu'une fonction
// dédiée qui partage les briques de bas niveau. sourceQuote (optionnel)
// affiche juste une référence croisée vers le devis d'origine quand la
// facture en vient (createInvoiceFromQuote) ; originalInvoiceNumber (optionnel)
// est le numéro de la facture annulée quand CETTE facture est un avoir.
// `asBase64` (voir buildInvoicePdfBase64 plus bas, pour l'archivage
// automatique sur Google Drive) rend le PDF en base64 pur au lieu de
// déclencher le téléchargement navigateur — même mise en page, jamais
// dupliquée (même principe que downloadQuotePdf ci-dessus).
async function downloadInvoicePdf(invoice, client, settings, invoiceSkills, sourceQuote, originalInvoiceNumber, { asBase64 = false } = {}) {
  const doc = new jsPDF({ unit: "mm", format: "a4" });
  const pageWidth = doc.internal.pageSize.getWidth();
  const pageHeight = doc.internal.pageSize.getHeight();
  const marginX = 15;
  const contentWidth = pageWidth - marginX * 2;

  const rawLogoUrl = settings?.logoUrl || "";
  const logoDataUrl = rawLogoUrl.startsWith("data:image/")
    ? rawLogoUrl
    : await loadQuoteLogoDataUrl(rawLogoUrl);

  const isCreditNote = !!invoice.creditNoteOf;

  // ------------------------------------------------------------------ PAGE 1
  drawQuoteBand(doc, pageWidth);
  let y = drawQuoteHeader(doc, { marginX, pageWidth, top: marginX, logoDataUrl, settings });

  if (settings?.activity) {
    drawQuoteEyebrow(doc, settings.activity, marginX, y);
    y += 10;
  }

  // Bandeau "AVOIR" — visible uniquement si cette facture EST un avoir
  // (invoice.creditNoteOf renseigné) : annonce clairement de quelle facture
  // elle annule/corrige le montant, avant même le titre.
  if (isCreditNote) {
    const bandH = 9;
    doc.setFillColor(...QUOTE_PDF_COLORS.ink);
    doc.roundedRect(marginX, y, contentWidth, bandH, 1.5, 1.5, "F");
    doc.setFont("helvetica", "bold");
    doc.setFontSize(9.5);
    doc.setTextColor(...QUOTE_PDF_COLORS.white);
    doc.text(`AVOIR — annule et corrige la facture ${originalInvoiceNumber || "—"}`, marginX + 5, y + bandH / 2 + 3);
    y += bandH + 8;
  }

  // Titre "Facture" (38pt) à gauche, numéro F-AAAA-NNN + dates à droite.
  const titleBaseline = y + 13;
  doc.setFont("helvetica", "bold");
  doc.setFontSize(38);
  doc.setTextColor(...QUOTE_PDF_COLORS.ink);
  doc.text("Facture", marginX, titleBaseline);

  doc.setFont("helvetica", "bold");
  doc.setFontSize(14);
  doc.setTextColor(...QUOTE_PDF_COLORS.brand);
  doc.text(`Facture ${invoice.number}`, pageWidth - marginX, y + 2, { align: "right" });
  doc.setFont("helvetica", "normal");
  doc.setFontSize(8.5);
  doc.setTextColor(...QUOTE_PDF_COLORS.textMuted);
  doc.text(
    `Émise le ${invoice.issueDate ? fmtShort(invoice.issueDate) : "—"}  •  Échéance le ${invoice.dueDate ? fmtShort(invoice.dueDate) : "—"}`,
    pageWidth - marginX,
    y + 8,
    { align: "right" }
  );
  if (sourceQuote?.number) {
    doc.text(`Devis d'origine : ${sourceQuote.number}`, pageWidth - marginX, y + 13, { align: "right" });
  }
  y = titleBaseline + 10;

  // Deux encadrés côte à côte — identiques au PDF devis.
  const boxGap = 6;
  const boxWidth = (contentWidth - boxGap) / 2;
  const companyLines = [
    settings?.companyName || "Quentin Morel Engineering",
    settings?.address,
    [settings?.email, settings?.phone, settings?.website].filter(Boolean).join("  •  "),
  ].filter(Boolean);
  const clientLines = [client?.name, client?.address, client?.email].filter(Boolean);
  const boxLineH = 5;
  const boxTextTop = 13;
  const boxPad = 6;
  const boxHeight = boxTextTop + Math.max(companyLines.length, clientLines.length) * boxLineH + boxPad;

  const leftX = marginX;
  const rightX = marginX + boxWidth + boxGap;
  drawQuoteMutedBox(doc, { x: leftX, y, width: boxWidth, height: boxHeight });
  drawQuoteMutedBox(doc, { x: rightX, y, width: boxWidth, height: boxHeight });

  drawQuoteEyebrow(doc, "Votre interlocuteur", leftX + boxPad, y + 8);
  drawQuoteEyebrow(doc, "Facturé à", rightX + boxPad, y + 8);

  const writeBoxLines = (lines, x) => {
    let ly = y + boxTextTop;
    lines.forEach((line, i) => {
      doc.setFont("helvetica", i === 0 ? "bold" : "normal");
      doc.setFontSize(9.5);
      doc.setTextColor(...(i === 0 ? QUOTE_PDF_COLORS.textStrong : QUOTE_PDF_COLORS.textMuted));
      doc.text(String(line), x + boxPad, ly, { maxWidth: boxWidth - boxPad * 2 });
      ly += boxLineH;
    });
  };
  writeBoxLines(companyLines, leftX);
  writeBoxLines(clientLines, rightX);
  y += boxHeight + 12;

  drawQuoteEyebrow(doc, "01 / Prestations facturées", marginX, y);
  y += 8;
  if (invoice.title) {
    doc.setFont("helvetica", "bold");
    doc.setFontSize(13.5);
    doc.setTextColor(...QUOTE_PDF_COLORS.textStrong);
    doc.text(invoice.title, marginX, y);
    y += 9;
  }
  y += 3;

  // Tableau des lignes — même construction que le devis, chips de
  // compétences comprises (buildQuoteLinesTableRows/attachQuoteSkillsCellDrawer,
  // partagés). Les lignes d'un avoir portent des montants déjà négatifs
  // (createCreditNote, part-001) : fmtQuoteAmount les affiche tels quels.
  const rows = buildQuoteLinesTableRows(invoice.lines, invoiceSkills);
  autoTable(doc, {
    startY: y,
    head: [["Désignation", "Qté", "Unité", "PU HT", "Total HT"]],
    body: rows,
    theme: "striped",
    styles: { font: "helvetica", fontSize: 9, textColor: QUOTE_PDF_COLORS.textStrong, fillColor: QUOTE_PDF_COLORS.white, lineWidth: 0 },
    alternateRowStyles: { fillColor: QUOTE_PDF_COLORS.tableAlt },
    headStyles: { fillColor: QUOTE_PDF_COLORS.ink, textColor: QUOTE_PDF_COLORS.white, fontStyle: "bold", lineWidth: 0 },
    columnStyles: {
      0: { cellWidth: 70 },
      1: { cellWidth: 20, halign: "right" },
      2: { cellWidth: 25 },
      3: { cellWidth: 30, halign: "right" },
      4: { cellWidth: 35, halign: "right" },
    },
    margin: { left: marginX, right: marginX },
    didDrawPage: () => drawQuoteBand(doc, pageWidth),
    didDrawCell: attachQuoteSkillsCellDrawer(doc, invoice.lines, invoiceSkills),
  });

  const totalsWidth = 75;
  const totalsX = pageWidth - marginX - totalsWidth;
  let totalsY = doc.lastAutoTable.finalY + 8;
  doc.setFont("helvetica", "normal");
  doc.setFontSize(9.5);
  doc.setTextColor(...QUOTE_PDF_COLORS.textStrong);
  doc.text("Total HT", totalsX, totalsY);
  doc.text(fmtQuoteAmount(invoiceTotal(invoice)), pageWidth - marginX, totalsY, { align: "right" });
  totalsY += 4;

  const bandH = 12;
  doc.setFillColor(...QUOTE_PDF_COLORS.brand);
  doc.roundedRect(totalsX, totalsY, totalsWidth, bandH, 1.5, 1.5, "F");
  doc.setFont("helvetica", "bold");
  doc.setFontSize(9);
  doc.setTextColor(...QUOTE_PDF_COLORS.white);
  doc.text("TOTAL HT (= TTC)", totalsX + 4, totalsY + bandH / 2 + 3);
  doc.setFontSize(12);
  doc.text(fmtQuoteAmount(invoiceTotal(invoice)), pageWidth - marginX - 4, totalsY + bandH / 2 + 3, { align: "right" });

  // ------------------------------------------------------------------ PAGE 2
  doc.addPage();
  drawQuoteBand(doc, pageWidth);
  y = drawQuoteHeader(doc, { marginX, pageWidth, top: marginX, logoDataUrl, settings });

  drawQuoteEyebrow(doc, `${invoice.number} / Conditions de la facture`, marginX, y);
  y += 12;
  doc.setFont("helvetica", "bold");
  doc.setFontSize(26);
  doc.setTextColor(...QUOTE_PDF_COLORS.ink);
  doc.text("Conditions & mentions légales", marginX, y);
  y += 14;

  // Mentions légales FACTURE (RCS/RM + assurance en plus, voir
  // invoiceLegalMentionsText ci-dessus) réparties en sections numérotées,
  // même structure de rendu que le devis.
  const legal = invoiceLegalMentionsText(invoice, settings);
  const legalSections = [
    { number: "02", title: "Règlement", text: `${legal[0]} ${legal[1]}` },
    { number: "03", title: "Pénalités & indemnités", text: `${legal[2]} ${legal[3]}` },
    { number: "04", title: "Identification", text: legal.slice(4).join(" ") },
  ];
  const sectionTextWidth = contentWidth - 14;
  legalSections.forEach((section) => {
    doc.setFont("helvetica", "bold");
    doc.setFontSize(12);
    doc.setTextColor(...QUOTE_PDF_COLORS.brand);
    doc.text(section.number, marginX, y);
    doc.setTextColor(...QUOTE_PDF_COLORS.textStrong);
    doc.text(section.title, marginX + 14, y);
    y += 7;
    doc.setFont("helvetica", "normal");
    doc.setFontSize(9.5);
    doc.setTextColor(...QUOTE_PDF_COLORS.textMuted);
    const wrapped = doc.splitTextToSize(section.text, sectionTextWidth);
    doc.text(wrapped, marginX + 14, y);
    y += wrapped.length * 5 + 10;
  });

  // Pas de "Bon pour accord" sur une facture (ça n'a pas de sens) — un simple
  // récapitulatif des conditions de paiement à la place.
  const payBoxH = 30;
  const payBoxY = pageHeight - 15 - payBoxH - 8;
  drawQuoteMutedBox(doc, { x: marginX, y: payBoxY, width: contentWidth, height: payBoxH });
  drawQuoteEyebrow(doc, "05 / Conditions de paiement", marginX + 6, payBoxY + 9);
  doc.setFont("helvetica", "normal");
  doc.setFontSize(9.5);
  doc.setTextColor(...QUOTE_PDF_COLORS.textStrong);
  doc.text(`Paiement par virement bancaire, à réception, échéance au ${invoice.dueDate ? fmtShort(invoice.dueDate) : "—"}.`, marginX + 6, payBoxY + 18);
  doc.text(`Montant ${isCreditNote ? "à rembourser/déduire" : "dû"} : ${fmtQuoteAmount(invoiceTotal(invoice))}`, marginX + 6, payBoxY + 25);

  // ------------------------------------------------------------------ PAGE 3
  // CGV — même logique conditionnelle que le devis : pas de page si vide,
  // même texte (pas de nouveau contenu CGV distinct à gérer).
  if ((settings?.cgvText || "").trim()) {
    const drawCgvPageHead = () => {
      drawQuoteBand(doc, pageWidth);
      let hy = drawQuoteHeader(doc, { marginX, pageWidth, top: marginX, logoDataUrl, settings });
      drawQuoteEyebrow(doc, `${invoice.number} / Conditions générales de vente`, marginX, hy);
      hy += 12;
      doc.setFont("helvetica", "bold");
      doc.setFontSize(26);
      doc.setTextColor(...QUOTE_PDF_COLORS.ink);
      doc.text("Conditions générales de vente", marginX, hy);
      hy += 6;
      const cgvVersion = quoteCgvVersionLabel(settings);
      if (cgvVersion) {
        doc.setFont("helvetica", "normal");
        doc.setFontSize(8.5);
        doc.setTextColor(...QUOTE_PDF_COLORS.textMuted);
        doc.text(`CGV v.${cgvVersion}`, marginX, hy + 5);
      }
      return hy + 16;
    };

    doc.addPage();
    y = drawCgvPageHead();

    const cgvBottomLimit = pageHeight - 22;
    const cgvLineH = 5;
    doc.setFont("helvetica", "normal");
    doc.setFontSize(9.5);
    doc.setTextColor(...QUOTE_PDF_COLORS.textMuted);
    const paragraphs = settings.cgvText.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
    paragraphs.forEach((paragraph) => {
      const wrapped = doc.splitTextToSize(paragraph, contentWidth);
      wrapped.forEach((line) => {
        if (y > cgvBottomLimit) {
          doc.addPage();
          y = drawCgvPageHead();
          doc.setFont("helvetica", "normal");
          doc.setFontSize(9.5);
          doc.setTextColor(...QUOTE_PDF_COLORS.textMuted);
        }
        doc.text(line, marginX, y);
        y += cgvLineH;
      });
      y += 4;
    });
  }

  // ---------------------------------------------------------- Pagination finale
  const totalPages = doc.internal.getNumberOfPages();
  for (let p = 1; p <= totalPages; p++) {
    doc.setPage(p);
    drawQuoteFooter(doc, { marginX, pageWidth, pageHeight, settings, pageNum: p, totalPages });
  }

  if (asBase64) {
    const dataUri = doc.output("datauristring");
    return dataUri.slice(dataUri.indexOf(",") + 1);
  }
  doc.save(`${isCreditNote ? "Avoir" : "Facture"}-${invoice.number}.pdf`);
}

// PDF en base64 pur (sans le préfixe data:...;base64,), pour l'envoyer tel
// quel à /api/nexora/drive-archive — jamais de téléchargement déclenché ni de
// duplication de la mise en page (voir downloadInvoicePdf, option asBase64).
async function buildInvoicePdfBase64(invoice, client, settings, invoiceSkills, sourceQuote, originalInvoiceNumber) {
  return downloadInvoicePdf(invoice, client, settings, invoiceSkills, sourceQuote, originalInvoiceNumber, { asBase64: true });
}

// Archivage automatique sur Google Drive pour une facture (ou un avoir) —
// même principe que archiveQuotePdfToDrive : fire-and-forget, jamais
// bloquant, réutilise archivePdfToDrive (voir plus haut, au-dessus de
// downloadQuotePdf).
async function archiveInvoicePdfToDrive(invoice, client, settings, invoiceSkills, sourceQuote, originalInvoiceNumber) {
  try {
    const isCreditNote = !!invoice.creditNoteOf;
    const pdfBase64 = await buildInvoicePdfBase64(invoice, client, settings, invoiceSkills, sourceQuote, originalInvoiceNumber);
    await archivePdfToDrive({
      clientName: client?.name || "Client sans nom",
      filename: `${isCreditNote ? "Avoir" : "Facture"}-${invoice.number}.pdf`,
      pdfBase64,
    });
  } catch (error) {
    console.warn("Archivage Drive (facture) : erreur de génération PDF", error);
  }
}

// ============================================================================
// Fiche mémo PDF depuis une tâche (#289) — export A4 haut de gamme, client
// uniquement (aucune écriture Firestore, aucune modification de tâche). Les
// fonctions pures de préparation des données (NEXORA:MEMO-PDF-CORE) vivent dans
// index.html.part-000, testables sans navigateur ; ce fichier ne porte que le
// dessin jsPDF, sur le même modèle que le module Devis juste au-dessus.
// ============================================================================
// === NEXORA:MEMO-PDF-DRAW:START ===

const MEMO_INK = [16, 27, 45];        // #101B2D
const MEMO_INK_SOFT = [69, 83, 107];  // #45536B
const MEMO_INK_FAINT = [133, 147, 170]; // #8593AA
const MEMO_ACCENT = [30, 79, 216];    // #1E4FD8
const MEMO_LINE = [222, 227, 236];    // #DEE3EC
const MEMO_PAPER_SOFT = [241, 243, 248]; // #F1F3F8

const MEMO_PAGE_W = 210, MEMO_PAGE_H = 297, MEMO_MARGIN = 15;
const MEMO_CONTENT_W = MEMO_PAGE_W - MEMO_MARGIN * 2;
const MEMO_BOTTOM_LIMIT = MEMO_PAGE_H - 16;
// Respiration entre deux sections de la fiche mémo (retour de test #289).
const MEMO_SECTION_GAP = 8;

function memoFmtFr(dateIso) {
  if (!dateIso) return "";
  const d = new Date(dateIso + "T00:00:00");
  if (Number.isNaN(d.getTime())) return "";
  return d.toLocaleDateString("fr-FR", { day: "numeric", month: "short", year: "numeric" });
}

// Découpe des segments (gras/italique/code/lien) en lignes qui tiennent dans
// maxWidth, un mot à la fois — c'est ce qui permet de garder le style de
// chaque mot (contrairement à doc.splitTextToSize, qui ne connaît qu'une
// chaîne plate).
function memoWrapSegments(doc, segments, maxWidth, baseSize) {
  const words = [];
  segments.forEach((seg) => {
    String(seg.text).split(/(\s+)/).forEach((raw) => {
      // Helvetica n'encode que Windows-1252 : emoji et symboles hors table
      // sont convertis ou retirés (projectPdfSafeText) plutôt qu'imprimés
      // en charabia.
      const chunk = /^\s+$/.test(raw) ? raw : projectPdfSafeText(raw);
      if (chunk === "") return;
      words.push({ text: chunk, bold: seg.bold, italic: seg.italic, code: seg.code, href: seg.href });
    });
  });
  const widthOf = (w) => {
    doc.setFont(w.code ? "courier" : "helvetica", w.bold ? "bold" : w.italic ? "italic" : "normal");
    doc.setFontSize(w.code ? baseSize - 0.5 : baseSize);
    return doc.getTextWidth(w.text);
  };
  const lines = [[]];
  let lineWidth = 0;
  words.forEach((w) => {
    const isSpace = /^\s+$/.test(w.text);
    const ww = widthOf(w);
    if (!isSpace && lineWidth + ww > maxWidth && lines[lines.length - 1].length) {
      lines.push([]);
      lineWidth = 0;
    }
    if (isSpace && lineWidth === 0) return; // pas d'espace en début de ligne
    lines[lines.length - 1].push(w);
    lineWidth += ww;
  });
  return lines.filter((l) => l.length);
}

function memoDrawSegmentLines(doc, lines, x, y, lineHeight, baseSize, color = MEMO_INK) {
  lines.forEach((line) => {
    let cx = x;
    line.forEach((w) => {
      doc.setFont(w.code ? "courier" : "helvetica", w.bold ? "bold" : w.italic ? "italic" : "normal");
      doc.setFontSize(w.code ? baseSize - 0.5 : baseSize);
      doc.setTextColor(...(w.href ? MEMO_ACCENT : color));
      doc.text(w.text, cx, y);
      if (w.href) {
        const ww = doc.getTextWidth(w.text);
        doc.setDrawColor(...MEMO_ACCENT);
        doc.setLineWidth(0.15);
        doc.line(cx, y + 0.6, cx + ww, y + 0.6);
      }
      cx += doc.getTextWidth(w.text);
    });
    y += lineHeight;
  });
  return y;
}

function memoRoundedChip(doc, x, y, text, bg, { fontSize = 7.6 } = {}) {
  text = projectPdfSafeText(text);
  doc.setFont("helvetica", "bold");
  doc.setFontSize(fontSize);
  const padX = 2.4, h = 4.6;
  const w = doc.getTextWidth(text) + padX * 2;
  doc.setFillColor(...memoHexToRgb(bg));
  doc.roundedRect(x, y, w, h, 1.1, 1.1, "F");
  doc.setTextColor(...memoHexToRgb(memoContrastInk(bg)));
  doc.text(text, x + padX, y + h / 2 + 1.1);
  return w;
}

// En-tête minimaliste répétée sur les pages 2+ : logo + titre court + numéro
// de page (le numéro exact est posé dans la passe finale de pagination).
function memoDrawMiniHeader(doc, title, logoDataUrl) {
  let y = MEMO_MARGIN;
  const logoW = 12, logoH = 6; // ratio 2:1, identique au logo réel
  if (logoDataUrl) {
    try { doc.addImage(logoDataUrl, undefined, MEMO_MARGIN, y - 4, logoW, logoH); } catch (_) {}
  }
  doc.setFont("helvetica", "bold");
  doc.setFontSize(9);
  doc.setTextColor(...MEMO_INK_SOFT);
  doc.text(title, MEMO_MARGIN + (logoDataUrl ? logoW + 4 : 0), y);
  doc.setDrawColor(...MEMO_LINE);
  doc.setLineWidth(0.2);
  doc.line(MEMO_MARGIN, y + 4, MEMO_PAGE_W - MEMO_MARGIN, y + 4);
  return y + 11; // MEMO_CONTINUATION_TOP
}

function memoDrawFooter(doc, pageNum, totalPages) {
  const y = MEMO_PAGE_H - 11;
  doc.setDrawColor(...MEMO_LINE);
  doc.setLineWidth(0.2);
  doc.line(MEMO_MARGIN, y, MEMO_PAGE_W - MEMO_MARGIN, y);
  doc.setFont("helvetica", "normal");
  doc.setFontSize(7);
  doc.setTextColor(...MEMO_INK_FAINT);
  doc.text("Nexora · export confidentiel", MEMO_MARGIN, y + 4);
  doc.text(`page ${pageNum}/${totalPages}`, MEMO_PAGE_W - MEMO_MARGIN, y + 4, { align: "right" });
}

// Titre garanti sur une seule ligne : réduit la taille jusqu'à ce qu'il
// tienne dans maxWidth plutôt que de le tronquer — mécanique jsPDF de la
// même idée que l'ajustement JS utilisé sur l'aperçu HTML validé.
function memoFitTitleFontSize(doc, title, maxWidth, startSize, minSize) {
  let size = startSize;
  doc.setFont("helvetica", "bold");
  while (size > minSize) {
    doc.setFontSize(size);
    if (doc.getTextWidth(title) <= maxWidth) break;
    size -= 0.5;
  }
  return size;
}

// Pictogramme dessiné (jamais un emoji : Helvetica ne les porte pas) de
// chaque type d'encadré, blanc sur une pastille de la couleur du type.
function memoCalloutIcon(doc, type, cx, cy, rgb) {
  doc.setFillColor(...rgb);
  doc.setDrawColor(255, 255, 255);
  if (type === "warning") {
    doc.triangle(cx, cy - 1.7, cx + 1.8, cy + 1.3, cx - 1.8, cy + 1.3, "F");
  } else {
    doc.circle(cx, cy, 1.6, "F");
  }
  doc.setTextColor(255, 255, 255);
  doc.setFont("helvetica", "bold");
  if (type === "tip") {
    doc.setLineWidth(0.4);
    doc.lines([[0.55, 0.6], [1.1, -1.25]], cx - 0.85, cy + 0.05, [1, 1], "S");
  } else if (type === "note") {
    doc.setLineWidth(0.3);
    doc.line(cx - 0.75, cy - 0.5, cx + 0.75, cy - 0.5);
    doc.line(cx - 0.75, cy + 0.05, cx + 0.75, cy + 0.05);
    doc.line(cx - 0.75, cy + 0.6, cx + 0.3, cy + 0.6);
  } else {
    doc.setFontSize(6.4);
    doc.text(type === "info" ? "i" : "!", cx, cy + (type === "warning" ? 1 : 0.8), { align: "center" });
  }
}

// Encadré (callout) : fond teinté, bordure fine et filet gauche épais de la
// couleur du type, pictogramme + titre coloré — comme .lp-callout dans
// l'application. Le fond doit être posé AVANT le texte : la hauteur (et les
// éventuels sauts de page) est donc d'abord mesurée à blanc, sur un document
// jetable, avec les mêmes polices ; un encadré long se poursuit sur la page
// suivante avec son fond, jamais coupé entre son titre et sa première ligne.
const MEMO_CONTINUATION_TOP = MEMO_MARGIN + 11; // = retour de memoDrawMiniHeader
function memoDrawCallout(doc, block, x, width, y, opts) {
  const meta = MEMO_CALLOUT_TYPES[block.calloutType] || MEMO_CALLOUT_TYPES.note;
  const color = memoHexToRgb(meta.color), bg = memoHexToRgb(meta.bg);
  const border = memoHexToRgb(lerpColor(meta.bg, meta.color, 0.45));
  const titleRgb = memoHexToRgb(projectPdfTextOnPaper(meta.color, meta.bg));
  const BAR = 1, PAD_X = 4, PAD_TOP = 2.8, PAD_BOTTOM = 2.6;
  const innerX = x + BAR + PAD_X, innerW = width - BAR - PAD_X * 2;
  const hasBody = block.blocks.length > 0;
  doc.setFont("helvetica", "bold");
  doc.setFontSize(8.2);
  const titleLines = doc.splitTextToSize(projectPdfSafeText(block.title || meta.label), innerW - 5);
  y += 1.8; // respiration avant l'encadré
  const headNeed = PAD_TOP + titleLines.length * 3.8 + (hasBody ? 7 : PAD_BOTTOM);
  if (y - 3 + headNeed > MEMO_BOTTOM_LIMIT) { doc.addPage(); y = opts.onPageBreak(doc); }
  const top = y - 3;
  const titleBaseline = top + PAD_TOP + 2.9;
  const bodyStart = titleBaseline + (titleLines.length - 1) * 3.8 + (hasBody ? 5.4 : 0);

  // Mesure à blanc : nombre de sauts de page et bas de l'encadré.
  let breaks = 0;
  let bottom = titleBaseline + (titleLines.length - 1) * 3.8 + 1.2 + PAD_BOTTOM;
  if (hasBody) {
    const scratch = new jsPDF({ unit: "mm", format: "a4" });
    const endY = memoDrawBlocks(scratch, block.blocks, innerX, innerW, bodyStart, {
      ...opts,
      onPageBreak: () => { breaks++; return MEMO_CONTINUATION_TOP; },
    });
    bottom = endY - 3.2 + PAD_BOTTOM;
  }
  const panel = (y1, y2) => {
    doc.setFillColor(...bg);
    doc.setDrawColor(...border);
    doc.setLineWidth(0.25);
    doc.roundedRect(x, y1, width, y2 - y1, 0.9, 0.9, "FD");
    doc.setFillColor(...color);
    doc.rect(x, y1, BAR, y2 - y1, "F");
  };
  panel(top, breaks ? MEMO_BOTTOM_LIMIT + 1 : bottom);
  memoCalloutIcon(doc, block.calloutType, innerX + 1.6, titleBaseline - 1.05, color);
  doc.setFont("helvetica", "bold");
  doc.setFontSize(8.2);
  doc.setTextColor(...titleRgb);
  titleLines.forEach((l, i) => doc.text(l, innerX + 4.6, titleBaseline + i * 3.8));
  if (hasBody) {
    let seg = 0;
    memoDrawBlocks(doc, block.blocks, innerX, innerW, bodyStart, {
      ...opts,
      onPageBreak: (d) => {
        const yTop = opts.onPageBreak(d);
        seg++;
        panel(yTop - 4.6, seg === breaks ? bottom : MEMO_BOTTOM_LIMIT + 1);
        return yTop;
      },
    });
  }
  return bottom + 2 + 4.2; // respiration après + ligne de base suivante
}

function memoDrawBlocks(doc, blocks, x, width, y, opts) {
  const { onPageBreak } = opts;
  const ensure = (needed) => {
    if (y + needed > MEMO_BOTTOM_LIMIT) {
      doc.addPage();
      y = onPageBreak(doc);
    }
  };
  blocks.forEach((block, idx) => {
    if (block.type === "h2" || block.type === "h3" || block.type === "h4") {
      const size = block.type === "h2" ? 11.5 : block.type === "h3" ? 10 : 9.2;
      if (idx > 0) y += block.type === "h2" ? 3.2 : block.type === "h3" ? 2.2 : 1.4; // air avant un titre
      ensure(size / 2.6 + 2);
      const lines = memoWrapSegments(doc, block.segments.map((s) => ({ ...s, bold: true })), width, size);
      y = memoDrawSegmentLines(doc, lines, x, y, size / 2.3, size, MEMO_INK);
      y += 1;
      return;
    }
    if (block.type === "p") {
      const lines = memoWrapSegments(doc, block.segments, width, 8.6);
      ensure(lines.length * 4 + 1);
      y = memoDrawSegmentLines(doc, lines, x, y, 4, 8.6, MEMO_INK);
      y += 1.6;
      return;
    }
    if (block.type === "li") {
      const lines = memoWrapSegments(doc, block.segments, width - 4, 8.6);
      ensure(lines.length * 4 + 0.5);
      doc.setFillColor(...MEMO_INK_SOFT);
      doc.circle(x + 1, y - 1.2, 0.5, "F");
      y = memoDrawSegmentLines(doc, lines, x + 4, y, 4, 8.6, MEMO_INK);
      y += 0.6;
      return;
    }
    if (block.type === "task") {
      const lines = memoWrapSegments(doc, block.segments, width - 5, 8.6);
      ensure(lines.length * 4 + 0.5);
      doc.setDrawColor(...(block.checked ? [23, 138, 76] : [133, 147, 170]));
      doc.setFillColor(...(block.checked ? [23, 138, 76] : [255, 255, 255]));
      doc.setLineWidth(0.3); // sinon hérite du trait épais d'un encadré précédent
      doc.roundedRect(x, y - 3, 3, 3, 0.6, 0.6, block.checked ? "FD" : "D");
      if (block.checked) {
        doc.setDrawColor(255, 255, 255);
        doc.setLineWidth(0.4);
        doc.line(x + 0.6, y - 1.6, x + 1.2, y - 0.9);
        doc.line(x + 1.2, y - 0.9, x + 2.4, y - 2.6);
      }
      y = memoDrawSegmentLines(doc, lines, x + 5, y, 4, 8.6, block.checked ? MEMO_INK_FAINT : MEMO_INK);
      y += 0.6;
      return;
    }
    if (block.type === "callout") {
      y = memoDrawCallout(doc, block, x, width, y, opts);
      return;
    }
    if (block.type === "table") {
      const cols = block.header.length;
      const colW = width / cols;
      ensure(6);
      doc.setFillColor(...MEMO_PAPER_SOFT);
      doc.rect(x, y - 3.6, width, 5.2, "F");
      doc.setFont("helvetica", "bold");
      doc.setFontSize(7.6);
      doc.setTextColor(...MEMO_INK_SOFT);
      block.header.forEach((seg, i) => {
        const t = projectPdfSafeText(seg.map((s) => s.text).join(""));
        doc.text(t, x + i * colW + 1.4, y);
      });
      y += 4.6;
      doc.setDrawColor(...MEMO_LINE);
      doc.setLineWidth(0.15);
      doc.line(x, y - 3, x + width, y - 3);
      block.rows.forEach((row) => {
        ensure(5);
        doc.setFont("helvetica", "normal");
        doc.setFontSize(7.6);
        doc.setTextColor(...MEMO_INK);
        row.forEach((seg, i) => {
          const t = projectPdfSafeText(seg.map((s) => s.text).join(""));
          doc.text(t, x + i * colW + 1.4, y);
        });
        y += 4.6;
        doc.setDrawColor(...MEMO_LINE);
        doc.line(x, y - 1.6, x + width, y - 1.6);
      });
      y += 1.6;
      return;
    }
  });
  return y;
}

async function downloadFicheMemoPdf(task, catalogs, { asBase64 = false, asDoc = false, logoDataUrl = NEXORA_LOGO_FULL, now = new Date() } = {}) {
  const raw = memoTaskFields(task, catalogs);
  // Libellés courts rendus tels quels par jsPDF : même nettoyage Windows-1252.
  const f = {
    ...raw,
    title: projectPdfSafeText(raw.title),
    checklist: raw.checklist.map((it) => ({ ...it, text: projectPdfSafeText(it.text) })),
    attachments: raw.attachments.map((a) => ({ ...a, name: projectPdfSafeText(a.name) })),
    dependencies: raw.dependencies.map((d) => ({ ...d, title: projectPdfSafeText(d.title) })),
  };
  const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
  const doc = new jsPDF({ unit: "mm", format: "a4" });
  let y = MEMO_MARGIN;

  // --------------------------------------------------------------- En-tête
  const titleMaxWidth = MEMO_CONTENT_W - (logoDataUrl ? 20 : 0);
  const titleSize = memoFitTitleFontSize(doc, f.title || "Sans titre", titleMaxWidth, 17, 9);
  if (logoDataUrl) { try { doc.addImage(logoDataUrl, undefined, MEMO_MARGIN, y - 2, 16, 8); } catch (_) {} }
  doc.setFont("helvetica", "bold");
  doc.setFontSize(titleSize);
  doc.setTextColor(...MEMO_INK);
  doc.text(f.title || "Sans titre", MEMO_MARGIN + (logoDataUrl ? 20 : 0), y + 3.5);
  y += 8;
  doc.setFont("helvetica", "normal");
  doc.setFontSize(7.6);
  doc.setTextColor(...MEMO_INK_FAINT);
  const exportDate = now.toLocaleDateString("fr-FR", { day: "numeric", month: "short", year: "numeric" });
  doc.text(`Fiche mémo · export du ${exportDate}`, MEMO_MARGIN + (logoDataUrl ? 20 : 0), y);
  y += 4;
  doc.setDrawColor(...MEMO_INK);
  doc.setLineWidth(0.5);
  doc.line(MEMO_MARGIN, y, MEMO_PAGE_W - MEMO_MARGIN, y);
  y += 7;

  // Ref #342 : la capsule « Jalon » suit le jour de début/fin, pas le champ
  // `milestone` brut (qui tient compte des horaires, #338) — sans effet ici :
  // f.milestone === true (jalon posé explicitement) l'active toujours.
  if (isMilestoneVisual(f)) {
    // Pas de glyphe Unicode (helvetica standard ne porte pas ◆ — octets
    // illisibles à l'impression) : le losange est dessiné, pas écrit, et la
    // largeur de la capsule se mesure sur le texte réel plutôt qu'un forfait
    // qui aurait pu le tronquer.
    const label = "Jalon";
    doc.setFont("helvetica", "bold");
    doc.setFontSize(7.2);
    const textW = doc.getTextWidth(label);
    const boxW = textW + 9;
    doc.setFillColor(...MEMO_INK);
    doc.roundedRect(MEMO_MARGIN, y - 3.6, boxW, 4.8, 1, 1, "F");
    const dx = MEMO_MARGIN + 3, dy = y - 1.2;
    doc.setFillColor(255, 255, 255);
    doc.triangle(dx, dy - 1.3, dx + 1.3, dy, dx, dy + 1.3, "F");
    doc.triangle(dx, dy - 1.3, dx - 1.3, dy, dx, dy + 1.3, "F");
    doc.setTextColor(255, 255, 255);
    doc.text(label, MEMO_MARGIN + 6, y - 0.4);
    y += 7;
  }

  // ------------------------------------------------------------ Métadonnées
  // Tout en haut de la fiche, sur toute la largeur et en deux colonnes
  // (retour de test #289) : uniquement les champs réellement présents.
  const metaRows = [];
  if (f.project) metaRows.push({ label: "Projet", chip: f.project });
  if (f.taskType) metaRows.push({ label: "Type", chip: f.taskType });
  if (f.status) metaRows.push({ label: "Statut", chip: f.status });
  if (f.criticality) metaRows.push({ label: "Priorité", chip: f.criticality });
  if (f.start) metaRows.push({ label: "Début", text: memoFmtFr(f.start) });
  if (f.end && f.end !== f.start) metaRows.push({ label: "Échéance", text: memoFmtFr(f.end) });
  if (f.responsible) metaRows.push({ label: "Responsable", responsible: f.responsible });
  if (f.progress != null) metaRows.push({ label: "Avancement", progress: f.progress });
  if (metaRows.length) {
    doc.setFont("helvetica", "bold");
    doc.setFontSize(7.4);
    doc.setTextColor(...MEMO_INK_SOFT);
    doc.text("MÉTADONNÉES", MEMO_MARGIN, y);
    doc.setDrawColor(...MEMO_LINE);
    doc.setLineWidth(0.2);
    doc.line(MEMO_MARGIN, y + 1.4, MEMO_PAGE_W - MEMO_MARGIN, y + 1.4);
    y += 6.4;
    const gap = 8;
    const colW = (MEMO_CONTENT_W - gap) / 2;
    const perCol = Math.ceil(metaRows.length / 2);
    metaRows.forEach((row, i) => {
      const col = i < perCol ? 0 : 1;
      const rx = MEMO_MARGIN + col * (colW + gap);
      const ry = y + (i % perCol) * 5.6;
      doc.setFont("helvetica", "normal");
      doc.setFontSize(7.8);
      doc.setTextColor(...MEMO_INK_FAINT);
      doc.text(row.label, rx, ry);
      if (row.chip) {
        doc.setFont("helvetica", "bold");
        doc.setFontSize(7.6);
        const w = doc.getTextWidth(projectPdfSafeText(row.chip.name)) + 4.8;
        memoRoundedChip(doc, rx + colW - w, ry - 3.4, row.chip.name, row.chip.color);
      } else if (row.text) {
        doc.setFont("helvetica", "bold");
        doc.setTextColor(...MEMO_INK);
        doc.text(row.text, rx + colW, ry, { align: "right" });
      } else if (row.responsible) {
        doc.setFont("helvetica", "bold");
        doc.setFontSize(8);
        doc.setTextColor(...MEMO_INK);
        doc.text(projectPdfSafeText(row.responsible.name), rx + colW - 8, ry, { align: "right" });
        doc.setFillColor(...memoHexToRgb(row.responsible.color));
        doc.circle(rx + colW - 3, ry - 1, 2.6, "F");
        doc.setFontSize(6.4);
        doc.setTextColor(...memoHexToRgb(memoContrastInk(row.responsible.color)));
        doc.text(row.responsible.initials, rx + colW - 3, ry - 0.4, { align: "center" });
      } else if (row.progress != null) {
        doc.setFont("helvetica", "bold");
        doc.setTextColor(...MEMO_INK);
        doc.text(`${row.progress} %`, rx + colW, ry, { align: "right" });
        const barX = rx + 22, barW = colW - 22 - 12;
        doc.setFillColor(237, 240, 245);
        doc.roundedRect(barX, ry - 1.8, barW, 1.6, 0.8, 0.8, "F");
        if (row.progress > 0) {
          doc.setFillColor(...MEMO_ACCENT);
          doc.roundedRect(barX, ry - 1.8, (barW * row.progress) / 100, 1.6, 0.8, 0.8, "F");
        }
      }
      doc.setDrawColor(237, 240, 245);
      doc.setLineWidth(0.2);
      doc.line(rx, ry + 1.6, rx + colW, ry + 1.6);
    });
    y += perCol * 5.6 + MEMO_SECTION_GAP;
  }

  // --------------------------------------------------------------- Sous-tâches
  // Après les métadonnées, avant la description.
  if (f.checklist.length) {
    if (y > MEMO_BOTTOM_LIMIT - 12) { doc.addPage(); y = memoDrawMiniHeader(doc, f.title, logoDataUrl); }
    doc.setFont("helvetica", "bold");
    doc.setFontSize(7.4);
    doc.setTextColor(...MEMO_INK_SOFT);
    doc.text("SOUS-TÂCHES", MEMO_MARGIN, y);
    doc.setDrawColor(...MEMO_LINE);
    doc.setLineWidth(0.2);
    doc.line(MEMO_MARGIN, y + 1.4, MEMO_PAGE_W - MEMO_MARGIN, y + 1.4);
    y += 5.4;
    f.checklist.forEach((item) => {
      const dateW = item.date ? 26 : 0;
      doc.setFont("helvetica", item.done ? "normal" : "bold");
      doc.setFontSize(8.4);
      const lines = doc.splitTextToSize(String(item.text), MEMO_CONTENT_W - 5 - dateW);
      if (y + lines.length * 3.8 > MEMO_BOTTOM_LIMIT - 2) { doc.addPage(); y = memoDrawMiniHeader(doc, f.title, logoDataUrl); }
      doc.setDrawColor(...(item.done ? [23, 138, 76] : [133, 147, 170]));
      doc.setFillColor(...(item.done ? [23, 138, 76] : [255, 255, 255]));
      doc.setLineWidth(0.2);
      doc.roundedRect(MEMO_MARGIN, y - 3, 3, 3, 0.6, 0.6, item.done ? "FD" : "D");
      if (item.done) {
        doc.setDrawColor(255, 255, 255);
        doc.setLineWidth(0.4);
        doc.line(MEMO_MARGIN + 0.6, y - 1.6, MEMO_MARGIN + 1.2, y - 0.9);
        doc.line(MEMO_MARGIN + 1.2, y - 0.9, MEMO_MARGIN + 2.4, y - 2.6);
      }
      doc.setFont("helvetica", item.done ? "normal" : "bold");
      doc.setFontSize(8.4);
      doc.setTextColor(...(item.done ? MEMO_INK_FAINT : MEMO_INK));
      doc.text(lines, MEMO_MARGIN + 5, y);
      if (item.date) {
        doc.setFont("helvetica", "normal");
        doc.setFontSize(7.4);
        doc.setTextColor(...MEMO_INK_FAINT);
        doc.text(memoFmtFr(item.date), MEMO_PAGE_W - MEMO_MARGIN, y, { align: "right" });
      }
      y += lines.length * 3.8 + 1.4;
    });
    y += MEMO_SECTION_GAP;
  }

  // --------------------------------------------------------------- Description
  // Toute la largeur de la page, paginée comme le compte rendu.
  if (f.hasDescription) {
    if (y > MEMO_BOTTOM_LIMIT - 12) { doc.addPage(); y = memoDrawMiniHeader(doc, f.title, logoDataUrl); }
    doc.setFont("helvetica", "bold");
    doc.setFontSize(7.4);
    doc.setTextColor(...MEMO_INK_SOFT);
    doc.text("DESCRIPTION", MEMO_MARGIN, y);
    doc.setDrawColor(...MEMO_LINE);
    doc.setLineWidth(0.2);
    doc.line(MEMO_MARGIN, y + 1.4, MEMO_PAGE_W - MEMO_MARGIN, y + 1.4);
    y += 6;
    y = memoDrawBlocks(doc, memoMarkdownBlocks(f.description), MEMO_MARGIN, MEMO_CONTENT_W, y, {
      onPageBreak: (d) => memoDrawMiniHeader(d, f.title, logoDataUrl),
    });
    y += MEMO_SECTION_GAP;
  }

  // ------------------------------------------------------------ Compte rendu
  if (f.hasReport) {
    if (y > MEMO_BOTTOM_LIMIT - 12) { doc.addPage(); y = memoDrawMiniHeader(doc, f.title, logoDataUrl); }
    doc.setFont("helvetica", "bold");
    doc.setFontSize(7.4);
    doc.setTextColor(...MEMO_INK_SOFT);
    doc.text("COMPTE RENDU", MEMO_MARGIN, y);
    doc.setDrawColor(...MEMO_LINE);
    doc.line(MEMO_MARGIN, y + 1.4, MEMO_PAGE_W - MEMO_MARGIN, y + 1.4);
    y += 6;
    y = memoDrawBlocks(doc, memoMarkdownBlocks(f.report), MEMO_MARGIN, MEMO_CONTENT_W, y, {
      onPageBreak: (d) => memoDrawMiniHeader(d, f.title, logoDataUrl),
    });
    y += MEMO_SECTION_GAP;
  }

  // ---------------------------------------------------------- Pièces jointes
  if (f.attachments.length) {
    if (y > MEMO_BOTTOM_LIMIT - 10) { doc.addPage(); y = memoDrawMiniHeader(doc, f.title, logoDataUrl); }
    doc.setFont("helvetica", "bold");
    doc.setFontSize(7.4);
    doc.setTextColor(...MEMO_INK_SOFT);
    doc.text("PIÈCES JOINTES", MEMO_MARGIN, y);
    y += 5;
    f.attachments.forEach((a) => {
      if (y > MEMO_BOTTOM_LIMIT - 6) { doc.addPage(); y = memoDrawMiniHeader(doc, f.title, logoDataUrl); }
      doc.setFont("helvetica", "normal");
      doc.setFontSize(8);
      doc.setTextColor(...MEMO_INK);
      doc.text(`— ${a.name}`, MEMO_MARGIN, y);
      y += 4.6;
    });
    y += MEMO_SECTION_GAP;
  }

  // ------------------------------------------------------------ Dépendances
  if (f.dependencies.length) {
    if (y > MEMO_BOTTOM_LIMIT - 10) { doc.addPage(); y = memoDrawMiniHeader(doc, f.title, logoDataUrl); }
    doc.setFont("helvetica", "bold");
    doc.setFontSize(7.4);
    doc.setTextColor(...MEMO_INK_SOFT);
    doc.text("DÉPENDANCES", MEMO_MARGIN, y);
    y += 5;
    f.dependencies.forEach((d) => {
      if (y > MEMO_BOTTOM_LIMIT - 6) { doc.addPage(); y = memoDrawMiniHeader(doc, f.title, logoDataUrl); }
      doc.setFont("helvetica", "normal");
      doc.setFontSize(8);
      doc.setTextColor(...MEMO_INK);
      doc.text(`— Dépend de : ${d.title}`, MEMO_MARGIN, y);
      y += 4.6;
    });
    y += MEMO_SECTION_GAP;
  }

  // ------------------------------------------------------- Frise chronologique
  // Chaque repère hebdomadaire porte sa date (retour de test #289) ; les
  // libellés ne se chevauchent jamais : une date qui toucherait sa voisine
  // est sautée, « Échéance » descend d'un cran si elle rattrape « Début », et
  // aucun libellé ne sort des marges.
  if (f.start) {
    const durationEnd = f.end || f.start;
    const start = new Date(f.start + "T00:00:00");
    const end = new Date(durationEnd + "T00:00:00");
    const rangeStart = new Date(start); rangeStart.setDate(rangeStart.getDate() - 31);
    const rangeEnd = new Date(end); rangeEnd.setDate(rangeEnd.getDate() + 31);
    const totalDays = Math.max(1, (rangeEnd - rangeStart) / 86400000);
    const xOf = (d) => MEMO_MARGIN + (((d - rangeStart) / 86400000 / totalDays) * MEMO_CONTENT_W);
    const clampText = (text, cx, size, bold) => {
      doc.setFont("helvetica", bold ? "bold" : "normal");
      doc.setFontSize(size);
      const w = doc.getTextWidth(text);
      const x1 = Math.max(MEMO_MARGIN, Math.min(cx - w / 2, MEMO_PAGE_W - MEMO_MARGIN - w));
      return { x1, x2: x1 + w, w };
    };
    const hasEnd = f.end && f.end !== f.start;
    const durX = xOf(start), durEndX = xOf(end);
    const startLabel = `Début · ${memoFmtFr(f.start)}`;
    const endLabel = hasEnd ? `Échéance · ${memoFmtFr(f.end)}` : "";
    const sBox = clampText(startLabel, durX, 6.6, true);
    const eBox = hasEnd ? clampText(endLabel, durEndX, 6.6, true) : null;
    const endRaised = !!eBox && eBox.x1 < sBox.x2 + 2;
    const timelineH = endRaised ? 30 : 26;
    if (y > MEMO_BOTTOM_LIMIT - timelineH) { doc.addPage(); y = memoDrawMiniHeader(doc, f.title, logoDataUrl); }
    y = Math.max(y, MEMO_BOTTOM_LIMIT - timelineH); // ancre en bas de la dernière page, comme l'aperçu validé
    doc.setFont("helvetica", "bold");
    doc.setFontSize(7.4);
    doc.setTextColor(...MEMO_INK_SOFT);
    doc.text("FRISE CHRONOLOGIQUE", MEMO_MARGIN, y);
    doc.setDrawColor(...MEMO_LINE);
    doc.setLineWidth(0.2);
    doc.line(MEMO_MARGIN, y + 1.4, MEMO_PAGE_W - MEMO_MARGIN, y + 1.4);
    const axisY = y + (endRaised ? 16 : 12);
    doc.setDrawColor(215, 220, 230);
    doc.setLineWidth(0.6);
    doc.line(MEMO_MARGIN, axisY, MEMO_PAGE_W - MEMO_MARGIN, axisY);
    // Portion réellement avancée, épaisse ; reste de la durée plus fin — même
    // mécanique que la Vue Métro.
    doc.setDrawColor(...MEMO_ACCENT);
    doc.setLineWidth(1);
    doc.setLineCap?.("round");
    doc.line(durX, axisY, durEndX, axisY);
    if (f.progress != null && f.progress > 0) {
      doc.setLineWidth(1.6);
      doc.line(durX, axisY, durX + ((durEndX - durX) * f.progress) / 100, axisY);
    }
    doc.setLineCap?.("butt");
    // Repères hebdomadaires (lundis) et leur date, sous l'axe.
    const firstTick = new Date(rangeStart);
    firstTick.setDate(firstTick.getDate() + ((8 - firstTick.getDay()) % 7));
    let lastLabelEnd = -Infinity;
    const todayInRange = today >= rangeStart && today <= rangeEnd;
    const todayTickX = todayInRange ? xOf(today) : null;
    for (let d = new Date(firstTick); d <= rangeEnd; d.setDate(d.getDate() + 7)) {
      const tx = xOf(d);
      doc.setDrawColor(...MEMO_LINE);
      doc.setLineWidth(0.25);
      doc.line(tx, axisY - 1.4, tx, axisY + 1.4);
      const label = d.toLocaleDateString("fr-FR", { day: "numeric", month: "short" });
      const box = clampText(label, tx, 5.6, false);
      if (box.x1 < lastLabelEnd + 1.5) continue;
      if (todayTickX != null && todayTickX > box.x1 - 1 && todayTickX < box.x2 + 1) continue; // le trait « Aujourd'hui » passerait dessus
      doc.setTextColor(...MEMO_INK_SOFT);
      doc.text(label, box.x1, axisY + 4.4);
      lastLabelEnd = box.x2;
    }
    // Stations Début / Échéance, centrées exactement sur l'axe.
    doc.setFillColor(255, 255, 255);
    doc.setDrawColor(...MEMO_ACCENT);
    doc.setLineWidth(0.7);
    doc.circle(durX, axisY, 1.3, "FD");
    doc.setFont("helvetica", "bold");
    doc.setFontSize(6.6);
    doc.setTextColor(...MEMO_INK);
    doc.text(startLabel, sBox.x1, axisY - 4);
    if (hasEnd) {
      doc.setDrawColor(...MEMO_INK_FAINT);
      doc.circle(durEndX, axisY, 1.3, "FD");
      const ey = endRaised ? axisY - 8 : axisY - 4;
      if (endRaised) { doc.setDrawColor(...MEMO_LINE); doc.setLineWidth(0.2); doc.line(durEndX, axisY - 1.6, durEndX, ey + 1); }
      doc.setFont("helvetica", "bold");
      doc.setFontSize(6.6);
      doc.setTextColor(...MEMO_INK);
      doc.text(endLabel, eBox.x1, ey);
    }
    if (todayInRange) {
      const todayX = todayTickX;
      doc.setDrawColor(...MEMO_INK);
      doc.setLineWidth(0.5);
      doc.line(todayX, axisY - 3, todayX, axisY + 5.6);
      const tBox = clampText("Aujourd'hui", todayX, 6.6, true);
      doc.setTextColor(...MEMO_INK);
      doc.text("Aujourd'hui", tBox.x1, axisY + 8.8);
    }
  }

  // -------------------------------------------------------- Pagination finale
  const totalPages = doc.internal.getNumberOfPages();
  for (let p = 1; p <= totalPages; p++) { doc.setPage(p); memoDrawFooter(doc, p, totalPages); }

  if (asDoc) return doc; // recette de rendu (tools/pdf-check)
  if (asBase64) {
    const dataUri = doc.output("datauristring");
    return dataUri.slice(dataUri.indexOf(",") + 1);
  }
  doc.save(memoFileName(f.title, iso(now)));
  return doc;
}

// === NEXORA:MEMO-PDF-DRAW:END ===

// ============================================================================
// Fiche projet PDF (#291) — synthèse A4 portrait d'un projet avec sa vue
// Métro. Export client uniquement : lecture des catalogues déjà chargés,
// aucune écriture Firestore, aucune mutation de tâche ou de projet, aucun
// effet sur la synchronisation Google Calendar. Les données et la projection
// Métro viennent des fonctions pures NEXORA:PROJECT-PDF-CORE (part-000) ; ce
// bloc ne fait que dessiner, en partageant avec la Fiche mémo (#289) le logo,
// la conversion de couleurs, le format de date et la pagination par en-tête
// minimal répété.
// ============================================================================
// === NEXORA:PROJECT-PDF-DRAW:START ===

const PPDF_PAGE_W = 210, PPDF_PAGE_H = 297, PPDF_M = 12;
const PPDF_CW = PPDF_PAGE_W - PPDF_M * 2;
const PPDF_BOTTOM = PPDF_PAGE_H - 10;
const PPDF_BG = "#EFF1F0";      // --bg
const PPDF_PAPER = "#FFFFFF";   // --surface
const PPDF_BORDER = "#DBDFDB";  // --border
const PPDF_HAIR = "#E6E9E7";    // --quai-clair : séparateurs internes
const PPDF_TEXT2 = "#495166";   // --text-secondary (8:1 sur blanc)
const PPDF_ACCENT = "#FF7A3D";  // --accent : repère « aujourd'hui », correspondances
const PPDF_ACCENT_TEXT = "#CB4000"; // --accent-text (AA sur blanc)
const PPDF_SUCCESS = "#1FA971"; // --success : station terminée
const PPDF_DANGER = "#E2483E";  // --danger : retard
const PPDF_DANGER_TEXT = "#D72C20";

function ppdfColor(doc, kind, hex) {
  const rgb = memoHexToRgb(hex);
  if (kind === "fill") doc.setFillColor(...rgb);
  else if (kind === "draw") doc.setDrawColor(...rgb);
  else doc.setTextColor(...rgb);
}
function ppdfFont(doc, size, style = "normal") {
  doc.setFont("helvetica", style);
  doc.setFontSize(size);
}
function ppdfWidth(doc, text, size, bold) {
  ppdfFont(doc, size, bold ? "bold" : "normal");
  return doc.getTextWidth(String(text));
}
function ppdfDash(doc, pattern) {
  if (typeof doc.setLineDashPattern === "function") doc.setLineDashPattern(pattern || [], 0);
}
// Micro-libellé : capitales espacées, gris secondaire lisible (AA).
function ppdfMicro(doc, text, x, y, { align = "left", color = PPDF_TEXT2, size = 5.8 } = {}) {
  ppdfFont(doc, size, "bold");
  ppdfColor(doc, "text", color);
  doc.text(projectPdfSafeText(text).toUpperCase(), x, y, { align, charSpace: 0.12 });
}
function ppdfMicroWidth(doc, text, size = 5.8) {
  const t = projectPdfSafeText(text).toUpperCase();
  return ppdfWidth(doc, t, size, true) + 0.12 * Math.max(0, t.length - 1);
}
// Micro-libellé contraint à une largeur de cellule : réduit sa taille, puis
// passe sur deux lignes — jamais tronqué, jamais sur le filet voisin.
function ppdfMicroFit(doc, text, x, y, maxW, { size = 5.4, color = PPDF_TEXT2 } = {}) {
  let s = size;
  while (s > 4.6 && ppdfMicroWidth(doc, text, s) > maxW) s -= 0.2;
  if (ppdfMicroWidth(doc, text, s) <= maxW) { ppdfMicro(doc, text, x, y, { size: s, color }); return 1; }
  const words = projectPdfSafeText(text).split(/\s+/);
  const lines = [];
  let cur = "";
  words.forEach((w) => { const c = cur ? cur + " " + w : w; if (ppdfMicroWidth(doc, c, s) <= maxW || !cur) cur = c; else { lines.push(cur); cur = w; } });
  if (cur) lines.push(cur);
  lines.forEach((l, i) => ppdfMicro(doc, l, x, y - (lines.length - 1 - i) * s * 0.4, { size: s, color }));
  return lines.length;
}
function ppdfWrap(doc, text, size, bold, maxW) {
  ppdfFont(doc, size, bold ? "bold" : "normal");
  const words = projectPdfSafeText(text).split(/\s+/).filter(Boolean);
  const lines = [];
  let cur = "";
  words.forEach((w) => {
    const cand = cur ? cur + " " + w : w;
    if (doc.getTextWidth(cand) <= maxW || !cur) cur = cand; else { lines.push(cur); cur = w; }
  });
  if (cur) lines.push(cur);
  // Mot plus large que la colonne : coupé, jamais tronqué.
  return lines.flatMap((l) => {
    if (doc.getTextWidth(l) <= maxW) return [l];
    const parts = [];
    let buf = "";
    for (const ch of l) { if (doc.getTextWidth(buf + ch) > maxW && buf) { parts.push(buf); buf = ch; } else buf += ch; }
    if (buf) parts.push(buf);
    return parts;
  });
}

// Pastille de catalogue (statut, type, criticité) : couleur du catalogue,
// encre choisie pour ≥ 4,5:1. Réduit sa taille plutôt que de déborder de
// `maxW`, puis passe sur deux lignes : jamais tronquée.
function ppdfChipLayout(doc, text, maxW, size = 6) {
  const label = projectPdfSafeText(text);
  let s = size;
  while (s > 5 && ppdfWidth(doc, label, s, true) + 3 > maxW) s -= 0.25;
  const lines = ppdfWidth(doc, label, s, true) + 3 > maxW ? ppdfWrap(doc, label, s, true, maxW - 3) : [label];
  const w = Math.min(maxW, Math.max(...lines.map((l) => ppdfWidth(doc, l, s, true))) + 3);
  return { lines, size: s, w, h: lines.length * (s * 0.42) + 1.9 };
}
function ppdfChip(doc, x, y, text, hex, maxW = 60, size = 6) {
  const c = projectPdfChipColors(hex);
  const L = ppdfChipLayout(doc, text, maxW, size);
  ppdfColor(doc, "fill", c.bg);
  doc.roundedRect(x, y, L.w, L.h, 0.7, 0.7, "F");
  ppdfFont(doc, L.size, "bold");
  ppdfColor(doc, "text", c.ink);
  L.lines.forEach((line, i) => doc.text(line, x + 1.5, y + 1.05 + (i + 1) * L.size * 0.42 - 0.35));
  return L;
}

// Texte détouré d'un halo papier (contour blanc sous le remplissage).
function ppdfHaloText(doc, text, x, y, color, halo = 0.55) {
  ppdfColor(doc, "draw", PPDF_PAPER);
  doc.setLineWidth(halo);
  ppdfDash(doc, null);
  doc.text(text, x, y, { renderingMode: "stroke" });
  ppdfColor(doc, "text", color);
  doc.text(text, x, y, { renderingMode: "fill" });
}
function ppdfDiamond(doc, x, y, r, fillHex, strokeHex) {
  if (fillHex) ppdfColor(doc, "fill", fillHex);
  if (strokeHex) ppdfColor(doc, "draw", strokeHex);
  const style = fillHex && strokeHex ? "FD" : fillHex ? "F" : "S";
  doc.lines([[r, r], [-r, r], [-r, -r], [r, -r]], x, y - r, [1, 1], style, true);
}
function ppdfCheck(doc, x, y, r) {
  doc.setDrawColor(255, 255, 255);
  doc.setLineWidth(Math.max(0.22, r * 0.28));
  doc.lines([[r * 0.38, r * 0.4], [r * 0.64, -r * 0.8]], x - r * 0.5, y, [1, 1], "S");
}
function ppdfLine(doc, pts) {
  if (pts.length < 2) return;
  doc.lines(pts.slice(1).map((p, i) => [p[0] - pts[i][0], p[1] - pts[i][1]]), pts[0][0], pts[0][1], [1, 1], "S");
}
// Même tracé que branchPath() de la Vue Métro : départ vertical, coude
// arrondi, puis horizontal jusqu'à la station de fin.
function ppdfBranchPoints(x0, y0, x1, y1, bend = 2.4) {
  if (Math.abs(x1 - x0) < 0.2) return [[x0, y0], [x0, y1]];
  const b = Math.min(bend, Math.abs(x1 - x0) / 2, Math.abs(y1 - y0) / 2);
  const dy = y1 > y0 ? 1 : -1, dx = x1 >= x0 ? 1 : -1;
  const pts = [[x0, y0], [x0, y1 - dy * b]];
  for (let i = 1; i <= 6; i++) {
    const a = (Math.PI / 2) * (i / 6);
    pts.push([x0 + dx * b * (1 - Math.cos(a)), y1 - dy * b * (1 - Math.sin(a))]);
  }
  pts.push([x1, y1]);
  return pts;
}
// Découpe une polyligne à une abscisse curviligne (portion réalisée).
function ppdfSplitPolyline(pts, ratio) {
  const segs = pts.slice(1).map((p, i) => Math.hypot(p[0] - pts[i][0], p[1] - pts[i][1]));
  const total = segs.reduce((s, v) => s + v, 0);
  let left = Math.max(0, Math.min(1, ratio)) * total;
  const a = [pts[0]];
  for (let i = 0; i < segs.length; i++) {
    if (left >= segs[i]) { a.push(pts[i + 1]); left -= segs[i]; continue; }
    const k = segs[i] ? left / segs[i] : 0;
    const mid = [pts[i][0] + (pts[i + 1][0] - pts[i][0]) * k, pts[i][1] + (pts[i + 1][1] - pts[i][1]) * k];
    a.push(mid);
    return [a, [mid, ...pts.slice(i + 1)]];
  }
  return [a, []];
}

// Image (logo projet, avatar) rendue dans un disque : le carré de l'image est
// posé puis ses coins sont masqués par un anneau de la couleur du fond — même
// résultat qu'un avatar rond de l'application, sans masque de découpe jsPDF.
function ppdfDiscImage(doc, dataUrl, x, y, r, bgHex) {
  try {
    doc.addImage(dataUrl, undefined, x - r, y - r, r * 2, r * 2);
  } catch (_) { return false; }
  ppdfColor(doc, "draw", bgHex);
  doc.setLineWidth(r * 0.5);
  doc.circle(x, y, r * 1.22, "S");
  return true;
}
function ppdfAvatar(doc, member, x, y, r, images, bgHex = PPDF_PAPER) {
  const src = member.image ? images.get(member.image.src) : null;
  ppdfColor(doc, "fill", member.color);
  doc.circle(x, y, r, "F");
  if (src && ppdfDiscImage(doc, src, x, y, r, bgHex)) return;
  const c = projectPdfChipColors(member.color);
  ppdfColor(doc, "fill", c.bg);
  doc.circle(x, y, r, "F");
  ppdfFont(doc, r * 2.3, "bold");
  ppdfColor(doc, "text", c.ink);
  doc.text(member.initials, x, y + r * 0.36, { align: "center" });
}

// Préchargement des images distantes (avatars, icône projet en URL) : une
// image qui refuse le chargement (CORS, hors ligne) retombe sur l'avatar à
// initiales / le marqueur de couleur — l'export ne dépend jamais du réseau.
async function ppdfLoadImages(sources, timeoutMs = 4000) {
  const out = new Map();
  await Promise.all([...new Set(sources.filter(Boolean).map((s) => JSON.stringify(s)))].map(async (json) => {
    const s = JSON.parse(json);
    if (s.kind === "data") { out.set(s.src, s.src); return; }
    if (typeof fetch !== "function" || typeof FileReader === "undefined") return;
    try {
      const ctrl = typeof AbortController !== "undefined" ? new AbortController() : null;
      const timer = setTimeout(() => ctrl && ctrl.abort(), timeoutMs);
      const res = await fetch(s.src, { mode: "cors", signal: ctrl ? ctrl.signal : undefined });
      clearTimeout(timer);
      if (!res.ok) return;
      const blob = await res.blob();
      if (!/image\/(png|jpe?g)/i.test(blob.type)) return;
      const dataUrl = await new Promise((resolve, reject) => {
        const fr = new FileReader();
        fr.onload = () => resolve(fr.result);
        fr.onerror = reject;
        fr.readAsDataURL(blob);
      });
      out.set(s.src, dataUrl);
    } catch (_) { /* repli initiales / marqueur */ }
  }));
  return out;
}

function ppdfPanel(doc, x, y, w, h) {
  ppdfColor(doc, "fill", PPDF_PAPER);
  ppdfColor(doc, "draw", PPDF_BORDER);
  doc.setLineWidth(0.2);
  ppdfDash(doc, null);
  doc.rect(x, y, w, h, "FD");
}
function ppdfPageBackground(doc) {
  ppdfColor(doc, "fill", PPDF_BG);
  doc.rect(0, 0, PPDF_PAGE_W, PPDF_PAGE_H, "F");
}

// --- En-têtes ----------------------------------------------------------------
function ppdfProjectMarker(doc, data, x, y, r, images) {
  ppdfColor(doc, "fill", data.project.color);
  doc.circle(x, y, r, "F");
  const src = data.project.image ? images.get(data.project.image.src) : null;
  if (src) ppdfDiscImage(doc, src, x, y, r * 0.78, data.project.color);
}
function ppdfHeaderLayout(doc, data) {
  const logoW = 26;
  const nameX = PPDF_M + logoW + 11;
  const maxW = PPDF_PAGE_W - PPDF_M - nameX - 14;
  const name = projectPdfSafeText(data.project.name) || "Projet";
  let size = 17;
  while (size > 11 && ppdfWidth(doc, name, size, true) > maxW) size -= 0.5;
  const lines = ppdfWidth(doc, name, size, true) > maxW ? ppdfWrap(doc, name, size, true, maxW) : [name];
  return { logoW, nameX, size, lines, h: Math.max(15, lines.length * size * 0.43 + 6) };
}
function ppdfDrawHeader(doc, data, H, logoDataUrl, images) {
  const y = PPDF_M;
  if (logoDataUrl) { try { doc.addImage(logoDataUrl, undefined, PPDF_M, y, H.logoW, H.logoW / 2); } catch (_) {} }
  ppdfColor(doc, "draw", PPDF_BORDER);
  doc.setLineWidth(0.2);
  doc.line(PPDF_M + H.logoW + 4, y + 1, PPDF_M + H.logoW + 4, y + H.h - 3);
  const textH = H.lines.length * H.size * 0.43;
  const top = y + (H.h - 2 - textH) / 2;
  const firstBaseline = top + H.size * 0.43 - 0.6;
  ppdfProjectMarker(doc, data, H.nameX - 3.4, firstBaseline - H.size * 0.3528 * 0.36, 1.8, images);
  ppdfFont(doc, H.size, "bold");
  ppdfColor(doc, "text", PPDF_INK);
  H.lines.forEach((l, i) => doc.text(l, H.nameX, top + (i + 1) * H.size * 0.43 - 0.6));
  ppdfColor(doc, "draw", PPDF_INK);
  doc.setLineWidth(0.45);
  doc.line(PPDF_M, y + H.h, PPDF_PAGE_W - PPDF_M, y + H.h);
  return y + H.h + 4;
}
function ppdfDrawMiniHeader(doc, data, logoDataUrl, images) {
  const y = PPDF_M;
  if (logoDataUrl) { try { doc.addImage(logoDataUrl, undefined, PPDF_M, y - 0.5, 12, 6); } catch (_) {} }
  const name = projectPdfSafeText(data.project.name);
  const maxW = PPDF_CW - 16 - 22;
  let size = 8.5;
  while (size > 6 && ppdfWidth(doc, name, size, true) > maxW) size -= 0.25;
  const lines = ppdfWidth(doc, name, size, true) > maxW ? ppdfWrap(doc, name, size, true, maxW) : [name];
  ppdfProjectMarker(doc, data, PPDF_M + 16.5, y + 2.4, 1.3, images);
  ppdfFont(doc, size, "bold");
  ppdfColor(doc, "text", PPDF_INK);
  lines.forEach((l, i) => doc.text(l, PPDF_M + 19, y + 3.4 + i * size * 0.42));
  const bottom = y + Math.max(7, 3.4 + lines.length * size * 0.42 + 1.4);
  ppdfColor(doc, "draw", PPDF_BORDER);
  doc.setLineWidth(0.2);
  doc.line(PPDF_M, bottom, PPDF_PAGE_W - PPDF_M, bottom);
  return bottom + 4;
}
function ppdfDrawPageNumber(doc, n, total) {
  ppdfMicro(doc, `${n} / ${total}`, PPDF_PAGE_W - PPDF_M, PPDF_M + 3.4, { align: "right" });
}

// --- Synthèse ----------------------------------------------------------------
function ppdfSynthesisCells(data) {
  const c = data.counts;
  const cells = [
    { label: "Tâches", value: String(c.total), sub: `${c.active} active${c.active > 1 ? "s" : ""}`, w: 19 },
    { label: "En cours", value: String(c.inProgress), dot: data.statusColors.inProgress, w: 18 },
    { label: "Terminées", value: String(c.done), dot: data.statusColors.done, w: 19 },
  ];
  if (c.waitingThird != null) cells.push({ label: "Attente tiers", value: String(c.waitingThird), dot: data.statusColors.waitingThird, w: 22 });
  if (data.progress != null) cells.push({ label: "Avancement", value: `${data.progress} %`, bar: data.progress, w: 22 });
  if (data.period) cells.push({ label: "Période", lines: [projectPdfFmtDate(data.period.start), projectPdfFmtDate(data.period.end)], w: 25 });
  if (data.nextCritical) cells.push({ label: "Prochaine échéance critique", critical: data.nextCritical, w: 0 });
  const fixed = cells.reduce((s, x) => s + x.w, 0);
  const flex = cells.filter((x) => !x.w);
  const rest = PPDF_CW - fixed;
  if (flex.length) flex.forEach((x) => { x.w = rest / flex.length; });
  else { const k = PPDF_CW / fixed; cells.forEach((x) => { x.w *= k; }); }
  return cells;
}
function ppdfCriticalLines(doc, crit, w) {
  const lines = ppdfWrap(doc, crit.row.title, 7.4, true, w - 5);
  const tags = [projectPdfFmtDate(crit.date)];
  return { lines, tags };
}
function ppdfSynthesisLayout(doc, data) {
  const cells = ppdfSynthesisCells(data);
  let kpiH = 17;
  cells.forEach((cell) => {
    if (cell.critical) {
      const L = ppdfCriticalLines(doc, cell.critical, cell.w);
      cell.layout = L;
      kpiH = Math.max(kpiH, 6.5 + L.lines.length * 3.2 + 6.8);
    }
  });
  // Répartition des tâches actives par statut et par type (vraies pastilles).
  const groups = [];
  if (data.byStatus.length) groups.push({ label: "Actives par statut", items: data.byStatus });
  if (data.byType.length) groups.push({ label: "Actives par type", items: data.byType });
  const labelW = 30;
  const rows = [];
  groups.forEach((g) => {
    let x = 0, line = 0;
    const placed = g.items.map((it) => {
      const text = `${it.name}  ${it.count}`;
      const L = ppdfChipLayout(doc, text, PPDF_CW - labelW - 8);
      if (x && x + L.w > PPDF_CW - labelW - 8) { x = 0; line++; }
      const p = { it, text, x, line, L };
      x += L.w + 1.6;
      return p;
    });
    rows.push({ ...g, placed, h: (line + 1) * 5.4 });
  });
  const urgent = data.urgent.length ? {
    text: data.urgent.slice(0, 3).map((r) => `${projectPdfSafeText(r.title)} (${projectPdfFmtDate(r.end)}${r.late ? ", en retard" : ""})`).join(" ; ")
      + (data.urgent.length > 3 ? ` ; +${data.urgent.length - 3}` : ""),
  } : null;
  if (urgent) urgent.lines = ppdfWrap(doc, urgent.text, 6.6, false, PPDF_CW - 30);
  const distH = rows.reduce((s, r) => s + r.h, 0);
  const h = kpiH + (urgent ? urgent.lines.length * 2.9 + 3.4 : 0) + (rows.length ? distH + 3.2 : 0);
  return { cells, kpiH, rows, labelW, urgent, h };
}
function ppdfDrawSynthesis(doc, data, S, y) {
  ppdfPanel(doc, PPDF_M, y, PPDF_CW, S.h);
  let x = PPDF_M;
  S.cells.forEach((cell, i) => {
    const cx = x + 3;
    if (i) { ppdfColor(doc, "draw", PPDF_HAIR); doc.setLineWidth(0.2); doc.line(x, y + 2.5, x, y + S.kpiH - 2.5); }
    ppdfMicroFit(doc, cell.label, cx, y + 5.6, cell.w - 5, { size: cell.critical ? 5.6 : 5.4 });
    if (cell.value != null) {
      ppdfFont(doc, 13, "bold");
      ppdfColor(doc, "text", PPDF_INK);
      let vx = cx;
      if (cell.dot) { ppdfColor(doc, "fill", cell.dot); doc.circle(cx + 1.1, y + 10.4, 1.1, "F"); vx += 3.2; }
      ppdfFont(doc, 13, "bold");
      ppdfColor(doc, "text", PPDF_INK);
      doc.text(cell.value, vx, y + 12);
      if (cell.sub) { ppdfFont(doc, 6.2, "normal"); ppdfColor(doc, "text", PPDF_TEXT2); doc.text(cell.sub, cx, y + 15.4); }
      if (cell.bar != null) {
        const bw = cell.w - 6;
        ppdfColor(doc, "fill", PPDF_HAIR);
        doc.rect(cx, y + 14, bw, 1.1, "F");
        if (cell.bar > 0) { ppdfColor(doc, "fill", data.project.color); doc.rect(cx, y + 14, (bw * cell.bar) / 100, 1.1, "F"); }
      }
    }
    if (cell.lines) {
      ppdfFont(doc, 7.6, "bold");
      ppdfColor(doc, "text", PPDF_INK);
      doc.text(cell.lines[0], cx, y + 9.8);
      ppdfFont(doc, 6.2, "normal");
      ppdfColor(doc, "text", PPDF_TEXT2);
      doc.text("au", cx, y + 12.6);
      ppdfFont(doc, 7.6, "bold");
      ppdfColor(doc, "text", PPDF_INK);
      doc.text(cell.lines[1], cx, y + 15.4);
    }
    if (cell.critical) {
      const L = cell.layout, crit = cell.critical;
      const markerColor = crit.row.criticality?.color || crit.row.status?.color || PPDF_INK;
      if (crit.row.milestone) ppdfDiamond(doc, cx + 1.2, y + 8.6, 1.2, markerColor, null);
      else { ppdfColor(doc, "fill", markerColor); doc.circle(cx + 1.2, y + 8.6, 1.1, "F"); }
      ppdfFont(doc, 7.4, "bold");
      ppdfColor(doc, "text", PPDF_INK);
      L.lines.forEach((l, k) => doc.text(l, cx + 3.6, y + 9.6 + k * 3.2));
      let ty = y + 9.6 + L.lines.length * 3.2 + 0.6;
      let tx = cx + 3.6;
      ppdfFont(doc, 6.6, "bold");
      ppdfColor(doc, "text", crit.overdue ? PPDF_DANGER_TEXT : PPDF_TEXT2);
      doc.text(L.tags[0], tx, ty + 1.2);
      tx += ppdfWidth(doc, L.tags[0], 6.6, true) + 2;
      if (crit.row.criticality) tx += ppdfChip(doc, tx, ty - 1.6, crit.row.criticality.name, crit.row.criticality.color, 30, 5.6).w + 1.2;
      if (crit.overdue) ppdfChip(doc, tx, ty - 1.6, "En retard", PPDF_DANGER, 30, 5.6);
    }
    x += cell.w;
  });
  let cy = y + S.kpiH;
  if (S.urgent) {
    ppdfColor(doc, "draw", PPDF_HAIR);
    doc.setLineWidth(0.2);
    doc.line(PPDF_M + 3, cy, PPDF_M + PPDF_CW - 3, cy);
    const L = ppdfChip(doc, PPDF_M + 3, cy + 1.6, `Urgent · ${data.urgent.length}`, "#DC2626", 26, 5.6);
    ppdfFont(doc, 6.6, "normal");
    ppdfColor(doc, "text", PPDF_INK);
    S.urgent.lines.forEach((l, k) => doc.text(l, PPDF_M + 3 + L.w + 2.4, cy + 4.2 + k * 2.9));
    cy += S.urgent.lines.length * 2.9 + 3.4;
  }
  if (S.rows.length) {
    ppdfColor(doc, "draw", PPDF_HAIR);
    doc.setLineWidth(0.2);
    doc.line(PPDF_M + 3, cy, PPDF_M + PPDF_CW - 3, cy);
    cy += 1.6;
    S.rows.forEach((r) => {
      ppdfMicro(doc, r.label, PPDF_M + 3, cy + 3.3, { size: 5.2 });
      r.placed.forEach((p) => ppdfChip(doc, PPDF_M + 3 + S.labelW + p.x, cy + 0.6 + p.line * 5.4, p.text, p.it.color, PPDF_CW - S.labelW - 8));
      cy += r.h;
    });
  }
  return y + S.h + 4;
}

// --- Vue Métro ---------------------------------------------------------------
function ppdfLegendItems(proj) {
  const L = proj.legend, items = [];
  if (L.milestone) items.push({ key: "milestone", label: "Jalon" });
  if (L.action) items.push({ key: "action", label: "Action" });
  if (L.done) items.push({ key: "done", label: "Terminé" });
  if (L.future) items.push({ key: "future", label: "Prévu" });
  if (L.late) items.push({ key: "late", label: "En retard" });
  if (L.dependency) items.push({ key: "dependency", label: "Dépendance" });
  if (L.correspondence) items.push({ key: "correspondence", label: "Correspondance" });
  if (L.shared) items.push({ key: "shared", label: "Tronc commun" });
  if (L.today) items.push({ key: "today", label: "Aujourd'hui" });
  return items;
}
function ppdfDrawLegendGlyph(doc, key, x, y, color) {
  doc.setLineWidth(0.35);
  ppdfDash(doc, null);
  if (key === "milestone") ppdfDiamond(doc, x + 1.3, y, 1.1, color, null);
  else if (key === "action") { ppdfColor(doc, "fill", PPDF_PAPER); ppdfColor(doc, "draw", color); doc.circle(x + 1.3, y, 0.95, "FD"); }
  else if (key === "done") { ppdfColor(doc, "fill", PPDF_SUCCESS); doc.circle(x + 1.3, y, 1.05, "F"); ppdfCheck(doc, x + 1.3, y, 1.05); }
  else if (key === "future") { ppdfColor(doc, "draw", color); doc.setLineWidth(0.5); ppdfDash(doc, [0.8, 0.6]); doc.line(x, y, x + 3.2, y); ppdfDash(doc, null); return 3.2; }
  else if (key === "late") { ppdfColor(doc, "draw", PPDF_DANGER); doc.setLineWidth(0.4); doc.circle(x + 1.3, y, 1.1, "S"); }
  else if (key === "dependency") { ppdfColor(doc, "draw", PPDF_TEXT2); doc.setLineWidth(0.3); ppdfDash(doc, [0.25, 0.6]); doc.line(x, y, x + 3.2, y); ppdfDash(doc, null); return 3.2; }
  else if (key === "correspondence") { ppdfColor(doc, "fill", PPDF_PAPER); ppdfColor(doc, "draw", PPDF_ACCENT); doc.setLineWidth(0.3); doc.circle(x + 1.3, y, 1.25, "FD"); ppdfColor(doc, "fill", PPDF_ACCENT); doc.circle(x + 1.3, y, 0.45, "F"); }
  else if (key === "shared") { ppdfColor(doc, "draw", color); doc.setLineWidth(0.45); doc.line(x, y - 0.35, x + 3.2, y - 0.35); ppdfColor(doc, "draw", PPDF_ACCENT); doc.line(x, y + 0.35, x + 3.2, y + 0.35); return 3.2; }
  else if (key === "today") { ppdfColor(doc, "draw", PPDF_ACCENT); doc.setLineWidth(0.35); doc.line(x + 1.3, y - 1.3, x + 1.3, y + 1.3); }
  return 2.6;
}
function ppdfMetroLayout(doc, data, availableH) {
  const innerW = PPDF_CW - 8;
  const measure = (text, size, bold) => ppdfWidth(doc, text, size, bold);
  const build = (spacing) => projectPdfMetroProjection(data, { width: innerW, measure, maxHeight: 150, spacing });
  let proj = null;
  // Aère le tracé quand la page le permet, sans jamais pousser le reste ; le
  // mode numéroté (projet trop dense) n'est retenu qu'à l'espacement normal.
  for (const spacing of [2, 1.75, 1.5, 1.25, 1]) {
    const p = build(spacing);
    if (!p) break;
    if (spacing === 1 || (!p.numbered && p.height + 24 <= availableH)) { proj = p; break; }
  }
  if (!proj) return null;
  const legend = ppdfLegendItems(proj);
  const titleW = ppdfMicroWidth(doc, "Vue Métro", 6.2) + 6;
  let lx = 0, lrow = 0;
  const legendPlaced = legend.map((it) => {
    const w = 3.6 + ppdfWidth(doc, it.label, 5.8, false) + 3;
    if (lx && lx + w > PPDF_CW - 8 - titleW) { lx = 0; lrow++; }
    const p = { ...it, x: lx, row: lrow };
    lx += w;
    return p;
  });
  const headH = 7 + lrow * 3.6;
  const axisH = 5;
  const footH = proj.todayX != null ? 5 : 2.5;
  const index = proj.numbered ? proj.stations.map((s) => ({ s, lines: ppdfWrap(doc, `${s.number}. ${s.item.t.title}`, 6.4, false, (PPDF_CW - 14) / 2 - 22) })) : [];
  return { proj, innerW, legendPlaced, titleW, headH, axisH, footH, h: headH + axisH + proj.height + footH, index };
}
function ppdfDrawMetro(doc, data, ML, y) {
  const { proj } = ML;
  ppdfPanel(doc, PPDF_M, y, PPDF_CW, ML.h);
  ppdfMicro(doc, "Vue Métro", PPDF_M + 3, y + 4.8, { size: 6.2 });
  ML.legendPlaced.forEach((it) => {
    const lx = PPDF_M + 3 + ML.titleW + it.x, ly = y + 4 + it.row * 3.6;
    const gw = ppdfDrawLegendGlyph(doc, it.key, lx, ly, data.project.color);
    ppdfFont(doc, 5.8, "normal");
    ppdfColor(doc, "text", PPDF_TEXT2);
    doc.text(it.label, lx + gw + 1, ly + 0.9);
  });
  const ox = PPDF_M + 4;
  const axisY = y + ML.headH + 3.2;
  const top = y + ML.headH + ML.axisH;
  const oy = top - proj.top;
  const bottom = top + proj.height;
  const X = (x) => ox + x, Y = (v) => oy + v;
  const lineColor = data.project.color;
  const today = data.today;

  // Colonnes temporelles (mêmes séparateurs que la Vue Métro), en fond.
  let lastLabelEnd = -Infinity;
  proj.separators.forEach((s) => {
    if (!s.clamped) {
      ppdfColor(doc, "draw", PPDF_HAIR);
      doc.setLineWidth(0.2);
      ppdfDash(doc, null);
      doc.line(X(s.x), axisY + 1.2, X(s.x), bottom);
    }
    const w = ppdfMicroWidth(doc, s.label, 5.2);
    const lx = Math.min(X(s.x) + 0.8, PPDF_M + PPDF_CW - 3 - w);
    if (lx > lastLabelEnd + 1.5) { ppdfMicro(doc, s.label, lx, axisY, { size: 5.2 }); lastLabelEnd = lx + w; }
  });
  // Repère « aujourd'hui » : trait fin derrière le tracé.
  if (proj.todayX != null) {
    ppdfColor(doc, "draw", PPDF_ACCENT);
    doc.setLineWidth(0.3);
    doc.line(X(proj.todayX), top - 1, X(proj.todayX), bottom + 1);
    ppdfColor(doc, "fill", PPDF_ACCENT);
    doc.triangle(X(proj.todayX) - 1, top - 1.8, X(proj.todayX) + 1, top - 1.8, X(proj.todayX), top - 0.4, "F");
    ppdfFont(doc, 5.4, "bold");
    ppdfColor(doc, "text", PPDF_ACCENT_TEXT);
    const label = "Aujourd'hui";
    const w = ppdfWidth(doc, label, 5.4, true);
    const lx = Math.max(PPDF_M + 2, Math.min(X(proj.todayX) - w / 2, PPDF_M + PPDF_CW - 2 - w));
    doc.text(label, lx, bottom + 3.4);
  }

  // Dépendances intra-projet : connecteur pointillé discret, sous le reste.
  proj.connectors.forEach((c) => {
    const midX = (c.x1 + c.x2) / 2;
    ppdfColor(doc, "draw", PPDF_TEXT2);
    doc.setLineWidth(0.3);
    ppdfDash(doc, [0.25, 0.7]);
    ppdfLine(doc, [[X(c.x1), Y(c.y1)], [X(midX), Y(c.y1)], [X(midX), Y(c.y2)], [X(c.x2), Y(c.y2)]]);
    ppdfDash(doc, null);
  });

  // Ligne du projet : réalisée pleine jusqu'à aujourd'hui, prévue en
  // pointillé au-delà ; portion d'avancement en trait épais (règle Métro).
  const xs = X(proj.xStart), xe = X(proj.xEnd), my = Y(0);
  const splitX = today <= data.period.start ? xs : today >= data.period.end ? xe : X(proj.todayX);
  ppdfColor(doc, "draw", lineColor);
  doc.setLineCap && doc.setLineCap("round");
  doc.setLineWidth(0.9);
  if (splitX > xs) doc.line(xs, my, splitX, my);
  if (xe > splitX) { ppdfDash(doc, [1.2, 0.9]); doc.line(splitX, my, xe, my); ppdfDash(doc, null); }
  if (proj.progress > 0) { doc.setLineWidth(1.6); doc.line(xs, my, xs + (xe - xs) * (proj.progress / 100), my); }
  // Départ (station) et butoir de fin, comme la Vue Métro.
  ppdfColor(doc, "fill", PPDF_PAPER);
  doc.setLineWidth(0.6);
  doc.circle(xs, my, 1.9, "FD");
  // Butoir : barre perpendiculaire + demi-disque plein (Terminus de la Vue Métro).
  doc.setLineWidth(0.7);
  doc.line(xe + 1.2, my - 2.2, xe + 1.2, my + 2.2);
  ppdfColor(doc, "fill", lineColor);
  const half = [];
  for (let k = 0; k <= 10; k++) { const a = -Math.PI / 2 + (Math.PI * k) / 10; half.push([xe + 1.9 + 1.6 * Math.cos(a), my + 1.6 * Math.sin(a)]); }
  doc.lines(half.slice(1).map((p, k) => [p[0] - half[k][0], p[1] - half[k][1]]), half[0][0], half[0][1], [1, 1], "F", true);

  // Tracés des stations (bifurcations, tiges des jalons), puis stations, puis libellés.
  const partnerColor = (t) => (data.partners.find((p) => p.id === t.partnerId) || {}).color || PPDF_ACCENT;
  proj.stations.forEach((s) => {
    const t = s.item.t;
    const color = t.status?.color || lineColor;
    if (s.item.kind === "milestone") {
      ppdfColor(doc, "draw", color);
      doc.setLineWidth(0.45);
      ppdfDash(doc, [0.25, 0.9]);
      doc.line(X(s.xEnd), my, X(s.xEnd), Y(s.y));
      ppdfDash(doc, null);
      return;
    }
    const pts = ppdfBranchPoints(X(s.xStart), my, X(s.xEnd), Y(s.y));
    const pct = t.done ? 100 : t.progress || 0;
    const existing = t.start <= today; // départ déjà passé : bifurcation existante
    const [doneSeg, restSeg] = ppdfSplitPolyline(pts, pct / 100);
    const strokes = t.shared ? [[color, -0.3], [partnerColor(t), 0.3]] : [[color, 0]];
    strokes.forEach(([c, off]) => {
      const shift = (p) => p.map(([px, py]) => [px, py + off]);
      ppdfColor(doc, "draw", c);
      doc.setLineWidth(t.shared ? 0.45 : 0.5);
      if (restSeg.length > 1) {
        if (!existing || !t.done) ppdfDash(doc, [1, 0.8]);
        ppdfLine(doc, shift(restSeg));
        ppdfDash(doc, null);
      }
      if (pct > 0 && doneSeg.length > 1) { doc.setLineWidth(t.shared ? 0.7 : 1); ppdfLine(doc, shift(doneSeg)); }
    });
    // Départ de bifurcation sur la ligne.
    ppdfColor(doc, "fill", PPDF_PAPER);
    ppdfColor(doc, "draw", color);
    doc.setLineWidth(0.4);
    doc.circle(X(s.xStart), my, 0.75, "FD");
  });

  // Correspondances inter-projets : double anneau sous la station.
  proj.correspondences.forEach((c) => {
    const cx = X(c.x), cy = Y(c.y);
    ppdfColor(doc, "fill", PPDF_PAPER);
    ppdfColor(doc, "draw", c.color || PPDF_ACCENT);
    doc.setLineWidth(0.35);
    ppdfDash(doc, [0.5, 0.5]);
    doc.circle(cx, cy, 3.1, "FD");
    ppdfDash(doc, null);
    ppdfColor(doc, "draw", PPDF_ACCENT);
    doc.circle(cx, cy, 2.45, "S");
  });

  proj.stations.forEach((s) => {
    const t = s.item.t;
    const color = t.status?.color || lineColor;
    const sx = X(s.xEnd), sy = Y(s.y);
    if (s.item.kind === "milestone") {
      // Station sur la ligne (anneau à la couleur du statut), losange au bout de la tige.
      ppdfColor(doc, "fill", t.done ? PPDF_SUCCESS : PPDF_PAPER);
      ppdfColor(doc, "draw", t.done ? PPDF_SUCCESS : color);
      doc.setLineWidth(0.6);
      doc.circle(sx, my, 1.6, "FD");
      if (t.done) ppdfCheck(doc, sx, my, 1.6);
      if (t.late) { ppdfColor(doc, "draw", PPDF_DANGER); doc.setLineWidth(0.4); doc.circle(sx, my, 2.3, "S"); }
      ppdfColor(doc, "draw", PPDF_PAPER);
      doc.setLineWidth(0.35);
      ppdfDiamond(doc, sx, sy, 1.9, t.done ? PPDF_SUCCESS : color, PPDF_PAPER);
      if (t.done) ppdfCheck(doc, sx, sy, 1.25);
      if (t.late) { ppdfColor(doc, "draw", PPDF_DANGER); doc.setLineWidth(0.4); ppdfDiamond(doc, sx, sy, 2.6, null, PPDF_DANGER); }
    } else {
      if (t.late) { ppdfColor(doc, "draw", PPDF_DANGER); doc.setLineWidth(0.4); doc.circle(sx, sy, 2.2, "S"); }
      if (t.done) {
        ppdfColor(doc, "fill", PPDF_SUCCESS);
        doc.circle(sx, sy, 1.5, "F");
        ppdfCheck(doc, sx, sy, 1.5);
      } else {
        ppdfColor(doc, "fill", PPDF_PAPER);
        ppdfColor(doc, "draw", t.shared ? partnerColor(t) : color);
        doc.setLineWidth(t.shared ? 0.35 : 0.55);
        doc.circle(sx, sy, 1.5, "FD");
        if (t.shared) { ppdfColor(doc, "draw", color); doc.circle(sx, sy, 0.9, "S"); }
      }
    }
  });

  // Libellés posés APRÈS toutes les stations, sans fond opaque : un fin halo
  // papier autour des lettres suffit à les détacher d'un tracé qui passerait
  // dessous, sans masquer la ligne, les bifurcations ni les stations — même
  // principe que le halo `paint-order: stroke` des libellés de la Vue Métro.
  // Les libellés ne se chevauchent jamais entre eux (garanti par la projection).
  proj.stations.forEach((s) => {
    const t = s.item.t;
    const bx = X(s.box.x1), by = Y(s.box.y1);
    if (proj.numbered) {
      ppdfFont(doc, 6.4, "bold");
      ppdfHaloText(doc, s.titleLines[0], bx + 0.6, by + 2.9, PPDF_INK);
      return;
    }
    ppdfFont(doc, 6.6, "bold");
    s.titleLines.forEach((l, k) => ppdfHaloText(doc, l, bx + 0.6, by + 2.6 + k * 2.9, t.done ? PPDF_TEXT2 : PPDF_INK));
    if (s.meta) {
      ppdfFont(doc, 5.4, "normal");
      ppdfHaloText(doc, s.meta, bx + 0.6, by + 2.6 + s.titleLines.length * 2.9 + 0.1, t.late ? PPDF_DANGER_TEXT : PPDF_TEXT2);
    }
  });

  // Point courant accentué : position d'aujourd'hui sur la ligne.
  if (proj.todayX != null) {
    ppdfColor(doc, "fill", PPDF_ACCENT);
    ppdfColor(doc, "draw", PPDF_PAPER);
    doc.setLineWidth(0.5);
    doc.circle(X(proj.todayX), my, 1.25, "FD");
  }
  doc.setLineCap && doc.setLineCap("butt");
  return y + ML.h + 4;
}

// --- Tableau des tâches actives -----------------------------------------------
const PPDF_COLS = [
  { key: "task", label: "Tâche", w: 84 },
  { key: "status", label: "Statut", w: 24 },
  { key: "type", label: "Type", w: 22 },
  { key: "date", label: "Date / fin", w: 27 },
  { key: "owner", label: "Responsable", w: PPDF_CW - 84 - 24 - 22 - 27 },
];
const PPDF_ROW_H = 6.2;
// Une tâche = une ligne. Le titre réduit sa taille (7,2 → 5,6 pt) pour tenir
// à côté de ses marqueurs (avancement, criticité) ; il ne passe sur deux
// lignes qu'en tout dernier recours — jamais tronqué. Le losange de début de
// ligne signale un jalon, la date en rouge un retard, la pastille « Terminé »
// le dernier jalon franchi : aucun libellé supplémentaire n'est nécessaire.
function ppdfTaskRowLayout(doc, r) {
  const colW = PPDF_COLS[0].w - 7.5;
  const crit = r.criticality ? ppdfChipLayout(doc, r.criticality.name, 20, 5.4) : null;
  const pct = r.progress != null && r.progress > 0 && !r.done ? `${r.progress} %` : "";
  const pctW = pct ? ppdfWidth(doc, pct, 5.8, true) + 1.6 : 0;
  const tagsW = (crit ? crit.w + 1.4 : 0) + pctW;
  const titleMax = colW - tagsW;
  const title = projectPdfSafeText(r.title) || "Sans titre";
  let size = 7.2;
  while (size > 5.6 && ppdfWidth(doc, title, size, true) > titleMax) size -= 0.2;
  const titleLines = ppdfWidth(doc, title, size, true) > titleMax ? ppdfWrap(doc, title, size, true, titleMax) : [title];
  const status = r.status ? ppdfChipLayout(doc, r.status.name, PPDF_COLS[1].w - 3) : null;
  const type = r.type ? ppdfChipLayout(doc, r.type.name, PPDF_COLS[2].w - 3) : null;
  const sameYear = r.start && r.end && r.start.slice(0, 4) === r.end.slice(0, 4);
  const dateText = !r.end ? "" : r.start && r.start !== r.end
    ? `${sameYear ? projectPdfFmtDate(r.start).replace(/ \d{4}$/, "") : projectPdfFmtDate(r.start)} – ${projectPdfFmtDate(r.end)}`
    : projectPdfFmtDate(r.end);
  let dateSize = 6.6;
  while (dateSize > 5.2 && ppdfWidth(doc, dateText, dateSize, true) > PPDF_COLS[3].w - 3) dateSize -= 0.2;
  const ownerName = r.responsible ? projectPdfSafeText(r.responsible.name) : "";
  let ownerSize = 6.8;
  while (ownerSize > 5.4 && ppdfWidth(doc, ownerName, ownerSize, false) > PPDF_COLS[4].w - 9) ownerSize -= 0.2;
  const ownerLines = r.responsible ? (ppdfWidth(doc, ownerName, ownerSize, false) > PPDF_COLS[4].w - 9 ? ppdfWrap(doc, ownerName, ownerSize, false, PPDF_COLS[4].w - 9) : [ownerName]) : [];
  const lines = Math.max(titleLines.length, ownerLines.length, status ? status.lines.length : 1, type ? type.lines.length : 1);
  const h = lines > 1 ? PPDF_ROW_H + (lines - 1) * 2.8 : PPDF_ROW_H;
  return { r, titleLines, size, crit, pct, pctW, status, type, dateText, dateSize, ownerLines, ownerSize, h };
}
function ppdfDrawTableHead(doc, x, y) {
  let cx = x;
  PPDF_COLS.forEach((c, i) => { ppdfMicro(doc, c.label, cx + (i ? 1.5 : 2.6), y + 3.6, { size: 5.4 }); cx += c.w; });
  ppdfColor(doc, "draw", PPDF_INK);
  doc.setLineWidth(0.3);
  doc.line(x + 2, y + 5.4, x + PPDF_CW - 2, y + 5.4);
  return y + 5.4;
}
function ppdfDrawTaskRow(doc, L, x, y, images) {
  const r = L.r;
  const mid = y + PPDF_ROW_H / 2;
  const base = mid + 0.95; // ligne de base commune à toute la rangée
  let cx = x;
  const markColor = r.done ? PPDF_SUCCESS : (r.status?.color || PPDF_INK);
  if (r.milestone) ppdfDiamond(doc, cx + 3.6, mid, 1.05, markColor, null);
  else { ppdfColor(doc, "fill", markColor); doc.circle(cx + 3.6, mid, 0.85, "F"); }
  ppdfFont(doc, L.size, "bold");
  ppdfColor(doc, "text", r.done ? PPDF_TEXT2 : PPDF_INK);
  L.titleLines.forEach((l, k) => doc.text(l, cx + 6, base + k * 2.8));
  // Marqueurs alignés à droite de la colonne Tâche.
  let tx = cx + PPDF_COLS[0].w - 1.5;
  if (L.crit) { tx -= L.crit.w; ppdfChip(doc, tx, mid - L.crit.h / 2, r.criticality.name, r.criticality.color, 20, 5.4); tx -= 1.4; }
  if (L.pct) { ppdfFont(doc, 5.8, "bold"); ppdfColor(doc, "text", PPDF_TEXT2); doc.text(L.pct, tx, base - 0.1, { align: "right" }); }
  cx += PPDF_COLS[0].w;
  if (L.status) ppdfChip(doc, cx + 1.5, mid - L.status.h / 2, r.status.name, r.status.color, PPDF_COLS[1].w - 3);
  cx += PPDF_COLS[1].w;
  if (L.type) ppdfChip(doc, cx + 1.5, mid - L.type.h / 2, r.type.name, r.type.color, PPDF_COLS[2].w - 3);
  cx += PPDF_COLS[2].w;
  if (L.dateText) {
    ppdfFont(doc, L.dateSize, "bold");
    ppdfColor(doc, "text", r.late ? PPDF_DANGER_TEXT : PPDF_INK);
    doc.text(L.dateText, cx + 1.5, base);
  }
  cx += PPDF_COLS[3].w;
  if (r.responsible) {
    ppdfAvatar(doc, r.responsible, cx + 3.4, mid, 1.9, images);
    ppdfFont(doc, L.ownerSize, "normal");
    ppdfColor(doc, "text", PPDF_INK);
    L.ownerLines.forEach((l, k) => doc.text(l, cx + 6.6, base + k * 2.8));
  }
  ppdfColor(doc, "draw", PPDF_HAIR);
  doc.setLineWidth(0.2);
  doc.line(x + 2, y + L.h, x + PPDF_CW - 2, y + L.h);
}

// --- État du réseau ----------------------------------------------------------
function ppdfNetworkCells(data) {
  const c = data.counts;
  const cells = [
    { label: "Projets du périmètre", value: String(data.perimeterCount) },
    { label: "Tâches actives", value: String(c.active) },
    { label: "Blocages / attentes", value: String(c.blocked) },
    { label: "Jalons à venir", value: String(c.upcomingMilestones) },
  ];
  if (data.avgPerimeterProgress != null) cells.push({ label: "Avancement moyen", value: `${data.avgPerimeterProgress} %` });
  if (data.nextCritical) cells.push({ label: "Prochaine échéance critique", value: projectPdfFmtDate(data.nextCritical.date), sub: data.nextCritical.row.title, wide: true, overdue: data.nextCritical.overdue });
  return cells;
}
function ppdfNetworkLayout(doc, data) {
  const cells = ppdfNetworkCells(data);
  const n = cells.length + (cells.some((x) => x.wide) ? 1 : 0);
  const unit = PPDF_CW / n;
  let h = 15;
  cells.forEach((cell) => {
    cell.w = cell.wide ? unit * 2 : unit;
    if (cell.sub) { cell.subLines = ppdfWrap(doc, cell.sub, 6.2, false, cell.w - 6); h = Math.max(h, 12.6 + cell.subLines.length * 2.7 + 1.4); }
  });
  return { cells, h: h + 6 };
}
function ppdfDrawNetwork(doc, data, N, y) {
  ppdfPanel(doc, PPDF_M, y, PPDF_CW, N.h);
  ppdfColor(doc, "fill", PPDF_INK);
  doc.rect(PPDF_M, y, PPDF_CW, 0.8, "F");
  ppdfMicro(doc, "État du réseau", PPDF_M + 3, y + 4.6, { size: 6.2 });
  let x = PPDF_M;
  const top = y + 6;
  N.cells.forEach((cell, i) => {
    if (i) { ppdfColor(doc, "draw", PPDF_HAIR); doc.setLineWidth(0.2); doc.line(x, top + 1.5, x, y + N.h - 2); }
    ppdfMicroFit(doc, cell.label, x + 3, top + 4.6, cell.w - 5, { size: 5.2 });
    ppdfFont(doc, 10.5, "bold");
    ppdfColor(doc, "text", cell.overdue ? PPDF_DANGER_TEXT : PPDF_INK);
    doc.text(cell.value, x + 3, top + 9.4);
    if (cell.subLines) {
      ppdfFont(doc, 6.2, "normal");
      ppdfColor(doc, "text", PPDF_TEXT2);
      cell.subLines.forEach((l, k) => doc.text(l, x + 3, top + 12.4 + k * 2.7));
    }
    x += cell.w;
  });
  return y + N.h + 4;
}

// --- Assemblage ----------------------------------------------------------------
async function buildFicheProjetPdf(projectId, catalogs, { logoDataUrl = NEXORA_LOGO_FULL, todayIso = iso(new Date()), showDoneOnMetro = true } = {}) {
  if (typeof jsPDF !== "function") throw new Error("Générateur PDF indisponible : recharge Nexora puis réessaie.");
  const data = projectPdfData(projectId, catalogs, todayIso, { showDoneOnMetro });
  if (!data) throw new Error("Projet introuvable : impossible de générer la fiche projet.");
  const images = await ppdfLoadImages([data.project.image, ...data.taskRows.map((r) => r.responsible?.image)]);
  const doc = new jsPDF({ unit: "mm", format: "a4", orientation: "portrait" });
  doc.setProperties({ title: `Fiche projet - ${projectPdfSafeText(data.project.name)}`, creator: "Nexora" });
  ppdfPageBackground(doc);

  const newPage = () => {
    doc.addPage();
    ppdfPageBackground(doc);
    return ppdfDrawMiniHeader(doc, data, logoDataUrl, images);
  };
  const H = ppdfHeaderLayout(doc, data);
  let y = ppdfDrawHeader(doc, data, H, logoDataUrl, images);
  const S = ppdfSynthesisLayout(doc, data);
  const rows = data.taskRows.filter((r) => !r.done || r.lastMilestone).map((r) => ppdfTaskRowLayout(doc, r));
  const N = ppdfNetworkLayout(doc, data);
  const tableTitleH = 7, headH = 5.4;
  const tableH = tableTitleH + headH + (rows.length ? rows.reduce((s, L) => s + L.h, 0) : 8) + 2;

  y = ppdfDrawSynthesis(doc, data, S, y);

  // Vue Métro : bloc insécable, aéré si la page le permet.
  const metroSpace = PPDF_BOTTOM - y - tableH - N.h - 8;
  const ML = ppdfMetroLayout(doc, data, Math.max(0, metroSpace));
  if (ML) {
    if (y + ML.h > PPDF_BOTTOM) y = newPage();
    y = ppdfDrawMetro(doc, data, ML, y);
    // Mode numéroté (projet très dense) : index des stations, paginé.
    if (ML.index.length) {
      const colW = (PPDF_CW - 8) / 2;
      let i = 0;
      while (i < ML.index.length) {
        if (y + 12 > PPDF_BOTTOM) y = newPage();
        const startY = y;
        let colHeights = [0, 0];
        const blockItems = [];
        ppdfMicro(doc, "Index des stations", PPDF_M + 3, y + 4.2, { size: 5.8 });
        let cy = [y + 7, y + 7];
        let col = 0;
        while (i < ML.index.length) {
          const it = ML.index[i];
          const h = it.lines.length * 2.8 + 1.4;
          if (cy[col] + h > PPDF_BOTTOM - 2) { if (col === 0) { col = 1; continue; } break; }
          blockItems.push({ it, x: PPDF_M + 4 + col * colW, y: cy[col] });
          cy[col] += h;
          i++;
          if (col === 0 && i >= Math.ceil(ML.index.length / 2) && cy[0] - startY > 20) col = 1;
        }
        colHeights = cy;
        const blockH = Math.max(...colHeights) - startY + 1.5;
        ppdfPanel(doc, PPDF_M, startY, PPDF_CW, blockH);
        ppdfMicro(doc, "Index des stations", PPDF_M + 3, startY + 4.2, { size: 5.8 });
        blockItems.forEach(({ it, x, y: iy }) => {
          const t = it.s.item.t;
          if (it.s.item.kind === "milestone") ppdfDiamond(doc, x + 0.9, iy + 1.2, 0.9, t.done ? PPDF_SUCCESS : (t.status?.color || PPDF_INK), null);
          else { ppdfColor(doc, "fill", t.done ? PPDF_SUCCESS : (t.status?.color || PPDF_INK)); doc.circle(x + 0.9, iy + 1.2, 0.8, "F"); }
          ppdfFont(doc, 6.4, "normal");
          ppdfColor(doc, "text", PPDF_INK);
          it.lines.forEach((l, k) => doc.text(l, x + 2.8, iy + 2.1 + k * 2.8));
          ppdfFont(doc, 5.6, "normal");
          ppdfColor(doc, "text", PPDF_TEXT2);
          doc.text(projectPdfFmtDate(t.end), x + colW - 3, iy + 2.1, { align: "right" });
        });
        y = startY + blockH + 4;
      }
    }
  }

  // Tâches en cours : lignes insécables, en-tête de colonnes répété.
  const startTable = (withTitle) => {
    const need = (withTitle ? tableTitleH : 2) + headH + (rows[0] ? rows[0].h : 8);
    if (y + need > PPDF_BOTTOM) y = newPage();
    return y;
  };
  let tableTop = startTable(true);
  let segTop = tableTop;
  let cy = tableTop + tableTitleH;
  const closeSegment = (bottom) => {
    // Le cadre est tracé APRÈS le contenu du segment : on le pose sans fond.
    ppdfColor(doc, "draw", PPDF_BORDER);
    doc.setLineWidth(0.2);
    doc.rect(PPDF_M, segTop, PPDF_CW, bottom - segTop, "S");
  };
  // Fond blanc du segment : calculé à l'avance pour la page courante.
  const segmentHeight = (from, startIdx, withTitle) => {
    let h = (withTitle ? tableTitleH : 2) + headH;
    let k = startIdx;
    while (k < rows.length && from + h + rows[k].h + 2 <= PPDF_BOTTOM) { h += rows[k].h; k++; }
    if (!rows.length) h += 8;
    return { h: h + 2, end: k };
  };
  let idx = 0;
  let seg = segmentHeight(segTop, 0, true);
  ppdfColor(doc, "fill", PPDF_PAPER);
  doc.rect(PPDF_M, segTop, PPDF_CW, seg.h, "F");
  ppdfMicro(doc, "Tâches en cours", PPDF_M + 3, segTop + 4.8, { size: 6.2 });
  cy = ppdfDrawTableHead(doc, PPDF_M, cy - 1.6) + 0.2;
  if (!rows.length) {
    ppdfFont(doc, 7.2, "normal");
    ppdfColor(doc, "text", PPDF_TEXT2);
    doc.text("Aucune tâche active", PPDF_M + 3, cy + 5);
    cy += 8;
  }
  while (idx < rows.length) {
    if (idx >= seg.end) {
      closeSegment(segTop + seg.h);
      y = newPage();
      segTop = y;
      seg = segmentHeight(segTop, idx, false);
      ppdfColor(doc, "fill", PPDF_PAPER);
      doc.rect(PPDF_M, segTop, PPDF_CW, seg.h, "F");
      cy = ppdfDrawTableHead(doc, PPDF_M, segTop + 0.4) + 0.2;
    }
    ppdfDrawTaskRow(doc, rows[idx], PPDF_M, cy, images);
    cy += rows[idx].h;
    idx++;
  }
  closeSegment(segTop + seg.h);
  y = segTop + seg.h + 4;

  // État du réseau : barre basse, jamais coupée.
  if (y + N.h > PPDF_BOTTOM) y = newPage();
  ppdfDrawNetwork(doc, data, N, y);

  const total = doc.internal.getNumberOfPages();
  for (let p = 1; p <= total; p++) { doc.setPage(p); ppdfDrawPageNumber(doc, p, total); }
  return { doc, data, fileName: projectPdfFileName(data.project.name, todayIso) };
}

async function downloadFicheProjetPdf(projectId, catalogs, options = {}) {
  const { doc, fileName } = await buildFicheProjetPdf(projectId, catalogs, options);
  doc.save(fileName);
  return fileName;
}
// === NEXORA:PROJECT-PDF-DRAW:END ===

function QuoteStatusBadge({ status }) {
  const meta = quoteStatusMeta(status);
  return <span className="lp-quote-badge" style={{ background: meta.color }}>{meta.label}</span>;
}

// Affichage en lecture d'une liste de chips (skillIds -> badges colorés) —
// utilisé sous chaque ligne de devis et dans le catalogue. UI seulement,
// jamais dans le PDF (décision actée avec Quentin, design déjà validé).
function QuoteChipBadges({ skills, ids }) {
  const list = (ids || []).map((id) => skills.find((s) => s.id === id)).filter(Boolean);
  if (!list.length) return null;
  return (
    <div className="lp-quote-chip-row">
      {list.map((s) => <span key={s.id} className="lp-quote-chip" style={{ background: s.color }}>{s.label}</span>)}
    </div>
  );
}

// Sélecteur multi-choix custom (pas de librairie externe) : chaque chip
// disponible en badge coloré, cliquable pour ajouter/retirer — opacité
// réduite tant qu'il n'est pas sélectionné (voir .lp-quote-chip-btn, part-001).
function QuoteChipPicker({ skills, selectedIds, onToggle }) {
  if (!skills.length) return null;
  return (
    <div className="lp-quote-chip-picker">
      {skills.map((s) => {
        const active = (selectedIds || []).includes(s.id);
        return (
          <button
            key={s.id}
            type="button"
            className={"lp-quote-chip lp-quote-chip-btn" + (active ? " active" : "")}
            style={{ background: s.color }}
            onClick={() => onToggle(s.id)}
            title={active ? `Retirer ${s.label}` : `Ajouter ${s.label}`}
          >
            {s.label}
          </button>
        );
      })}
    </div>
  );
}

function QuotesView({ quotes, clients, settings, setSettings, catalog, skills, onSaveCatalogEntry, onDeleteCatalogEntry, onSaveSkill, onDeleteSkill, onSaveQuote, onDuplicateQuote, onDeleteQuote, onSetStatus, onAddClient, onSaveClient, onDeleteClient, onFacturer, toolbarSlot }) {
  const [formTarget, setFormTarget] = useState(null); // null | "new" | devis à éditer
  const [settingsOpen, setSettingsOpen] = useState(false);
  const [pendingDelete, setPendingDelete] = useState(null);
  const todayIso = iso(new Date());

  // Les plus récents (numéro décroissant) en tête — un devis récemment créé
  // n'a pas besoin d'être cherché en bas d'une longue liste.
  const rows = useMemo(() => [...quotes].sort((a, b) => (b.number || "").localeCompare(a.number || "")), [quotes]);

  const handleSave = (data) => {
    const saved = onSaveQuote(data, formTarget && formTarget !== "new" ? formTarget.id : undefined);
    setFormTarget(null);
    // Fire-and-forget : ne retarde ni ne bloque jamais la fermeture du
    // formulaire, même si Drive est lent ou pas encore configuré.
    if (saved) {
      const client = clients.find((c) => c.id === saved.clientId);
      archiveQuotePdfToDrive(saved, client, settings, skills);
    }
  };

  return (
    <div className="lp-quotes-wrap">
      <ViewToolbarPortal slot={toolbarSlot}>
        <button className="lp-btn" onClick={() => setSettingsOpen(true)}><Settings size={13} style={{ marginRight: 4, verticalAlign: -2 }} />Réglages entreprise</button>
        <button className="lp-btn lp-btn-primary" onClick={() => setFormTarget("new")}><Plus size={13} style={{ marginRight: 4, verticalAlign: -2 }} />Nouveau devis</button>
      </ViewToolbarPortal>

      {quotes.length === 0 ? (
        <div className="lp-empty" style={{ padding: 30 }}>Aucun devis pour l'instant. Crée le premier avec « Nouveau devis ».</div>
      ) : (
        <div className="lp-quotes-list">
          {rows.map((q) => {
            const client = clients.find((c) => c.id === q.clientId);
            const status = effectiveQuoteStatus(q, todayIso);
            return (
              <div className="lp-quotes-row" key={q.id}>
                <div className="lp-quotes-row-main">
                  <span className="lp-quotes-number">{q.number}</span>
                  <span className="lp-quotes-client">{client?.name || "Client non renseigné"}</span>
                  {q.title && <span className="lp-quotes-title">{q.title}</span>}
                </div>
                <QuoteStatusBadge status={status} />
                <span className="lp-quotes-amount">{fmtQuoteAmount(quoteTotal(q))}</span>
                <span className="lp-quotes-date">{q.issueDate ? fmtShort(q.issueDate) : "—"}</span>
                <select
                  className="lp-quotes-status-select"
                  value={q.status}
                  onChange={(e) => onSetStatus(q.id, e.target.value)}
                  title="Changer de statut"
                >
                  {QUOTE_EDITABLE_STATUSES.map((s) => <option key={s.key} value={s.key}>{s.label}</option>)}
                </select>
                <button className="lp-icon-btn" title="Voir / éditer" onClick={() => setFormTarget(q)}><Pencil size={14} /></button>
                <button className="lp-icon-btn" title="Dupliquer" onClick={() => onDuplicateQuote(q)}><Copy size={14} /></button>
                <button className="lp-icon-btn" title="Télécharger le PDF" onClick={() => downloadQuotePdf(q, client, settings, skills)}><Download size={14} /></button>
                {/* "Facturer ce devis" — uniquement sur un devis Accepté : crée la
                    facture (createInvoiceFromQuote) et bascule sur la vue Factures. */}
                {status === "accepted" && (
                  <button className="lp-btn" title="Facturer ce devis" onClick={() => onFacturer(q)}><Receipt size={13} style={{ marginRight: 4, verticalAlign: -2 }} />Facturer ce devis</button>
                )}
                <button className="lp-icon-btn" title="Supprimer" onClick={() => setPendingDelete(q)}><Trash2 size={14} /></button>
              </div>
            );
          })}
        </div>
      )}

      {formTarget && (
        <QuoteFormModal
          quote={formTarget === "new" ? null : formTarget}
          clients={clients}
          catalog={catalog}
          skills={skills}
          onAddClient={onAddClient}
          onSave={handleSave}
          onClose={() => setFormTarget(null)}
        />
      )}
      {settingsOpen && (
        <QuoteSettingsModal
          settings={settings}
          catalog={catalog}
          skills={skills}
          onSaveCatalogEntry={onSaveCatalogEntry}
          onDeleteCatalogEntry={onDeleteCatalogEntry}
          onSaveSkill={onSaveSkill}
          onDeleteSkill={onDeleteSkill}
          onSave={(data) => {
            setSettings((prev) => ({
              ...prev,
              ...data,
              // cgvUpdatedAt ne bouge QUE si le texte des CGV a RÉELLEMENT
              // changé — jamais à chaque sauvegarde de réglages (logo,
              // SIRET...), sans quoi la version affichée changerait pour rien.
              cgvUpdatedAt: data.cgvText !== prev.cgvText ? iso(new Date()) : prev.cgvUpdatedAt,
            }));
            setSettingsOpen(false);
          }}
          onClose={() => setSettingsOpen(false)}
        />
      )}
      {pendingDelete && (
        <ConfirmModal
          title="Supprimer ce devis ?"
          message={`Le devis « ${pendingDelete.number} » sera définitivement supprimé. Cette action est irréversible.`}
          danger
          confirmLabel="Supprimer"
          onConfirm={() => { onDeleteQuote(pendingDelete.id); setPendingDelete(null); }}
          onClose={() => setPendingDelete(null)}
        />
      )}
    </div>
  );
}

function QuoteFormModal({ quote, clients, catalog, skills, onAddClient, onSave, onClose }) {
  const isNew = !quote;
  const [clientId, setClientId] = useState(quote?.clientId || "");
  const [title, setTitle] = useState(quote?.title || "");
  const [issueDate, setIssueDate] = useState(quote?.issueDate || iso(new Date()));
  const [validUntil, setValidUntil] = useState(quote?.validUntil || defaultQuoteValidUntil(quote?.issueDate || iso(new Date())));
  const [lines, setLines] = useState(
    quote?.lines?.length ? quote.lines.map((l) => ({ ...l })) : [{ id: uid(), kind: "forfait", description: "", amount: 0, skillIds: [] }]
  );
  const [notes, setNotes] = useState(quote?.notes || "");
  const [showNewClient, setShowNewClient] = useState(false);
  const [newClientName, setNewClientName] = useState("");
  const [newClientAddress, setNewClientAddress] = useState("");
  const [newClientEmail, setNewClientEmail] = useState("");
  const [newClientPhone, setNewClientPhone] = useState("");
  // Catalogue de prestations : la liste se déplie sous le bouton (même motif
  // que showNewClient ci-dessus) — sélectionner une entrée en fait une COPIE
  // one-shot dans une nouvelle ligne, jamais une référence permanente.
  const [showCatalog, setShowCatalog] = useState(false);

  // La validité par défaut (30 jours) ne se recale QUE pour un nouveau devis
  // encore vierge : un devis existant garde toujours la date choisie, jamais
  // recalculée derrière le dos de l'utilisateur.
  useEffect(() => {
    if (isNew) setValidUntil(defaultQuoteValidUntil(issueDate));
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [issueDate]);

  const total = useMemo(() => lines.reduce((sum, l) => sum + quoteLineAmount(l), 0), [lines]);

  const updateLine = (id, patch) => setLines((prev) => prev.map((l) => (l.id === id ? { ...l, ...patch } : l)));
  const addLine = (kind) => setLines((prev) => [
    ...prev,
    kind === "regie"
      ? { id: uid(), kind: "regie", description: "", quantity: 1, unit: "hour", unitRate: 0, skillIds: [] }
      : { id: uid(), kind: "forfait", description: "", amount: 0, skillIds: [] },
  ]);
  const removeLine = (id) => setLines((prev) => prev.filter((l) => l.id !== id));
  const toggleLineSkill = (lineId, skillId) => setLines((prev) => prev.map((l) => {
    if (l.id !== lineId) return l;
    const ids = l.skillIds || [];
    return { ...l, skillIds: ids.includes(skillId) ? ids.filter((s) => s !== skillId) : [...ids, skillId] };
  }));

  // Insertion depuis le catalogue : copie one-shot des valeurs de l'entrée
  // dans une nouvelle ligne — description = label + description du
  // catalogue, kind/amount/unit/unitRate/skillIds copiés. Librement
  // modifiable ensuite comme n'importe quelle ligne, sans lien permanent
  // avec l'entrée catalogue (modifier le catalogue plus tard ne touche
  // jamais les devis déjà créés).
  const insertFromCatalog = (entry) => {
    const description = [entry.label, entry.description].filter(Boolean).join(" — ");
    setLines((prev) => [
      ...prev,
      entry.kind === "regie"
        ? { id: uid(), kind: "regie", description, quantity: 1, unit: entry.unit || "hour", unitRate: entry.unitRate || 0, skillIds: [...(entry.skillIds || [])] }
        : { id: uid(), kind: "forfait", description, amount: entry.amount || 0, skillIds: [...(entry.skillIds || [])] },
    ]);
    setShowCatalog(false);
  };

  const createClientInline = () => {
    if (!newClientName.trim()) return;
    const client = onAddClient({
      name: newClientName.trim(), address: newClientAddress.trim(),
      email: newClientEmail.trim(), phone: newClientPhone.trim(),
    });
    setClientId(client.id);
    setShowNewClient(false);
    setNewClientName(""); setNewClientAddress(""); setNewClientEmail(""); setNewClientPhone("");
  };

  const save = () => {
    onSave({
      clientId, title: title.trim(), issueDate, validUntil,
      lines: lines.filter((l) => (l.description || "").trim()),
      notes,
    });
  };

  return (
    <Modal
      title={isNew ? "Nouveau devis" : `Devis ${quote.number}`}
      onClose={onClose}
      wide
      footer={
        <>
          <button className="lp-btn" onClick={onClose}>Annuler</button>
          <button className="lp-btn lp-btn-primary" onClick={save} disabled={!clientId || lines.length === 0}>Enregistrer</button>
        </>
      }
    >
      <div className="lp-field">
        <label>Client</label>
        <div style={{ display: "flex", gap: 6 }}>
          <select value={clientId} onChange={(e) => setClientId(e.target.value)} style={{ flex: 1 }}>
            <option value="">— Choisir —</option>
            {clients.map((c) => <option key={c.id} value={c.id}>{c.name}</option>)}
          </select>
          <button type="button" className="lp-btn" onClick={() => setShowNewClient((v) => !v)}><Plus size={13} style={{ marginRight: 4, verticalAlign: -2 }} />Client</button>
        </div>
      </div>
      {showNewClient && (
        <div className="lp-quote-inline-client">
          <div className="lp-field"><label>Nom</label><input value={newClientName} onChange={(e) => setNewClientName(e.target.value)} /></div>
          <div className="lp-field"><label>Adresse</label><input value={newClientAddress} onChange={(e) => setNewClientAddress(e.target.value)} /></div>
          <div className="lp-field"><label>Email</label><input value={newClientEmail} onChange={(e) => setNewClientEmail(e.target.value)} /></div>
          <div className="lp-field"><label>Téléphone</label><input value={newClientPhone} onChange={(e) => setNewClientPhone(e.target.value)} /></div>
          <button type="button" className="lp-btn lp-btn-primary" onClick={createClientInline}>Créer ce client</button>
        </div>
      )}
      <div className="lp-field"><label>Objet du devis</label><input value={title} onChange={(e) => setTitle(e.target.value)} placeholder="Ex : Mission d'assistance à maîtrise d'ouvrage" /></div>
      <div style={{ display: "flex", gap: 10 }}>
        <div className="lp-field" style={{ flex: 1 }}><label>Date d'émission</label><input type="date" value={issueDate} onChange={(e) => setIssueDate(e.target.value)} /></div>
        <div className="lp-field" style={{ flex: 1 }}><label>Validité jusqu'au</label><input type="date" value={validUntil} onChange={(e) => setValidUntil(e.target.value)} /></div>
      </div>

      <div className="lp-section-title">Lignes du devis</div>
      <div className="lp-quote-lines">
        {lines.map((l) => (
          <div key={l.id}>
            <div className="lp-quote-line-row">
              <select
                value={l.kind}
                onChange={(e) => updateLine(l.id, e.target.value === "regie"
                  ? { kind: "regie", quantity: l.quantity || 1, unit: l.unit || "hour", unitRate: l.unitRate || 0 }
                  : { kind: "forfait", amount: l.amount || 0 })}
              >
                <option value="forfait">Forfait</option>
                <option value="regie">Régie</option>
              </select>
              <input className="lp-quote-line-desc" placeholder="Description" value={l.description} onChange={(e) => updateLine(l.id, { description: e.target.value })} />
              {l.kind === "regie" ? (
                <>
                  <input type="number" min="0" step="0.5" style={{ width: 70 }} value={l.quantity} onChange={(e) => updateLine(l.id, { quantity: Number(e.target.value) })} title="Quantité" />
                  <select value={l.unit} onChange={(e) => updateLine(l.id, { unit: e.target.value })}>
                    {QUOTE_REGIE_UNITS.map((u) => <option key={u.key} value={u.key}>{u.label}</option>)}
                  </select>
                  <input type="number" min="0" step="1" style={{ width: 90 }} value={l.unitRate} onChange={(e) => updateLine(l.id, { unitRate: Number(e.target.value) })} placeholder="Taux HT" title="Taux unitaire HT" />
                </>
              ) : (
                <input type="number" min="0" step="1" style={{ width: 110 }} value={l.amount} onChange={(e) => updateLine(l.id, { amount: Number(e.target.value) })} placeholder="Montant HT" title="Montant HT" />
              )}
              <span className="lp-quote-line-amount">{fmtQuoteAmount(quoteLineAmount(l))}</span>
              <button type="button" className="lp-icon-btn" onClick={() => removeLine(l.id)} title="Supprimer la ligne"><Trash2 size={13} /></button>
            </div>
            {/* Chips de compétences/logiciels de la ligne — sélecteur toggle
                ET affichage en lecture confondus (cliquer bascule, la couleur
                pleine indique la sélection actuelle). UI seulement, jamais
                dans le PDF. */}
            <QuoteChipPicker skills={skills || []} selectedIds={l.skillIds} onToggle={(skillId) => toggleLineSkill(l.id, skillId)} />
          </div>
        ))}
      </div>
      <div style={{ display: "flex", gap: 6, flexWrap: "wrap" }}>
        <button type="button" className="lp-btn" onClick={() => addLine("forfait")}><Plus size={13} style={{ marginRight: 4, verticalAlign: -2 }} />Ligne forfait</button>
        <button type="button" className="lp-btn" onClick={() => addLine("regie")}><Plus size={13} style={{ marginRight: 4, verticalAlign: -2 }} />Ligne régie</button>
        <button type="button" className="lp-btn" onClick={() => setShowCatalog((v) => !v)}><BookOpen size={13} style={{ marginRight: 4, verticalAlign: -2 }} />Insérer depuis le catalogue</button>
      </div>
      {showCatalog && (
        <div className="lp-quote-catalog-picker">
          {(catalog || []).length === 0 ? (
            <span style={{ fontSize: 11.5, color: "var(--text-muted)" }}>Aucune entrée dans le catalogue — ajoute-en depuis Réglages entreprise › Catalogue.</span>
          ) : (catalog || []).map((entry) => (
            <button type="button" key={entry.id} className="lp-quote-catalog-picker-item" onClick={() => insertFromCatalog(entry)}>
              <span className="lp-quote-catalog-picker-label">{entry.label}</span>
              <span className="lp-quote-catalog-picker-meta">
                {entry.kind === "regie" ? `Régie · ${fmtQuoteAmount(entry.unitRate || 0)}` : `Forfait · ${fmtQuoteAmount(entry.amount || 0)}`}
              </span>
            </button>
          ))}
        </div>
      )}

      <div className="lp-quote-total">Total HT (TVA non applicable, art. 293 B du CGI — HT = TTC) : <strong>{fmtQuoteAmount(total)}</strong></div>

      <div className="lp-field"><label>Notes internes (non imprimées sur le PDF)</label><textarea rows={2} value={notes} onChange={(e) => setNotes(e.target.value)} /></div>
    </Modal>
  );
}

// Rogne automatiquement les marges blanches/transparentes d'un logo importé,
// AVANT stockage du data-URL — la charte graphique QM précise explicitement
// que "les marges blanches ont été retirées pour le placement" : un fichier
// brut, encadré de blanc, doit être recadré ici pour correspondre au rendu
// attendu du PDF (drawQuoteHeader, object-fit "contain" dans une boîte
// serrée). Détection best-effort par bounding box des pixels non-blancs /
// non-transparents (tolérance de 8 par canal RGB) — un canvas indisponible,
// une image déjà cadrée pile sur ses bords, ou toute autre erreur retombent
// simplement sur l'image telle quelle : jamais bloquant pour l'utilisateur.
async function cropLogoWhiteMargins(dataUrl) {
  try {
    const img = await new Promise((resolve, reject) => {
      const im = new Image();
      im.onload = () => resolve(im);
      im.onerror = reject;
      im.src = dataUrl;
    });
    const width = img.naturalWidth, height = img.naturalHeight;
    if (!width || !height) return dataUrl;
    const canvas = document.createElement("canvas");
    canvas.width = width; canvas.height = height;
    const ctx = canvas.getContext("2d");
    if (!ctx) return dataUrl;
    ctx.drawImage(img, 0, 0);
    const { data } = ctx.getImageData(0, 0, width, height);
    const TOLERANCE = 8;
    let minX = width, minY = height, maxX = -1, maxY = -1;
    for (let y = 0; y < height; y++) {
      for (let x = 0; x < width; x++) {
        const i = (y * width + x) * 4;
        const isWhite = data[i + 3] === 0 || (data[i] >= 255 - TOLERANCE && data[i + 1] >= 255 - TOLERANCE && data[i + 2] >= 255 - TOLERANCE);
        if (!isWhite) {
          if (x < minX) minX = x;
          if (x > maxX) maxX = x;
          if (y < minY) minY = y;
          if (y > maxY) maxY = y;
        }
      }
    }
    // Rien détecté (image entièrement blanche/transparente), ou bbox = image
    // entière (déjà cadrée) : ne pas recadrer, inutile.
    if (maxX < 0 || (minX === 0 && minY === 0 && maxX === width - 1 && maxY === height - 1)) return dataUrl;
    const cropW = maxX - minX + 1, cropH = maxY - minY + 1;
    const out = document.createElement("canvas");
    out.width = cropW; out.height = cropH;
    const octx = out.getContext("2d");
    if (!octx) return dataUrl;
    octx.drawImage(canvas, minX, minY, cropW, cropH, 0, 0, cropW, cropH);
    return out.toDataURL("image/png");
  } catch (e) {
    return dataUrl; // best-effort : jamais bloquant
  }
}

const QUOTE_SETTINGS_TABS = [
  { key: "company", label: "Entreprise" },
  { key: "cgv", label: "CGV" },
  { key: "catalog", label: "Catalogue" },
  { key: "skills", label: "Compétences" },
];

function QuoteSettingsModal({ settings, catalog, skills, onSaveCatalogEntry, onDeleteCatalogEntry, onSaveSkill, onDeleteSkill, onSave, onClose }) {
  const [activeTab, setActiveTab] = useState("company");
  // Rappel discret (une fois, lecture seule) que l'archivage automatique sur
  // Google Drive n'est pas encore actif côté Netlify — voir archivePdfToDrive
  // et NEXORA_DRIVE_ROOT_FOLDER_ID (_shared/drive.ts). Jamais de bannière
  // permanente ni de popup : juste une ligne dans ces réglages.
  const [driveArchiveNotConfigured] = useState(() => {
    try { return localStorage.getItem("nexora:driveArchiveNotConfigured") === "1"; } catch (_) { return false; }
  });
  const [companyName, setCompanyName] = useState(settings.companyName || "");
  const [siret, setSiret] = useState(settings.siret || "");
  const [address, setAddress] = useState(settings.address || "");
  const [activity, setActivity] = useState(settings.activity || "");
  const [email, setEmail] = useState(settings.email || "");
  const [phone, setPhone] = useState(settings.phone || "");
  const [website, setWebsite] = useState(settings.website || "");
  const [logoUrl, setLogoUrl] = useState(settings.logoUrl || "");
  const [logoError, setLogoError] = useState("");
  // Assurance professionnelle — texte libre, utilisé UNIQUEMENT dans le PDF
  // facture (mention conditionnelle, absente si vide). Voir seedQuoteSettings
  // (part-000) et downloadInvoicePdf (plus bas).
  const [insurance, setInsurance] = useState(settings.insurance || "");
  // CGV — rédigées une fois, insérées automatiquement sur chaque devis (page
  // 3 du PDF). La version affichée se recalcule à la volée depuis
  // settings.cgvUpdatedAt (voir quoteCgvVersionLabel) : rien à saisir ici.
  const [cgvText, setCgvText] = useState(settings.cgvText || "");
  // Limite d'upload direct — même valeur et même message que les pièces
  // jointes de tâche (onFileAttach, part-002) : pas de vrai stockage de
  // fichiers dans cette appli, donc on se limite aux petits logos pour ne
  // jamais dépasser la limite de taille d'un document Firestore.
  const MAX_LOGO_BYTES = 350 * 1024;
  const isLogoDataUrl = (value) => /^data:image\//.test(String(value || ""));

  const onLogoFile = (e) => {
    const file = e.target.files?.[0];
    e.target.value = "";
    if (!file) return;
    setLogoError("");
    if (file.size > MAX_LOGO_BYTES) {
      setLogoError(`« ${file.name} » fait ${Math.round(file.size / 1024)} Ko — trop volumineux pour être joint directement (limite ${Math.round(MAX_LOGO_BYTES / 1024)} Ko). Utilise plutôt un lien externe (Drive, etc.) ci-dessus.`);
      return;
    }
    const reader = new FileReader();
    reader.onload = async () => {
      // Recadrage automatique des marges blanches avant stockage (voir
      // cropLogoWhiteMargins ci-dessus) — best-effort, jamais bloquant.
      const raw = String(reader.result || "");
      setLogoUrl(await cropLogoWhiteMargins(raw));
    };
    reader.readAsDataURL(file);
  };
  const removeLogo = () => { setLogoUrl(""); setLogoError(""); };

  const save = () => {
    const trimmedLogo = logoUrl.trim();
    // Un data-URL (upload direct) est toujours valide tel quel : c'est le
    // chemin principal et fiable, il n'a besoin d'aucun fetch réseau au
    // moment de générer le PDF. Seul un lien externe classique reste soumis
    // à la validation Google Drive (repli secondaire, potentiellement fragile
    // — CORS, lien de partage plutôt qu'accès direct au binaire, etc.).
    if (trimmedLogo && !isLogoDataUrl(trimmedLogo) && !isGoogleDriveUrl(trimmedLogo)) {
      setLogoError("Colle une URL Google Drive ou Google Docs valide commençant par https://.");
      return;
    }
    onSave({ companyName, siret, address, activity, email, phone, website, logoUrl: trimmedLogo, cgvText, insurance });
  };

  return (
    <Modal
      title="Réglages entreprise — Devis"
      onClose={onClose}
      wide
      footer={
        <>
          <button className="lp-btn" onClick={onClose}>Annuler</button>
          <button className="lp-btn lp-btn-primary" onClick={save}>Enregistrer</button>
        </>
      }
    >
      <div className="lp-task-tabs lp-quote-settings-tabs">
        {QUOTE_SETTINGS_TABS.map((t) => (
          <button key={t.key} type="button" className={"lp-task-tab-btn" + (activeTab === t.key ? " active" : "")} onClick={() => setActiveTab(t.key)}>{t.label}</button>
        ))}
      </div>

      {activeTab === "company" && (
        <>
          <p style={{ fontSize: 11.5, color: "var(--text-muted)", margin: "0 0 4px", lineHeight: 1.45 }}>
            Ces informations apparaissent sur chaque devis PDF généré. Les valeurs actuelles sont des placeholders, à
            remplacer par les vraies informations de l'entreprise.
          </p>
          {driveArchiveNotConfigured && (
            <p style={{ fontSize: 11, color: "var(--text-muted)", margin: "0 0 10px", lineHeight: 1.4 }}>
              Archivage automatique sur Google Drive : pas encore configuré côté serveur — les PDF de devis ne sont
              pas déposés dans Drive pour l'instant (le téléchargement manuel n'est pas concerné).
            </p>
          )}
          <div className="lp-field"><label>Raison sociale</label><input value={companyName} onChange={(e) => setCompanyName(e.target.value)} /></div>
          <div className="lp-field"><label>SIRET</label><input value={siret} onChange={(e) => setSiret(e.target.value)} /></div>
          <div className="lp-field"><label>Adresse</label><input value={address} onChange={(e) => setAddress(e.target.value)} /></div>
          <div className="lp-field"><label>Activité déclarée</label><input value={activity} onChange={(e) => setActivity(e.target.value)} /></div>
          <div className="lp-field"><label>Email</label><input value={email} onChange={(e) => setEmail(e.target.value)} /></div>
          <div className="lp-field"><label>Téléphone</label><input value={phone} onChange={(e) => setPhone(e.target.value)} /></div>
          <div className="lp-field"><label>Site web</label><input value={website} onChange={(e) => setWebsite(e.target.value)} placeholder="https://..." /></div>
          <div className="lp-field">
            <label>Assurance professionnelle (optionnel)</label>
            <input value={insurance} onChange={(e) => setInsurance(e.target.value)} placeholder="Ex : Assureur X — RC Pro n° ..." />
            <p style={{ fontSize: 11, color: "var(--text-muted)", margin: "4px 0 0" }}>
              Affichée uniquement sur le PDF facture (mention conditionnelle), jamais sur le devis. Laisse vide pour ne rien afficher.
            </p>
          </div>
          <div className="lp-field">
            <label>Logo</label>
            <p style={{ fontSize: 11, color: "var(--text-muted)", margin: "0 0 6px" }}>
              Importe directement une image (chemin fiable, recommandé) — le lien Google Drive reste
              disponible en option, mais peut échouer silencieusement dans le PDF (lien privé, CORS).
              Les marges blanches sont recadrées automatiquement à l'import.
            </p>
            <div style={{ display: "flex", gap: 6, alignItems: "center", flexWrap: "wrap" }}>
              <label className="lp-btn" style={{ cursor: "pointer", margin: 0 }}>
                <Upload size={13} style={{ marginRight: 4, verticalAlign: -2 }} />Importer le logo
                <input type="file" accept="image/*" onChange={onLogoFile} style={{ display: "none" }} />
              </label>
              {logoUrl && <button type="button" className="lp-btn" onClick={removeLogo}>Retirer le logo</button>}
            </div>
            {logoError && <p style={{ color: "var(--danger)", fontSize: 11, margin: "6px 0 0" }}>{logoError}</p>}
            {logoUrl && isLogoDataUrl(logoUrl) && (
              <div className="lp-quote-logo-preview">
                <img src={logoUrl} alt="Logo" onError={(e) => { e.currentTarget.style.display = "none"; }} />
              </div>
            )}
          </div>
          <div className="lp-field">
            <label>Ou lien Google Drive (option secondaire, moins fiable)</label>
            <input
              value={isLogoDataUrl(logoUrl) ? "" : logoUrl}
              onChange={(e) => { setLogoUrl(e.target.value); setLogoError(""); }}
              placeholder="https://drive.google.com/..."
              disabled={isLogoDataUrl(logoUrl)}
            />
          </div>
          {logoUrl && isGoogleDriveUrl(logoUrl) && !isLogoDataUrl(logoUrl) && (
            <div className="lp-quote-logo-preview">
              <img src={logoUrl} alt="Logo" onError={(e) => { e.currentTarget.style.display = "none"; }} />
            </div>
          )}
        </>
      )}

      {activeTab === "cgv" && (
        <>
          <p style={{ fontSize: 11.5, color: "var(--text-muted)", margin: "0 0 8px", lineHeight: 1.45 }}>
            Rédigées une fois, insérées automatiquement sur chaque devis (page 3 du PDF, uniquement si ce champ n'est
            pas vide). La version affichée ({quoteCgvVersionLabel(settings) ? `actuellement CGV v.${quoteCgvVersionLabel(settings)}` : "aucune pour l'instant"}) se
            recalcule automatiquement depuis la date de dernière modification — rien à saisir à part le texte.
          </p>
          <div className="lp-field">
            <label>Conditions générales de vente</label>
            <textarea rows={16} value={cgvText} onChange={(e) => setCgvText(e.target.value)} placeholder="Colle ou rédige ici le texte complet des CGV — les paragraphes (ligne vide) sont conservés sur la page 3 du PDF." />
          </div>
        </>
      )}

      {activeTab === "catalog" && (
        <QuoteCatalogTab catalog={catalog || []} skills={skills || []} onSaveEntry={onSaveCatalogEntry} onDeleteEntry={onDeleteCatalogEntry} />
      )}

      {activeTab === "skills" && (
        <QuoteSkillsTab skills={skills || []} onSaveSkill={onSaveSkill} onDeleteSkill={onDeleteSkill} />
      )}
    </Modal>
  );
}

// Onglet Catalogue (QuoteSettingsModal) : liste des entrées existantes
// (édition/suppression) + formulaire d'ajout, mêmes champs qu'une ligne de
// devis plus un label court et des skillIds.
function QuoteCatalogTab({ catalog, skills, onSaveEntry, onDeleteEntry }) {
  const blank = { id: null, label: "", description: "", kind: "forfait", amount: 0, unit: "hour", unitRate: 0, skillIds: [] };
  const [editing, setEditing] = useState(null); // null = formulaire fermé, sinon l'entrée en cours d'édition/création

  const startNew = () => setEditing({ ...blank });
  const startEdit = (entry) => setEditing({ ...blank, ...entry });
  const cancel = () => setEditing(null);
  const submit = () => {
    if (!editing.label.trim()) return;
    onSaveEntry({ ...editing, id: editing.id || uid(), label: editing.label.trim() });
    setEditing(null);
  };
  const toggleSkill = (skillId) => setEditing((prev) => {
    const ids = prev.skillIds || [];
    return { ...prev, skillIds: ids.includes(skillId) ? ids.filter((s) => s !== skillId) : [...ids, skillId] };
  });

  return (
    <div>
      <p style={{ fontSize: 11.5, color: "var(--text-muted)", margin: "0 0 8px", lineHeight: 1.45 }}>
        Gabarits de lignes réutilisables — « Insérer depuis le catalogue » (dans un devis) en copie les valeurs dans
        une nouvelle ligne, librement modifiable ensuite : modifier une entrée ici ne change aucun devis déjà créé.
      </p>
      <div className="lp-quotes-list" style={{ marginBottom: 10 }}>
        {catalog.length === 0 && <div className="lp-empty" style={{ padding: 14 }}>Aucune entrée pour l'instant.</div>}
        {catalog.map((entry) => (
          <div className="lp-quote-catalog-row" key={entry.id}>
            <div className="lp-quote-catalog-main">
              <span className="lp-quote-catalog-label">{entry.label}</span>
              {entry.description && <span className="lp-quote-catalog-desc">{entry.description}</span>}
              <QuoteChipBadges skills={skills} ids={entry.skillIds} />
            </div>
            <span className="lp-quote-catalog-meta">{entry.kind === "regie" ? `Régie · ${fmtQuoteAmount(entry.unitRate || 0)}` : `Forfait · ${fmtQuoteAmount(entry.amount || 0)}`}</span>
            <button type="button" className="lp-icon-btn" title="Éditer" onClick={() => startEdit(entry)}><Pencil size={14} /></button>
            <button type="button" className="lp-icon-btn" title="Supprimer" onClick={() => onDeleteEntry(entry.id)}><Trash2 size={14} /></button>
          </div>
        ))}
      </div>

      {editing ? (
        <div className="lp-quote-inline-client">
          <div className="lp-field"><label>Label</label><input value={editing.label} onChange={(e) => setEditing({ ...editing, label: e.target.value })} placeholder="Ex : Audit & cadrage" /></div>
          <div className="lp-field"><label>Description</label><input value={editing.description} onChange={(e) => setEditing({ ...editing, description: e.target.value })} /></div>
          <div className="lp-quote-line-row">
            <select value={editing.kind} onChange={(e) => setEditing({ ...editing, kind: e.target.value })}>
              <option value="forfait">Forfait</option>
              <option value="regie">Régie</option>
            </select>
            {editing.kind === "regie" ? (
              <>
                <select value={editing.unit} onChange={(e) => setEditing({ ...editing, unit: e.target.value })}>
                  {QUOTE_REGIE_UNITS.map((u) => <option key={u.key} value={u.key}>{u.label}</option>)}
                </select>
                <input type="number" min="0" step="1" style={{ width: 100 }} value={editing.unitRate} onChange={(e) => setEditing({ ...editing, unitRate: Number(e.target.value) })} placeholder="Taux HT" />
              </>
            ) : (
              <input type="number" min="0" step="1" style={{ width: 110 }} value={editing.amount} onChange={(e) => setEditing({ ...editing, amount: Number(e.target.value) })} placeholder="Montant HT" />
            )}
          </div>
          <QuoteChipPicker skills={skills} selectedIds={editing.skillIds} onToggle={toggleSkill} />
          <div style={{ display: "flex", gap: 6 }}>
            <button type="button" className="lp-btn lp-btn-primary" onClick={submit}>{editing.id ? "Mettre à jour" : "Ajouter au catalogue"}</button>
            <button type="button" className="lp-btn" onClick={cancel}>Annuler</button>
          </div>
        </div>
      ) : (
        <button type="button" className="lp-btn" onClick={startNew}><Plus size={13} style={{ marginRight: 4, verticalAlign: -2 }} />Ajouter une entrée</button>
      )}
    </div>
  );
}

// Onglet Compétences (QuoteSettingsModal) : ajout/suppression/renommage/
// changement de couleur d'un chip, aperçu visuel en badge à côté de chaque
// entrée — palette fixe (QUOTE_SKILL_COLORS, part-000), pas de sélecteur de
// couleur libre.
function QuoteSkillsTab({ skills, onSaveSkill, onDeleteSkill }) {
  const [editingId, setEditingId] = useState(null); // id d'un skill existant en édition, ou "new"
  const [label, setLabel] = useState("");
  const [color, setColor] = useState(QUOTE_SKILL_COLORS[0]);

  const startNew = () => { setEditingId("new"); setLabel(""); setColor(QUOTE_SKILL_COLORS[0]); };
  const startEdit = (skill) => { setEditingId(skill.id); setLabel(skill.label); setColor(skill.color); };
  const cancel = () => setEditingId(null);
  const submit = () => {
    if (!label.trim()) return;
    onSaveSkill({ id: editingId === "new" ? uid() : editingId, label: label.trim(), color });
    setEditingId(null);
  };

  return (
    <div>
      <p style={{ fontSize: 11.5, color: "var(--text-muted)", margin: "0 0 8px", lineHeight: 1.45 }}>
        Chips affichés sur chaque ligne de devis et dans le catalogue (jamais sur le PDF). Supprimer un chip le
        retire aussi de toutes les lignes et entrées de catalogue qui le référencent.
      </p>
      <div className="lp-quotes-list" style={{ marginBottom: 10 }}>
        {skills.length === 0 && <div className="lp-empty" style={{ padding: 14 }}>Aucun chip pour l'instant.</div>}
        {skills.map((s) => (
          <div className="lp-quote-skill-row" key={s.id}>
            <span className="lp-quote-chip" style={{ background: s.color }}>{s.label}</span>
            <span className="lp-quote-skill-name" />
            <button type="button" className="lp-icon-btn" title="Éditer" onClick={() => startEdit(s)}><Pencil size={14} /></button>
            <button type="button" className="lp-icon-btn" title="Supprimer" onClick={() => onDeleteSkill(s.id)}><Trash2 size={14} /></button>
          </div>
        ))}
      </div>

      {editingId ? (
        <div className="lp-quote-inline-client">
          <div className="lp-field"><label>Nom</label><input value={label} onChange={(e) => setLabel(e.target.value)} placeholder="Ex : Notion" /></div>
          <div className="lp-field">
            <label>Couleur</label>
            <div style={{ display: "flex", gap: 6 }}>
              {QUOTE_SKILL_COLORS.map((c) => (
                <button key={c} type="button" className={"lp-quote-color-swatch" + (color === c ? " active" : "")} style={{ background: c }} onClick={() => setColor(c)} title={c} />
              ))}
            </div>
          </div>
          <div style={{ display: "flex", gap: 6 }}>
            <button type="button" className="lp-btn lp-btn-primary" onClick={submit}>{editingId === "new" ? "Ajouter" : "Mettre à jour"}</button>
            <button type="button" className="lp-btn" onClick={cancel}>Annuler</button>
          </div>
        </div>
      ) : (
        <button type="button" className="lp-btn" onClick={startNew}><Plus size={13} style={{ marginRight: 4, verticalAlign: -2 }} />Ajouter un chip</button>
      )}
    </div>
  );
}

// ============================================================================
// Module Facture — construit sur le modèle du module Devis ci-dessus. Réutilise
// QuoteChipPicker/QuoteChipBadges, QUOTE_REGIE_UNITS, quoteLineAmount,
// fmtQuoteAmount, downloadInvoicePdf (plus haut) — jamais de duplication.
// ============================================================================
function InvoiceStatusBadge({ status }) {
  const meta = invoiceStatusMeta(status);
  return <span className="lp-quote-badge" style={{ background: meta.color }}>{meta.label}</span>;
}

const INVOICES_SUBVIEWS = [
  { key: "invoices", label: "Factures" },
  { key: "receipts", label: "Livre des recettes" },
];

function InvoicesView({ invoices, quotes, clients, settings, setSettings, catalog, skills, onSaveCatalogEntry, onDeleteCatalogEntry, onSaveSkill, onDeleteSkill, onSaveInvoice, onDuplicateInvoice, onSetStatus, onCreateCreditNote, onAddClient, autoOpenId, onAutoOpened, toolbarSlot }) {
  const [subview, setSubview] = useState("invoices");
  const [formTarget, setFormTarget] = useState(null); // null | "new" | facture à éditer
  const [settingsOpen, setSettingsOpen] = useState(false);
  const todayIso = iso(new Date());

  // Ouverture automatique de la facture venant d'être créée depuis "Facturer
  // ce devis" (QuotesView → createInvoiceFromQuote) — consommée une seule
  // fois (onAutoOpened efface pendingOpenInvoiceId côté parent), jamais de
  // réouverture au moindre re-render.
  useEffect(() => {
    if (!autoOpenId) return;
    const inv = invoices.find((i) => i.id === autoOpenId);
    if (inv) setFormTarget(inv);
    onAutoOpened();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [autoOpenId]);

  const rows = useMemo(() => [...invoices].sort((a, b) => (b.number || "").localeCompare(a.number || "")), [invoices]);
  const paidRows = useMemo(() => rows.filter((inv) => inv.status === "paid"), [rows]);

  const handleSave = (data) => {
    const saved = onSaveInvoice(data, formTarget && formTarget !== "new" ? formTarget.id : undefined);
    setFormTarget(null);
    // Fire-and-forget, même motif que QuotesView.handleSave : ne retarde ni
    // ne bloque jamais la fermeture du formulaire.
    if (saved) {
      const client = clients.find((c) => c.id === saved.clientId);
      const sourceQuote = saved.quoteId ? quotes.find((q) => q.id === saved.quoteId) : null;
      const original = saved.creditNoteOf ? invoices.find((i) => i.id === saved.creditNoteOf) : null;
      archiveInvoicePdfToDrive(saved, client, settings, skills, sourceQuote, original?.number);
    }
  };

  // Export CSV du Livre des recettes — même motif que backupTextDownload
  // (part-001, Blob + URL.createObjectURL), pas de librairie externe.
  const exportReceiptsCsv = () => {
    const header = ["Numéro", "Client", "Objet", "Date de paiement", "Montant HT"];
    const lines = paidRows.map((inv) => {
      const client = clients.find((c) => c.id === inv.clientId);
      return [inv.number, client?.name || "", inv.title || "", inv.paidAt ? fmtShort(inv.paidAt) : "", fmtQuoteAmount(invoiceTotal(inv))];
    });
    const csv = [header, ...lines].map((row) => row.map((cell) => `"${String(cell ?? "").replace(/"/g, '""')}"`).join(",")).join("\r\n");
    const blob = new Blob([csv], { type: "text/csv;charset=utf-8" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = `livre-des-recettes_${todayIso}.csv`;
    document.body.appendChild(a);
    a.click();
    a.remove();
    setTimeout(() => URL.revokeObjectURL(url), 1500);
  };

  return (
    <div className="lp-quotes-wrap">
      <ViewToolbarPortal slot={toolbarSlot}>
        <button className="lp-btn" onClick={() => setSettingsOpen(true)}><Settings size={13} style={{ marginRight: 4, verticalAlign: -2 }} />Réglages entreprise</button>
        {subview === "invoices" && (
          <button className="lp-btn lp-btn-primary" onClick={() => setFormTarget("new")}><Plus size={13} style={{ marginRight: 4, verticalAlign: -2 }} />Nouvelle facture</button>
        )}
        {subview === "receipts" && (
          <button className="lp-btn" onClick={exportReceiptsCsv} disabled={paidRows.length === 0}><Download size={13} style={{ marginRight: 4, verticalAlign: -2 }} />Export CSV</button>
        )}
      </ViewToolbarPortal>

      <div className="lp-task-tabs" style={{ marginBottom: 12 }}>
        {INVOICES_SUBVIEWS.map((t) => (
          <button key={t.key} type="button" className={"lp-task-tab-btn" + (subview === t.key ? " active" : "")} onClick={() => setSubview(t.key)}>{t.label}</button>
        ))}
      </div>

      {subview === "invoices" && (
        rows.length === 0 ? (
          <div className="lp-empty" style={{ padding: 30 }}>Aucune facture pour l'instant. Crée-en une avec « Nouvelle facture » ou facture un devis Accepté.</div>
        ) : (
          <div className="lp-quotes-list">
            {rows.map((inv) => {
              const client = clients.find((c) => c.id === inv.clientId);
              const status = effectiveInvoiceStatus(inv, todayIso);
              const editable = inv.status === "issued";
              const total = invoiceTotal(inv);
              const original = inv.creditNoteOf ? invoices.find((i) => i.id === inv.creditNoteOf) : null;
              const sourceQuote = inv.quoteId ? quotes.find((q) => q.id === inv.quoteId) : null;
              return (
                <div className="lp-quotes-row" key={inv.id}>
                  <div className="lp-quotes-row-main">
                    <span className="lp-quotes-number">{inv.number}{inv.creditNoteOf && " (avoir)"}</span>
                    <span className="lp-quotes-client">{client?.name || "Client non renseigné"}</span>
                    {inv.title && <span className="lp-quotes-title">{inv.title}</span>}
                  </div>
                  <InvoiceStatusBadge status={status} />
                  <span className="lp-quotes-amount" style={total < 0 ? { color: "var(--danger)" } : undefined}>{fmtQuoteAmount(total)}</span>
                  <span className="lp-quotes-date">{inv.issueDate ? fmtShort(inv.issueDate) : "—"}</span>
                  {editable && (
                    <select
                      className="lp-quotes-status-select"
                      value={inv.status}
                      onChange={(e) => onSetStatus(inv.id, e.target.value)}
                      title="Changer de statut"
                    >
                      {INVOICE_MANUAL_STATUSES.map((s) => <option key={s.key} value={s.key}>{s.label}</option>)}
                    </select>
                  )}
                  {editable && <button className="lp-icon-btn" title="Voir / éditer" onClick={() => setFormTarget(inv)}><Pencil size={14} /></button>}
                  <button className="lp-icon-btn" title="Dupliquer" onClick={() => onDuplicateInvoice(inv)}><Copy size={14} /></button>
                  <button className="lp-icon-btn" title="Télécharger le PDF" onClick={() => downloadInvoicePdf(inv, client, settings, skills, sourceQuote, original?.number)}><Download size={14} /></button>
                  {(inv.status === "issued" || inv.status === "paid") && (
                    <button className="lp-icon-btn" title="Créer un avoir" onClick={() => onCreateCreditNote(inv.id)}><FileMinus size={14} /></button>
                  )}
                </div>
              );
            })}
          </div>
        )
      )}

      {subview === "receipts" && (
        paidRows.length === 0 ? (
          <div className="lp-empty" style={{ padding: 30 }}>Aucune facture payée pour l'instant.</div>
        ) : (
          <div className="lp-quotes-list">
            {paidRows.map((inv) => {
              const client = clients.find((c) => c.id === inv.clientId);
              return (
                <div className="lp-quotes-row" key={inv.id}>
                  <div className="lp-quotes-row-main">
                    <span className="lp-quotes-number">{inv.number}</span>
                    <span className="lp-quotes-client">{client?.name || "Client non renseigné"}</span>
                    {inv.title && <span className="lp-quotes-title">{inv.title}</span>}
                  </div>
                  <span className="lp-quotes-amount">{fmtQuoteAmount(invoiceTotal(inv))}</span>
                  <span className="lp-quotes-date" title="Date de paiement">{inv.paidAt ? fmtShort(inv.paidAt) : "—"}</span>
                </div>
              );
            })}
          </div>
        )
      )}

      {formTarget && (
        <InvoiceFormModal
          invoice={formTarget === "new" ? null : formTarget}
          clients={clients}
          catalog={catalog}
          skills={skills}
          onAddClient={onAddClient}
          onSave={handleSave}
          onClose={() => setFormTarget(null)}
        />
      )}
      {settingsOpen && (
        <QuoteSettingsModal
          settings={settings}
          catalog={catalog}
          skills={skills}
          onSaveCatalogEntry={onSaveCatalogEntry}
          onDeleteCatalogEntry={onDeleteCatalogEntry}
          onSaveSkill={onSaveSkill}
          onDeleteSkill={onDeleteSkill}
          onSave={(data) => {
            setSettings((prev) => ({
              ...prev,
              ...data,
              cgvUpdatedAt: data.cgvText !== prev.cgvText ? iso(new Date()) : prev.cgvUpdatedAt,
            }));
            setSettingsOpen(false);
          }}
          onClose={() => setSettingsOpen(false)}
        />
      )}
    </div>
  );
}

function InvoiceFormModal({ invoice, clients, catalog, skills, onAddClient, onSave, onClose }) {
  const isNew = !invoice;
  const [clientId, setClientId] = useState(invoice?.clientId || "");
  const [title, setTitle] = useState(invoice?.title || "");
  const [issueDate, setIssueDate] = useState(invoice?.issueDate || iso(new Date()));
  const [dueDate, setDueDate] = useState(invoice?.dueDate || defaultInvoiceDueDate(invoice?.issueDate || iso(new Date())));
  const [lines, setLines] = useState(
    invoice?.lines?.length ? invoice.lines.map((l) => ({ ...l })) : [{ id: uid(), kind: "forfait", description: "", amount: 0, skillIds: [] }]
  );
  const [showNewClient, setShowNewClient] = useState(false);
  const [newClientName, setNewClientName] = useState("");
  const [newClientAddress, setNewClientAddress] = useState("");
  const [newClientEmail, setNewClientEmail] = useState("");
  const [newClientPhone, setNewClientPhone] = useState("");
  const [showCatalog, setShowCatalog] = useState(false);

  // L'échéance par défaut (30 jours) ne se recale QUE pour une nouvelle
  // facture encore vierge — même principe que QuoteFormModal.
  useEffect(() => {
    if (isNew) setDueDate(defaultInvoiceDueDate(issueDate));
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [issueDate]);

  const total = useMemo(() => lines.reduce((sum, l) => sum + quoteLineAmount(l), 0), [lines]);

  const updateLine = (id, patch) => setLines((prev) => prev.map((l) => (l.id === id ? { ...l, ...patch } : l)));
  const addLine = (kind) => setLines((prev) => [
    ...prev,
    kind === "regie"
      ? { id: uid(), kind: "regie", description: "", quantity: 1, unit: "hour", unitRate: 0, skillIds: [] }
      : { id: uid(), kind: "forfait", description: "", amount: 0, skillIds: [] },
  ]);
  const removeLine = (id) => setLines((prev) => prev.filter((l) => l.id !== id));
  const toggleLineSkill = (lineId, skillId) => setLines((prev) => prev.map((l) => {
    if (l.id !== lineId) return l;
    const ids = l.skillIds || [];
    return { ...l, skillIds: ids.includes(skillId) ? ids.filter((s) => s !== skillId) : [...ids, skillId] };
  }));

  const insertFromCatalog = (entry) => {
    const description = [entry.label, entry.description].filter(Boolean).join(" — ");
    setLines((prev) => [
      ...prev,
      entry.kind === "regie"
        ? { id: uid(), kind: "regie", description, quantity: 1, unit: entry.unit || "hour", unitRate: entry.unitRate || 0, skillIds: [...(entry.skillIds || [])] }
        : { id: uid(), kind: "forfait", description, amount: entry.amount || 0, skillIds: [...(entry.skillIds || [])] },
    ]);
    setShowCatalog(false);
  };

  const createClientInline = () => {
    if (!newClientName.trim()) return;
    const client = onAddClient({
      name: newClientName.trim(), address: newClientAddress.trim(),
      email: newClientEmail.trim(), phone: newClientPhone.trim(),
    });
    setClientId(client.id);
    setShowNewClient(false);
    setNewClientName(""); setNewClientAddress(""); setNewClientEmail(""); setNewClientPhone("");
  };

  const save = () => {
    onSave({
      clientId, title: title.trim(), issueDate, dueDate,
      lines: lines.filter((l) => (l.description || "").trim()),
    });
  };

  return (
    <Modal
      title={isNew ? "Nouvelle facture" : `Facture ${invoice.number}`}
      onClose={onClose}
      wide
      footer={
        <>
          <button className="lp-btn" onClick={onClose}>Annuler</button>
          <button className="lp-btn lp-btn-primary" onClick={save} disabled={!clientId || lines.length === 0}>Enregistrer</button>
        </>
      }
    >
      <div className="lp-field">
        <label>Client</label>
        <div style={{ display: "flex", gap: 6 }}>
          <select value={clientId} onChange={(e) => setClientId(e.target.value)} style={{ flex: 1 }}>
            <option value="">— Choisir —</option>
            {clients.map((c) => <option key={c.id} value={c.id}>{c.name}</option>)}
          </select>
          <button type="button" className="lp-btn" onClick={() => setShowNewClient((v) => !v)}><Plus size={13} style={{ marginRight: 4, verticalAlign: -2 }} />Client</button>
        </div>
      </div>
      {showNewClient && (
        <div className="lp-quote-inline-client">
          <div className="lp-field"><label>Nom</label><input value={newClientName} onChange={(e) => setNewClientName(e.target.value)} /></div>
          <div className="lp-field"><label>Adresse</label><input value={newClientAddress} onChange={(e) => setNewClientAddress(e.target.value)} /></div>
          <div className="lp-field"><label>Email</label><input value={newClientEmail} onChange={(e) => setNewClientEmail(e.target.value)} /></div>
          <div className="lp-field"><label>Téléphone</label><input value={newClientPhone} onChange={(e) => setNewClientPhone(e.target.value)} /></div>
          <button type="button" className="lp-btn lp-btn-primary" onClick={createClientInline}>Créer ce client</button>
        </div>
      )}
      <div className="lp-field"><label>Objet de la facture</label><input value={title} onChange={(e) => setTitle(e.target.value)} placeholder="Ex : Mission d'assistance à maîtrise d'ouvrage" /></div>
      <div style={{ display: "flex", gap: 10 }}>
        <div className="lp-field" style={{ flex: 1 }}><label>Date d'émission</label><input type="date" value={issueDate} onChange={(e) => setIssueDate(e.target.value)} /></div>
        <div className="lp-field" style={{ flex: 1 }}><label>Échéance</label><input type="date" value={dueDate} onChange={(e) => setDueDate(e.target.value)} /></div>
      </div>

      <div className="lp-section-title">Lignes de la facture</div>
      <div className="lp-quote-lines">
        {lines.map((l) => (
          <div key={l.id}>
            <div className="lp-quote-line-row">
              <select
                value={l.kind}
                onChange={(e) => updateLine(l.id, e.target.value === "regie"
                  ? { kind: "regie", quantity: l.quantity || 1, unit: l.unit || "hour", unitRate: l.unitRate || 0 }
                  : { kind: "forfait", amount: l.amount || 0 })}
              >
                <option value="forfait">Forfait</option>
                <option value="regie">Régie</option>
              </select>
              <input className="lp-quote-line-desc" placeholder="Description" value={l.description} onChange={(e) => updateLine(l.id, { description: e.target.value })} />
              {l.kind === "regie" ? (
                <>
                  <input type="number" min="0" step="0.5" style={{ width: 70 }} value={l.quantity} onChange={(e) => updateLine(l.id, { quantity: Number(e.target.value) })} title="Quantité" />
                  <select value={l.unit} onChange={(e) => updateLine(l.id, { unit: e.target.value })}>
                    {QUOTE_REGIE_UNITS.map((u) => <option key={u.key} value={u.key}>{u.label}</option>)}
                  </select>
                  <input type="number" step="1" style={{ width: 90 }} value={l.unitRate} onChange={(e) => updateLine(l.id, { unitRate: Number(e.target.value) })} placeholder="Taux HT" title="Taux unitaire HT" />
                </>
              ) : (
                <input type="number" step="1" style={{ width: 110 }} value={l.amount} onChange={(e) => updateLine(l.id, { amount: Number(e.target.value) })} placeholder="Montant HT" title="Montant HT" />
              )}
              <span className="lp-quote-line-amount">{fmtQuoteAmount(quoteLineAmount(l))}</span>
              <button type="button" className="lp-icon-btn" onClick={() => removeLine(l.id)} title="Supprimer la ligne"><Trash2 size={13} /></button>
            </div>
            <QuoteChipPicker skills={skills || []} selectedIds={l.skillIds} onToggle={(skillId) => toggleLineSkill(l.id, skillId)} />
          </div>
        ))}
      </div>
      <div style={{ display: "flex", gap: 6, flexWrap: "wrap" }}>
        <button type="button" className="lp-btn" onClick={() => addLine("forfait")}><Plus size={13} style={{ marginRight: 4, verticalAlign: -2 }} />Ligne forfait</button>
        <button type="button" className="lp-btn" onClick={() => addLine("regie")}><Plus size={13} style={{ marginRight: 4, verticalAlign: -2 }} />Ligne régie</button>
        <button type="button" className="lp-btn" onClick={() => setShowCatalog((v) => !v)}><BookOpen size={13} style={{ marginRight: 4, verticalAlign: -2 }} />Insérer depuis le catalogue</button>
      </div>
      {showCatalog && (
        <div className="lp-quote-catalog-picker">
          {(catalog || []).length === 0 ? (
            <span style={{ fontSize: 11.5, color: "var(--text-muted)" }}>Aucune entrée dans le catalogue — ajoute-en depuis Réglages entreprise › Catalogue.</span>
          ) : (catalog || []).map((entry) => (
            <button type="button" key={entry.id} className="lp-quote-catalog-picker-item" onClick={() => insertFromCatalog(entry)}>
              <span className="lp-quote-catalog-picker-label">{entry.label}</span>
              <span className="lp-quote-catalog-picker-meta">
                {entry.kind === "regie" ? `Régie · ${fmtQuoteAmount(entry.unitRate || 0)}` : `Forfait · ${fmtQuoteAmount(entry.amount || 0)}`}
              </span>
            </button>
          ))}
        </div>
      )}

      <div className="lp-quote-total">Total HT (TVA non applicable, art. 293 B du CGI — HT = TTC) : <strong>{fmtQuoteAmount(total)}</strong></div>
    </Modal>
  );
}


// ============================================================================
// Module Finance PRO — Quentin Morel Engineering (auto-entrepreneur, prestations
// intellectuelles). Chaîne prospect -> devis -> mission -> temps/dépenses ->
// facturation -> encaissement -> obligations -> pilotage, RATTACHÉE aux
// modules Devis/Facture existants (NEXORA:QUOTES/NEXORA:INVOICES, part-000) —
// jamais dupliquée. `quotes`/`quoteClients`/`projects` restent la seule
// source de vérité pour devis/clients/missions : les entités ci-dessous ne
// stockent que des RÉFÉRENCES (missionId -> projects.id, clientId ->
// quoteClients.id), jamais une seconde copie.
//
// Séparation stricte avec KDM360 : aucune fonction de ce bloc ne lit ni
// n'écrit `apps/nexora/netlify/functions/_shared/finance.ts` (Supabase
// KDM360/Budget360). Les entités ci-dessous vivent uniquement dans Firebase
// Nexora (clés `nexora:pro*`), comme le reste de l'application.
//
// Conception complète : docs/finance-pro/AUDIT_CONCEPTION.md (rattaché à
// l'issue #267 et aux lots #268-#277).
// ============================================================================

// === NEXORA:FINANCEPRO-CORE:START ===

// ---------------------------------------------------------------------------
// Constantes de référentiel
// ---------------------------------------------------------------------------

