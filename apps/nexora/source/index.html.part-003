  // COCHÉES = affichées), plus lisible pour Tous/Aucun.
  const [orgChartHiddenTeamIds, setOrgChartHiddenTeamIds] = useState(
    Array.isArray(widget?.orgChartHiddenTeamIds) ? widget.orgChartHiddenTeamIds : []
  );
  const orgChartTeamOptions = useMemo(
    () => normalizeTeams(ctx.teams).map((t) => ({ id: t.id, name: t.name, color: t.color })),
    [ctx.teams]
  );
  const orgChartVisibleTeamIds = orgChartTeamOptions.map((t) => t.id).filter((id) => !orgChartHiddenTeamIds.includes(id));
  // Filtre par dossier d'équipes (#215) : vide = tous les dossiers (comme
  // avant ce réglage). Se combine avec orgChartHiddenTeamIds plutôt que de
  // le remplacer — une équipe reste masquable individuellement même à
  // l'intérieur d'un dossier filtré.
  const [orgChartFolderId, setOrgChartFolderId] = useState(
    typeof widget?.orgChartFolderId === "string" ? widget.orgChartFolderId : ""
  );
  // Libellé de la boîte racine synthétique (#249) : n'apparaît que quand
  // plusieurs équipes de premier niveau se regroupent sous une racine commune
  // (roots.length > 1 dans OrgHierarchyChart). Vide = « Organisation », comme
  // avant ce réglage — le champ est stocké tel quel, sans valeur par défaut
  // écrite dedans, pour qu'un widget déjà en place reste identique tant que
  // personne n'y touche.
  // Relations propres à CE widget (#295) : liens libres équipe/personne, avec
