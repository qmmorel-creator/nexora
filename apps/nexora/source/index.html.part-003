  // un choix explicite étant requis.
  const [budgetProjectId, setBudgetProjectId] = useState(
    widget?.budgetProjectId || ((ctx.activeProjectIds || [])[0] ? CURRENT_PROJECT_FILTER : "")
  );
  const [burnRateProjectId, setBurnRateProjectId] = useState(widget?.burnRateProjectId || ctx.projects[0]?.id || "");
  // Organigramme (plan Métro, #295) : affichage des correspondances
