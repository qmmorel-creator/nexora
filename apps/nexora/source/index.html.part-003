  };
  const [taskDetailTaskId, setTaskDetailTaskId] = useState(widget?.taskDetailTaskId || "");
  const [userProfileMember, setUserProfileMember] = useState(widget?.userProfileMember || "");
  const [content, setContent] = useState(widget?.content || "");
  // #137 : plus de repli silencieux sur le premier projet du portefeuille à
  // la création du widget — "Projet courant" si un projet est déjà ouvert
