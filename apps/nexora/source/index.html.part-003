        if (c.kind === "task") { l.classList.toggle("is-urgent", !!(c.f && c.f.urgent)); l.classList.toggle("is-late", !!(c.f && c.f.late)); }
        l._w = l.offsetWidth; l._h = l.offsetHeight;
        if (l.tagName === "BUTTON") l.setAttribute("aria-label", labelAria(c));
      }
      const selected = !!(S.selected && S.selected.kind === c.kind && S.selected.id === c.id) || (c.kind === "planet" && c.id === S.planetId);
      if (l._sel !== selected) { l.classList.toggle("is-selected", selected); l._sel = selected; l._w = l.offsetWidth; l._h = l.offsetHeight; }
      l.classList.toggle("is-dim", (c.kind === "planet" && S.dimmed.has(c.id)) || (c.kind === "galaxy" && S.level === "universe" && !!S.selected && S.selected.kind === "galaxy" && S.selected.id !== c.id));
      let box = null;
      for (let si = 0; si < c.sides.length && !box; si++) {
        for (let k = 0; k < 3 && !box; k++) {
