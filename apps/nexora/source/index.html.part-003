      : v >= rect.x + r - 0.5 && v <= rect.x + rect.w - r + 0.5 && (Math.abs(p[1] - rect.y) < 0.5 || Math.abs(p[1] - rect.y - rect.h) < 0.5);
  };
  for (let guard = 0; guard < 20; guard++) {
    const n = pts.length;
    let done = true;
    for (let i = 1; i + 2 < n; i++) {
      const a = pts[i - 1], b = pts[i], c = pts[i + 1], d = pts[i + 2];
      const jogH = Math.abs(b[1] - c[1]) < 0.5 && Math.abs(b[0] - c[0]) > 0.5 && Math.abs(b[0] - c[0]) < ORGMETRO_JOG;
      const jogV = Math.abs(b[0] - c[0]) < 0.5 && Math.abs(b[1] - c[1]) > 0.5 && Math.abs(b[1] - c[1]) < ORGMETRO_JOG;
      if (!jogH && !jogV) continue;
      // Axe du décalage à supprimer : x pour un crochet horizontal, y sinon.
      const axis = jogH ? 0 : 1;
      const parallel = (p, q) => Math.abs(p[axis] - q[axis]) < 0.5;
      if (!parallel(a, b) || !parallel(c, d)) continue;
      if (i + 2 < n - 1) { c[axis] = b[axis]; d[axis] = b[axis]; }
      else if (i - 1 > 0) { a[axis] = c[axis]; b[axis] = c[axis]; }
      else if (!pinA && onFace(ra, a, axis, c[axis])) { a[axis] = c[axis]; b[axis] = c[axis]; }
      else if (!pinB && onFace(rb, d, axis, b[axis])) { c[axis] = b[axis]; d[axis] = b[axis]; }
      else continue;
      pts = orgMetroSimplifyRoute(pts);
      done = false;
      break;
    }
    if (done) break;
  }
  return pts;
}
// Finition commune d'un tracé : extrémités du bon côté, points de connexion
// épinglés, puis traits faiblement décalés alignés.
function orgMetroFinishRoute(points, ra, rb, entry) {
  let pts = orgMetroFaceEndpoints(points, ra, rb);
  const pinA = entry && ra ? orgMetroNormalizePort(entry.from) : null;
  const pinB = entry && rb ? orgMetroNormalizePort(entry.to) : null;
  if (pinA) pts = orgMetroPinEndpoint(pts, ra, pinA, false);
  if (pinB) pts = orgMetroPinEndpoint(pts, rb, pinB, true);
  return orgMetroStraightenRoute(pts, ra, rb, pinA, pinB);
}
// Point de connexion déplacé : enregistré sur le lien (from / to).
function orgMetroSetLinkPort(map, key, end, pin) {
  const cur = normalizeOrgMetroLinkOffsets(map);
  const p = orgMetroNormalizePort(pin);
  if (!p || (end !== "from" && end !== "to")) return cur;
  return normalizeOrgMetroLinkOffsets({ ...cur, [key]: { ...(cur[key] || {}), [end]: p } });
}
// Points de liaison du bon côté (retour de test) : une extrémité posée sur un
// bord de bandeau alors que le tracé repart vers le côté OPPOSÉ (lien
// déplacé, ou bandeau qui a bougé) est ramenée sur le bord qui fait face au
// tracé — ou sur le bord haut / bas quand le tracé repart à la verticale
// au-dessus / au-dessous du bandeau. Jamais de lien qui traverse son propre
// bandeau pour ressortir de l'autre côté.
function orgMetroFaceEndpoints(points, ra, rb) {
  const out = points.map((p) => [p[0], p[1]]);
  const fix = (i, dir, r) => {
    const p = out[i], q = out[i + dir], n2 = out[i + 2 * dir];
    if (!r || !q || Math.abs(p[1] - q[1]) > 0.5) return;
    const left = r.x, right = r.x + r.w;
    if (q[0] < left - 0.5 && p[0] > left + 0.5) p[0] = left;
    else if (q[0] > right + 0.5 && p[0] < right - 0.5) p[0] = right;
    else if (q[0] >= left - 0.5 && q[0] <= right + 0.5 && n2 && Math.abs(n2[0] - q[0]) < 0.5) {
      // Le tracé repart à la verticale depuis l'aplomb du bandeau.
      if (n2[1] < r.y) { p[0] = q[0]; p[1] = r.y; q[1] = r.y; }
      else if (n2[1] > r.y + r.h) { p[0] = q[0]; p[1] = r.y + r.h; q[1] = r.y + r.h; }
    }
  };
  if (out.length >= 2) {
    fix(0, 1, ra);
    fix(out.length - 1, -1, rb);
  }
  return orgMetroSimplifyRoute(out);
}
// Nettoyage d'un tracé orthogonal (retour de test : lignes prolongées trop
// loin) : points confondus retirés, et tout point intermédiaire aligné avec
// ses deux voisins supprimé — y compris un aller-retour sur une même droite
// (un décalage dans le sens d'un segment, ou un plan qui a changé depuis le
// déplacement du lien, ne laisse jamais de trait qui dépasse puis revient).
function orgMetroSimplifyRoute(points) {
  let pts = points.filter((p, i) => i === 0 || p[0] !== points[i - 1][0] || p[1] !== points[i - 1][1]);
  let changed = true;
  while (changed && pts.length > 2) {
    changed = false;
    for (let i = 1; i < pts.length - 1; i++) {
      const [a, b, c] = [pts[i - 1], pts[i], pts[i + 1]];
      const sameX = Math.abs(a[0] - b[0]) < 0.5 && Math.abs(b[0] - c[0]) < 0.5;
      const sameY = Math.abs(a[1] - b[1]) < 0.5 && Math.abs(b[1] - c[1]) < 0.5;
      const same = Math.abs(a[0] - b[0]) < 0.5 && Math.abs(a[1] - b[1]) < 0.5;
      if (sameX || sameY || same) {
        pts = [...pts.slice(0, i), ...pts.slice(i + 1)];
        changed = true;
        break;
      }
    }
  }
  return pts;
}
// Étoile à cinq branches (repère du responsable), centrée en (cx, cy).
function orgMetroStarPath(cx, cy, r) {
  const pts = [];
  for (let i = 0; i < 10; i++) {
    const rad = i % 2 ? r * 0.45 : r;
    const a = -Math.PI / 2 + (i * Math.PI) / 5;
    pts.push((i ? "L " : "M ") + (cx + rad * Math.cos(a)).toFixed(2) + " " + (cy + rad * Math.sin(a)).toFixed(2));
  }
  return pts.join(" ") + " Z";
}
// --- Vues enregistrées (retour de test) ------------------------------------------
// Une vue = un instantané NOMMÉ de la disposition du plan, propre au widget
// (widget.orgMetroViews) : ordre et déplacements des lignes et des liens,
// replis, disposition verticale / horizontale des équipes, répartition des
// équipes empilées, correspondances affichées. Recharger une vue réapplique
// exactement ces réglages ; les données (équipes, personnes) restent celles du
// moment.
const ORGMETRO_VIEW_DEFAULTS = {
  orgMetroOrder: null, orgMetroOffsets: null, orgMetroLinkOffsets: null, orgMetroCollapsed: [],
  orgMetroStackSplit: null, orgMetroHorizontalTeams: [], orgMetroStackedTeams: [], orgMetroShowTransverse: true,
  orgMetroLeadInBadge: false,
};
const ORGMETRO_VIEW_MAX = 30;
function orgMetroViewSnapshot(state) {
  const out = {};
  Object.keys(ORGMETRO_VIEW_DEFAULTS).forEach((k) => {
    const v = state ? state[k] : undefined;
    out[k] = v === undefined ? ORGMETRO_VIEW_DEFAULTS[k] : JSON.parse(JSON.stringify(v));
  });
  return out;
}
// Réglages à écrire sur le widget pour recharger une vue : tout champ absent
// de l'instantané revient à sa valeur par défaut.
function orgMetroViewPatch(state) {
  return orgMetroViewSnapshot(state && typeof state === "object" ? state : {});
}
function normalizeOrgMetroViews(list) {
  const seen = new Set();
  return (Array.isArray(list) ? list : [])
    .filter((v) => v && typeof v === "object" && String(v.name || "").trim())
    .map((v, i) => ({
      id: String(v.id || "view-" + i),
      name: String(v.name).trim().slice(0, 60),
      savedAt: typeof v.savedAt === "string" ? v.savedAt : "",
      state: orgMetroViewPatch(v.state),
    }))
    .filter((v) => (seen.has(v.id) ? false : (seen.add(v.id), true)))
    .slice(0, ORGMETRO_VIEW_MAX);
}
// Enregistrer sous un nom : un nom déjà pris remplace la vue du même nom.
function orgMetroSaveView(views, name, state, now, id) {
  const clean = String(name || "").trim().slice(0, 60);
  const list = normalizeOrgMetroViews(views);
  if (!clean) return list;
  const existing = list.find((v) => v.name.toLocaleLowerCase("fr") === clean.toLocaleLowerCase("fr"));
  const view = { id: existing ? existing.id : id, name: clean, savedAt: now, state: orgMetroViewSnapshot(state) };
  return existing ? list.map((v) => (v.id === existing.id ? view : v)) : [...list, view].slice(-ORGMETRO_VIEW_MAX);
}
// === NEXORA:ORGMETRO:END ===

// === NEXORA:ORGRELATIONS:START ===
// Relations propres à un widget Organigramme (retour de test sur #295) : des
// liens LIBRES, enregistrés sur le widget (widget.orgChartRelations) et non
// dans le catalogue d'équipes — deux widgets peuvent donc raconter deux
// histoires différentes sur la même organisation, sans rien changer à la
// hiérarchie. Une extrémité est une équipe (« team:<id> ») ou une personne
// (« person:<nom> », le nom étant l'identifiant des personnes, comme
// managerName ou leadName). Une légende texte facultative accompagne le lien.
const ORGRELATION_LABEL_MAX = 80;
function orgRelationRefParse(ref) {
  const m = /^(team|person):(.+)$/.exec(String(ref || ""));
  return m ? { type: m[1], id: m[2] } : null;
}
function normalizeOrgChartRelations(list) {
  const seen = new Set();
  return (Array.isArray(list) ? list : [])
    .filter((r) => r && typeof r === "object")
    .map((r, i) => ({
      id: String(r.id || "rel-" + i),
      from: String(r.from || ""),
      to: String(r.to || ""),
      label: String(r.label || "").trim().slice(0, ORGRELATION_LABEL_MAX),
      // Occurrence visée d'une personne présente à plusieurs endroits : l'id
      // de l'équipe où se trouve la station choisie ; vide = sa première
      // occurrence (comportement d'origine).
      fromAt: r.fromAt ? String(r.fromAt) : "",
      toAt: r.toAt ? String(r.toAt) : "",
    }))
    .filter((r) => orgRelationRefParse(r.from) && orgRelationRefParse(r.to) && r.from !== r.to)
    .filter((r) => {
      if (seen.has(r.id)) return false;
      seen.add(r.id);
      return true;
    });
}
// Choix proposés dans la fiche du widget : équipes puis personnes, triées.
function orgChartRelationOptions(teams, members) {
  const byName = (a, b) => a.label.localeCompare(b.label, "fr");
  const teamOpts = normalizeTeams(teams).map((t) => ({ id: "team:" + t.id, label: "Équipe · " + t.name })).sort(byName);
  const personOpts = (members || []).filter((m) => m && m.name).map((m) => ({ id: "person:" + m.name, label: m.name })).sort(byName);
  return [...teamOpts, ...personOpts];
}
// Équipes où une personne apparaît dans l'Organigramme (membre, ou
// responsable même sans en être membre) : autant d'occurrences possibles
// pour une extrémité de relation.
function orgChartPersonOccurrenceTeams(name, teams, members) {
  const catalogue = normalizeTeams(teams);
  const m = (members || []).find((x) => x && x.name === name);
  const ids = new Set([...(m ? memberTeamIds(m) : []).map(String), ...catalogue.filter((t) => t.leadName === name).map((t) => t.id)]);
  return catalogue.filter((t) => ids.has(t.id)).map((t) => ({ id: t.id, label: t.name }));
}
// Relations dont les deux extrémités existent dans CE rendu (équipe visible,
// personne présente) : une équipe masquée ou une personne partie retire le
// lien de l'affichage, sans jamais l'effacer du widget.
function orgChartVisibleRelations(relations, hasTeam, hasPerson) {
  return normalizeOrgChartRelations(relations).filter((r) => [r.from, r.to].every((ref) => {
    const p = orgRelationRefParse(ref);
    return p.type === "team" ? hasTeam(p.id) : hasPerson(p.id);
  }));
}
// Position de la légende : au milieu du plus long segment du tracé.
function orgRelationLabelAnchor(points) {
  let best = null;
  for (let i = 1; i < points.length; i++) {
    const len = Math.abs(points[i][0] - points[i - 1][0]) + Math.abs(points[i][1] - points[i - 1][1]);
    if (!best || len > best.len) best = { len, x: (points[i][0] + points[i - 1][0]) / 2, y: (points[i][1] + points[i - 1][1]) / 2 };
  }
  return best ? { x: best.x, y: best.y } : null;
}
// Place de la légende (retour de visuel) : sur le tracé, jamais sur un texte.
// On essaie chaque segment, du plus long au plus court, en partant de son
// milieu puis en s'en écartant pas à pas ; le premier emplacement où la
// pastille (w × h) ne touche aucun obstacle l'emporte. À défaut, le milieu
// du plus long segment.
const ORGRELATION_LABEL_H = 18;
function orgRelationLabelWidth(label) {
  return Math.ceil(String(label || "").length * 6.2 + 18);
}
function orgRelationLabelPlacement(points, w, h, obstacles) {
  const segs = [];
  for (let i = 1; i < points.length; i++) {
    const [x1, y1] = points[i - 1];
    const [x2, y2] = points[i];
    segs.push({ i, x1, y1, x2, y2, len: Math.abs(x2 - x1) + Math.abs(y2 - y1) });
  }
  segs.sort((a, b) => b.len - a.len || a.i - b.i);
  const free = (cx, cy) => !(obstacles || []).some((r) => cx - w / 2 < r.x + r.w && r.x < cx + w / 2 && cy - h / 2 < r.y + r.h && r.y < cy + h / 2);
  for (const sg of segs) {
    const steps = Math.max(1, Math.floor(sg.len / 8));
    for (let k = 0; k <= steps; k++) {
      for (const sign of k ? [1, -1] : [1]) {
        const t = 0.5 + (sign * k) / (2 * steps);
        if (t < 0 || t > 1) continue;
        const cx = sg.x1 + (sg.x2 - sg.x1) * t;
        const cy = sg.y1 + (sg.y2 - sg.y1) * t;
        if (free(cx, cy)) return { x: cx, y: cy };
      }
    }
  }
  return orgRelationLabelAnchor(points);
}
// Relations dans le plan Métro : accroche = bandeau d'une ligne, ou station
// (canonique de préférence) et son libellé pour une personne.
function orgMetroRelationRoutes(layout, relations, linkOffsets) {
  const lo = normalizeOrgMetroLinkOffsets(linkOffsets);
  const obstacles = orgMetroObstacles(layout);
  const top = layout.branches.reduce((m, b) => Math.min(m, b.badge ? b.badge.y : b.y), Infinity);
  const branchByKey = new Map(layout.branches.map((b) => [b.key, b]));
  const anchor = (ref, at) => {
    const p = orgRelationRefParse(ref);
    if (!p) return null;
    if (p.type === "team") {
      const hit = orgMetroTeamAnchor(layout, p.id);
      return hit ? { rect: hit.rect, keys: ["badge:" + hit.branch.key], kind: "team", color: hit.branch.color || null } : null;
    }
    // Occurrence choisie (équipe `at`), sinon la première occurrence.
    const hit = orgMetroPersonAnchor(layout, p.id, at);
    return hit ? { rect: hit.rect, keys: hit.keys, kind: "person", color: null } : null;
  };
  const hasTeam = (id) => Boolean(orgMetroTeamAnchor(layout, id));
  const hasPerson = (name) => layout.stations.some((s) => s.name === name) || layout.branches.some((b) => b.badgeLead && b.badgeLead.name === name);
  // La légende évite aussi les traits (troncs, raccords, coudes) et les
  // correspondances blanches, pas seulement les textes.
  const labelObstacles = [...obstacles];
  layout.branches.forEach((b) => {
    const w = b.lineW + 4;
    orgMetroLineRects({ trunk: b.trunk, upTrunk: b.upTrunk, badge: b.badge, row: b.row, elbow: b.elbow }).forEach((r) => labelObstacles.push({ x: r.x - w / 2, y: r.y - w / 2, w: r.w + w, h: r.h + w }));
    if (b.drop) labelObstacles.push({ x: b.drop.x - w / 2, y: b.drop.y0, w, h: b.drop.y1 - b.drop.y0 });
  });
  orgMetroJunctions(layout).forEach((j) => labelObstacles.push({ x: j.x - 7, y: j.y - 7, w: 14, h: 14 }));
  return orgChartVisibleRelations(relations, hasTeam, hasPerson).map((r) => {
    const A = anchor(r.from, r.fromAt);
    const B = anchor(r.to, r.toAt);
    const skip = new Set([...A.keys, ...B.keys]);
    const best = orgMetroRouteRects(A.rect, B.rect, obstacles.filter((o) => !skip.has(o.key)), top);
    const key = "relation:" + r.id;
    const edit = orgMetroEditRoute(best.pts, lo[key]);
    const pts = orgMetroFinishRoute(edit.points, A.rect, B.rect, lo[key]);
    const labelAt = r.label ? orgRelationLabelPlacement(pts, orgRelationLabelWidth(r.label), ORGRELATION_LABEL_H, labelObstacles) : null;
    return {
      movable: edit.movable,
      key, id: r.id, from: r.from, to: r.to, label: r.label, points: pts, hits: best.hits, d: orgMetroPolylineD(pts), labelAt,
      fromKind: A.kind, toKind: B.kind, fromColor: A.color, toColor: B.color, fromRect: A.rect, toRect: B.rect,
    };
  });
}
// === NEXORA:ORGRELATIONS:END ===

// Racines visibles de l'Organigramme, communes aux deux modes de rendu :
// arbre construit par buildOrgHierarchyTree, « Sans équipe » retiré si le
// réglage le demande, puis rapprochement des partenaires transverses (#235,
// #244). La vue Métro (#295) consomme donc EXACTEMENT les mêmes racines que la
// vue hiérarchique.
function orgChartVisibleRoots(teams, members, showUnassigned) {
  const allRoots = buildOrgHierarchyTree(teams, members);
  const filtered = showUnassigned === false ? allRoots.filter((r) => r.team !== null) : allRoots;
  return reorderOrgHierarchyRoots(filtered, teams);
}

// --- Vue Métro : rendu SVG (#295) -------------------------------------------
// Aucune sémantique n'est recalculée ici : tout vient de layoutOrgMetro et des
// helpers purs du bloc NEXORA:ORGMETRO. Les couleurs de ligne sont celles des
// équipes (données) ; les neutres suivent les variables de thème.
const ORGMETRO_NEUTRAL_LINE = "var(--text-muted, #7a8290)";
const ORGMETRO_HUB_LINE = "var(--life-text, #18263d)";
const ORGMETRO_MIN_ZOOM = 0.15;
const ORGMETRO_MAX_ZOOM = 3;
const ORGMETRO_FIT_MARGIN = 16;
// À l'ouverture, le plan n'est jamais réduit sous ce zoom : dans un widget
// étroit, il vaut mieux un plan lisible cadré en haut, que l'on parcourt au
// doigt, qu'un plan entier illisible.
// « Ajuster à l'écran » reste disponible pour voir le plan entier.
const ORGMETRO_MIN_OPEN_ZOOM = 0.6;
const orgMetroColor = (color, kind) => color || (kind === "hub" ? ORGMETRO_HUB_LINE : ORGMETRO_NEUTRAL_LINE);
const orgMetroClampZoom = (k) => Math.min(ORGMETRO_MAX_ZOOM, Math.max(ORGMETRO_MIN_ZOOM, k));

// Lignes : troncs (groupe « lignes »), barres de bifurcation et raccords
// (groupe « branches »). Une barre porte la couleur de la ligne PARENTE : c'est
// elle qui se divise, depuis un seul point aligné.
function OrgMetroLines({ layout, dim }) {
  const trunks = [];
  const forks = [];
  layout.branches.forEach((b) => {
    const p = orgMetroBranchPaths(b);
    const cls = dim(b.key) ? " is-dim" : "";
    const color = orgMetroColor(b.color, b.kind);
    // data-metro-drag : attraper une ligne déplace la ligne d'équipe entière.
    const drag = "branch:" + b.key;
    // Chaque trait a sa zone de prise invisible, plus large que le trait :
    // le curseur « main » apparaît sans avoir à viser au pixel près.
    const hit = (key, d, target) => <path key={"h" + key} className="lp-orgmetro-line-hit" d={d} data-metro-drag={target} />;
    // Équipe empilée : sa ligne verticale se glisse pour faire monter ou
    // descendre le bandeau entre ses sous-équipes.
    const trunkDrag = b.stackable ? "split:" + b.key : drag;
    if (p.trunk) trunks.push(<path key={"t:" + b.key} className={"lp-orgmetro-line" + cls} d={p.trunk} data-metro-drag={trunkDrag} style={{ stroke: color, strokeWidth: b.lineW }} />, hit("t:" + b.key, p.trunk, trunkDrag));
    if (p.row) trunks.push(<path key={"r:" + b.key} className={"lp-orgmetro-line" + cls} d={p.row} data-metro-drag={drag} style={{ stroke: color, strokeWidth: b.lineW }} />, hit("r:" + b.key, p.row, drag));
    // La barre de bifurcation appartient à son nœud : l'attraper déplace le
    // nœud et les lignes qui en partent.
    if (p.fork) forks.push(<path key={"f:" + b.key} className={"lp-orgmetro-line" + cls} d={p.fork} data-metro-drag={"fork:" + b.key} style={{ stroke: color, strokeWidth: b.lineW }} />, hit("f:" + b.key, p.fork, "fork:" + b.key));
    // Trait horizontal d'une sous-équipe empilée : il se glisse en hauteur.
    const dropDrag = b.elbow && b.elbow.stacked ? "elbow:" + b.key : drag;
    if (p.drop) forks.push(<path key={"d:" + b.key} className={"lp-orgmetro-line" + cls} d={p.drop} data-metro-drag={dropDrag} style={{ stroke: color, strokeWidth: b.lineW }} />, hit("d:" + b.key, p.drop, dropDrag));
  });
  return (
    <>
      <g className="lp-orgmetro-lines">{trunks}</g>
      <g className="lp-orgmetro-branches">{forks}</g>
    </>
  );
}

// Correspondances : liens transverses entre lignes (pointillés, pastilles de
// correspondance aux deux bouts) et, au survol d'une personne multi-équipe,
// la liaison entre ses occurrences.
function OrgMetroCorrespondences({ routes, relationRoutes, occurrenceLinks, dimRoute, dimRelation }) {
  return (
    <g className="lp-orgmetro-correspondences">
      {relationRoutes.map((r) => {
        const labelW = r.label ? orgRelationLabelWidth(r.label) : 0;
        return (
          <g key={r.key} className={"lp-orgmetro-relation-group" + (dimRelation(r) ? " is-dim" : "")} data-metro-drag={"link:" + r.key}>
            <title>{"Relation" + (r.label ? " — " + r.label : "") + " · glisser pour déplacer"}</title>
            <path className="lp-orgmetro-link-hit" d={r.d} />
            <path className="lp-orgmetro-relation" d={r.d} />
            {r.labelAt && (
              <>
                <rect className="lp-orgmetro-relation-pill" x={r.labelAt.x - labelW / 2} y={r.labelAt.y - 9} width={labelW} height={18} rx={9} />
                <text className="lp-orgmetro-relation-label" x={r.labelAt.x} y={r.labelAt.y} textAnchor="middle" dominantBaseline="central">{r.label}</text>
              </>
            )}
          </g>
        );
      })}
      {routes.map((r) => {
        const cls = dimRoute(r) ? " is-dim" : "";
        // Lien secondaire hiérarchique : trait plein de la couleur de la
        // seconde équipe parente, comme une ligne de métro.
        if (r.hierarchical) return (
          <g key={r.key} className={"lp-orgmetro-secondary-group" + cls} data-metro-drag={"link:" + r.key}>
            <title>Rattachement hiérarchique secondaire · glisser pour déplacer</title>
            <path className="lp-orgmetro-link-hit" d={r.d} />
            <path className="lp-orgmetro-secondary" d={r.d} style={{ stroke: orgMetroColor(r.toColor, "team"), strokeWidth: r.lineW }} />
          </g>
        );
        return (
          <g key={r.key} className={"lp-orgmetro-transverse-group" + cls} data-metro-drag={"link:" + r.key}>
            <title>Lien transverse · glisser pour déplacer</title>
            <path className="lp-orgmetro-link-hit" d={r.d} />
            <path className="lp-orgmetro-transverse" d={r.d} />
          </g>
        );
      })}
      {occurrenceLinks.map((l) => <path key={l.key} className="lp-orgmetro-occurrence" d={l.d} />)}
    </g>
  );
}

// Rivets d'accroche des correspondances et des relations (retour de test :
// les ronds creux sous les bandeaux faisaient « pas fini »). Dessinés
// PAR-DESSUS les bandeaux, centrés sur leur bord : un rivet plein de la
// couleur de la ligne, cerclé de blanc, qui ancre visiblement le lien dans
// l'équipe. Côté personne, un point plein discret de la couleur du lien.
// Points de connexion : chacun s'attrape (data-metro-drag « port:<bout>:<lien> »)
// et glisse le long des bords de son bandeau.
function OrgMetroPorts({ routes, relationRoutes, dimRoute, dimRelation, editable }) {
  const port = (key, p, kind, color, cls, dimmed, drag) => {
    const common = { key, "data-metro-drag": editable && drag ? drag : undefined };
    const c = cls + (dimmed ? " is-dim" : "") + (editable && drag ? " is-draggable" : "");
    return kind === "person"
      ? <circle {...common} className={"lp-orgmetro-port is-person " + c} cx={p[0]} cy={p[1]} r={3.25} />
      : <circle {...common} className={"lp-orgmetro-port is-team " + c} cx={p[0]} cy={p[1]} r={5} style={{ fill: orgMetroColor(color, "team") }} />;
  };
  const drags = (r) => [r.fromRect ? "port:from:" + r.key : null, r.toRect && !r.toPerson ? "port:to:" + r.key : null];
  return (
    <g className="lp-orgmetro-ports" aria-hidden="true">
      {relationRoutes.map((r) => [
        // Accroche sur une personne : sa station reste cliquable, seul un
        // point posé sur un bandeau d'équipe se déplace.
        port(r.key + ":a", r.points[0], r.fromKind, r.fromColor, "is-relation", dimRelation(r), r.fromKind === "team" ? drags(r)[0] : null),
        port(r.key + ":b", r.points[r.points.length - 1], r.toKind, r.toColor, "is-relation", dimRelation(r), r.toKind === "team" ? drags(r)[1] : null),
      ])}
      {routes.map((r) => [
        port(r.key + ":a", r.points[0], "team", r.fromColor, "is-transverse", dimRoute(r), drags(r)[0]),
        port(r.key + ":b", r.points[r.points.length - 1], "team", r.toColor, "is-transverse", dimRoute(r), drags(r)[1]),
      ])}
    </g>
  );
}

// Stations : points de bifurcation, puis une station par occurrence de
// personne — forme selon l'importance (responsable, lead, manager, membre),
// pastille pour une station de correspondance (personne multi-équipe) : la
// géométrie reste lisible sans la couleur.
function OrgMetroStations({ layout, dim, focusKey }) {
  const junctions = orgMetroJunctions(layout).map((j) => (
    <circle
      key={j.key}
      className={"lp-orgmetro-junction" + (j.key.startsWith("j:") ? " is-draggable" : "") + (dim(j.branchKey) ? " is-dim" : "")}
      cx={j.x} cy={j.y} r={j.lineW / 2 + 2.5}
      data-metro-drag={j.key.startsWith("j:") ? "fork:" + j.branchKey : undefined}
      style={{ stroke: orgMetroColor(j.color, j.kind), strokeWidth: 2.5 }}
    />
  ));
  return (
    <g className="lp-orgmetro-stations">
      {junctions}
      {layout.stations.map((s) => {
        // Inactif : station grise, quelle que soit la couleur de la ligne.
        const color = s.inactive ? ORGMETRO_NEUTRAL_LINE : orgMetroColor(s.color, "team");
        const cls = "lp-orgmetro-station is-" + s.level + (s.inactive ? " is-inactive" : "") + (s.pill ? " is-pill" : "") + (s.duplicate ? " is-duplicate" : "") + (dim(s.branchKey, s.key) ? " is-dim" : "") + (focusKey === s.key ? " is-focus" : "");
        const aria = s.name + (s.role ? " — " + s.role : "") + (s.leads.length ? " — responsable de " + s.leads.join(", ") : "") + (s.duplicate ? " (correspondance)" : "") + (s.inactive ? " (inactif)" : "");
        return (
          <g key={s.key} className={cls} data-metro-key={s.key} data-metro-drag={"branch:" + s.branchKey} tabIndex={0} role="button" aria-label={aria}>
            <title>{aria}</title>
            {s.pill ? (
              <rect x={s.cx - s.r} y={s.cy - 4.5} width={s.r * 2} height={9} rx={4.5} style={{ stroke: color }} />
            ) : (
              <circle cx={s.cx} cy={s.cy} r={s.r} style={{ stroke: color, strokeWidth: s.stroke }} />
            )}
            {s.kind === "lead" && <circle className="lp-orgmetro-lead-halo" cx={s.cx} cy={s.cy} r={s.half - 1} />}
            {s.level === "lead-root" && <circle className="lp-orgmetro-station-core" cx={s.cx} cy={s.cy} r={2.6} />}
            {s.level === "lead-sub" && <circle className="lp-orgmetro-station-core" cx={s.cx} cy={s.cy} r={2} style={{ fill: color }} />}
          </g>
        );
      })}
    </g>
  );
}

// Libellés : bandeaux de ligne (équipe, ou racine « Organisation »), puis nom
// et poste de chaque station, à droite de la ligne — jamais tronqués.
function OrgMetroLabels({ layout, dim, drag }) {
  return (
    <g className="lp-orgmetro-labels">
      {layout.branches.filter((b) => b.badge).map((b) => {
        const bd = b.badge;
        const color = orgMetroColor(b.color, b.kind);
        const isHub = b.kind === "hub";
        // Pointillés : ligne transverse indépendante, jamais une équipe
        // rattachée à un utilisateur (reliée en trait plein).
        const cls = "lp-orgmetro-badge is-" + bd.level + (b.independent && !b.personParent ? " is-independent" : "") + (b.team ? " is-clickable" : "") + (b.collapsed ? " is-collapsed" : "") + (dim(b.key) ? " is-dim" : "");
        // Variante ★ : le responsable occupe une bande en bas du bandeau,
        // teinte plus soutenue de la couleur de l'équipe ; le nom de l'équipe
        // et son compteur se centrent au-dessus.
        const bandH = bd.subtitle ? ORGMETRO_BADGE_BAND_H : 0;
        const headH = bd.h - bandH;
        const textTop = bd.y + (headH - bd.lines.length * bd.lineH) / 2 + bd.lineH * 0.74;
        const subY = bd.y + bd.h - bandH / 2 + 4;
        const rx = bd.h / 2 > 16 ? 16 : bd.h / 2;
        const bandD = bandH ? `M ${bd.x} ${bd.y + headH} H ${bd.x + bd.w} V ${bd.y + bd.h - rx} A ${rx} ${rx} 0 0 1 ${bd.x + bd.w - rx} ${bd.y + bd.h} H ${bd.x + rx} A ${rx} ${rx} 0 0 1 ${bd.x} ${bd.y + bd.h - rx} Z` : "";
        return (
          <g key={"b:" + b.key} className={cls + (drag && drag.key === b.key ? " is-dragging" : "")} data-metro-drag={"branch:" + b.key} data-metro-key={b.team ? b.key : undefined} tabIndex={b.team ? 0 : undefined} role={b.team ? "button" : undefined} aria-label={b.team ? "Équipe " + b.team.name : undefined}>
            {b.team && <title>{"Équipe " + b.team.name + " — " + bd.count + " personne" + (Number(bd.count) > 1 ? "s" : "") + (b.leadName ? " — responsable : " + b.leadName : " — aucun responsable") + (b.collapsed ? " · clic pour déplier" : " · clic pour replier") + " · double-clic pour modifier"}</title>}
            <rect className="lp-orgmetro-badge-bg" x={bd.x} y={bd.y} width={bd.w} height={bd.h} rx={rx} />
            {bandD && <path className="lp-orgmetro-badge-band" d={bandD} style={{ fill: color }} />}
            {!isHub && <rect className="lp-orgmetro-badge-tint" x={bd.x} y={bd.y} width={bd.w} height={bd.h} rx={rx} style={{ fill: color, stroke: color }} />}
            {bd.lines.map((line, i) => (
              <text key={i} className="lp-orgmetro-badge-text" x={isHub ? bd.x + bd.w / 2 : bd.x + bd.padX} y={textTop + i * bd.lineH} textAnchor={isHub ? "middle" : "start"}>{line}</text>
            ))}
            {bd.subtitle && (
              <>
                <path className="lp-orgmetro-lead-star" d={orgMetroStarPath(bd.x + bd.padX + 5, subY - 4, 5)} />
                <text className="lp-orgmetro-badge-sub" x={bd.x + bd.padX + ORGMETRO_STAR_W} y={subY}>{bd.subtitle}</text>
              </>
            )}
            {bd.count && (
              <>
                {/* Chiffre centré dans sa pastille, horizontalement ET
                    verticalement (dominant-baseline), quelle que soit la
                    hauteur du bandeau. */}
                <rect className="lp-orgmetro-badge-count-bg" x={bd.x + bd.w - bd.padX - bd.countW} y={bd.y + headH / 2 - ORGMETRO_COUNT_H / 2} width={bd.countW} height={ORGMETRO_COUNT_H} rx={ORGMETRO_COUNT_H / 2} style={{ fill: color }} />
                <text className="lp-orgmetro-badge-count" x={bd.x + bd.w - bd.padX - bd.countW / 2} y={bd.y + headH / 2} textAnchor="middle" dominantBaseline="central" style={{ fill: b.color ? textOn(b.color) : "#ffffff" }}>{bd.count}</text>
              </>
            )}
          </g>
        );
      })}
      {layout.stations.map((s) => {
        const top = s.label.y;
        return (
          <g key={"l:" + s.key} className={"lp-orgmetro-label is-" + s.level + (s.inactive ? " is-inactive" : "") + (dim(s.branchKey, s.key) ? " is-dim" : "")} data-metro-key={s.key} data-metro-drag={"branch:" + s.branchKey}>
            {s.starW > 0 && <path className="lp-orgmetro-lead-star" d={orgMetroStarPath(s.label.x + 5.5, top + 7.5, 5.5)} />}
            {s.nameLines.map((line, i) => (
              <text key={"n" + i} className="lp-orgmetro-name" x={s.label.x + s.starW} y={top + i * ORGMETRO_NAME_LINE_H + 11.5}>{line}</text>
            ))}
            {s.roleLines.map((line, i) => (
              <text key={"r" + i} className={"lp-orgmetro-role" + (s.roleIsFallback ? " is-fallback" : "")} x={s.label.x} y={top + s.nameLines.length * ORGMETRO_NAME_LINE_H + i * ORGMETRO_ROLE_LINE_H + 10}>{line}</text>
            ))}
          </g>
        );
      })}
    </g>
  );
}

// Export (#295) : le SVG affiché, à l'échelle 1, styles calculés recopiés en
// attributs pour qu'il reste identique hors de Nexora ; le PNG en est une
// rastérisation au double de sa taille. Rien ne transite par le serveur.
const ORGMETRO_EXPORT_STYLE_PROPS = ["fill", "fill-opacity", "stroke", "stroke-width", "stroke-dasharray", "stroke-linecap", "stroke-linejoin", "stroke-opacity", "opacity", "font-family", "font-size", "font-weight"];
function orgMetroSerializeSvg(svgEl, layout) {
  const clone = svgEl.cloneNode(true);
  const src = svgEl.querySelectorAll("*");
  const dst = clone.querySelectorAll("*");
  src.forEach((el, i) => {
    const cs = window.getComputedStyle(el);
    const target = dst[i];
    ORGMETRO_EXPORT_STYLE_PROPS.forEach((p) => { target.style.setProperty(p, cs.getPropertyValue(p)); });
    target.removeAttribute("class");
    target.removeAttribute("tabindex");
  });
  clone.setAttribute("xmlns", "http://www.w3.org/2000/svg");
  clone.setAttribute("width", String(layout.width));
  clone.setAttribute("height", String(layout.height));
  clone.setAttribute("viewBox", `0 0 ${layout.width} ${layout.height}`);
  clone.removeAttribute("class");
  clone.removeAttribute("style");
  const viewport = clone.querySelector("[data-metro-viewport]");
  if (viewport) viewport.removeAttribute("transform");
  const bg = document.createElementNS("http://www.w3.org/2000/svg", "rect");
  bg.setAttribute("width", "100%");
  bg.setAttribute("height", "100%");
  bg.setAttribute("fill", window.getComputedStyle(svgEl.parentElement || svgEl).backgroundColor || "#ffffff");
  clone.insertBefore(bg, clone.firstChild);
  return new XMLSerializer().serializeToString(clone);
}
function orgMetroDownload(blob, filename) {
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url;
  a.download = filename;
  document.body.appendChild(a);
  a.click();
  a.remove();
  setTimeout(() => URL.revokeObjectURL(url), 1000);
}
function orgMetroExport(svgEl, layout, format) {
  if (!svgEl || !layout || !layout.width) return;
  const xml = orgMetroSerializeSvg(svgEl, layout);
  const svgBlob = new Blob([xml], { type: "image/svg+xml;charset=utf-8" });
  if (format === "svg") { orgMetroDownload(svgBlob, "organigramme-metro.svg"); return; }
  // Les navigateurs plafonnent la taille d'un canevas : au-delà, on réduit
  // l'échelle plutôt que de produire une image vide.
  const scale = Math.min(2, 16000 / Math.max(layout.width, layout.height));
  const url = URL.createObjectURL(svgBlob);
  const img = new Image();
  img.onload = () => {
    const canvas = document.createElement("canvas");
    canvas.width = Math.round(layout.width * scale);
    canvas.height = Math.round(layout.height * scale);
    const ctx2d = canvas.getContext("2d");
    if (ctx2d) {
      ctx2d.scale(scale, scale);
      ctx2d.drawImage(img, 0, 0);
      canvas.toBlob((png) => { if (png) orgMetroDownload(png, "organigramme-metro.png"); }, "image/png");
    }
    URL.revokeObjectURL(url);
  };
  img.onerror = () => URL.revokeObjectURL(url);
  img.src = url;
}

// Cadrage (zoom + déplacement) : état { k, tx, ty } appliqué au groupe racine
// du SVG. Tant que personne n'a bougé le plan, il reste ajusté à la place
// disponible (redimensionnement du widget compris).
function useOrgMetroViewport(contentW, contentH) {
  const ref = useRef(null);
  const [size, setSize] = useState({ w: 0, h: 0 });
  const [view, setView] = useState({ k: 1, tx: 0, ty: 0 });
  const touchedRef = useRef(false);
  useLayoutEffect(() => {
    const measure = () => {
      const el = ref.current;
      if (!el) return;
      setSize((prev) => (prev.w === el.clientWidth && prev.h === el.clientHeight ? prev : { w: el.clientWidth, h: el.clientHeight }));
    };
    measure();
    if (typeof ResizeObserver === "undefined") return undefined;
    const ro = new ResizeObserver(measure);
    if (ref.current) ro.observe(ref.current);
    return () => ro.disconnect();
  }, []);
  const place = useCallback((k) => {
    const tx = (size.w - contentW * k) / 2;
    const fitsV = contentH * k <= size.h - ORGMETRO_FIT_MARGIN * 2;
    const ty = fitsV ? (size.h - contentH * k) / 2 : ORGMETRO_FIT_MARGIN;
    return { k, tx, ty };
  }, [size.w, size.h, contentW, contentH]);
  const fitZoom = useCallback(() => {
    if (!size.w || !size.h || !contentW || !contentH) return 1;
    return orgMetroClampZoom(Math.min(1, (size.w - ORGMETRO_FIT_MARGIN * 2) / contentW, (size.h - ORGMETRO_FIT_MARGIN * 2) / contentH));
  }, [size.w, size.h, contentW, contentH]);
  const openZoom = useCallback(() => Math.max(fitZoom(), Math.min(1, ORGMETRO_MIN_OPEN_ZOOM)), [fitZoom]);
  // Cadrage initial en useLayoutEffect (#330) : calculé et posé AVANT la
  // première peinture, dans le même passage synchrone que la mesure du
  // conteneur ci-dessus — sinon le plan s'affiche un instant non cadré
  // (échelle 1, coin haut-gauche) puis « saute » à sa position définitive,
  // ce qui se voit comme une animation de tracé au chargement.
  useLayoutEffect(() => {
    if (!touchedRef.current && size.w && size.h) setView(place(openZoom()));
  }, [size.w, size.h, contentW, contentH, place, openZoom]);
  // Ajuster : le plan entier, quitte à passer sous le zoom d'ouverture.
  const fit = () => { touchedRef.current = true; setView(place(fitZoom())); };
  const recenter = () => { touchedRef.current = true; setView((v) => place(v.k)); };
  // Cadrage par défaut, celui de l'ouverture du plan.
  const reset = () => { touchedRef.current = false; setView(place(openZoom())); };
  const zoomAt = (factor, px, py) => {
    touchedRef.current = true;
    setView((v) => {
      const k = orgMetroClampZoom(v.k * factor);
      const cx = px === undefined ? size.w / 2 : px;
      const cy = py === undefined ? size.h / 2 : py;
      return { k, tx: cx - (cx - v.tx) * (k / v.k), ty: cy - (cy - v.ty) * (k / v.k) };
    });
  };
  const setManual = (next) => { touchedRef.current = true; setView(next); };
  return { ref, size, view, fit, recenter, reset, zoomAt, setManual };
}

function OrgMetroChart({ teams, members, showUnassigned, rootLabel, onEditTeam, onEditMember, onFilterPerson, showTransverse, onToggleTransverse, leadInBadge, onToggleLeadInBadge, relations, order, offsets, onChangeOffsets, linkOffsets, onChangeLinkOffsets, onResetLayout, collapsed, onToggleCollapsed, horizontal, stacked, stackSplit, onChangeStackSplit, views, onSaveView, onLoadView, onDeleteView }) {
  const roots = useMemo(() => orgChartVisibleRoots(teams, members, showUnassigned), [teams, members, showUnassigned]);
  // Ordre des lignes choisi par glisser-déposer (widget.orgMetroOrder) : le
  // plan entier est recalculé, rien n'est déplacé « à la main ».
  // Répartition des équipes empilées (widget.orgMetroStackSplit) ; pendant
  // le glisser d'une ligne empilée, aperçu en direct de la nouvelle
  // répartition.
  const [drag, setDrag] = useState(null); // { kind: "team" | "link" | "split", key, dx, dy, k? }
  const splitKey = drag && drag.kind === "split" ? drag.key + ":" + drag.k : "";
  const shownSplit = useMemo(() => {
    const cur = stackSplit && typeof stackSplit === "object" ? stackSplit : {};
    return drag && drag.kind === "split" ? { ...cur, [drag.key.slice(5)]: drag.k } : cur;
  }, [stackSplit, splitKey]);
  const graph = useMemo(() => buildOrgMetroGraph(roots, teams, { rootLabel, order, collapsed, horizontal, stacked, stackSplit: shownSplit, leadInBadge }), [roots, teams, rootLabel, order, collapsed, horizontal, stacked, shownSplit, leadInBadge]);
  // Disposition par défaut, puis déplacements libres sur la grille
  // (widget.orgMetroOffsets) : ligne et sous-arborescence déplacées ensemble.
  // Pendant un déplacement, le plan est recalculé EN DIRECT avec le décalage
  // en cours (par pas de grille) : la ligne entière, ses raccords et les
  // liens suivent le pointeur.
  const base = useMemo(() => layoutOrgMetro(graph), [graph]);
  const addOffset = (map, key, dx, dy) => {
    const cur = normalizeOrgMetroOffsets(map);
    const prev = cur[key] || { dx: 0, dy: 0 };
    return normalizeOrgMetroOffsets({ ...cur, [key]: { dx: prev.dx + dx, dy: prev.dy + dy } });
  };
  // Déplacements enregistrés, sans chevauchement sur le plan courant.
  const settledOffsets = useMemo(() => orgMetroSettleOffsets(base, offsets), [base, offsets]);
  const shownOffsets = useMemo(() => (drag && drag.kind === "team" ? addOffset(settledOffsets, drag.key, drag.dx, drag.dy) : settledOffsets), [settledOffsets, drag]);
  // Lien : seul le segment attrapé bouge, perpendiculairement à lui-même.
  // Lien : le trait attrapé suit le pointeur en X et en Y (ses voisins
  // s'allongent) ; point de connexion : il glisse le long des bords.
  const linkEdit = (map, d) => (d.kind === "port" ? orgMetroSetLinkPort(map, d.key, d.end, d.pin) : orgMetroMoveLinkSeg(map, d.key, d.movable, d.seg, d.dx, d.dy));
  const shownLinkOffsets = useMemo(() => (drag && ((drag.kind === "link" && drag.seg != null) || (drag.kind === "port" && drag.pin)) ? linkEdit(linkOffsets, drag) : linkOffsets), [linkOffsets, drag]);
  const layout = useMemo(() => orgMetroApplyOffsets(base, shownOffsets), [base, shownOffsets]);
  // Lien principal transverse + liens transverses supplémentaires de chaque
  // équipe : tous en correspondances, recalculés sur la position courante des
  // lignes (ils suivent donc chaque déplacement).
  const links = useMemo(() => [
    ...transverseTeamLinks(teams),
    ...teamExtraLinks(teams),
    // Équipes rattachées à un utilisateur : lien hiérarchique depuis sa station.
    ...normalizeTeams(teams).filter((t) => t.parentMemberName && t.parentTeamId).map((t) => ({ fromId: t.id, person: t.parentMemberName, at: t.parentTeamId, type: "hierarchique" })),
  ], [teams]);
  const routes = useMemo(() => orgMetroTransverseRoutes(layout, links, shownLinkOffsets), [layout, links, shownLinkOffsets]);
  // Relations propres au widget (widget.orgChartRelations).
  const relationRoutes = useMemo(() => orgMetroRelationRoutes(layout, relations, shownLinkOffsets), [layout, relations, shownLinkOffsets]);
  const occurrences = useMemo(() => orgMetroOccurrences(layout), [layout]);
  // Objets Nexora désignés par une clé d'élément SVG : un clic ou Entrée
  // ouvre la fiche existante (TeamFormModal / TeamMemberFormModal).
  const itemsByKey = useMemo(() => {
    const m = new Map();
    layout.branches.forEach((b) => { if (b.team) m.set(b.key, { type: "team", team: b.team, branchKey: b.key }); });
    layout.stations.forEach((s) => m.set(s.key, { type: "person", member: s.member, name: s.name, stationKey: s.key }));
    return m;
  }, [layout]);

  const vp = useOrgMetroViewport(layout.width, layout.height);
  const svgRef = useRef(null);
  const [focus, setFocus] = useState(null);
  const [panning, setPanning] = useState(false);
  const pointersRef = useRef(new Map());
  const gestureRef = useRef(null);
  const draggedRef = useRef(false);
  const branchByKey = useMemo(() => new Map(layout.branches.map((b) => [b.key, b])), [layout]);
  // Ce que déplace un geste commencé sur un élément : une ligne ou une
  // station → sa ligne d'équipe entière (une branche de rattachés appartient
  // à la ligne d'où elle part) ; le grand titre → lui seul ; un lien → son
  // tracé.
  const dragTargetFromEvent = (e) => {
    const el = e.target && e.target.closest ? e.target.closest("[data-metro-drag]") : null;
    if (!el) return null;
    const v = el.getAttribute("data-metro-drag") || "";
    if (v.startsWith("link:")) return { kind: "link", key: v.slice(5) };
    if (v.startsWith("port:")) {
      const end = v.slice(5, v.indexOf(":", 5));
      const key = v.slice(v.indexOf(":", 5) + 1);
      const route = [...routes, ...relationRoutes].find((r) => r.key === key);
      const rect = route ? (end === "from" ? route.fromRect : route.toRect) : null;
      return rect && onChangeLinkOffsets ? { kind: "port", key, end, rect } : null;
    }
    if (v.startsWith("elbow:")) return branchByKey.has(v.slice(6)) ? { kind: "team", key: v } : null;
    if (v.startsWith("split:")) return onChangeStackSplit && branchByKey.has(v.slice(6)) ? { kind: "split", key: v.slice(6), layoutAtStart: layout } : null;
    // Nœud de bifurcation (ou sa barre) : il bouge avec les lignes qui en
    // partent — même mécanique de décalage que les lignes.
    if (v.startsWith("fork:")) return branchByKey.has(v.slice(5)) ? { kind: "team", key: v } : null;
    const b = branchByKey.get(v.slice(7));
    if (!b) return null;
    if (b.kind === "team" || b.kind === "hub") return { kind: "team", key: b.key };
    const teamKey = [...b.ancestors].reverse().find((k) => k.startsWith("team:"));
    return teamKey ? { kind: "team", key: teamKey } : null;
  };

  const related = useMemo(() => {
    if (!focus) return null;
    return orgMetroRelated(layout, focus.type === "team" ? { branchKey: focus.branchKey } : { name: focus.name });
  }, [focus, layout]);
  const dim = (branchKey, stationKey) => {
    if (!related) return false;
    if (stationKey && related.stationKeys.has(stationKey)) return false;
    return !related.branchKeys.has(branchKey);
  };
  const dimRoute = (r) => Boolean(related) && !(related.teamIds.has(r.fromId) || related.teamIds.has(r.toId));
  const relationTouches = (ref) => {
    const p = orgRelationRefParse(ref);
    if (!p) return false;
    if (p.type === "team") return related.teamIds.has(p.id);
    return (focus && focus.name === p.id) || layout.stations.some((st) => st.name === p.id && related.stationKeys.has(st.key));
  };
  const dimRelation = (r) => Boolean(related) && !(relationTouches(r.from) || relationTouches(r.to));
  const occurrenceLinks = useMemo(() => {
    if (!showTransverse || !focus || focus.type !== "person") return [];
    const list = occurrences.get(focus.name);
    if (!list) return [];
    return list.slice(1).map((s) => ({ key: "occ:" + s.key, d: orgMetroOccurrencePath(list[0], s) }));
  }, [focus, occurrences, showTransverse]);

  const itemFromEvent = (e) => {
    const el = e.target && e.target.closest ? e.target.closest("[data-metro-key]") : null;
    return el ? itemsByKey.get(el.getAttribute("data-metro-key")) || null : null;
  };
  const openItem = (item) => {
    if (!item) return;
    if (item.type === "team") { if (onEditTeam) onEditTeam(item.team); return; }
    if (!item.member) return; // responsable hors de l'annuaire : aucune fiche
    if (onEditMember) onEditMember(item.member);
    else if (onFilterPerson) onFilterPerson(item.name);
  };

  // Geste : un pointeur = déplacement du plan (au-delà d'un petit seuil, pour
  // qu'un simple clic reste un clic), deux pointeurs = pincer pour zoomer.
  const localPoint = (e) => {
    const rect = vp.ref.current.getBoundingClientRect();
    return { x: e.clientX - rect.left, y: e.clientY - rect.top };
  };
  const onPointerDown = (e) => {
    if (e.button !== undefined && e.button !== 0 && e.pointerType === "mouse") return;
    const p = localPoint(e);
    pointersRef.current.set(e.pointerId, p);
    if (pointersRef.current.size === 1) {
      draggedRef.current = false;
      // Sur une ligne, une station, un bandeau, le titre ou un lien, le même
      // geste déplace CET élément (et non le plan), par pas de grille.
      let target = onChangeOffsets ? dragTargetFromEvent(e) : null;
      if (target && target.kind === "link") {
        // Segment attrapé : le plus proche du pointeur, dans le repère du plan.
        const route = [...routes, ...relationRoutes].find((r) => r.key === target.key);
        const hit = route ? orgMetroNearestSegment(route.movable, (p.x - vp.view.tx) / vp.view.k, (p.y - vp.view.ty) / vp.view.k) : null;
        target = hit ? { ...target, seg: hit.seg, horizontal: hit.horizontal, movable: route.movable } : null;
      }
      gestureRef.current = { type: "pan", id: e.pointerId, sx: p.x, sy: p.y, view: vp.view, moved: false, target };
    } else if (pointersRef.current.size === 2) {
      const [a, b] = [...pointersRef.current.values()];
      draggedRef.current = true;
      try { e.currentTarget.setPointerCapture(e.pointerId); } catch (err) { /* pointeur déjà relâché */ }
      gestureRef.current = { type: "pinch", d0: Math.hypot(a.x - b.x, a.y - b.y) || 1, mid: { x: (a.x + b.x) / 2, y: (a.y + b.y) / 2 }, view: vp.view };
    }
  };
  const onPointerMove = (e) => {
    // Survol d'un lien (sans geste en cours) : curseur ↕ sur un segment
    // horizontal, ↔ sur un vertical — le sens dans lequel il se déplace.
    if (!gestureRef.current && e.target && e.target.closest) {
      const el = e.target.closest('[data-metro-drag^="link:"]');
      if (el) {
        const route = [...routes, ...relationRoutes].find((r) => r.key === el.getAttribute("data-metro-drag").slice(5));
        const lp = localPoint(e);
        const hit = route ? orgMetroNearestSegment(route.movable, (lp.x - vp.view.tx) / vp.view.k, (lp.y - vp.view.ty) / vp.view.k) : null;
        el.style.cursor = hit ? "move" : "";
      }
    }
    if (!pointersRef.current.has(e.pointerId)) return;
    const p = localPoint(e);
    pointersRef.current.set(e.pointerId, p);
    const g = gestureRef.current;
    if (!g) return;
    if (g.type === "pan" && g.id === e.pointerId) {
      const dx = p.x - g.sx, dy = p.y - g.sy;
      if (!g.moved && Math.hypot(dx, dy) > 4) {
        g.moved = true;
        draggedRef.current = true;
        if (!g.target) setPanning(true);
        setFocus(null);
        try { e.currentTarget.setPointerCapture(e.pointerId); } catch (err) { /* pointeur déjà relâché */ }
      }
      if (g.moved && g.target) {
        const next = { ...g.target, dx: orgMetroSnap(dx / g.view.k), dy: orgMetroSnap(dy / g.view.k) };
        if (next.kind === "split") next.k = orgMetroStackSplitAt(g.target.layoutAtStart, next.key, dy / g.view.k);
        if (next.kind === "port") next.pin = orgMetroPortAt(g.target.rect, (p.x - g.view.tx) / g.view.k, (p.y - g.view.ty) / g.view.k);
        const samePin = (a, b) => (!a && !b) || (a && b && a.side === b.side && a.t === b.t);
        setDrag((prev) => (prev && prev.key === next.key && prev.dx === next.dx && prev.dy === next.dy && prev.k === next.k && samePin(prev.pin, next.pin) ? prev : next));
      }
      else if (g.moved) vp.setManual({ k: g.view.k, tx: g.view.tx + dx, ty: g.view.ty + dy });
    } else if (g.type === "pinch" && pointersRef.current.size >= 2) {
      const [a, b] = [...pointersRef.current.values()];
      const d = Math.hypot(a.x - b.x, a.y - b.y) || 1;
      const k = orgMetroClampZoom(g.view.k * (d / g.d0));
      const mid = { x: (a.x + b.x) / 2, y: (a.y + b.y) / 2 };
      vp.setManual({
        k,
        tx: mid.x - (g.mid.x - g.view.tx) * (k / g.view.k),
        ty: mid.y - (g.mid.y - g.view.ty) * (k / g.view.k),
      });
    }
  };
  const onPointerEnd = (e) => {
    const g0 = gestureRef.current;
    if (g0 && g0.target && g0.moved && g0.id === e.pointerId && drag && e.type !== "pointercancel" && (drag.dx || drag.dy || drag.pin)) {
      if (drag.kind === "split") {
        onChangeStackSplit({ ...(stackSplit || {}), [drag.key.slice(5)]: drag.k });
      } else if (drag.kind === "team") {
        // Au lâcher : si un texte se superpose, la ligne glisse vers la case
        // libre la plus proche (orgMetroFreeOffsets).
        onChangeOffsets(orgMetroFreeOffsets(base, addOffset(settledOffsets, drag.key, drag.dx, drag.dy), drag.key));
      } else if (onChangeLinkOffsets) {
        if ((drag.kind === "link" && drag.seg != null) || (drag.kind === "port" && drag.pin)) onChangeLinkOffsets(linkEdit(linkOffsets, drag));
      }
    }
    if (g0 && g0.target) setDrag(null);
    pointersRef.current.delete(e.pointerId);
    if (pointersRef.current.size === 1) {
      // Fin d'un pincement : le doigt restant reprend le déplacement.
      const [[id, p]] = [...pointersRef.current.entries()];
      gestureRef.current = { type: "pan", id, sx: p.x, sy: p.y, view: vp.view, moved: true };
    } else if (pointersRef.current.size === 0) {
      gestureRef.current = null;
      setPanning(false);
    }
  };
  const onClickCapture = (e) => {
    if (draggedRef.current) { e.stopPropagation(); e.preventDefault(); draggedRef.current = false; }
  };
  // Zoom à la molette seulement avec Ctrl/⌘ (et le pincement du pavé
  // tactile, qui arrive sous cette forme) : la molette seule fait toujours
  // défiler le tableau de bord, comme partout ailleurs dans Nexora.
  useEffect(() => {
    const el = vp.ref.current;
    if (!el) return undefined;
    const onWheel = (e) => {
      if (!e.ctrlKey && !e.metaKey) return;
      e.preventDefault();
      const rect = el.getBoundingClientRect();
      vp.zoomAt(Math.exp(-e.deltaY * 0.0022), e.clientX - rect.left, e.clientY - rect.top);
    };
    el.addEventListener("wheel", onWheel, { passive: false });
    return () => el.removeEventListener("wheel", onWheel);
  });

  const onPointerOver = (e) => {
    if (e.pointerType && e.pointerType !== "mouse") return;
    if (gestureRef.current && gestureRef.current.moved) return;
    const item = itemFromEvent(e);
    const key = item ? item.branchKey || item.stationKey : null;
    setFocus((prev) => ((prev ? prev.branchKey || prev.stationKey : null) === key ? prev : item));
  };
  // Bandeau d'équipe : clic simple = replier / déplier la ligne (seul le
  // responsable reste) ; double-clic = fiche équipe, comme dans la vue
  // hiérarchique. Le clic simple attend un instant pour ne pas replier la
  // ligne quand c'est un double-clic qui arrive. Clavier : Entrée ouvre la
  // fiche, Espace replie / déplie.
  const clickTimerRef = useRef(null);
  useEffect(() => () => clearTimeout(clickTimerRef.current), []);
  const onSvgClick = (e) => {
    const item = itemFromEvent(e);
    if (!item) return;
    if (item.type === "team" && onToggleCollapsed) {
      clearTimeout(clickTimerRef.current);
      const key = item.branchKey;
      clickTimerRef.current = setTimeout(() => onToggleCollapsed(key), 240);
      return;
    }
    openItem(item);
  };
  const onSvgDoubleClick = (e) => {
    const item = itemFromEvent(e);
    if (!item || item.type !== "team") return;
    clearTimeout(clickTimerRef.current);
    openItem(item);
  };
  const onKeyDown = (e) => {
    if (e.key !== "Enter" && e.key !== " ") return;
    const item = itemFromEvent(e);
    if (!item) return;
    e.preventDefault();
    if (e.key === " " && item.type === "team" && onToggleCollapsed) onToggleCollapsed(item.branchKey);
    else openItem(item);
  };
  const stopToolbar = (e) => e.stopPropagation();
  const [viewsOpen, setViewsOpen] = useState(false);
  const [viewName, setViewName] = useState("");
  const { view } = vp;

  return (
    <div
      className={"lp-orgmetro" + (panning ? " is-panning" : "") + (drag ? " is-dragging" : "")}
      ref={vp.ref}
      onPointerDown={onPointerDown}
      onPointerMove={onPointerMove}
      onPointerUp={onPointerEnd}
      onPointerCancel={onPointerEnd}
      onClickCapture={onClickCapture}
    >
      <svg
        ref={svgRef}
        className={"lp-orgmetro-svg" + (related ? " is-focusing" : "")}
        role="img"
        aria-label={"Plan métro de l'organisation — " + layout.stations.length + " stations"}
        onClick={onSvgClick}
        onDoubleClick={onSvgDoubleClick}
        onKeyDown={onKeyDown}
        onPointerOver={onPointerOver}
        onPointerLeave={() => setFocus(null)}
      >
        <g data-metro-viewport="1" transform={`translate(${view.tx} ${view.ty}) scale(${view.k})`}>
          {drag && (
            <>
              <defs>
                <pattern id="lp-orgmetro-grid" width={ORGMETRO_GRID} height={ORGMETRO_GRID} patternUnits="userSpaceOnUse">
                  <circle className="lp-orgmetro-grid-dot" cx={0} cy={0} r={1.2} />
                </pattern>
              </defs>
              <rect className="lp-orgmetro-grid" x={-layout.width} y={-layout.height} width={layout.width * 3} height={layout.height * 3} fill="url(#lp-orgmetro-grid)" />
            </>
          )}
          <OrgMetroLines layout={layout} dim={dim} />
          {/* Correspondances masquables ; un parent secondaire (hiérarchique)
              reste toujours affiché, comme les autres lignes. */}
          <OrgMetroCorrespondences routes={showTransverse ? routes : routes.filter((r) => r.hierarchical)} relationRoutes={showTransverse ? relationRoutes : []} occurrenceLinks={occurrenceLinks} dimRoute={dimRoute} dimRelation={dimRelation} />
          <OrgMetroStations layout={layout} dim={dim} focusKey={focus && focus.stationKey} />
          <OrgMetroLabels layout={layout} dim={dim} drag={drag && drag.kind === "team" ? drag : null} />
          <OrgMetroPorts routes={showTransverse ? routes : routes.filter((r) => r.hierarchical)} relationRoutes={showTransverse ? relationRoutes : []} dimRoute={dimRoute} dimRelation={dimRelation} editable={Boolean(onChangeLinkOffsets)} />

        </g>
      </svg>
      <div className="lp-orgmetro-toolbar" onPointerDown={stopToolbar}>
        <button type="button" onClick={() => vp.zoomAt(1 / 1.25)} title="Zoom arrière" aria-label="Zoom arrière"><Minus size={14} /></button>
        <span className="lp-orgmetro-zoom" aria-live="polite">{Math.round(view.k * 100)} %</span>
        <button type="button" onClick={() => vp.zoomAt(1.25)} title="Zoom avant" aria-label="Zoom avant"><Plus size={14} /></button>
        <button type="button" onClick={vp.fit} title="Ajuster à l'écran" aria-label="Ajuster à l'écran"><Maximize2 size={13} /></button>
        <button
          type="button"
          onClick={() => {
            vp.reset();
            const custom = Object.keys(normalizeOrgMetroOrder(order)).length || Object.keys(normalizeOrgMetroOffsets(offsets)).length || Object.keys(normalizeOrgMetroLinkOffsets(linkOffsets)).length || (collapsed && collapsed.length) || (stackSplit && Object.values(stackSplit).some((n) => Number(n) > 0));
            if (onResetLayout && custom) onResetLayout();
          }}
          title="Recentrer — rétablit la disposition et le cadrage par défaut"
          aria-label="Recentrer et rétablir la disposition par défaut"
        ><Crosshair size={13} /></button>
        <span className="lp-orgmetro-toolbar-sep" aria-hidden="true" />
        <button
          type="button"
          className={showTransverse ? "active" : ""}
          aria-pressed={showTransverse}
          onClick={() => onToggleTransverse && onToggleTransverse(!showTransverse)}
          title={showTransverse ? "Masquer les correspondances et relations" : "Afficher les correspondances et relations"}
          aria-label="Correspondances transverses"
        ><Waypoints size={13} /></button>
        {onToggleLeadInBadge && (
          <button
            type="button"
            className={leadInBadge ? "active" : ""}
            aria-pressed={Boolean(leadInBadge)}
            onClick={() => onToggleLeadInBadge(!leadInBadge)}
            title={leadInBadge ? "Responsables en tête de ligne (station)" : "Responsables dans le bandeau de l'équipe"}
            aria-label="Responsables dans le bandeau"
          ><Star size={13} /></button>
        )}
        {onSaveView && (
          <button type="button" className={viewsOpen ? "active" : ""} aria-pressed={viewsOpen} aria-expanded={viewsOpen} onClick={() => setViewsOpen((v) => !v)} title="Vues enregistrées — sauvegarder / recharger une disposition" aria-label="Vues enregistrées"><Bookmark size={13} /><span>Vues</span></button>
        )}
        <button type="button" onClick={() => orgMetroExport(svgRef.current, layout, "svg")} title="Exporter en SVG" aria-label="Exporter en SVG"><Download size={13} /><span>SVG</span></button>
        <button type="button" onClick={() => orgMetroExport(svgRef.current, layout, "png")} title="Exporter en PNG" aria-label="Exporter en PNG"><Download size={13} /><span>PNG</span></button>
      </div>
      {viewsOpen && onSaveView && (
        <div className="lp-orgmetro-views" onPointerDown={stopToolbar} role="dialog" aria-label="Vues enregistrées">
          <form
            className="lp-orgmetro-views-form"
            onSubmit={(e) => { e.preventDefault(); if (viewName.trim()) { onSaveView(viewName); setViewName(""); } }}
          >
            <input type="text" value={viewName} maxLength={60} onChange={(e) => setViewName(e.target.value)} placeholder="Nom de la vue" aria-label="Nom de la vue à enregistrer" />
            <button type="submit" className="lp-btn lp-btn-primary" disabled={!viewName.trim()}><Save size={13} /> Enregistrer</button>
          </form>
          <p className="lp-orgmetro-views-hint">Une vue garde la disposition actuelle : déplacements, replis, dispositions verticale / horizontale, correspondances. Un nom déjà utilisé est remplacé.</p>
          {(views || []).length === 0 ? (
            <p className="lp-orgmetro-views-empty">Aucune vue enregistrée.</p>
          ) : (
            <ul className="lp-orgmetro-views-list">
              {views.map((v) => (
                <li key={v.id}>
                  <button type="button" className="lp-orgmetro-views-load" onClick={() => { onLoadView(v.id); setViewsOpen(false); }} title={"Recharger la vue « " + v.name + " »"}>
                    <span className="lp-orgmetro-views-name">{v.name}</span>
                    {v.savedAt && <span className="lp-orgmetro-views-date">{new Date(v.savedAt).toLocaleString("fr-FR", { dateStyle: "short", timeStyle: "short" })}</span>}
                  </button>
                  <button type="button" className="lp-icon-btn" onClick={() => onDeleteView(v.id)} title={"Supprimer la vue « " + v.name + " »"} aria-label={"Supprimer la vue " + v.name}><Trash2 size={13} /></button>
                </li>
              ))}
            </ul>
          )}
        </div>
      )}
      <div className="lp-orgmetro-legend" aria-hidden="true">
        <span><i className="lp-orgmetro-legend-lead" /><Star size={11} className="lp-orgmetro-legend-star" />Responsable</span>
        <span><i className="lp-orgmetro-legend-sub" />Lead / manager</span>
        <span><i className="lp-orgmetro-legend-member" />Membre</span>
        <span><i className="lp-orgmetro-legend-dup" />Rattachement</span>
        <span><i className="lp-orgmetro-legend-transverse" />Lien transverse</span>
        {routes.some((r) => r.hierarchical) && <span><i className="lp-orgmetro-legend-secondary" />Parent secondaire</span>}
        {relationRoutes.length > 0 && <span><i className="lp-orgmetro-legend-relation" />Relation</span>}
      </div>
    </div>
  );
}


function WidgetOrgChart({ widget, ctx, onFilterPerson, onOpenTeamsSettings, setTeams, setTeamMembers, setTeamFolders, setTasks, pushToast, onUpdateWidget }) {
  // Modale d'édition d'équipe au double-clic sur une carte (#231) — même
  // TeamFormModal que le crayon de Réglages > Équipe (TeamCatalogManager),
  // rien de dupliqué. null = fermée.
  const [editTeamId, setEditTeamId] = useState(null);
  const editTeam = editTeamId ? (ctx.teams || []).find((t) => t.id === editTeamId) : null;
  // Modale de réglages complets au double-clic sur un nom d'utilisateur
  // (#237) — même TeamMemberFormModal que Réglages > Utilisateurs, rien de
  // dupliqué. null = fermée.
  const [editMemberName, setEditMemberName] = useState(null);
  const editMember = editMemberName ? (ctx.teamMembers || []).find((m) => m.name === editMemberName) : null;
  // Équipes affichées (#209, retour de test) : widget.orgChartHiddenTeamIds
  // liste celles MASQUÉES — absent/vide = toutes affichées, comme avant ce
  // réglage. Une équipe masquée disparaît du catalogue vu par les deux modes
  // de rendu ; ses membres, s'ils n'appartiennent à aucune autre équipe
  // visible, rejoignent « Sans équipe » — même sort qu'une équipe supprimée
  // (voir TeamCatalogManager). normalizeTeams gère déjà une équipe dont le
  // parent a disparu (elle remonte au premier niveau), donc filtrer ici
  // suffit sans dupliquer cette logique.
  const hiddenTeamIds = widget?.orgChartHiddenTeamIds;
  // Filtre par dossier d'équipes (#215) : combiné à orgChartHiddenTeamIds
  // plutôt que substitué — une équipe reste masquable au cas par cas même
  // filtrée par dossier.
  const folderId = widget?.orgChartFolderId || "";
  const rawVisibleTeams = useMemo(() => {
    let list = ctx.teams || [];
    if (folderId) list = normalizeTeams(list).filter((t) => t.folderId === folderId);
    if (hiddenTeamIds && hiddenTeamIds.length) list = list.filter((t) => !hiddenTeamIds.includes(String(t?.id)));
    return list;
  }, [ctx.teams, hiddenTeamIds, folderId]);
  // Utilisateurs inactifs propres à CE widget (widget.orgChartInactiveMembers)
  // : grisés, à leur place.
  const inactiveKeys = widget?.orgChartInactiveMembers;
  const members = useMemo(() => orgChartMembersWithInactive(ctx.teamMembers || [], inactiveKeys), [ctx.teamMembers, inactiveKeys]);

  // Réglage « Afficher les ressources sans équipe » (retour de test) : true
  // par défaut — widgets déjà en place, sans ce champ, gardent leur affichage
  // actuel.
  const showUnassigned = widget?.orgChartShowUnassigned !== false;

  // Correspondances transverses de la vue Métro : affichées par défaut.
  const [showTransverse, setShowTransverse] = useState(widget?.orgMetroShowTransverse !== false);
  useEffect(() => { setShowTransverse(widget?.orgMetroShowTransverse !== false); }, [widget?.orgMetroShowTransverse]);
  const toggleTransverse = (next) => {
    setShowTransverse(next);
    if (onUpdateWidget) onUpdateWidget({ orgMetroShowTransverse: next });
  };
  // Variante « responsable dans le bandeau » (bouton ★) : désactivée par
  // défaut.
  const [leadInBadge, setLeadInBadge] = useState(widget?.orgMetroLeadInBadge === true);
  useEffect(() => { setLeadInBadge(widget?.orgMetroLeadInBadge === true); }, [widget?.orgMetroLeadInBadge]);
  const toggleLeadInBadge = (next) => {
    setLeadInBadge(next);
    if (onUpdateWidget) onUpdateWidget({ orgMetroLeadInBadge: next });
  };
  // Disposition des lignes du Métro choisie par glisser-déposer
  // (widget.orgMetroOrder) ; « Recentrer » la remet à zéro (null).
  const [metroOrder, setMetroOrder] = useState(widget?.orgMetroOrder || null);
  useEffect(() => { setMetroOrder(widget?.orgMetroOrder || null); }, [widget?.orgMetroOrder]);
  // Déplacements libres des lignes sur la grille (widget.orgMetroOffsets).
  const [metroOffsets, setMetroOffsets] = useState(widget?.orgMetroOffsets || null);
  useEffect(() => { setMetroOffsets(widget?.orgMetroOffsets || null); }, [widget?.orgMetroOffsets]);
  const changeMetroOffsets = (next) => {
    setMetroOffsets(next);
    if (onUpdateWidget) onUpdateWidget({ orgMetroOffsets: next });
  };
  // Déplacements des liens (relations, correspondances transverses).
  const [metroLinkOffsets, setMetroLinkOffsets] = useState(widget?.orgMetroLinkOffsets || null);
  useEffect(() => { setMetroLinkOffsets(widget?.orgMetroLinkOffsets || null); }, [widget?.orgMetroLinkOffsets]);
  const changeMetroLinkOffsets = (next) => {
    setMetroLinkOffsets(next);
    if (onUpdateWidget) onUpdateWidget({ orgMetroLinkOffsets: next });
  };
  // Lignes repliées (clic simple sur un bandeau) : widget.orgMetroCollapsed.
  const [metroCollapsed, setMetroCollapsed] = useState(Array.isArray(widget?.orgMetroCollapsed) ? widget.orgMetroCollapsed : []);
  useEffect(() => { setMetroCollapsed(Array.isArray(widget?.orgMetroCollapsed) ? widget.orgMetroCollapsed : []); }, [widget?.orgMetroCollapsed]);
  const toggleMetroCollapsed = (key) => {
    const next = metroCollapsed.includes(key) ? metroCollapsed.filter((k) => k !== key) : [...metroCollapsed, key];
    setMetroCollapsed(next);
    if (onUpdateWidget) onUpdateWidget({ orgMetroCollapsed: next });
  };
  // Équipes en disposition horizontale (paramètres du widget).
  const metroHorizontal = useMemo(() => (Array.isArray(widget?.orgMetroHorizontalTeams) ? widget.orgMetroHorizontalTeams : []), [widget?.orgMetroHorizontalTeams]);
  // Équipes dont les sous-équipes s'empilent à la verticale.
  const metroStacked = useMemo(() => (Array.isArray(widget?.orgMetroStackedTeams) ? widget.orgMetroStackedTeams : []), [widget?.orgMetroStackedTeams]);
  // Sous-équipes placées au-dessus du bandeau d'une équipe empilée
  // (widget.orgMetroStackSplit, { idÉquipe: nombre }) : réglé en glissant sa
  // ligne ; « Recentrer » le remet à zéro.
  const [metroStackSplit, setMetroStackSplit] = useState(widget?.orgMetroStackSplit || null);
  useEffect(() => { setMetroStackSplit(widget?.orgMetroStackSplit || null); }, [widget?.orgMetroStackSplit]);
  const changeMetroStackSplit = (next) => {
    setMetroStackSplit(next);
    if (onUpdateWidget) onUpdateWidget({ orgMetroStackSplit: next });
  };
  // Vues enregistrées (widget.orgMetroViews) : enregistrer la disposition
  // courante sous un nom, la recharger, la supprimer.
  const metroViews = useMemo(() => normalizeOrgMetroViews(widget?.orgMetroViews), [widget?.orgMetroViews]);
  const saveMetroView = onUpdateWidget ? (name) => {
    const state = {
      orgMetroOrder: metroOrder, orgMetroOffsets: metroOffsets, orgMetroLinkOffsets: metroLinkOffsets,
      orgMetroCollapsed: metroCollapsed, orgMetroStackSplit: metroStackSplit,
      orgMetroHorizontalTeams: metroHorizontal, orgMetroStackedTeams: metroStacked, orgMetroShowTransverse: showTransverse,
      orgMetroLeadInBadge: leadInBadge,
    };
    onUpdateWidget({ orgMetroViews: orgMetroSaveView(metroViews, name, state, new Date().toISOString(), "view-" + Date.now().toString(36)) });
  } : undefined;
  const loadMetroView = onUpdateWidget ? (id) => {
    const view = metroViews.find((v) => v.id === id);
    if (!view) return;
    const patch = orgMetroViewPatch(view.state);
    setMetroOrder(patch.orgMetroOrder);
    setMetroOffsets(patch.orgMetroOffsets);
    setMetroLinkOffsets(patch.orgMetroLinkOffsets);
    setMetroCollapsed(patch.orgMetroCollapsed);
    setMetroStackSplit(patch.orgMetroStackSplit);
    setShowTransverse(patch.orgMetroShowTransverse);
    setLeadInBadge(patch.orgMetroLeadInBadge === true);
    onUpdateWidget(patch);
  } : undefined;
  const deleteMetroView = onUpdateWidget ? (id) => onUpdateWidget({ orgMetroViews: metroViews.filter((v) => v.id !== id) }) : undefined;
  // « Recentrer » : disposition par défaut (ordre, déplacements et replis
  // effacés).
  const resetMetroLayout = () => {
    setMetroOrder(null);
    setMetroOffsets(null);
    setMetroLinkOffsets(null);
    setMetroCollapsed([]);
    setMetroStackSplit(null);
    if (onUpdateWidget) onUpdateWidget({ orgMetroOrder: null, orgMetroOffsets: null, orgMetroLinkOffsets: null, orgMetroCollapsed: [], orgMetroStackSplit: null });
  };
  const rootLabel = widget?.orgChartRootLabel && String(widget.orgChartRootLabel).trim() ? String(widget.orgChartRootLabel).trim() : "Organisation";
  const onEditTeam = setTeams && setTeamMembers && setTeamFolders ? (team) => setEditTeamId(team.id) : undefined;
  const onEditMember = setTeamMembers ? (member) => setEditMemberName(member.name) : undefined;

  // Rendu : le plan Métro (#295), seule vue de l'Organigramme depuis le
  // retrait de la vue hiérarchique.
  const content = !members.length
    ? <div className="lp-empty">Aucun utilisateur : ajoute des personnes dans Réglages › Utilisateurs.</div>
    : (
      <OrgMetroChart
        teams={rawVisibleTeams}
        members={members}
        showUnassigned={showUnassigned}
        rootLabel={rootLabel}
        onEditTeam={onEditTeam}
        onEditMember={onEditMember}
        onFilterPerson={onFilterPerson}
        showTransverse={showTransverse}
        onToggleTransverse={toggleTransverse}
        leadInBadge={leadInBadge}
        onToggleLeadInBadge={toggleLeadInBadge}
        relations={widget?.orgChartRelations}
        order={metroOrder}
        offsets={metroOffsets}
        onChangeOffsets={changeMetroOffsets}
        linkOffsets={metroLinkOffsets}
        onChangeLinkOffsets={changeMetroLinkOffsets}
        collapsed={metroCollapsed}
        onToggleCollapsed={toggleMetroCollapsed}
        horizontal={metroHorizontal}
        stacked={metroStacked}
        stackSplit={metroStackSplit}
        onChangeStackSplit={changeMetroStackSplit}
        views={metroViews}
        onSaveView={saveMetroView}
        onLoadView={loadMetroView}
        onDeleteView={deleteMetroView}
        onResetLayout={resetMetroLayout}
      />
    );

  return (
    <div className="lp-widget-orgchart">
      <div className="lp-widget-orgchart-head">
        {onOpenTeamsSettings && (
          <button type="button" className="lp-icon-btn" onClick={onOpenTeamsSettings} title="Réglages → Utilisateurs & Équipes" aria-label="Réglages des utilisateurs et équipes">
            <Settings size={13} />
          </button>
        )}
      </div>
      <div className="lp-widget-orgchart-body">{content}</div>
      {editTeam && (
        <TeamFormModal
          team={editTeam}
          teams={ctx.teams}
          teamMembers={ctx.teamMembers}
          setTeamMembers={setTeamMembers}
          teamFolders={ctx.teamFolders}
          setTeamFolders={setTeamFolders}
          pushToast={pushToast}
          onSave={(data) => { setTeams((ctx.teams || []).map((t) => (t.id === editTeamId ? { ...t, ...data } : t))); setEditTeamId(null); }}
          onClose={() => setEditTeamId(null)}
        />
      )}
      {editMember && (
        <TeamMemberFormModal
          member={editMember}
          teams={ctx.teams}
          teamMembers={ctx.teamMembers}
          onSave={(data) => {
            saveTeamMemberEdit({ target: editMember, data, setTeamMembers, tasks: ctx.tasks, setTasks, pushToast });
            setEditMemberName(null);
          }}
          onClose={() => setEditMemberName(null)}
        />
      )}
    </div>
  );
}

/* Widget « Utilisateur » (#173). Une fiche par personne, choisie dans les
   réglages du widget : ses paramètres (modifiables sans repasser par
   Réglages › Utilisateurs), son plan de charge des 30 prochains jours (même
   lecture que la couche « Tâches » de la Charge personnel, #152), la
   répartition de ses tâches actives par projet et la liste de celles sur
   lesquelles elle travaille — réutilisant WidgetChart et WidgetList tels
   quels plutôt que de redessiner un graphe et une liste. Lecture des tâches
   et des affectations, écriture uniquement sur la fiche de la personne. */
function WidgetUserProfile({ widget, ctx, staffing, onOpen, setTasks, pushToast, onUpdateTeamMembers }) {
  const member = (ctx.teamMembers || []).find((m) => m.name === widget.userProfileMember) || null;
  const [editing, setEditing] = useState(false);
  const today = useMemo(() => iso(new Date()), []);
  const tasksIndex = useMemo(() => staffingActiveTasksIndex(ctx.tasks, ctx), [ctx.tasks, ctx.statuses]);

  if (!widget.userProfileMember) {
    return <div className="lp-empty">Choisis une personne dans la fiche du widget.</div>;
  }
  if (!member) {
    return <div className="lp-empty">« {widget.userProfileMember} » ne fait plus partie de l'annuaire — choisis une autre personne dans la fiche du widget.</div>;
  }

  const name = member.name;
  const activeTasks = useMemo(
    () => (ctx.tasks || []).filter((t) => t.assignee === name && !t.milestone && !isTaskDoneGlobal(t, ctx)),
    [ctx.tasks, ctx, name]
  );
  const loadDays = useMemo(() => {
    const out = [];
    for (let i = 0; i < 30; i += 1) {
      const dayIso = addDays(today, i);
      out.push({ iso: dayIso, count: staffingActiveTasksForCell(tasksIndex, name, dayIso).length });
    }
    return out;
  }, [tasksIndex, name, today]);
  const capacity = normalizeMemberCapacity(member.capacityPerDay);
  const teamNames = memberTeamIds(member).map((id) => teamFor(ctx.teams, id)?.name).filter(Boolean);

  return (
    <div className="lp-userprofile">
      <div className="lp-userprofile-head">
        <span className="lp-userprofile-avatar" style={{ background: member.color || staffingMemberColor(name) }}>
          {member.avatarDataUrl ? <IconGlyph icon={member.avatarDataUrl} size={22} /> : name.split(/\s+/).map((p) => p.charAt(0)).join("").slice(0, 2).toUpperCase()}
        </span>
        <div className="lp-userprofile-id">
          <span
            className="lp-userprofile-name"
            onDoubleClick={onUpdateTeamMembers ? () => setEditing(true) : undefined}
            title={onUpdateTeamMembers ? "Double-clic pour modifier l'utilisateur" : undefined}
            style={onUpdateTeamMembers ? { cursor: "pointer" } : undefined}
          >{name}</span>
          <span className="lp-userprofile-meta">
            {member.email || "Sans email"} · Capacité {capacity}/j{teamNames.length > 0 ? " · " + teamNames.join(", ") : ""}
          </span>
        </div>
        {onUpdateTeamMembers && (
          <button type="button" className="lp-btn lp-btn-mini" onClick={() => setEditing(true)}>Modifier</button>
        )}
      </div>

      <div className="lp-userprofile-section">
        <div className="lp-userprofile-section-title">Plan de charge — 30 prochains jours</div>
        <div className="lp-userprofile-load">
          {loadDays.map((d) => (
            <span
              key={d.iso}
              className={"lp-userprofile-load-cell" + (d.count === 0 ? " is-empty" : d.count >= 3 ? " is-high" : " is-filled")}
              title={fmtShort(d.iso) + " — " + d.count + " tâche" + (d.count > 1 ? "s" : "") + " active" + (d.count > 1 ? "s" : "")}
            />
          ))}
        </div>
      </div>

      <div className="lp-userprofile-row">
        <div className="lp-userprofile-section lp-userprofile-half">
          <div className="lp-userprofile-section-title">Répartition par projet</div>
          <WidgetChart tasks={activeTasks} groupBy="project" chartStyle="pie" ctx={ctx} />
        </div>
        <div className="lp-userprofile-section lp-userprofile-half">
          <div className="lp-userprofile-section-title">{activeTasks.length} tâche{activeTasks.length > 1 ? "s" : ""} en cours</div>
          <WidgetList tasks={activeTasks} sortBy="end" limit={30} ctx={ctx} onOpen={onOpen} />
        </div>
      </div>

      {editing && onUpdateTeamMembers && (
        <TeamMemberFormModal
          member={member}
          teams={ctx.teams}
          teamMembers={ctx.teamMembers}
          onSave={(data) => {
            saveTeamMemberEdit({ target: member, data, setTeamMembers: onUpdateTeamMembers, tasks: ctx.tasks, setTasks, pushToast });
            setEditing(false);
          }}
          onClose={() => setEditing(false)}
        />
      )}
    </div>
  );
}

/* Widget « Utilisateurs & Équipes » (#228) : reprend TeamAndUserManagerPanel
   (Réglages > Équipe — Utilisateurs, Équipes, dossiers d'équipes, ajout
   rapide de membre) directement dans un tableau de bord, sans dupliquer la
   logique. Seul le conteneur change : défilement interne, hauteur calée sur
   la carte du widget (comme les autres widgets "complet", ex. WidgetEmbedMetro),
   puisque la taille du widget est contrainte/redimensionnable. */
function WidgetTeamCatalog({ ctx, setTeams, setTeamMembers, setTeamFolders, setTasks, pushToast }) {
  if (!setTeams || !setTeamFolders || !setTeamMembers) {
    return <div className="lp-empty">Gestion des utilisateurs et équipes indisponible ici.</div>;
  }
  // Pas de conteneur spécifique : .lp-widget-body (WidgetFrame) fournit déjà
  // le défilement interne et le padding communs à tous les widgets.
  return (
    <TeamAndUserManagerPanel
      teamMembers={ctx.teamMembers}
      setTeamMembers={setTeamMembers}
      tasks={ctx.tasks}
      setTasks={setTasks}
      teams={ctx.teams}
      setTeams={setTeams}
      teamFolders={ctx.teamFolders}
      setTeamFolders={setTeamFolders}
      pushToast={pushToast}
      defaultOpen
    />
  );
}

/* Widget « Charge personnel » (#124). Les personnes en lignes, les jours en
   colonnes, et dans chaque case les ateliers du jour — plusieurs par jour si
   besoin.

   Le graphisme est celui de la heat map, délibérément : cases arrondies posées
   sur une trame régulière, liseré d'accent sur aujourd'hui, week-end atténué,
   légende en pied. Ce n'est pas une coquetterie — c'est la même lecture « une
   case = une journée » que Nexora propose déjà ailleurs, et l'apprendre deux
   fois n'apporterait rien.

   Toute la logique sans rendu vit dans le bloc NEXORA:STAFFING : ce composant
   ne fait que mesurer, placer et écouter. */
/* Trois longueurs pour le même jour, choisies sur la largeur MESURÉE d'une
   case : « lun » quand il y a la place, « lu » en vue mois — où « M » seul ne
   distinguerait pas mardi de mercredi — et l'initiale en dernier recours. */
const STAFFING_DOW_LABELS = ["lun", "mar", "mer", "jeu", "ven", "sam", "dim"];
const STAFFING_DOW_SHORT = ["lu", "ma", "me", "je", "ve", "sa", "di"];
const STAFFING_GRID_GAP = 3;

function WidgetStaffing({ widget, ctx, staffing, onUpdateStaffing, onUpdateWidget, onUpdateWorkshops }) {
  const cfg = normalizeStaffingWidget(widget);
  const catalogue = useMemo(() => normalizeWorkshops(ctx.workshops), [ctx.workshops]);
  const knownIds = useMemo(() => catalogue.map((w) => w.id), [catalogue]);
  const todayIso = useMemo(() => iso(new Date()), []);
  const frame = useMemo(
    () => staffingWindow(cfg.staffingRange, cfg.staffingOffset, todayIso, { start: cfg.staffingStart, end: cfg.staffingEnd }),
    [cfg.staffingRange, cfg.staffingOffset, todayIso, cfg.staffingStart, cfg.staffingEnd]
  );
  const days = useMemo(
    () => staffingDays(frame, todayIso, { showWeekends: cfg.staffingShowWeekends }),
    [frame, todayIso, cfg.staffingShowWeekends]
  );
  const members = useMemo(
    () => staffingVisibleMembers(ctx.teamMembers, cfg.staffingMembers, cfg.staffingExtraMembers),
    [ctx.teamMembers, cfg.staffingMembers, cfg.staffingExtraMembers]
  );
  const cells = useMemo(() => staffingByCell(staffing), [staffing]);
  // Couche « Tâches » (#152) : lecture seule, jamais d'écriture croisée avec les
  // affectations (#124 l'exclut). Un seul index par rendu, servi aux cases et à
  // l'infobulle.
  const tasksIndex = useMemo(() => staffingActiveTasksIndex(ctx.tasks, ctx), [ctx.tasks, ctx.statuses]);
  // Capacité par personne (#163) : le repli à 1 poste couvre l'annuaire d'avant
  // ce réglage comme les personnes ajoutées à la main, qui n'en ont pas.
  const capacityByName = useMemo(() => {
    const map = new Map();
    (ctx.teamMembers || []).forEach((m) => {
      if (m && String(m.name || "").trim()) map.set(String(m.name).trim(), normalizeMemberCapacity(m.capacityPerDay));
    });
    return map;
  }, [ctx.teamMembers]);
  // Totaux par atelier sur la fenêtre affichée (#164).
  const workshopTotals = useMemo(() => staffingWorkshopTotalsInWindow(staffing, members, days), [staffing, members, days]);

  /* La largeur d'une case est MESURÉE, pas supposée : c'est elle qui décide si
     une bande peut porter le nom de son atelier, son code, ou rien du tout. En
     vue mois, trente et une colonnes laissent une quinzaine de pixels chacune —
     y écrire quoi que ce soit donnerait une bouillie de lettres coupées. */
  const gridRef = useRef(null);
  const [gridPx, setGridPx] = useState(0);
  useEffect(() => {
    const el = gridRef.current;
    if (!el || typeof ResizeObserver === "undefined") return undefined;
    const observer = new ResizeObserver(() => {
      const width = Math.round(el.getBoundingClientRect().width);
      setGridPx((prev) => (prev === width ? prev : width));
    });
    observer.observe(el);
    return () => observer.disconnect();
  }, []);

  const nameW = days.length > 16 ? 146 : 188;
  const loadW = cfg.staffingShowLoad ? 64 : 0;
  const colCount = Math.max(1, days.length);
  /* Mode « pixel-art » (#124) : au-delà d'un certain nombre de colonnes, l'écart
     entre cases devient un quadrillage plus voyant que les couleurs elles-mêmes.
     Estimé avec l'écart normal — l'écart réel en dépend, mais l'écart pèse trop
     peu sur la largeur totale pour faire osciller la décision. Les cases se
     touchent alors, sans coin arrondi ; chacune reste sa propre case cliquable,
     seul le survol distingue le bon jour. */
  const estGutters = STAFFING_GRID_GAP * (colCount + (loadW ? 1 : 0));
  const estCellPx = gridPx > 0 ? Math.max(0, (gridPx - nameW - loadW - estGutters) / colCount) : 0;
  const pixelArt = estCellPx > 0 && estCellPx < 14;
  const gridGap = pixelArt ? 0 : STAFFING_GRID_GAP;
  const gutters = gridGap * (colCount + (loadW ? 1 : 0));
  const cellPx = gridPx > 0 ? Math.max(0, (gridPx - nameW - loadW - gutters) / colCount) : 0;
  const gridTemplate = nameW + "px repeat(" + colCount + ", minmax(0, 1fr))" + (loadW ? " " + loadW + "px" : "");

  const [picker, setPicker] = useState(null); // { member, date, rect }
  const [query, setQuery] = useState("");
  const [hover, setHover] = useState(null);   // { x, y, member, day }

  // Le panneau se ferme au clic dehors et à Échap, comme tous les menus de
  // Nexora. Il vit en portail : le widget coupe à son bord, et un panneau
  // rendu dedans serait tranché dès la dernière ligne.
  useEffect(() => {
    if (!picker) return undefined;
    const onKey = (e) => { if (e.key === "Escape") setPicker(null); };
    const onDown = (e) => { if (!e.target.closest || !e.target.closest(".lp-cp-picker")) setPicker(null); };
    document.addEventListener("keydown", onKey);
    document.addEventListener("mousedown", onDown);
    return () => { document.removeEventListener("keydown", onKey); document.removeEventListener("mousedown", onDown); };
  }, [picker]);

  /* Glisser-peindre (#154) : la case où le clic démarre donne sa sélection,
     balayée sur les cases suivantes SANS écrire — seul un aperçu local
     (`paintPreview`) change à chaque case survolée. Le magasin n'est écrit
     qu'UNE fois, au relâchement, et seulement si au moins une deuxième case a
     été touchée : un simple clic reste un simple clic, il ouvre le panneau. */
  const paintRef = useRef(null); // { member, ids, dates: Set }
  const justPaintedRef = useRef(false);
  const [paintPreview, setPaintPreview] = useState(null); // { member, dates: Set }
  const beginPaint = (member, date, e) => {
    if (e.button !== 0 || !onUpdateStaffing) return;
    const ids = cells.get(staffingCellId(member, date)) || [];
    paintRef.current = { member, ids, dates: new Set([date]) };
    setPaintPreview({ member, dates: new Set([date]) });
  };
  const paintOver = (member, date) => {
    const p = paintRef.current;
    if (!p || p.member !== member || p.dates.has(date)) return;
    p.dates.add(date);
    setPaintPreview({ member, dates: new Set(p.dates) });
  };
  useEffect(() => {
    if (!paintPreview) return undefined;
    const onUp = () => {
      const p = paintRef.current;
      paintRef.current = null;
      setPaintPreview(null);
      if (!p || p.dates.size < 2 || !onUpdateStaffing) return;
      justPaintedRef.current = true;
      onUpdateStaffing((prev) => {
        let next = prev;
        p.dates.forEach((date) => { next = staffingSetCell(next, p.member, date, p.ids, knownIds); });
        return next;
      });
    };
    document.addEventListener("mouseup", onUp);
    return () => document.removeEventListener("mouseup", onUp);
  }, [paintPreview, knownIds, onUpdateStaffing]);

  const periodLabel = cfg.staffingRange === "month"
    ? monthLabel(frame.start)
    : fmtShort(frame.start) + " – " + fmtShort(frame.end);

  const shiftPeriod = (dir) => {
    if (!onUpdateWidget) return;
    onUpdateWidget({ staffingOffset: normalizeStaffingOffset(cfg.staffingOffset + dir) });
  };
  const setRange = (range) => {
    if (!onUpdateWidget) return;
    onUpdateWidget({ staffingRange: range, staffingOffset: 0 });
  };

  const openPicker = (member, date, e) => {
    if (justPaintedRef.current) { justPaintedRef.current = false; return; }
    if (!onUpdateStaffing) return;
    setHover(null);
    setQuery("");
    setPicker({ member, date, rect: e.currentTarget.getBoundingClientRect() });
  };

  const currentIds = picker ? (cells.get(staffingCellId(picker.member, picker.date)) || []) : [];
  const toggleWorkshop = (id) => {
    if (!picker || !onUpdateStaffing) return;
    const next = currentIds.includes(id) ? currentIds.filter((x) => x !== id) : [...currentIds, id];
    onUpdateStaffing((prev) => staffingSetCell(prev, picker.member, picker.date, next, knownIds));
  };
  const clearCell = () => {
    if (!picker || !onUpdateStaffing) return;
    onUpdateStaffing((prev) => staffingSetCell(prev, picker.member, picker.date, [], knownIds));
  };

  /* Créer un atelier SANS quitter la case (#124) : le besoin se découvre en
     affectant — « tiens, il manque Grue » —, et renvoyer dans les Réglages
     pour revenir ensuite ferait perdre la case qu'on était en train de
     remplir. L'atelier créé est aussitôt posé sur elle : c'est pour elle qu'on
     l'a créé.

     Il entre dans le MÊME catalogue que les autres, marqué `custom` : un second
     magasin aurait donné deux endroits où chercher « Grue », et deux règles de
     suppression. */
  const [draft, setDraft] = useState(null); // { name, color }
  const openDraft = () => setDraft({ name: query.trim(), color: STAFFING_COLOR_CHOICES[0] });
  const createWorkshop = () => {
    if (!draft || !picker || !onUpdateWorkshops || !onUpdateStaffing) return;
    const name = String(draft.name || "").trim();
    if (!name) return;
    const made = staffingAddCustomWorkshop(catalogue, name, draft.color);
    if (!made.workshop) return;
    if (made.created) onUpdateWorkshops(made.catalogue);
    const nextIds = currentIds.includes(made.workshop.id) ? currentIds : [...currentIds, made.workshop.id];
    onUpdateStaffing((prev) => staffingSetCell(prev, picker.member, picker.date, nextIds, made.catalogue.map((w) => w.id)));
    setDraft(null);
    setQuery("");
  };

  const dayTitle = (dayIso) => {
    const d = new Date(dayIso + "T00:00:00");
    return d.toLocaleDateString("fr-FR", { weekday: "long", day: "numeric", month: "long" });
  };

  if (!members.length) {
    return (
      <div className="lp-empty">
        {(ctx.teamMembers || []).length === 0
          ? "Aucun utilisateur : ajoute des personnes dans Réglages › Utilisateurs, ou directement dans les réglages de ce widget."
          : "Personne n'est encore affiché : ouvre les réglages du widget pour cocher les personnes à suivre — « Tout cocher » les prend toutes — ou pour en ajouter à la main."}
      </div>
    );
  }

  const tooltip = !hover ? null : createPortal(
    <div
      className="lp-pie-tooltip lp-widget-metro-tooltip"
      style={{ position: "fixed", left: hover.x, top: hover.y, zIndex: 100000, maxWidth: 240, pointerEvents: "none" }}
    >
      <div className="lp-widget-metro-tooltip-head">
        <span className="lp-widget-metro-tooltip-dot" style={{ background: hover.color || "var(--text-muted)" }} />
        <span className="lp-widget-metro-tooltip-title">{hover.member}</span>
      </div>
      <div className="lp-widget-metro-tooltip-meta">{dayTitle(hover.date)}</div>
      {hover.ids.length === 0 ? (
        <div className="lp-cp-tip-empty">Aucun atelier — cliquer pour en poser</div>
      ) : (
        <>
          {hover.ids.map((id) => {
            const shop = workshopFor(catalogue, id);
            if (!shop) return null;
            return (
              <div className="lp-cp-tip-line" key={id}>
                <span className="lp-cp-dot" style={{ background: shop.color }} />
                <span>{shop.name}</span>
              </div>
            );
          })}
          <div className="lp-cp-tip-foot">
            {hover.ids.length > 1 ? hover.ids.length + " postes ce jour-là" : "1 poste ce jour-là"}
          </div>
        </>
      )}
      {hover.tasks && hover.tasks.length > 0 && (
        <div className="lp-cp-tip-tasks">
          <div className="lp-cp-tip-tasks-title">{hover.tasks.length} tâche{hover.tasks.length > 1 ? "s" : ""} active{hover.tasks.length > 1 ? "s" : ""}</div>
          {hover.tasks.slice(0, 6).map((t) => <div className="lp-cp-tip-line" key={t.id}>{t.title}</div>)}
          {hover.tasks.length > 6 && <div className="lp-cp-tip-line">… et {hover.tasks.length - 6} de plus</div>}
        </div>
      )}
      {hover.overCapacity && (
        <div className="lp-cp-tip-capacity"><AlertTriangle size={11} /> Capacité dépassée ce jour-là</div>
      )}
    </div>,
    document.body
  );

  /* Le panneau de sélection. Ancré sous la case, ramené dans la fenêtre quand
     il en sortirait — une case de fin de mois ouvrait sinon son panneau hors
     de l'écran. */
  const pickerNode = !picker ? null : (() => {
    const W = 264;
    const H = 330;
    const left = Math.max(8, Math.min(picker.rect.left, (typeof window !== "undefined" ? window.innerWidth : 1200) - W - 8));
    const below = picker.rect.bottom + 6;
    const fitsBelow = below + H < (typeof window !== "undefined" ? window.innerHeight : 900);
    const top = fitsBelow ? below : Math.max(8, picker.rect.top - H - 6);
    const picked = staffingPickerGroups(catalogue, currentIds, query);
    return createPortal(
      <div className="lp-cp-picker" style={{ position: "fixed", left, top, width: W, zIndex: 100001 }}>
        <div className="lp-cp-picker-head">
          <div className="lp-cp-picker-head-text">
            <span className="lp-cp-picker-who">{picker.member}</span>
            <span className="lp-cp-picker-when">{dayTitle(picker.date)}</span>
          </div>
          <button type="button" className="lp-icon-btn" aria-label="Fermer" onClick={() => setPicker(null)}>
            <X size={14} />
          </button>
        </div>
        <div className="lp-cp-picker-search">
          <Search size={13} />
          <input
            type="text"
            autoFocus
            value={query}
            onChange={(e) => setQuery(e.target.value)}
            placeholder="Rechercher un atelier…"
            aria-label="Rechercher un atelier"
          />
        </div>
        <div className="lp-cp-picker-list">
          {picked.groups.length === 0 && <div className="lp-cp-picker-empty">Aucun atelier ne correspond.</div>}
          {picked.groups.map((group) => (
            <div key={group.key}>
              {group.label && <div className="lp-cp-picker-group">{group.label}</div>}
              {group.items.map((item) => (
                <label className={"lp-cp-picker-opt" + (item.checked ? " is-on" : "")} key={item.id}>
                  <input type="checkbox" checked={item.checked} onChange={() => toggleWorkshop(item.id)} />
                  <span className="lp-cp-dot" style={{ background: item.color }} />
                  <span className="lp-cp-picker-opt-name">{item.name}</span>
                </label>
              ))}
            </div>
          ))}
          {picked.hiddenSelected.length > 0 && (
            <div className="lp-cp-picker-note">
              {picked.hiddenSelected.join(", ")} {picked.hiddenSelected.length > 1 ? "restent cochés" : "reste coché"} : {picked.hiddenSelected.length > 1 ? "ils sortent" : "il sort"} du filtre, pas de la sélection.
            </div>
          )}
          {onUpdateWorkshops && !draft && (
            <button type="button" className="lp-cp-picker-new" onClick={openDraft}>
              <Plus size={13} />
              {query.trim() ? "Créer l’atelier « " + query.trim() + " »" : "Créer un atelier personnalisé"}
            </button>
          )}
          {onUpdateWorkshops && draft && (
            <div className="lp-cp-draft">
              <input
                type="text"
                autoFocus
                value={draft.name}
                onChange={(e) => setDraft({ ...draft, name: e.target.value })}
                onKeyDown={(e) => {
                  if (e.key === "Enter") { e.preventDefault(); createWorkshop(); }
                  if (e.key === "Escape") { e.preventDefault(); setDraft(null); }
                }}
                placeholder="Nom de l’atelier"
                aria-label="Nom du nouvel atelier"
              />
              <div className="lp-cp-draft-colors">
                {STAFFING_COLOR_CHOICES.map((c) => (
                  <button
                    key={c}
                    type="button"
                    className={"lp-cp-swatch" + (draft.color === c ? " is-on" : "")}
                    style={{ background: c }}
                    aria-label={"Couleur " + c}
                    aria-pressed={draft.color === c}
                    onClick={() => setDraft({ ...draft, color: c })}
                  />
                ))}
              </div>
              <div className="lp-cp-draft-foot">
                <button type="button" className="lp-btn lp-btn-mini" onClick={() => setDraft(null)}>Annuler</button>
                <button type="button" className="lp-btn lp-btn-mini lp-btn-primary" onClick={createWorkshop} disabled={!draft.name.trim()}>
                  Créer et poser
                </button>
              </div>
            </div>
          )}
        </div>
        <div className="lp-cp-picker-foot">
          <span className="lp-cp-picker-count">
            {currentIds.length === 0 ? "Aucun atelier" : currentIds.length > 1 ? currentIds.length + " ateliers" : "1 atelier"}
          </span>
          {currentIds.length > 0 && (
            <button type="button" className="lp-btn lp-btn-mini" onClick={clearCell}>Tout retirer</button>
          )}
          <button type="button" className="lp-btn lp-btn-mini lp-btn-primary" onClick={() => setPicker(null)}>Terminé</button>
        </div>
      </div>,
      document.body
    );
  })();

  return (
    <div className="lp-cp">
      <div className="lp-cp-bar">
        <div className="lp-cp-nav">
          <button type="button" className="lp-tool-btn lp-cp-nav-btn" aria-label="Période précédente" onClick={() => shiftPeriod(-1)}>
            <ChevronLeft size={13} />
          </button>
          {cfg.staffingRange === "custom" && onUpdateWidget ? (
            /* #248 : en mode « Plage », les deux bornes se changent au clic,
               directement dans l'en-tête — plus besoin d'ouvrir les réglages
               du widget. On écrit dans staffingStart/staffingEnd, le MÊME état
               que la fiche de réglages (StaffingDisplayFields plus bas), pas
               une copie : les deux éditeurs restent en phase. L'offset repart
               à 0 comme là-bas, pour que la borne saisie soit bien celle
               affichée tout de suite, sans décalage de navigation hérité. */
            <span className="lp-cp-period lp-cp-period-editable">
              <label className="lp-cp-period-datepick-wrap" title="Changer la date de début">
                {fmtShort(frame.start)}
                <input
                  type="date"
                  className="lp-cp-period-datepick"
                  value={frame.start}
                  max={frame.end}
                  onChange={(e) => {
                    if (!e.target.value) return;
                    onUpdateWidget({ staffingStart: e.target.value, staffingEnd: frame.end, staffingOffset: 0 });
                  }}
                  aria-label="Date de début de la plage"
                />
              </label>
              {" – "}
              <label className="lp-cp-period-datepick-wrap" title="Changer la date de fin">
                {fmtShort(frame.end)}
                <input
                  type="date"
                  className="lp-cp-period-datepick"
                  value={frame.end}
                  min={frame.start}
                  onChange={(e) => {
                    if (!e.target.value) return;
                    onUpdateWidget({ staffingStart: frame.start, staffingEnd: e.target.value, staffingOffset: 0 });
                  }}
                  aria-label="Date de fin de la plage"
                />
              </label>
            </span>
          ) : (
            <span className="lp-cp-period">{periodLabel}</span>
          )}
          <button type="button" className="lp-tool-btn lp-cp-nav-btn" aria-label="Période suivante" onClick={() => shiftPeriod(1)}>
            <ChevronRight size={13} />
          </button>
        </div>
        <div className="lp-zoom-group">
          {STAFFING_RANGES.map((r) => (
            <button
              key={r}
              type="button"
              className={"lp-zoom-btn" + (cfg.staffingRange === r ? " active" : "")}
              onClick={() => setRange(r)}
            >
              {staffingRangeLabel(r)}
            </button>
          ))}
        </div>
        {cfg.staffingOffset !== 0 && onUpdateWidget && (
          <button type="button" className="lp-tool-btn" onClick={() => onUpdateWidget({ staffingOffset: 0 })}>Aujourd'hui</button>
        )}
      </div>

      <div className={"lp-cp-grid" + (pixelArt ? " is-pixel" : "")} ref={gridRef} style={{ gridTemplateColumns: gridTemplate, gap: gridGap }}>
        <div className="lp-cp-corner">Personne</div>
        {days.map((day) => (
          <div
            key={day.iso}
            className={"lp-cp-head" + (day.today ? " is-today" : "") + (day.weekend ? " is-weekend" : "")}
            title={dayTitle(day.iso)}
          >
            <span className="lp-cp-head-dow">
              {cellPx >= 30
                ? STAFFING_DOW_LABELS[day.dow]
                : cellPx >= 17
                  ? STAFFING_DOW_SHORT[day.dow]
                  : STAFFING_DOW_SHORT[day.dow].charAt(0).toUpperCase()}
            </span>
            <span className="lp-cp-head-num">{day.num}</span>
          </div>
        ))}
        {cfg.staffingShowLoad && <div className="lp-cp-corner lp-cp-corner-right">Postes</div>}

        {members.map((member) => {
          const load = staffingMemberLoad(staffing, member.name, days);
          return (
            <React.Fragment key={member.name}>
              <div className="lp-cp-person">
                <span className="lp-cp-avatar" style={{ background: member.color || staffingMemberColor(member.name) }}>
                  {member.avatarDataUrl
                    ? <IconGlyph icon={member.avatarDataUrl} size={16} />
                    : member.name.split(/\s+/).map((part) => part.charAt(0)).join("").slice(0, 2).toUpperCase()}
                </span>
                <span className="lp-cp-person-name">{member.name}</span>
                {onUpdateStaffing && (
                  <span className="lp-cp-person-tools">
                    <button
                      type="button"
                      className="lp-icon-btn lp-cp-person-tool"
                      title="Répéter la semaine précédente sur la période affichée"
                      aria-label={"Répéter la semaine précédente pour " + member.name}
                      onClick={() => onUpdateStaffing((prev) => staffingRepeatPreviousWeek(prev, member.name, days, knownIds))}
                    >
                      <RefreshCw size={11} />
                    </button>
                    <button
                      type="button"
                      className="lp-icon-btn lp-cp-person-tool"
                      title="Appliquer le motif de la première semaine remplie aux cases encore vides de la période"
                      aria-label={"Appliquer le motif hebdomadaire pour " + member.name}
                      onClick={() => onUpdateStaffing((prev) => staffingApplyWeekPattern(prev, member.name, days, knownIds))}
                    >
                      <Copy size={11} />
                    </button>
                  </span>
                )}
              </div>
              {days.map((day) => {
                const ids = cells.get(staffingCellId(member.name, day.iso)) || [];
                const fill = staffingCellFill(ids, catalogue);
                const label = staffingCellLabel(fill, cellPx);
                const activeTasks = cfg.staffingShowTasks ? staffingActiveTasksForCell(tasksIndex, member.name, day.iso) : [];
                const capacity = capacityByName.get(member.name) || STAFFING_CAPACITY_DEFAULT;
                const overCapacity = (ids.length + activeTasks.length) > capacity;
                const painting = !!paintPreview && paintPreview.member === member.name && paintPreview.dates.has(day.iso);
                return (
                  <button
                    type="button"
                    key={day.iso}
                    className={"lp-cp-cell" + (ids.length ? " is-filled" : " is-empty") + (day.today ? " is-today" : "") + (day.weekend ? " is-weekend" : "") + (overCapacity ? " is-over-capacity" : "") + (painting ? " is-painting" : "") + (pixelArt ? " is-pixel" : "")}
                    style={fill ? { background: fill.background } : undefined}
                    aria-label={member.name + " — " + dayTitle(day.iso) + " — " + (ids.length ? ids.map((id) => (workshopFor(catalogue, id) || {}).name).filter(Boolean).join(", ") : "aucun atelier") + (activeTasks.length ? " — " + activeTasks.length + " tâche(s) active(s)" : "") + (overCapacity ? " — capacité dépassée" : "")}
                    onClick={(e) => openPicker(member.name, day.iso, e)}
                    onMouseDown={(e) => beginPaint(member.name, day.iso, e)}
                    onMouseEnter={(e) => { if (e.buttons === 1) paintOver(member.name, day.iso); setHover({ member: member.name, color: member.color, date: day.iso, ids, tasks: activeTasks, overCapacity, x: e.clientX + 14, y: e.clientY + 16 }); }}
                    onMouseMove={(e) => setHover((prev) => (prev ? { ...prev, x: e.clientX + 14, y: e.clientY + 16 } : prev))}
                    onMouseLeave={() => setHover(null)}
                  >
                    {label && <span className="lp-cp-label">{label}</span>}
                    {ids.length === 0 && <span className="lp-cp-plus" aria-hidden="true">+</span>}
                    {cfg.staffingShowTasks && activeTasks.length > 0 && (
                      <span className={"lp-cp-tasks-badge" + (activeTasks.length > 2 ? " is-high" : "")} aria-hidden="true">{activeTasks.length}</span>
                    )}
                    {overCapacity && <AlertTriangle size={10} className="lp-cp-capacity-alert" aria-hidden="true" />}
                  </button>
                );
              })}
              {cfg.staffingShowLoad && (
                <div className="lp-cp-load">
                  <span className="lp-cp-load-track">
                    <span
                      className="lp-cp-load-fill"
                      style={{ width: Math.min(100, days.length ? (load / (days.length * 1.4)) * 100 : 0) + "%", background: member.color || "var(--text-muted)" }}
                    />
                  </span>
                  <span className="lp-cp-load-value">{load}</span>
                </div>
              )}
            </React.Fragment>
          );
        })}

        <div className="lp-cp-corner lp-cp-foot-label">Personnes affectées</div>
        {days.map((day) => {
          const count = staffingDayCount(staffing, members, day.iso);
          return (
            <div key={day.iso} className={"lp-cp-foot" + (count === 0 ? " is-zero" : "") + (day.today ? " is-today" : "")}>
              {count}
            </div>
          );
        })}
        {cfg.staffingShowLoad && <div />}
      </div>

      <div className="lp-cp-legend">
        {catalogue.map((shop) => {
          const total = workshopTotals.get(shop.id) || 0;
          return (
            <span className="lp-cp-legend-item" key={shop.id}>
              <span className="lp-cp-dot" style={{ background: shop.color }} />
              {shop.name}
              {total > 0 && <span className="lp-cp-legend-total">{total}</span>}
            </span>
          );
        })}
      </div>

      {tooltip}
      {pickerNode}
    </div>
  );
}

// Axe temporel compact, partagé par les widgets Mini-Gantt et Mini métro : choisit
// automatiquement le pas d'affichage (jour/semaine/mois/trimestre/année) selon
// l'étendue réelle des dates du widget, pour rester lisible quel que soit le zoom
// — même logique d'ajustement automatique que la vue Planning Projets complète.
/* Largeur estimée d'une étiquette d'axe, en pixels. Mono 10 px gras : ~6,2 px
   par caractère, volontairement un peu généreux — sous-estimer laisserait deux
   étiquettes se toucher, ce que l'éclaircie est précisément là pour éviter. */
const MINIGANTT_AXIS_LABEL_GAP = 10;
function widgetAxisLabelWidth(label) {
  return 4 + String(label || "").length * 6.2;
}

function widgetAxisUnit(spanDays) {
  return spanDays <= 18 ? "day" : spanDays <= 70 ? "week" : spanDays <= 550 ? "month" : spanDays <= 1500 ? "quarter" : "year";
}
function widgetAxisTicks(minDate, maxDate) {
  const spanDays = Math.max(1, dayIndex(maxDate) - dayIndex(minDate));
  const unit = widgetAxisUnit(spanDays);
  const dayLabel = (d) => { const dt = new Date(d + "T00:00:00"); return `${dt.getDate()}/${dt.getMonth() + 1}`; };
  const ticks = [];
  let cur = unitStart(minDate, unit);
  let guard = 0;
  while (dayIndex(cur) <= dayIndex(maxDate) && guard < 80) {
    if (dayIndex(cur) >= dayIndex(minDate)) ticks.push({ date: cur, label: unit === "day" ? dayLabel(cur) : unitLabel(cur, unit) });
    cur = addDays(cur, unitLen(cur, unit));
    guard++;
  }
  // Pour un pas "jour", on ne garde qu'une étiquette sur N pour ne jamais surcharger un widget étroit.
  if (unit === "day" && ticks.length > 7) {
    const step = Math.ceil(ticks.length / 7);
    return ticks.filter((_, i) => i % step === 0);
  }
  return ticks;
}
// Séparateurs intermédiaires, plus fins que les étiquettes principales : à un pas
// "semaine", un repère par jour ; à un pas "mois", un repère par semaine ; à un pas
// "trimestre", un repère par mois — pour garder un sens de l'échelle même quand les
// étiquettes principales sont grossières, sans jamais surcharger le widget.
/* Sous-grille verticale : un repère intermédiaire entre deux graduations
   étiquetées, pour donner du contexte temporel sans surcharger l'axe.

   Le pas ANNUEL n'en avait aucun : sur un diagramme de sept ans, on voyait sept
   traits et rien entre eux — impossible de situer une barre au trimestre près
   (retour de test). Il reçoit donc les trimestres, comme le pas trimestriel
   reçoit les mois. Le pas JOURNALIER reste sans sous-grille : il n'y a rien de
   plus fin qu'un jour à montrer.

   Le garde-fou passe de 300 à 600 : sept ans de trimestres tiennent largement,
   mais une fenêtre à dates fixes de vingt ans en demanderait quatre-vingts de
   plus, et la boucle doit rester bornée quoi qu'il arrive. */
/* Échelle des graduations, du plus large au plus fin. Descendre « d'un cran »,
   c'est avancer d'une case dans cette suite — l'axe porte donc jusqu'à TROIS
   niveaux : son unité, puis deux sous-grilles de plus en plus fines. */
const WIDGET_AXIS_SCALE = ["year", "quarter", "month", "week", "day"];

function widgetFinerUnit(unit, crans) {
  const i = WIDGET_AXIS_SCALE.indexOf(unit);
  if (i === -1) return null;
  return WIDGET_AXIS_SCALE[i + crans] || null;
}

/* Sous-graduations à `crans` niveaux sous l'unité de l'axe.

   Un garde-fou de densité, et pas seulement de boucle : sous une échelle
   mensuelle, le troisième niveau est le JOUR, soit jusqu'à 550 traits sur une
   piste de quelques centaines de pixels — un aplat gris, pas un repère. Au-delà
   de MINIGANTT_SUBGRID_MAX traits, le niveau se tait, et l'axe reste lisible à
   tous les zooms sans qu'on ait à le régler. */
const MINIGANTT_SUBGRID_MAX = 180;

function widgetSubTicks(minDate, maxDate, crans) {
  const spanDays = Math.max(1, dayIndex(maxDate) - dayIndex(minDate));
  const unit = widgetAxisUnit(spanDays);
  const subUnit = widgetFinerUnit(unit, crans);
  if (!subUnit) return [];
  const ticks = [];
  let cur = unitStart(minDate, subUnit);
  let guard = 0;
  while (dayIndex(cur) <= dayIndex(maxDate) && guard < 1200) {
    if (dayIndex(cur) >= dayIndex(minDate)) ticks.push(cur);
    cur = addDays(cur, unitLen(cur, subUnit));
    guard++;
  }
  return ticks.length > MINIGANTT_SUBGRID_MAX ? [] : ticks;
}

// Un cran sous l'unité de l'axe : année → trimestre, mois → semaine…
function widgetSecondaryTicks(minDate, maxDate) {
  return widgetSubTicks(minDate, maxDate, 1);
}

// Deux crans : année → mois, trimestre → semaine, mois → jour. C'est ce niveau
// qui se tait le premier quand la piste ne peut plus le porter.
function widgetTertiaryTicks(minDate, maxDate) {
  return widgetSubTicks(minDate, maxDate, 2);
}

// Heat map mensuelle compacte : grille calendrier sur 3 mois consécutifs, navigable
// de mois en mois, colorée par PROJET (et non plus par densité) — chaque case avec
// des tâches se terminant ce jour-là est teintée avec la couleur du projet ; quand
// plusieurs projets se terminent le même jour, la case est partagée en quartiers
// (conic-gradient) selon la couleur de chacun. Les jours en retard gardent un
// contour rouge distinct, pour rester un signal d'alerte reconnaissable même si la
// couleur de fond est désormais celle du projet plutôt qu'un dégradé de charge.
function WidgetHeatmapMonth({ widget, tasks, ctx, onOpen, onUpdateTask, appearance }) {
  const [monthOffset, setMonthOffset] = useState(0);
  const [hoverDay, setHoverDay] = useState(null); // { day, x, y }
  const [selectedDay, setSelectedDay] = useState(null); // jour cliqué : ouvre le panneau de liste à droite
  // null = pas encore glissé par l'utilisateur → répartition 50/50 exacte (flex
  // égal des deux côtés). Un nombre = largeur en px du volet liste, fixée par un
  // glisser-déposer explicite sur la poignée.
  const [listWidth, setListWidth] = useState(null);
  const dragRef = useRef(null);
  const wrapRef = useRef(null);
  const daylistRef = useRef(null);
  // Volet Description (#177, désormais toujours actif — #216) : la tâche
  // choisie DANS LA LISTE, distincte du jour choisi dans le calendrier ;
  // changer de jour ne doit pas fermer la description en cours de lecture tant
  // que la tâche reste dans la liste du jour affiché. #216 : simple clic sur
  // une tâche de la liste → affiche sa description ici (volet 3) ; double-clic
  // → ouvre la fiche complète (édition), comme ailleurs dans l'app.
  const showDescPane = true;
  const [descTaskId, setDescTaskId] = useState(null);
  const [descPreview, setDescPreview] = useState(true);
  const [descPaneWidth, setDescPaneWidth] = useState(null);
  const descPaneRef = useRef(null);
  const descDragRef = useRef(null);
  // Largeur plancher du calendrier : quelle que soit la position de L'AUTRE
  // séparateur, il en reste toujours au moins ça — sans ce plancher partagé,
  // pousser un volet à fond pouvait écraser le calendrier jusqu'à une largeur
  // quasi nulle, et le second séparateur devenait alors impossible à ramener
  // (les deux poignées donnaient l'impression d'être liées, #286).
  const CALENDAR_MIN_WIDTH = 180;
  /* Widget étroit (#298) : sous cette largeur, les trois volets côte à côte
     laisseraient au calendrier moins que son plancher — à 420 px il tombait à
     116 px, rognant les mois et le dimanche. On les empile alors (calendrier,
     puis liste, puis description), sans poignée de redimensionnement. La
     largeur est lue sur la boîte de bordure : l'apparition d'une barre de
     défilement verticale ne la change pas, donc pas d'aller-retour. */
  const STACK_BELOW_WIDTH = 640;
  const [stacked, setStacked] = useState(false);
  useLayoutEffect(() => {
    const el = wrapRef.current;
    if (!el) return undefined;
    const measure = () => {
      const w = el.getBoundingClientRect().width;
      if (w > 0) setStacked(w < STACK_BELOW_WIDTH);
    };
    measure();
    if (typeof ResizeObserver === "undefined") return undefined;
    const ro = new ResizeObserver(measure);
    ro.observe(el);
    return () => ro.disconnect();
  }, []);
  const startDescResize = (e) => {
    e.preventDefault();
    const startWidth = descPaneWidth != null ? descPaneWidth : (descPaneRef.current?.getBoundingClientRect().width || 280);
    descDragRef.current = { startX: e.clientX, startWidth };
    const onMove = (ev) => {
      if (!descDragRef.current) return;
      const wrapWidth = wrapRef.current?.getBoundingClientRect().width || 900;
      const listW = listWidth != null ? listWidth : (daylistRef.current?.getBoundingClientRect().width || 0);
      const delta = descDragRef.current.startX - ev.clientX;
      const maxDesc = Math.max(200, wrapWidth - CALENDAR_MIN_WIDTH - listW);
      setDescPaneWidth(Math.max(200, Math.min(maxDesc, descDragRef.current.startWidth + delta)));
    };
    const onUp = () => {
      descDragRef.current = null;
      window.removeEventListener("mousemove", onMove);
      window.removeEventListener("mouseup", onUp);
    };
    window.addEventListener("mousemove", onMove);
    window.addEventListener("mouseup", onUp);
  };
  const startResize = (e) => {
    e.preventDefault();
    const startWidth = listWidth != null ? listWidth : (daylistRef.current?.getBoundingClientRect().width || 400);
    dragRef.current = { startX: e.clientX, startWidth };
    const onMove = (ev) => {
      if (!dragRef.current) return;
      const wrapWidth = wrapRef.current?.getBoundingClientRect().width || 800;
      const descW = descPaneWidth != null ? descPaneWidth : (descPaneRef.current?.getBoundingClientRect().width || 0);
      const delta = dragRef.current.startX - ev.clientX; // glisser vers la gauche agrandit la liste
      const maxList = Math.max(220, wrapWidth - CALENDAR_MIN_WIDTH - descW);
      const next = Math.max(220, Math.min(maxList, dragRef.current.startWidth + delta));
      setListWidth(next);
    };
    const onUp = () => {
      dragRef.current = null;
      window.removeEventListener("mousemove", onMove);
      window.removeEventListener("mouseup", onUp);
    };
    window.addEventListener("mousemove", onMove);
    window.addEventListener("mouseup", onUp);
  };
  const dated = useMemo(() => tasks.filter((t) => t.start && t.end), [tasks]);
  const today = iso(new Date());
  const MONTHS_FULL = ["Janvier", "Février", "Mars", "Avril", "Mai", "Juin", "Juillet", "Août", "Septembre", "Octobre", "Novembre", "Décembre"];
  const DOW = ["L", "M", "M", "J", "V", "S", "D"];

  // Les 3 mois affichés côte à côte : le mois courant (+ monthOffset) d'abord, puis
  // les deux suivants — jamais de mois isolé au milieu, pour rester lisible comme
  // un vrai calendrier trimestriel qu'on fait glisser mois par mois.
  const months = useMemo(() => {
    return [0, 1, 2].map((i) => {
      const base = new Date();
      base.setDate(1);
      base.setMonth(base.getMonth() + monthOffset + i);
      const year = base.getFullYear(), month = base.getMonth();
      const firstOfMonth = new Date(year, month, 1);
      const startDow = (firstOfMonth.getDay() + 6) % 7; // lundi = 0
      const gridStart = new Date(firstOfMonth);
      gridStart.setDate(gridStart.getDate() - startDow);
      const cells = [];
      for (let d = 0; d < 42; d++) {
        const dt = new Date(gridStart);
        dt.setDate(dt.getDate() + d);
        cells.push(iso(dt));
      }
      // On n'affiche que les semaines nécessaires (5 ou 6 selon le mois) pour ne
      // pas gaspiller une ligne entière de cases vides quand ce n'est pas utile.
      let neededRows = 6;
      for (let r = 6; r >= 5; r--) {
        const lastCellOfRow = cells[r * 7 - 1];
        if (lastCellOfRow && new Date(lastCellOfRow + "T00:00:00").getMonth() !== month) neededRows = r;
      }
      return { year, month, visibleCells: cells.slice(0, neededRows * 7), neededRows };
    });
  }, [monthOffset]);
  const rangeLabel = `${MONTHS_FULL[months[0].month]} ${months[0].year} — ${MONTHS_FULL[months[2].month]} ${months[2].year}`;

  // Uniquement les dates de FIN de tâche et les dates de JALON — jamais les dates
  // de début ni une date intermédiaire. Un jalon a start === end, donc il est déjà
  // naturellement inclus via t.end ; ce filtre exclut explicitement toute autre
  // lecture possible pour rester sans ambiguïté.
  const { tasksByDay, lateCounts } = useMemo(() => {
    const byDay = {}, late = {};
    dated.forEach((t) => {
      (byDay[t.end] || (byDay[t.end] = [])).push(t);
      if (!isTaskDoneGlobal(t, ctx) && t.end < today) late[t.end] = (late[t.end] || 0) + 1;
    });
    return { tasksByDay: byDay, lateCounts: late };
  }, [dated, ctx, today]);

  const tasksForDay = (day) => tasksByDay[day] || [];

  // Sélection d'un jour, factorisée pour être partagée entre le clic direct sur
  // une case du calendrier et le bouton « Aujourd'hui » (#323) : même
  // comportement dans les deux cas (case cochée/décochée, description auto si
  // une seule tâche ce jour-là).
  const selectDay = (day) => {
    const dayTasks = tasksForDay(day);
    setSelectedDay((d) => (d === day ? null : (dayTasks.length ? day : null)));
    setDescTaskId(dayTasks.length === 1 ? dayTasks[0].id : null);
  };
  const goToToday = () => {
    setMonthOffset(0);
    selectDay(today);
  };

  // Couleur(s) d'une case : la ou les couleurs des projets ayant une tâche qui se
  // termine ce jour-là. Un seul projet → aplat. Plusieurs projets → la case est
  // divisée en quartiers égaux (un par projet, dans l'ordre d'apparition) via un
  // conic-gradient orienté en diagonale, pour que le partage saute aux yeux même
  // sur une petite case.
  const cellBackground = (day) => {
    const dayTasks = tasksForDay(day);
    if (!dayTasks.length) return null;
    const projIds = [];
    dayTasks.forEach((t) => { if (t.projectId && !projIds.includes(t.projectId)) projIds.push(t.projectId); });
    const colors = (projIds.length ? projIds : [null]).map(
      (pid) => ctx.projects.find((p) => p.id === pid)?.color || "var(--text-muted)"
    );
    if (colors.length === 1) return colors[0];
    const seg = 360 / colors.length;
    const stops = colors.map((c, i) => `${c} ${i * seg}deg ${(i + 1) * seg}deg`).join(", ");
    return `conic-gradient(from 45deg, ${stops})`;
  };

  const selectedTasks = selectedDay ? tasksForDay(selectedDay) : [];

  // Légende : un point par projet ayant au moins une tâche visible dans ce widget,
  // dans l'ordre de première apparition — pour associer couleur ↔ projet d'un
  // coup d'œil sans avoir à cliquer sur chaque case.
  const legendProjects = useMemo(() => {
    const seen = new Set(), list = [];
    dated.forEach((t) => {
      if (t.projectId && !seen.has(t.projectId)) {
        seen.add(t.projectId);
        const p = ctx.projects.find((pr) => pr.id === t.projectId);
        if (p) list.push(p);
      }
    });
    return list;
  }, [dated, ctx.projects]);

  return (
    <div className={"lp-widget-heatmap-wrap" + (stacked ? " is-stacked" : "")} ref={wrapRef}>
      <div className="lp-widget-heatmap">
        <div className="lp-widget-heatmap-head">
          <button className="lp-icon-btn" onClick={() => setMonthOffset((m) => m - 1)} title="Mois précédent"><ChevronRight size={13} style={{ transform: "rotate(180deg)" }} /></button>
          <span className="lp-widget-heatmap-title">{rangeLabel}</span>
          <button className="lp-icon-btn" onClick={() => setMonthOffset((m) => m + 1)} title="Mois suivant"><ChevronRight size={13} /></button>
          {monthOffset !== 0 && <button className="lp-icon-btn" onClick={() => setMonthOffset(0)} title="Revenir au mois en cours"><RefreshCw size={11} /></button>}
          <button type="button" className="lp-tool-btn lp-widget-heatmap-today-btn" onClick={goToToday} title="Aller à aujourd'hui et sélectionner le jour">Aujourd'hui</button>
        </div>
        {legendProjects.length > 0 && (
          <div className="lp-widget-heatmap-legend">
            {legendProjects.map((p) => (
              <span className="lp-widget-heatmap-legend-item" key={p.id}>
                <span className="lp-widget-heatmap-legend-dot" style={{ background: p.color || "var(--text-muted)" }} />
                {p.name}
              </span>
            ))}
          </div>
        )}
        <div className="lp-widget-heatmap-months">
          {months.map(({ year, month, visibleCells, neededRows }) => (
            <div className="lp-widget-heatmap-month" key={`${year}-${month}`}>
              <div className="lp-widget-heatmap-month-title">{MONTHS_FULL[month]} {year}</div>
              <div className="lp-widget-heatmap-dow">
                {DOW.map((d, i) => <span key={i}>{d}</span>)}
              </div>
              {/* Plancher de hauteur par ligne : les mois ne s'étirent plus pour
                  remplir la hauteur depuis qu'ils se répartissent en grille
                  (#68), et sans lui les cases se tasseraient jusqu'à cacher le
                  numéro du jour quand plusieurs lignes de mois se partagent la
                  hauteur. Le « 1fr » reste : là où il y a de la place, les cases
                  la prennent toujours. */}
              <div className="lp-widget-heatmap-grid" style={{ gridTemplateRows: `repeat(${neededRows}, minmax(16px, 1fr))` }}>
                {visibleCells.map((day) => {
                  const inMonth = new Date(day + "T00:00:00").getMonth() === month;
                  const bg = cellBackground(day);
                  const dayTasks = tasksForDay(day);
                  const isLate = (lateCounts[day] || 0) > 0;
                  /* Passé au sens strict : aujourd'hui n'est pas du passé, et
                     doit rester au premier plan avec les jours à venir (#68). */
                  const isPast = day < today;
                  return (
                    <div
                      key={day}
                      className={"lp-widget-heatmap-cell" + (!inMonth ? " lp-widget-heatmap-cell-out" : "") + (day === today ? " lp-widget-heatmap-cell-today" : "") + (day === selectedDay ? " lp-widget-heatmap-cell-selected" : "") + (isLate ? " lp-widget-heatmap-cell-late" : "") + (isPast && bg ? " lp-widget-heatmap-cell-past" : "")}
                      style={bg ? { background: bg } : undefined}
                      onMouseEnter={(e) => dayTasks.length && setHoverDay({ day, tasks: dayTasks, x: e.clientX, y: e.clientY })}
                      onMouseMove={(e) => dayTasks.length && setHoverDay({ day, tasks: dayTasks, x: e.clientX, y: e.clientY })}
                      onMouseLeave={() => setHoverDay(null)}
                      onClick={() => selectDay(day)}
                      onDoubleClick={() => { if (dayTasks.length === 1) onOpen(dayTasks[0]); }}
                    >
                      {/* Sur une case lavée, le blanc devient illisible : le
                          numéro reprend la couleur du texte ordinaire. */}
                      <span className="lp-widget-heatmap-daynum" style={bg ? { color: isPast ? "var(--text-900)" : "#fff" } : undefined}>{new Date(day + "T00:00:00").getDate()}</span>
                    </div>
                  );
                })}
              </div>
            </div>
          ))}
        </div>
        {hoverDay && (
          <WidgetPointerTooltip x={hoverDay.x} y={hoverDay.y} className="lp-pie-tooltip lp-widget-metro-tooltip">
            <div className="lp-widget-metro-tooltip-title">{fmtShort(hoverDay.day)}</div>
            <div className="lp-widget-metro-tooltip-meta">{hoverDay.tasks.slice(0, 5).map((t) => t.title).join(", ")}{hoverDay.tasks.length > 5 ? ` +${hoverDay.tasks.length - 5} autres` : ""}</div>
          </WidgetPointerTooltip>
        )}
      </div>
      {/* Poignée de glisser : ajuste la part respective du calendrier et de la
          liste. Tant qu'elle n'a pas été utilisée, les deux volets se partagent
          l'espace disponible à parts strictement égales (flex 1 1 0 des deux
          côtés) — un glisser-déposer explicite fixe ensuite une largeur en px. */}
      <div className="lp-widget-heatmap-resize-handle" onMouseDown={startResize} title="Glisser pour redimensionner" />
      {/* Panneau de liste : toujours apparent (même sans jour sélectionné, avec un
          message d'invite), pour que sa présence soit prévisible plutôt que de
          faire réapparaître/disparaître le calendrier à chaque clic. */}
      <div className="lp-widget-heatmap-daylist" ref={daylistRef} style={stacked ? undefined : listWidth == null ? { flex: "1 1 0" } : { flex: `0 0 ${listWidth}px` }}>
        <div className="lp-widget-heatmap-daylist-head">
          <span>{selectedDay ? fmtShort(selectedDay) : "Aucun jour sélectionné"}</span>
          {selectedDay && <button className="lp-icon-btn" onClick={() => setSelectedDay(null)}><X size={12} /></button>}
        </div>
        {selectedDay ? (
          <div className="lp-widget-heatmap-daylist-items">
            {selectedTasks.map((t) => {
              const proj = ctx.projects.find((p) => p.id === t.projectId);
              const st = ctx.statuses.find((s) => s.id === t.statusId);
              return (
                <div
                  className={"lp-widget-heatmap-daylist-item" + (descTaskId === t.id ? " is-selected" : "")}
                  key={t.id}
                  onClick={() => setDescTaskId(t.id)}
                  onDoubleClick={() => onOpen(t)}
                  title="Clic : voir la description — double-clic : ouvrir la fiche"
                >
                  <span className="lp-project-dot" style={{ background: proj?.color || "var(--text-muted)", width: 12, height: 12, flex: "0 0 auto" }} />
                  <span className="lp-widget-heatmap-daylist-title">{t.title}</span>
                  {st && <span className="lp-widget-heatmap-daylist-status" style={{ color: st.color }}>{st.name}</span>}
                </div>
              );
            })}
          </div>
        ) : (
          <div className="lp-widget-heatmap-daylist-empty">Clique sur un jour du calendrier pour voir les tâches qui s'y terminent.</div>
        )}
      </div>

      {showDescPane && (() => {
        const descTask = descTaskId ? tasks.find((t) => t.id === descTaskId) : null;
        // #216 : une tâche « Réunion » affiche son volet 3 en deux sections
        // repliées par défaut (Description = ordre du jour, Compte rendu =
        // champ dédié `meetingReport` écrit par la fiche de tâche, #136) —
        // jamais mélangées, comme le reste de l'app.
        const isMeeting = descTask ? isMeetingTask(descTask, ctx) : false;
        return (
          <>
            <div className="lp-widget-hmgrid-resize-handle" onMouseDown={startDescResize} title="Glisser pour redimensionner" />
            <div
              className="lp-widget-hmgrid-descpane"
              ref={descPaneRef}
              style={stacked ? undefined : descPaneWidth == null ? { flex: "1 1 0" } : { flex: `0 0 ${descPaneWidth}px` }}
            >
              <div className="lp-widget-hmgrid-tasklist-head">
                <span>{descTask ? descTask.title || "Sans titre" : "Aucune tâche choisie"}</span>
                {descTask && !isMeeting && (
                  <div className="lp-desc-mode-toggle">
                    <button type="button" className={descPreview ? "active" : ""} onClick={() => setDescPreview(true)}>Aperçu</button>
                    <button type="button" className={!descPreview ? "active" : ""} onClick={() => setDescPreview(false)}>Écrire</button>
                  </div>
                )}
              </div>
              {!descTask ? (
                <div className="lp-widget-hmgrid-tasklist-empty">Clique sur une tâche de la liste pour lire ou modifier sa description.</div>
              ) : isMeeting ? (
                <div className="lp-widget-hmgrid-descpane-body lp-widget-hmgrid-descpane-meeting">
                  <SettingsFoldSection title="Description">
                    <div
                      className="lp-desc-preview"
                      dangerouslySetInnerHTML={{
                        __html: renderMarkdown(descTask.desc ?? descTask.description ?? "", true) || '<p style="color:var(--text-muted)">Aucune description.</p>',
                      }}
                    />
                  </SettingsFoldSection>
                  <SettingsFoldSection title="Compte rendu">
                    <div
                      className="lp-desc-preview"
                      dangerouslySetInnerHTML={{
                        __html: renderMarkdown(descTask.meetingReport || "", true) || '<p style="color:var(--text-muted)">Pas encore de compte rendu.</p>',
                      }}
                    />
                  </SettingsFoldSection>
                </div>
              ) : descPreview ? (
                <div
                  className="lp-desc-preview lp-widget-hmgrid-descpane-body"
                  dangerouslySetInnerHTML={{
                    __html: renderMarkdown(descTask.desc ?? descTask.description ?? "", true) || '<p style="color:var(--text-muted)">Aucune description.</p>',
                  }}
                />
              ) : (
                <textarea
                  className="lp-widget-hmgrid-descpane-body lp-widget-hmgrid-descpane-edit"
                  value={descTask.desc ?? descTask.description ?? ""}
                  onChange={(e) => onUpdateTask && onUpdateTask(descTask.id, { desc: e.target.value })}
                  placeholder="Écris ici… Markdown pris en charge."
                />
              )}
            </div>
          </>
        );
      })()}
    </div>
  );
}

/* Widget « Quick Habit » (#193) : la coche du jour, groupée par Thème — pills
   en radio pour un thème « choix unique », chips indépendantes pour un thème
   « multi-sélection ». La date affichée n'est PAS forcément aujourd'hui :
   naviguer vers le passé corrige une coche oubliée, naviguer vers le futur
   pré-remplit un jour à venir (congé prévu, séance planifiée…) — aucune des
   deux directions n'est restreinte. */
/* Rendu d'UN thème (habitudes à cocher OU chiffrées) pour une date donnée —
   partagé par le widget Quick Habit et la fenêtre "Quick Habit" ouverte en
   double-clic depuis la Heatmap (#193 v2), qui édite TOUS les thèmes d'un
   coup pour un jour précis.
   `allThemes` (le catalogue COMPLET, pas juste `theme`) doit être passé à
   toggleHabitLogEntry/setHabitLogValue : ces deux fonctions en dérivent la
   liste des habitudes connues et, via normalizeHabitLog, SUPPRIMENT du
   journal toute entrée dont l'habitude n'y figure pas. Leur passer un seul
   thème effaçait donc silencieusement les coches de tous les autres thèmes
   à chaque bascule — régression corrigée le jour même du déploiement. */
/* Aperçu miniature du pixel du jour pour une section (#221) : réutilise TEL
   QUEL le calcul canonique de la heatmap mensuelle/annuelle des habitudes —
   habitCellColors() dérive les couleurs des habitudes cochées/chiffrées ce
   jour-là pour ce thème, habitCellBackground() les compose (aplat ou dégradé
   conique si plusieurs) — jamais une logique de couleur dupliquée ici. Les
   données viennent de habitLog déjà chargé par le widget, aucune lecture
   Firestore supplémentaire. Purement décoratif : pas de cursor, pas de
   gestionnaire de clic, exclu de la navigation clavier (rôle "img"). */
function DailyPixelPreview({ section, date, habitLog, size = 14 }) {
  const colors = useMemo(() => habitCellColors(section, habitLog, date), [section, habitLog, date]);
  const empty = colors.length === 0;
  const bg = habitCellBackground(colors, "var(--paper-soft)");
  const dateLabel = date ? new Date(date + "T00:00:00").toLocaleDateString("fr-FR", { day: "numeric", month: "long", year: "numeric" }) : "";
  return (
    <span
      className={"lp-widget-habit-quick-theme-preview" + (empty ? " is-empty" : "")}
      style={{ width: size, height: size, background: bg }}
      role="img"
      aria-label={`Aperçu du pixel ${section?.name || ""} pour le ${dateLabel}`}
      title="Aperçu du pixel du jour"
    />
  );
}

function HabitThemeGroup({ theme, allThemes, date, habitLog, setHabitLog }) {
  const checkedIds = useMemo(() => new Set(habitLogHabitIdsForDate(habitLog, date)), [habitLog, date]);

  const toggle = (habitId) => {
    if (!setHabitLog) return;
    setHabitLog((prev) => toggleHabitLogEntry(prev, allThemes, habitId, date));
  };
  const setValue = (habitId, raw) => {
    if (!setHabitLog) return;
    setHabitLog((prev) => setHabitLogValue(prev, allThemes, habitId, date, raw));
  };

  return (
    <div className="lp-widget-habit-quick-theme">
      <div className="lp-widget-habit-quick-theme-head">
        <span className="lp-widget-habit-quick-theme-dot" style={{ background: theme.color }} />
        <span className="lp-widget-habit-quick-theme-name">{theme.name}</span>
        <DailyPixelPreview section={theme} date={date} habitLog={habitLog} size={14} />
        <span className="lp-widget-habit-quick-theme-mode">{theme.selectionMode === "multi" ? "plusieurs possibles" : "un seul choix"}</span>
      </div>
      {theme.habits.length === 0 ? (
        <div className="lp-widget-habit-quick-theme-empty">Aucune habitude dans ce thème.</div>
      ) : (
        <div className="lp-widget-habit-quick-options">
          {theme.habits.map((habit) => {
            if (habit.kind === "numeric") {
              const val = habitLogValueForDate(habitLog, habit.id, date);
              const min = Number.isFinite(habit.min) ? habit.min : 0;
              const max = Number.isFinite(habit.max) ? habit.max : min + 10;
              // #223 : boutons +/- à la place de l'input number/slider. Pas de
              // valeur posée -> "-" désactivé (rien à retirer) ; "+" démarre à
              // `min` (pas min+1) ; setValue() clampe déjà [min, max] et efface
              // l'entrée sur une valeur vide, réutilisé tel quel ici.
              // Pas partagé avec le widget Pixel des habitudes (#353).
              const dec = () => {
                const next = habitNumericStep(habit, val === null ? NaN : val, -1);
                if (next !== null) setValue(habit.id, next);
              };
              const inc = () => {
                const next = habitNumericStep(habit, val === null ? NaN : val, 1);
                if (next !== null) setValue(habit.id, next);
              };
              return (
                <div
                  key={habit.id}
                  className="lp-widget-habit-numeric"
                  style={val !== null ? { borderColor: habit.color } : undefined}
                >
                  <span className="lp-widget-habit-numeric-name">{habit.name}</span>
                  <div className="lp-widget-habit-numeric-controls">
                    <button type="button" className="lp-widget-habit-numeric-btn" onClick={dec} disabled={val === null} aria-label={`Diminuer ${habit.name}`}>−</button>
                    <span className="lp-widget-habit-numeric-value">{habitValueLabel(val)}</span>
                    <button type="button" className="lp-widget-habit-numeric-btn" onClick={inc} disabled={val !== null && val >= max} aria-label={`Augmenter ${habit.name}`}>+</button>
                  </div>
                </div>
              );
            }
            const active = checkedIds.has(habit.id);
            if (theme.selectionMode === "multi") {
              return (
                <button
                  key={habit.id}
                  type="button"
                  className={"lp-widget-habit-chip" + (active ? " active" : "")}
                  style={active ? { borderColor: habit.color, background: habit.color + "1f", color: "var(--text-900)" } : undefined}
                  onClick={() => toggle(habit.id)}
                >
                  {active ? <Check size={11} color={habit.color} /> : <span className="lp-widget-habit-chip-empty" />}
                  {habit.name}
                </button>
              );
            }
            return (
              <button
                key={habit.id}
                type="button"
                className={"lp-widget-habit-pill" + (active ? " active" : "")}
                style={active ? { background: habit.color, borderColor: habit.color, color: textOn(habit.color) } : undefined}
                onClick={() => toggle(habit.id)}
              >
                {habit.name}
              </button>
            );
          })}
        </div>
      )}
    </div>
  );
}

/* Fenêtre "Quick Habit" ouverte en double-clic sur N'IMPORTE QUEL jour
   (widget Heatmap habitudes, vue mensuelle ou annuelle) : modifie TOUTES
   les habitudes de TOUS les thèmes pour cette date, pas seulement celles du
   thème actuellement affiché par la heatmap. */
function HabitQuickDayModal({ date, themes, habitLog, setHabitLog, onClose }) {
  const label = new Date(date + "T00:00:00").toLocaleDateString("fr-FR", { weekday: "long", day: "numeric", month: "long", year: "numeric" });
  return (
    <Modal title={`Quick Habit — ${label}`} onClose={onClose}>
      <div className="lp-widget-habit-quick lp-habit-quick-modal-body">
        {themes.length === 0 ? (
          <div className="lp-widget-habit-empty">Aucun Thème d'habitude configuré.</div>
        ) : (
          themes.map((theme) => <HabitThemeGroup key={theme.id} theme={theme} allThemes={themes} date={date} habitLog={habitLog} setHabitLog={setHabitLog} />)
        )}
      </div>
    </Modal>
  );
}

function WidgetHabitQuick({ widget, ctx, habitLog, setHabitLog, viewDate: viewDateProp, setViewDate: setViewDateProp, onOpenHabitThemes }) {
  const themes = useMemo(() => normalizeHabitThemes(ctx.habitThemes), [ctx.habitThemes]);
  const todayIso = iso(new Date());
  // Contrôlé par DashboardView (partagé avec la Heatmap de la même page) quand
  // ces props sont fournies ; sinon repli sur un état local — même logique
  // que les widgets pilotés/autonomes déjà présents ailleurs dans le fichier.
  const [viewDateLocal, setViewDateLocal] = useState(todayIso);
  const viewDate = viewDateProp !== undefined ? viewDateProp : viewDateLocal;
  const setViewDate = setViewDateProp || setViewDateLocal;

  const checkedIds = useMemo(() => new Set(habitLogHabitIdsForDate(habitLog, viewDate)), [habitLog, viewDate]);
  const totalChecked = themes.reduce((sum, t) => sum + t.habits.filter((h) => checkedIds.has(h.id)).length, 0);
  const dateLabel = viewDate === todayIso ? "Aujourd'hui" : fmtShort(viewDate);

  if (!themes.length) {
    return (
      <div className="lp-widget-habit-quick lp-widget-habit-empty">
        Aucun Thème d'habitude configuré. Ouvrez Réglages → Thèmes d'habitudes pour en créer un.
      </div>
    );
  }

  return (
    <div className="lp-widget-habit-quick">
      <div className="lp-widget-habit-quick-head">
        <div className="lp-widget-habit-quick-title-row">
          <div>
            <div className="lp-widget-habit-quick-title">Quick Habit</div>
            <div className="lp-widget-habit-quick-sub">Cochez ce que vous avez fait</div>
          </div>
          {onOpenHabitThemes && (
            <button type="button" className="lp-icon-btn" onClick={onOpenHabitThemes} title="Réglages → Thèmes d'habitudes" aria-label="Réglages des thèmes d'habitudes">
              <Settings size={13} />
            </button>
          )}
        </div>
        <div className="lp-widget-habit-quick-datenav">
          <button className="lp-icon-btn" onClick={() => setViewDate((d) => addDays(d, -1))} aria-label="Jour précédent"><ChevronLeft size={14} /></button>
          <span className="lp-widget-habit-quick-datelabel">{dateLabel}</span>
          <button className="lp-icon-btn" onClick={() => setViewDate((d) => addDays(d, 1))} aria-label="Jour suivant"><ChevronRight size={14} /></button>
          <label className="lp-widget-habit-quick-datepick-wrap" title="Choisir une date">
            <CalendarClock size={14} />
            <input type="date" className="lp-widget-habit-quick-datepick" value={viewDate} onChange={(e) => e.target.value && setViewDate(e.target.value)} aria-label="Choisir une date" />
          </label>
        </div>
      </div>

      {themes.map((theme) => (
        <HabitThemeGroup key={theme.id} theme={theme} allThemes={themes} date={viewDate} habitLog={habitLog} setHabitLog={setHabitLog} />
      ))}

      <div className="lp-widget-habit-quick-footer">
        {totalChecked === 0 ? "Aucune habitude validée" : totalChecked === 1 ? "1 habitude validée" : `${totalChecked} habitudes validées`} · {dateLabel === "Aujourd'hui" ? "aujourd'hui" : fmtShort(viewDate)}
      </div>
    </div>
  );
}

/* Widget « Heatmap habitudes » (#193) : un seul Thème affiché à la fois — la
   coloration vient des HABITUDES de ce thème (couleur individuelle, dégradé
   conique si plusieurs le même jour), jamais du thème lui-même, à la demande
   explicite de Quentin. Bascule Mensuel/Annuel dans le même widget, comme
   Échéances ou l'Organigramme — pas deux widgets séparés. */
const HABIT_HEATMAP_VIEWS = ["month", "year", "quarter"];
const HABIT_HEATMAP_MONTHS_FULL = ["Janvier", "Février", "Mars", "Avril", "Mai", "Juin", "Juillet", "Août", "Septembre", "Octobre", "Novembre", "Décembre"];
const HABIT_HEATMAP_DOW = ["L", "M", "M", "J", "V", "S", "D"];

// (#224) Grille annuelle : condense la taille des cases ET l'espacement pour
// tenir dans l'espace réellement disponible (mesuré par ResizeObserver, même
// idée que celui de l'Organigramme #219) au lieu d'une case fixe à 11px qui
// déborde (widget étroit) ou laisse du vide (widget large). `space` est la
// largeur (colonnes = semaines) ou la hauteur (lignes = repère de mois + 7
// jours) disponible pour `count` cases ; le résultat reste borné à
// [YEAR_CELL_MIN, YEAR_CELL_MAX] pour ne jamais devenir illisible ni énorme.
const YEAR_CELL_MIN = 5;
const YEAR_CELL_MAX = 15;
function fitYearGridMetrics(space, count) {
  if (!space || !count) return { cell: YEAR_CELL_MAX, gap: 3 };
  const solve = (gap) => Math.max(YEAR_CELL_MIN, Math.min(YEAR_CELL_MAX, (space - gap * (count - 1)) / count));
  let gap = 3;
  let cell = solve(gap);
  if (cell < 9) { gap = 2; cell = solve(gap); }
  if (cell <= YEAR_CELL_MIN + 0.5) { gap = 1; cell = solve(gap); }
  return { cell, gap };
}

// Fond d'une case vide : léger gris pour un week-end pas encore coché — à la
// demande explicite de Quentin, tant que rien n'y est posé — sinon la teinte
// habituelle. Jamais appliqué à une case qui porte une couleur.
function habitEmptyCellBg(day) {
  if (day.colors.length) return habitCellBackground(day.colors);
  return day.isWeekend ? "rgba(16,21,31,0.08)" : "var(--paper-soft)";
}

/* Pixel des habitudes (#353, maquette « mosaïque centrale ») : une habitude =
   un pixel. Trois jours — la veille, le jour affiché (au premier plan), le
   lendemain — et la semaine en bandeau. Au centre, chaque catégorie aligne
   ses habitudes, reliées chacune à SON pixel ; le pixel et la case sont deux
   commandes du MÊME état, écrit par les fonctions existantes du journal
   (toggleHabitLogEntry, setHabitLogValue, habitNumericStep) — jamais une
   logique de validation parallèle. « Non applicable » vit dans
   nexora:habitSkips (setHabitSkip). Dates civiles locales (iso/addDays). */
const HPX_HEAD_H = 36; // en-tête de catégorie (hauteur de la rangée de pixels)
const HPX_ROW_H = 24; // une ligne d'habitude
const HPX_PX = 28; // un pixel du jour affiché
const HPX_GAP = 10;
const HPX_PAD = 4; // marge intérieure de la rangée de pixels
const HPX_LEFT = 40; // retrait de la rangée de pixels après les lignes
const HPX_STATE_LABELS = { done: "validée", part: "quantité posée", todo: "à faire", na: "non applicable" };

function hpxDayLabel(date, todayIso) {
  if (date === todayIso) return "Aujourd'hui";
  if (date === addDays(todayIso, -1)) return "Hier";
  if (date === addDays(todayIso, 1)) return "Demain";
  const d = new Date(date + "T00:00:00");
  const s = d.toLocaleDateString("fr-FR", { weekday: "long" });
  return s.charAt(0).toUpperCase() + s.slice(1);
}
function hpxLongDate(date) {
  return new Date(date + "T00:00:00").toLocaleDateString("fr-FR", { weekday: "long", day: "numeric", month: "long" });
}
// Sous-titre d'un jour : date longue quand le titre est relatif (Hier,
// Aujourd'hui, Demain) ; sinon le titre porte déjà le jour de la semaine.
function hpxSubDate(date, todayIso) {
  const rel = [addDays(todayIso, -1), todayIso, addDays(todayIso, 1)].includes(date);
  return new Date(date + "T00:00:00").toLocaleDateString("fr-FR", rel ? { weekday: "long", day: "numeric", month: "long" } : { day: "numeric", month: "long", year: "numeric" });
}
function hpxWeekStart(date) {
  const d = new Date(date + "T00:00:00");
  return addDays(date, -((d.getDay() + 6) % 7));
}

function HabitPixel({ habit, st, size, future, focused, onClick, onHover, label }) {
  const state = st ? st.state : "todo";
  const max = Number.isFinite(habit.max) ? habit.max : 10;
  const fill = st && st.value !== null && habit.kind === "numeric" ? Math.round(habitValueIntensity(habit, st.value) * 100) : 0;
  const cls = "lp-hpx-px is-" + state + (future && state === "todo" ? " is-future" : "") + (focused ? " is-focus" : "");
  const style = { "--c": habit.color, "--fill": fill + "%", width: size, height: size };
  const inner = size < 20 ? null
    : state === "done" && habit.kind !== "numeric" ? <Check size={Math.round(size * 0.5)} strokeWidth={3} />
    : (state === "done" || state === "part") && habit.kind === "numeric" ? <span className="lp-hpx-px-val">{habitValueLabel(st.value)}/{habitValueLabel(max)}</span>
    : state === "na" ? <span className="lp-hpx-px-na">–</span> : null;
  if (!onClick) return <span className={cls} style={style} aria-hidden="true">{inner}</span>;
  return (
    <button
      type="button"
      className={cls}
      style={style}
      onClick={onClick}
      onMouseEnter={onHover ? () => onHover(habit.id) : undefined}
      onMouseLeave={onHover ? () => onHover(null) : undefined}
      onFocus={onHover ? () => onHover(habit.id) : undefined}
      onBlur={onHover ? () => onHover(null) : undefined}
      aria-label={label}
      aria-pressed={state === "done" || state === "part"}
      title={label}
    >{inner}</button>
  );
}

// Motif d'un jour en « carré journalier » (#353) : rangées complétées de
// cases grises vides, puis rangées vides, jusqu'au carré parfait.
function HabitPixelMosaic({ themes, day, date, todayIso, size = 8, gap = 2 }) {
  const n = habitPixelSquareSize(themes);
  const filler = (key) => <span key={key} className="lp-hpx-px is-filler" style={{ width: size, height: size }} aria-hidden="true" />;
  const rows = themes.map((t) => (
    <span key={t.id} className="lp-hpx-mosaic-row" style={{ gap }}>
      {t.habits.map((h) => <HabitPixel key={h.id} habit={h} st={day.habits[h.id]} size={size} future={date > todayIso} />)}
      {Array.from({ length: n - t.habits.length }, (_, i) => filler("f" + i))}
    </span>
  ));
  for (let r = themes.length; r < n; r++) {
    rows.push(<span key={"r" + r} className="lp-hpx-mosaic-row" style={{ gap }}>{Array.from({ length: n }, (_, i) => filler("f" + i))}</span>);
  }
  return (
    <span className="lp-hpx-mosaic" style={{ gap }} role="img" aria-label={`${day.done} habitudes validées sur ${day.total}`}>{rows}</span>
  );
}

function HabitPixelSide({ themes, date, day, todayIso, onSelect, collapsed }) {
  return (
    <section className="lp-hpx-side" aria-label={hpxDayLabel(date, todayIso) + " — " + hpxLongDate(date)}>
      <button type="button" className="lp-hpx-side-head" onClick={() => onSelect(date)} title="Afficher ce jour au premier plan">
        <span className="lp-hpx-side-title"><b>{hpxDayLabel(date, todayIso)}</b><span>{hpxSubDate(date, todayIso)}</span></span>
        <HabitPixelMosaic themes={themes} day={day} date={date} todayIso={todayIso} size={8} />
        <span className="lp-hpx-count"><b>{day.done}</b> / {day.total}</span>
      </button>
      {themes.map((t) => (
        <div key={t.id} className="lp-hpx-side-theme">
          <div className="lp-hpx-side-theme-head"><span className="lp-hpx-dot" style={{ background: t.color }} />{t.name}<span className="lp-hpx-muted">{day.themes[t.id].done} / {day.themes[t.id].total}</span></div>
          {!collapsed.has(t.id) && t.habits.map((h) => {
            const st = day.habits[h.id];
            return (
              <div key={h.id} className={"lp-hpx-side-row" + (st.state === "na" ? " is-na" : "")}>
                <HabitPixel habit={h} st={st} size={11} future={date > todayIso} />
                <span className="lp-hpx-side-name">{h.name}</span>
                <span className="lp-hpx-muted">{h.kind === "numeric" ? habitValueLabel(st.value) + " / " + habitValueLabel(h.max) : st.state === "done" ? "fait" : st.state === "na" ? "n/a" : ""}</span>
              </div>
            );
          })}
        </div>
      ))}
    </section>
  );
}

const HPX_VIEWS = [["day", "Jour"], ["week", "Semaine"], ["month", "Mois"]];
function hpxAddMonths(date, n) {
  const d = new Date(date + "T00:00:00");
  return iso(new Date(d.getFullYear(), d.getMonth() + n, 1));
}

/* Vue « Semaine » (#353) : les sept carrés journaliers côte à côte, en
   grand ; un clic ouvre le jour en vue Jour. */
function HabitPixelWeekView({ themes, week, stateOf, todayIso, onOpenDay }) {
  const n = habitPixelSquareSize(themes);
  const size = Math.max(8, Math.min(22, Math.floor(150 / n) - 2));
  return (
    <div className="lp-hpx-weekview">
      {week.map((d) => {
        const k = stateOf(d);
        const pct = k.total ? Math.round((k.done / k.total) * 100) : 0;
        return (
          <button key={d} type="button" className={"lp-hpx-weekview-day" + (d === todayIso ? " is-today" : "") + (d > todayIso ? " is-future" : "")} onClick={() => onOpenDay(d)} aria-label={`${hpxLongDate(d)} : ${k.done} sur ${k.total} — ouvrir le jour`}>
            <span className="lp-hpx-weekview-head">
              <b>{new Date(d + "T00:00:00").toLocaleDateString("fr-FR", { weekday: "long" })}</b>
              <span>{new Date(d + "T00:00:00").toLocaleDateString("fr-FR", { day: "numeric", month: "short" })}</span>
            </span>
            <HabitPixelMosaic themes={themes} day={k} date={d} todayIso={todayIso} size={size} gap={3} />
            <span className="lp-hpx-count"><b>{k.done}</b> / {k.total}</span>
            <span className="lp-hpx-weekview-bar" aria-hidden="true"><span style={{ width: pct + "%" }} /></span>
          </button>
        );
      })}
    </div>
  );
}

/* Vue « Mois » (#353) : calendrier du mois, un carré journalier par jour
   (semaines du lundi au dimanche ; jours hors du mois estompés). */
function HabitPixelMonthView({ themes, anchor, stateOf, todayIso, onOpenDay }) {
  const n = habitPixelSquareSize(themes);
  const size = Math.max(3, Math.min(8, Math.floor(64 / n) - 1));
  const first = anchor.slice(0, 7) + "-01";
  const start = hpxWeekStart(first);
  const nextMonth = hpxAddMonths(first, 1);
  const days = [];
  for (let d = start; d < nextMonth || days.length % 7; d = addDays(d, 1)) days.push(d);
  const month = first.slice(0, 7);
  return (
    <div className="lp-hpx-monthview">
      {["Lun.", "Mar.", "Mer.", "Jeu.", "Ven.", "Sam.", "Dim."].map((l) => <span key={l} className="lp-hpx-monthview-dow">{l}</span>)}
      {days.map((d) => {
        const k = stateOf(d);
        const out = d.slice(0, 7) !== month;
        return (
          <button key={d} type="button" className={"lp-hpx-monthview-day" + (out ? " is-out" : "") + (d === todayIso ? " is-today" : "")} onClick={() => onOpenDay(d)} aria-label={`${hpxLongDate(d)} : ${k.done} sur ${k.total} — ouvrir le jour`}>
            <span className="lp-hpx-monthview-num">{Number(d.slice(8, 10))}</span>
            <HabitPixelMosaic themes={themes} day={k} date={d} todayIso={todayIso} size={size} gap={1} />
            <span className="lp-hpx-muted">{k.done} / {k.total}</span>
          </button>
        );
      })}
    </div>
  );
}

function WidgetHabitPixel({ widget, ctx, habitLog, setHabitLog, habitSkips, setHabitSkips, externalToolbarSlot, onOpenHabitThemes, onUpdateWidget }) {
  const themes = useMemo(() => normalizeHabitThemes(ctx.habitThemes).filter((t) => t.habits.length > 0), [ctx.habitThemes]);
  const todayIso = iso(new Date());
  const [date, setDate] = useState(todayIso);
  const [hover, setHover] = useState(null);
  // Vue Jour / Semaine / Mois (#353), mémorisée sur le widget.
  const [view, setViewState] = useState(() => (HPX_VIEWS.some(([k]) => k === (widget && widget.habitPixelView)) ? widget.habitPixelView : "day"));
  const setView = (v) => { setViewState(v); if (onUpdateWidget) onUpdateWidget({ habitPixelView: v }); };
  const openDay = (d) => { setDate(d); setView("day"); };
  // Thèmes repliés (retour de test, #353) : mémorisés sur le widget
  // (widget.habitPixelCollapsed, identifiants de thèmes). Replié, un thème
  // garde son en-tête, son compteur et sa rangée de pixels (toujours
  // cliquables) ; ses lignes et liaisons disparaissent.
  const [collapsedList, setCollapsedList] = useState(() => (Array.isArray(widget && widget.habitPixelCollapsed) ? widget.habitPixelCollapsed.map(String) : []));
  useEffect(() => { setCollapsedList(Array.isArray(widget && widget.habitPixelCollapsed) ? widget.habitPixelCollapsed.map(String) : []); }, [widget && widget.habitPixelCollapsed]);
  const collapsed = useMemo(() => new Set(collapsedList), [collapsedList]);
  const saveCollapsed = (list) => { setCollapsedList(list); if (onUpdateWidget) onUpdateWidget({ habitPixelCollapsed: list }); };
  const toggleTheme = (id) => saveCollapsed(collapsed.has(id) ? collapsedList.filter((x) => x !== id) : [...collapsedList, id]);
  const allCollapsed = themes.length > 0 && themes.every((t) => collapsed.has(t.id));
  const prev = addDays(date, -1);
  const next = addDays(date, 1);
  const week = useMemo(() => { const s = hpxWeekStart(date); return [0, 1, 2, 3, 4, 5, 6].map((i) => addDays(s, i)); }, [date]);
  const stateOf = useMemo(() => {
    const cache = new Map();
    return (d) => {
      if (!cache.has(d)) cache.set(d, habitDayStates(ctx.habitThemes, habitLog, habitSkips, d));
      return cache.get(d);
    };
  }, [ctx.habitThemes, habitLog, habitSkips]);
  const day = stateOf(date);

  // Écritures : TOUJOURS le catalogue complet (voir HabitThemeGroup).
  const allThemes = ctx.habitThemes;
  const clearSkip = (habitId) => { if (setHabitSkips) setHabitSkips((p) => setHabitSkip(p, allThemes, habitId, date, false)); };
  const toggleCheck = (habit) => {
    if (!setHabitLog) return;
    clearSkip(habit.id);
    setHabitLog((p) => toggleHabitLogEntry(p, allThemes, habit.id, date));
  };
  const stepNumeric = (habit, delta) => {
    if (!setHabitLog) return;
    const v = day.habits[habit.id].value;
    const raw = habitNumericStep(habit, v === null ? NaN : v, delta);
    if (raw === null) return;
    clearSkip(habit.id);
    setHabitLog((p) => setHabitLogValue(p, allThemes, habit.id, date, raw));
  };
  // Clic sur le pixel d'une quantité : +1 ; au maximum, il repart à vide.
  const pixelClick = (habit) => {
    const st = day.habits[habit.id];
    if (st.state === "na") { clearSkip(habit.id); return; }
    if (habit.kind !== "numeric") { toggleCheck(habit); return; }
    if (st.value !== null && st.value >= habit.max) { setHabitLog((p) => setHabitLogValue(p, allThemes, habit.id, date, "")); return; }
    stepNumeric(habit, 1);
  };
  const toggleNa = (habit) => {
    if (!setHabitSkips) return;
    const on = day.habits[habit.id].state !== "na";
    setHabitSkips((p) => setHabitSkip(p, allThemes, habit.id, date, on));
    // Non applicable efface la validation du jour (une validation primerait).
    if (on && setHabitLog) setHabitLog((p) => setHabitLogValue(p, allThemes, habit.id, date, ""));
  };
  const onKeyDown = (e) => {
    if (e.target && /^(INPUT|SELECT|TEXTAREA)$/.test(e.target.tagName)) return;
    if (e.key === "ArrowLeft" && e.altKey) { e.preventDefault(); setDate(prev); }
    if (e.key === "ArrowRight" && e.altKey) { e.preventDefault(); setDate(next); }
  };
  const pixelLabel = (habit) => {
    const st = day.habits[habit.id];
    const v = habit.kind === "numeric" ? ` (${st.value === null ? 0 : habitValueLabel(st.value)} / ${habitValueLabel(habit.max)})` : "";
    return `${habit.name} — ${HPX_STATE_LABELS[st.state]}${v}. ${habit.kind === "numeric" ? "Clic : +1" : "Clic : valider / annuler"}`;
  };

  const toolbar = (
    <ViewToolbarPortal slot={externalToolbarSlot}>
      <span className="lp-density-row lp-hpx-views" role="group" aria-label="Vue">
        {HPX_VIEWS.map(([k, label]) => (
          <button key={k} type="button" className={"lp-density-btn" + (view === k ? " active" : "")} aria-pressed={view === k} onClick={() => setView(k)}>{label}</button>
        ))}
      </span>
      {view === "day" ? (
        <span className="lp-hpx-nav" role="group" aria-label="Jour affiché">
          <button type="button" className="lp-icon-btn" aria-label="Jour précédent" onClick={() => setDate(prev)}><ChevronLeft size={14} /></button>
          <button type="button" className="lp-hpx-nav-side" onClick={() => setDate(prev)}>{hpxDayLabel(prev, todayIso)}</button>
          <label className="lp-hpx-nav-current">
            {hpxDayLabel(date, todayIso)} · {hpxSubDate(date, todayIso)}
            <input type="date" value={date} onChange={(e) => e.target.value && setDate(e.target.value)} aria-label="Choisir un jour" />
          </label>
          <button type="button" className="lp-hpx-nav-side" onClick={() => setDate(next)}>{hpxDayLabel(next, todayIso)}</button>
          <button type="button" className="lp-icon-btn" aria-label="Jour suivant" onClick={() => setDate(next)}><ChevronRight size={14} /></button>
        </span>
      ) : (
        <span className="lp-hpx-nav" role="group" aria-label={view === "week" ? "Semaine affichée" : "Mois affiché"}>
          <button type="button" className="lp-icon-btn" aria-label={view === "week" ? "Semaine précédente" : "Mois précédent"} onClick={() => setDate(view === "week" ? addDays(date, -7) : hpxAddMonths(date, -1))}><ChevronLeft size={14} /></button>
          <label className="lp-hpx-nav-current">
            {view === "week"
              ? "Semaine du " + new Date(week[0] + "T00:00:00").toLocaleDateString("fr-FR", { day: "numeric", month: "long" })
              : (() => { const t = new Date(date + "T00:00:00").toLocaleDateString("fr-FR", { month: "long", year: "numeric" }); return t.charAt(0).toUpperCase() + t.slice(1); })()}
            <input type="date" value={date} onChange={(e) => e.target.value && setDate(e.target.value)} aria-label="Choisir une date" />
          </label>
          <button type="button" className="lp-icon-btn" aria-label={view === "week" ? "Semaine suivante" : "Mois suivant"} onClick={() => setDate(view === "week" ? addDays(date, 7) : hpxAddMonths(date, 1))}><ChevronRight size={14} /></button>
        </span>
      )}
      <button type="button" className="lp-tool-btn" disabled={date === todayIso} onClick={() => setDate(todayIso)}>Aujourd'hui</button>
      {/* Accès rapide, comme Quick Habit : Réglages → Thèmes d'habitudes
          (créer un thème, ajouter / renommer une habitude). Libellé explicite :
          l'engrenage de l'en-tête règle déjà le widget lui-même. */}
      {onOpenHabitThemes && (
        <button type="button" className="lp-tool-btn" onClick={onOpenHabitThemes} title="Réglages → Thèmes d'habitudes" aria-label="Créer ou modifier les thèmes et habitudes">
          <Settings size={13} /> Thèmes & habitudes
        </button>
      )}
      {view === "day" && themes.length > 1 && (
        <button type="button" className="lp-tool-btn" onClick={() => saveCollapsed(allCollapsed ? [] : themes.map((t) => t.id))} aria-label={allCollapsed ? "Déplier tous les thèmes" : "Replier tous les thèmes"}>
          {allCollapsed ? <ChevronsDown size={13} /> : <ChevronsUp size={13} />} {allCollapsed ? "Tout déplier" : "Tout replier"}
        </button>
      )}
    </ViewToolbarPortal>
  );

  if (!themes.length) {
    return (
      <>
        {toolbar}
        <div className="lp-widget-habit-empty">
          Aucune habitude configurée.
          {onOpenHabitThemes && <button type="button" className="lp-tool-btn" onClick={onOpenHabitThemes}>Configurer les thèmes d'habitudes</button>}
        </div>
      </>
    );
  }

  if (view === "week" || view === "month") {
    return (
      <div className="lp-hpx">
        {toolbar}
        {view === "week"
          ? <HabitPixelWeekView themes={themes} week={week} stateOf={stateOf} todayIso={todayIso} onOpenDay={openDay} />
          : <HabitPixelMonthView themes={themes} anchor={date} stateOf={stateOf} todayIso={todayIso} onOpenDay={openDay} />}
      </div>
    );
  }

  return (
    <div className="lp-hpx" onKeyDown={onKeyDown}>
      {toolbar}
      <div className="lp-hpx-days">
        <HabitPixelSide themes={themes} date={prev} day={stateOf(prev)} todayIso={todayIso} onSelect={setDate} collapsed={collapsed} />
        <section className="lp-hpx-main" aria-label={hpxDayLabel(date, todayIso) + " — " + hpxLongDate(date)}>
          <div className="lp-hpx-main-head">
            <div className="lp-hpx-main-title"><b>{hpxDayLabel(date, todayIso)}</b><span>{hpxSubDate(date, todayIso)}</span></div>
            <div className="lp-hpx-summary">
              <HabitPixelMosaic themes={themes} day={day} date={date} todayIso={todayIso} size={9} />
              <span className="lp-hpx-summary-text"><b>Le pixel du jour</b><span>1 habitude = 1 pixel · non applicables exclues</span></span>
              <span className="lp-hpx-count is-big" aria-live="polite"><b>{day.done}</b> / {day.total}</span>
            </div>
          </div>
          {themes.map((t) => {
            const tc = day.themes[t.id];
            const folded = collapsed.has(t.id);
            const blockH = HPX_HEAD_H + (folded ? 0 : t.habits.length * HPX_ROW_H);
            const pxX = (i) => HPX_LEFT + HPX_PAD + i * (HPX_PX + HPX_GAP) + HPX_PX / 2;
            const pxBottom = HPX_PAD * 2 + HPX_PX;
            return (
              <div key={t.id} className={"lp-hpx-theme" + (folded ? " is-folded" : "")} style={{ height: blockH, "--hpx-rows": folded ? 0 : t.habits.length }}>
                <div className="lp-hpx-list">
                  <button
                    type="button"
                    className="lp-hpx-theme-head"
                    style={{ height: HPX_HEAD_H }}
                    onClick={() => toggleTheme(t.id)}
                    aria-expanded={!folded}
                    title={folded ? "Déplier le thème" : "Replier le thème"}
                  >
                    <ChevronRight size={14} className="lp-hpx-theme-chevron" aria-hidden="true" />
                    <span className="lp-hpx-dot is-big" style={{ background: t.color }} />{t.name}<span className="lp-hpx-muted">{tc.done} / {tc.total}</span>
                    {folded && <span className="lp-hpx-muted lp-hpx-theme-hint">{t.habits.length} habitude{t.habits.length > 1 ? "s" : ""}</span>}
                  </button>
                  {!folded && t.habits.map((h) => {
                    const st = day.habits[h.id];
                    const active = hover === h.id;
                    return (
                      <div
                        key={h.id}
                        className={"lp-hpx-row" + (st.state === "na" ? " is-na" : "") + (active ? " is-focus" : "")}
                        style={{ height: HPX_ROW_H }}
                        onMouseEnter={() => setHover(h.id)}
                        onMouseLeave={() => setHover(null)}
                      >
                        <HabitPixel habit={h} st={st} size={16} future={date > todayIso} focused={active} onClick={() => pixelClick(h)} onHover={setHover} label={pixelLabel(h)} />
                        <span className="lp-hpx-row-name">{h.name}</span>
                        {st.state === "na" ? (
                          <button type="button" className="lp-hpx-na-chip" onClick={() => toggleNa(h)} aria-label={`${h.name} : non applicable — rendre applicable`}>Non applicable</button>
                        ) : h.kind === "numeric" ? (
                          <span className="lp-hpx-step">
                            <button type="button" onClick={() => stepNumeric(h, -1)} disabled={st.value === null} aria-label={`Diminuer ${h.name}`}>−</button>
                            <b>{habitValueLabel(st.value)} / {habitValueLabel(h.max)}</b>
                            <button type="button" onClick={() => stepNumeric(h, 1)} disabled={st.value !== null && st.value >= h.max} aria-label={`Augmenter ${h.name}`}>+</button>
                          </span>
                        ) : (
                          <button
                            type="button"
                            role="checkbox"
                            aria-checked={st.state === "done"}
                            aria-label={h.name}
                            className={"lp-hpx-check" + (st.state === "done" ? " is-on" : "")}
                            style={{ "--c": h.color }}
                            onClick={() => toggleCheck(h)}
                            onFocus={() => setHover(h.id)}
                            onBlur={() => setHover(null)}
                          >{st.state === "done" && <Check size={11} strokeWidth={3.2} />}</button>
                        )}
                        {st.state !== "na" && (
                          <button type="button" className="lp-hpx-na-btn" onClick={() => toggleNa(h)} aria-label={`Marquer ${h.name} non applicable ce jour`} title="Non applicable ce jour">n/a</button>
                        )}
                        <span className="lp-hpx-anchor" style={{ background: h.color }} aria-hidden="true" />
                      </div>
                    );
                  })}
                </div>
                <div className="lp-hpx-wires">
                  <svg className="lp-hpx-wires-svg" aria-hidden="true">
                    {!folded && t.habits.map((h, i) => {
                      const st = day.habits[h.id];
                      const on = st.state === "done" || st.state === "part";
                      return (
                        <path
                          key={h.id}
                          d={habitPixelWirePath(HPX_HEAD_H + i * HPX_ROW_H + HPX_ROW_H / 2, pxX(i), pxBottom + 4, 6)}
                          className={"lp-hpx-wire" + (on ? " is-on" : "") + (st.state === "na" ? " is-na" : "") + (hover === h.id ? " is-focus" : "")}
                          style={{ stroke: st.state === "na" ? undefined : h.color }}
                        />
                      );
                    })}
                  </svg>
                  <div className="lp-hpx-pixels" style={{ left: HPX_LEFT, padding: HPX_PAD, gap: HPX_GAP, "--tc": t.color }}>
                    {t.habits.map((h) => (
                      <HabitPixel key={h.id} habit={h} st={day.habits[h.id]} size={HPX_PX} future={date > todayIso} focused={hover === h.id} onClick={() => pixelClick(h)} onHover={setHover} label={pixelLabel(h)} />
                    ))}
                  </div>
                </div>
              </div>
            );
          })}
        </section>
        <HabitPixelSide themes={themes} date={next} day={stateOf(next)} todayIso={todayIso} onSelect={setDate} collapsed={collapsed} />
      </div>
      <div className="lp-hpx-week" role="group" aria-label="Semaine">
        {week.map((d) => {
          const k = stateOf(d);
          return (
            <button key={d} type="button" className={"lp-hpx-week-day" + (d === date ? " is-active" : "") + (d === todayIso ? " is-today" : "")} onClick={() => setDate(d)} aria-pressed={d === date} aria-label={`${hpxLongDate(d)} : ${k.done} sur ${k.total}`}>
              <HabitPixelMosaic themes={themes} day={k} date={d} todayIso={todayIso} size={6} />
              <span><b>{new Date(d + "T00:00:00").toLocaleDateString("fr-FR", { weekday: "short", day: "numeric" })}</b><span className="lp-hpx-muted">{k.done} / {k.total}</span></span>
            </button>
          );
        })}
      </div>
    </div>
  );
}

function WidgetHabitHeatmap({ widget, ctx, habitLog, setHabitLog, onUpdateWidget, selectedDate }) {
  const themes = useMemo(() => normalizeHabitThemes(ctx.habitThemes), [ctx.habitThemes]);
  const themeId = themes.some((t) => t.id === widget?.habitHeatmapThemeId) ? widget.habitHeatmapThemeId : (themes[0]?.id || "");
  const theme = habitThemeById(themes, themeId);
  const view = HABIT_HEATMAP_VIEWS.includes(widget?.habitHeatmapView) ? widget.habitHeatmapView : "month";
  const [monthOffset, setMonthOffset] = useState(0);
  const [quickDayModal, setQuickDayModal] = useState(null); // iso date | null
  const [themeMenuOpen, setThemeMenuOpen] = useState(false);
  // Légende cliquable (retour de test) : une habitude masquée sort du calcul
  // des couleurs des cases — jamais un second thème à part, juste le thème
  // affiché amputé de cette habitude — donc habitCellBackground redistribue
  // seul le dégradé conique sur les habitudes restantes, sans rien de plus à
  // écrire ici. Ids bruts (pas liés au thème affiché) : revenir sur un thème
  // ne réaffiche pas une habitude masquée ailleurs par erreur, mais aucune
  // collision possible, les ids sont uniques tous thèmes confondus.
  const [hiddenHabitIds, setHiddenHabitIds] = useState(() => new Set());
  const toggleHabitVisibility = (habitId) => setHiddenHabitIds((prev) => {
    const next = new Set(prev);
    if (next.has(habitId)) next.delete(habitId); else next.add(habitId);
    return next;
  });
  const rootRef = useRef(null);
  /* Glisser-peindre (#353) : en mode « Peindre », la légende choisit le
     pinceau (une habitude du thème affiché) et un glisser sur les jours pose
     — ou efface, si le premier jour touché l'avait déjà — cette habitude sur
     chaque jour traversé (paintHabitLogEntries). Jamais les jours futurs. */
  const [paintMode, setPaintMode] = useState(false);
  const [brushId, setBrushId] = useState(null);
  const strokeRef = useRef(null);
  const brush = theme ? (theme.habits.find((h) => h.id === brushId) || theme.habits[0] || null) : null;
  const paintTodayIso = iso(new Date());
  const endStroke = () => {
    const st = strokeRef.current;
    if (!st) return;
    window.removeEventListener("pointermove", st.move);
    window.removeEventListener("pointerup", st.up);
    window.removeEventListener("pointercancel", st.up);
    strokeRef.current = null;
  };
  useEffect(() => endStroke, []);
  const paintDates = (dates, on, habitId) => {
    if (setHabitLog) setHabitLog((prev) => paintHabitLogEntries(prev, ctx.habitThemes, habitId, dates, on));
  };
  const onPaintPointerDown = (e) => {
    if (!paintMode || !brush || !setHabitLog) return;
    if (e.button !== undefined && e.button !== 0) return;
    const cell = e.target && e.target.closest ? e.target.closest("[data-hdate]") : null;
    if (!cell) return;
    const date = cell.getAttribute("data-hdate");
    if (!date || date > paintTodayIso) return;
    e.preventDefault();
    endStroke();
    const has = normalizeHabitLog(habitLog).some((x) => x.habitId === brush.id && x.date === date);
    const stroke = { on: !has, habitId: brush.id, dates: new Set([date]) };
    stroke.move = (ev) => {
      const el = document.elementFromPoint(ev.clientX, ev.clientY);
      const c = el && el.closest ? el.closest("[data-hdate]") : null;
      if (!c || !rootRef.current || !rootRef.current.contains(c)) return;
      const d = c.getAttribute("data-hdate");
      if (!d || d > paintTodayIso || stroke.dates.has(d)) return;
      stroke.dates.add(d);
      paintDates([d], stroke.on, stroke.habitId);
    };
    stroke.up = () => endStroke();
    strokeRef.current = stroke;
    window.addEventListener("pointermove", stroke.move);
    window.addEventListener("pointerup", stroke.up);
    window.addEventListener("pointercancel", stroke.up);
    paintDates([date], stroke.on, stroke.habitId);
  };
  const paintAttr = (date, paintable) => (paintMode && paintable && date <= paintTodayIso ? date : undefined);
  // Espace réellement disponible pour la grille annuelle (#224) : mesuré sur
  // le conteneur `.lp-widget-habit-heatmap-year` lui-même (pas le widget
  // entier, qui inclut aussi l'en-tête et la légende) — largeur ET hauteur,
  // pour condenser la taille des cases/l'espacement dans les deux sens au
  // lieu de garder 11px fixes qui débordent ou laissent du vide.
  const yearRef = useRef(null);
  const [yearSize, setYearSize] = useState({ width: 0, height: 0 });
  useEffect(() => {
    const el = yearRef.current;
    if (!el || typeof ResizeObserver === "undefined") return undefined;
    const ro = new ResizeObserver(([entry]) => setYearSize({ width: entry.contentRect.width, height: entry.contentRect.height }));
    ro.observe(el);
    return () => ro.disconnect();
  }, [view]);

  const setThemeId = (id) => onUpdateWidget && onUpdateWidget({ habitHeatmapThemeId: id });
  const openDay = (dIso) => setQuickDayModal(dIso);

  const now = new Date();
  const base = new Date(now.getFullYear(), now.getMonth() + monthOffset, 1);
  const year = base.getFullYear();
  const month = base.getMonth();

  // Thème affiché amputé des habitudes masquées par la légende — jamais un
  // second calcul de couleurs, juste un theme.habits plus court : habitCellColors
  // (appelée par habitMonthDays/habitYearWeeks) n'en tient alors plus compte, et
  // habitCellBackground redistribue seul le dégradé conique sur ce qui reste.
  const visibleTheme = useMemo(
    () => (theme && hiddenHabitIds.size ? { ...theme, habits: theme.habits.filter((h) => !hiddenHabitIds.has(h.id)) } : theme),
    [theme, hiddenHabitIds]
  );

  const monthDays = useMemo(() => (visibleTheme && view === "month" ? habitMonthDays(visibleTheme, habitLog, year, month) : []), [visibleTheme, habitLog, year, month, view]);
  const yearWeeks = useMemo(() => (visibleTheme && view === "year" ? habitYearWeeks(visibleTheme, habitLog, now.getFullYear()) : []), [visibleTheme, habitLog, view]);
  // Une seule ligne de 53 semaines si la largeur disponible permet encore une
  // case lisible (≥ YEAR_CELL_MIN, comme le calendrier de contributions
  // GitHub) ; sinon repli sur deux blocs de ~6 mois empilés plutôt qu'une
  // ligne débordante. Tant que la mesure n'est pas encore arrivée
  // (yearSize.width === 0, premier rendu), on part du repli le plus sûr.
  const yearHalves = useMemo(() => {
    if (!yearWeeks.length) return [];
    const singleRowMinWidth = yearWeeks.length * YEAR_CELL_MIN + (yearWeeks.length - 1) * 1;
    if (yearSize.width >= singleRowMinWidth) return [yearWeeks];
    const half = Math.ceil(yearWeeks.length / 2);
    return [yearWeeks.slice(0, half), yearWeeks.slice(half)];
  }, [yearWeeks, yearSize.width]);
  // Taille de case + espacement condensés (#224) : le plus petit des deux
  // ajustements (largeur pour les colonnes/semaines, hauteur pour les 8
  // lignes — le repère de mois + 7 jours) tenant sur CHAQUE bloc affiché ;
  // deux blocs empilés se partagent la hauteur disponible (moins le gap
  // vertical entre eux).
  const yearCols = yearHalves[0] ? yearHalves[0].length : 0;
  const yearBlockHeight = yearHalves.length > 1 ? Math.max(0, (yearSize.height - 12) / 2) : yearSize.height;
  const yearMetrics = useMemo(() => {
    const byWidth = fitYearGridMetrics(yearSize.width, yearCols);
    const byHeight = fitYearGridMetrics(yearBlockHeight, 8);
    return { cell: Math.min(byWidth.cell, byHeight.cell), gap: Math.min(byWidth.gap, byHeight.gap) };
  }, [yearSize.width, yearCols, yearBlockHeight]);
  const quarterMonths = useMemo(() => {
    if (!visibleTheme || view !== "quarter") return [];
    return [0, -1, -2].map((offset) => {
      const d = new Date(now.getFullYear(), now.getMonth() + monthOffset + offset, 1);
      return { year: d.getFullYear(), month: d.getMonth(), days: habitMonthDays(visibleTheme, habitLog, d.getFullYear(), d.getMonth()) };
    });
  }, [visibleTheme, habitLog, monthOffset, view]);

  if (!themes.length) {
    return (
      <div className="lp-widget-habit-heatmap lp-widget-habit-empty">
        Aucun Thème d'habitude configuré. Ouvrez Réglages → Thèmes d'habitudes pour en créer un.
      </div>
    );
  }

  return (
    <div className={"lp-widget-habit-heatmap" + (paintMode ? " is-painting" : "")} ref={rootRef} onPointerDown={onPaintPointerDown}>
      <div className="lp-widget-habit-heatmap-head">
        {setHabitLog && theme && theme.habits.length > 0 && (
          <button
            type="button"
            className={"lp-tool-btn lp-widget-habit-heatmap-paint-btn" + (paintMode ? " active" : "")}
            aria-pressed={paintMode}
            onClick={() => setPaintMode((m) => !m)}
            title={paintMode ? "Quitter le mode peinture" : "Peindre : choisir une habitude dans la légende, puis glisser sur les jours"}
          >
            <Pencil size={12} /> {paintMode ? "Peindre : " + (brush ? brush.name : "") : "Peindre"}
          </button>
        )}
        <button
          type="button"
          className={"lp-icon-btn" + (themeMenuOpen ? " active" : "")}
          onClick={() => setThemeMenuOpen((o) => !o)}
          title={`Thème affiché : ${theme?.name || "—"}`}
          aria-label="Choisir le thème affiché"
        >
          <SlidersHorizontal size={13} />
        </button>
      </div>
      {themeMenuOpen && (
        <div className="lp-widget-habit-heatmap-themepop">
          <select
            className="lp-widget-habit-heatmap-theme-select"
            value={themeId}
            onChange={(e) => { setThemeId(e.target.value); setThemeMenuOpen(false); }}
            aria-label="Thème affiché"
            autoFocus
          >
            {themes.map((t) => <option key={t.id} value={t.id}>{t.name}</option>)}
          </select>
        </div>
      )}

      {(view === "month" || view === "quarter") && (
        <div className="lp-widget-habit-heatmap-monthnav">
          <span>{view === "month" ? `${HABIT_HEATMAP_MONTHS_FULL[month]} ${year}` : `${HABIT_HEATMAP_MONTHS_FULL[quarterMonths[2]?.month]} — ${HABIT_HEATMAP_MONTHS_FULL[month]} ${year}`}</span>
          <div>
            <button className="lp-icon-btn" onClick={() => setMonthOffset((m) => m - 1)} aria-label="Période précédente"><ChevronLeft size={13} /></button>
            <button className="lp-icon-btn" onClick={() => setMonthOffset((m) => m + 1)} aria-label="Période suivante"><ChevronRight size={13} /></button>
            {monthOffset !== 0 && <button className="lp-icon-btn" onClick={() => setMonthOffset(0)} title="Revenir à aujourd'hui"><RefreshCw size={11} /></button>}
          </div>
        </div>
      )}

      {view === "month" && (
        <>
          <div className="lp-widget-habit-heatmap-dow">
            {HABIT_HEATMAP_DOW.map((d, i) => <span key={i}>{d}</span>)}
          </div>
          <div className="lp-widget-habit-heatmap-grid">
            {monthDays.map((day) => (
              <div
                key={day.date}
                className={"lp-widget-habit-heatmap-cell" + (!day.inMonth ? " out" : "") + (day.isToday ? " today" : "") + (day.isFuture ? " future" : "") + (day.date === selectedDate ? " selected" : "")}
                style={{ background: habitEmptyCellBg(day) }}
                title={day.date}
                data-hdate={paintAttr(day.date, !day.isFuture)}
                onDoubleClick={() => openDay(day.date)}
              >
                <span className="lp-widget-habit-heatmap-daynum">{day.day}</span>
              </div>
            ))}
          </div>
        </>
      )}

      {view === "quarter" && (
        <div className="lp-widget-habit-heatmap-quarter">
          {quarterMonths.map((qm) => (
            <div className="lp-widget-habit-heatmap-quarter-month" key={qm.year + "-" + qm.month}>
              <div className="lp-widget-habit-heatmap-quarter-month-label">{HABIT_HEATMAP_MONTHS_FULL[qm.month]} {qm.year}</div>
              <div className="lp-widget-habit-heatmap-dow lp-widget-habit-heatmap-dow-mini">
                {HABIT_HEATMAP_DOW.map((d, i) => <span key={i}>{d}</span>)}
              </div>
              <div className="lp-widget-habit-heatmap-grid lp-widget-habit-heatmap-grid-mini">
                {qm.days.map((day) => (
                  <div
                    key={day.date}
                    className={"lp-widget-habit-heatmap-cell" + (!day.inMonth ? " out" : "") + (day.isToday ? " today" : "") + (day.isFuture ? " future" : "")}
                    style={{ background: habitEmptyCellBg(day) }}
                    title={day.date}
                    data-hdate={paintAttr(day.date, !day.isFuture)}
                    onDoubleClick={() => openDay(day.date)}
                  >
                    <span className="lp-widget-habit-heatmap-daynum">{day.day}</span>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      )}

      {view === "year" && (
        <div className="lp-widget-habit-heatmap-year" ref={yearRef}>
          {yearHalves.map((weeksHalf, hi) => (
            <div className="lp-widget-habit-heatmap-year-half" key={hi}>
              <div
                className="lp-widget-habit-heatmap-year-grid"
                style={{
                  gridTemplateColumns: `repeat(${weeksHalf.length}, ${yearMetrics.cell}px)`,
                  gridTemplateRows: `${Math.max(9, yearMetrics.cell + 1)}px repeat(7, ${yearMetrics.cell}px)`,
                  gap: `${yearMetrics.gap}px`,
                }}
              >
                {weeksHalf.map((w, wi) => (
                  w.monthLabel ? (
                    <span key={w.key + "-lbl"} className="lp-widget-habit-heatmap-year-label" style={{ gridColumn: wi + 1, gridRow: 1, fontSize: yearMetrics.cell < 9 ? "7.5px" : undefined }}>
                      {w.monthLabel}
                    </span>
                  ) : null
                ))}
                {weeksHalf.map((w, wi) => w.days.map((day, di) => (
                  <div
                    key={day.date + "-" + di}
                    className={"lp-widget-habit-heatmap-year-day" + (day.inYear && day.date === selectedDate ? " selected" : "")}
                    style={{
                      gridColumn: wi + 1,
                      gridRow: di + 2,
                      width: `${yearMetrics.cell}px`,
                      height: `${yearMetrics.cell}px`,
                      background: day.inYear ? habitEmptyCellBg(day) : "transparent",
                    }}
                    title={day.inYear ? day.date : undefined}
                    data-hdate={paintAttr(day.date, day.inYear)}
                    onDoubleClick={day.inYear ? () => openDay(day.date) : undefined}
                  />
                )))}
              </div>
            </div>
          ))}
        </div>
      )}

      {theme && theme.habits.length > 0 && (
        <div className="lp-widget-habit-heatmap-legend">
          {theme.habits.map((h) => {
            const hidden = hiddenHabitIds.has(h.id);
            // Mode peinture : la légende choisit le pinceau.
            if (paintMode) {
              const active = brush && brush.id === h.id;
              return (
                <button
                  type="button"
                  key={h.id}
                  className={"lp-widget-habit-heatmap-legend-item is-brush" + (active ? " is-active" : "")}
                  aria-pressed={Boolean(active)}
                  onClick={() => setBrushId(h.id)}
                  title={`Peindre avec ${h.name}`}
                >
                  <span className="lp-widget-habit-heatmap-legend-dot" style={{ background: h.color }} />
                  {h.name}
                </button>
              );
            }
            return (
              <button
                type="button"
                key={h.id}
                className={"lp-widget-habit-heatmap-legend-item" + (hidden ? " is-hidden" : "")}
                onClick={() => toggleHabitVisibility(h.id)}
                title={hidden ? `Réafficher ${h.name}` : `Masquer ${h.name}`}
              >
                <span className="lp-widget-habit-heatmap-legend-dot" style={{ background: h.color }} />
                {h.name}
              </button>
            );
          })}
        </div>
      )}

      {quickDayModal && (
        <HabitQuickDayModal date={quickDayModal} themes={themes} habitLog={habitLog} setHabitLog={setHabitLog} onClose={() => setQuickDayModal(null)} />
      )}
    </div>
  );
}

// Widget "Next Best Action" : détermine l'action la plus utile à réaliser
// maintenant parmi toutes les tâches éligibles, et explique pourquoi. Le moteur
// (getNextBestAction) est totalement séparé de ce composant, qui ne fait que
// l'afficher et gérer les interactions (§20 de la demande).
function WidgetNextBestAction({ tasks, ctx, onOpen, onStartTask }) {
  const [showWhy, setShowWhy] = useState(false);
  const [showAlternatives, setShowAlternatives] = useState(false);
  const { candidates, blocked } = useMemo(() => getNextBestAction({ tasks, ctx }), [tasks, ctx]);

  if (candidates.length === 0 && blocked.length === 0) {
    return (
      <div className="lp-widget-nba-empty">
        <CheckCircle2 size={22} color="var(--success)" />
        <div className="lp-widget-nba-empty-title">Tout est à jour</div>
        <div className="lp-widget-nba-empty-sub">Aucune action en attente ne requiert ton attention.</div>
      </div>
    );
  }
  if (candidates.length === 0) {
    return (
      <div className="lp-widget-nba-empty">
        <Lock size={22} color="var(--text-muted)" />
        <div className="lp-widget-nba-empty-title">Tout est bloqué</div>
        <div className="lp-widget-nba-empty-sub">{blocked.length} tâche{blocked.length > 1 ? "s" : ""} en attente d'une dépendance non terminée — aucune n'est exécutable dans l'immédiat.</div>
      </div>
    );
  }

  const top = candidates[0];
  if (top.totalScore < NBA_WEIGHTS.noHighImpactThreshold) {
    return (
      <div className="lp-widget-nba-empty">
        <Search size={20} color="var(--text-muted)" />
        <div className="lp-widget-nba-empty-title">Aucune action à fort impact</div>
        <div className="lp-widget-nba-empty-sub">Rien ne se distingue particulièrement pour l'instant parmi les {candidates.length} tâche{candidates.length > 1 ? "s" : ""} disponible{candidates.length > 1 ? "s" : ""}.</div>
      </div>
    );
  }

  const proj = ctx.projects.find((p) => p.id === top.task.projectId);
  const st = ctx.statuses.find((s) => s.id === top.task.statusId);
  const reasonIcon = (icon) => {
    if (icon === "late" || icon === "due") return <AlertTriangle size={11} />;
    if (icon === "block") return <Zap size={11} />;
    if (icon === "critical") return <Network size={11} />;
    if (icon === "milestone") return <Milestone size={11} />;
    if (icon === "quick") return <CheckCircle2 size={11} />;
    return null;
  };
  const impactLabel = top.totalScore >= 70 ? "HIGH IMPACT" : top.totalScore >= 40 ? "MEDIUM IMPACT" : "LOW IMPACT";
  const alternatives = candidates.slice(1, 5);

  return (
    <div className="lp-widget-nba">
      <div className="lp-widget-nba-card">
        <div className="lp-widget-nba-title" onClick={() => onOpen(top.task)}>{top.task.title}</div>
        <div className="lp-widget-nba-project">
          {proj && <span className="lp-project-dot" style={{ background: proj.color || "var(--text-muted)", width: 12, height: 12 }} />}
          {proj?.name}{st ? ` · ${st.name}` : ""}
        </div>
        <div className="lp-widget-nba-scorebar-row">
          <div className="lp-widget-nba-scorebar-track"><div className="lp-widget-nba-scorebar-fill" style={{ width: `${top.totalScore}%` }} /></div>
          <span className="lp-widget-nba-scoreval">{top.totalScore}</span>
        </div>
        <span className={"lp-widget-nba-impact-tag" + (top.totalScore >= 70 ? " high" : top.totalScore >= 40 ? " medium" : " low")}>{impactLabel}</span>
        <div className="lp-widget-nba-reasons">
          {top.reasons.map((r, i) => (
            <div className="lp-widget-nba-reason" key={i}>{reasonIcon(r.icon)} {r.text}</div>
          ))}
        </div>
        <div className="lp-widget-nba-effort">{top.effortDays > 0 ? `Estimation : ${top.effortDays} jour${top.effortDays > 1 ? "s" : ""}` : "Effort inconnu"}</div>
        <div className="lp-widget-nba-actions">
          <button className="lp-btn lp-btn-primary" onClick={() => { if (onStartTask) onStartTask(top.task); onOpen(top.task); }}>Commencer</button>
          <button className="lp-btn" onClick={() => setShowWhy((v) => !v)}>Pourquoi ?</button>
        </div>
        {showWhy && (
          <div className="lp-widget-nba-why">
            <div className="lp-widget-nba-why-title">Pourquoi cette tâche ?</div>
            {[
              ["Urgence", top.factors.urgency, 40],
              ["Impact sur les dépendances", top.factors.dependencyImpact, 55],
              ["Chemin critique", top.factors.criticalPathScore, 25],
              ["Impact jalon", top.factors.milestoneScore, 20],
              ["Priorité du projet", top.factors.projectImportanceScore, 15],
            ].map(([label, val, max]) => (
              <div className="lp-widget-nba-why-row" key={label}>
                <span className="lp-widget-nba-why-label">{label}</span>
                <div className="lp-widget-nba-why-track"><div className="lp-widget-nba-why-fill" style={{ width: `${max ? (val / max) * 100 : 0}%` }} /></div>
                <span className="lp-widget-nba-why-val">{val > 0 ? "+" : ""}{val}</span>
              </div>
            ))}
            {top.factors.effortPenalty > 0 && (
              <div className="lp-widget-nba-why-row">
                <span className="lp-widget-nba-why-label">Pénalité d'effort</span>
                <div className="lp-widget-nba-why-track"><div className="lp-widget-nba-why-fill lp-widget-nba-why-fill-neg" style={{ width: `${(top.factors.effortPenalty / 18) * 100}%` }} /></div>
                <span className="lp-widget-nba-why-val">−{top.factors.effortPenalty}</span>
              </div>
            )}
            <div className="lp-widget-nba-why-summary">
              {top.blockedCount > 0 && <div>{top.blockedCount} tâche{top.blockedCount > 1 ? "s dépendent" : " dépend"} de cette action.</div>}
              <div>Impact potentiel : {top.totalScore >= 70 ? "élevé" : top.totalScore >= 40 ? "moyen" : "faible"}.</div>
            </div>
          </div>
        )}
      </div>
      {alternatives.length > 0 && (
        <div className="lp-widget-nba-alts">
          <button className="lp-widget-nba-alts-toggle" onClick={() => setShowAlternatives((v) => !v)}>
            <ChevronRight size={12} style={{ transform: showAlternatives ? "rotate(90deg)" : "none" }} /> Autres actions recommandées
          </button>
          {showAlternatives && (
            <div className="lp-widget-nba-alts-list">
              {alternatives.map((c, i) => (
                <div className="lp-widget-nba-alt-row" key={c.task.id} onClick={() => onOpen(c.task)}>
                  <span className="lp-widget-nba-alt-rank">{i + 2}</span>
                  <span className="lp-widget-nba-alt-title">{c.task.title}</span>
                  <span className="lp-widget-nba-alt-score">{c.totalScore}</span>
                </div>
              ))}
            </div>
          )}
        </div>
      )}
    </div>
  );
}

// Widget "Daily Briefing" : synthèse opérationnelle du jour. Le moteur
// (getDailyBriefing) est séparé de l'affichage ; il réutilise directement le
// moteur Next Best Action sans dupliquer de logique de priorisation.
function WidgetDailyBriefing({ tasks, ctx, onOpen, onViewDay, activityLog, staffing }) {
  const [openAlert, setOpenAlert] = useState(null);
  const briefing = useMemo(() => getDailyBriefing({ tasks, ctx, activityLog, staffing }), [tasks, ctx, activityLog, staffing]);
  const dateLabel = new Date(briefing.date + "T00:00:00").toLocaleDateString("fr-FR", { weekday: "long", day: "numeric", month: "long" });

  const summaryText = {
    none: "Rien ne requiert d'attention immédiate aujourd'hui.",
    calm: "La journée s'annonce calme.",
    busy: "Journée chargée — plusieurs points à surveiller.",
    critical: "Attention requise sur plusieurs points aujourd'hui.",
  }[briefing.priorityLevel];

  return (
    <div className="lp-widget-briefing">
      <div className="lp-widget-briefing-date">{dateLabel}</div>
      <div className="lp-widget-briefing-summary">{summaryText}</div>

      {briefing.alerts.length > 0 && (
        <div className="lp-widget-briefing-alerts">
          {briefing.alerts.map((a) => (
            <div key={a.key}>
              <div className="lp-widget-briefing-alert" onClick={() => setOpenAlert((k) => (k === a.key ? null : a.key))}>
                <span>{a.icon} {a.label}</span>
                <ChevronRight size={12} style={{ transform: openAlert === a.key ? "rotate(90deg)" : "none" }} />
              </div>
              {openAlert === a.key && (
                <div className="lp-widget-briefing-alert-list">
                  {(a.tasks || []).slice(0, 8).map((t) => (
                    <div key={t.id} className="lp-widget-briefing-alert-item" onClick={() => onOpen(t)}>{t.title}</div>
                  ))}
                  {(a.projects || []).slice(0, 8).map((p) => (
                    <div key={p.id} className="lp-widget-briefing-alert-item" onClick={() => onOpen(null)}>
                      <span className="lp-project-dot" style={{ background: p.color || "var(--text-muted)", width: 10, height: 10, marginRight: 5 }} />{p.name}
                    </div>
                  ))}
                </div>
              )}
            </div>
          ))}
        </div>
      )}

      {briefing.todayItems.length > 0 && (
        <div className="lp-widget-briefing-section">
          <div className="lp-widget-briefing-section-title">Aujourd'hui</div>
          {briefing.todayItems.slice(0, 6).map((t) => {
            const proj = ctx.projects.find((p) => p.id === t.projectId);
            return (
              <div className="lp-widget-briefing-item" key={t.id} onClick={() => onOpen(t)}>
                {t.milestone ? <Milestone size={12} /> : <span className="lp-project-dot" style={{ background: proj?.color || "var(--text-muted)", width: 10, height: 10 }} />}
                <span className="lp-widget-briefing-item-title">{t.title}</span>
                {proj && <span className="lp-widget-briefing-item-proj">{proj.name}</span>}
              </div>
            );
          })}
        </div>
      )}

      {briefing.meetingsWithoutReport.length > 0 && (
        <div className="lp-widget-briefing-section">
          <div className="lp-widget-briefing-section-title">Réunions sans compte rendu (48 h)</div>
          {briefing.meetingsWithoutReport.slice(0, 6).map((t) => {
            const proj = ctx.projects.find((p) => p.id === t.projectId);
            return (
              <div className="lp-widget-briefing-item" key={t.id} onClick={() => onOpen(t)}>
                <span className="lp-project-dot" style={{ background: proj?.color || "var(--text-muted)", width: 10, height: 10 }} />
                <span className="lp-widget-briefing-item-title">{t.title}</span>
                {proj && <span className="lp-widget-briefing-item-proj">{proj.name}</span>}
              </div>
            );
          })}
        </div>
      )}

      {briefing.recentChanges.length > 0 && (
        <div className="lp-widget-briefing-section">
          <div className="lp-widget-briefing-section-title">Changements récents (24h)</div>
          {/* #139 : chaque entrée porte déjà taskId — la ligne agrégée
              ("3 tâches terminées") reste l'en-tête, et les tâches qu'elle
              résume sont maintenant listées dessous, cliquables une par une.
              Recherchée dans ctx.tasks (non filtré) : une tâche marquée
              terminée puis exclue par le filtre du widget doit rester
              ouvrable depuis son propre historique. */}
          {briefing.recentChanges.map((c) => (
            <div className="lp-widget-briefing-change" key={c.key}>
              <div className="lp-widget-briefing-change-summary">{c.icon} {c.text}</div>
              <div className="lp-widget-briefing-change-entries">
                {c.entries.map((e) => {
                  const task = (ctx.tasks || []).find((t) => t.id === e.taskId);
                  return (
                    <button
                      type="button"
                      key={e.id}
                      className="lp-widget-briefing-change-entry"
                      disabled={!task}
                      onClick={() => task && onOpen(task)}
                      title={task ? "Ouvrir la tâche" : "Tâche introuvable"}
                    >
                      {e.taskTitle || "Sans titre"}
                    </button>
                  );
                })}
              </div>
            </div>
          ))}
        </div>
      )}


      {briefing.nextBestAction && (
        <div className="lp-widget-briefing-nba">
          <div className="lp-widget-briefing-section-title"><Zap size={11} style={{ verticalAlign: -2 }} /> Next Best Action</div>
          <div className="lp-widget-briefing-nba-title" onClick={() => onOpen(briefing.nextBestAction.task)}>{briefing.nextBestAction.task.title}</div>
          {briefing.nextBestAction.reasons.slice(0, 2).map((r, i) => (
            <div key={i} className="lp-widget-briefing-nba-reason">→ {r.text}</div>
          ))}
        </div>
      )}

      {/* #170 : ce que la Charge personnel dit de demain — silencieux tant
          qu'aucune affectation n'y est posée pour demain (staffingTomorrow
          vaut alors null ou des listes vides), plutôt que d'annoncer un
          silence comme un fait. */}
      {briefing.staffingTomorrow && briefing.staffingTomorrow.workshopCounts.length > 0 && (
        <div className="lp-widget-briefing-section">
          <div className="lp-widget-briefing-section-title">Demain</div>
          <div className="lp-widget-briefing-change">
            {briefing.staffingTomorrow.workshopCounts.map((w, i) => (
              <React.Fragment key={w.id}>{i > 0 ? ", " : ""}{w.count} en {w.name}</React.Fragment>
            ))}
          </div>
          {briefing.staffingTomorrow.tasksForAbsent.length > 0 && (
            <div>
              <div className="lp-widget-briefing-change" onClick={() => setOpenAlert((k) => (k === "absentTasks" ? null : "absentTasks"))} style={{ cursor: "pointer" }}>
                ⚠ {briefing.staffingTomorrow.tasksForAbsent.length} tâche{briefing.staffingTomorrow.tasksForAbsent.length > 1 ? "s" : ""} assignée{briefing.staffingTomorrow.tasksForAbsent.length > 1 ? "s" : ""} à une personne absente
              </div>
              {openAlert === "absentTasks" && (
                <div className="lp-widget-briefing-alert-list">
                  {briefing.staffingTomorrow.tasksForAbsent.slice(0, 8).map((t) => (
                    <div key={t.id} className="lp-widget-briefing-alert-item" onClick={() => onOpen(t)}>{t.title} — {t.assignee}</div>
                  ))}
                </div>
              )}
            </div>
          )}
        </div>
      )}

      {onViewDay && (
        <button className="lp-btn" style={{ width: "100%" }} onClick={onViewDay}>Voir la journée</button>
      )}
    </div>
  );
}

// Mini radar : version compacte de la vue Radar (planning circulaire annuel) —
// chaque tâche devient un arc sur l'année, réparti sur quelques anneaux pour
// limiter les recouvrements, les jalons en losanges sur le pourtour. Survol
// pour le détail, clic pour ouvrir — même langage que les autres widgets.
// Widget "Domino Effect" : classe les tâches par effet d'entraînement réel
// (combien de travail elles débloquent), pas seulement par urgence — repose sur
// getDominoEffect, qui réutilise le même graphe de dépendances que Next Best
// Action. Reste lisible avec beaucoup de tâches grâce à un simple classement
// (plutôt qu'un graphe de nœuds, qui deviendrait illisible au-delà de
// quelques éléments) — la même liste sert de vue desktop et mobile.
/* Réglages d'affichage du Mini-Gantt — UN SEUL formulaire, servi à la fois par
   la fiche du widget et par les réglages de la vue pleine page.

   Les deux en portaient chacun leur copie, et elles avaient divergé : la vue
   ignorait l'inactivité et les champs personnalisés dans le regroupement, ne
   validait pas la fenêtre à dates fixes, et avait perdu en route toutes les
   explications de la fiche (#86). Un composant partagé rend la divergence
   impossible : un réglage ajouté ici apparaît des deux côtés.

   Contrat : `value` porte les MÊMES clés que le widget enregistré, `onChange`
   reçoit un correctif partiel de ces clés. La fiche du widget les range dans
   son état local jusqu'à l'enregistrement, la vue les écrit aussitôt dans ses
   préférences — le formulaire, lui, ne connaît que les clés. */
function MiniGanttDisplayFields({ value, onChange, ctx, scope }) {
  const fields = value.miniGanttFields || MINI_GANTT_DEFAULTS.miniGanttFields;
  const fieldsLayout = value.miniGanttFieldsLayout === "inline" ? "inline" : "aligned";
  const sortKey = normalizeMiniGanttSort(value.miniGanttSort);
  const sortDir = normalizeMiniGanttSortDir(value.miniGanttSortDir);
  const range = normalizeMiniGanttRange(value.miniGanttRange);
  const windowStart = value.miniGanttWindow?.start || "";
  const windowEnd = value.miniGanttWindow?.end || "";
  const windowError = miniGanttWindowMessage(range, windowStart, windowEnd);
  const colorBy = value.colorBy === "project" || value.colorBy === "taskType" ? value.colorBy : "status";
  const patchRange = (patch) => onChange({ miniGanttRange: normalizeMiniGanttRange({ ...range, ...patch }) });
  const patchWindow = (patch) => onChange({ miniGanttWindow: { start: windowStart, end: windowEnd, ...patch } });
  const toggleField = (key) => onChange({ miniGanttFields: fields.includes(key) ? fields.filter((f) => f !== key) : [...fields, key] });
  return (
    <>
      <p style={{ fontSize: 12, color: "var(--text-600)", marginTop: -6, marginBottom: 8 }}>Choisis un ou plusieurs projets ci-dessous — chaque tâche affiche le projet en label si plusieurs sont mélangés.</p>
      <div className="lp-field">
        <label>Grouper par <span style={{ fontWeight: 400, textTransform: "none", color: "var(--text-600)" }}>(sections repliables, qui distinguent visuellement les tâches)</span></label>
        <select value={value.groupBy || "none"} onChange={(e) => onChange({ groupBy: e.target.value })}>
          {miniGanttGroupByKeys(ctx).map((key) => (
            <option key={key} value={key}>{key === "none" ? "Aucun regroupement" : fieldLabel(key, ctx)}</option>
          ))}
        </select>
      </div>
      <label className="lp-checkbox-line">
        <input type="checkbox" checked={value.showMilestones !== false} onChange={(e) => onChange({ showMilestones: e.target.checked })} /> Afficher les jalons (avec leur émoji propre s'ils en ont un)
      </label>
      {/* #146 : activé par défaut dans la vue Gantt plein écran (une page dédiée
          en profite pleinement), désactivé par défaut dans un widget de tableau
          de bord (une tuile dense s'en passe le plus souvent) — `scope` porte
          exactement cette distinction. */}
      <label className="lp-checkbox-line">
        <input
          type="checkbox"
          checked={value.miniGanttShowDependencies !== undefined ? !!value.miniGanttShowDependencies : scope === "view"}
          onChange={(e) => onChange({ miniGanttShowDependencies: e.target.checked })}
        /> Flèches de dépendance (fin → début, en rouge si la tâche démarre avant que sa dépendance ne finisse)
      </label>
      {/* #166 : la checklist porte déjà une date par item (`item.end`, comme le
          Métro le dessine en bifurcations) — le Mini-Gantt l'ignorait
          entièrement. Une ligne fine, cochable, par item daté. */}
      <label className="lp-checkbox-line">
        <input
          type="checkbox"
          checked={!!value.miniGanttShowSubtasks}
          onChange={(e) => onChange({ miniGanttShowSubtasks: e.target.checked })}
        /> Sous-tâches datées (une ligne par item de checklist qui porte une date, cochable directement)
      </label>
      {/* Le trait vertical d'un jalon ne se règle PAS ici : c'est un choix
          propre à chaque repère, dans les Annotations, jalon par jalon (#95).
          Un réglage unique pour tout le diagramme imposait le trait sous tous
          les jalons ou sous aucun. */}
      <div className="lp-field" style={{ marginTop: 10 }}>
        <label>Couleur des barres</label>
        <div className="lp-density-row">
          <button type="button" className={"lp-density-btn" + (colorBy === "status" ? " active" : "")} onClick={() => onChange({ colorBy: "status" })}>Par statut</button>
          <button type="button" className={"lp-density-btn" + (colorBy === "project" ? " active" : "")} onClick={() => onChange({ colorBy: "project" })}>Par projet</button>
          <button type="button" className={"lp-density-btn" + (colorBy === "taskType" ? " active" : "")} onClick={() => onChange({ colorBy: "taskType" })}>Par type</button>
        </div>
      </div>
      <div className="lp-field" style={{ marginTop: 10 }}>
        <label>Informations affichées à côté de la barre</label>
        <p style={{ fontSize: 11.5, color: "var(--text-600)", marginTop: -2, marginBottom: 6 }}>Chaque champ garde la même mise en forme (pastille, badge, format de date…) que partout ailleurs dans Nexora.</p>
        {MINIGANTT_ROW_FIELD_OPTIONS.map((f) => (
          <label className="lp-checkbox-line" key={f}>
            <input type="checkbox" checked={fields.includes(f)} onChange={() => toggleField(f)} /> {fieldLabel(f, ctx)}
          </label>
        ))}
      </div>
      <div className="lp-field" style={{ marginTop: 10 }}>
        <label>Disposition de ces informations</label>
        <div className="lp-density-row">
          <button type="button" className={"lp-density-btn" + (fieldsLayout === "aligned" ? " active" : "")} onClick={() => onChange({ miniGanttFieldsLayout: "aligned" })}>Alignées à droite</button>
          <button type="button" className={"lp-density-btn" + (fieldsLayout === "inline" ? " active" : "")} onClick={() => onChange({ miniGanttFieldsLayout: "inline" })}>À la suite de la barre</button>
        </div>
      </div>
      <div className="lp-field" style={{ marginTop: 10 }}>
        <label>Ordre des lignes</label>
        <div className="lp-density-row">
          {MINIGANTT_SORT_KEYS.map((k) => (
            <button key={k} type="button" className={"lp-density-btn" + (sortKey === k ? " active" : "")} onClick={() => onChange({ miniGanttSort: k })}>
              {MINIGANTT_SORT_LABELS[k]}
            </button>
          ))}
        </div>
        <div className="lp-density-row" style={{ marginTop: 6 }}>
          <button type="button" className={"lp-density-btn" + (sortDir === "asc" ? " active" : "")} onClick={() => onChange({ miniGanttSortDir: "asc" })}>Croissant</button>
          <button type="button" className={"lp-density-btn" + (sortDir === "desc" ? " active" : "")} onClick={() => onChange({ miniGanttSortDir: "desc" })}>Décroissant</button>
        </div>
        <p style={{ fontSize: 11.5, color: "var(--text-600)", marginTop: 6, marginBottom: 0 }}>
          À position égale dans le tri, les jalons passent devant les barres — quel que soit le sens.
        </p>
      </div>
      <div className="lp-field" style={{ marginTop: 10 }}>
        <label>Étendue temporelle</label>
        <div className="lp-density-row">
          <button type="button" className={"lp-density-btn" + (range.mode === "auto" ? " active" : "")} onClick={() => patchRange({ mode: "auto" })}>Automatique</button>
          <button type="button" className={"lp-density-btn" + (range.mode === "rolling" ? " active" : "")} onClick={() => patchRange({ mode: "rolling" })}>Fenêtre glissante</button>
          <button type="button" className={"lp-density-btn" + (range.mode === "fixed" ? " active" : "")} onClick={() => patchRange({ mode: "fixed" })}>Dates fixes</button>
        </div>
        {range.mode === "auto" && (
          <>
            <label className="lp-checkbox-line" style={{ marginTop: 8 }}>
              <input type="checkbox" checked={range.includeToday} onChange={(e) => patchRange({ includeToday: e.target.checked })} />
              {" "}Toujours inclure la ligne « Aujourd'hui »
            </label>
            <p style={{ fontSize: 11.5, color: "var(--text-600)", marginTop: 6, marginBottom: 0 }}>
              L'axe couvre exactement l'étendue des tâches affichées. Décoché, un diagramme entièrement passé ou entièrement futur se cadre sur ses tâches et perd son repère du jour.
            </p>
          </>
        )}
        {range.mode === "rolling" && (
          <>
            <div className="lp-row2" style={{ marginTop: 8 }}>
              <div className="lp-field">
                <label>Mois avant aujourd'hui</label>
                <input type="number" min="0" max={MINIGANTT_RANGE_MAX_MONTHS} value={range.beforeMonths} onChange={(e) => patchRange({ beforeMonths: e.target.value })} />
              </div>
              <div className="lp-field">
                <label>Mois après aujourd'hui</label>
                <input type="number" min="0" max={MINIGANTT_RANGE_MAX_MONTHS} value={range.afterMonths} onChange={(e) => patchRange({ afterMonths: e.target.value })} />
              </div>
            </div>
            <p style={{ fontSize: 11.5, color: "var(--text-600)", marginTop: 6, marginBottom: 0 }}>
              L'axe suit le calendrier : la fenêtre avance toute seule jour après jour. Une tâche hors fenêtre n'est pas dessinée.
            </p>
          </>
        )}
        {range.mode === "fixed" && (
          <>
            <div className="lp-row2" style={{ marginTop: 8 }}>
              <div className="lp-field">
                <label>Du</label>
                <input type="date" value={windowStart} onChange={(e) => patchWindow({ start: e.target.value })} />
              </div>
              <div className="lp-field">
                <label>Au</label>
                <input type="date" value={windowEnd} min={windowStart || undefined} onChange={(e) => patchWindow({ end: e.target.value })} />
              </div>
            </div>
            {windowError && <p className="lp-gantt-annot-error">{windowError}</p>}
            <p style={{ fontSize: 11.5, color: "var(--text-600)", marginTop: 6, marginBottom: 0 }}>
              L'axe ne bouge plus. Les boutons − / Auto / + de la barre d'outils relâchent ce cadrage.
            </p>
          </>
        )}
      </div>
      <div className="lp-field" style={{ marginTop: 10 }}>
        <label>Mode d'affichage</label>
        <div className="lp-density-row">
          <button type="button" className={"lp-density-btn" + (value.miniGanttComparisonEnabled ? "" : " active")} onClick={() => onChange({ miniGanttComparisonEnabled: false })}>Standard</button>
          <button type="button" className={"lp-density-btn" + (value.miniGanttComparisonEnabled ? " active" : "")} onClick={() => onChange({ miniGanttComparisonEnabled: true })}>Comparaison</button>
        </div>
        <p style={{ fontSize: 11.5, color: "var(--text-600)", marginTop: 6, marginBottom: 0 }}>
          En mode Comparaison, les tâches dont la fiche porte des dates de référence affichent la période initiale en arrière-plan, la période actuelle au premier plan, et l'écart en jours. Les autres gardent le rendu standard.
          {scope === "view" ? " Ce réglage est propre à la vue Gantt et se retient d'une session à l'autre." : " Ce réglage est propre à ce widget et suit sa duplication."}
        </p>
      </div>
    </>
  );
}


/* Réglages d'affichage du widget « Bulles » (#92) — UN SEUL formulaire, comme
   `MiniGanttDisplayFields` dont il est le pendant (la leçon de #86 : deux
   copies d'un formulaire divergent toujours). Contrat identique : `value`
   porte les MÊMES clés que le widget enregistré, `onChange` reçoit un
   correctif partiel de ces clés.

   Tout ce qui concerne le CADRAGE — étendue temporelle, fenêtre à dates fixes,
   ordre des lignes — passe par les normalisateurs du Mini-Gantt, sans copie :
   c'est le même axe, ce sont donc les mêmes réglages, et un widget qui change
   de type les garde. */
/* Réglages du widget « Charge personnel » (#124).

   La SÉLECTION DE PERSONNES est propre au widget, et c'est le point : deux
   widgets côte à côte suivent deux équipes différentes. Aucune personne cochée
   veut dire « tout le monde » — et non « personne », qui ferait d'un widget
   neuf une grille vide sans rien expliquer. */
function StaffingDisplayFields({ value, onChange, ctx }) {
  const cfg = normalizeStaffingWidget(value);
  const [newMember, setNewMember] = useState("");
  const team = (ctx.teamMembers || [])
    .filter((m) => m && String(m.name || "").trim())
    .map((m) => ({ name: String(m.name).trim(), color: m.color || "" }));
  const toggleMember = (name) => {
    const on = cfg.staffingMembers.includes(name);
    onChange({ staffingMembers: on ? cfg.staffingMembers.filter((n) => n !== name) : [...cfg.staffingMembers, name] });
  };
  /* Une personne AJOUTÉE À LA MAIN n'entre pas dans l'annuaire (#124) : un
     intérimaire, un sous-traitant, quelqu'un qui n'a pas de compte. L'inscrire
     dans Réglages › Utilisateurs pour le planifier reviendrait à lui ouvrir
     Nexora. */
  const [newColor, setNewColor] = useState(STAFFING_COLOR_CHOICES[0]);
  const addMember = () => {
    const name = newMember.trim();
    if (!name) return;
    onChange({ staffingExtraMembers: [...cfg.staffingExtraMembers, { name, color: newColor }] });
    setNewMember("");
  };
  const removeMember = (name) => onChange({
    staffingExtraMembers: cfg.staffingExtraMembers.filter((m) => m.name !== name),
  });
  /* Recolorer quelqu'un ne touche QUE sa couleur : le nom est la cle de ses
     affectations, et le reecrire ici les detacherait de leur personne. */
  const recolorMember = (name, color) => onChange({
    staffingExtraMembers: cfg.staffingExtraMembers.map((m) => (m.name === name ? { ...m, color } : m)),
  });
  return (
    <>
      <div className="lp-field" style={{ marginTop: 10 }}>
        <label>Granularité par défaut</label>
        <div className="lp-density-row">
          {STAFFING_RANGES.map((r) => (
            <button
              key={r}
              type="button"
              className={"lp-density-btn" + (cfg.staffingRange === r ? " active" : "")}
              onClick={() => onChange({ staffingRange: r, staffingOffset: 0 })}
            >
              {staffingRangeLabel(r)}
            </button>
          ))}
        </div>
        <p style={{ fontSize: 11.5, color: "var(--text-600)", marginTop: 6, marginBottom: 0 }}>
          La navigation se fait ensuite période par période depuis le widget, et son bouton « Aujourd'hui » y revient.
        </p>
        {cfg.staffingRange === "custom" && (
          <>
            <div style={{ display: "flex", gap: 6, marginTop: 8 }}>
              <label style={{ flex: "1 1 0", minWidth: 0, display: "flex", flexDirection: "column", gap: 3 }}>
                <span style={{ fontSize: 11, fontWeight: 700, color: "var(--text-600)" }}>Début</span>
                <input type="date" value={cfg.staffingStart} onChange={(e) => onChange({ staffingStart: e.target.value, staffingOffset: 0 })} />
              </label>
              <label style={{ flex: "1 1 0", minWidth: 0, display: "flex", flexDirection: "column", gap: 3 }}>
                <span style={{ fontSize: 11, fontWeight: 700, color: "var(--text-600)" }}>Fin</span>
                <input type="date" value={cfg.staffingEnd} onChange={(e) => onChange({ staffingEnd: e.target.value, staffingOffset: 0 })} />
              </label>
            </div>
            <p style={{ fontSize: 11.5, color: "var(--text-600)", marginTop: 6, marginBottom: 0 }}>
              {!cfg.staffingStart || !cfg.staffingEnd
                ? "Tant que l’une des deux dates manque, le widget montre le mois en cours."
                : "Les flèches font ensuite glisser la plage de sa propre durée. Au-delà de " + STAFFING_CUSTOM_MAX_DAYS + " jours, elle est ramenée à cette longueur : les colonnes tomberaient sous le pixel."}
            </p>
          </>
        )}
      </div>

      <div className="lp-field" style={{ marginTop: 10 }}>
        <label>Personnes affichées</label>
        <p style={{ fontSize: 11.5, color: "var(--text-600)", marginTop: -2, marginBottom: 6 }}>
          {cfg.staffingMembers.length === 0
            ? "Aucune coche : personne n’est affiché. Coche les personnes à suivre, ou ajoute-en à la main plus bas."
            : `${cfg.staffingMembers.length} personne${cfg.staffingMembers.length > 1 ? "s" : ""} sur ${team.length}.`}
        </p>
        {/* #215 : filtre rapide par dossier d'équipes — coche d'un coup toutes
            les personnes dont au moins une équipe appartient au dossier choisi,
            sans changer les autres coches déjà faites. */}
        {(ctx.teamFolders || []).length > 0 && (
          <select
            style={{ marginBottom: 8, width: "100%" }}
            value=""
            onChange={(e) => {
              const folderId = e.target.value;
              if (!folderId) return;
              const folderTeamIds = new Set(normalizeTeams(ctx.teams).filter((t) => t.folderId === folderId).map((t) => t.id));
              const namesInFolder = (ctx.teamMembers || [])
                .filter((m) => memberTeamIds(m).some((id) => folderTeamIds.has(id)))
                .map((m) => m.name);
              onChange({ staffingMembers: Array.from(new Set([...cfg.staffingMembers, ...namesInFolder])) });
            }}
          >
            <option value="">Filtrer par dossier d'équipes…</option>
            {sortedByName(ctx.teamFolders).map((f) => <option key={f.id} value={f.id}>{f.name}</option>)}
          </select>
        )}
        {team.length === 0 && (
          <p style={{ fontSize: 11.5, color: "var(--text-600)", margin: 0 }}>
            Aucun utilisateur : ajoute des personnes dans Réglages › Utilisateurs.
          </p>
        )}
        {team.map((member) => (
          <label className="lp-checkbox-line" key={member.name}>
            <input
              type="checkbox"
              checked={cfg.staffingMembers.includes(member.name)}
              onChange={() => toggleMember(member.name)}
            /> {member.name}
          </label>
        ))}
        {team.length > 0 && (
          <button
            type="button"
            className="lp-btn lp-btn-mini"
            style={{ marginTop: 6 }}
            onClick={() => onChange({ staffingMembers: cfg.staffingMembers.length === team.length ? [] : team.map((m) => m.name) })}
          >
            {cfg.staffingMembers.length === team.length ? "Tout décocher" : "Tout cocher"}
          </button>
        )}
      </div>

      <div className="lp-field" style={{ marginTop: 10 }}>
        <label>Personnes ajoutées à la main</label>
        <p style={{ fontSize: 11.5, color: "var(--text-600)", marginTop: -2, marginBottom: 6 }}>
          Quelqu'un qui n'a pas de compte Nexora — intérimaire, sous-traitant, renfort. Ces personnes
          n'existent que dans ce widget, et l'inscrire dans Réglages › Utilisateurs reviendrait à lui
          ouvrir l'application.
        </p>
        {cfg.staffingExtraMembers.map((person) => (
          <div className="lp-cp-person-row" key={person.name}>
            <div className="lp-manage-item" style={{ flex: "1 1 auto", minWidth: 0 }}>
              <span
                className="lp-workshop-swatch"
                style={{ background: person.color || staffingMemberColor(person.name), borderRadius: "50%" }}
                aria-hidden="true"
              />
              <span className="lp-manage-name">{person.name}</span>
              <button className="lp-icon-btn" onClick={() => removeMember(person.name)} aria-label={"Retirer " + person.name}>
                <Trash2 size={15} />
              </button>
            </div>
            <div className="lp-cp-draft-colors">
              {STAFFING_COLOR_CHOICES.map((c) => (
                <button
                  key={c}
                  type="button"
                  className={"lp-cp-swatch" + ((person.color || staffingMemberColor(person.name)) === c ? " is-on" : "")}
                  style={{ background: c }}
                  aria-label={"Couleur " + c + " pour " + person.name}
                  aria-pressed={(person.color || staffingMemberColor(person.name)) === c}
                  onClick={() => recolorMember(person.name, c)}
                />
              ))}
            </div>
          </div>
        ))}
        <div style={{ display: "flex", gap: 6, marginTop: 6 }}>
          <input
            type="text"
            value={newMember}
            onChange={(e) => setNewMember(e.target.value)}
            onKeyDown={(e) => { if (e.key === "Enter") { e.preventDefault(); addMember(); } }}
            placeholder="Ex. Intérim — Sofiane"
            aria-label="Nom de la personne à ajouter"
            style={{ flex: "1 1 auto", minWidth: 0 }}
          />
          <button type="button" className="lp-btn" onClick={addMember} disabled={!newMember.trim()}>Ajouter</button>
        </div>
        <div className="lp-cp-draft-colors" style={{ marginTop: 6 }}>
          {STAFFING_COLOR_CHOICES.map((c) => (
            <button
              key={c}
              type="button"
              className={"lp-cp-swatch" + (newColor === c ? " is-on" : "")}
              style={{ background: c }}
              aria-label={"Couleur " + c + " pour la personne à ajouter"}
              aria-pressed={newColor === c}
              onClick={() => setNewColor(c)}
            />
          ))}
        </div>
      </div>

      <div className="lp-field" style={{ marginTop: 10 }}>
        <label>Affichage</label>
        <label className="lp-checkbox-line">
          <input type="checkbox" checked={cfg.staffingShowWeekends} onChange={(e) => onChange({ staffingShowWeekends: e.target.checked })} /> Afficher les week-ends
        </label>
        <label className="lp-checkbox-line">
          <input type="checkbox" checked={cfg.staffingShowLoad} onChange={(e) => onChange({ staffingShowLoad: e.target.checked })} /> Colonne « Postes » à droite
        </label>
        <label className="lp-checkbox-line">
          <input type="checkbox" checked={cfg.staffingShowTasks} onChange={(e) => onChange({ staffingShowTasks: e.target.checked })} /> Couche « Tâches » (nombre de tâches actives par personne et par jour)
        </label>
        <p style={{ fontSize: 11.5, color: "var(--text-600)", marginTop: 6, marginBottom: 0 }}>
          Un week-end masqué reste affectable depuis une autre granularité : la case disparaît de la vue, jamais l'affectation. La couche « Tâches » est en lecture seule — elle ne modifie jamais les affectations (#124).
        </p>
      </div>
    </>
  );
}

function BubblesDisplayFields({ value, onChange, ctx }) {
  const cfg = normalizeBubblesWidget(value || {});
  const sortKey = normalizeMiniGanttSort(value.miniGanttSort);
  const sortDir = normalizeMiniGanttSortDir(value.miniGanttSortDir);
  const range = normalizeMiniGanttRange(value.miniGanttRange);
  const windowStart = value.miniGanttWindow?.start || "";
  const windowEnd = value.miniGanttWindow?.end || "";
  const windowError = miniGanttWindowMessage(range, windowStart, windowEnd);
  const patchRange = (patch) => onChange({ miniGanttRange: normalizeMiniGanttRange({ ...range, ...patch }) });
  const patchWindow = (patch) => onChange({ miniGanttWindow: { start: windowStart, end: windowEnd, ...patch } });
  const toggleField = (key) => onChange({
    bubbleFields: cfg.bubbleFields.includes(key)
      ? cfg.bubbleFields.filter((f) => f !== key)
      : [...cfg.bubbleFields, key],
  });
  return (
    <>
      <p style={{ fontSize: 12, color: "var(--text-600)", marginTop: -6, marginBottom: 8 }}>
        Chaque tâche devient une bulle posée sur l'axe du temps, à sa date et à sa durée. Les champs cochés plus bas se rangent sous la bulle.
      </p>
      <div className="lp-field">
        <label>Grouper par <span style={{ fontWeight: 400, textTransform: "none", color: "var(--text-600)" }}>(sections repliables, qui séparent visuellement les bulles)</span></label>
        <select value={value.groupBy || "none"} onChange={(e) => onChange({ groupBy: e.target.value })}>
          {miniGanttGroupByKeys(ctx).map((key) => (
            <option key={key} value={key}>{key === "none" ? "Aucun regroupement" : fieldLabel(key, ctx)}</option>
          ))}
        </select>
      </div>
      <div className="lp-field">
        <label>Colorer par <span style={{ fontWeight: 400, textTransform: "none", color: "var(--text-600)" }}>(indépendant du regroupement)</span></label>
        <select value={cfg.bubbleColorBy} onChange={(e) => onChange({ bubbleColorBy: e.target.value })}>
          {miniGanttGroupByKeys(ctx).filter((key) => key !== "none").map((key) => (
            <option key={key} value={key}>{fieldLabel(key, ctx)}</option>
          ))}
        </select>
        <p style={{ fontSize: 11.5, color: "var(--text-600)", marginTop: 4, marginBottom: 0 }}>
          La bulle prend la couleur de sa valeur — celle du statut, du projet, du type ou de la criticité. Un champ dont les valeurs n'ont pas de couleur à elles (responsable, période…) reçoit une teinte stable, la même partout pour la même valeur.
        </p>
      </div>
      <label className="lp-checkbox-line">
        <input type="checkbox" checked={cfg.bubbleShowLegend} onChange={(e) => onChange({ bubbleShowLegend: e.target.checked })} /> Afficher la légende des couleurs (cliquer un rang met son groupe en avant)
      </label>
      <label className="lp-checkbox-line">
        <input type="checkbox" checked={cfg.bubbleTruncateTitles} onChange={(e) => onChange({ bubbleTruncateTitles: e.target.checked })} /> Tronquer les titres
      </label>
      <p style={{ fontSize: 11.5, color: "var(--text-600)", marginTop: -2, marginBottom: 8 }}>
        {cfg.bubbleTruncateTitles
          ? "Un titre trop long est coupé à deux lignes — une seule en hauteur compacte. Décoche pour l’afficher en entier : les bulles gagnent alors la hauteur nécessaire."
          : "Les titres s’affichent en entier, sur autant de lignes qu’il faut. Toutes les lignes prennent la hauteur du titre le plus long, pour que la grille ne se lise pas en escalier."}
      </p>
      <label className="lp-checkbox-line">
        <input type="checkbox" checked={value.showMilestones !== false} onChange={(e) => onChange({ showMilestones: e.target.checked })} /> Afficher les jalons (bulle compacte centrée sur leur date, avec leur icône propre)
      </label>
      <div className="lp-field" style={{ marginTop: 10 }}>
        <label>Dans la bulle</label>
        <label className="lp-checkbox-line">
          <input type="checkbox" checked={cfg.bubbleShowProgress} onChange={(e) => onChange({ bubbleShowProgress: e.target.checked })} /> Statut et avancement en pied de bulle
        </label>
        <label className="lp-checkbox-line">
          <input type="checkbox" checked={cfg.bubbleShowDescription} onChange={(e) => onChange({ bubbleShowDescription: e.target.checked })} /> Description de la tâche
        </label>
        {/* Réglage sans objet tant que la description n'est pas affichée : il
            n'apparaît qu'alors, plutôt que d'occuper le formulaire pour rien. */}
        {cfg.bubbleShowDescription && (
          <div className="lp-field" style={{ marginTop: 6, marginBottom: 2 }}>
            <label>Lignes de description</label>
            <div className="lp-density-row">
              {[1, 2, 3].map((n) => (
                <button
                  key={n}
                  type="button"
                  className={"lp-density-btn" + (cfg.bubbleDescriptionLines === n ? " active" : "")}
                  onClick={() => onChange({ bubbleDescriptionLines: n })}
                >
                  {n} ligne{n > 1 ? "s" : ""}
                </button>
              ))}
            </div>
            <p style={{ fontSize: 11.5, color: "var(--text-600)", marginTop: 6, marginBottom: 0 }}>
              La bulle gagne la hauteur des lignes demandées : le statut et l'avancement en pied restent visibles.
            </p>
          </div>
        )}
        <label className="lp-checkbox-line">
          <input type="checkbox" checked={cfg.bubbleShowDates} onChange={(e) => onChange({ bubbleShowDates: e.target.checked })} /> Dates de début et de fin aux extrémités
        </label>
      </div>
      <div className="lp-field" style={{ marginTop: 10 }}>
        <label>Hauteur des bulles</label>
        <div className="lp-density-row">
          {BUBBLE_SIZES.map((size) => (
            <button
              key={size}
              type="button"
              className={"lp-density-btn" + (cfg.bubbleSize === size ? " active" : "")}
              onClick={() => onChange({ bubbleSize: size })}
            >
              {size === "compact" ? "Compacte" : size === "large" ? "Haute" : "Normale"}
            </button>
          ))}
        </div>
      </div>
      <div className="lp-field" style={{ marginTop: 10 }}>
        <label>Champs affichés</label>
        <p style={{ fontSize: 11.5, color: "var(--text-600)", marginTop: -2, marginBottom: 6 }}>
          Chaque champ garde la même mise en forme (pastille, badge, format de date…) que partout ailleurs dans Nexora. Un champ vide ne laisse pas de trou.
        </p>
        {BUBBLE_ROW_FIELD_OPTIONS.map((f) => (
          <label className="lp-checkbox-line" key={f}>
            <input type="checkbox" checked={cfg.bubbleFields.includes(f)} onChange={() => toggleField(f)} /> {fieldLabel(f, ctx)}
          </label>
        ))}
      </div>
      <div className="lp-field" style={{ marginTop: 10 }}>
        <label>Disposition de ces champs</label>
        <div className="lp-density-row">
          <button type="button" className={"lp-density-btn" + (cfg.bubbleFieldsLayout === "compact" ? " active" : "")} onClick={() => onChange({ bubbleFieldsLayout: "compact" })}>Condensée, rattachée</button>
          <button type="button" className={"lp-density-btn" + (cfg.bubbleFieldsLayout === "under" ? " active" : "")} onClick={() => onChange({ bubbleFieldsLayout: "under" })}>Sous la bulle</button>
          <button type="button" className={"lp-density-btn" + (cfg.bubbleFieldsLayout === "inline" ? " active" : "")} onClick={() => onChange({ bubbleFieldsLayout: "inline" })}>À la suite de la bulle</button>
        </div>
        <p style={{ fontSize: 11.5, color: "var(--text-600)", marginTop: 6, marginBottom: 0 }}>
          {bubbleEffectiveFieldsLayout(cfg) === "compact" && cfg.bubbleFieldsLayout !== "compact"
            ? "En couloirs, les champs prennent la forme condensée : c'est la seule qui ne déborde pas sur la bulle voisine."
            : "Condensée : une seule ligne collée sous la bulle, à sa largeur exacte, valeurs séparées par un point médian."}
        </p>
      </div>
      <div className="lp-field" style={{ marginTop: 10 }}>
        <label>Disposition des bulles</label>
        <div className="lp-density-row">
          <button type="button" className={"lp-density-btn" + (cfg.bubbleLayout === "lanes" ? " active" : "")} onClick={() => onChange({ bubbleLayout: "lanes" })}>Côte à côte (couloirs)</button>
          <button type="button" className={"lp-density-btn" + (cfg.bubbleLayout === "rows" ? " active" : "")} onClick={() => onChange({ bubbleLayout: "rows" })}>Une tâche, une ligne</button>
        </div>
        <p style={{ fontSize: 11.5, color: "var(--text-600)", marginTop: 6, marginBottom: 0 }}>
          En couloirs, les bulles d'un même regroupement se rangent au maximum côte à côte sur la ligne de temps ; on ne descend d'une ligne que lorsque deux d'entre elles se chevauchent.
        </p>
      </div>
      <div className="lp-field" style={{ marginTop: 10 }}>
        <label>Ordre des lignes</label>
        <div className="lp-density-row">
          {MINIGANTT_SORT_KEYS.map((k) => (
            <button key={k} type="button" className={"lp-density-btn" + (sortKey === k ? " active" : "")} onClick={() => onChange({ miniGanttSort: k })}>
              {MINIGANTT_SORT_LABELS[k]}
            </button>
          ))}
        </div>
        <div className="lp-density-row" style={{ marginTop: 6 }}>
          <button type="button" className={"lp-density-btn" + (sortDir === "asc" ? " active" : "")} onClick={() => onChange({ miniGanttSortDir: "asc" })}>Croissant</button>
          <button type="button" className={"lp-density-btn" + (sortDir === "desc" ? " active" : "")} onClick={() => onChange({ miniGanttSortDir: "desc" })}>Décroissant</button>
        </div>
      </div>
      <div className="lp-field" style={{ marginTop: 10 }}>
        <label>Étendue temporelle</label>
        <div className="lp-density-row">
          <button type="button" className={"lp-density-btn" + (range.mode === "auto" ? " active" : "")} onClick={() => patchRange({ mode: "auto" })}>Automatique</button>
          <button type="button" className={"lp-density-btn" + (range.mode === "rolling" ? " active" : "")} onClick={() => patchRange({ mode: "rolling" })}>Fenêtre glissante</button>
          <button type="button" className={"lp-density-btn" + (range.mode === "fixed" ? " active" : "")} onClick={() => patchRange({ mode: "fixed" })}>Dates fixes</button>
        </div>
        {range.mode === "auto" && (
          <label className="lp-checkbox-line" style={{ marginTop: 8 }}>
            <input type="checkbox" checked={range.includeToday} onChange={(e) => patchRange({ includeToday: e.target.checked })} />
            {" "}Toujours inclure la ligne « Aujourd'hui »
          </label>
        )}
        {range.mode === "rolling" && (
          <div className="lp-row2" style={{ marginTop: 8 }}>
            <div className="lp-field">
              <label>Mois avant aujourd'hui</label>
              <input type="number" min="0" max={MINIGANTT_RANGE_MAX_MONTHS} value={range.beforeMonths} onChange={(e) => patchRange({ beforeMonths: e.target.value })} />
            </div>
            <div className="lp-field">
              <label>Mois après aujourd'hui</label>
              <input type="number" min="0" max={MINIGANTT_RANGE_MAX_MONTHS} value={range.afterMonths} onChange={(e) => patchRange({ afterMonths: e.target.value })} />
            </div>
          </div>
        )}
        {range.mode === "fixed" && (
          <div className="lp-row2" style={{ marginTop: 8 }}>
            <div className="lp-field">
              <label>Du</label>
              <input type="date" value={windowStart} onChange={(e) => patchWindow({ start: e.target.value })} />
            </div>
            <div className="lp-field">
              <label>Au</label>
              <input type="date" value={windowEnd} min={windowStart || undefined} onChange={(e) => patchWindow({ end: e.target.value })} />
            </div>
          </div>
        )}
        {windowError && <p className="lp-gantt-annot-error">{windowError}</p>}
      </div>
    </>
  );
}

/* Éditeur des macro-bulles. Plusieurs par widget, chacune avec son libellé, sa
   couleur, son habillage et sa multisélection de tâches AVEC RECHERCHE —
   `GanttTaskMultiSelect`, la liste déjà utilisée par les encadrés du Gantt :
   elle groupe par projet, compte les tâches retenues et signale celles qui ont
   disparu. La réécrire aurait donné une seconde ergonomie pour le même geste. */
function BubbleMacrosEditor({ macros, tasks, ctx, onChange }) {
  const list = normalizeBubbleMacros(macros);
  const [open, setOpen] = useState(false);
  const [editingId, setEditingId] = useState(null);
  const [pendingDelete, setPendingDelete] = useState(null);
  const knownTaskIds = useMemo(() => new Set(tasks.map((t) => t.id)), [tasks]);

  const patchMacro = (id, values) => onChange(list.map((m) => (m.id === id ? { ...m, ...values } : m)));
  const move = (id, dir) => {
    const i = list.findIndex((m) => m.id === id);
    const j = i + dir;
    if (i < 0 || j < 0 || j >= list.length) return;
    const next = [...list];
    [next[i], next[j]] = [next[j], next[i]];
    onChange(next);
  };
  const add = () => {
    const created = {
      id: uid(), label: "Nouvelle macro-bulle", color: BUBBLE_MACRO_DEFAULT_COLOR,
      opacity: BUBBLE_MACRO_DEFAULT_OPACITY, borderStyle: "solid",
      borderWidth: BUBBLE_MACRO_DEFAULT_BORDER_WIDTH, taskIds: [], showProgress: true,
    };
    onChange([...list, created]);
    setOpen(true);
    setEditingId(created.id);
  };
  const duplicate = (macro) => {
    const copy = { ...macro, id: uid(), label: `${macro.label} (copie)` };
    const i = list.findIndex((m) => m.id === macro.id);
    onChange([...list.slice(0, i + 1), copy, ...list.slice(i + 1)]);
    setEditingId(copy.id);
  };

  return (
    <>
      <MiniGanttListSection
        icon={<Layers size={13} />} title="Macro-bulles" count={list.length}
        hint="Une enveloppe colorée autour des bulles de plusieurs tâches : une phase, un lot, un chantier. Elle vit dans ce widget et ne modifie aucune tâche. L'ordre ci-dessous est celui de l'imbrication et du regroupement des lignes."
        open={open} onToggle={() => setOpen((o) => !o)} onAdd={add} addLabel="Ajouter une macro-bulle"
      >
        {list.map((macro) => {
          const check = validateBubbleMacro(macro);
          const missing = macro.taskIds.filter((id) => !knownTaskIds.has(id));
          return (
            <MiniGanttAnnotationRow
              key={macro.id} item={macro} list={list} editing={editingId === macro.id}
              onToggleEdit={() => setEditingId(editingId === macro.id ? null : macro.id)}
              onMove={(dir) => move(macro.id, dir)}
              onDuplicate={() => duplicate(macro)}
              onDelete={() => setPendingDelete(macro)}
              warning={!check.ok}
              swatch={<span className="lp-bubble-macro-swatch" style={{ background: bubbleMacroFill(macro), borderColor: macro.color }} />}
              title={macro.label || "Sans libellé"}
              subtitle={macro.taskIds.length === 0
                ? "aucune tâche — non dessinée"
                : `${macro.taskIds.length} tâche${macro.taskIds.length > 1 ? "s" : ""}${missing.length ? ` · ${missing.length} introuvable${missing.length > 1 ? "s" : ""}` : ""}`}
            >
              <div className="lp-field">
                <label>Libellé</label>
                <input type="text" value={macro.label} onChange={(e) => patchMacro(macro.id, { label: e.target.value })} placeholder="Phase essais, Lot 1, Marche probatoire…" />
              </div>
              {!check.ok && <p className="lp-gantt-annot-error">{check.error}</p>}
              <div className="lp-field">
                <label>Couleur</label>
                <ColorPicker value={macro.color} onChange={(color) => patchMacro(macro.id, { color })} />
              </div>
              <GanttBlockOpacityRow
                block={{ ...macro, kind: "phase" }}
                onChange={(values) => patchMacro(macro.id, values)}
              />
              <GanttAnnotationBorderRow value={macro.borderStyle} onChange={(borderStyle) => patchMacro(macro.id, { borderStyle })} />
              <GanttBlockBorderWidthRow block={macro} onChange={(values) => patchMacro(macro.id, values)} />
              <label className="lp-checkbox-line">
                <input type="checkbox" checked={macro.showProgress !== false} onChange={(e) => patchMacro(macro.id, { showProgress: e.target.checked })} /> Afficher l'avancement agrégé (moyenne pondérée par la durée)
              </label>
              <GanttTaskMultiSelect
                tasks={tasks} ctx={ctx} value={macro.taskIds}
                onChange={(taskIds) => patchMacro(macro.id, { taskIds })}
                label="Tâches rattachées"
                hint="Les tâches non successives produisent plusieurs enveloppes."
              />
            </MiniGanttAnnotationRow>
          );
        })}
      </MiniGanttListSection>
      {pendingDelete && (
        <ConfirmModal
          title="Supprimer cette macro-bulle ?"
          message={`« ${pendingDelete.label || "Sans libellé"} » ne sera plus dessinée. Les tâches qu'elle rassemblait ne changent pas.`}
          confirmLabel="Supprimer"
          onConfirm={() => { onChange(list.filter((m) => m.id !== pendingDelete.id)); setPendingDelete(null); }}
          onClose={() => setPendingDelete(null)}
        />
      )}
    </>
  );
}
/* Vue principale : elle adapte uniquement la persistance de vue au contrat du
   widget. Toute la préparation temporelle et le rendu restent dans
   WidgetMiniGantt, ce qui interdit un second moteur Gantt. */
function MiniGanttViewSettings({ prefs, setPrefs, tasks, ctx, onClose }) {
  const annotations = ganttAnnotationsOf(prefs);
  // Même règle que la modale du widget : une tâche-jalon n'a qu'une date de
  // fin, l'exiger des deux côtés vidait les sélecteurs (#94).
  const datedTasks = (tasks || []).filter((task) => task.start || task.end);
  const defaultStart = datedTasks.reduce((value, task) => (task.start && task.start < value ? task.start : value), iso(new Date()));
  const defaultEnd = datedTasks.reduce((value, task) => (task.end && task.end > value ? task.end : value), iso(new Date()));
  const patchAnnotations = (patch) => setPrefs({ ganttAnnotations: { ...annotations, ...patch } });
  return (
    <Modal title="Réglages de la vue Gantt" onClose={onClose} wide footer={<button className="lp-btn lp-btn-primary" onClick={onClose}>Terminé</button>}>
      {/* Exactement le formulaire de la fiche du widget — mêmes réglages, mêmes
          libellés, mêmes explications, même validation des dates fixes : c'est
          LE MÊME composant, pas une copie qui pourrait s'en écarter (#86). */}
      <div className="lp-widget-config-section">
        <div className="lp-widget-config-title"><Settings size={12} /> Affichage</div>
        <MiniGanttDisplayFields value={prefs} onChange={setPrefs} ctx={ctx} scope="view" />
      </div>
      {/* Le filtre du widget, à l'identique : c'est le même composant de
          formulaire, donc les mêmes champs et les mêmes règles. Il resserre ce
          que la page laisse passer, il ne s'y substitue pas. */}
      <div className="lp-widget-config-section">
        <div className="lp-widget-config-title"><Search size={12} /> Filtrer les tâches prises en compte</div>
        <TaskFilterFields
          filter={{ ...widgetDefaultFilter(), ...(prefs.filter || {}) }}
          setFilter={(next) => setPrefs({ filter: typeof next === "function" ? next({ ...widgetDefaultFilter(), ...(prefs.filter || {}) }) : next })}
          ctx={ctx}
        />
      </div>
      <div className="lp-widget-config-section"><div className="lp-widget-config-title"><StickyNote size={12} /> Annotations</div>
        <p style={{ fontSize: 12, color: "var(--text-600)", marginTop: -6, marginBottom: 8 }}>
          Les annotations ci-dessous sont enregistrées avec la vue Gantt : elles la suivent d'une session à l'autre, sans jamais modifier les tâches.
        </p>
        <MiniGanttAnnotationsEditor blocks={annotations.temporalBlocks || []} frames={annotations.highlightFrames || []} milestones={annotations.milestones || []} risks={collectTaskDelayRisks(tasks || [])} notes={annotations.notes || []} spans={annotations.spans || []} allowSpans tasks={datedTasks} ctx={ctx} defaultStart={defaultStart} defaultEnd={defaultEnd} onChange={patchAnnotations} /></div>
    </Modal>
  );
}

function MiniGanttView({ tasks, ctx, onOpen, setTasks, prefs, setPrefs, metaBlocks, toolbarSlot, pushToast, taskBaselines }) {
  const widget = normalizeMiniGanttViewPrefs(prefs);
  const [settingsOpen, setSettingsOpen] = useState(false);
  /* Le filtre de la vue s'applique EN PLUS de ceux de la page, jamais à leur
     place : `tasks` arrive déjà filtré par la page, on ne fait que resserrer. */
  const scoped = useMemo(
    () => (widget.filter ? applyWidgetFilter(tasks || [], widget.filter, ctx) : (tasks || [])),
    [tasks, widget.filter, ctx]
  );
  return (
    <section className="lp-minigantt-view" aria-label="Gantt">
      <WidgetMiniGantt
        widget={widget}
        tasks={scoped}
        ctx={ctx}
        /* La vue occupe la page : elle montre TOUT ce que les filtres laissent
           passer, sans le plafond des tuiles de tableau de bord (#115). */
        showAllRows
        groupBy={widget.groupBy}
        onOpen={onOpen}
        onUpdateWidget={(patch) => setPrefs(patch)}
        onUpdateTask={(taskId, patch) => setTasks((prev) => prev.map((task) => task.id === taskId ? { ...task, ...patch, lastInteraction: new Date().toISOString() } : task))}
        metaBlocks={metaBlocks || []}
        toolbarSlot={toolbarSlot}
        onOpenSettings={() => setSettingsOpen(true)}
        pushToast={pushToast}
        taskBaselines={taskBaselines}
      />
      {settingsOpen && <MiniGanttViewSettings prefs={widget} setPrefs={setPrefs} tasks={scoped} ctx={ctx} onClose={() => setSettingsOpen(false)} />}
    </section>
  );
}

// Widget "Chemin critique" — regroupe par projet, puis affiche chaque niveau
// du chemin (computeCriticalLevels, déjà utilisé par la vue Planning Projets
// complète) sous forme de chaîne verticale ; plusieurs tâches dans un même
// niveau = branches parallèles à égalité, affichées côte à côte.
function WidgetCriticalPath({ tasks, ctx, onOpen }) {
  const byProject = useMemo(() => {
    const groups = new Map();
    tasks.filter((t) => t.start && t.end).forEach((t) => {
      if (!groups.has(t.projectId)) groups.set(t.projectId, []);
      groups.get(t.projectId).push(t);
    });
    return [...groups.entries()]
      .map(([projectId, projTasks]) => ({ project: ctx.projects.find((p) => p.id === projectId), levels: computeCriticalLevels(projTasks) }))
      .filter((g) => g.levels.length > 0);
  }, [tasks, ctx]);

  if (byProject.length === 0) return <div className="lp-empty" style={{ padding: 16 }}>Aucun chemin critique détecté — nécessite des tâches liées par des dépendances.</div>;

  return (
    <div className="lp-widget-critpath">
      {byProject.map(({ project, levels }) => (
        <div key={project?.id || "none"}>
          <div className="lp-widget-critpath-project">
            <span className="lp-project-dot" style={{ background: project?.color || "var(--text-muted)", width: 14, height: 14, fontSize: 8 }}><IconGlyph icon={project?.icon} size={8} /></span>
            {project?.name || "Sans projet"}
          </div>
          {levels.map((levelTasks, i) => {
            const isLast = i === levels.length - 1;
            const isBranch = levelTasks.length > 1;
            return (
              <div className={"lp-widget-critpath-level" + (isBranch ? " lp-widget-critpath-level-branch" : "")} key={i}>
                {isBranch && <div className="lp-widget-critpath-branch-label"><GitBranch size={10} /> {levelTasks.length} tâches en parallèle</div>}
                <div className="lp-widget-critpath-branch-row">
                  {levelTasks.map((t) => {
                    const done = isTaskDoneGlobal(t, ctx);
                    return (
                      <div className="lp-widget-critpath-step" key={t.id} onClick={() => onOpen(t)}>
                        <div className="lp-widget-critpath-rail">
                          <div className={"lp-widget-critpath-dot" + (done ? " done" : "")} />
                          {!isLast && <div className="lp-widget-critpath-line" />}
                        </div>
                        <div className="lp-widget-critpath-info">
                          <div className="lp-widget-critpath-title">
                            {t.milestone && <MilestoneTypeGlyph types={ctx.milestoneTypes} type={t.milestoneTypeId} icon={resolveMilestoneIcon(t, ctx)} size={11} style={{ marginRight: 3, verticalAlign: -2 }} />}
                            {t.title}
                          </div>
                          <div className="lp-widget-critpath-dates">{t.milestone ? fmtShort(t.end) : `${fmtShort(t.start)} → ${fmtShort(t.end)}`}</div>
                        </div>
                      </div>
                    );
                  })}
                </div>
              </div>
            );
          })}
        </div>
      ))}
    </div>
  );
}


// #140 : « Tâches bloquantes » classait les mêmes bloqueurs que Domino Effect,
// par un score plus simple — le nombre de tâches bloquées DIRECTEMENT. Plutôt
// que deux widgets, Domino Effect gagne ce tri en alternative au sien (impact
// total, pondéré par cascade/chemin critique/échéance) ; l'ancien widget est
// migré à la lecture vers celui-ci en sélectionnant ce tri.
function WidgetDominoEffect({ widget, tasks, ctx, onOpen }) {
  const [expandedId, setExpandedId] = useState(null);
  const results = useMemo(() => getDominoEffect({ tasks, ctx }), [tasks, ctx]);
  const sorted = useMemo(() => {
    if (widget?.dominoSortBy !== "directImpact") return results;
    return [...results].sort((a, b) => b.directImpact - a.directImpact || b.totalImpact - a.totalImpact || a.task.id.localeCompare(b.task.id));
  }, [results, widget?.dominoSortBy]);
  const top = sorted.slice(0, 8);

  if (results.length === 0) {
    return (
      <div className="lp-widget-domino-empty">
        <GitBranch size={20} color="var(--text-muted)" />
        <div className="lp-widget-domino-empty-title">Aucune chaîne de dépendances</div>
        <div className="lp-widget-domino-empty-sub">Ce filtre ne contient aucune tâche qui en bloque une autre pour l'instant.</div>
      </div>
    );
  }

  return (
    <div className="lp-widget-domino">
      <div className="lp-widget-domino-sub">See what is blocking the most work</div>
      {top.map((r, i) => {
        const t = r.task;
        const proj = ctx.projects.find((p) => p.id === t.projectId);
        const st = ctx.statuses.find((s) => s.id === t.statusId);
        const expanded = expandedId === t.id;
        return (
          <div className="lp-widget-domino-item" key={t.id}>
            <div className="lp-widget-domino-row" onClick={() => setExpandedId(expanded ? null : t.id)}>
              <span className="lp-widget-domino-rank">{i + 1}</span>
              <div className="lp-widget-domino-info">
                <div className="lp-widget-domino-title">
                  {proj && <span className="lp-project-dot" style={{ background: proj.color || "var(--text-muted)", width: 10, height: 10 }} />}
                  {t.title}
                </div>
                <div className="lp-widget-domino-meta">
                  {r.directImpact} directe{r.directImpact > 1 ? "s" : ""}{r.indirectImpact > 0 ? ` · ${r.indirectImpact} en cascade` : ""}
                  {r.onCriticalPath && " · chemin critique"}
                </div>
              </div>
              <span className="lp-widget-domino-count">{r.totalImpact}</span>
              <ChevronRight size={13} style={{ transform: expanded ? "rotate(90deg)" : "none", flex: "0 0 auto", color: "var(--text-600)" }} />
            </div>
            {expanded && (
              <div className="lp-widget-domino-detail">
                <div className="lp-widget-domino-detail-grid">
                  <div><span className="lp-widget-domino-detail-label">Statut</span><span>{st?.name || "—"}</span></div>
                  <div><span className="lp-widget-domino-detail-label">Responsable</span><span>{t.assignee || "Non assigné"}</span></div>
                  <div><span className="lp-widget-domino-detail-label">Échéance</span><span>{fmtShort(t.end)}</span></div>
                  <div><span className="lp-widget-domino-detail-label">Impact total</span><span>{r.totalImpact} tâche{r.totalImpact > 1 ? "s" : ""}</span></div>
                </div>
                {r.milestoneUnlocked && <div className="lp-widget-domino-detail-note">Débloque le jalon « {r.milestoneUnlocked.title} »</div>}
                {r.directTasks.length > 0 && (
                  <div className="lp-widget-domino-detail-deps">
                    <div className="lp-widget-domino-detail-label">Bloque directement</div>
                    {r.directTasks.slice(0, 6).map((dt) => (
                      <div key={dt.id} className="lp-widget-domino-dep-item" onClick={(e) => { e.stopPropagation(); onOpen(dt); }}>{dt.title}</div>
                    ))}
                    {r.directTasks.length > 6 && <div className="lp-widget-domino-dep-more">+{r.directTasks.length - 6} autres</div>}
                  </div>
                )}
                <button className="lp-btn lp-btn-primary" style={{ width: "100%", marginTop: 8 }} onClick={() => onOpen(t)}>Open task</button>
              </div>
            )}
          </div>
        );
      })}
    </div>
  );
}

const PROJECT_STORY_LEVEL_META = {
  major: { size: 11, weight: 800 },
  normal: { size: 9, weight: 700 },
  minor: { size: 7, weight: 600 },
};



// Widget "Budget Burn Rate" : rythme de consommation réel d'UN projet et
// autonomie budgétaire restante — réutilise calculateBudgetBurnRate, le même
// moteur que l'en-tête du tableau de bord financier, pour ne jamais dupliquer
// ce calcul entre les deux endroits où il est affiché.
function WidgetBudgetBurnRate({ widget, ctx, expenses, onOpen }) {
  const project = ctx.projects.find((p) => p.id === widget.burnRateProjectId) || ctx.projects[0];
  const br = useMemo(() => (project ? calculateBudgetBurnRate({ project, expenses }) : null), [project, expenses]);

  if (!project) return <div className="lp-empty" style={{ padding: 16 }}>Choisis un projet.</div>;
  if (!br || br.status === "noDates") {
    return (
      <div className="lp-widget-burn-empty">
        <div className="lp-widget-burn-empty-title">{project.name}</div>
        <div className="lp-widget-burn-empty-sub">Aucune dépense datée pour ce projet — le rythme de consommation n'est pas encore calculable.</div>
      </div>
    );
  }

  return (
    <div className="lp-widget-burn">
      <div className="lp-widget-burn-project" onClick={() => onOpen(null)}>{project.name}</div>
      <div className="lp-widget-burn-pct">{br.pctConsumed}%<span> du budget consommé</span></div>
      <div className="lp-widget-burn-track"><div className={"lp-widget-burn-fill" + (br.healthStatus === "over" ? " over" : br.healthStatus === "risk" ? " risk" : "")} style={{ width: `${Math.min(100, br.pctConsumed)}%` }} /></div>
      <div className="lp-widget-burn-figures">
        <div><span className="lp-widget-burn-figure-label">Dépensé</span><span className="lp-widget-burn-figure-value">{fmtEuro(br.totalSpent)}</span></div>
        <div><span className="lp-widget-burn-figure-label">Budget</span><span className="lp-widget-burn-figure-value">{fmtEuro(br.budgetActuel)}</span></div>
        <div><span className="lp-widget-burn-figure-label">Reste</span><span className={"lp-widget-burn-figure-value" + (br.remaining < 0 ? " negative" : "")}>{fmtEuro(br.remaining)}</span></div>
      </div>
      <div className="lp-widget-burn-rate">
        <span className="lp-widget-burn-rate-label">Rythme</span>
        <span className="lp-widget-burn-rate-value">{fmtEuro(br.weeklyRate)} / semaine</span>
      </div>
      {br.weeksRemaining !== null && (
        <div className={"lp-widget-burn-insight" + (br.healthStatus === "over" ? " danger" : br.healthStatus === "risk" ? " warn" : " ok")}>
          {br.healthStatus === "over"
            ? <>🔴 Dépassement de {fmtEuro(Math.abs(br.remaining))}</>
            : <>{br.healthStatus === "risk" ? "⚠️" : "✓"} ≈ {br.weeksRemaining} semaine{br.weeksRemaining > 1 ? "s" : ""} d'autonomie au rythme actuel</>}
        </div>
      )}
    </div>
  );
}

// Widget "Matrice des risques" : grille 5×5 probabilité × impact pour UN
// projet, avec le nombre de risques par case et leur détail au survol —
// réutilise le même moteur (riskScoreOf/riskLevelOf) que le registre complet.
// Anneau de progression : un cercle SVG dont la taille suit celle de la tuile.
// Défini au niveau module pour ne pas être recréé à chaque rendu du Treemap.
function TreemapProgressRing({ value, size, color, trackColor, textColor }) {
  const v = Math.max(0, Math.min(100, Number(value) || 0));
  const stroke = size >= 34 ? 3.5 : 2.5;
  const r = (size - stroke) / 2;
  const c = 2 * Math.PI * r;
  return (
    <span className="lp-widget-treemap-ring" style={{ width: size, height: size }}>
      <svg width={size} height={size} aria-hidden="true">
        <circle cx={size / 2} cy={size / 2} r={r} fill="none" stroke={trackColor} strokeWidth={stroke} />
        <circle
          cx={size / 2} cy={size / 2} r={r} fill="none" stroke={color} strokeWidth={stroke} strokeLinecap="round"
          strokeDasharray={`${(c * v) / 100} ${c}`}
          transform={`rotate(-90 ${size / 2} ${size / 2})`}
        />
      </svg>
      {textColor && size >= 30 && <span className="lp-widget-treemap-ring-text" style={{ color: textColor }}>{Math.round(v)}%</span>}
    </span>
  );
}

// Widget « Treemap projets ».
//
// UNE TUILE = UN PROJET. La surface vient du COUNT() des tâches du projet
// retenues par le filtre de taille ; la couleur du même filtre, d'un second
// filtre, ou de la criticité moyenne. `tasks` arrive déjà réduit par les
// méta-filtres, le filtre de page et le filtre du widget : ce composant ne
// refiltre jamais le périmètre, il ne fait que compter à l'intérieur.
function WidgetProjectTreemap({ widget, tasks, ctx, expenses, onOpenProject, onEditProject, onFilterProject, taskBaselines }) {
  const cfg = useMemo(() => normalizeProjectTreemapConfig(widget), [widget]);
  const [search, setSearch] = useState("");
  const [selectedId, setSelectedId] = useState(null);
  const [activeBucket, setActiveBucket] = useState(null);
  const [hover, setHover] = useState(null);
  const [menu, setMenu] = useState(null);

  // La mosaïque est calculée sur la taille RÉELLEMENT mesurée : à aucun moment
  // une estimation ne décide du pavage, sinon les tuiles déborderaient du cadre
  // dès qu'on redimensionne le widget.
  const scrollRef = useRef(null);
  const [box, setBox] = useState({ w: 0, h: 0 });
  useEffect(() => {
    const el = scrollRef.current;
    if (!el || typeof ResizeObserver === "undefined") return;
    const measure = () => {
      const rect = el.getBoundingClientRect();
      setBox((prev) => {
        const w = Math.round(rect.width), h = Math.round(rect.height);
        return prev.w === w && prev.h === h ? prev : { w, h };
      });
    };
    measure();
    const ro = new ResizeObserver(measure);
    ro.observe(el);
    return () => ro.disconnect();
  }, []);

  const todayIdx = dayIndex(iso(new Date()));
  // Faits d'une tâche, tels que le bloc pur les attend. Toutes ces notions
  // existent déjà dans Nexora : aucune donnée n'est inventée ici.
  const factsOf = useCallback((t) => ({
    done: isTaskDoneGlobal(t, ctx),
    late: isTaskLate(t, ctx),
    urgent: isTaskUrgent(t, ctx),
    milestone: getTaskType(t) === "milestone",
    daysToDue: t.end ? dayIndex(t.end) - todayIdx : null,
    inactivityDays: taskInteractionAgeDays(t),
    // Lue sur le projet DE LA TÂCHE, pas sur l'entité de la tuile : sinon le
    // score de criticité d'une même tâche changerait selon l'axe choisi.
    projectPriority: ((ctx.projects || []).find((p) => p.id === t.projectId) || {}).priority || "normal",
  }), [ctx, todayIdx]);

  // Entités qui portent les tuiles, et rattachement d'une tâche à la sienne.
  // Les quatre champs partagent la forme { id, name, color } attendue par le
  // bloc pur ; la tuile « sans valeur » évite qu'une tâche disparaisse du
  // comptage sans qu'on puisse le voir.
  const { tileEntities, bucketIdOf } = useMemo(() => {
    if (cfg.tileBy === "status") {
      return {
        tileEntities: [...(ctx.statuses || []), { id: "__none__", name: "Sans statut", color: "#94A3B8" }],
        bucketIdOf: (t) => t.statusId || "__none__",
      };
    }
    if (cfg.tileBy === "taskType") {
      return {
        tileEntities: [...(ctx.taskTypes || []), { id: "__none__", name: "Sans type", color: "#94A3B8" }],
        bucketIdOf: (t) => t.taskTypeId || "__none__",
      };
    }
    if (cfg.tileBy === "criticality") {
      return {
        tileEntities: [...CRITICALITIES, { id: "__none__", name: "Sans criticité", color: "#94A3B8" }],
        bucketIdOf: (t) => t.criticality || "__none__",
      };
    }
    return { tileEntities: ctx.projects || [], bucketIdOf: (t) => t.projectId };
  }, [cfg.tileBy, ctx.projects, ctx.statuses, ctx.taskTypes]);
  const tilesAreProjects = cfg.tileBy === "project";

  // Les deux filtres sont évalués UNE fois sur l'ensemble du périmètre, puis
  // consultés par identifiant : pas de re-filtrage par projet ni par rendu.
  const sizeIds = useMemo(
    () => new Set(applyWidgetFilter(tasks, cfg.sizeFilter, ctx).map((t) => t.id)),
    [tasks, cfg.sizeFilter, ctx]
  );
  const colorIds = useMemo(
    () => (cfg.colorMode === "secondaryFilterGradient"
      ? new Set(applyWidgetFilter(tasks, cfg.colorFilter, ctx).map((t) => t.id))
      : sizeIds),
    [tasks, cfg.colorFilter, cfg.colorMode, ctx, sizeIds]
  );

  const extras = useMemo(() => {
    const map = {};
    // Risques et budget appartiennent au projet : sur une tuile de statut, il
    // n'y a rien à y rattacher (les champs correspondants sont d'ailleurs
    // retirés par le normalisateur).
    if (!tilesAreProjects) return map;
    (ctx.projects || []).forEach((p) => {
      const stats = computeBudgetStats(p.id, ctx.projects, expenses || []);
      map[p.id] = {
        budgetConsumed: stats.consumed,
        budgetTotal: stats.budgetActuel,
        budgetPct: stats.pct,
      };
    });
    return map;
  }, [ctx.projects, expenses, tilesAreProjects]);

  // #133 : comparaison à la référence par tâche, pour la coloration « dérive » —
  // même repli taskBaselines que le Gantt (#150), pour ne jamais raconter deux
  // histoires différentes du même retard selon le widget consulté.
  const comparisonOf = useCallback((t) => miniGanttTaskComparison(t, taskBaselines), [taskBaselines]);
  const rows = useMemo(() => computeTreemapProjects({
    projects: tileEntities,
    tasks,
    sizeMatch: (t) => sizeIds.has(t.id),
    colorMatch: (t) => colorIds.has(t.id),
    factsOf,
    extras,
    bucketIdOf,
    colorMode: cfg.colorMode,
    showZeroProjects: cfg.showZeroProjects,
    comparisonOf,
  }), [tileEntities, bucketIdOf, tasks, sizeIds, colorIds, factsOf, extras, cfg.colorMode, cfg.showZeroProjects, comparisonOf]);

  const domain = useMemo(() => treemapColorDomain(rows, cfg.colorMode), [rows, cfg.colorMode]);
  const legend = useMemo(
    () => (cfg.showLegend ? treemapLegendBuckets(rows, cfg.colorMode, cfg.palette, cfg.direction) : []),
    [rows, cfg.colorMode, cfg.palette, cfg.direction, cfg.showLegend]
  );

  const visibleRows = useMemo(() => {
    const q = search.trim().toLowerCase();
    return rows.filter((r) => {
      if (q && !String(r.project.name || "").toLowerCase().includes(q)) return false;
      if (activeBucket) {
        const bucket = legend.find((b) => b.key === activeBucket);
        if (bucket && !(r.colorValue >= bucket.min && r.colorValue < bucket.max)) return false;
      }
      return true;
    });
  }, [rows, search, activeBucket, legend]);

  const groupLabelOf = (row) => {
    if (cfg.groupBy === "folder") return (ctx.projectFolders || []).find((f) => f.id === row.project.folderId)?.name || "Sans dossier";
    if (cfg.groupBy === "priority") return { high: "Prioritaire", low: "Priorité faible" }[row.project.priority] || "Priorité normale";
    if (cfg.groupBy === "owner") return row.owner || "Non assigné";
    if (cfg.groupBy === "criticality") return row.criticality.level.label;
    return "";
  };

  const groups = useMemo(() => {
    if (cfg.groupBy === "none") return [{ key: "all", label: "", rows: visibleRows }];
    const map = new Map();
    visibleRows.forEach((r) => {
      const label = groupLabelOf(r);
      if (!map.has(label)) map.set(label, []);
      map.get(label).push(r);
    });
    return [...map.entries()]
      .map(([label, list]) => ({ key: label, label, rows: list }))
      .sort((a, b) => b.rows.length - a.rows.length || a.label.localeCompare(b.label));
  }, [visibleRows, cfg.groupBy, ctx.projectFolders]);

  const GROUP_HEADER_H = 20;
  const GROUP_GAP = 10;
  const layout = useMemo(() => {
    const W = box.w, H = box.h;
    if (W <= 0 || H <= 0) return { height: H, blocks: [] };
    const asItems = (list) => list.map((r) => ({ row: r, weight: r.weight }));
    if (cfg.groupBy === "none") {
      return { height: H, blocks: [{ key: "all", label: "", headerRect: null, tiles: squarifyTreemap(asItems(visibleRows), { x: 0, y: 0, w: W, h: H }) }] };
    }
    const rects = treemapGroupRects(groups, { x: 0, y: 0, w: W, h: H }, { headerH: GROUP_HEADER_H, gap: GROUP_GAP, minBodyH: 70 });
    const blocks = rects.map(({ group, headerRect, bodyRect }) => ({
      key: group.key,
      label: group.label,
      headerRect,
      tiles: squarifyTreemap(asItems(group.rows), bodyRect),
    }));
    // #332 : treemapGroupRects garantit désormais que tout tient dans H — la
    // hauteur du canevas reste donc H, jamais un débordement qui déclencherait
    // une barre de défilement.
    return { height: H, blocks };
  }, [box, visibleRows, groups, cfg.groupBy]);

  const statusOfId = (id) => (ctx.statuses || []).find((s) => s.id === id);
  const memberOf = (name) => (ctx.teamMembers || []).find((m) => m.name === name);
  const fmtNumber = (n) => (Number.isInteger(n) ? n.toLocaleString("fr-FR") : Number(n).toLocaleString("fr-FR", { maximumFractionDigits: 2 }));

  // Valeur textuelle d'un champ, dans la présentation propre à son type.
  const renderField = (key, row, dark) => {
    const chipClass = "lp-widget-treemap-chip" + (dark ? " is-dark" : "");
    if (key === "dominantStatus") {
      const st = statusOfId(row.dominantStatusId);
      if (!st) return null;
      return <span className={chipClass} key={key} title={`Statut dominant : ${st.name}`}><span className="lp-widget-treemap-chip-dot" style={{ background: st.color }} />{st.name}</span>;
    }
    if (key === "owner") {
      if (!row.owner) return null;
      const u = memberOf(row.owner);
      const initials = row.owner.split(/\s+/).map((p) => p[0]).join("").slice(0, 2).toUpperCase();
      return (
        <span className={chipClass} key={key} title={`Responsable principal : ${row.owner}`}>
          <span className="lp-widget-treemap-chip-avatar" style={{ background: u?.color || "var(--text-muted)" }}>{initials}</span>
          {row.owner}
        </span>
      );
    }
    if (key === "sizeCount") return <span className={chipClass} key={key} title="Tâches retenues par le filtre de taille">{row.sizeCount} tâche{row.sizeCount > 1 ? "s" : ""}</span>;
    if (key === "colorCount") return <span className={chipClass} key={key} title="Tâches retenues par le filtre de coloration">{row.colorCount} ciblée{row.colorCount > 1 ? "s" : ""}</span>;
    if (key === "progress") return <span className={chipClass} key={key} title="Progression moyenne des tâches retenues">{row.progress}%</span>;
    if (key === "averageCriticality") {
      const lvl = row.criticality.level;
      return <span className={chipClass} key={key} title={`Criticité moyenne : ${row.criticality.score}/100`}><span className="lp-widget-treemap-chip-dot" style={{ background: lvl.color }} />{lvl.label}</span>;
    }
    if (key === "lateTaskCount") {
      if (!row.lateCount) return null;
      return <span className={chipClass} key={key} style={{ color: "var(--danger)" }} title="Tâches en retard"><AlertTriangle size={9} />{row.lateCount}</span>;
    }
    if (key === "urgentTaskCount") {
      if (!row.urgentCount) return null;
      return <span className={chipClass} key={key} style={{ color: "var(--danger)" }} title="Tâches de criticité urgente"><Flame size={9} />{row.urgentCount}</span>;
    }
    if (key === "nextMilestone") {
      if (!row.nextMilestone) return null;
      return <span className={chipClass} key={key} title={`Prochain jalon : ${row.nextMilestone.title} (${fmtShort(row.nextMilestone.date)})`}>◆ {fmtShort(row.nextMilestone.date)}</span>;
    }
    if (key === "endDate") {
      if (!row.endDate) return null;
      return <span className={chipClass} key={key} title="Dernière échéance des tâches retenues"><CalendarClock size={9} />{fmtShort(row.endDate)}</span>;
    }
    if (key === "budget") {
      if (!row.budgetTotal) return null;
      return <span className={chipClass} key={key} title={`Budget consommé : ${fmtNumber(row.budgetConsumed)} € sur ${fmtNumber(row.budgetTotal)} €`}><Wallet size={9} />{row.budgetPct}%</span>;
    }
    if (key === "priority") {
      const label = { high: "Prioritaire", low: "Priorité faible" }[row.project.priority] || "Priorité normale";
      return <span className={chipClass} key={key} title="Priorité du projet">{label}</span>;
    }
    if (key === "folder") {
      const folder = (ctx.projectFolders || []).find((f) => f.id === row.project.folderId);
      if (!folder) return null;
      return <span className={chipClass} key={key} title="Dossier du projet">{folder.name}</span>;
    }
    return null;
  };

  const openRow = (row) => { if (tilesAreProjects && cfg.openOnClick && onOpenProject) onOpenProject(row.projectId); };

  const tooltipNode = () => {
    if (!hover) return null;
    const row = hover.row;
    const worst = row.criticality.level;
    const node = (
      <div className="lp-widget-treemap-tooltip" style={{ left: Math.min(hover.x + 14, (typeof window !== "undefined" ? window.innerWidth : 1200) - 300), top: hover.y + 14 }}>
        <div className="lp-widget-treemap-tooltip-title">{row.project.name}</div>
        <div className="lp-widget-treemap-tooltip-row"><span>Taille — tâches du filtre</span><strong>{row.sizeCount}</strong></div>
        {cfg.colorMode === "secondaryFilterGradient" && <div className="lp-widget-treemap-tooltip-row"><span>Couleur — second filtre</span><strong>{row.colorCount}</strong></div>}
        {cfg.colorMode === "averageCriticality" && <div className="lp-widget-treemap-tooltip-row"><span>Couleur — criticité moyenne</span><strong>{row.criticality.score}/100 · {worst.label}</strong></div>}
        {cfg.colorMode === "sizeFilterGradient" && <div className="lp-widget-treemap-tooltip-row"><span>Couleur — même filtre</span><strong>{row.sizeCount}</strong></div>}
        {cfg.colorMode === "averageDrift" && (
          <div className="lp-widget-treemap-tooltip-row">
            <span>Couleur — dérive moyenne</span>
            <strong>{row.driftCount ? `${miniGanttComparisonDeltaLabel(row.driftAvg)} (${row.driftCount} tâche${row.driftCount > 1 ? "s" : ""} comparée${row.driftCount > 1 ? "s" : ""})` : "aucune tâche comparable"}</strong>
          </div>
        )}
        <div className="lp-widget-treemap-tooltip-sep" />
        <div className="lp-widget-treemap-tooltip-row"><span>Tâches de la tuile (périmètre)</span><strong>{row.taskCount}</strong></div>
        <div className="lp-widget-treemap-tooltip-row"><span>Terminées</span><strong>{row.doneCount}</strong></div>
        <div className="lp-widget-treemap-tooltip-row"><span>En retard</span><strong>{row.lateCount}</strong></div>
        <div className="lp-widget-treemap-tooltip-row"><span>Urgentes</span><strong>{row.urgentCount}</strong></div>
        <div className="lp-widget-treemap-tooltip-row"><span>Progression moyenne</span><strong>{row.progress}%</strong></div>
        {row.nextMilestone && <div className="lp-widget-treemap-tooltip-row"><span>Prochain jalon</span><strong>{fmtShort(row.nextMilestone.date)}</strong></div>}
        <div className="lp-widget-treemap-tooltip-note">
          Criticité = moyenne, sur les tâches retenues, de : retard {TREEMAP_CRITICALITY_WEIGHTS.late},
          criticité urgente {TREEMAP_CRITICALITY_WEIGHTS.urgent}, échéance ≤ {TREEMAP_DUE_SOON_DAYS} j {TREEMAP_CRITICALITY_WEIGHTS.dueSoon},
          jalon {TREEMAP_CRITICALITY_WEIGHTS.milestone}, inactivité ≥ {TREEMAP_STALE_DAYS} j {TREEMAP_CRITICALITY_WEIGHTS.stale},
          projet prioritaire {TREEMAP_CRITICALITY_WEIGHTS.projectPriorityHigh}. Une tâche terminée vaut 0.
        </div>
      </div>
    );
    return createPortal(node, document.body);
  };

  const secondaryFields = cfg.fields.filter((f) => f !== "projectName");
  const radiusPx = { sharp: 2, medium: 8, round: 14 }[cfg.radius];

  const renderTile = (tile) => {
    const row = tile.row;
    const inset = cfg.gap / 2;
    const w = Math.max(0, tile.w - cfg.gap);
    const h = Math.max(0, tile.h - cfg.gap);
    if (w < 6 || h < 6) return null;
    const density = treemapTileDensity(w, h, cfg.compact);
    const bg = row.sizeCount === 0 ? TREEMAP_NEUTRAL_COLOR : treemapTileColor(row.colorValue, domain, cfg.palette, cfg.direction);
    const fg = treemapTextColor(bg);
    const dark = fg === "#FFFFFF";
    const budget = treemapSecondaryFieldBudget(density);
    const chips = budget === 0 ? [] : secondaryFields.map((f) => renderField(f, row, dark)).filter(Boolean).slice(0, budget);
    const showRing = cfg.showProgressRing && cfg.fields.includes("progress") && density !== "small";
    const ringSize = density === "large" ? 38 : 26;
    // Place déjà prise avant la liste : marges, nom du projet, bloc principal,
    // et la rangée de capsules qui reste ancrée en bas de la tuile.
    const reserved = 16
      + (density === "small" ? 15 : 17)
      + (density === "small" ? 18 : (density === "large" ? 44 : 32))
      + (chips.length ? 20 : 0);
    const upcomingMax = cfg.showUpcoming ? treemapUpcomingCapacity(h, reserved, w) : 0;
    const upcoming = upcomingMax > 0 ? row.upcoming.slice(0, upcomingMax) : [];
    // Le rouge doit rester lisible : sur une tuile foncée, le rouge plein
    // deviendrait illisible, on prend donc sa version claire.
    const lateColor = dark ? "#FFC9C9" : "#C23232";
    const hiddenUpcoming = row.upcomingTotal - upcoming.length;
    return (
      <div
        key={row.projectId}
        className={
          "lp-widget-treemap-tile is-" + density
          + (cfg.openOnClick ? " is-clickable" : "")
          + (cfg.border ? " is-bordered" : "")
          + (selectedId === row.projectId ? " is-selected" : "")
          + (row.sizeCount === 0 ? " is-zero" : "")
          + (selectedId && selectedId !== row.projectId ? " is-dimmed" : "")
        }
        style={{ left: tile.x + inset, top: tile.y + inset, width: w, height: h, background: bg, color: fg, borderRadius: radiusPx }}
        onClick={() => { setSelectedId((prev) => (prev === row.projectId ? null : row.projectId)); openRow(row); }}
        onContextMenu={(e) => { if (!tilesAreProjects) return; e.preventDefault(); setHover(null); setMenu({ row, x: e.clientX, y: e.clientY }); }}
        onMouseEnter={(e) => setHover({ row, x: e.clientX, y: e.clientY })}
        onMouseMove={(e) => setHover((prev) => (prev && prev.row === row ? { row, x: e.clientX, y: e.clientY } : prev))}
        onMouseLeave={() => setHover((prev) => (prev && prev.row === row ? null : prev))}
        title={density === "small" ? `${row.project.name} — ${row.sizeCount} tâche${row.sizeCount > 1 ? "s" : ""}` : undefined}
      >
        <div className="lp-widget-treemap-tile-head">
          <span className="lp-widget-treemap-tile-dot" style={{ background: row.project.color || "var(--text-muted)" }} />
          <span className="lp-widget-treemap-tile-name">{row.project.name}</span>
        </div>
        {density !== "small" ? (
          <div className="lp-widget-treemap-tile-main">
            {showRing && (
              <TreemapProgressRing
                value={row.progress}
                size={ringSize}
                color={fg}
                trackColor={dark ? "rgba(255,255,255,.28)" : "rgba(11,21,38,.16)"}
                textColor={density === "large" ? fg : null}
              />
            )}
            <span className="lp-widget-treemap-tile-metric">
              <span className="lp-widget-treemap-tile-metric-value">{row.sizeCount}</span>
              <span className="lp-widget-treemap-tile-metric-label">tâche{row.sizeCount > 1 ? "s" : ""}</span>
            </span>
          </div>
        ) : (
          <span className="lp-widget-treemap-tile-metric-value">{row.sizeCount}</span>
        )}
        {upcoming.length > 0 && (
          <div className="lp-widget-treemap-upcoming">
            {upcoming.map((u) => (
              <span className={"lp-widget-treemap-upcoming-item" + (u.late ? " is-late" : "")} key={u.id} title={`${u.title} — ${fmtShort(u.end)}${u.late ? " · en retard" : ""}`}>
                <span className="lp-widget-treemap-upcoming-dot" style={{ background: u.late ? lateColor : "currentColor", opacity: u.late ? 1 : 0.55 }} />
                <span className="lp-widget-treemap-upcoming-title" style={u.late ? { color: lateColor } : undefined}>{u.title || "Sans titre"}</span>
                <span className="lp-widget-treemap-upcoming-date" style={u.late ? { color: lateColor, opacity: 1 } : undefined}>{fmtShort(u.end)}</span>
              </span>
            ))}
            {hiddenUpcoming > 0 && upcomingMax > 1 && (
              <span className="lp-widget-treemap-upcoming-more">+{hiddenUpcoming} autre{hiddenUpcoming > 1 ? "s" : ""}</span>
            )}
          </div>
        )}
        {chips.length > 0 && <div className="lp-widget-treemap-tile-fields">{chips}</div>}
      </div>
    );
  };

  // États vides — jamais un cadre blanc muet : on dit pourquoi il n'y a rien et
  // quel réglage changerait la réponse.
  const emptyState = (() => {
    // Les messages nomment le champ qui porte les tuiles : « aucun projet »
    // serait faux, et surtout inutile, sur un Treemap groupé par statut.
    const noun = TREEMAP_TILE_BY_LABELS[cfg.tileBy].plural;
    if (!tileEntities.length) {
      return tilesAreProjects
        ? { title: "Aucun projet", sub: "Crée un projet pour que le Treemap ait quelque chose à représenter." }
        : { title: `Aucun de ces ${noun}`, sub: `Aucun ${TREEMAP_TILE_BY_LABELS[cfg.tileBy].label.toLowerCase()} n'est défini : le Treemap n'a rien à représenter.` };
    }
    if (rows.length === 0) {
      return tasks.length === 0
        ? { title: "Aucune tâche dans ce périmètre", sub: `Le filtre du widget et celui de l'onglet ne laissent passer aucune tâche : aucun de ces ${noun} ne peut donc être mesuré.` }
        : { title: `Aucun de ces ${noun} ne porte de tâche correspondante`, sub: "Le filtre de taille exclut toutes les tâches. Élargis-le, ou coche « Afficher les tuiles sans tâche correspondante » pour les garder en tuile minimale." };
    }
    if (visibleRows.length === 0) return { title: `Aucun de ces ${noun} pour cette sélection`, sub: `La recherche ou la tranche de légende active ne retient aucun de ces ${noun}.` };
    return null;
  })();

  return (
    <div className="lp-widget-treemap">
      {(cfg.showSearch || legend.length > 0) && (
        <div className="lp-widget-treemap-toolbar">
          {cfg.showSearch && (
            <span className="lp-widget-treemap-search">
              <Search size={11} color="var(--text-muted)" />
              <input type="text" value={search} onChange={(e) => setSearch(e.target.value)} placeholder="Rechercher un projet…" />
              {search && <button type="button" className="lp-icon-btn" onClick={() => setSearch("")} title="Effacer"><X size={11} /></button>}
            </span>
          )}
          {legend.length > 0 && (
            <span className="lp-widget-treemap-legend">
              {legend.map((b) => (
                <button
                  type="button"
                  key={b.key}
                  className={"lp-widget-treemap-legend-item" + (activeBucket === b.key ? " is-active" : "") + (b.count === 0 ? " is-empty" : "")}
                  onClick={() => { if (b.count > 0) setActiveBucket((prev) => (prev === b.key ? null : b.key)); }}
                  title={b.count === 0 ? "Aucun projet dans cette tranche" : "Ne garder que cette tranche"}
                >
                  <span className="lp-widget-treemap-legend-mark" style={{ background: b.color }} />
                  {b.label} · {b.count}
                </button>
              ))}
            </span>
          )}
        </div>
      )}
      <div className="lp-widget-treemap-scroll" ref={scrollRef}>
        {emptyState ? (
          <div className="lp-widget-treemap-empty">
            <LayoutDashboard size={20} color="var(--text-muted)" />
            <div className="lp-widget-treemap-empty-title">{emptyState.title}</div>
            <div className="lp-widget-treemap-empty-sub">{emptyState.sub}</div>
          </div>
        ) : (
          <div className="lp-widget-treemap-canvas" style={{ height: layout.height }}>
            {layout.blocks.map((block) => (
              <React.Fragment key={block.key}>
                {block.headerRect && (
                  <div className="lp-widget-treemap-group-label" style={{ left: block.headerRect.x, top: block.headerRect.y, width: block.headerRect.w, height: block.headerRect.h }}>
                    {block.label}
                  </div>
                )}
                {block.tiles.map(renderTile)}
              </React.Fragment>
            ))}
          </div>
        )}
      </div>
      {tooltipNode()}
      {menu && (
        <QuickContextMenu
          x={menu.x}
          y={menu.y}
          onClose={() => setMenu(null)}
          items={[
            { icon: <ExternalLink size={13} />, label: "Ouvrir le projet", onClick: () => { setMenu(null); onOpenProject && onOpenProject(menu.row.projectId); } },
            { icon: <Settings size={13} />, label: "Modifier le projet", onClick: () => { setMenu(null); onEditProject && onEditProject(menu.row.project); } },
            { icon: <Search size={13} />, label: "Filtrer cet onglet sur ce projet", onClick: () => { setMenu(null); onFilterProject && onFilterProject(menu.row.projectId); } },
          ]}
        />
      )}
    </div>
  );
}




// avec sa propre mini barre d'outils (portée dans un slot local) et son propre
// jeu de préférences (zoom, groupement...), indépendant de la vue plein écran.
// L'édition par glisser-déposer reste active (setTasks réel) ; en revanche
// créer/supprimer une tâche ou basculer son statut en un clic reste réservé à
// la vue plein écran et à la fiche tâche (onOpen), pour ne pas dupliquer toute
// la mécanique d'actions rapides dans un espace réduit.
function EmbeddedViewShell({ children, initialPrefs, externalToolbarSlot }) {
  const [toolbarSlot, setToolbarSlot] = useState(null);
  const [prefsState, setPrefsState] = useState(initialPrefs || {});
  const setPrefs = (patch) => setPrefsState((p) => ({ ...p, ...(typeof patch === "function" ? patch(p) : patch) }));
  // Si WidgetFrame fournit un emplacement dans son propre en-tête (pour fusionner
  // titre + barre d'outils sur une seule ligne), on l'utilise directement plutôt
  // que de créer un second emplacement en dessous.
  const effectiveSlot = externalToolbarSlot || toolbarSlot;
  return (
    <div className="lp-widget-embed">
      {!externalToolbarSlot && <div className="lp-widget-embed-toolbar" ref={setToolbarSlot} />}
      <div className="lp-widget-embed-body">
        {children({ toolbarSlot: effectiveSlot, prefs: prefsState, setPrefs })}
      </div>
    </div>
  );
}

function WidgetEmbedMetro({ widget, tasks, ctx, onOpen, appearance, expenses, setTasks, setTaskArchive, pushToast, externalToolbarSlot, onUpdateWidget, metaBlocks }) {
  // Mêmes règles que le Gantt embarqué : les annotations vivent dans la
  // configuration DU WIDGET, pas dans les préférences éphémères de la vue.
  const annotations = ganttAnnotationsOf(widget);
  return (
    <EmbeddedViewShell externalToolbarSlot={externalToolbarSlot}>
      {({ toolbarSlot, prefs, setPrefs }) => (
        <ProjectMetroView
          tasks={tasks} ctx={ctx} onOpen={onOpen} toolbarSlot={toolbarSlot}
          appearance={appearance} prefs={prefs} setPrefs={setPrefs}
          setTasks={setTasks || (() => {})} setTaskArchive={setTaskArchive || (() => {})} pushToast={pushToast || (() => {})} expenses={expenses || []}
          metaTemporalBlocks={metaBlocks}
          annotations={annotations}
          onAnnotationsChange={onUpdateWidget ? ((next) => onUpdateWidget({ ganttAnnotations: next })) : undefined}
          embedded
        />
      )}
    </EmbeddedViewShell>
  );
}

// Les annotations du Gantt embarqué vivent dans la configuration DU WIDGET
// (widget.ganttAnnotations) et non dans les préférences éphémères de la vue :
// elles survivent au rechargement et suivent le widget lors de la duplication
// d'un widget, d'un onglet ou d'un tableau de bord. Les autres réglages
// (zoom, colonnes, bulles) restent locaux au widget affiché, comme avant.
function ganttAnnotationsOf(widget) {
  const stored = widget && widget.ganttAnnotations;
  return stored && typeof stored === "object" ? stored : {};
}

function WidgetEmbedRadar({ tasks, ctx, onOpen, appearance, externalToolbarSlot }) {
  return (
    <EmbeddedViewShell externalToolbarSlot={externalToolbarSlot}>
      {({ toolbarSlot, prefs, setPrefs }) => (
        <RadarView tasks={tasks} ctx={ctx} onOpen={onOpen} appearance={appearance} prefs={prefs} setPrefs={setPrefs} toolbarSlot={toolbarSlot} embedded />
      )}
    </EmbeddedViewShell>
  );
}

// Sélecteur de type de widget, organisé par catégorie plutôt qu'en liste plate —
// chaque type garde une icône reconnaissable pour un repérage plus rapide.
// #317 : les widgets centrés sur les personnes ont leur propre section.
