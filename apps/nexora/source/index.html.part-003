        if (l.tagName === "BUTTON") { l.type = "button"; l.setAttribute("data-cosmos-kind", c.kind); l.setAttribute("data-cosmos-id", c.id); }
        l.className = "lp-cosmos-label lp-cosmos-label--" + c.kind;
