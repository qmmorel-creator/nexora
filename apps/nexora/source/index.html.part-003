}
// === NEXORA:COSMOS-ENGINE:END ===
// === NEXORA:TIMELINE3D-ENGINE:START ===
// Moteur 3D de la vue Timeline 3D (#454), directions validées sur maquettes
// (#452) : « Grande Ligne » (table de maquettiste, voies sur ballast, gares,
// trains à vapeur, passage à niveau, vue conducteur) et « Cabine » (faisceau
// de lignes en plein jour, vue à la première personne). La logique de réseau
// vit dans NEXORA:TIMELINE3D ; ce moteur ne fait que dessiner et animer.
// three.js ≥ r155 : intensités lumineuses physiques (× π) et couleurs sRGB.
function createTimeline3dEngine(THREE, container, opts) {
  const o = opts || {};
  const RM = !!(window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches);
  const LI = Math.PI;
  const PI = Math.PI, TAU = PI * 2;
  const renderer = new THREE.WebGLRenderer({ antialias: true, powerPreference: "high-performance" });
  renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
  renderer.shadowMap.enabled = true;
  renderer.shadowMap.type = THREE.PCFSoftShadowMap;
  const canvas = renderer.domElement;
  canvas.className = "lp-t3d-canvas";
  container.appendChild(canvas);
  const labelsEl = document.createElement("div");
  labelsEl.className = "lp-t3d-labels";
  container.appendChild(labelsEl);
  const camera = new THREE.PerspectiveCamera(40, 1, 0.1, 500);
  const V = (x, y, z) => new THREE.Vector3(x, y, z);
  const col = (c) => new THREE.Color(c);
  const mix = (a, b, t) => col(a).lerp(col(b), t);
  const DONE = "#9aa5b4", RED = "#e5484d", AMBER = "#f2b134";
  const SIG = { todo: "#2fd36b", doing: "#eaf6ff", wait: "#ffab2e", late: "#ff3b30", done: "#30353b" };
  const REST = -0.75, RT = 0.25;

  const S = {
    mode: o.mode === "cabine" ? "cabine" : "rail", animate: o.animate !== false, speed: o.speed || 2.4, qualityPref: o.quality || "auto", quality: "high",
    model: null, visible: null, scene: null, s: 0.45, lane: {}, ang: {}, R: 5, r0: 0, r1: 0,
    hits: [], anims: [], labels: [], selRing: null, selectedId: null, focus: 0,
    playing: false, sim: 0, simEnd: 60, dwell: 0, clockUntil: 0, driver: null, dl: { y: 0, p: -0.07, gy: 0, gp: -0.07 },
    trains: [], barriers: [], xlights: [], cars: [], clouds: [], puffs: [], ripples: [], boarding: [], hands: [], zones: [],
    down: 0, lastCab: null, st: {}, owned: [], W: 1, H: 1, stateKey: "", lastEmit: 0, disposed: false, raf: 0, last: performance.now(), intro: false,
  };
  const cam = { tx: 0, ty: 0, tz: 0, yaw: -0.5, pitch: 0.7, dist: 40, day: -4 };
  const goal = Object.assign({}, cam);
  const anim = () => S.animate && !RM;

  // ---------- Ressources partagées (libérées à chaque reconstruction) ----------
  const geoCache = new Map(), matCache = new Map();
  const own = (x) => { S.owned.push(x); return x; };
  const geo = (key, make) => { let g = geoCache.get(key); if (!g) { g = make(); geoCache.set(key, g); } return g; };
  const std = (c, extra) => {
    const key = "s:" + (typeof c === "string" ? c : c.getHexString()) + ":" + JSON.stringify(extra || {});
    let m = matCache.get(key);
    if (!m) { m = new THREE.MeshStandardMaterial(Object.assign({ color: col(c), roughness: 0.85 }, extra || {})); matCache.set(key, m); }
    return m;
  };
  const basic = (c, extra) => {
    const key = "b:" + (typeof c === "string" ? c : c.getHexString()) + ":" + JSON.stringify(extra || {});
    let m = matCache.get(key);
    if (!m) { m = new THREE.MeshBasicMaterial(Object.assign({ color: col(c) }, extra || {})); matCache.set(key, m); }
    return m;
  };
  const texOf = (stops) => {
    const c = document.createElement("canvas"); c.width = 64; c.height = 64;
    const g = c.getContext("2d"); const r = g.createRadialGradient(32, 32, 0, 32, 32, 32);
    stops.forEach(([k, v]) => r.addColorStop(k, v)); g.fillStyle = r; g.fillRect(0, 0, 64, 64);
    return new THREE.CanvasTexture(c);
  };
  const glowTex = texOf([[0, "rgba(255,255,255,1)"], [0.35, "rgba(255,255,255,.45)"], [1, "rgba(255,255,255,0)"]]);
  const puffTex = texOf([[0, "rgba(255,255,255,1)"], [0.55, "rgba(255,255,255,.75)"], [1, "rgba(255,255,255,0)"]]);
  // Halo additif (lampes) ou en mélange normal (lisible sur fond clair).
  const glow = (c, size, op, additive) => {
    const sp = new THREE.Sprite(own(new THREE.SpriteMaterial({ map: glowTex, color: col(c), transparent: true, opacity: op == null ? 0.8 : op, depthWrite: false, blending: additive ? THREE.AdditiveBlending : THREE.NormalBlending })));
    sp.scale.set(size, size, 1); return sp;
