}
body[data-life-app] :where(h1, h2, h3, h4) {
  font-family: var(--life-font) !important;
  letter-spacing: -.025em;
}
body[data-life-app] svg text { font-family: var(--life-font) !important; }
body[data-life-app] :where(pre, code, kbd) { font-family: var(--life-mono) !important; }
body[data-life-app] :where(button, a, input, select, textarea, summary, [tabindex]):focus-visible {
  outline: 2px solid var(--life-blue) !important;
  outline-offset: 3px !important;
}
body[data-life-app] :where(input[type=checkbox], input[type=radio]) { accent-color: var(--life-blue); }
