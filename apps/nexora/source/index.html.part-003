    return c;
  }
  function labelCandidates(H) {
    const M = S.model, out = [], sel = S.selected, hov = S.hovered;
    const isSel = (k, id) => !!(sel && sel.kind === k && sel.id === id);
    const isHov = (k, id) => !!(hov && hov.kind === k && hov.id === id);
    const prevTier = (key) => (pool[key] ? pool[key]._tier : null);
    const sunLabel = (g, prio) => {
      const rc = Math.max(1, g.radius * 0.075);
      out.push({ key: "s:" + g.id, kind: "sun", id: g.id, tier: 1, pos: new THREE.Vector3(g.pos.x, rc * 3.2, g.pos.z), prio, sides: ["top", "bottom"], off: 2 });
    };
    M.galaxies.forEach((g) => {
      if (S.level !== "universe" && g.id === S.galaxyId) return;
      const key = "g:" + g.id, px = pxSize(g.pos.x, 0, g.pos.z, g.radius, H);
      const force = isSel("galaxy", g.id) || isHov("galaxy", g.id);
      const tier = force ? 3 : cosmosLabelTier("galaxy", px, prevTier(key), false);
      out.push({ key, kind: "galaxy", id: g.id, tier, pos: new THREE.Vector3(g.pos.x, g.radius * 0.35, g.pos.z - g.radius * 0.8), prio: force ? 5000 : 1000 + tier * 300 + Math.min(200, px), sides: ["top", "bottom", "left", "right"], off: 6 });
      // Chiffre du soleil-tableau de bord, quand la galaxie est assez grande.
      if (px >= 150 && S.level === "universe") sunLabel(g, 900);
    });
    if (S.level === "galaxy" && S.galaxyId) sunLabel(M.galaxyById[S.galaxyId], 4200);
