      data.miniGanttShowDependencies = miniGanttShowDependencies;
      data.miniGanttShowSubtasks = miniGanttShowSubtasks;
      data.miniGanttSort = miniGanttSort;
      data.miniGanttSortDir = miniGanttSortDir;
      data.miniGanttRange = normalizeMiniGanttRange(miniGanttRange);
      /* Les dates fixes vivent dans `miniGanttWindow`, comme avant : le rendu
         les lit déjà, et un widget qui en portait une ne change pas de forme.
         Les autres cadrages la relâchent, sinon elle primerait sur eux. */
      data.miniGanttWindow = miniGanttRange.mode === "fixed" && !miniGanttWindowError
        ? { start: miniGanttWindowStart, end: miniGanttWindowEnd }
        : null;
      if (widget?.miniGanttZoomLevel != null) data.miniGanttZoomLevel = widget.miniGanttZoomLevel;
    }
    if (type === "bubbles") {
      // Les clés du cadrage et du regroupement sont celles du Mini-Gantt, aux
      // mêmes noms : un widget qui change de type garde sa fenêtre, son zoom,
      // son tri et ses annotations.
      data.groupBy = listGroupBy;
      data.showMilestones = showMilestones;
      data.miniGanttSort = miniGanttSort;
      data.miniGanttSortDir = miniGanttSortDir;
      data.miniGanttRange = normalizeMiniGanttRange(miniGanttRange);
      data.miniGanttWindow = miniGanttRange.mode === "fixed" && !miniGanttWindowError
        ? { start: miniGanttWindowStart, end: miniGanttWindowEnd }
        : null;
      if (widget?.miniGanttZoomLevel != null) data.miniGanttZoomLevel = widget.miniGanttZoomLevel;
      const bubbles = normalizeBubblesWidget({
        ...bubbleSettings,
        // Une tâche supprimée entre-temps quitte la macro-bulle à
        // l'ENREGISTREMENT, jamais au rendu : un filtre de widget ne doit pas
        // détruire une configuration.
        bubbleMacros: pruneBubbleMacros(bubbleSettings.bubbleMacros, ganttTasks.map((t) => t.id)),
      });
      data.bubbleColorBy = bubbles.bubbleColorBy;
      data.bubbleFields = bubbles.bubbleFields;
      data.bubbleFieldsLayout = bubbles.bubbleFieldsLayout;
      data.bubbleLayout = bubbles.bubbleLayout;
      data.bubbleSize = bubbles.bubbleSize;
      data.bubbleShowDates = bubbles.bubbleShowDates;
      data.bubbleShowProgress = bubbles.bubbleShowProgress;
      data.bubbleShowDescription = bubbles.bubbleShowDescription;
      data.bubbleDescriptionLines = bubbles.bubbleDescriptionLines;
      data.bubbleShowLegend = bubbles.bubbleShowLegend;
      data.bubbleTruncateTitles = bubbles.bubbleTruncateTitles;
      data.bubbleMacroGrouping = bubbles.bubbleMacroGrouping;
      data.bubbleMacros = bubbles.bubbleMacros;
    }
    if (type === "staffing") {
      const st = normalizeStaffingWidget(staffingSettings);
      data.staffingRange = st.staffingRange;
      data.staffingOffset = st.staffingOffset;
      /* Les deux bornes de la plage choisie a la main. Elles manquaient ici :
         la fiche les affichait, l'enregistrement les laissait tomber, et la
         granularite « Plage » restait donc sans effet. Toute cle de
         STAFFING_DEFAULTS doit etre recopiee ici — c'est ce que verifie
         desormais la suite, pour que le prochain reglage ajoute ne disparaisse
         pas en silence a son tour. */
      data.staffingStart = st.staffingStart;
      data.staffingEnd = st.staffingEnd;
      data.staffingMembers = st.staffingMembers;
      data.staffingExtraMembers = st.staffingExtraMembers;
      data.staffingShowWeekends = st.staffingShowWeekends;
      data.staffingShowLoad = st.staffingShowLoad;
      data.staffingShowTasks = st.staffingShowTasks;
    }
    if (titleColor) data.titleColor = titleColor; else data.titleColor = null;
    if (bgColor) data.bgColor = bgColor; else data.bgColor = null;
    if (bandColor) data.bandColor = bandColor; else data.bandColor = null;
    if (titleEmoji.trim()) data.titleEmoji = titleEmoji.trim(); else data.titleEmoji = null;
    if (type === "nextBestAction" || type === "dailyBriefing") data.onlyMine = onlyMine;
    return data;
  };

  const submit = () => {
    if (!isValid) return;
    onSave(buildData());
  };

  return (
    <Modal title={widget ? "Modifier le widget" : "Nouveau widget"} onClose={onClose} wide footer={
      <>
        <button className="lp-btn" onClick={onClose}>Annuler</button>
        <button className="lp-btn lp-btn-primary" onClick={submit} disabled={!isValid} title={!isValid ? "Renseigne les champs requis pour ce widget" : undefined}>{widget ? "Enregistrer" : "Ajouter le widget"}</button>
      </>
    }>
      <div className="lp-field"><label>Titre <span style={{ fontWeight: 400, textTransform: "none", color: "var(--text-600)" }}>(facultatif — sinon généré automatiquement)</span></label><input type="text" value={title} onChange={(e) => setTitle(e.target.value)} placeholder="Ex. Tâches en retard" autoFocus /></div>

      {/* Changer de tableau de bord (issue #58). Replié par défaut : c'est un
          geste rare, et déplié il pousserait les réglages du widget plus bas à
          chaque ouverture de la fiche. */}
      {transferOffered && (
        <div className="lp-widget-transfer">
          <div className="lp-widget-transfer-row">
            <span className="lp-widget-transfer-label"><LayoutDashboard size={13} /> Emplacement</span>
            <span className="lp-widget-transfer-here">{transferTargets.find(transferIsHere)?.label || "—"}</span>
            <button
              type="button"
              className="lp-btn lp-btn-mini"
              onClick={() => setTransferOpen((v) => !v)}
              aria-expanded={transferOpen}
            >
              Changer de tableau de bord
              <ChevronDown size={12} style={{ transform: transferOpen ? "rotate(180deg)" : "none" }} />
            </button>
          </div>

          {transferOpen && (
            <div className="lp-widget-transfer-panel">
              <div className="lp-field">
                <label>Tableau de bord de destination</label>
                <div className="lp-color-select" ref={transferPickerRef}>
                  <button
                    type="button"
                    className="lp-color-select-btn"
                    onClick={() => setTransferPickerOpen((o) => !o)}
                    aria-expanded={transferPickerOpen}
                  >
                    <span className="lp-color-select-label">
                      {transferSelected ? `${transferSelected.label}${transferIsHere(transferSelected) ? " — ici" : ""}` : "Aucune destination"}
                    </span>
                    <ChevronDown size={14} />
                  </button>
                  {transferPickerOpen && (
                    <div className="lp-color-select-panel">
                      {/* Même seuil que les autres listes de Nexora : en dessous
                          de six entrées, un champ de recherche encombre plus
                          qu'il n'aide. */}
                      {transferTargets.length > 5 && (
                        <input
                          ref={transferSearchRef}
                          type="text"
                          className="lp-select-search"
                          placeholder="Rechercher un tableau ou une page…"
                          value={transferQuery}
                          onChange={(e) => setTransferQuery(e.target.value)}
                          onClick={(e) => e.stopPropagation()}
                        />
                      )}
                      {transferFiltered.map((t) => (
                        <button
                          type="button"
                          key={`${t.boardId}-${t.pageId}`}
                          className={"lp-color-select-option" + (t === transferSelected ? " active" : "")}
                          onClick={() => { setTransferIndex(String(transferTargets.indexOf(t))); setTransferPickerOpen(false); }}
                        >
                          {t.label}{transferIsHere(t) ? " — ici" : ""}
                        </button>
                      ))}
                      {transferFiltered.length === 0 && <div className="lp-select-empty">Aucun résultat</div>}
                    </div>
                  )}
                </div>
              </div>

              <div className="lp-field">
                <label>Ce qu'il advient du widget</label>
                <div className="lp-widget-transfer-modes">
                  <label className={transferMode === "move" ? "active" : undefined}>
                    <input type="radio" name="lp-widget-transfer-mode" checked={transferMode === "move"} onChange={() => setTransferMode("move")} />
                    <span><strong>Le déplacer</strong> — il quitte ce tableau de bord.</span>
                  </label>
                  <label className={transferMode === "duplicate" ? "active" : undefined}>
                    <input type="radio" name="lp-widget-transfer-mode" checked={transferMode === "duplicate"} onChange={() => setTransferMode("duplicate")} />
                    <span><strong>Le dupliquer</strong> — une copie indépendante part là-bas, l'original reste ici.</span>
                  </label>
                </div>
              </div>

              <p className="lp-widget-transfer-hint">
                Les réglages affichés dans cette fiche partent avec le widget. Sa position
                dans la grille est recalculée à l'arrivée : elle n'aurait pas de sens sur
                une autre page.
              </p>

              <button
                type="button"
                className="lp-btn lp-btn-primary"
                disabled={!isValid || !transferSelected || (transferMode === "move" && transferIsHere(transferSelected))}
                title={transferMode === "move" && transferSelected && transferIsHere(transferSelected) ? "Le widget est déjà sur ce tableau de bord" : undefined}
                onClick={() => onTransfer({ data: buildData(), target: { boardId: transferSelected.boardId, pageId: transferSelected.pageId }, mode: transferMode })}
              >
                {transferMode === "move" ? "Déplacer le widget" : "Dupliquer le widget"}
              </button>
            </div>
          )}
        </div>
      )}

      <div className="lp-widget-type-hard-selector">
        <div className="lp-widget-type-hard-selector-row">
          <span className="lp-widget-type-hard-selector-label">
            <LayoutDashboard size={14}/>
            Type de widget
          </span>
          <button
            type="button"
            className="lp-widget-type-hard-selector-current"
            onClick={()=>setTypePickerOpen((v)=>!v)}
            aria-expanded={typePickerOpen}
          >
            <span>{WIDGET_TYPE_META.find((m)=>m.key===type)?.label || type}</span>
            <ChevronDown size={13} style={{transform:typePickerOpen ? "rotate(180deg)" : "none"}}/>
          </button>
        </div>

        {typePickerOpen && (
          <div className="lp-widget-type-hard-selector-panel">
            <div className="lp-widget-type-search-wrap">
              <Search size={13} className="lp-widget-type-search-icon" />
              <input
                type="text"
                className="lp-widget-type-search"
                placeholder="Rechercher un type de widget…"
                value={typeSearch}
                onChange={(e)=>setTypeSearch(e.target.value)}
              />
              {typeSearch && (
                <button type="button" className="lp-icon-btn" onClick={()=>setTypeSearch("")}>
                  <X size={12}/>
                </button>
              )}
            </div>

            <div className="lp-widget-type-picker">
              {WIDGET_TYPE_GROUPS.map((g)=>{
                const q=typeSearch.trim().toLowerCase();
                const items=WIDGET_TYPE_META.filter((m)=>m.group===g && (!q || m.label.toLowerCase().includes(q)));
                if(!items.length) return null;
                return (
                  <div key={g} className="lp-widget-type-group">
                    <div className="lp-widget-type-group-label">{g}</div>
                    <div className="lp-widget-type-grid">
                      {items.map((m)=>{
                        const Icon=m.icon;
                        return (
                          <button
                            key={m.key}
                            type="button"
                            className={"lp-widget-type-card"+(type===m.key ? " active" : "")}
                            onClick={()=>{
                              setType(m.key);
                              if(widget) setTypePickerOpen(false);
                            }}
                          >
                            <span className="lp-widget-type-card-icon"><Icon size={15}/></span>
                            <span>{m.label}</span>
                          </button>
                        );
                      })}
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        )}
      </div>

      <div className="lp-widget-config-section">
        <div className="lp-widget-config-title"><SlidersHorizontal size={12} /> Configuration</div>
        {type === "criticalPath" && (
          <p style={{ fontSize: 12, color: "var(--text-600)", margin: 0 }}>Ce widget n'a pas de réglage spécifique — choisis les projets concernés dans le filtre ci-dessous.</p>
        )}
        {type === "orgchart" && (
          <div className="lp-field">
            {/* #295 : plan Métro, seule vue de l'Organigramme (la vue
                hiérarchique a été retirée). */}
            <p style={{ fontSize: 12, color: "var(--text-600)", marginTop: 0, marginBottom: 10 }}>
              Équipes imbriquées (réglable dans Réglages › Équipes) et personnes sous leur équipe ou leur responsable
              direct (réglable dans la fiche de la personne).
            </p>
            {(
              <>
                <p style={{ fontSize: 12, color: "var(--text-600)", margin: "8px 0 0" }}>
                  Une équipe = une ligne, une sous-équipe = une bifurcation, une personne = une station ; une personne avec
                  des subordonnés ouvre sa propre branche. Clic sur une station pour ouvrir sa fiche ; clic sur une équipe pour
                  replier sa ligne, double-clic pour ouvrir sa fiche.
                </p>
                <label className="lp-checkbox-line" style={{ marginTop: 8 }}>
                  <input type="checkbox" checked={orgMetroShowTransverse} onChange={() => setOrgMetroShowTransverse((v) => !v)} />
                  Afficher les correspondances transverses
                </label>
                {orgChartTeamOptions.length > 0 && (() => {
                  // Disposition par équipe (retour de test : deux réglages
                  // « membres » / « sous-équipes » étaient incompréhensibles).
                  // Une seule notion : HORIZONTALE = tout ce que contient
                  // l'équipe s'étale côte à côte (membres sur une ligne,
                  // sous-équipes côte à côte) ; VERTICALE = tout s'empile
                  // (membres l'un sous l'autre, sous-équipes l'une sous
                  // l'autre à droite). Une équipe cochée dans une liste est
                  // retirée de l'autre ; aucune = disposition par défaut
                  // (membres empilés, sous-équipes côte à côte).
                  const toggle = (id, setMine, setOther) => {
                    setMine((prev) => (prev.includes(id) ? prev.filter((x) => x !== id) : [...prev, id]));
                    setOther((prev) => prev.filter((x) => x !== id));
                  };
                  const count = (n, word) => (n ? n + " équipe" + (n > 1 ? "s" : "") + " " + word : "");
                  return (
                    <div className="lp-field lp-orgmetro-layout-field" style={{ marginTop: 10 }}>
                      <label>Disposition des équipes</label>
                      <p style={{ fontSize: 12, color: "var(--text-600)", margin: "0 0 8px" }}>
                        Par défaut, les membres d'une équipe sont l'un sous l'autre et ses sous-équipes côte à côte.
                        <strong> Horizontale</strong> : membres ET sous-équipes côte à côte. <strong>Verticale</strong> : membres ET
                        sous-équipes les uns sous les autres (sous-équipes rangées à droite du tronc). Pris en compte à l'enregistrement.
                      </p>
                      <div className="lp-orgmetro-layout-row">
                        <span className="lp-orgmetro-layout-name">Verticale</span>
                        <EntityFilterMultiSelect
                          options={orgChartTeamOptions}
                          selectedIds={orgMetroStackedTeams}
                          onToggle={(id) => toggle(id, setOrgMetroStackedTeams, setOrgMetroHorizontalTeams)}
                          onSelectAll={() => { setOrgMetroStackedTeams(orgChartTeamOptions.map((t) => t.id)); setOrgMetroHorizontalTeams([]); }}
                          onDeselectAll={() => setOrgMetroStackedTeams([])}
                          placeholder="Rechercher une équipe…"
                          emptyLabel="Aucune équipe"
                          summary={count(orgMetroStackedTeams.length, "à la verticale")}
                          compact
                        />
                      </div>
                      <div className="lp-orgmetro-layout-row">
                        <span className="lp-orgmetro-layout-name">Horizontale</span>
                        <EntityFilterMultiSelect
                          options={orgChartTeamOptions}
                          selectedIds={orgMetroHorizontalTeams}
                          onToggle={(id) => toggle(id, setOrgMetroHorizontalTeams, setOrgMetroStackedTeams)}
                          onSelectAll={() => { setOrgMetroHorizontalTeams(orgChartTeamOptions.map((t) => t.id)); setOrgMetroStackedTeams([]); }}
                          onDeselectAll={() => setOrgMetroHorizontalTeams([])}
                          placeholder="Rechercher une équipe…"
                          emptyLabel="Aucune équipe"
                          summary={count(orgMetroHorizontalTeams.length, "à l'horizontale")}
                          compact
                        />
                      </div>
                    </div>
                  );
                })()}
              </>
            )}
            <hr className="lp-divider" style={{ margin: "10px 0" }} />
            <label className="lp-checkbox-line">
              <input type="checkbox" checked={orgChartShowUnassigned} onChange={() => setOrgChartShowUnassigned((v) => !v)} />
              Afficher les ressources sans équipe
            </label>
            {(ctx.teamFolders || []).length > 0 && (
              <div className="lp-field" style={{ marginTop: 10 }}>
                <label>Dossier d'équipes <span style={{ fontWeight: 400, textTransform: "none", color: "var(--text-600)" }}>(facultatif — restreint aux équipes de ce dossier)</span></label>
                <SearchableSelect
                  value={orgChartFolderId}
                  options={sortedByName(ctx.teamFolders).map((f) => ({ id: f.id, label: f.name }))}
                  onChange={(id) => setOrgChartFolderId(id)}
                  placeholder="Tous les dossiers"
                  emptyLabel="Tous les dossiers"
                />
              </div>
            )}
            {orgChartTeamOptions.length > 0 && (
              <div className="lp-field" style={{ marginTop: 10 }}>
                <label>Équipes affichées</label>
                <EntityFilterMultiSelect
                  options={orgChartTeamOptions}
                  selectedIds={orgChartVisibleTeamIds}
                  onToggle={(id) => setOrgChartHiddenTeamIds((prev) => (prev.includes(id) ? prev.filter((x) => x !== id) : [...prev, id]))}
                  onSelectAll={() => setOrgChartHiddenTeamIds([])}
                  onDeselectAll={() => setOrgChartHiddenTeamIds(orgChartTeamOptions.map((t) => t.id))}
                  emptyLabel="Aucune équipe affichée"
                />
              </div>
            )}
            {orgChartMemberOptions.length > 0 && (
              <div className="lp-field lp-orgchart-inactive-field" style={{ marginTop: 10 }}>
                <label>Désigner les utilisateurs inactifs <span style={{ fontWeight: 400, textTransform: "none", color: "var(--text-600)" }}>(propres à ce widget — ils restent à leur place, grisés)</span></label>
                <EntityFilterMultiSelect
                  options={orgChartMemberOptions}
                  selectedIds={orgChartInactiveMembers}
                  onToggle={(id) => setOrgChartInactiveMembers((prev) => (prev.includes(id) ? prev.filter((x) => x !== id) : [...prev, id]))}
                  onSelectAll={() => setOrgChartInactiveMembers(orgChartMemberOptions.map((o) => o.id))}
                  onDeselectAll={() => setOrgChartInactiveMembers([])}
                  placeholder="Rechercher un utilisateur…"
                  compact
                  emptyLabel="Aucun utilisateur inactif"
                  summary={orgChartInactiveMembers.length ? orgChartInactiveMembers.length + " utilisateur" + (orgChartInactiveMembers.length > 1 ? "s" : "") + " inactif" + (orgChartInactiveMembers.length > 1 ? "s" : "") : ""}
                />
              </div>
            )}
            <div className="lp-field" style={{ marginTop: 10 }}>
              <label>Libellé de la racine <span style={{ fontWeight: 400, textTransform: "none", color: "var(--text-600)" }}>(facultatif — utilisé seulement quand plusieurs équipes de premier niveau se regroupent ; station centrale du Métro)</span></label>
              <input type="text" value={orgChartRootLabel} onChange={(e) => setOrgChartRootLabel(e.target.value)} placeholder="Organisation" />
            </div>
            <hr className="lp-divider" style={{ margin: "12px 0 10px" }} />
            <div className="lp-field lp-orgrel-field">
              <label>Relations <span style={{ fontWeight: 400, textTransform: "none", color: "var(--text-600)" }}>(propres à ce widget — entre deux équipes, une équipe et une personne, ou deux personnes ; affichées sur le plan Métro)</span></label>
              {orgChartRelations.length === 0 && <p style={{ fontSize: 12, color: "var(--text-600)", margin: "0 0 8px" }}>Aucune relation pour l'instant.</p>}
              {orgChartRelations.map((r) => {
                const incomplete = !r.from || !r.to;
                const same = r.from && r.from === r.to;
                return (
                  <div key={r.id} className="lp-orgrel-row">
                    <div className="lp-orgrel-ends">
                      <SearchableSelect value={r.from || ""} options={orgChartRelationChoices} onChange={(id) => updateOrgRelation(r.id, { from: id, fromAt: "" })} placeholder="De…" emptyLabel="De…" />
                      <span className="lp-orgrel-arrow" aria-hidden="true">→</span>
                      <SearchableSelect value={r.to || ""} options={orgChartRelationChoices} onChange={(id) => updateOrgRelation(r.id, { to: id, toAt: "" })} placeholder="Vers…" emptyLabel="Vers…" />
                    </div>
                    {[["from", "fromAt", "De"], ["to", "toAt", "Vers"]].map(([end, atKey, word]) => {
                      // Personne présente à plusieurs endroits : choix de
                      // l'occurrence reliée (équipe où se trouve sa station).
                      const p = orgRelationRefParse(r[end]);
                      const occ = p && p.type === "person" ? orgChartPersonOccurrenceTeams(p.id, ctx.teams, ctx.teamMembers) : [];
                      if (occ.length < 2) return null;
                      return (
                        <div key={end} className="lp-orgrel-occurrence">
                          <span>{word} · {p.id} dans</span>
                          <SearchableSelect value={r[atKey] || ""} options={occ} onChange={(id) => updateOrgRelation(r.id, { [atKey]: id })} placeholder="Première occurrence" emptyLabel="Première occurrence" />
                        </div>
                      );
                    })}
                    <div className="lp-orgrel-legend">
                      <input type="text" value={r.label || ""} maxLength={ORGRELATION_LABEL_MAX} onChange={(e) => updateOrgRelation(r.id, { label: e.target.value })} placeholder="Légende (facultatif)" aria-label="Légende de la relation" />
                      <button type="button" className="lp-icon-btn" onClick={() => setOrgChartRelations((prev) => prev.filter((x) => x.id !== r.id))} title="Supprimer la relation" aria-label="Supprimer la relation"><Trash2 size={13} /></button>
                    </div>
                    {(incomplete || same) && (
                      <p className="lp-orgrel-hint">{same ? "Choisis deux extrémités différentes." : "Relation incomplète : elle ne sera pas enregistrée tant que les deux extrémités ne sont pas choisies."}</p>
                    )}
                  </div>
                );
              })}
              <button type="button" className="lp-btn" onClick={() => setOrgChartRelations((prev) => [...prev, { id: "rel-" + Date.now().toString(36) + "-" + prev.length, from: "", to: "", label: "" }])}>
                <Plus size={13} /> Créer une relation
              </button>
            </div>
          </div>
        )}
        {type === "habitHeatmap" && (
          <div className="lp-field">
            <label>Vue</label>
            <div className="lp-density-row">
              <button type="button" className={"lp-density-btn" + (habitHeatmapView === "month" ? " active" : "")} onClick={() => setHabitHeatmapView("month")}>Mensuel</button>
              <button type="button" className={"lp-density-btn" + (habitHeatmapView === "quarter" ? " active" : "")} onClick={() => setHabitHeatmapView("quarter")}>3 mois</button>
              <button type="button" className={"lp-density-btn" + (habitHeatmapView === "year" ? " active" : "")} onClick={() => setHabitHeatmapView("year")}>Annuel</button>
            </div>
            <p style={{ fontSize: 12, color: "var(--text-600)", marginTop: 6, marginBottom: 0 }}>
              Le Thème affiché se choisit dans le widget (icône d'options), pas ici.
            </p>
          </div>
        )}
        {type === "dominoEffect" && (
          <div className="lp-field">
            <label>Trier par</label>
            <div className="lp-density-row">
              <button type="button" className={"lp-density-btn" + (dominoSortBy === "score" ? " active" : "")} onClick={() => setDominoSortBy("score")}>Impact total (défaut)</button>
              <button type="button" className={"lp-density-btn" + (dominoSortBy === "directImpact" ? " active" : "")} onClick={() => setDominoSortBy("directImpact")}>Nombre de tâches bloquées</button>
            </div>
            <p style={{ fontSize: 12, color: "var(--text-600)", marginTop: 6, marginBottom: 0 }}>
              {dominoSortBy === "directImpact"
                ? "Classe par nombre de tâches bloquées directement — le tri de l'ancien widget « Tâches bloquantes »."
                : "Classe par impact total : tâches bloquées (directes et en cascade), chemin critique et échéance."}
            </p>
          </div>
        )}
      {type === "customCard" && (
        <div className="lp-custom-card-config">
          <div className="lp-row2">
            <div className="lp-field">
              <label>Source des informations de tâche</label>
              <select value={cardTaskMode} onChange={(e)=>setCardTaskMode(e.target.value)}>
                <option value="first">Première tâche du filtre</option>
                <option value="fixed">Une tâche précise</option>
              </select>
            </div>
            <div className="lp-field">
              <label>Colonnes de la carte</label>
              <select value={cardColumns} onChange={(e)=>setCardColumns(Number(e.target.value))}>
                <option value={1}>1 colonne</option>
                <option value={2}>2 colonnes</option>
                <option value={3}>3 colonnes</option>
              </select>
            </div>
          </div>

          <div className="lp-custom-card-appearance">
            <div className="lp-custom-card-appearance-title">
              <Palette size={13}/> Apparence de la carte
            </div>
            <div className="lp-row3">
              <div className="lp-field">
                <label>Style</label>
                <select value={cardSurface} onChange={(e)=>setCardSurface(e.target.value)}>
                  <option value="plain">Classique</option>
                  <option value="soft">Teinté</option>
                  <option value="outline">Contour accentué</option>
                  <option value="minimal">Minimal</option>
                </select>
              </div>
              <div className="lp-field">
                <label>Arrondi</label>
                <select value={cardRadius} onChange={(e)=>setCardRadius(e.target.value)}>
                  <option value="none">Aucun</option>
                  <option value="small">Petit</option>
                  <option value="medium">Moyen</option>
                  <option value="large">Grand</option>
                </select>
              </div>
              <div className="lp-field">
                <label>Couleur d'accent</label>
                <div className="lp-custom-card-color-row">
                  <input type="color" value={cardAccentColor || "#4F6AF5"} onChange={(e)=>setCardAccentColor(e.target.value)}/>
                  <button type="button" className="lp-btn" onClick={()=>setCardAccentColor("")}>Auto</button>
                </div>
              </div>
            </div>
            <div className="lp-row2">
              <div className="lp-field">
                <label>Fond général</label>
                <div className="lp-custom-card-color-row">
                  <input type="color" value={cardBackground || "#FFFFFF"} onChange={(e)=>setCardBackground(e.target.value)}/>
                  <button type="button" className="lp-btn" onClick={()=>setCardBackground("")}>Auto</button>
                </div>
              </div>
              <div className="lp-field">
                <label>Bordure générale</label>
                <div className="lp-custom-card-color-row">
                  <input type="color" value={cardBorderColor || "#D9DEE7"} onChange={(e)=>setCardBorderColor(e.target.value)}/>
                  <button type="button" className="lp-btn" onClick={()=>setCardBorderColor("")}>Auto</button>
                </div>
              </div>
            </div>
          </div>

          {cardTaskMode === "fixed" && (
            <div className="lp-field">
              <label>Tâche de référence</label>
              <TaskDetailPicker tasks={ctx.tasks} projects={ctx.projects} value={cardTaskId} onChange={setCardTaskId}/>
            </div>
          )}

          <div className="lp-custom-card-blocks-head">
            <div>
              <strong>Blocs affichés</strong>
              <span>Les agrégations utilisent les tâches du filtre ; les autres blocs utilisent la tâche de référence.</span>
            </div>
            <button type="button" className="lp-btn" onClick={addCardBlock}><Plus size={12}/> Ajouter un bloc</button>
          </div>

          <div className="lp-custom-card-block-editor-list">
            {cardBlocks.map((b,i)=>(
              <div key={b.id} className="lp-custom-card-block-editor">
                <div className="lp-custom-card-block-editor-top">
                  <span className="lp-custom-card-block-index">{i+1}</span>
                  <select value={b.kind} onChange={(e)=>updateCardBlock(b.id,{kind:e.target.value})}>
                    {CUSTOM_CARD_BLOCK_TYPES.map((o)=><option key={o.key} value={o.key}>{o.label}</option>)}
                  </select>
                  <button type="button" className="lp-icon-btn" disabled={i===0} onClick={()=>moveCardBlock(b.id,-1)} title="Monter"><ChevronUp size={13}/></button>
                  <button type="button" className="lp-icon-btn" disabled={i===cardBlocks.length-1} onClick={()=>moveCardBlock(b.id,1)} title="Descendre"><ChevronDown size={13}/></button>
                  <button type="button" className="lp-icon-btn" onClick={()=>removeCardBlock(b.id)} title="Supprimer"><Trash2 size={13}/></button>
                </div>

                <div className="lp-row3">
                  <div className="lp-field">
                    <label>Libellé <span style={{fontWeight:400,textTransform:"none"}}>(facultatif)</span></label>
                    <input value={b.label || ""} onChange={(e)=>updateCardBlock(b.id,{label:e.target.value})} placeholder="Ex. Échéance"/>
                  </div>
                  <div className="lp-field">
                    <label>Importance visuelle</label>
                    <select value={b.emphasis || "normal"} onChange={(e)=>updateCardBlock(b.id,{emphasis:e.target.value})}>
                      <option value="hero">Grande</option>
                      <option value="normal">Normale</option>
                      <option value="small">Compacte</option>
                    </select>
                  </div>
                  <div className="lp-field">
                    <label>Largeur</label>
                    <select value={b.span || "auto"} onChange={(e)=>updateCardBlock(b.id,{span:e.target.value})}>
                      <option value="auto">Automatique</option>
                      <option value="full">Toute la ligne</option>
                    </select>
                  </div>
                </div>

                <div className="lp-custom-card-block-style">
                  <div className="lp-custom-card-block-style-head">
                    <span>Style du bloc</span>
                    <label className="lp-checkbox-line">
                      <input
                        type="checkbox"
                        checked={b.showLabel !== false}
                        onChange={(e)=>updateCardBlock(b.id,{showLabel:e.target.checked})}
                      />
                      Afficher le libellé
                    </label>
                    <label className="lp-checkbox-line">
                      <input
                        type="checkbox"
                        checked={b.showIcon !== false}
                        onChange={(e)=>updateCardBlock(b.id,{showIcon:e.target.checked})}
                      />
                      Icône
                    </label>
                  </div>

                  {b.showIcon !== false && (
                    <div className="lp-field">
                      <label>Icône du bloc</label>
                      <IconEditor
                        icon={b.icon || CUSTOM_CARD_DEFAULT_ICONS[b.kind] || ""}
                        setIcon={(icon)=>updateCardBlock(b.id,{icon})}
                      />
                    </div>
                  )}

                  <div className="lp-row3">
                    <div className="lp-field">
                      <label>Couleur texte / icône</label>
                      <div className="lp-custom-card-color-row">
                        <input type="color" value={b.color || cardAccentColor || "#4F6AF5"} onChange={(e)=>updateCardBlock(b.id,{color:e.target.value})}/>
                        <button type="button" className="lp-btn" onClick={()=>updateCardBlock(b.id,{color:""})}>Auto</button>
                      </div>
                    </div>
                    <div className="lp-field">
                      <label>Fond du bloc</label>
                      <div className="lp-custom-card-color-row">
                        <input type="color" value={b.bgColor || "#FFFFFF"} onChange={(e)=>updateCardBlock(b.id,{bgColor:e.target.value})}/>
                        <button type="button" className="lp-btn" onClick={()=>updateCardBlock(b.id,{bgColor:""})}>Auto</button>
                      </div>
                    </div>
                    <div className="lp-field">
                      <label>Accent</label>
                      <select value={b.accent || "none"} onChange={(e)=>updateCardBlock(b.id,{accent:e.target.value})}>
                        <option value="none">Aucun</option>
                        <option value="left">Barre gauche</option>
                        <option value="top">Barre haute</option>
                        <option value="icon">Pastille icône</option>
                      </select>
                    </div>
                  </div>
                </div>

                {b.kind === "aggregate" && (
                  <div className="lp-field">
                    <label>Mesure agrégée</label>
                    <select value={b.metric || "count"} onChange={(e)=>updateCardBlock(b.id,{metric:e.target.value})}>
                      {WIDGET_METRICS.map((m)=><option key={m.key} value={m.key}>{m.label}</option>)}
                    </select>
                  </div>
                )}



                {b.kind === "staticText" && (
                  <div className="lp-field">
                    <label>Texte</label>
                    <textarea rows={2} value={b.text || ""} onChange={(e)=>updateCardBlock(b.id,{text:e.target.value})} placeholder="Texte libre à afficher sur la carte…"/>
                  </div>
                )}

                {b.kind === "daysRemaining" && (
                  <>
                    <div className="lp-field">
                      <label>Suivre</label>
                      <div className="lp-density-row">
                        <button type="button" className={"lp-density-btn" + ((b.countdownMode || "date") === "date" ? " active" : "")} onClick={()=>updateCardBlock(b.id,{countdownMode:"date"})}>Une date fixe</button>
                        <button type="button" className={"lp-density-btn" + (b.countdownMode === "task" ? " active" : "")} onClick={()=>updateCardBlock(b.id,{countdownMode:"task"})}>Une tâche / un jalon</button>
                        <button type="button" className={"lp-density-btn" + (b.countdownMode === "filter" ? " active" : "")} onClick={()=>updateCardBlock(b.id,{countdownMode:"filter"})}>Prochaine échéance filtrée</button>
                      </div>
                    </div>
                    {(b.countdownMode || "date") === "date" && (
                      <div className="lp-field"><label>Date cible</label><input type="date" value={b.countdownDate || ""} onChange={(e)=>updateCardBlock(b.id,{countdownDate:e.target.value})} /></div>
                    )}
                    {b.countdownMode === "task" && (
                      <div className="lp-field">
                        <label>Tâche ou jalon</label>
                        <select value={b.countdownTaskId || ""} onChange={(e)=>updateCardBlock(b.id,{countdownTaskId:e.target.value})}>
                          <option value="">— Choisir —</option>
                          {ctx.tasks.map((t) => <option key={t.id} value={t.id}>{t.title} ({fmtShort(t.end)})</option>)}
                        </select>
                      </div>
                    )}
                    {b.countdownMode === "filter" && (
                      <p style={{ fontSize: 12, color: "var(--text-600)", marginTop: 0, marginBottom: 0 }}>La tâche dont l'échéance est la plus proche parmi celles qui correspondent au filtre du widget (plus bas) est suivie automatiquement.</p>
                    )}
                  </>
                )}
              </div>
            ))}
            {!cardBlocks.length && <div className="lp-empty" style={{padding:12}}>Ajoute au moins un bloc à la carte.</div>}
          </div>
        </div>
      )}
      {type === "chart" && (
        <>
          <div className="lp-field">
            <label>Style de graphique</label>
            <select value={chartStyle} onChange={(e) => setChartStyle(e.target.value)}>
              {CHART_STYLES.map((s) => <option key={s.key} value={s.key}>{s.label}</option>)}
            </select>
          </div>
          {chartStyle === "gauge" && (
            <div className="lp-field">
              <label>Mesure</label>
              <select value={gaugeMetric} onChange={(e) => setGaugeMetric(e.target.value)}>
                {GAUGE_METRICS.map((m) => <option key={m.key} value={m.key}>{m.label}</option>)}
              </select>
            </div>
          )}
          {chartStyle === "line" && (
            <p style={{ fontSize: 12, color: "var(--text-600)", marginTop: -6 }}>La courbe montre l'évolution du nombre de tâches, mois par mois, selon leur date de fin.</p>
          )}
          {(chartStyle === "pie" || chartStyle === "bar" || chartStyle === "barh") && (
            <div className="lp-field">
              <label>Regrouper par</label>
              <select value={groupBy} onChange={(e) => setGroupBy(e.target.value)}>
                <WidgetGroupByOptions ctx={ctx} />
              </select>
            </div>
          )}
          {chartStyle === "stackedBar" && (
            <div className="lp-row2">
              <div className="lp-field">
                <label>Axe principal</label>
                <select value={groupBy} onChange={(e) => setGroupBy(e.target.value)}>
                  <WidgetGroupByOptions ctx={ctx} />
                </select>
              </div>
              <div className="lp-field">
                <label>Empilement</label>
                <select value={stackBy} onChange={(e) => setStackBy(e.target.value)}>
                  <WidgetGroupByOptions ctx={ctx} />
                </select>
              </div>
            </div>
          )}
        </>
      )}
      {type === "list" && (
        <div className="lp-row2">
          <div className="lp-field">
            <label>Trier par</label>
            <select value={sortBy} onChange={(e) => setSortBy(e.target.value)}>
              <option value="end">Date de fin</option>
              <option value="progress">Avancement</option>
              <option value="title">Titre</option>
              <option value="inactivity">Inactivité</option>
            </select>
          </div>
          <div className="lp-field"><label>Nombre max.</label><input type="number" min="1" max="30" value={limit} onChange={(e) => setLimit(e.target.value)} /></div>
        </div>
      )}

      {type === "list" && (
        <div className="lp-field">
          <label>Grouper par <span style={{ fontWeight: 400, textTransform: "none", color: "var(--text-600)" }}>(distingue visuellement les tâches par sections)</span></label>
          <select value={listGroupBy} onChange={(e) => setListGroupBy(e.target.value)}>
            <option value="none">Aucun</option>
            <option value="project">Projet</option>
            <option value="status">Statut</option>
            <option value="taskType">Type</option>
            <option value="assignee">Responsable</option>
            <option value="inactivity">Inactivité</option>
            <option value="period">Période</option>
          </select>
        </div>
      )}

      {type === "taskDetail" && (
        <div className="lp-field">
          <label>Tâche à afficher</label>
          <TaskDetailPicker
            tasks={taskDetailPickerTasks}
            projects={ctx.projects}
            value={taskDetailTaskId}
            onChange={setTaskDetailTaskId}
          />
          <p style={{fontSize:12,color:"var(--text-600)",marginTop:6,marginBottom:0}}>
            Recherche par nom de tâche ou par projet. Le projet est affiché pour chaque résultat — seules les tâches correspondant aux filtres ci-dessous (et à ceux de l'onglet) sont proposées.
          </p>
        </div>
      )}

      {type === "userProfile" && (
        <div className="lp-field">
          <label>Personne</label>
          <select value={userProfileMember} onChange={(e) => setUserProfileMember(e.target.value)}>
            <option value="">— Choisir —</option>
            {sortedByName(ctx.teamMembers || []).map((m) => <option key={m.id} value={m.name}>{m.name}</option>)}
          </select>
        </div>
      )}

      {type === "note" && (
        <div className="lp-field">
          <label>Contenu</label>
          <textarea className="lp-widget-note-edit" value={content} onChange={(e) => setContent(e.target.value)} placeholder="Écris ta note ici…" rows={5} />
        </div>
      )}

      {type === "budget" && (
        <>
          <div className="lp-field">
            <label>Projet</label>
            <ProjectSelect projects={ctx.projects} value={budgetProjectId} onChange={setBudgetProjectId} allowCurrent />
          </div>
          <div className="lp-field">
            <label>Mesure</label>
            <select value={budgetMetric} onChange={(e) => setBudgetMetric(e.target.value)}>
              <option value="engaged">Total dépensé (réel)</option>
              <option value="pctConsumed">% du budget consommé</option>
              <option value="reste">Reste disponible</option>
              <option value="byCategory">Répartition par catégorie</option>
            </select>
          </div>
        </>
      )}




      {type === "budgetBurnRate" && (
        <div className="lp-field">
          <label>Projet</label>
          <ProjectSelect projects={ctx.projects} value={burnRateProjectId} onChange={setBurnRateProjectId} />
          <p style={{ fontSize: 12, color: "var(--text-600)", marginTop: 6, marginBottom: 0 }}>Calculé à partir des dépenses réellement enregistrées dans le Chiffrage de ce projet — nécessite qu'au moins une dépense datée y soit renseignée.</p>
        </div>
      )}


      {(type === "nextBestAction" || type === "dailyBriefing") && (
        <label className="lp-checkbox-line" style={{ marginTop: -4 }}>
          <input type="checkbox" checked={onlyMine} onChange={(e) => setOnlyMine(e.target.checked)} /> Seulement mes tâches
        </label>
      )}


      {type === "heatmapGrid" && (
        <>
          <p style={{ fontSize: 12, color: "var(--text-600)", marginTop: -6, marginBottom: 10 }}>
            Une case = un croisement entre les deux champs choisis. Toutes les cases ont la même taille : c'est la couleur
            seule qui porte l'information, là où le Treemap encode aussi une surface. Une case hachurée n'a aucune tâche ;
            une case colorée affichant 0 en a, mais aucune ne compte pour la mesure. Le filtre général du widget (plus bas)
            décide du périmètre.
          </p>
          <div style={{ display: "flex", gap: 8 }}>
            <div className="lp-field" style={{ flex: 1, margin: 0 }}>
              <label>Lignes</label>
              <select value={heatmapRowField} onChange={(e) => setHeatmapRowField(e.target.value)}>
                {HEATMAP_AXIS_FIELDS.map((k) => <option value={k} key={k}>{HEATMAP_AXIS_LABELS[k]}</option>)}
              </select>
            </div>
            <div className="lp-field" style={{ flex: 1, margin: 0 }}>
              <label>Colonnes</label>
              <select value={heatmapColField} onChange={(e) => setHeatmapColField(e.target.value)}>
                {HEATMAP_AXIS_FIELDS.map((k) => <option value={k} key={k}>{HEATMAP_AXIS_LABELS[k]}</option>)}
              </select>
            </div>
          </div>
          {heatmapRowField === heatmapColField && (
            <p style={{ fontSize: 12, color: "var(--warning)", marginTop: 6, marginBottom: 0 }}>
              Les deux axes sont identiques : la grille se réduirait à une diagonale. Un second champ sera choisi
              à l'enregistrement.
            </p>
          )}
          <div className="lp-field" style={{ marginTop: 8 }}>
            <label>Mesure portée par la couleur</label>
            <select value={heatmapMetric} onChange={(e) => setHeatmapMetric(e.target.value)}>
              {HEATMAP_METRICS.map((k) => <option value={k} key={k}>{HEATMAP_METRIC_LABELS[k]}</option>)}
            </select>
          </div>
          <div className="lp-field" style={{ marginTop: 8 }}>
            <label>Palette</label>
            <select value={heatmapPalette} onChange={(e) => setHeatmapPalette(e.target.value)}>
              {Object.entries(TREEMAP_PALETTES).map(([k, p]) => <option value={k} key={k}>{p.label}</option>)}
            </select>
          </div>
          <label className="lp-checkbox-line" style={{ marginTop: 8 }}>
            <input type="checkbox" checked={heatmapShowValues} onChange={(e) => setHeatmapShowValues(e.target.checked)} />
            Afficher la valeur dans chaque case
          </label>
          <label className="lp-checkbox-line">
            <input type="checkbox" checked={heatmapShowDescPane} onChange={(e) => setHeatmapShowDescPane(e.target.checked)} />
            Volet Description (clic sur une tâche de la liste = sa description, à droite)
          </label>
        </>
      )}
      {type === "heatmapMonth" && (
        <p style={{ fontSize: 12, color: "var(--text-600)", marginTop: -6, marginBottom: 10 }}>
          Ce widget n'a pas de réglage spécifique — choisis les projets concernés dans le filtre ci-dessous.
          Clic sur une tâche de la liste : sa description à droite (volet 3) — double-clic : sa fiche complète.
        </p>
      )}
      {(type === "habitQuick" || type === "habitHeatmap" || type === "habitPixel") && (
        <p style={{ fontSize: 12, color: "var(--text-600)", marginTop: -6, marginBottom: 10 }}>
          Ce widget n'a pas de réglage ici — le Thème (Heatmap) et la date (Quick Habit) se choisissent directement
          dans le widget. Les Thèmes et leurs Habitudes se configurent dans Réglages → Thèmes d'habitudes.
        </p>
      )}
      {type === "teamCatalog" && (
        <p style={{ fontSize: 12, color: "var(--text-600)", marginTop: -6, marginBottom: 10 }}>
          Ce widget n'a pas de réglage ici — il reprend Réglages → Utilisateurs & Équipes tel quel (utilisateurs,
          équipes, dossiers d'équipes, ajout rapide de membre avec poste), avec défilement interne.
        </p>
      )}
      {type === "projectTreemap" && (
        <>
          <p style={{ fontSize: 12, color: "var(--text-600)", marginTop: -6, marginBottom: 10 }}>
            Une tuile = une valeur du champ choisi ci-dessous. La surface vient du nombre de tâches de la tuile retenues par
            le filtre de taille ; la couleur, du réglage « Coloration ». Le filtre général du widget (plus bas) décide d'abord
            du périmètre.
          </p>

          <div className="lp-widget-config-title" style={{ marginTop: 4 }}><Search size={12} /> Données</div>
          <div className="lp-field">
            <label>Une tuile représente</label>
            <select value={treemapTileBy} onChange={(e) => setTreemapTileBy(e.target.value)}>
              {TREEMAP_TILE_BY.map((key) => (
                <option value={key} key={key}>{TREEMAP_TILE_BY_LABELS[key].label}</option>
              ))}
            </select>
            {treemapTileBy !== "project" && (
              <p style={{ fontSize: 12, color: "var(--text-600)", marginTop: 6, marginBottom: 0 }}>
                Dossier, priorité, budget et risques appartiennent au projet : ces champs de tuile et ces regroupements sont
                retirés tant que les tuiles ne sont pas des projets. Ouvrir, modifier ou filtrer sur la tuile reste également
                propre aux projets.
              </p>
            )}
          </div>
          <div className="lp-field">
            <label>Filtre de taille <span style={{ fontWeight: 400, textTransform: "none", color: "var(--text-600)" }}>(vide = toutes les tâches du périmètre)</span></label>
            <div className="lp-widget-appearance-toggle" onClick={() => setTreemapSizeFilterOpen((v) => !v)}>
              <ChevronRight size={13} style={{ transform: treemapSizeFilterOpen ? "rotate(90deg)" : "none" }} />
              <Filter size={13} /> Tâches comptées pour la surface
              <span className="lp-widget-appearance-hint">{activeWidgetFilterCount(treemapSizeFilter) || "aucune"} condition{activeWidgetFilterCount(treemapSizeFilter) > 1 ? "s" : ""}</span>
            </div>
            {treemapSizeFilterOpen && (
              <div className="lp-widget-appearance-panel">
                <TaskFilterFields filter={treemapSizeFilter} setFilter={setTreemapSizeFilter} ctx={ctx} />
              </div>
            )}
          </div>
          <label className="lp-checkbox-line">
            <input type="checkbox" checked={treemapShowZeroProjects} onChange={(e) => setTreemapShowZeroProjects(e.target.checked)} />
            Afficher les {TREEMAP_TILE_BY_LABELS[treemapTileBy].plural} sans tâche correspondante, en tuile minimale
          </label>

          <div className="lp-widget-config-title" style={{ marginTop: 14 }}><Palette size={12} /> Encodage visuel</div>
          <div className="lp-field">
            <label>Coloration des projets</label>
            <div className="lp-density-row">
              <button type="button" className={"lp-density-btn" + (treemapColorMode === "sizeFilterGradient" ? " active" : "")} onClick={() => setTreemapColorMode("sizeFilterGradient")}>Même filtre</button>
              <button type="button" className={"lp-density-btn" + (treemapColorMode === "secondaryFilterGradient" ? " active" : "")} onClick={() => setTreemapColorMode("secondaryFilterGradient")}>Second filtre</button>
              <button type="button" className={"lp-density-btn" + (treemapColorMode === "averageCriticality" ? " active" : "")} onClick={() => { setTreemapColorMode("averageCriticality"); setTreemapPalette("levels"); }}>Criticité moyenne</button>
              <button type="button" className={"lp-density-btn" + (treemapColorMode === "averageDrift" ? " active" : "")} onClick={() => setTreemapColorMode("averageDrift")}>Dérive</button>
            </div>
            <p className="lp-gantt-annot-hint">
              {treemapColorMode === "sizeFilterGradient" && "La couleur suit le même comptage que la surface : plus un projet est gros, plus il est intense."}
              {treemapColorMode === "secondaryFilterGradient" && "La couleur suit un second comptage, indépendant de la surface — par exemple taille = tâches actives, couleur = tâches en retard."}
              {treemapColorMode === "averageCriticality" && `Criticité = moyenne, sur les tâches retenues, de : retard ${TREEMAP_CRITICALITY_WEIGHTS.late}, criticité urgente ${TREEMAP_CRITICALITY_WEIGHTS.urgent}, échéance ≤ ${TREEMAP_DUE_SOON_DAYS} j ${TREEMAP_CRITICALITY_WEIGHTS.dueSoon}, jalon ${TREEMAP_CRITICALITY_WEIGHTS.milestone}, inactivité ≥ ${TREEMAP_STALE_DAYS} j ${TREEMAP_CRITICALITY_WEIGHTS.stale}, projet prioritaire ${TREEMAP_CRITICALITY_WEIGHTS.projectPriorityHigh}. Une tâche terminée vaut 0. La règle est rappelée dans l'infobulle de chaque tuile.`}
              {treemapColorMode === "averageDrift" && "La couleur suit le retard moyen (en jours) des tâches ayant une référence de comparaison — manuelle, ou capturée automatiquement à leur première apparition (#150). Un projet en avance ou à l'heure reste neutre : seul le retard est signalé."}
            </p>
          </div>
          {treemapColorMode === "secondaryFilterGradient" && (
            <div className="lp-field">
              <label>Filtre de coloration</label>
              <div className="lp-widget-appearance-toggle" onClick={() => setTreemapColorFilterOpen((v) => !v)}>
                <ChevronRight size={13} style={{ transform: treemapColorFilterOpen ? "rotate(90deg)" : "none" }} />
                <Filter size={13} /> Tâches comptées pour la couleur
                <span className="lp-widget-appearance-hint">{activeWidgetFilterCount(treemapColorFilter) || "aucune"} condition{activeWidgetFilterCount(treemapColorFilter) > 1 ? "s" : ""}</span>
              </div>
              {treemapColorFilterOpen && (
                <div className="lp-widget-appearance-panel">
                  <TaskFilterFields filter={treemapColorFilter} setFilter={setTreemapColorFilter} ctx={ctx} />
                </div>
              )}
            </div>
          )}
          <div className="lp-row2">
            <div className="lp-field">
              <label>Palette</label>
              <select value={treemapPalette} onChange={(e) => setTreemapPalette(e.target.value)}>
                {Object.entries(TREEMAP_PALETTES).map(([key, p]) => <option key={key} value={key}>{p.label}</option>)}
              </select>
            </div>
            <div className="lp-field">
              <label>Sens</label>
              <div className="lp-density-row">
                <button type="button" className={"lp-density-btn" + (treemapDirection === "lowToHigh" ? " active" : "")} onClick={() => setTreemapDirection("lowToHigh")}>Croissant</button>
                <button type="button" className={"lp-density-btn" + (treemapDirection === "highToLow" ? " active" : "")} onClick={() => setTreemapDirection("highToLow")}>Décroissant</button>
              </div>
            </div>
          </div>
          <label className="lp-checkbox-line">
            <input type="checkbox" checked={treemapShowLegend} onChange={(e) => setTreemapShowLegend(e.target.checked)} /> Afficher la légende (cliquable pour isoler une tranche)
          </label>

          <div className="lp-widget-config-title" style={{ marginTop: 14 }}><Layers size={12} /> Contenu des tuiles</div>
          <div className="lp-field">
            <label>Champs affichés <span style={{ fontWeight: 400, textTransform: "none", color: "var(--text-600)" }}>(dans cet ordre — les petites tuiles n'en gardent que le début)</span></label>
            <div style={{ display: "flex", flexDirection: "column", gap: 4 }}>
              {treemapFields.map((key) => (
                <div className="lp-gantt-annot-head" key={key} style={{ cursor: "default" }}>
                  <span className="lp-gantt-annot-summary"><strong>{treemapFieldLabel(key)}</strong></span>
                  <span className="lp-gantt-annot-actions">
                    <button type="button" className="lp-icon-btn" onClick={() => moveTreemapField(key, -1)} disabled={treemapFields[0] === key} title="Monter"><ChevronUp size={12} /></button>
                    <button type="button" className="lp-icon-btn" onClick={() => moveTreemapField(key, 1)} disabled={treemapFields[treemapFields.length - 1] === key} title="Descendre"><ChevronDown size={12} /></button>
                    <button type="button" className="lp-icon-btn" onClick={() => setTreemapFields((prev) => prev.filter((k) => k !== key))} disabled={key === "projectName"} title={key === "projectName" ? "Le nom du projet est toujours affiché" : "Retirer"}><X size={12} /></button>
                  </span>
                </div>
              ))}
            </div>
            <div style={{ marginTop: 6 }}>
              <DropdownButton label={`${treemapFields.length} champ${treemapFields.length > 1 ? "s" : ""} affiché${treemapFields.length > 1 ? "s" : ""}`} icon={<Plus size={13} />} title="Champs disponibles">
                <div className="lp-dropdown-group-label">Champs disponibles</div>
                {treemapFieldCatalogue.map((f) => (
                  <label className="lp-checkbox-line" key={f.key}>
                    <input
                      type="checkbox"
                      checked={treemapFields.includes(f.key)}
                      disabled={f.key === "projectName"}
                      onChange={() => setTreemapFields((prev) => (prev.includes(f.key) ? prev.filter((k) => k !== f.key) : [...prev, f.key]))}
                    /> {f.label}
                  </label>
                ))}
              </DropdownButton>
            </div>
          </div>
          <label className="lp-checkbox-line">
            <input type="checkbox" checked={treemapShowProgressRing} onChange={(e) => setTreemapShowProgressRing(e.target.checked)} /> Afficher la progression sous forme d'anneau (champ « Progression »)
          </label>
          <label className="lp-checkbox-line">
            <input type="checkbox" checked={treemapShowUpcoming} onChange={(e) => setTreemapShowUpcoming(e.target.checked)} /> Afficher les prochaines tâches du projet
          </label>
          {treemapShowUpcoming && (
            <p className="lp-gantt-annot-hint">
              Les tâches non terminées qui portent une échéance, de la plus ancienne à la plus récente, en rouge si elles sont en retard.
              Le nombre affiché s'adapte tout seul à la hauteur de chaque tuile ; le reste est annoncé par un « + N autres ».
            </p>
          )}
          <label className="lp-checkbox-line">
            <input type="checkbox" checked={treemapCompact} onChange={(e) => setTreemapCompact(e.target.checked)} /> Mode compact — plus d'informations sur les petites tuiles
          </label>

          <div className="lp-widget-config-title" style={{ marginTop: 14 }}><Crosshair size={12} /> Interactions</div>
          <label className="lp-checkbox-line">
            <input type="checkbox" checked={treemapOpenOnClick} onChange={(e) => setTreemapOpenOnClick(e.target.checked)} /> Ouvrir le projet au clic sur sa tuile
          </label>
          <label className="lp-checkbox-line">
            <input type="checkbox" checked={treemapShowSearch} onChange={(e) => setTreemapShowSearch(e.target.checked)} /> Afficher la recherche par nom de tuile
          </label>
          <div className="lp-field" style={{ marginTop: 8 }}>
            <label>Regroupement</label>
            <div className="lp-density-row">
              <button type="button" className={"lp-density-btn" + (treemapGroupBy === "none" ? " active" : "")} onClick={() => setTreemapGroupBy("none")}>Aucun</button>
              {treemapTileBy === "project" && (
                <>
                  <button type="button" className={"lp-density-btn" + (treemapGroupBy === "folder" ? " active" : "")} onClick={() => setTreemapGroupBy("folder")}>Dossier</button>
                  <button type="button" className={"lp-density-btn" + (treemapGroupBy === "priority" ? " active" : "")} onClick={() => setTreemapGroupBy("priority")}>Priorité</button>
                </>
              )}
              <button type="button" className={"lp-density-btn" + (treemapGroupBy === "owner" ? " active" : "")} onClick={() => setTreemapGroupBy("owner")}>Responsable</button>
              <button type="button" className={"lp-density-btn" + (treemapGroupBy === "criticality" ? " active" : "")} onClick={() => setTreemapGroupBy("criticality")}>Criticité</button>
            </div>
          </div>

          <div className="lp-widget-config-title" style={{ marginTop: 14 }}><Palette size={12} /> Apparence des tuiles</div>
          <div className="lp-row2">
            <div className="lp-field">
              <label>Arrondi</label>
              <div className="lp-density-row">
                <button type="button" className={"lp-density-btn" + (treemapRadius === "sharp" ? " active" : "")} onClick={() => setTreemapRadius("sharp")}>Net</button>
                <button type="button" className={"lp-density-btn" + (treemapRadius === "medium" ? " active" : "")} onClick={() => setTreemapRadius("medium")}>Doux</button>
                <button type="button" className={"lp-density-btn" + (treemapRadius === "round" ? " active" : "")} onClick={() => setTreemapRadius("round")}>Arrondi</button>
              </div>
            </div>
            <div className="lp-field">
              <label>Espacement — {treemapGap} px</label>
              <input type="range" min="0" max="12" value={treemapGap} onChange={(e) => setTreemapGap(Number(e.target.value))} style={{ width: "100%" }} />
            </div>
          </div>
          <label className="lp-checkbox-line">
            <input type="checkbox" checked={treemapBorder} onChange={(e) => setTreemapBorder(e.target.checked)} /> Contour discret autour de chaque tuile
          </label>
        </>
      )}

      {type === "minigantt" && (
        /* Le formulaire d'affichage du Mini-Gantt vit dans un composant partagé
           avec les réglages de la vue pleine page : la fiche ne fait que lui
           prêter son état local, et les deux ne peuvent plus diverger (#86). */
        <MiniGanttDisplayFields
          value={{
            groupBy: listGroupBy,
            showMilestones,
            colorBy,
            miniGanttFields,
            miniGanttFieldsLayout,
            miniGanttSort,
            miniGanttSortDir,
            miniGanttRange,
            miniGanttWindow: { start: miniGanttWindowStart, end: miniGanttWindowEnd },
            miniGanttComparisonEnabled,
            miniGanttShowDependencies,
            miniGanttShowSubtasks,
          }}
          onChange={applyMiniGanttPatch}
          ctx={ctx}
          scope="widget"
        />
      )}

      {type === "staffing" && (
        <StaffingDisplayFields value={staffingSettings} onChange={applyStaffingPatch} ctx={ctx} />
      )}

      {type === "bubbles" && (
        /* Même contrat que le Mini-Gantt : un formulaire partagé, qui ne
           connaît que des clés, et la fiche qui les range dans son état local
           jusqu'à l'enregistrement. */
        <BubblesDisplayFields
          value={{
            ...bubbleSettings,
            groupBy: listGroupBy,
            showMilestones,
            miniGanttSort,
            miniGanttSortDir,
            miniGanttRange,
            miniGanttWindow: { start: miniGanttWindowStart, end: miniGanttWindowEnd },
          }}
          onChange={applyBubblePatch}
          ctx={ctx}
        />
      )}

      {type === "bubbles" && (
        <BubbleMacrosEditor
          macros={bubbleSettings.bubbleMacros}
          tasks={ganttTasks}
          ctx={ctx}
          onChange={(bubbleMacros) => applyBubblePatch({ bubbleMacros })}
        />
      )}

      {(type === "minigantt" || type === "bubbles") && (
        <>
          <p style={{ fontSize: 12, color: "var(--text-600)", marginTop: -6, marginBottom: 8 }}>
            Les annotations ci-dessous sont enregistrées avec ce widget : elles suivent sa duplication, celle de l'onglet et celle du tableau de bord, sans jamais modifier les tâches.
          </p>
          {/* Un seul éditeur, pour les deux types : les blocs temporels, les
              encadrés, les jalons et les annotations sont les MÊMES couches,
              dessinées par le même diagramme. La branche « sans jalons ni
              annotations » qui vivait ici ne servait plus personne. */}
          <MiniGanttAnnotationsEditor
            blocks={ganttAnnotations.temporalBlocks}
            frames={ganttAnnotations.highlightFrames}
            milestones={ganttAnnotations.milestones}
            risks={ganttTaskRisks}
            notes={ganttAnnotations.notes}
            spans={ganttAnnotations.spans}
            allowSpans
            tasks={ganttTasks}
            ctx={ctx}
            defaultStart={ganttDefaultStart}
            defaultEnd={ganttDefaultEnd}
            onChange={(patch) => setGanttAnnotations((prev) => ({ ...prev, ...patch }))}
          />
        </>
      )}

      </div>

      {usesTaskFilter && (
        <div className="lp-widget-config-section">
          <div className="lp-widget-config-title"><Search size={12} /> Filtrer les tâches prises en compte</div>
          <TaskFilterFields filter={filter} setFilter={setFilter} ctx={ctx} />
        </div>
      )}

      <div className="lp-widget-appearance-toggle" onClick={() => setShowAppearance((v) => !v)}>
        <ChevronRight size={13} style={{ transform: showAppearance ? "rotate(90deg)" : "none" }} />
        <Palette size={13} /> Personnalisation visuelle
        <span className="lp-widget-appearance-hint">emoji, couleurs</span>
      </div>
      {showAppearance && (
        <div className="lp-widget-appearance-panel">
          <div className="lp-field">
            <label>Icône du titre <span style={{ fontWeight: 400, textTransform: "none", color: "var(--text-600)" }}>(icône Tabler, image importée ou lien d'image)</span></label>
            <IconEditor icon={titleEmoji} setIcon={setTitleEmoji} />
          </div>
          <div className="lp-row3">
            <div className="lp-field">
              <label>Couleur du titre</label>
              <div style={{ display: "flex", gap: 6 }}>
                <input type="color" value={titleColor || "#0B1526"} onChange={(e) => setTitleColor(e.target.value)} style={{ flex: 1, height: 34 }} />
                {titleColor && <button type="button" className="lp-icon-btn" onClick={() => setTitleColor("")} title="Revenir à la couleur par défaut"><X size={13} /></button>}
              </div>
            </div>
            <div className="lp-field">
              <label>Couleur du bandeau</label>
              <div style={{ display: "flex", gap: 6 }}>
                <input type="color" value={bandColor || "#F3EFE6"} onChange={(e) => setBandColor(e.target.value)} style={{ flex: 1, height: 34 }} />
                {bandColor && <button type="button" className="lp-icon-btn" onClick={() => setBandColor("")} title="Revenir à la couleur par défaut"><X size={13} /></button>}
              </div>
            </div>
            <div className="lp-field">
              <label>Couleur de fond</label>
              <div style={{ display: "flex", gap: 6 }}>
                <input type="color" value={bgColor || "#ffffff"} onChange={(e) => setBgColor(e.target.value)} style={{ flex: 1, height: 34 }} />
                {bgColor && <button type="button" className="lp-icon-btn" onClick={() => setBgColor("")} title="Revenir à la couleur par défaut"><X size={13} /></button>}
              </div>
            </div>
          </div>
        </div>
      )}
    </Modal>
  );
}

// ============================================================================
// Authentification multi-utilisateur — porte d'accès avant l'application
// Chaque compte a ses propres données, isolées via users/{uid}/kv_store côté
// Firestore (voir window.storage dans la page hôte + firestore.rules fourni).
// ============================================================================
// Authentification multi-utilisateur — page d'accueil, connexion/inscription,
// puis l'application. Chaque compte a ses propres données, isolées via
// users/{uid}/kv_store côté Firestore (voir window.storage + firestore.rules).
// ============================================================================

// Illustration signature : une carte de métro stylisée, écho direct de la vue
// "Planning Projets" — c'est la seule vraie signature visuelle de Nexora.
function MetroHeroArt() {
  return (
    <svg viewBox="0 0 640 420" className="lp-hero-art" xmlns="http://www.w3.org/2000/svg">
      <path className="lp-hero-line lp-hero-line-1" d="M 30 120 L 220 120 Q 260 120 260 160 L 260 220 Q 260 260 300 260 L 610 260" />
      <path className="lp-hero-line lp-hero-line-2" d="M 60 320 L 240 320 Q 280 320 280 280 L 280 180 Q 280 140 320 140 L 580 140" />
      <path className="lp-hero-line lp-hero-line-3" d="M 100 40 L 100 200 Q 100 240 140 240 L 400 240 Q 440 240 440 280 L 440 380" />
      {[[30,120],[220,120],[260,220],[610,260],[60,320],[240,320],[280,180],[580,140],[100,40],[100,200],[400,240],[440,380]].map(([x,y],i) => (
        <circle key={i} cx={x} cy={y} r="7" className="lp-hero-station" />
      ))}
    </svg>
  );
}

function LandingPage({ onGetStarted, onLogin }) {
  const FEATURES = [
    { icon: "🚇", title: "Planning Projets", text: "Chaque projet devient une ligne de métro : bifurcations pour les tâches, épaisseur du trait selon l'avancement." },
    { icon: "📊", title: "Gantt", text: "Planning visuel unique : regroupements, annotations, risques et comparaison." },
    { icon: "🎯", title: "Radar annuel", text: "Vue circulaire de toute l'année, pour voir la charge se répartir dans le temps." },
    { icon: "🗂️", title: "Tableur type Airtable", text: "Édition en masse, duplication, ajout rapide — sans jamais quitter la grille." },
  ];
  return (
    <div className="lp-theme lp-landing">
      <nav className="lp-landing-nav">
        <img src={NEXORA_LOGO_FULL} alt="Nexora" className="lp-landing-logo-img" />
        <div className="lp-landing-nav-actions">
          <button className="lp-ghost-btn" onClick={onLogin}>Se connecter</button>
          <button className="lp-primary-btn" onClick={onGetStarted}>Essayer gratuitement</button>
        </div>
      </nav>

      <header className="lp-landing-hero">
        <div className="lp-landing-hero-text">
          <span className="lp-landing-eyebrow">Gestion de projet</span>
          <h1 className="lp-landing-title">Vos projets, tracés<br />comme un plan de métro.</h1>
          <p className="lp-landing-sub">
            Gantt, Radar annuel, Tableur, Planning en ligne de métro — sept vues sur les
            mêmes données, pour trouver enfin celle qui vous parle vraiment.
          </p>
          <div className="lp-landing-cta-row">
            <button className="lp-primary-btn lp-landing-cta" onClick={onGetStarted}>Créer mon compte gratuitement</button>
            <button className="lp-ghost-btn" onClick={onLogin}>J'ai déjà un compte</button>
          </div>
        </div>
        <div className="lp-landing-hero-art-wrap"><MetroHeroArt /></div>
      </header>

      <section className="lp-landing-features">
        {FEATURES.map((f) => (
          <div className="lp-landing-feature-card" key={f.title}>
            <span className="lp-landing-feature-icon">{f.icon}</span>
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </div>
        ))}
      </section>

      <section className="lp-landing-band">
        <h2>Prêt à voir vos projets autrement ?</h2>
        <button className="lp-primary-btn lp-landing-cta" onClick={onGetStarted}>Essayer gratuitement</button>
      </section>

      <footer className="lp-landing-footer">© {new Date().getFullYear()} Nexora</footer>
    </div>
  );
}

function ReadmeModal({ onClose }) {
  return (
    <Modal title="Guide de démarrage" onClose={onClose} wide>
      <div className="lp-readme">
        <p className="lp-readme-intro">
          Nexora affiche les mêmes projets et tâches sous <strong>sept angles différents</strong> —
          l'idée est de piocher la vue qui correspond à ce que vous voulez comprendre à l'instant T,
          pas d'en choisir une seule pour toujours.
        </p>

        <h3>Les vues disponibles</h3>
        <div className="lp-readme-grid">
          <div><strong>📊 Gantt</strong> — zoom du jour à 5 ans, dépendances entre tâches.</div>
          <div><strong>🔥 Heat map</strong> — densité de charge sur l'année, par semaine.</div>
          <div><strong>📅 Calendrier</strong> — vue semaine/mois classique.</div>
          <div><strong>🎯 Radar</strong> — calendrier circulaire de toute l'année.</div>
          <div><strong>☀️ Aujourd'hui</strong> — tableau de bord du jour.</div>
          <div><strong>🚇 Planning Projets</strong> — chaque projet en ligne de métro.</div>
          <div><strong>🗂️ Tableur</strong> — édition en masse façon Airtable.</div>
        </div>

        <h3>Fonctionnalités clés</h3>
        <ul className="lp-readme-list">
          <li><strong>Dépendances</strong> — dans la fiche d'une tâche, indiquez de quelles tâches elle dépend. Sa date de début se recale alors automatiquement, et un avertissement apparaît en cas de conflit.</li>
          <li><strong>Tâches récurrentes</strong> — cochez "Tâche récurrente" dans la fiche : une nouvelle occurrence est créée automatiquement à chaque passage à "Terminé".</li>
          <li><strong>Filtres et tri</strong> — en haut de l'écran, s'appliquent à toutes les vues à la fois.</li>
          <li><strong>Ctrl/Cmd+clic</strong> sur un projet dans la barre latérale pour l'ajouter/le retirer du filtre, sans remplacer toute la sélection.</li>
        </ul>

        <h3>Raccourcis clavier</h3>
        <div className="lp-readme-shortcuts">
          <span><kbd>N</kbd> Nouvelle tâche</span>
          <span><kbd>Ctrl</kbd>+<kbd>Alt</kbd>+<kbd>N</kbd> Tâche rapide</span>
          <span><kbd>/</kbd> Rechercher</span>
          <span><kbd>Échap</kbd> Fermer</span>
        </div>

        <p className="lp-readme-footer-note">
          Ce guide reste accessible à tout moment depuis "Guide de démarrage", en bas de la barre latérale.
        </p>
      </div>
    </Modal>
  );
}

function AssistantFirebaseExport({ user }) {
  const [state, setState] = useState({ status:"loading", payload:null, error:"" });

  useEffect(() => {
    let cancelled = false;
    const readValue = async (key, fallback) => {
      try {
        const result = await window.storage.get(key);
        return {
          value:parseStoredValue(result.value),
          revision:result.revision || null,
          updatedAt:result.updatedAt || null,
          storageMode:result.storageMode || "inline",
          chunkCount:Number(result.chunkCount || 0),
        };
      } catch (error) {
        const message = (error && error.message) || String(error);
        if (message.includes("Key not found")) {
          return { value:fallback, revision:null, updatedAt:null, storageMode:"missing", chunkCount:0 };
        }
        throw new Error(`${key} : ${message}`);
      }
    };

    (async () => {
      try {
        if (!window.storage) throw new Error("Firebase/storage indisponible.");
        const [tasksDoc, archiveDoc, projectsDoc, statusesDoc, typesDoc, membersDoc] = await Promise.all([
          readValue("nexora:tasks", []),
          readValue("nexora:taskArchive", []),
          readValue("nexora:projects", []),
          readValue("nexora:statuses", []),
          readValue("nexora:taskTypes", []),
          readValue("nexora:teamMembers", []),
        ]);

        const tasks = Array.isArray(tasksDoc.value) ? tasksDoc.value : [];
        const archive = Array.isArray(archiveDoc.value) ? archiveDoc.value : [];
        const projects = Array.isArray(projectsDoc.value) ? projectsDoc.value : [];
        const statuses = Array.isArray(statusesDoc.value) ? statusesDoc.value : [];
        const taskTypes = Array.isArray(typesDoc.value) ? typesDoc.value : [];
        const teamMembers = Array.isArray(membersDoc.value) ? membersDoc.value : [];
        const projectById = new Map(projects.map((item) => [item.id, item]));
        const statusById = new Map(statuses.map((item) => [item.id, item]));
        const typeById = new Map(taskTypes.map((item) => [item.id, item]));
        const doneStatusIds = new Set(statuses
          .filter((item) => /^(termine|terminee|terminees|fait|faite|done|clos|cloture)$/i.test(normalizeForMatch(item?.name || "")))
          .map((item) => item.id));

        const enrich = (task, source="active") => ({
          id:task.id || null,
          source,
          archivedAt:source === "archive" ? (task.archivedAt || null) : null,
          title:task.title || "",
          project:{ id:task.projectId || null, name:projectById.get(task.projectId)?.name || null },
          status:{ id:task.statusId || null, name:statusById.get(task.statusId)?.name || null, done:doneStatusIds.has(task.statusId) },
          taskType:{ id:task.taskTypeId || null, name:typeById.get(task.taskTypeId)?.name || null },
          start:task.start || null,
          end:task.end || null,
          milestone:!!task.milestone,
          progress:Number.isFinite(Number(task.progress)) ? Number(task.progress) : null,
          assignee:task.assignee || null,
          priority:task.priority || null,
          description:task.desc || "",
          checklist:Array.isArray(task.checklist) ? task.checklist : [],
          attachments:Array.isArray(task.attachments) ? task.attachments : [],
          customFields:task.customFields && typeof task.customFields === "object" ? task.customFields : {},
          lastInteraction:task.lastInteraction || null,
        });

        const activeTasks = tasks.map((task) => enrich(task));
        const now = new Date();
        const parisDate = new Intl.DateTimeFormat("fr-CA", {
          timeZone:"Europe/Paris", year:"numeric", month:"2-digit", day:"2-digit"
        }).format(now);
        const dated = activeTasks.filter((task) => task.start || task.end);
        const today = dated.filter((task) => task.start === parisDate || task.end === parisDate);
        const overdue = dated.filter((task) => !task.status.done && (task.end || task.start) < parisDate);
        const upcoming = dated.filter((task) => (task.start || task.end) > parisDate)
          .sort((a,b) => String(a.start || a.end).localeCompare(String(b.start || b.end)));
        const inactive = activeTasks.filter((task) => {
          if (!task.lastInteraction) return false;
          const age = now.getTime() - new Date(task.lastInteraction).getTime();
          return Number.isFinite(age) && age > 30 * 86400000;
        });
        const scope = new URLSearchParams(window.location.search).get("scope") || "today";
        const documents = {
          tasks:{ revision:tasksDoc.revision, updatedAt:tasksDoc.updatedAt, storageMode:tasksDoc.storageMode, chunkCount:tasksDoc.chunkCount },
          taskArchive:{ revision:archiveDoc.revision, updatedAt:archiveDoc.updatedAt, storageMode:archiveDoc.storageMode, chunkCount:archiveDoc.chunkCount },
          projects:{ revision:projectsDoc.revision, updatedAt:projectsDoc.updatedAt, storageMode:projectsDoc.storageMode, chunkCount:projectsDoc.chunkCount },
          statuses:{ revision:statusesDoc.revision, updatedAt:statusesDoc.updatedAt, storageMode:statusesDoc.storageMode, chunkCount:statusesDoc.chunkCount },
          taskTypes:{ revision:typesDoc.revision, updatedAt:typesDoc.updatedAt, storageMode:typesDoc.storageMode, chunkCount:typesDoc.chunkCount },
        };
        const payload = {
          ok:true,
          mode:"firebase-direct-readonly",
          export:"assistant",
          scope,
          generatedAt:now.toISOString(),
          timezone:"Europe/Paris",
          date:parisDate,
          user:{ uid:user.uid, email:user.email || null },
          health:{
            authenticated:true,
            activeTaskCount:tasks.length,
            archivedTaskCount:archive.length,
            projectCount:projects.length,
            statusCount:statuses.length,
            taskTypeCount:taskTypes.length,
            teamMemberCount:teamMembers.length,
            documents,
          },
          data: scope === "health" ? null
            : scope === "catalogs" ? { projects, statuses, taskTypes, teamMembers }
            : scope === "tasks" ? { active:activeTasks, archived:archive.map((task) => enrich(task, "archive")) }
            : { today, overdue, upcoming, inactive },
        };
        if (!cancelled) setState({ status:"ready", payload, error:"" });
      } catch (error) {
        const message = (error && error.message) || String(error);
        if (!cancelled) setState({ status:"error", payload:null, error:message });
      }
    })();
    return () => { cancelled = true; };
  }, [user.uid]);

  const output = state.status === "ready" ? state.payload
    : state.status === "error" ? { ok:false, mode:"firebase-direct-readonly", export:"assistant", error:state.error }
    : { ok:false, mode:"firebase-direct-readonly", export:"assistant", status:"loading" };

  return (
    <main className="lp-theme" style={{ minHeight:"100vh", background:"var(--bg)", padding:24 }}>
      <h1 style={{ fontSize:20, margin:"0 0 12px" }}>Assistant personnel Nexora — Firebase</h1>
      <p style={{ color:"var(--text-600)", margin:"0 0 16px" }}>Lecture seule · aucune donnée n’est modifiée.</p>
      <pre id="nexora-assistant-export" style={{ whiteSpace:"pre-wrap", overflowWrap:"anywhere", background:"var(--surface)", border:"1px solid var(--border)", borderRadius:12, padding:16, fontSize:12 }}>
        {JSON.stringify(output, null, 2)}
      </pre>
    </main>
  );
}

function MeetingFirebaseExport({ user }) {
  const [state, setState] = useState({ status:"loading", payload:null, error:"" });

  useEffect(() => {
    let cancelled = false;

    const readValue = async (key, fallback) => {
      try {
        const result = await window.storage.get(key);
        return {
          value: parseStoredValue(result.value),
          revision: result.revision || null,
          updatedAt: result.updatedAt || null,
          storageMode: result.storageMode || "inline",
          chunkCount: Number(result.chunkCount || 0),
        };
      } catch (error) {
        const message = (error && error.message) || String(error);
        if (message.includes("Key not found")) {
          return { value:fallback, revision:null, updatedAt:null, storageMode:"missing", chunkCount:0 };
        }
        throw new Error(`${key} : ${message}`);
      }
    };

    (async () => {
      try {
        if (!window.storage) throw new Error("Firebase/storage indisponible.");

        const [tasksDoc, archiveDoc, typesDoc, projectsDoc, statusesDoc] = await Promise.all([
          readValue("nexora:tasks", []),
          readValue("nexora:taskArchive", []),
          readValue("nexora:taskTypes", []),
          readValue("nexora:projects", []),
          readValue("nexora:statuses", []),
        ]);

        const tasks = Array.isArray(tasksDoc.value) ? tasksDoc.value : [];
        const archive = Array.isArray(archiveDoc.value) ? archiveDoc.value : [];
        const taskTypes = Array.isArray(typesDoc.value) ? typesDoc.value : [];
        const projects = Array.isArray(projectsDoc.value) ? projectsDoc.value : [];
        const statuses = Array.isArray(statusesDoc.value) ? statusesDoc.value : [];
        const meetingTypeIds = new Set(
          taskTypes
            .filter((type) => ["reunion", "reunions"].includes(normalizeForMatch(type?.name || "")))
            .map((type) => type.id)
            .filter(Boolean)
        );

        const projectById = new Map(projects.map((project) => [project.id, project]));
        const statusById = new Map(statuses.map((status) => [status.id, status]));
        const typeById = new Map(taskTypes.map((type) => [type.id, type]));

        const selectMeeting = (task, source) => {
          if (!task || !meetingTypeIds.has(task.taskTypeId)) return null;
          const type = typeById.get(task.taskTypeId);
          const project = projectById.get(task.projectId);
          const status = statusById.get(task.statusId);
          return {
            id: task.id || null,
            source,
            archivedAt: source === "archive" ? (task.archivedAt || null) : null,
            title: task.title || "",
            project: project ? { id:project.id, name:project.name || "" } : { id:task.projectId || null, name:null },
            status: status ? { id:status.id, name:status.name || "" } : { id:task.statusId || null, name:null },
            taskType: { id:type?.id || task.taskTypeId, name:type?.name || null },
            start: task.start || null,
            end: task.end || null,
            milestone: !!task.milestone,
            progress: Number.isFinite(Number(task.progress)) ? Number(task.progress) : null,
            assignee: task.assignee || null,
            description: task.desc || "",
            checklist: Array.isArray(task.checklist) ? task.checklist : [],
            attachments: Array.isArray(task.attachments) ? task.attachments : [],
            customFields: task.customFields && typeof task.customFields === "object" ? task.customFields : {},
            lastInteraction: task.lastInteraction || null,
          };
        };

        const meetings = [
          ...tasks.map((task) => selectMeeting(task, "active")),
          ...archive.map((task) => selectMeeting(task, "archive")),
        ].filter(Boolean).sort((a, b) =>
          String(a.start || a.end || "9999-12-31").localeCompare(String(b.start || b.end || "9999-12-31")) ||
          String(a.title).localeCompare(String(b.title), "fr")
        );

        const now = new Date();
        const parisDate = new Intl.DateTimeFormat("fr-CA", {
          timeZone:"Europe/Paris", year:"numeric", month:"2-digit", day:"2-digit"
        }).format(now);
        const payload = {
          ok:true,
          mode:"firebase-direct-readonly",
          generatedAt:now.toISOString(),
          timezone:"Europe/Paris",
          date:parisDate,
          user:{ uid:user.uid, email:user.email || null },
          diagnostics:{
            activeTaskCount:tasks.length,
            archivedTaskCount:archive.length,
            meetingCount:meetings.length,
            meetingTypeIds:[...meetingTypeIds],
            documents:{
              tasks:{ revision:tasksDoc.revision, updatedAt:tasksDoc.updatedAt, storageMode:tasksDoc.storageMode, chunkCount:tasksDoc.chunkCount },
              taskArchive:{ revision:archiveDoc.revision, updatedAt:archiveDoc.updatedAt, storageMode:archiveDoc.storageMode, chunkCount:archiveDoc.chunkCount },
              taskTypes:{ revision:typesDoc.revision, updatedAt:typesDoc.updatedAt, storageMode:typesDoc.storageMode, chunkCount:typesDoc.chunkCount },
            },
          },
          meetings,
        };

        if (!cancelled) setState({ status:"ready", payload, error:"" });
      } catch (error) {
        const message = (error && error.message) || String(error);
        if (!cancelled) setState({ status:"error", payload:null, error:message });
      }
    })();

    return () => { cancelled = true; };
  }, [user.uid]);

  const output = state.status === "ready"
    ? state.payload
    : state.status === "error"
      ? { ok:false, mode:"firebase-direct-readonly", error:state.error }
      : { ok:false, mode:"firebase-direct-readonly", status:"loading" };

  return (
    <main className="lp-theme" style={{ minHeight:"100vh", background:"var(--bg)", padding:24 }}>
      <h1 style={{ fontSize:20, margin:"0 0 12px" }}>Export Réunions Nexora — Firebase</h1>
      <p style={{ color:"var(--text-600)", margin:"0 0 16px" }}>
        Lecture seule · aucune donnée n’est modifiée.
      </p>
      <pre id="nexora-meeting-export" style={{ whiteSpace:"pre-wrap", overflowWrap:"anywhere", background:"var(--surface)", border:"1px solid var(--border)", borderRadius:12, padding:16, fontSize:12 }}>
        {JSON.stringify(output, null, 2)}
      </pre>
    </main>
  );
}

function AuthGate() {
  const [screen, setScreen] = useState("landing"); // landing | auth | app (dérivé pour les non-connectés)
  const [authState, setAuthState] = useState("checking"); // checking | out | in
  const [user, setUser] = useState(null);
  const [mode, setMode] = useState("signup"); // login | signup | reset
  const [email, setEmail] = useState("");
  const [password, setPassword] = useState("");
  const [error, setError] = useState("");
  const [busy, setBusy] = useState(false);
  const [info, setInfo] = useState("");

  // Migration ponctuelle des données de l'ancien emplacement partagé (kv_store)
  // vers l'emplacement isolé du compte (users/{uid}/kv_store), proposée une
  // seule fois si des données pré-existantes sont détectées.
  const [migration, setMigration] = useState(null); // null | "checking" | "available" | "running" | "done"

  useEffect(() => {
    const unsub = onAuthStateChanged(auth, (u) => {
      setUser(u);
      setAuthState(u ? "in" : "out");
    });
    return () => unsub();
  }, []);

  useEffect(() => {
    if (authState !== "in" || !user) return;
    let cancelled = false;
    (async () => {
      setMigration("checking");
      try {
        const newCol = collection(db, "users", user.uid, "kv_store");
        const newSnap = await getDocs(newCol);
        if (!newSnap.empty) { if (!cancelled) setMigration(null); return; }
        const oldCol = collection(db, "kv_store");
        const oldSnap = await getDocs(oldCol);
        if (oldSnap.empty) { if (!cancelled) setMigration(null); return; }
        if (!cancelled) setMigration("available");
      } catch {
        if (!cancelled) setMigration(null);
      }
    })();
    return () => { cancelled = true; };
  }, [authState, user]);

  const runMigration = async () => {
    setMigration("running");
    try {
      const oldSnap = await getDocs(collection(db, "kv_store"));
      for (const d of oldSnap.docs) {
        await setDoc(doc(db, "users", user.uid, "kv_store", d.id), d.data());
      }
      setMigration("done");
    } catch (e) {
      setMigration("available");
      setError("La migration a échoué : " + (e.message || e));
    }
  };

  const translateError = (code) => {
    const map = {
      "auth/invalid-email": "Adresse e-mail invalide.",
      "auth/user-not-found": "Aucun compte ne correspond à cet e-mail.",
      "auth/wrong-password": "Mot de passe incorrect.",
      "auth/invalid-credential": "E-mail ou mot de passe incorrect.",
      "auth/email-already-in-use": "Un compte existe déjà avec cet e-mail.",
      "auth/weak-password": "Le mot de passe doit contenir au moins 6 caractères.",
      "auth/too-many-requests": "Trop de tentatives — réessaie dans quelques minutes.",
    };
    return map[code] || "Une erreur est survenue.";
  };

  const submit = async (e) => {
    e.preventDefault();
    setError(""); setInfo("");
    if (!email.trim() || (mode !== "reset" && !password)) return;
    setBusy(true);
    try {
      if (mode === "login") await signInWithEmailAndPassword(auth, email.trim(), password);
      else if (mode === "signup") await createUserWithEmailAndPassword(auth, email.trim(), password);
      else if (mode === "reset") { await sendPasswordResetEmail(auth, email.trim()); setInfo("E-mail de réinitialisation envoyé — vérifie ta boîte de réception."); }
    } catch (err) {
      setError(translateError(err.code));
    } finally {
      setBusy(false);
    }
  };

  let content;
  if (authState === "checking") {
    content = <div className="lp-theme lp-auth-boot"><div className="lp-sync-dot" /></div>;
  } else if (authState === "in") {
    if (migration === "available" || migration === "running") {
      content = (
        <div className="lp-theme lp-auth-wrap">
          <div className="lp-auth-card">
            <img src={NEXORA_LOGO_FULL} alt="Nexora" className="lp-landing-logo-img" style={{ marginBottom: 18, display: "block" }} />
            <h2 className="lp-display">Données existantes trouvées</h2>
            <p style={{ fontSize: 13.5, color: "var(--text-600)", marginBottom: 18 }}>
              Nexora a détecté des projets et tâches enregistrés avant la mise en place des comptes. Veux-tu les rattacher à ton compte <strong>{user.email}</strong> ?
            </p>
            <div style={{ display: "flex", gap: 8 }}>
              <button className="lp-primary-btn" onClick={runMigration} disabled={migration === "running"}>{migration === "running" ? "Import en cours…" : "Importer mes données"}</button>
              <button className="lp-ghost-btn" onClick={() => setMigration(null)} disabled={migration === "running"}>Ignorer, démarrer à vide</button>
            </div>
            {error && <div className="lp-auth-error">{error}</div>}
          </div>
        </div>
      );
    } else {
      const params = new URLSearchParams(window.location.search);
      const assistantExportMode = params.get("nexoraAssistantExport") === "1";
      const meetingExportMode = params.get("nexoraMeetingExport") === "1";
      content = assistantExportMode
        ? <AssistantFirebaseExport user={user} />
        : meetingExportMode
          ? <MeetingFirebaseExport user={user} />
          : <LePlan currentUser={user} onSignOut={() => signOut(auth)} />;
    }
  } else if (screen === "landing") {
    content = <LandingPage onGetStarted={() => { setMode("signup"); setScreen("auth"); }} onLogin={() => { setMode("login"); setScreen("auth"); }} />;
  } else {
    content = (
      <div className="lp-theme lp-auth-wrap">
        <form className="lp-auth-card" onSubmit={submit}>
          <button type="button" className="lp-auth-logo-btn" onClick={() => setScreen("landing")}><img src={NEXORA_LOGO_FULL} alt="Nexora" className="lp-landing-logo-img" /></button>
          <h2 className="lp-display lp-auth-title">
            {mode === "login" && "Content de te revoir"}
            {mode === "signup" && "Créer ton compte"}
            {mode === "reset" && "Mot de passe oublié"}
          </h2>
          <p className="lp-auth-lede">
            {mode === "login" && "Connecte-toi à ton espace de projets."}
            {mode === "signup" && "Chaque compte a son propre espace, isolé des autres — gratuit pour commencer."}
            {mode === "reset" && "Reçois un lien pour réinitialiser ton mot de passe."}
          </p>
          <div className="lp-field">
            <label>E-mail</label>
            <input type="email" placeholder="toi@exemple.com" value={email} onChange={(e) => setEmail(e.target.value)} autoFocus required />
          </div>
          {mode !== "reset" && (
            <div className="lp-field">
              <label>Mot de passe</label>
              <input type="password" placeholder="••••••••" value={password} onChange={(e) => setPassword(e.target.value)} minLength={6} required />
            </div>
          )}
          {error && <div className="lp-auth-error">{error}</div>}
          {info && <div className="lp-auth-info">{info}</div>}
          <button className="lp-auth-submit" type="submit" disabled={busy}>
            {busy ? <span className="lp-sync-dot" /> : mode === "login" ? "Se connecter" : mode === "signup" ? "Créer mon compte" : "Envoyer le lien"}
          </button>
          <div className="lp-auth-links">
            {mode === "login" && <>
              <button type="button" onClick={() => { setMode("signup"); setError(""); }}>Créer un compte</button>
              <button type="button" onClick={() => { setMode("reset"); setError(""); }}>Mot de passe oublié ?</button>
            </>}
            {mode === "signup" && <button type="button" onClick={() => { setMode("login"); setError(""); }}>J'ai déjà un compte</button>}
            {mode === "reset" && <button type="button" onClick={() => { setMode("login"); setError(""); }}>Retour à la connexion</button>}
          </div>
        </form>
      </div>
    );
  }

  return (
    <>
      <GlobalStyles />
      {content}
    </>
  );
}

// ============================================================================
// Vue "Chiffrage" — suivi budgétaire par projet : budget initial/actuel,
// dépenses engagées/à venir/aléas, table détaillée et synthèse par catégorie
// (catégories personnalisables par l'utilisateur, comme les statuts/projets).
// ============================================================================
function fmtEuro(n) {
  const v = Number(n) || 0;
  return v.toLocaleString("fr-FR", { maximumFractionDigits: 0 }) + " €";
}
// Version compacte pour les axes de graphiques (1,2k€ au lieu de 1200 €).
function fmtEuroCompact(n) {
  const v = Number(n) || 0;
  if (Math.abs(v) >= 1000000) return (v / 1000000).toLocaleString("fr-FR", { maximumFractionDigits: 1 }) + "M€";
  if (Math.abs(v) >= 1000) return (v / 1000).toLocaleString("fr-FR", { maximumFractionDigits: 1 }) + "k€";
  return Math.round(v) + "€";
}

// Taux de consommation budgétaire réel — utilisé à la fois dans l'en-tête du
// tableau de bord financier ET dans le widget "Budget Burn Rate" du dashboard,
// pour ne jamais dupliquer ce calcul. Basé sur les dépenses réellement
// enregistrées (jamais de rythme inventé) : rythme journalier depuis la
// première dépense, projeté sur le budget restant.
// Accepte soit un projet unique (mode historique, filtre lui-même ses dépenses),
// soit un budget + des dépenses déjà agrégées (mode dossier — plusieurs
// projets réunis) — pour rester réutilisable dans les deux cas sans dupliquer
// le calcul de rythme de consommation.
// Échelle 5×5 classique (probabilité × impact, chacun de 1 à 5) — le standard
// le plus reconnu en gestion de risques, pour rester lisible sans formation
// spécifique. Score = probabilité × impact (1 à 25), regroupé en 4 niveaux.









function calculateBudgetBurnRate({ project, expenses, budgetActuel: budgetActuelOverride, poolExpenses }) {
  if (!project && budgetActuelOverride === undefined) return { status: "noProject" };
  const budgetActuel = budgetActuelOverride !== undefined ? budgetActuelOverride : (Number(project.budgetActuel) || Number(project.budgetInitial) || 0);
  const projExpenses = poolExpenses || expenses.filter((e) => e.projectId === project.id);
  const totalSpent = projExpenses.reduce((s, e) => s + (Number(e.amount) || 0), 0);
  const pctConsumed = budgetActuel > 0 ? Math.round((totalSpent / budgetActuel) * 100) : 0;
  const remaining = budgetActuel - totalSpent;

  const dates = projExpenses.map((e) => e.date).filter(Boolean).sort();
  if (dates.length === 0) return { status: "noDates", budgetActuel, totalSpent, remaining, pctConsumed };

  const firstDate = dates[0];
  const today = iso(new Date());
  const daysElapsed = Math.max(1, dayIndex(today) - dayIndex(firstDate));
  const dailyRate = totalSpent / daysElapsed;
  const weeklyRate = dailyRate * 7;
  const weeksRemaining = dailyRate > 0 ? Math.round((remaining / dailyRate) / 7 * 10) / 10 : null;

  let healthStatus;
  if (remaining < 0) healthStatus = "over";
  else if (weeksRemaining !== null && weeksRemaining < 4) healthStatus = "risk";
  else healthStatus = "ok";

  return { status: "ready", budgetActuel, totalSpent, remaining, pctConsumed, dailyRate, weeklyRate, weeksRemaining, healthStatus, daysElapsed };
}
























// ============================================================================
// Échéances — sources publiques + manuel/récurrent (hors Google Calendar,
// hors finances, et sans réimporter les tâches Nexora comme source).
// ============================================================================
const DEADLINE_TYPES = [
  { value:"info", label:"Information" },
  { value:"action", label:"Action requise" },
  { value:"renewal", label:"Renouvellement" },
  { value:"expiration", label:"Expiration" },
  { value:"important", label:"Événement important" },
];
const DEADLINE_CATEGORIES = ["Impôts","Administratif","Famille","Santé","Véhicules","Maison","Abonnements","Voyages","Calendrier public"];
const DEADLINE_COLORS = { tax:"#E5573F", school:"#4E7CC7", holiday:"#2E9B72", clock:"#8A64C5", manual:"#A56A2A", gmail:"#D14F4F" };
const deadlineDate = (d) => { const x=new Date((d||"")+"T12:00:00"); return Number.isNaN(x.getTime()) ? null : x; };
const daysFromToday = (d) => { const x=deadlineDate(d); if(!x) return 0; const t=new Date(); t.setHours(12,0,0,0); return Math.round((x-t)/86400000); };
const deadlineMonthLabel = (date) => deadlineDate(date)?.toLocaleDateString("fr-FR",{month:"long",year:"numeric"}) || "";
const deadlineDayLabel = (date) => deadlineDate(date)?.toLocaleDateString("fr-FR",{day:"2-digit",month:"short"}).replace(".","") || date;
function lastSunday(year, monthIndex){ const d=new Date(year,monthIndex+1,0,12); d.setDate(d.getDate()-d.getDay()); return iso(d); }
function easterSunday(year){ const a=year%19,b=Math.floor(year/100),c=year%100,d=Math.floor(b/4),e=b%4,f=Math.floor((b+8)/25),g=Math.floor((b-f+1)/3),h=(19*a+b-d-g+15)%30,i=Math.floor(c/4),k=c%4,l=(32+2*e+2*i-h-k)%7,m=Math.floor((a+11*h+22*l)/451),month=Math.floor((h+l-7*m+114)/31)-1,day=((h+l-7*m+114)%31)+1; return new Date(year,month,day,12); }
function addDaysIso(date,n){ const d=new Date(date); d.setDate(d.getDate()+n); return iso(d); }
function publicHolidayItems(year){ const easter=easterSunday(year); return [
  [year+"-01-01","Jour de l’An"],[addDaysIso(easter,1),"Lundi de Pâques"],[year+"-05-01","Fête du Travail"],[year+"-05-08","Victoire 1945"],[addDaysIso(easter,39),"Ascension"],[addDaysIso(easter,50),"Lundi de Pentecôte"],[year+"-07-14","Fête nationale"],[year+"-08-15","Assomption"],[year+"-11-01","Toussaint"],[year+"-11-11","Armistice"],[year+"-12-25","Noël"]
].map(([date,title])=>({id:`public-holiday-${date}`,title,date,type:"info",category:"Calendrier public",source:"PUBLIC",provider:"Jours fériés France",description:"Jour férié national",status:"upcoming",reminders:[],publicKey:`holiday:${date}`})); }
function schoolHolidayItems(zone="A"){
  const common=[["2026-09-01","Rentrée scolaire","Rentrée des élèves 2026-2027"],["2026-10-17","Vacances de la Toussaint","Fin des cours"],["2026-11-02","Reprise après Toussaint","Reprise des cours"],["2026-12-19","Vacances de Noël","Fin des cours"],["2027-01-04","Reprise après Noël","Reprise des cours"]];
  const byZone={
    A:[["2027-02-13","Vacances d’hiver","Fin des cours"],["2027-03-01","Reprise après vacances d’hiver","Reprise des cours"],["2027-04-10","Vacances de printemps","Fin des cours"],["2027-04-26","Reprise après vacances de printemps","Reprise des cours"]],
    B:[["2027-02-20","Vacances d’hiver","Fin des cours"],["2027-03-08","Reprise après vacances d’hiver","Reprise des cours"],["2027-04-17","Vacances de printemps","Fin des cours"],["2027-05-03","Reprise après vacances de printemps","Reprise des cours"]],
    C:[["2027-02-06","Vacances d’hiver","Fin des cours"],["2027-02-22","Reprise après vacances d’hiver","Reprise des cours"],["2027-04-03","Vacances de printemps","Fin des cours"],["2027-04-19","Reprise après vacances de printemps","Reprise des cours"]]
  };
  return [...common,...(byZone[zone]||byZone.A),["2027-05-07","Pont scolaire","Pas de classe · calendrier national"],["2027-07-03","Vacances d’été","Fin des cours 2026-2027"]]
    .map(([date,title,description])=>({id:`school-${zone}-${date}-${title}`,title,date,type:"info",category:"Famille",source:"PUBLIC",provider:`Éducation nationale · Zone ${zone}`,description:`${description} · Zone ${zone}`,status:"upcoming",reminders:[],publicKey:`school:${zone}:${date}:${title}`}));
}
function clockChangeItems(year){ return [
  {date:lastSunday(year,2),title:"Passage à l’heure d’été",description:"Changement d’heure · France"},
  {date:lastSunday(year,9),title:"Passage à l’heure d’hiver",description:"Changement d’heure · France"}
].map(x=>({...x,id:`clock-${x.date}`,type:"info",category:"Calendrier public",source:"PUBLIC",provider:"Changement d’heure",status:"upcoming",reminders:[],publicKey:`clock:${x.date}`})); }
function taxItems2026(){ return [
  ["2026-09-15","Impôt sur le revenu : date limite de paiement","Paiement non dématérialisé, si concerné"],
  ["2026-09-20","Impôt sur le revenu : paiement en ligne","Date limite de paiement en ligne, si concerné"],
  ["2026-09-25","Impôt sur le revenu : prélèvement du solde","1 échéance si solde ≤ 300 €, sinon 1re des 4 échéances"],
  ["2026-09-30","Taxe foncière : adhésion au prélèvement à l’échéance","Date limite d’adhésion, si concerné"],
  ["2026-10-15","Taxe foncière : date limite de paiement","Paiement non dématérialisé, si concerné"],
  ["2026-10-20","Taxe foncière : paiement en ligne","Date limite de paiement en ligne, si concerné"],
  ["2026-10-26","Impôt sur le revenu : 2e prélèvement du solde","Si solde supérieur à 300 €"],
  ["2026-11-25","Impôt sur le revenu : 3e prélèvement du solde","Si solde supérieur à 300 €"],
  ["2026-11-30","Correction déclaration de revenus : fermeture","Fin du service de correction en ligne 2026"],
  ["2026-12-28","Impôt sur le revenu : 4e prélèvement du solde","Si solde supérieur à 300 €"]
].map(([date,title,description])=>({id:`tax-${date}-${title}`,title,date,type:"action",category:"Impôts",source:"PUBLIC",provider:"DGFiP · calendrier fiscal 2026",description,status:"upcoming",reminders:[30,7,1],publicKey:`tax:${date}:${title}`})); }
function mergePublicDeadlines(existing, incoming){ const manual=existing.filter(x=>x.source!=="PUBLIC"); const existingPublic=new Map(existing.filter(x=>x.source==="PUBLIC").map(x=>[x.publicKey||x.id,x])); const merged=incoming.map(x=>({...x,...(existingPublic.get(x.publicKey||x.id)||{}),title:x.title,date:x.date,source:"PUBLIC",provider:x.provider,publicKey:x.publicKey})); return [...manual,...merged]; }

const SYNCED_CALENDAR_DEFS = [
  { id:"fr-holidays", label:"Jours fériés France", description:"Jours fériés nationaux français", icon:"tabler:flag", defaultProjectName:"Jours fériés", defaultColor:"#2E9B72" },
  { id:"school-holidays", label:"Vacances scolaires", description:"Rentrée, vacances et reprises selon la zone scolaire", icon:"tabler:school", defaultProjectName:"Vacances scolaires", defaultColor:"#4E7CC7" },
  { id:"clock-changes", label:"Changements d’heure", description:"Passage heure d’été / heure d’hiver", icon:"tabler:clock", defaultProjectName:"Changements d’heure", defaultColor:"#8A64C5" },
  { id:"taxes", label:"Calendrier fiscal DGFiP", description:"Principales dates fiscales des particuliers", icon:"tabler:building-bank", defaultProjectName:"Fiscalité", defaultColor:"#E5573F" },
];

function normalizedSyncedCalendars(settings){
  const saved = Array.isArray(settings?.calendars) ? settings.calendars : [];
  return SYNCED_CALENDAR_DEFS.map(def => {
    const hit = saved.find(c => c.id === def.id) || {};
    return {
      id: def.id,
      enabled: hit.enabled !== false,
      projectName: hit.projectName || def.defaultProjectName,
      color: hit.color || def.defaultColor,
      // #138 : bloc temporel plutôt que jalon — régénéré à chaque
      // synchronisation comme le reste de ce calendrier, jamais modifiable
      // à la main (voir syncedCalendarAutoMetaBlock).
      showAsMetaBlock: hit.showAsMetaBlock === true,
    };
  });
}

// #138 : le méta-bloc qu'un calendrier synchronisé pose lui-même sur ses
// tâches quand « Afficher comme bloc temporel » est coché — opacité réduite
// FIXE (jamais réglable) : c'est ce qui le distingue d'un bloc manuel posé
// depuis les Réglages, dont l'opacité reste au choix de l'utilisateur.
function syncedCalendarAutoMetaBlock(color) {
  return { enabled: true, kind: "phase", color, borderStyle: "dashed", opacity: 0.42, dashboardIds: null };
}

function syncedCalendarItems(calendarId, settings){
  const years=[new Date().getFullYear(), new Date().getFullYear()+1];
  if(calendarId==="fr-holidays") return years.flatMap(y=>publicHolidayItems(y));
  if(calendarId==="school-holidays") return schoolHolidayItems(settings?.zone || "A");
  if(calendarId==="clock-changes") return years.flatMap(y=>clockChangeItems(y));
  if(calendarId==="taxes"){
    // Référentiel fiscal actuellement disponible dans cette version : 2026.
    return new Date().getFullYear()===2026 ? taxItems2026() : [];
  }
  return [];
}

function SyncedCalendarsSettingsPane({ settings, setSettings, projects, tasks, onSync, pushToast, hideTitle }){
  const calendars = normalizedSyncedCalendars(settings);
  const updateCalendar = (id, patch) => {
    setSettings(prev => {
      const current = normalizedSyncedCalendars(prev);
      return { ...prev, calendars: current.map(c => c.id===id ? { ...c, ...patch } : c) };
    });
  };
  const linkedProject = (id) => projects.find(p => p.syncedCalendarSource && p.syncedCalendarId===id);
  return (
    <div className="lp-settings-pane">
      {!hideTitle && <div className="lp-section-title">Calendriers synchronisés</div>}
      <p style={{fontSize:12.5,color:"var(--text-600)",marginTop:-6,lineHeight:1.5}}>
        Chaque calendrier activé crée son propre projet Nexora. Les dates sont importées comme jalons du projet correspondant.
        La source reste le calendrier public : lors d’une synchronisation, les jalons générés sont reconstruits sans toucher aux autres projets.
      </p>

      <div className="lp-row2">
        <div className="lp-field">
          <label>Zone scolaire</label>
          <select value={settings?.zone || "A"} onChange={e=>setSettings(p=>({...p,zone:e.target.value}))}>
            <option value="A">Zone A</option><option value="B">Zone B</option><option value="C">Zone C</option>
          </select>
        </div>
        <div className="lp-field">
          <label>Département fiscal</label>
          <input value={settings?.department || "69"} onChange={e=>setSettings(p=>({...p,department:e.target.value}))} placeholder="69"/>
        </div>
      </div>

      <div className="lp-section-title" style={{marginTop:4}}>Sources</div>
      {SYNCED_CALENDAR_DEFS.map(def=>{
        const cal=calendars.find(c=>c.id===def.id);
        const proj=linkedProject(def.id);
        const count=proj ? tasks.filter(t=>t.projectId===proj.id && t.syncedCalendarImported).length : 0;
        return (
          <div key={def.id} className="lp-gcal-calendar-row" style={{alignItems:"center",padding:"8px 0"}}>
            <label className="lp-checkbox-row" style={{padding:"7px 0",minWidth:210}}>
              <input type="checkbox" checked={!!cal.enabled} onChange={e=>updateCalendar(def.id,{enabled:e.target.checked})}/>
              <span className="lp-project-dot" style={{background:cal.color,width:16,height:16}}><IconGlyph icon={def.icon} size={9}/></span>
              <span style={{textTransform:"none",fontWeight:650,fontSize:13.5}}>{def.label}</span>
            </label>
            <div style={{flex:1,minWidth:0}}>
              <div style={{fontSize:10.5,color:"var(--text-600)",marginBottom:5}}>{def.description}</div>
              <input
                type="text"
                className="lp-gcal-custom-name-input"
                value={cal.projectName}
                onChange={e=>updateCalendar(def.id,{projectName:e.target.value})}
                placeholder={def.defaultProjectName}
                disabled={!cal.enabled}
              />
            </div>
            <input
              type="color"
              value={cal.color}
              onChange={e=>updateCalendar(def.id,{color:e.target.value})}
              disabled={!cal.enabled}
              title="Couleur du projet"
              style={{width:34,height:30,border:"1px solid var(--border)",borderRadius:6,background:"var(--surface)",padding:3}}
            />
            <div style={{width:110,textAlign:"right",fontSize:9.5,color:"var(--text-muted)"}}>
              {proj ? `${count} ${cal.showAsMetaBlock ? "bloc" : "jalon"}${count>1?"s":""}` : (cal.enabled ? "Projet à créer" : "Désactivé")}
            </div>
          </div>
        );
      })}
      {/* #138 : case séparée, sous la liste — pas dans chaque ligne déjà
          dense (nom + couleur + compteur) — pour rester lisible. */}
      <div className="lp-section-title" style={{marginTop:10}}>Affichage</div>
      {SYNCED_CALENDAR_DEFS.map(def=>{
        const cal=calendars.find(c=>c.id===def.id);
        if(!cal.enabled) return null;
        return (
          <label key={def.id} className="lp-checkbox-row" style={{padding:"4px 0"}}>
            <input type="checkbox" checked={!!cal.showAsMetaBlock} onChange={e=>updateCalendar(def.id,{showAsMetaBlock:e.target.checked})}/>
            <span style={{textTransform:"none",fontSize:12.5}}>
              {def.label} — afficher comme bloc temporel <span style={{color:"var(--text-600)",fontWeight:400}}>(bande sur le diagramme plutôt qu'un jalon ; régénéré à chaque synchronisation, jamais modifiable à la main)</span>
            </span>
          </label>
        );
      })}

      <div style={{display:"flex",alignItems:"center",gap:8,marginTop:8}}>
        <button className="lp-btn lp-btn-primary" onClick={onSync}><RefreshCw size={13}/> Synchroniser maintenant</button>
        {settings?.lastSyncAt && <span style={{fontSize:9.5,color:"var(--text-muted)"}}>Dernière synchro : {new Date(settings.lastSyncAt).toLocaleString("fr-FR")}</span>}
      </div>
      <div style={{marginTop:8,padding:"9px 11px",borderLeft:"3px solid var(--line-blue)",background:"var(--paper-soft)",fontSize:11.5,lineHeight:1.45,color:"var(--text-600)"}}>
        Gmail n’est plus utilisé par ce module. Google Calendar conserve sa synchronisation séparée dans son propre réglage.
      </div>
    </div>
  );
}

/* Pages fixes, sans widget (#193 suite) : priorisées plutôt qu'exhaustives —
   la logique (quelles tâches, dans quel ordre) vit dans NEXORA:FIXED-PAGES
   (part-002), ces deux composants n'en affichent que le résultat. */

/* Calendrier (#294) — vue et widget.

   Une grille continue de semaines (lundi → dimanche) ; un clic sur un jour
   déroule, sous SA semaine, la frise horaire du jour sur toute la largeur. La
   frise est un composant dédié et non le moteur Gantt : celui-ci ne connaît
   que des jours, et le rendre horaire l'aurait fragilisé partout où il sert.
   Toute la logique (pistes des bandeaux, découpage horaire, règles des
   terminées) vit dans NEXORA:CALENDAR, testée à part. */
const CALENDAR_ROW_PX = 66;
const CALENDAR_ROW_PX_COMPACT = 26;

function calendarNowMinutes() {
  const d = new Date();
  return d.getHours() * 60 + d.getMinutes();
}

function CalendarDayTimeline({ dateIso, tasks, ctx, onOpen, onAdd, onClose, compact = false, caretCol = null, fit = false }) {
  const model = useMemo(() => calendarDayModel(tasks, ctx, dateIso), [tasks, ctx, dateIso]);
  const isToday = dateIso === iso(new Date());
  const [nowMin, setNowMin] = useState(calendarNowMinutes);
  useEffect(() => {
    if (!isToday) return undefined;
    setNowMin(calendarNowMinutes());
    const id = setInterval(() => setNowMin(calendarNowMinutes()), 60000);
    return () => clearInterval(id);
  }, [isToday]);

  const firstMin = model.timed.length ? model.timed[0].startMin : null;
  // La vue montre toute la journée ; le widget, plus étroit, part au plus tard
  // de 6 h (plus tôt si une tâche commence avant).
  const h0 = compact ? Math.min(6, firstMin == null ? 6 : Math.floor(firstMin / 60)) : 0;
  const winStart = h0 * 60;
  const winLen = CALENDAR_DAY_MINUTES - winStart;
  const pct = (m) => Math.max(0, Math.min(100, ((m - winStart) / winLen) * 100));
  const step = compact ? 3 : 1;
  const hours = [];
  for (let h = h0; h < 24; h += step) hours.push(h);
  const rowPx = compact ? CALENDAR_ROW_PX_COMPACT : CALENDAR_ROW_PX;
  const topPad = compact ? 4 : 24;
  const lanesHeight = model.timed.length * rowPx + topPad + (compact ? 4 : 8);

  // Sur un écran étroit la frise défile : elle s'ouvre directement sur la
  // première tâche (ou sur l'heure actuelle), comme sur la maquette mobile.
  const scrollRef = useRef(null);
  useLayoutEffect(() => {
    const el = scrollRef.current;
    if (!el || compact || el.scrollWidth <= el.clientWidth) return;
    const target = firstMin != null ? firstMin : (isToday ? nowMin : 8 * 60);
    el.scrollLeft = Math.max(0, (target / CALENDAR_DAY_MINUTES) * el.scrollWidth - 24);
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [dateIso, compact]);

  const stats = model.total === 0 ? "Aucune tâche" : [
    `${model.total} tâche${model.total > 1 ? "s" : ""}`,
    `${model.doneCount} terminée${model.doneCount > 1 ? "s" : ""}`,
    model.plannedMinutes ? `${calendarDurationLabel(model.plannedMinutes)} planifiée${model.plannedMinutes >= 120 ? "s" : ""}` : null,
  ].filter(Boolean).join(" · ");
  const dayLabel = calendarLongDate(dateIso).replace(/ \d{4}$/, "");
  const yearLabel = dateIso.slice(0, 4);

  return (
    <div className={"lp-cal-day" + (compact ? " lp-cal-day-compact" : "") + (fit ? " lp-cal-day-fit" : "")} role="region" aria-label={`Frise du ${calendarLongDate(dateIso)}`}>
      {caretCol != null && <span className="lp-cal-caret" style={{ left: `calc(${((caretCol + 0.5) * 100) / 7}% - 6px)` }} aria-hidden="true" />}
      <div className="lp-cal-day-head">
        <div className="lp-cal-day-titles">
          <div className="lp-cal-day-title">
            <span>{dayLabel}{!compact && <span className="lp-cal-day-year"> {yearLabel}</span>}</span>
            {isToday && !compact && <span className="lp-cal-today-tag">Aujourd'hui</span>}
          </div>
          <div className="lp-cal-day-stats">{stats}</div>
        </div>
        {onAdd && (
          <button type="button" className="lp-cal-btn" onClick={() => onAdd(dateIso)}>
            <Plus size={14} /><span className="lp-cal-btn-label">Tâche ce jour</span>
          </button>
        )}
        {onClose && (
          <button type="button" className="lp-cal-btn lp-cal-btn-icon" aria-label="Fermer la frise du jour" onClick={onClose}>
            <X size={15} />
          </button>
        )}
      </div>

      {(model.allDay.length > 0 || !compact) && (
        <div className="lp-cal-allday">
          {!compact && <span className="lp-cal-allday-label">Journée</span>}
          <div className="lp-cal-allday-list">
            {model.allDay.length === 0 ? (
              <span className="lp-cal-muted">Aucune tâche sur la journée entière</span>
            ) : model.allDay.map(({ task, done, range }) => {
              const meta = fixedPageProjectMeta(task, ctx);
              return (
                <button
                  type="button"
                  key={task.id}
                  className={"lp-cal-allday-chip" + (done ? " is-done" : "")}
                  style={{ "--cal-color": meta.projectColor }}
                  onClick={() => onOpen && onOpen(task)}
                  title={meta.projectName || undefined}
                >
                  <span className="lp-cal-dot" aria-hidden="true" />
                  {done && <Check size={13} className="lp-cal-check" aria-label="Terminée" />}
                  <span className="lp-cal-chip-title">{task.title || "Sans titre"}</span>
                  {range && range.start !== range.end && (
                    <span className="lp-cal-chip-range">{calendarShortDate(range.start)} → {calendarShortDate(range.end)}</span>
                  )}
                </button>
              );
            })}
          </div>
        </div>
      )}

      {model.timed.length === 0 ? (
        <div className="lp-cal-empty">
          {model.total === 0
            ? "Rien de prévu ce jour-là."
            : "Aucune tâche horodatée ce jour-là. Ajoute une heure de début dans la fiche d'une tâche pour la placer sur la frise."}
        </div>
      ) : (
        <div className="lp-cal-track-scroll" ref={scrollRef}>
          <div className="lp-cal-track">
            <div className="lp-cal-ruler" aria-hidden="true">
              {hours.map((h) => (
                <span
                  key={h}
                  className={"lp-cal-hour" + (h % 6 === 0 ? " is-major" : "") + (h === h0 ? " is-first" : "")}
                  style={{ left: pct(h * 60) + "%" }}
                >
                  {String(h).padStart(2, "0")} h
                </span>
              ))}
            </div>
            <div className="lp-cal-lanes" style={{ height: lanesHeight }}>
              {!compact && [[0, 7], [21, 24]].map(([a, b]) => (
                <span key={a} className="lp-cal-night" style={{ left: pct(a * 60) + "%", width: pct(b * 60) - pct(a * 60) + "%" }} aria-hidden="true" />
              ))}
              {hours.map((h) => (
                <span key={h} className={"lp-cal-gridline" + (h % 6 === 0 ? " is-major" : "")} style={{ left: pct(h * 60) + "%" }} aria-hidden="true" />
              ))}
              {model.timed.map((r, idx) => {
                const meta = fixedPageProjectMeta(r.task, ctx);
                const left = pct(r.startMin);
                const width = Math.max(pct(r.endMin) - left, compact ? 1.2 : 0.6);
                const anchorRight = left > (compact ? 62 : 66);
                const textStyle = anchorRight
                  ? { right: `calc(${Math.max(0, 100 - left - (compact ? 0 : width))}% + ${compact ? 6 : 0}px)` }
                  : (compact ? { left: `calc(${left + width}% + 6px)` } : { left: left + "%" });
                const timeLabel = `${calendarMinutesToLabel(r.startMin)} – ${calendarMinutesToLabel(r.endMin)}`;
                const place = String(r.task.location || "").trim();
                return (
                  <button
                    type="button"
                    key={r.task.id}
                    className={"lp-cal-row" + (r.done ? " is-done" : "") + (anchorRight ? " is-right" : "")}
                    style={{ top: idx * rowPx + topPad, height: rowPx - 6, "--cal-color": meta.projectColor }}
                    onClick={() => onOpen && onOpen(r.task)}
                    aria-label={`${r.task.title || "Sans titre"}, ${timeLabel}${r.done ? ", terminée" : ""}`}
                  >
                    <span className="lp-cal-bar" style={{ left: left + "%", width: width + "%" }} />
                    {compact ? (
                      <span className="lp-cal-row-text" style={textStyle}>
                        <span className="lp-cal-row-time">{calendarMinutesToLabel(r.startMin)}</span>
                        <span className="lp-cal-row-title">{r.done && <Check size={12} className="lp-cal-check" />}{r.task.title || "Sans titre"}</span>
                      </span>
                    ) : (
                      <span className="lp-cal-row-text" style={textStyle}>
                        <span className="lp-cal-row-time">{timeLabel} · {calendarDurationLabel(r.endMin - r.startMin)}</span>
                        <span className="lp-cal-row-title">{r.done && <Check size={15} className="lp-cal-check" />}<span>{r.task.title || "Sans titre"}</span></span>
                        <span className="lp-cal-row-meta">
                          <span className="lp-cal-dot" aria-hidden="true" />
                          <span>{[meta.projectName, place, r.done ? "Terminée" : ""].filter(Boolean).join(" · ")}</span>
                        </span>
                      </span>
                    )}
                  </button>
                );
              })}
              {isToday && nowMin >= winStart && (
                <>
                  <span className="lp-cal-now" style={{ left: pct(nowMin) + "%" }} aria-hidden="true" />
                  {!compact && <span className="lp-cal-now-pill" style={{ left: pct(nowMin) + "%" }}>{calendarMinutesToLabel(nowMin)}</span>}
                </>
              )}
            </div>
          </div>
        </div>
      )}
    </div>
  );
}

function CalendarBoard({ tasks, ctx, onOpen, onAdd, prefs, compact = false, headerExtra = null }) {
  const cfg = normalizeCalendarViewPrefs(prefs);
  const todayIso = iso(new Date());
  const todayWeek = calendarWeekStart(todayIso);
  const STEP = 8;
  const [range, setRange] = useState(() => ({ first: addDays(todayWeek, -7 * (compact ? 6 : 8)), count: compact ? 18 : 30 }));
  const [selected, setSelected] = useState(null);
  const [labelMonth, setLabelMonth] = useState(() => todayIso.slice(0, 7));
  const label = calendarMonthTitle(labelMonth + "-01");
  const [height, setHeight] = useState(null);
  const rootRef = useRef(null);
  const scrollRef = useRef(null);
  const headRef = useRef(null);
  const weekRefs = useRef(new Map());
  const panelRef = useRef(null);
  // Au premier rendu : la semaine précédant aujourd'hui en haut, pour garder
  // un peu de contexte au-dessus du jour courant.
  const pendingScroll = useRef({ week: compact ? todayWeek : addDays(todayWeek, -7), smooth: false });
  const prependFrom = useRef(null);
  const frame = useRef(0);

  const weeks = useMemo(() => calendarWeekStarts(range.first, range.count), [range]);
  const lastWeek = weeks[weeks.length - 1];
  // Vue et widget partagent la même grille (#294 suite) : pastilles titrées,
  // heure, bandeaux multi-jours et « +N » — le widget n'en change que la densité.
  const layouts = useMemo(
    () => weeks.map((w) => calendarWeekLayout(tasks, ctx, w, cfg.rowsPerCell)),
    [weeks, tasks, ctx, cfg.rowsPerCell]
  );

  // La vue occupe la hauteur disponible de la fenêtre et défile en interne
  // (en-tête des jours collant) ; le widget prend la hauteur de son cadre.
  useLayoutEffect(() => {
    if (compact) return undefined;
    const measure = () => {
      const el = rootRef.current;
      if (!el) return;
      const top = el.getBoundingClientRect().top + (window.scrollY || 0);
      setHeight(Math.max(420, window.innerHeight - Math.max(0, top - (window.scrollY || 0)) - 16));
    };
    measure();
    window.addEventListener("resize", measure);
    return () => window.removeEventListener("resize", measure);
  }, [compact]);

  const headerOffset = () => headRef.current?.offsetHeight || 0;
  const scrollToWeek = (week, smooth) => {
    if (week < range.first || week > lastWeek) {
      // Hors de la plage chargée : on l'étend, le défilement suit au rendu.
      pendingScroll.current = { week, smooth: false };
      setRange((r) => {
        const first = week < r.first ? addDays(week, -7 * STEP) : r.first;
        const end = addDays(r.first, 7 * (r.count - 1));
        const last = week > end ? addDays(week, 7 * STEP) : end;
        return { first, count: Math.round((dayIndex(last) - dayIndex(first)) / 7) + 1 };
      });
      return;
    }
    const el = weekRefs.current.get(week);
    const sc = scrollRef.current;
    if (!el || !sc) return;
    sc.scrollTo({ top: Math.max(0, el.offsetTop - headerOffset()), behavior: smooth ? "smooth" : "auto" });
  };

  const updateLabel = () => {
    const sc = scrollRef.current;
    if (!sc) return;
    const y = sc.scrollTop + headerOffset() + 4;
    let current = weeks[0];
    for (const w of weeks) {
      const el = weekRefs.current.get(w);
      if (!el) continue;
      if (el.offsetTop + el.offsetHeight > y) { current = w; break; }
    }
    if (current) setLabelMonth(addDays(current, 3).slice(0, 7));
  };

  useLayoutEffect(() => {
    const sc = scrollRef.current;
    if (!sc) return;
    if (prependFrom.current) {
      sc.scrollTop = prependFrom.current.top + (sc.scrollHeight - prependFrom.current.height);
      prependFrom.current = null;
    }
    const pending = pendingScroll.current;
    // La vue attend sa hauteur définitive : défiler avant, c'est défiler un
    // conteneur qui ne défile pas encore.
    if (pending && (compact || height) && weekRefs.current.get(pending.week)) {
      pendingScroll.current = null;
      scrollToWeek(pending.week, pending.smooth);
    }
    updateLabel();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [range, height]);

  const onScroll = () => {
    if (frame.current) return;
    frame.current = requestAnimationFrame(() => {
      frame.current = 0;
      const sc = scrollRef.current;
      if (!sc) return;
      updateLabel();
      if (sc.scrollTop < 240) {
        prependFrom.current = { top: sc.scrollTop, height: sc.scrollHeight };
        setRange((r) => ({ first: addDays(r.first, -7 * STEP), count: r.count + STEP }));
      } else if (sc.scrollTop + sc.clientHeight > sc.scrollHeight - 320) {
        setRange((r) => ({ ...r, count: r.count + STEP }));
      }
    });
  };
  useEffect(() => () => { if (frame.current) cancelAnimationFrame(frame.current); }, []);

  // Le panneau qui s'ouvre reste visible : on fait juste ce qu'il faut défiler.
  useEffect(() => {
    if (selected && panelRef.current) panelRef.current.scrollIntoView({ block: "nearest", behavior: "smooth" });
  }, [selected]);

  const goMonth = (delta) => {
    const [y, m] = labelMonth.split("-").map(Number);
    const d = new Date(y, m - 1 + delta, 1);
    scrollToWeek(calendarWeekStart(iso(d)), true);
  };
  const toggle = (date) => setSelected((cur) => (cur === date ? null : date));

  const legend = useMemo(() => {
    if (compact) return [];
    const counts = new Map();
    const from = range.first;
    const to = lastWeek ? addDays(lastWeek, 6) : from;
    (tasks || []).forEach((t) => {
      const r = calendarTaskRange(t);
      if (!r || r.end < from || r.start > to || isTaskDoneGlobal(t, ctx)) return;
      const meta = fixedPageProjectMeta(t, ctx);
      if (!meta.projectName) return;
      const cur = counts.get(meta.projectName) || { ...meta, n: 0 };
      cur.n += 1;
      counts.set(meta.projectName, cur);
    });
    return [...counts.values()].sort((a, b) => b.n - a.n);
  }, [compact, tasks, ctx, range.first, lastWeek]);
  const LEGEND_MAX = 6;

  const weekdayLabels = compact ? ["L", "M", "M", "J", "V", "S", "D"] : ["Lun.", "Mar.", "Mer.", "Jeu.", "Ven.", "Sam.", "Dim."];
  const todayCol = calendarDayOfWeek(todayIso);

  const cellClass = (date, i, extra) => {
    const dn = Number(date.slice(8, 10));
    const month = Number(date.slice(5, 7));
    return "lp-cal-cell"
      + (month % 2 ? " is-odd-month" : "")
      + (i >= 5 ? " is-weekend" : "")
      + (date === todayIso ? " is-today" : "")
      + (date < todayIso ? " is-past" : "")
      + (date === selected ? " is-selected" : "")
      + (dn === 1 && i > 0 ? " is-month-start" : "")
      + (dn <= 7 ? " is-month-first-week" : "")
      + (extra || "");
  };
  const dayHead = (date) => {
    const dn = Number(date.slice(8, 10));
    return (
      <span className="lp-cal-cell-head">
        {dn === 1 && <span className="lp-cal-month-tag">{compact ? CALENDAR_MONTHS_SHORT[Number(date.slice(5, 7)) - 1] : calendarMonthTitle(date)}</span>}
        <span className="lp-cal-daynum">{dn}</span>
      </span>
    );
  };

  return (
    <div
      ref={rootRef}
      className={"lp-cal-board" + (compact ? " lp-cal-board-compact" : "")}
      style={!compact && height ? { height } : undefined}
    >
      <div className="lp-cal-toolbar">
        {!compact && <h2 className="lp-cal-heading">Calendrier</h2>}
        <span className="lp-cal-month-label">{label}</span>
        <span className="lp-cal-spacer" />
        {!compact && legend.length > 0 && (
          <span className="lp-cal-legend" aria-label="Projets affichés">
            {legend.slice(0, LEGEND_MAX).map((p) => (
              <span key={p.projectName} className="lp-cal-legend-item" style={{ "--cal-color": p.projectColor }}>
                <span className="lp-cal-dot" aria-hidden="true" />{p.projectName}
              </span>
            ))}
            {legend.length > LEGEND_MAX && <span className="lp-cal-legend-item">+{legend.length - LEGEND_MAX}</span>}
          </span>
        )}
        {headerExtra}
        {/* « Aujourd'hui » : revient à la semaine courante ET sélectionne le
            jour (panneau du jour ouvert), comme un clic sur sa case. */}
        <button type="button" className="lp-cal-btn" onClick={() => { setSelected(todayIso); scrollToWeek(compact ? todayWeek : addDays(todayWeek, -7), true); }} title="Aller à aujourd'hui et sélectionner le jour">Aujourd'hui</button>
        <span className="lp-cal-nav">
          <button type="button" className="lp-cal-btn lp-cal-btn-icon" aria-label="Mois précédent" onClick={() => goMonth(-1)}><ChevronLeft size={16} /></button>
          <button type="button" className="lp-cal-btn lp-cal-btn-icon" aria-label="Mois suivant" onClick={() => goMonth(1)}><ChevronRight size={16} /></button>
        </span>
      </div>

      <div className="lp-cal-scroll" ref={scrollRef} onScroll={onScroll}>
        <div className="lp-cal-weekdays" ref={headRef}>
          {weekdayLabels.map((l, i) => (
            <span key={i} className={"lp-cal-weekday" + (i >= 5 ? " is-weekend" : "") + (i === todayCol ? " is-today" : "")}>{l}</span>
          ))}
        </div>
        {weeks.map((w, wi) => {
          const open = !!selected && selected >= w && selected <= addDays(w, 6);
          return (
            <div key={w} className="lp-cal-week-block" ref={(el) => { if (el) weekRefs.current.set(w, el); else weekRefs.current.delete(w); }}>
                <div className="lp-cal-week" style={{ "--cal-lanes": layouts[wi].laneCount, "--cal-rows": cfg.rowsPerCell }}>
                  {layouts[wi].days.map((d, i) => (
                    <button
                      type="button"
                      key={d.date}
                      className={cellClass(d.date, i)}
                      onClick={() => toggle(d.date)}
                      aria-pressed={selected === d.date}
                      aria-label={`${calendarLongDate(d.date)}, ${d.total} tâche${d.total > 1 ? "s" : ""} à venir`}
                    >
                      {dayHead(d.date)}
                      <span className="lp-cal-cell-items">
                        {d.items.map((t) => {
                          const meta = fixedPageProjectMeta(t, ctx);
                          const time = cfg.showTimes && calendarTimeToMinutes(t.startTime) != null ? t.startTime : "";
                          return (
                            <span key={t.id} className="lp-cal-chip" style={{ "--cal-color": meta.projectColor }} title={(time ? time + " · " : "") + (t.title || "")}>
                              <span className="lp-cal-dot" aria-hidden="true" />
                              {time && <span className="lp-cal-chip-time">{time}</span>}
                              <span className="lp-cal-chip-title">{t.title || "Sans titre"}</span>
                            </span>
                          );
                        })}
                        {d.hidden > 0 && <span className="lp-cal-more">+{d.hidden}<span className="lp-cal-more-word"> {d.hidden > 1 ? "autres" : "autre"}</span></span>}
                      </span>
                    </button>
                  ))}
                  {layouts[wi].spans.map((s) => {
                    const meta = fixedPageProjectMeta(s.task, ctx);
                    const time = calendarTimeToMinutes(s.task.startTime) != null && !s.clipStart ? s.task.startTime + " · " : "";
                    return (
                      <span
                        key={s.task.id}
                        className={"lp-cal-span" + (s.clipStart ? " is-clip-start" : "") + (s.clipEnd ? " is-clip-end" : "")}
                        style={{ "--cal-color": meta.projectColor, "--cal-text": textOn(meta.projectColor), "--c0": s.col0, "--c1": s.col1, "--lane": s.lane }}
                        title={s.task.title || ""}
                        aria-hidden="true"
                      >
                        {s.clipStart ? "‹ " : ""}{time}{s.task.title || "Sans titre"}
                      </span>
                    );
                  })}
                </div>
              {open && (
                <div className="lp-cal-panel" ref={panelRef}>
                  <CalendarDayTimeline
                    dateIso={selected}
                    tasks={tasks}
                    ctx={ctx}
                    onOpen={onOpen}
                    onAdd={onAdd}
                    onClose={() => setSelected(null)}
                    compact={compact}
                    caretCol={calendarDayOfWeek(selected)}
                  />
                </div>
              )}
            </div>
          );
        })}
      </div>
    </div>
  );
}

// === NEXORA:CARTE-ENGINE:START ===
// Au-delà de cette distance de caméra, seuls les totems survolés ou le
// territoire courant gardent leur nom (#410).
const CARTE_TOTEM_LABEL_FAR = 60;
// Noms des tâches au-dessus des cases (#444) : sous cette distance de caméra
// (19 = vue par défaut), au plus CARTE_TASK_LABEL_MAX étiquettes candidates.
const CARTE_TASK_LABEL_NEAR = 22;
const CARTE_TASK_LABEL_MAX = 80;
// Ordre de préséance de la bordure d'une case partagée (#394) : en retard
// d'abord, puis en cours, en attente, à faire, information, terminée.
const CARTE_BORDER_RANK = { doing: 1, waiting: 2, todo: 3, info: 4, done: 5 };
// Moteur 3D de la vue Carte (#361). three.js est chargé à la demande par la
// vue (import dynamique) et passé en paramètre : aucune autre vue ne le paie.
// Toutes les pièces des modèles (voir NEXORA:CARTE) sont instanciées par
// couple géométrie × matériau : quelques dizaines d'appels de dessin, quel que
// soit le nombre de tâches. Le moteur ne modifie jamais une tâche.
function createCarteEngine(THREE, container, opts) {
  const o = opts || {};
  const renderer = new THREE.WebGLRenderer({ antialias: true, powerPreference: "high-performance" });
  renderer.setClearColor("#bfe3f2");
  renderer.shadowMap.type = THREE.PCFSoftShadowMap;
  const canvas = renderer.domElement;
  canvas.className = "lp-carte-canvas";
  canvas.setAttribute("aria-hidden", "true");
  container.appendChild(canvas);

  const scene = new THREE.Scene();
  scene.fog = new THREE.Fog("#bfe3f2", 60, 170);
  const camera = new THREE.PerspectiveCamera(34, 1, 0.5, 700);
  const hemi = new THREE.HemisphereLight(0xffffff, 0x8a8f6a, 1.35);
  scene.add(hemi);
  const sun = new THREE.DirectionalLight("#fff6e0", 2.1);
  sun.position.set(30, 50, 20);
  sun.shadow.mapSize.set(2048, 2048);
  Object.assign(sun.shadow.camera, { left: -40, right: 40, top: 40, bottom: -40, far: 220 });
  scene.add(sun, sun.target);
  const world = new THREE.Group();
  const overlay = new THREE.Group();
  scene.add(world, overlay);

  const reduced = !!(window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches);
  const S = {
    data: null, layout: null, stats: {}, visible: null, poi: {}, poisByKey: {}, selected: null, near: null, hovered: null,
    yaw: 0.6, pitch: 0.92, dist: 19, target: new THREE.Vector3(), follow: true, focusGoal: null,
    keys: {}, joy: { x: 0, y: 0 }, walkTo: null, quality: o.quality || "auto", effQuality: "high", detail: 2,
    time: 0, raf: 0, disposed: false, spin: [], walkPhase: 0, territory: null, placedKeeper: false,
    people: o.people !== false,
    // Animations persistantes (#425 à #436), désactivables dans « Affichage ».
    ambient: o.ambient !== false,
  };

  // ---------- Géométries unitaires (base à y = 0, hauteur 1) ----------
  const G = {};
  const mk = (name, geo) => { geo.computeVertexNormals(); G[name] = geo; };
  mk("box", new THREE.BoxGeometry(1, 1, 1).translate(0, 0.5, 0));
  mk("cyl", new THREE.CylinderGeometry(0.5, 0.5, 1, 8).translate(0, 0.5, 0));
  mk("hex", new THREE.CylinderGeometry(0.5, 0.5, 1, 6).translate(0, 0.5, 0));
  mk("cone", new THREE.ConeGeometry(0.5, 1, 8).translate(0, 0.5, 0));
  mk("pyr", new THREE.ConeGeometry(0.5, 1, 4).translate(0, 0.5, 0));
  mk("ball", new THREE.IcosahedronGeometry(0.5, 1).translate(0, 0.5, 0));
  mk("dome", new THREE.SphereGeometry(0.5, 10, 5, 0, Math.PI * 2, 0, Math.PI / 2).scale(1, 2, 1));
  // Variantes « tournantes » : l'axe de rotation est Z.
  mk("cyl~s", new THREE.CylinderGeometry(0.5, 0.5, 1, 10).rotateX(Math.PI / 2));
  mk("box~s", new THREE.BoxGeometry(1, 1, 1));
  const tileGeo = new THREE.CylinderGeometry(1, 1, 1, 6).translate(0, 0.5, 0);
  const capGeo = new THREE.CylinderGeometry(0.985, 0.985, 0.14, 6).translate(0, 0.07, 0);
  const ringGeo = new THREE.RingGeometry(0.78, 0.96, 6).rotateX(-Math.PI / 2).rotateY(Math.PI / 6);
  const planeGeo = new THREE.PlaneGeometry(1, 1);
  // Bordure des cases qui portent une tâche (#394), à la couleur du statut :
  // un liseré large posé sur le dessus de la dalle.
  const borderGeo = new THREE.RingGeometry(0.78, 0.99, 6).rotateX(-Math.PI / 2).rotateY(Math.PI / 6);
  const geos = Object.values(G).concat([tileGeo, capGeo, ringGeo, planeGeo, borderGeo]);
  // Nom d'un dossier écrit au sol (#377, #393), à la manière d'une carte
  // ancienne : capitales espacées, posées lettre à lettre le long de l'axe de
  // l'île (courbe v = a·u² + b·u + c dans le repère de la région). La texture
  // couvre la bande de la courbe ; `ppu` = pixels par unité du monde.
  const REGION_INK = { fill: "#fffaf0", stroke: "rgba(24,38,61,.78)" };
  function regionTexture(text, curve) {
    const ink = REGION_INK;
    const F = 96;
    const font = "700 italic " + F + "px 'Palatino Linotype', 'Book Antiqua', Palatino, Georgia, serif";
    const c = document.createElement("canvas");
    const g = c.getContext("2d");
    const chars = Array.from(text), gap = F * 0.34;
    let widths = chars.map(() => F * 0.7);
    if (g) { g.font = font; widths = chars.map((ch) => g.measureText(ch).width); }
    const natural = widths.reduce((m, w) => m + w, 0) + gap * Math.max(0, chars.length - 1);
    // Hauteur des lettres dans le monde : le nom occupe ~75 % de l'île.
    const hW = Math.max(0.9, Math.min(2.4, curve.vlen * 0.36 + 0.5, (curve.ulen * 0.7 * F) / natural));
    let ppu = F / hW;
    const span = (natural / F) * hW;
    const u0 = curve.umid - span / 2, u1 = curve.umid + span / 2;
    const vAt = (u) => curve.a * u * u + curve.b * u + curve.c;
    let vmin = Infinity, vmax = -Infinity;
    for (let i = 0; i <= 24; i++) { const v = vAt(u0 + (span * i) / 24); vmin = Math.min(vmin, v); vmax = Math.max(vmax, v); }
    const pad = hW * 0.9;
    const U0 = u0 - pad, V0 = vmin - pad, UW = span + 2 * pad, VH = vmax - vmin + 2 * pad;
    const k = Math.min(1, 4096 / (UW * ppu), 2048 / (VH * ppu));
    ppu *= k;
    c.width = Math.max(64, Math.ceil(UW * ppu)); c.height = Math.max(32, Math.ceil(VH * ppu));
    if (g) {
      const fs = F * k;
      g.font = "700 italic " + fs + "px 'Palatino Linotype', 'Book Antiqua', Palatino, Georgia, serif";
      g.textAlign = "center"; g.textBaseline = "middle"; g.lineJoin = "round";
      // Abscisse curviligne : les lettres gardent leur espacement dans les
      // virages.
      const N = 200, cum = [0];
      for (let i = 1; i <= N; i++) { const ua = u0 + (span * (i - 1)) / N, ub = u0 + (span * i) / N; cum.push(cum[i - 1] + Math.hypot(ub - ua, vAt(ub) - vAt(ua))); }
      const scale = cum[N] / span;
      let at = 0;
      chars.forEach((ch, i) => {
        const wW = (widths[i] / F) * hW;
        const target = (at + wW / 2) * scale;
        let j = 1; while (j < N && cum[j] < target) j++;
        const u = u0 + (span * (j - 1 + (target - cum[j - 1]) / Math.max(1e-6, cum[j] - cum[j - 1]))) / N;
        const v = vAt(u), ang = Math.atan(2 * curve.a * u + curve.b);
        at += wW + (gap / F) * hW;
        if (ch === " ") return;
        g.save();
        g.translate((u - U0) * ppu, (v - V0) * ppu);
        g.rotate(ang);
        g.lineWidth = fs * 0.12; g.strokeStyle = ink.stroke; g.strokeText(ch, 0, 0);
        g.fillStyle = ink.fill; g.fillText(ch, 0, 0);
        g.restore();
      });
    }
    const t = new THREE.CanvasTexture(c);
    t.colorSpace = THREE.SRGBColorSpace;
    t.anisotropy = 8;
    return { texture: t, w: UW, h: VH, cu: U0 + UW / 2, cv: V0 + VH / 2 };
  }
  // Axe d'une île (#393) : analyse en composantes principales des cases, puis
  // courbe du second degré ajustée, à courbure bornée pour rester lisible.
  function regionCurve(pts) {
    const n = pts.length;
    let mx = 0, mz = 0;
    pts.forEach((p) => { mx += p[0]; mz += p[1]; });
    mx /= n; mz /= n;
    let sxx = 0, szz = 0, sxz = 0;
    pts.forEach((p) => { const dx = p[0] - mx, dz = p[1] - mz; sxx += dx * dx; szz += dz * dz; sxz += dx * dz; });
    const theta = 0.5 * Math.atan2(2 * sxz, sxx - szz);
    const ux = Math.cos(theta), uz = Math.sin(theta);
    const uv = pts.map((p) => { const dx = p[0] - mx, dz = p[1] - mz; return [dx * ux + dz * uz, -dx * uz + dz * ux]; });
    let umin = Infinity, umax = -Infinity, vmin = Infinity, vmax = -Infinity;
    uv.forEach((q) => { umin = Math.min(umin, q[0]); umax = Math.max(umax, q[0]); vmin = Math.min(vmin, q[1]); vmax = Math.max(vmax, q[1]); });
    // Moindres carrés v = a·u² + b·u + c (équations normales 3 × 3).
    const m = [[0, 0, 0], [0, 0, 0], [0, 0, 0]], r = [0, 0, 0];
    uv.forEach((q) => { const f = [q[0] * q[0], q[0], 1]; for (let i = 0; i < 3; i++) { r[i] += f[i] * q[1]; for (let j = 0; j < 3; j++) m[i][j] += f[i] * f[j]; } });
    let sol = [0, 0, 0];
    const det = (A) => A[0][0] * (A[1][1] * A[2][2] - A[1][2] * A[2][1]) - A[0][1] * (A[1][0] * A[2][2] - A[1][2] * A[2][0]) + A[0][2] * (A[1][0] * A[2][1] - A[1][1] * A[2][0]);
    const D = det(m);
    if (Math.abs(D) > 1e-6) sol = [0, 1, 2].map((i) => det(m.map((row, ri) => row.map((x, ci) => (ci === i ? r[ri] : x)))) / D);
    const ulen = Math.max(4, umax - umin), vlen = Math.max(2, vmax - vmin), half = ulen / 2;
    const amax = (0.18 * ulen) / (half * half);
    const a = Math.max(-amax, Math.min(amax, sol[0] || 0));
    const b = Math.max(-0.35, Math.min(0.35, sol[1] || 0));
    const c = Math.max(vmin + 0.5, Math.min(vmax - 0.5, sol[2] || 0));
    return { cx: mx, cz: mz, theta, a, b, c, umid: (umin + umax) / 2, ulen, vlen };
  }

  const mats = [];
  const mat = (m) => { mats.push(m); return m; };
  const MAT = {
    l: mat(new THREE.MeshLambertMaterial({ color: "#ffffff", flatShading: true })),
    g: mat(new THREE.MeshBasicMaterial({ color: "#ffffff" })),
    t: mat(new THREE.MeshBasicMaterial({ color: "#ffffff", transparent: true, opacity: 0.32, depthWrite: false })),
    s: mat(new THREE.MeshLambertMaterial({ color: "#ffffff", flatShading: true })),
    water: mat(new THREE.MeshLambertMaterial({ color: "#ffffff", transparent: true, opacity: 0.86, flatShading: true })),
    ring: mat(new THREE.MeshBasicMaterial({ color: "#ffffff", transparent: true, opacity: 0.95, depthWrite: false, side: THREE.DoubleSide })),
    alarm: mat(new THREE.MeshBasicMaterial({ color: "#ff1f1f", transparent: true, opacity: 0.85, depthWrite: false, side: THREE.DoubleSide })),
    cloud: mat(new THREE.MeshLambertMaterial({ color: "#ffffff", flatShading: true })),
    bolt: mat(new THREE.MeshBasicMaterial({ color: "#fff3a0" })),
    rain: mat(new THREE.MeshBasicMaterial({ color: "#5d97d6", transparent: true, opacity: 0.9, depthWrite: false })),
    flame: mat(new THREE.MeshBasicMaterial({ color: "#ffffff", transparent: true, opacity: 0.93, depthWrite: false })),
    smoke: mat(new THREE.MeshLambertMaterial({ color: "#3b3b3f", transparent: true, opacity: 0.45, depthWrite: false, flatShading: true })),
    clock: mat(new THREE.MeshLambertMaterial({ color: "#ffffff", flatShading: true })),
    boltHalo: mat(new THREE.MeshBasicMaterial({ color: "#bfe2ff", transparent: true, opacity: 0.35, depthWrite: false })),
    border: mat(new THREE.MeshBasicMaterial({ color: "#ffffff", side: THREE.DoubleSide, polygonOffset: true, polygonOffsetFactor: -2, polygonOffsetUnits: -2 })),
    // Lave du thème Volcan (#408) : lumineuse, elle pulse doucement.
    lava: mat(new THREE.MeshBasicMaterial({ color: "#ffffff" })),
    route: mat(new THREE.LineDashedMaterial({ color: "#8a5a35", dashSize: 0.25, gapSize: 0.2, transparent: true, opacity: 0.55 })),
  };

  // Coche verte des tâches terminées (#372) : une texture dessinée une fois,
  // un nuage de points toujours tourné vers la caméra.
  const checkTex = (() => {
    const c = document.createElement("canvas");
    c.width = c.height = 64;
    const g = c.getContext("2d");
    if (g) {
      g.fillStyle = "#1FA971"; g.beginPath(); g.arc(32, 32, 29, 0, Math.PI * 2); g.fill();
      g.strokeStyle = "#ffffff"; g.lineWidth = 3; g.stroke();
      g.lineWidth = 8; g.lineCap = "round"; g.lineJoin = "round";
      g.beginPath(); g.moveTo(18, 33); g.lineTo(28, 43); g.lineTo(46, 22); g.stroke();
    }
    const t = new THREE.CanvasTexture(c);
    t.colorSpace = THREE.SRGBColorSpace;
    return t;
  })();
  MAT.check = mat(new THREE.PointsMaterial({ map: checkTex, size: 1.25, sizeAttenuation: true, transparent: true, alphaTest: 0.2, depthWrite: false }));

  // Une seule direction artistique, Classique (#404) : les pièces « l » et
  // « s » sont éclairées, « g » lumineuses, « t » translucides.
  const litMat = (m) => MAT[m] || MAT.l;
  const tmpM = new THREE.Matrix4(), tmpQ = new THREE.Quaternion(), tmpS = new THREE.Vector3(), tmpP = new THREE.Vector3(), tmpC = new THREE.Color(), UP = new THREE.Vector3(0, 1, 0);
  const tmpE = new THREE.Euler();

  function clearGroup(g) {
    while (g.children.length) {
      const c = g.children.pop();
      if (c.isInstancedMesh) c.dispose();
      if (c.userData.ownGeo) c.geometry.dispose();
      if (c.userData.ownTex && c.material && c.material.map) c.material.map.dispose();
      if (c.userData.ownMat) c.material.dispose();
    }
  }

  // Tampon d'instances : on compte d'abord, on alloue ensuite.
  function makeBatcher() {
    const buckets = {};
    return {
      add(g, m, x, y, z, sx, sy, sz, rot, color, meta) {
        const key = (m === "s" ? g + "~s" : g) + "|" + m;
        const b = buckets[key] || (buckets[key] = { g: m === "s" ? g + "~s" : g, m, items: [] });
        b.items.push([x, y, z, sx, sy, sz, rot || 0, color, meta]);
      },
      flush(group, shadows) {
        const spins = [];
        Object.keys(buckets).forEach((key) => {
          const b = buckets[key];
          const geo = G[b.g] || G.box;
          const mesh = new THREE.InstancedMesh(geo, litMat(b.m), b.items.length);
          mesh.castShadow = shadows && b.m === "l";
          mesh.receiveShadow = shadows;
          b.items.forEach((it, i) => {
            tmpQ.setFromAxisAngle(UP, it[6]);
            tmpS.set(Math.max(0.001, Math.abs(it[3])), Math.max(0.001, Math.abs(it[4])), Math.max(0.001, Math.abs(it[5])));
            tmpP.set(it[0], it[1], it[2]);
            mesh.setMatrixAt(i, tmpM.compose(tmpP, tmpQ, tmpS));
            mesh.setColorAt(i, tmpC.set(it[7]));
            if (b.m === "s") spins.push({ mesh, i, p: [it[0], it[1], it[2]], s: [tmpS.x, tmpS.y, tmpS.z], rot: it[6], ph: it[8] || 0 });
          });
          mesh.instanceMatrix.needsUpdate = true;
          if (mesh.instanceColor) mesh.instanceColor.needsUpdate = true;
          mesh.computeBoundingSphere();
          group.add(mesh);
        });
        return spins;
      },
    };
  }
  // Pose un modèle (liste de pièces locales) à (x, y, z) avec rotation ry.
  function placeModel(batch, parts, x, y, z, ry, meta) {
    const c = Math.cos(ry || 0), s = Math.sin(ry || 0);
    for (let i = 0; i < parts.length; i++) {
      const p = parts[i];
      const lx = p.p[0], lz = p.p[2];
      batch.add(p.g, p.m, x + lx * c + lz * s, y + p.p[1], z - lx * s + lz * c, p.s[0], p.s[1], p.s[2], (p.r || 0) + (ry || 0), p.c, meta);
    }
  }

  const theme = (id) => CARTE_THEME_BY_ID[id] || CARTE_THEMES[0];
  function tileColors(t) {
    if (t.kind === "sea") return { top: "#3f9ccf", side: "#2d7fb0", water: true };
    if (t.kind === "islet") return { top: "#9fcf6a", side: "#8a6a45" };
    const th = theme(t.theme);
    const pal = th.pal;
    const v = carteRand("v:" + t.q + "," + t.r);
    if (t.kind === "water") return { top: pal.water, side: carteMix(pal.water, "#000000", 0.25), water: true };
    if (t.lava && !t.road) {
      const dim = S.dimmed && t.projectId && S.dimmed.has(t.projectId);
      return { top: dim ? "#8a6a5e" : v < 0.5 ? "#ff5a14" : "#ff7a1e", side: pal.side, lava: true };
    }
    let top = t.kind === "edge" || t.kind === "wild" ? pal.wild : v < 0.3 ? pal.alt : pal.top;
    if (th.relief === "peak" && t.ring >= 3) top = pal.alt;
    if (th.relief === "crater" && t.ring === 1) top = "#3a3230";
    if (t.road) top = th.id === "cyberpunk" ? "#65768a" : th.id === "ville" ? "#b8b2a4" : "#e2bb82";
    if (t.kind === "hub") {
      const p = S.layout.projectById[t.projectId];
      top = carteMix(pal.top, (p && p.color) || pal.top, 0.35);
    }
    const col = { top: carteMix(top, v < 0.5 ? "#000000" : "#ffffff", Math.abs(v - 0.5) * 0.12), side: pal.side };
    if (S.dimmed && t.projectId && S.dimmed.has(t.projectId)) { col.top = carteMix(col.top, CARTE_DIM_TOP, 0.75); col.side = carteMix(col.side, "#8e949c", 0.6); }
    return col;
  }

  // ---------- Construction ----------
  function build() {
    clearGroup(world);
    S.spin = [];
    const L = S.layout;
    const q = S.effQuality;
    const shadows = q === "high";
    const keys = Object.keys(L.tiles);
    const baseM = new THREE.InstancedMesh(tileGeo, litMat("l"), keys.length);
    const capM = new THREE.InstancedMesh(capGeo, litMat("l"), keys.length);
    const waterM = new THREE.InstancedMesh(capGeo, MAT.water, keys.length);
    const lavaM = new THREE.InstancedMesh(capGeo, MAT.lava, keys.length);
    capM.count = 0; waterM.count = 0; lavaM.count = 0;
    capM.userData.keys = []; waterM.userData.keys = []; lavaM.userData.keys = [];
    baseM.receiveShadow = capM.receiveShadow = shadows;
    const capTop = {};
    keys.forEach((k, i) => {
      const t = L.tiles[k];
      const w = carteToWorld(t.q, t.r);
      const col = tileColors(t);
      if (col.water) {
        baseM.setMatrixAt(i, tmpM.compose(tmpP.set(w.x, 0, w.z), tmpQ.identity(), tmpS.set(1, 0.08, 1)));
        baseM.setColorAt(i, tmpC.set(col.side));
        const j = waterM.count++;
        waterM.setMatrixAt(j, tmpM.compose(tmpP.set(w.x, t.h - 0.06, w.z), tmpQ.identity(), tmpS.set(1, 1, 1)));
        capTop[k] = t.h - 0.06 + 0.14;
        waterM.setColorAt(j, tmpC.set(t.bridge ? carteMix(col.top, "#ffffff", 0.15) : col.top));
        waterM.userData.keys[j] = k;
      } else {
        baseM.setMatrixAt(i, tmpM.compose(tmpP.set(w.x, 0, w.z), tmpQ.identity(), tmpS.set(1, t.h, 1)));
        baseM.setColorAt(i, tmpC.set(col.side));
        const cm = col.lava ? lavaM : capM;
        const j = cm.count++;
        cm.setMatrixAt(j, tmpM.compose(tmpP.set(w.x, t.h - 0.02, w.z), tmpQ.identity(), tmpS.set(1, 1, 1)));
        capTop[k] = t.h + 0.12;
        cm.setColorAt(j, tmpC.set(col.top));
        cm.userData.keys[j] = k;
      }
    });
    [baseM, waterM, capM, lavaM].forEach((m) => { m.instanceMatrix.needsUpdate = true; if (m.instanceColor) m.instanceColor.needsUpdate = true; m.computeBoundingSphere(); world.add(m); });
    S.pickMeshes = [capM, waterM, lavaM];

    // Noms des dossiers au sol (#377, #393) : le long de l'île, au-dessus de
    // ses dalles. Une seconde passe, très pâle et sans test de profondeur,
    // garde le nom devinable derrière les bâtiments. Une région entièrement
    // écartée par les filtres n'affiche pas son nom.
    S.regionLabels = [];
    const regions = {};
    keys.forEach((k) => {
      const t = L.tiles[k];
      const p = t.projectId && L.projectById[t.projectId];
      if (!p || !p.group || !p.folderName || t.kind === "sea") return;
      const w = carteToWorld(t.q, t.r);
      const g = regions[p.group] || (regions[p.group] = { name: p.folderName, pts: [], top: 0, projects: new Set() });
      g.pts.push([w.x, w.z]); g.top = Math.max(g.top, t.h); g.projects.add(t.projectId);
    });
    Object.keys(regions).sort().forEach((gid) => {
      const g = regions[gid];
      if (S.dimmed && [...g.projects].every((pid) => S.dimmed.has(pid))) return;
      const cv = regionCurve(g.pts);
      const tx = regionTexture(g.name.toUpperCase(), cv);
      const ux = Math.cos(cv.theta), uz = Math.sin(cv.theta);
      const px = cv.cx + ux * tx.cu - uz * tx.cv, pz = cv.cz + uz * tx.cu + ux * tx.cv;
      [{ depthTest: true, opacity: 0.96, order: 3 }, { depthTest: false, opacity: 0.22, order: 4 }].forEach((pass, i) => {
        const mesh = new THREE.Mesh(planeGeo, new THREE.MeshBasicMaterial({ map: tx.texture, transparent: true, depthWrite: false, depthTest: pass.depthTest, opacity: pass.opacity }));
        mesh.userData.ownMat = true;
        if (i === 0) mesh.userData.ownTex = true;
        mesh.scale.set(tx.w, tx.h, 1);
        mesh.position.set(px, g.top + 0.3, pz);
        mesh.userData.theta = cv.theta;
        mesh.userData.alpha = pass.opacity;
        mesh.rotation.set(-Math.PI / 2, 0, -cv.theta);
        mesh.renderOrder = pass.order;
        world.add(mesh);
        S.regionLabels.push(mesh);
      });
    });

    const batch = makeBatcher();
    const poiKeys = new Set(L.pois.map((p) => p.key));
    // Décor (allégé en qualité basse ; limité aux territoires en grands volumes).
    const decorShare = q === "low" ? 0.4 : 1;
    keys.forEach((k) => {
      const t = L.tiles[k];
      if (t.road || poiKeys.has(k) || t.kind === "hub") {
        if (t.bridge) placeModel(batch, [cP("box", t.theme === "cyberpunk" ? "#65768a" : "#a8743f", 0, 0, 0, 1.5, 0.08, 0.5)], carteToWorld(t.q, t.r).x, t.h + 0.02, carteToWorld(t.q, t.r).z, carteRand("b" + k) < 0.5 ? 0 : Math.PI / 3);
        return;
      }
      if (carteRand("share" + k) > decorShare) return;
      const w = carteToWorld(t.q, t.r);
      const decor = carteDecorModel(t, theme(t.theme || "foret").pal, t.theme || "foret");
      placeModel(batch, S.dimmed && t.projectId && S.dimmed.has(t.projectId) ? carteDimParts(decor) : decor, w.x, t.h + 0.12, w.z, 0);
    });
    // Tâches.
    S.poi = {}; S.poisByKey = {};
    const urgent = [];
    const storms = [];
    const clocks = [];
    const fires = [];
    const avatars = [];
    const warnings = [];
    const dones = [];
    const borders = {};
    const amb = [];
    const vis = S.visible;
    L.pois.forEach((p) => {
      const t = S.data.taskById[p.taskId];
      if (!t || (vis && !vis.has(t.id))) return;
      const tile = L.tiles[p.key];
      const w = carteToWorld(tile.q, tile.r);
      let ox = 0, oz = 0, k = 1.35;
      const n = L.occupancy[p.key] || 1;
      if (n > 1) { const a = p.stack * 2.4; const r = 0.42 + 0.12 * Math.floor(p.stack / 6); ox = Math.cos(a) * r; oz = Math.sin(a) * r; k = 0.62; }
      const x = w.x + ox, z = w.z + oz, y = tile.h + 0.12;
      const sec = t.secondaryProjectId && L.projectById[t.secondaryProjectId];
      const detail = n > 1 ? Math.min(S.detail, 1) : S.detail;
      let parts = carteTaskModel(t, tile.theme, { detail, secondaryColor: sec ? sec.color : null, people: S.people });
      if (tile.kind === "water" && !/^(mer|ile)$/.test(tile.theme) && t.state !== "info") parts = carteStilts(theme(tile.theme).pal.wood, 0.3).concat(parts.map((pp) => Object.assign({}, pp, { p: [pp.p[0], pp.p[1] + 0.02, pp.p[2]] })));
      if (k !== 1) parts = parts.map((pp) => Object.assign({}, pp, { p: [pp.p[0] * k, pp.p[1] * k, pp.p[2] * k], s: [pp.s[0] * k, pp.s[1] * k, pp.s[2] * k] }));
      const ry = (carteRand("ry" + t.id) - 0.5) * 0.8;
      placeModel(batch, parts, x, y, z, ry, carteRand(t.id) * 6);
      let top = 0; parts.forEach((pp) => { if (pp.m !== "t" && pp.m !== "h") top = Math.max(top, pp.p[1] + pp.s[1]); });
      S.poi[t.id] = { x, y, z, key: p.key, top: y + Math.min(top, 7) + 0.1 };
      const urgentOpen = t.criticality === "urgent" && t.state !== "done" && t.state !== "info";
      if (urgentOpen) urgent.push({ x, y, z, k });
      // En retard : horloge qui fait tic-tac (#414) ; en plus urgente : gros
      // éclairs venus du ciel (#406). Incendie (#385) : urgente sans retard.
      const hz = carteHazard(t);
      if (hz === "tempest") storms.push({ x, y, z, top: y + Math.min(top, 7), big: true, ph: carteRand("storm" + t.id) });
      else if (hz === "clock") clocks.push({ x, y, z, k, top: y + Math.min(top, 7), ph: carteRand("clock" + t.id) });
      else if (hz === "fire") fires.push({ x, y, z, k, h: Math.max(0.3, Math.min(top, 7)), ph: carteRand("fire" + t.id) * 6.283 });
      if (carteDangerSign(t)) {
        let wb = y + Math.min(top, 7) + (hz === "clock" ? CLOCK_RISE * k + CLOCK_R * 2 * k + 0.25 : 0.5 * k);
        // Au-dessus du badge d'initiales du responsable, qui le masquerait.
        if (t.assignee && S.people) wb = Math.max(wb, y + carteAvatarAnchor(t)[1] * k + 0.2 + (0.55 + 0.25 * k) / 2 + 0.8);
        const wsz = carteWarningSize(k);
        warnings.push({ x, z, k, base: wb, ph: carteRand("warn" + t.id) });
        // Le nom de la tâche (#444) se pose au-dessus du panneau.
        S.poi[t.id].labelTop = wb + wsz + 0.1;
      }
      // Avatar (#382, #398) : badge d'initiales au-dessus du bonhomme, à tous
      // les niveaux de détail et sur les cases partagées.
      if (t.assignee && S.people) {
        const a = carteAvatarAnchor(t);
        const cr = Math.cos(ry), sr = Math.sin(ry);
        avatars.push({ name: t.assignee, color: cartePersonColor(t.assignee, t.assigneeColor), x: x + (a[0] * cr + a[2] * sr) * k, y: y + a[1] * k, z: z + (-a[0] * sr + a[2] * cr) * k, k });
      }
      if (t.state === "done") dones.push(x, y + Math.min(top, 7) + 1.05, z);
      amb.push({ t, x, y, z, k, ry, top: y + Math.min(top, 7) });
      // Une case partagée prend la couleur de sa tâche la plus pressante.
      const rank = t.overdue ? 0 : CARTE_BORDER_RANK[t.state] != null ? CARTE_BORDER_RANK[t.state] : 5;
      if (!borders[p.key] || rank < borders[p.key].rank) borders[p.key] = { rank, color: t.statusColor };
      (S.poisByKey[p.key] = S.poisByKey[p.key] || []).push(t.id);
    });
    // Cœurs de projets (#395, #399) : des totems harmonisés. Chaque cœur est
    // posé sur une colonne aux couleurs du projet ; tous culminent à la même
    // altitude, au-dessus de la tâche affichée la plus haute.
    let taskTop = 0;
    Object.keys(S.poi).forEach((id) => { taskTop = Math.max(taskTop, S.poi[id].top); });
    const hubs = L.territories.map((tr) => {
      const p = L.projectById[tr.projectId];
      const st = S.stats[tr.projectId] || { stage: 0 };
      const tile = L.tiles[carteKey(tr.q, tr.r)];
      const model = carteHubModel(tr.theme, st.stage, p.color, p.priority).map((m) => Object.assign({}, m, { p: [m.p[0] * 1.3, m.p[1] * 1.3, m.p[2] * 1.3], s: [m.s[0] * 1.3, m.s[1] * 1.3, m.s[2] * 1.3] }));
      let top = 0; model.forEach((m) => { top = Math.max(top, m.p[1] + m.s[1]); });
      return { tr, p, tile, model, top, base: tile.h + 0.12 };
    });
    const summit = Math.max(taskTop + CARTE_TOTEM_MARGIN, ...hubs.map((h) => h.base + h.top), CARTE_TOTEM_MIN);
    hubs.forEach((h) => {
      const w = carteToWorld(h.tr.q, h.tr.r);
      const column = carteTotemColumn(summit - h.base - h.top, h.p.color, theme(h.tr.theme).pal.stone);
      const parts = column.parts.concat(h.model.map((m) => Object.assign({}, m, { p: [m.p[0], m.p[1] + column.h, m.p[2]] })));
      placeModel(batch, S.dimmed && S.dimmed.has(h.tr.projectId) ? carteDimParts(parts) : parts, w.x, h.base, w.z, 0, 0);
      h.tr.anchor = new THREE.Vector3(w.x, summit + 0.35, w.z);
      h.tr.world = new THREE.Vector3(w.x, h.base, w.z);
      h.x = w.x; h.z = w.z;
    });
    S.spin = batch.flush(world, shadows);
    if (dones.length) {
      const geo = new THREE.BufferGeometry();
      geo.setAttribute("position", new THREE.Float32BufferAttribute(dones, 3));
      const pts = new THREE.Points(geo, MAT.check);
      pts.userData.ownGeo = true;
      pts.frustumCulled = false;
      world.add(pts);
    }
    // Tâches urgentes (#367) : anneau au sol et fanal rouge qui clignotent.
    if (urgent.length) {
      const ring = new THREE.InstancedMesh(ringGeo, MAT.alarm, urgent.length);
      urgent.forEach((u, i) => {
        ring.setMatrixAt(i, tmpM.compose(tmpP.set(u.x, u.y + 0.03, u.z), tmpQ.identity(), tmpS.set(u.k * 0.85, 1, u.k * 0.85)));
      });
      ring.instanceMatrix.needsUpdate = true; ring.computeBoundingSphere(); ring.frustumCulled = false; world.add(ring);
    }
    const bKeys = Object.keys(borders);
    if (bKeys.length) {
      const bm = new THREE.InstancedMesh(borderGeo, MAT.border, bKeys.length);
      bKeys.forEach((k, i) => {
        const tile = L.tiles[k], w = carteToWorld(tile.q, tile.r);
        // Au-dessus de la dalle claire de la tâche (#379), qui la masquerait.
        bm.setMatrixAt(i, tmpM.compose(tmpP.set(w.x, (capTop[k] != null ? capTop[k] : tile.h + 0.12) + 0.05, w.z), tmpQ.identity(), tmpS.set(1, 1, 1)));
        const c = S.dimmed && tile.projectId && S.dimmed.has(tile.projectId) ? carteMix(borders[k].color, CARTE_DIM_TOP, 0.7) : borders[k].color;
        bm.setColorAt(i, tmpC.set(c || "#94A3B8"));
      });
      bm.instanceMatrix.needsUpdate = true; if (bm.instanceColor) bm.instanceColor.needsUpdate = true;
      bm.computeBoundingSphere();
      world.add(bm);
    }
    buildStorms(storms);
    buildClocks(clocks);
    buildFires(fires);
    buildAvatars(avatars);
    buildWarnings(warnings);
    buildAmbient({ tasks: amb, hubs, summit, regions, avatars });
    buildTrail();
    buildMilestoneRings(amb);
    const maxSpin = q === "low" || reduced ? 0 : q === "medium" ? 60 : 240;
    S.spin = S.spin.slice(0, maxSpin);
    drawSelection();
  }

  // ---------- Sélection, routes de convoi ----------
  function drawSelection() {
    clearGroup(overlay);
    S.convoys = [];
    const id = S.selected;
    const pos = id && S.poi[id];
    if (!pos) return;
    const ring = new THREE.Mesh(ringGeo, MAT.ring.clone());
    ring.userData.ownMat = true;
    ring.material.color.set("#245edb");
    const tile = S.layout.tiles[pos.key];
    const w = carteToWorld(tile.q, tile.r);
    ring.position.set(w.x, tile.h + 0.14, w.z);
    overlay.add(ring);
    const t = S.data.taskById[id];
    const links = [];
    t.dependsOn.forEach((d) => links.push({ other: d, color: "#6b4ce6", into: true }));
    S.data.tasks.forEach((o2) => { if (o2.dependsOn.indexOf(id) !== -1) links.push({ other: o2.id, color: "#e07b1a", into: false }); });
    const from = new THREE.Vector3(pos.x, pos.y + 0.2, pos.z);
    const arc = (a, b, color, dash) => {
      const mid = a.clone().lerp(b, 0.5); mid.y += 0.8 + a.distanceTo(b) * 0.18;
      const curve = new THREE.QuadraticBezierCurve3(a, mid, b);
      const geo = new THREE.BufferGeometry().setFromPoints(curve.getPoints(48));
      const line = new THREE.Line(geo, new THREE.LineDashedMaterial({ color, dashSize: dash, gapSize: dash * 0.7 }));
      line.computeLineDistances();
      line.userData.ownGeo = line.userData.ownMat = true;
      overlay.add(line);
      return curve;
    };
    links.forEach((lk) => {
      const op = S.poi[lk.other];
      const other = S.data.taskById[lk.other];
      let end;
      if (op) end = new THREE.Vector3(op.x, op.y + 0.2, op.z);
      else if (other) {
        const tr = S.layout.territories.find((x) => x.projectId === (other.projectId || "__terre-inconnue__"));
        if (!tr || !tr.world) return;
        end = tr.world.clone().add(new THREE.Vector3(0, 0.3, 0));
      } else return;
      const a = lk.into ? end : from, b = lk.into ? from : end;
      const curve = arc(a, b, lk.color, 0.22);
      // Prédécesseur non terminé : la charrette attend devant une barrière.
      const pred = lk.into ? other : t;
      const blocked = pred && pred.state !== "done";
      const cart = new THREE.Mesh(G.box, new THREE.MeshLambertMaterial({ color: blocked ? "#b0493a" : "#8a5a35" }));
      cart.userData.ownMat = true;
      cart.scale.set(0.22, 0.16, 0.3);
      overlay.add(cart);
      S.convoys.push({ curve, cart, blocked });
      if (blocked) {
        const bar = new THREE.Mesh(G.box, new THREE.MeshBasicMaterial({ color: "#DC2626" }));
        bar.userData.ownMat = true;
        const p = curve.getPoint(0.86);
        bar.position.copy(p); bar.scale.set(0.5, 0.06, 0.06);
        overlay.add(bar);
      }
    });
    if (t.secondaryProjectId) {
      const tr = S.layout.territories.find((x) => x.projectId === t.secondaryProjectId);
      if (tr && tr.world) arc(from, tr.world.clone().add(new THREE.Vector3(0, 0.3, 0)), "#2a9d8f", 0.12);
    }
  }

  // ---------- Arpenteur ----------
  const keeper = new THREE.Group();
  (function buildKeeper() {
    const m = (c) => { const x = new THREE.MeshLambertMaterial({ color: c, flatShading: true }); mats.push(x); return x; };
    const coat = m("#3f6fb5"), skin = m("#f1c9a5"), hat = m("#c9a24a"), boot = m("#4a3a2a"), staff = m("#e8e0d0");
    const add = (geo, mt, x, y, z, sx, sy, sz) => { const me = new THREE.Mesh(geo, mt); me.position.set(x, y, z); me.scale.set(sx, sy, sz); me.castShadow = true; keeper.add(me); return me; };
    const body = add(G.cyl, coat, 0, 0.16, 0, 0.36, 0.44, 0.36);
    add(G.ball, skin, 0, 0.58, 0, 0.28, 0.28, 0.28);
    add(G.cyl, hat, 0, 0.8, 0, 0.56, 0.04, 0.56);
    add(G.cyl, hat, 0, 0.82, 0, 0.3, 0.14, 0.3);
    const l1 = add(G.cyl, boot, -0.08, 0, 0, 0.12, 0.18, 0.12);
    const l2 = add(G.cyl, boot, 0.08, 0, 0, 0.12, 0.18, 0.12);
    add(G.cyl, staff, 0.24, 0, 0.08, 0.04, 0.9, 0.04);
    add(G.box, m("#d9412f"), 0.24, 0.72, 0.08, 0.1, 0.08, 0.02);
    const shadow = new THREE.Mesh(new THREE.CircleGeometry(0.3, 12), new THREE.MeshBasicMaterial({ color: "#000000", transparent: true, opacity: 0.18, depthWrite: false }));
    shadow.rotation.x = -Math.PI / 2; shadow.position.y = 0.01; keeper.add(shadow);
    geos.push(shadow.geometry); mats.push(shadow.material);
    // Barque (#428) : cachée à terre, elle porte l'arpenteur sur l'eau.
    const boat = new THREE.Group();
    const wood = m("#8a5a35"), woodDark = m("#5f3c22");
    const part = (mt, x, y, z, sx, sy, sz) => { const me = new THREE.Mesh(G.box, mt); me.position.set(x, y, z); me.scale.set(sx, sy, sz); me.castShadow = true; boat.add(me); };
    part(woodDark, 0, -0.06, 0, 0.5, 0.08, 1.05);
    part(wood, -0.26, -0.04, 0, 0.06, 0.2, 1.0); part(wood, 0.26, -0.04, 0, 0.06, 0.2, 1.0);
    part(wood, 0, -0.04, 0.5, 0.5, 0.2, 0.06); part(wood, 0, -0.04, -0.5, 0.5, 0.16, 0.06);
    const bow = new THREE.Mesh(G.pyr, wood); bow.position.set(0, -0.06, 0.62); bow.rotation.set(Math.PI / 2, Math.PI / 4, 0); bow.scale.set(0.5, 0.26, 0.2); boat.add(bow);
    const oar = new THREE.Mesh(G.box, woodDark); oar.position.set(0.34, 0.1, 0); oar.rotation.z = -0.9; oar.scale.set(0.04, 0.8, 0.06); boat.add(oar);
    boat.visible = false;
    keeper.add(boat);
    keeper.userData = { body, l1, l2, boat, oar };
    scene.add(keeper);
  })();

  function groundAt(x, z) {
    const h = carteFromWorld(x, z);
    const t = S.layout && S.layout.tiles[carteKey(h[0], h[1])];
    if (!t) return null;
    if (t.kind === "sea" || t.kind === "water") return t.bridge ? t.h + 0.1 : Math.max(0.12, t.h) + 0.02;
    return t.h + 0.12;
  }

  // ---------- Caméra ----------
  function updateCamera(dt, snap) {
    const goal = S.follow ? tmpP.set(keeper.position.x, keeper.position.y + 0.4, keeper.position.z) : (S.focusGoal || S.target);
    const k = snap || reduced ? 1 : 1 - Math.pow(0.001, dt);
    S.target.lerp(goal, k);
    const cp = Math.cos(S.pitch), sp = Math.sin(S.pitch);
    camera.position.set(S.target.x + Math.sin(S.yaw) * cp * S.dist, S.target.y + sp * S.dist, S.target.z + Math.cos(S.yaw) * cp * S.dist);
    camera.lookAt(S.target);
    // Les noms de dossiers se retournent quand la caméra passe de l'autre
    // côté de l'île : ils se lisent toujours de gauche à droite.
    (S.regionLabels || []).forEach((m) => {
      const th = m.userData.theta;
      const flip = Math.cos(th) * Math.cos(S.yaw) - Math.sin(th) * Math.sin(S.yaw) < 0;
      m.rotation.z = -th + (flip ? Math.PI : 0);
      // De près, le nom s'efface : il sert à s'orienter de loin.
      m.material.opacity = m.userData.alpha * Math.max(0, Math.min(1, (S.dist - 17) / 15));
      m.visible = m.material.opacity > 0.01;
    });
    scene.fog.near = S.dist * 0.8 + 25;
    scene.fog.far = S.dist * 2.2 + 70;
    if (sun.castShadow) { sun.position.set(S.target.x + 30, 50, S.target.z + 20); sun.target.position.copy(S.target); }
  }
  function zoomBy(f) { S.dist = Math.max(7, Math.min(150, S.dist * f)); }

  // ---------- Entrées ----------
  const keyMap = { arrowup: "f", z: "f", w: "f", arrowdown: "b", s: "b", arrowleft: "l", q: "l", a: "l", arrowright: "r", d: "r" };
  function onKey(e, down) {
    if (e.altKey || e.ctrlKey || e.metaKey) return;
    const tag = (e.target && e.target.tagName) || "";
    if (/INPUT|TEXTAREA|SELECT/.test(tag) || (e.target && e.target.isContentEditable)) return;
    const k = String(e.key || "").toLowerCase();
    if (keyMap[k]) { S.keys[keyMap[k]] = down; if (down) { S.follow = true; S.walkTo = null; } e.preventDefault(); return; }
    if (!down) return;
    if (k === "e" || k === "pageup") { S.yaw += Math.PI / 6; e.preventDefault(); }
    else if (k === "r" || k === "pagedown") { S.yaw -= Math.PI / 6; e.preventDefault(); }
    else if (k === "+" || k === "=") { zoomBy(0.8); e.preventDefault(); }
    else if (k === "-") { zoomBy(1.25); e.preventDefault(); }
    else if (k === "enter" || k === " ") { if (S.near) { select(S.near); e.preventDefault(); } }
    else if (k === "c") { recenter(); e.preventDefault(); }
  }
  const kd = (e) => onKey(e, true), ku = (e) => onKey(e, false);
  const blur = () => { S.keys = {}; };
  const keyTarget = o.keyTarget || container;
  keyTarget.addEventListener("keydown", kd);
  keyTarget.addEventListener("keyup", ku);
  keyTarget.addEventListener("blur", blur, true);
  const onWheel = (e) => { e.preventDefault(); zoomBy(e.deltaY > 0 ? 1.12 : 0.89); };
  canvas.addEventListener("wheel", onWheel, { passive: false });

  const pointers = {}; let drag = null, pinch = null;
  const ray = new THREE.Raycaster(), ndc = new THREE.Vector2();
  function pick(cx, cy) {
    const rect = canvas.getBoundingClientRect();
    ndc.set(((cx - rect.left) / rect.width) * 2 - 1, -((cy - rect.top) / rect.height) * 2 + 1);
    ray.setFromCamera(ndc, camera);
    const hits = ray.intersectObjects(S.pickMeshes || [], false);
    if (!hits.length) return null;
    return { key: hits[0].object.userData.keys[hits[0].instanceId], point: hits[0].point };
  }
  function taskAt(k, point) {
    const ids = S.poisByKey[k];
    if (!ids || !ids.length) return null;
    if (ids.length === 1 || !point) return ids[0];
    let best = ids[0], bd = Infinity;
    ids.forEach((id) => { const p = S.poi[id]; const d = Math.hypot(p.x - point.x, p.z - point.z); if (d < bd) { bd = d; best = id; } });
    return best;
  }
  const hubAt = (k) => { const t = S.layout.tiles[k]; return t && t.kind === "hub" ? t.projectId : null; };
  // Totem sous le pointeur (#399) : le segment vertical du cœur de projet,
  // projeté à l'écran. Les dalles seules ne suffisent pas : le haut du totem
  // passe devant d'autres cases.
  const segA = new THREE.Vector3(), segB = new THREE.Vector3();
  function totemAt(cx, cy) {
    if (!S.layout) return null;
    const rect = canvas.getBoundingClientRect();
    const px = cx - rect.left, py = cy - rect.top, W = rect.width, H = rect.height;
    let best = null, bd = Infinity;
    S.layout.territories.forEach((tr) => {
      if (!tr.anchor || !tr.world) return;
      segA.copy(tr.world).project(camera); segB.copy(tr.anchor).project(camera);
      if (segA.z > 1 || segB.z > 1) return;
      const ax = (segA.x + 1) / 2 * W, ay = (1 - segA.y) / 2 * H, bx = (segB.x + 1) / 2 * W, by = (1 - segB.y) / 2 * H;
      const vx = bx - ax, vy = by - ay, l2 = vx * vx + vy * vy || 1;
      const u = Math.max(0, Math.min(1, ((px - ax) * vx + (py - ay) * vy) / l2));
      const d = Math.hypot(px - (ax + vx * u), py - (ay + vy * u));
      // Tolérance proportionnelle à la taille apparente du totem.
      const tol = Math.max(14, Math.min(60, Math.sqrt(l2) * 0.35));
      if (d < tol && d < bd) { bd = d; best = tr.projectId; }
    });
    return best;
  }
  // Glisser la vue (#396) : clic molette ou clic droit enfoncé, Maj + clic
  // gauche, ou clic gauche en mode « main ». La caméra quitte l'arpenteur, qui
  // ne bouge pas ; le recentrage ou un pas de l'arpenteur la lui rendent.
  function panBy(dx, dy) {
    const H = canvas.clientHeight || 600;
    const k = (2 * S.dist * Math.tan((camera.fov * Math.PI) / 360)) / H;
    const rx = Math.cos(S.yaw), rz = -Math.sin(S.yaw), fx = -Math.sin(S.yaw), fz = -Math.cos(S.yaw);
    const kf = k / Math.max(0.5, Math.sin(S.pitch));
    const mx = -rx * dx * k + fx * dy * kf, mz = -rz * dx * k + fz * dy * kf;
    if (S.follow || !S.focusGoal) S.focusGoal = S.target.clone();
    S.follow = false;
    S.focusGoal.x += mx; S.focusGoal.z += mz;
    S.target.x += mx; S.target.z += mz;
  }
  const onDown = (e) => {
    if (keyTarget.focus) keyTarget.focus({ preventScroll: true });
    // Clic molette : pas de défilement automatique du navigateur.
    if (e.button === 1) e.preventDefault();
    pointers[e.pointerId] = { x: e.clientX, y: e.clientY };
    try { canvas.setPointerCapture(e.pointerId); } catch (err) { /* pointeur déjà relâché */ }
    const ids = Object.keys(pointers);
    if (ids.length === 2) { const a = pointers[ids[0]], b = pointers[ids[1]]; pinch = { d: Math.hypot(a.x - b.x, a.y - b.y), dist: S.dist }; drag = null; }
    else {
      const pan = e.button === 1 || e.button === 2 || (e.button === 0 && (e.shiftKey || S.panMode));
      drag = { sx: e.clientX, sy: e.clientY, lx: e.clientX, ly: e.clientY, yaw: S.yaw, pitch: S.pitch, moved: false, pan };
      if (pan) canvas.style.cursor = "grabbing";
    }
  };
  const onMove = (e) => {
    if (pointers[e.pointerId]) pointers[e.pointerId] = { x: e.clientX, y: e.clientY };
    const ids = Object.keys(pointers);
    if (pinch && ids.length === 2) {
      const a = pointers[ids[0]], b = pointers[ids[1]];
      S.dist = Math.max(7, Math.min(150, pinch.dist * pinch.d / Math.max(20, Math.hypot(a.x - b.x, a.y - b.y))));
      return;
    }
    if (drag) {
      const dx = e.clientX - drag.sx, dy = e.clientY - drag.sy;
      if (Math.hypot(dx, dy) > 6) drag.moved = true;
      if (drag.pan) { if (drag.moved) panBy(e.clientX - drag.lx, e.clientY - drag.ly); drag.lx = e.clientX; drag.ly = e.clientY; }
      else if (drag.moved) { S.yaw = drag.yaw - dx * 0.006; S.pitch = Math.max(0.45, Math.min(1.35, drag.pitch + dy * 0.004)); }
      return;
    }
    if (e.pointerType === "mouse" && S.layout) {
      // Survol d'un avatar (#382) : bulle avec le nom du responsable.
      const rect = canvas.getBoundingClientRect();
      ndc.set(((e.clientX - rect.left) / rect.width) * 2 - 1, -((e.clientY - rect.top) / rect.height) * 2 + 1);
      ray.setFromCamera(ndc, camera);
      const av = (S.avatarSprites || []).length ? ray.intersectObjects(S.avatarSprites, false)[0] : null;
      if (av) {
        tip.textContent = "Responsable : " + av.object.userData.name;
        tip.style.transform = "translate(" + Math.round(e.clientX - rect.left + 14) + "px," + Math.round(e.clientY - rect.top + 12) + "px)";
        tip.hidden = false;
      } else tip.hidden = true;
      const h = pick(e.clientX, e.clientY);
      const totem = totemAt(e.clientX, e.clientY);
      const id = h && !totem ? taskAt(h.key, h.point) : null;
      const hp = totem || (h && !id ? hubAt(h.key) : null);
      const hv = id ? "t:" + id : hp ? "p:" + hp : null;
      if (hv !== S.hovered) { S.hovered = hv; canvas.style.cursor = hv && !S.panMode ? "pointer" : "grab"; }
    }
  };
  const onUp = (e) => {
    delete pointers[e.pointerId];
    if (pinch) { if (Object.keys(pointers).length < 2) pinch = null; drag = null; return; }
    if (drag && drag.pan) canvas.style.cursor = S.panMode ? "grab" : S.hovered ? "pointer" : "grab";
    if (drag && !drag.moved && !(drag.pan && e.button !== 0) && S.layout) {
      const h = pick(e.clientX, e.clientY);
      const totem = totemAt(e.clientX, e.clientY);
      // Un clic (ou un toucher) sur un totem épingle le nom du projet.
      S.pinnedHub = totem || (h ? hubAt(h.key) : null);
      if (totem) { if (o.onTerritory) o.onTerritory(totem); focusProject(totem); }
      else if (h) {
        const id = taskAt(h.key, h.point), hp = hubAt(h.key);
        if (id) { walkToTask(id); select(id); }
        else { if (hp && o.onTerritory) o.onTerritory(hp); walkTo(h.point.x, h.point.z); }
      }
    }
    drag = null;
  };
  const onCancel = (e) => { delete pointers[e.pointerId]; drag = null; pinch = null; };
  const onMenu = (e) => e.preventDefault();
  const onAux = (e) => { if (e.button === 1) e.preventDefault(); };
  canvas.addEventListener("contextmenu", onMenu);
  canvas.addEventListener("mousedown", onAux);
  canvas.addEventListener("pointerdown", onDown);
  canvas.addEventListener("pointermove", onMove);
  canvas.addEventListener("pointerup", onUp);
  canvas.addEventListener("pointercancel", onCancel);
  const hideTip = () => { tip.hidden = true; if (S.hovered && S.hovered.startsWith("p:")) S.hovered = null; };
  canvas.addEventListener("pointerleave", hideTip);
  canvas.addEventListener("wheel", hideTip, { passive: true });

  function walkTo(x, z) { S.walkTo = { x, z }; S.follow = true; }
  function walkToTask(id) {
    const p = S.poi[id];
    if (!p) return false;
    const dx = keeper.position.x - p.x, dz = keeper.position.z - p.z, d = Math.hypot(dx, dz) || 1;
    walkTo(p.x + dx / d * 0.75, p.z + dz / d * 0.75);
    return true;
  }

  function step(dt) {
    const f = (S.keys.f ? 1 : 0) - (S.keys.b ? 1 : 0) - S.joy.y;
    const s = (S.keys.r ? 1 : 0) - (S.keys.l ? 1 : 0) + S.joy.x;
    let mx = 0, mz = 0;
    if (Math.abs(f) > 0.05 || Math.abs(s) > 0.05) {
      const fx = -Math.sin(S.yaw), fz = -Math.cos(S.yaw);
      mx = fx * f - fz * s; mz = fz * f + fx * s;
      S.walkTo = null;
    } else if (S.walkTo) {
      mx = S.walkTo.x - keeper.position.x; mz = S.walkTo.z - keeper.position.z;
      if (Math.hypot(mx, mz) < 0.12) { S.walkTo = null; mx = mz = 0; }
    }
    const len = Math.hypot(mx, mz);
    if (len > 0) {
      const sp = 3.8 * Math.min(1, len);
      mx /= len; mz /= len;
      let nx = keeper.position.x + mx * sp * dt, nz = keeper.position.z + mz * sp * dt;
      if (groundAt(nx, nz) == null) { S.walkTo = null; nx = keeper.position.x; nz = keeper.position.z; }
      keeper.position.x = nx; keeper.position.z = nz;
      keeper.rotation.y = Math.atan2(mx, mz);
      S.walkPhase += dt * 12;
    }
    const gy = groundAt(keeper.position.x, keeper.position.z);
    const u = keeper.userData;
    // Sur l'eau (hors pont), l'arpenteur rame dans sa barque (#428).
    const kh = carteFromWorld(keeper.position.x, keeper.position.z);
    const kt = S.layout.tiles[carteKey(kh[0], kh[1])];
    const afloat = !!(kt && (kt.kind === "sea" || kt.kind === "water") && !kt.bridge);
    u.boat.visible = afloat;
    const bob = afloat ? Math.sin(S.time * (reduced ? 1.2 : 2.6)) * 0.035 + 0.06 : 0;
    if (afloat) { u.boat.rotation.z = Math.sin(S.time * (reduced ? 0.9 : 1.9)) * 0.06; u.oar.rotation.x = len > 0 && !reduced ? Math.sin(S.walkPhase * 0.5) * 0.5 : 0; }
    if (gy != null) keeper.position.y += (gy + bob - keeper.position.y) * Math.min(1, dt * 14);
    const moving = len > 0 && !reduced && !afloat;
    u.l1.position.z = moving ? Math.sin(S.walkPhase) * 0.06 : 0;
    u.l2.position.z = moving ? -Math.sin(S.walkPhase) * 0.06 : 0;
    u.body.position.y = 0.16 + (moving ? Math.abs(Math.sin(S.walkPhase)) * 0.03 : 0);
    // Tâche la plus proche (lecture seule).
    let near = null, nd = 1.3;
    const kq = carteFromWorld(keeper.position.x, keeper.position.z);
    for (let dq = -1; dq <= 1; dq++) for (let dr = -1; dr <= 1; dr++) {
      const list = S.poisByKey[carteKey(kq[0] + dq, kq[1] + dr)];
      if (!list) continue;
      list.forEach((id) => { const p = S.poi[id]; const d = Math.hypot(p.x - keeper.position.x, p.z - keeper.position.z); if (d < nd) { nd = d; near = id; } });
    }
    if (near !== S.near) { S.near = near; o.onNear && o.onNear(near); }
    const here = S.layout.tiles[carteKey(kq[0], kq[1])];
    const terr = here && here.projectId ? here.projectId : null;
    if (terr !== S.territory) { S.territory = terr; o.onTerritoryEnter && o.onTerritoryEnter(terr); }
  }

  // ---------- Gros éclairs des tâches en retard ET urgentes (#406) ----------
  // Un nuage noir très haut dans le ciel, d'où tombent trois gros éclairs en
  // zigzag jusqu'à la tâche, avec un halo et une pluie dense.
  const CLOUD_BIG = [[-0.34, 0, 0, 0.72], [0.3, 0.06, 0.08, 0.66], [0, 0.2, -0.08, 0.82], [0.06, -0.04, 0.26, 0.56], [-0.62, 0.1, -0.3, 0.7], [0.62, 0.1, -0.22, 0.74], [0, 0.34, 0.3, 0.76]];
  const BIG_BOLTS = 3, BOLT_SEGS = 8, BIG_CLOUD_RISE = 7, CLOUD_F = 2.4;
  const boltA = new THREE.Vector3(), boltB = new THREE.Vector3(), boltD = new THREE.Vector3();
  function buildStorms(list) {
    S.storms = null;
    if (!list.length) return;
    const low = S.effQuality === "low";
    const all = list.slice(0, 80);
    const clouds = new THREE.InstancedMesh(G.ball, MAT.cloud, all.length * CLOUD_BIG.length);
    let ci = 0;
    all.forEach((s) => {
      const f = CLOUD_F;
      s.cloudY = s.top + BIG_CLOUD_RISE;
      s.ground = s.y + 0.05;
      CLOUD_BIG.forEach((c) => {
        clouds.setMatrixAt(ci, tmpM.compose(tmpP.set(s.x + c[0] * f, s.cloudY + c[1] * f - c[3] * f * 0.5, s.z + c[2] * f), tmpQ.identity(), tmpS.set(c[3] * f, c[3] * f * 0.72, c[3] * f)));
        clouds.setColorAt(ci, tmpC.set("#262a33"));
        ci++;
      });
    });
    clouds.instanceMatrix.needsUpdate = true; if (clouds.instanceColor) clouds.instanceColor.needsUpdate = true;
    clouds.frustumCulled = false; world.add(clouds);
    const nSeg = all.length * BIG_BOLTS * BOLT_SEGS;
    const bigBolts = new THREE.InstancedMesh(G.box, MAT.bolt, nSeg);
    const halo = new THREE.InstancedMesh(G.box, MAT.boltHalo, nSeg);
    [bigBolts, halo].forEach((m) => { m.frustumCulled = false; world.add(m); });
    const drops = low ? 24 : 60;
    const rain = new THREE.InstancedMesh(G.box, MAT.rain, all.length * drops);
    rain.frustumCulled = false; world.add(rain);
    S.storms = { list: all, clouds, bigBolts, halo, rain, drops };
    placeStorms(0);
  }
  // Animation continue (#397) : l'orage et le feu bougent toujours, même en
  // qualité basse. Si le système demande moins d'animations, le mouvement
  // ralentit et l'éclair reste allumé au lieu de clignoter (aucun flash).
  const calm = reduced;
  const hidden = () => tmpM.compose(tmpP.set(0, -50, 0), tmpQ.identity(), tmpS.set(0.0001, 0.0001, 0.0001));
  function placeStorms(t0) {
    const W = S.storms;
    if (!W) return;
    const t = calm ? t0 * 0.3 : t0;
    let si = 0, di = 0;
    W.list.forEach((s) => {
      const f = CLOUD_F;
      // Chaque éclat redessine un tracé nouveau ; figé si animations réduites.
      for (let j = 0; j < BIG_BOLTS; j++) {
        const cycT = t * 0.75 + s.ph + j * 0.31;
        const cyc = cycT % 1;
        const on = calm || cyc < 0.09 || (cyc > 0.14 && cyc < 0.2);
        const seed = "bolt" + j + ":" + (calm ? 0 : Math.floor(cycT)) + ":" + s.ph;
        const a0 = j * 2.094 + s.ph * 6.283;
        const sx = s.x + Math.cos(a0) * 0.9 * f, sz = s.z + Math.sin(a0) * 0.9 * f;
        const ex = s.x + Math.cos(a0) * 0.25, ez = s.z + Math.sin(a0) * 0.25;
        const top = s.cloudY - 0.3, fall = top - s.ground;
        const point = (i, out) => {
          const u = i / BOLT_SEGS;
          const amp = i === 0 || i === BOLT_SEGS ? 0 : 0.55 * Math.sin(Math.PI * u) + 0.12;
          return out.set(
            sx + (ex - sx) * u + (carteRand(seed + "x" + i) - 0.5) * 2 * amp,
            top - fall * u,
            sz + (ez - sz) * u + (carteRand(seed + "z" + i) - 0.5) * 2 * amp,
          );
        };
        point(0, boltA);
        for (let i = 1; i <= BOLT_SEGS; i++) {
          point(i, boltB);
          if (on) {
            boltD.subVectors(boltB, boltA);
            const len = boltD.length();
            tmpQ.setFromUnitVectors(UP, boltD.normalize());
            W.bigBolts.setMatrixAt(si, tmpM.compose(boltA, tmpQ, tmpS.set(0.2, len, 0.2)));
            W.halo.setMatrixAt(si, tmpM.compose(boltA, tmpQ, tmpS.set(0.62, len, 0.62)));
          } else {
            W.bigBolts.setMatrixAt(si, hidden());
            W.halo.setMatrixAt(si, hidden());
          }
          si++;
          boltA.copy(boltB);
        }
      }
      // Pluie : gouttes qui tombent du nuage jusqu'au sol, en boucle.
      const fall = Math.max(0.3, s.cloudY - s.ground);
      for (let j = 0; j < W.drops; j++) {
        const a = carteRand("r" + j) * 6.283, r = Math.sqrt(carteRand("rr" + j)) * 0.62 * f;
        const yv = s.cloudY - 0.1 - ((t * 7.5 + carteRand("rp" + j) * fall + s.ph * fall) % fall);
        W.rain.setMatrixAt(di++, tmpM.compose(tmpP.set(s.x + Math.cos(a) * r, yv, s.z + Math.sin(a) * r), tmpQ.setFromAxisAngle(UP, 0), tmpS.set(0.04, 0.5, 0.04)));
      }
    });
    [W.bigBolts, W.halo, W.rain].forEach((m) => { m.instanceMatrix.needsUpdate = true; });
  }

  // ---------- Horloge des tâches en retard (#414) ----------
  // Un réveil rouge flotte au-dessus de la tâche, toujours tourné vers la
  // caméra : cadran blanc, quatre repères, petite aiguille et trotteuse qui
  // avance d'un cran chaque seconde. À chaque tic, le réveil bascule
  // légèrement d'un côté puis de l'autre. Figé si animations réduites.
  const CLOCK_R = 0.42, CLOCK_RISE = 0.9;
  const clockYaw = new THREE.Quaternion(), clockTilt = new THREE.Quaternion(), clockPart = new THREE.Quaternion();
  const clockFace = new THREE.Quaternion().setFromEuler(new THREE.Euler(Math.PI / 2, 0, 0));
  const clockFwd = new THREE.Vector3(), clockRight = new THREE.Vector3(), clockC = new THREE.Vector3(), clockV = new THREE.Vector3();
  function buildClocks(list) {
    S.clocks = null;
    if (!list.length) return;
    const all = list.slice(0, 400);
    const discs = new THREE.InstancedMesh(G.cyl, MAT.clock, all.length * 2);
    const sticks = new THREE.InstancedMesh(G.box, MAT.clock, all.length * 6);
    const knobs = new THREE.InstancedMesh(G.ball, MAT.clock, all.length * 4);
    // Couleurs fixes : boîtier, cadran ; 4 repères, petite aiguille, trotteuse ; 2 cloches, 2 pieds.
    all.forEach((s, i) => {
      discs.setColorAt(i * 2, tmpC.set("#d6332a")); discs.setColorAt(i * 2 + 1, tmpC.set("#fbf7ee"));
      for (let j = 0; j < 6; j++) sticks.setColorAt(i * 6 + j, tmpC.set(j < 5 ? "#2b2b2b" : "#d6332a"));
      for (let j = 0; j < 4; j++) knobs.setColorAt(i * 4 + j, tmpC.set(j < 2 ? "#e0b44a" : "#2b2b2b"));
    });
    [discs, sticks, knobs].forEach((m) => { if (m.instanceColor) m.instanceColor.needsUpdate = true; m.frustumCulled = false; world.add(m); });
    S.clocks = { list: all, discs, sticks, knobs };
    placeClocks(0);
  }
  function placeClocks(t0) {
    const W = S.clocks;
    if (!W) return;
    const t = calm ? 0 : t0;
    W.list.forEach((s, i) => {
      const k = s.k || 1, R = CLOCK_R * k;
      // Face tournée vers la caméra (rotation autour de la verticale).
      const yaw = Math.atan2(camera.position.x - s.x, camera.position.z - s.z);
      const sec = Math.floor(t + s.ph * 60);
      const frac = t + s.ph * 60 - sec;
      // Tic-tac : bascule de ±5° qui s'amortit juste après chaque seconde.
      const rock = calm ? 0 : (sec % 2 ? 1 : -1) * 0.09 * Math.exp(-frac * 9);
      clockYaw.setFromAxisAngle(UP, yaw);
      clockTilt.setFromAxisAngle(clockV.set(0, 0, 1), rock);
      clockYaw.multiply(clockTilt);
      clockFwd.set(0, 0, 1).applyQuaternion(clockYaw);
      clockRight.set(1, 0, 0).applyQuaternion(clockYaw);
      clockC.set(s.x, s.top + CLOCK_RISE * k + R, s.z);
      const at = (dx, dy, dz) => tmpP.copy(clockC).addScaledVector(clockRight, dx).addScaledVector(clockV.set(0, 1, 0).applyQuaternion(clockYaw), dy).addScaledVector(clockFwd, dz);
      // Boîtier puis cadran : deux disques, le cadran un peu devant.
      clockPart.copy(clockYaw).multiply(clockFace);
      W.discs.setMatrixAt(i * 2, tmpM.compose(at(0, 0, -0.1 * k), clockPart, tmpS.set(R * 2, 0.2 * k, R * 2)));
      W.discs.setMatrixAt(i * 2 + 1, tmpM.compose(at(0, 0, 0.1 * k), clockPart, tmpS.set(R * 1.64, 0.02 * k, R * 1.64)));
      // Repères, aiguilles : boîtes tournées dans le plan du cadran.
      const stick = (j, angle, from, len, w) => {
        clockPart.copy(clockYaw).multiply(clockTilt.setFromAxisAngle(clockV.set(0, 0, 1), -angle));
        const dx = Math.sin(angle) * from, dy = Math.cos(angle) * from;
        W.sticks.setMatrixAt(i * 6 + j, tmpM.compose(at(dx, dy, 0.13 * k), clockPart, tmpS.set(w, len, 0.02 * k)));
      };
      for (let j = 0; j < 4; j++) stick(j, j * Math.PI / 2, R * 0.62, R * 0.18, 0.05 * k);
      stick(4, s.ph * 6.283, 0, R * 0.45, 0.07 * k);
      stick(5, (sec % 60) * (Math.PI / 30), 0, R * 0.72, 0.035 * k);
      // Cloches en haut, pieds en bas.
      const knob = (j, dx, dy, d) => W.knobs.setMatrixAt(i * 4 + j, tmpM.compose(at(dx, dy - d / 2, 0), clockYaw, tmpS.set(d, d, d)));
      knob(0, -R * 0.62, R * 0.86, R * 0.55); knob(1, R * 0.62, R * 0.86, R * 0.55);
      knob(2, -R * 0.55, -R * 0.95, R * 0.25); knob(3, R * 0.55, -R * 0.95, R * 0.25);
    });
    [W.discs, W.sticks, W.knobs].forEach((m) => { m.instanceMatrix.needsUpdate = true; });
  }

  // ---------- Incendie des tâches urgentes (#385) ----------
  // Des foyers enveloppent la construction : quatre au pied, deux sur le
  // bâtiment, un au sommet. Chaque foyer = trois flammes (rouge, orange,
  // jaune) qui vacillent. Au-dessus, une colonne de fumée noire monte en
  // boucle et des braises jaillissent.
  const FIRE_FLAMES = [{ c: "#e0301a", r: 0.3, h: 0.78 }, { c: "#ff8616", r: 0.21, h: 0.6 }, { c: "#ffd94a", r: 0.11, h: 0.4 }];
  // [dx, hauteur relative au bâtiment, dz, taille]
  const FIRE_SPOTS = [[0.5, 0, 0.1, 1], [-0.42, 0, 0.3, 0.9], [0.05, 0, -0.5, 0.95], [-0.2, 0, -0.1, 1.1], [0.22, 0.45, 0.18, 0.85], [-0.2, 0.7, -0.12, 0.8], [0.02, 1, 0.02, 1.25]];
  const FIRE_SMOKE = 7, FIRE_EMBERS = 8;
  function buildFires(list) {
    S.fires = null;
    const all = list.slice(0, 150);
    if (!all.length) return;
    const flames = new THREE.InstancedMesh(G.cone, MAT.flame, all.length * FIRE_SPOTS.length * FIRE_FLAMES.length);
    let fi = 0;
    all.forEach(() => FIRE_SPOTS.forEach(() => FIRE_FLAMES.forEach((f) => flames.setColorAt(fi++, tmpC.set(f.c)))));
    if (flames.instanceColor) flames.instanceColor.needsUpdate = true;
    flames.frustumCulled = false; world.add(flames);
    const smoke = new THREE.InstancedMesh(G.ball, MAT.smoke, all.length * FIRE_SMOKE);
    smoke.frustumCulled = false; world.add(smoke);
    const embers = new THREE.InstancedMesh(G.box, MAT.bolt, all.length * FIRE_EMBERS);
    if (embers) { embers.frustumCulled = false; world.add(embers); }
    S.fires = { list: all, flames, smoke, embers };
    placeFires(0);
  }
  function placeFires(t0) {
    const F = S.fires;
    if (!F) return;
    const t = calm ? t0 * 0.3 : t0;
    let fi = 0, si = 0, ei = 0;
    F.list.forEach((u) => {
      const k = u.k;
      FIRE_SPOTS.forEach((sp, j) => {
        const flick = 0.8 + 0.3 * Math.sin(t * 11 + u.ph + j * 1.7) + 0.12 * Math.sin(t * 23 + j);
        const bx = u.x + sp[0] * k, by = u.y + sp[1] * u.h, bz = u.z + sp[2] * k;
        FIRE_FLAMES.forEach((f, m) => {
          const sway = Math.sin(t * 7 + u.ph + j + m) * 0.05;
          const hh = f.h * sp[3] * k * (m ? flick : 0.9 + 0.1 * flick);
          tmpQ.setFromEuler(tmpE.set(sway, 0, sway * 0.6));
          F.flames.setMatrixAt(fi++, tmpM.compose(tmpP.set(bx, by, bz), tmpQ, tmpS.set(f.r * sp[3] * k, hh, f.r * sp[3] * k)));
        });
      });
      const top = u.y + u.h + 0.9 * k;
      for (let j = 0; j < FIRE_SMOKE; j++) {
        const c = (t * 0.35 + j / FIRE_SMOKE + u.ph) % 1;
        const r = (0.26 + c * 0.55) * k;
        const drift = c * 0.45 * k;
        F.smoke.setMatrixAt(si++, tmpM.compose(tmpP.set(u.x + drift * 0.8 + Math.sin(j * 2.1 + u.ph) * 0.12, top + c * 2.2 * k, u.z + drift * 0.3), tmpQ.identity(), tmpS.set(r, r * 0.85, r)));
      }
      {
        for (let j = 0; j < FIRE_EMBERS; j++) {
          const c = (t * 0.9 + carteRand("em" + j) + u.ph) % 1;
          const a = carteRand("ea" + j) * 6.283;
          const rr = (0.2 + c * 0.6) * k;
          F.embers.setMatrixAt(ei++, tmpM.compose(tmpP.set(u.x + Math.cos(a) * rr, u.y + u.h * 0.5 + c * 2.4 * k, u.z + Math.sin(a) * rr), tmpQ.identity(), tmpS.setScalar(0.07 * k * (1 - c * 0.6))));
        }
      }
    });
    F.flames.instanceMatrix.needsUpdate = true;
    F.smoke.instanceMatrix.needsUpdate = true;
    if (F.embers) F.embers.instanceMatrix.needsUpdate = true;
  }

  // ---------- Avatars des responsables (#382) ----------
  const avatarCache = {};
  function avatarMaterial(name, color) {
    const key = name + "|" + color;
    if (avatarCache[key]) return avatarCache[key];
    const c = document.createElement("canvas");
    c.width = c.height = 96;
    const g = c.getContext("2d");
    if (g) {
      g.fillStyle = color; g.beginPath(); g.arc(48, 48, 42, 0, Math.PI * 2); g.fill();
      g.lineWidth = 6; g.strokeStyle = "#ffffff"; g.stroke();
      g.fillStyle = "#ffffff"; g.font = "800 38px Inter, -apple-system, 'Segoe UI', sans-serif";
      g.textAlign = "center"; g.textBaseline = "middle"; g.fillText(carteInitials(name), 48, 51);
    }
    const tex = new THREE.CanvasTexture(c);
    tex.colorSpace = THREE.SRGBColorSpace;
    const m = new THREE.SpriteMaterial({ map: tex, transparent: true });
    avatarCache[key] = m;
    return m;
  }
  function buildAvatars(list) {
    S.avatarSprites = [];
    list.slice(0, 800).forEach((a) => {
      const sp = new THREE.Sprite(avatarMaterial(a.name, a.color));
      sp.position.set(a.x, a.y + 0.2, a.z);
      const sz = 0.55 + 0.25 * a.k;
      sp.scale.set(sz, sz, 1);
      sp.userData.name = a.name;
      world.add(sp);
      S.avatarSprites.push(sp);
    });
  }

  // ---------- Panneau danger des tâches de criticité moyenne (#450) ----------
  // En volume, comme le réveil des tâches en retard : un triangle noir extrudé,
  // une face jaune en relief et un point d'exclamation noir en saillie. Le
  // panneau reste tourné vers la caméra et oscille doucement sur son axe ; la
  // face jaune clignote (allumée / sombre). Figé et allumé si animations
  // réduites.
  const WARN_R = 0.46;
  const carteWarningSize = (k) => WARN_R * k * 1.5; // hauteur du triangle
  // Prisme triangulaire, pointe en haut, épaisseur selon Z, centré sur son
  // centre de gravité (sommet à +R, base à -R/2).
  const warnTriGeo = new THREE.CylinderGeometry(1, 1, 1, 3).rotateX(Math.PI / 2).rotateZ(Math.PI);
  geos.push(warnTriGeo);
  const warnFaceMat = mat(new THREE.MeshBasicMaterial({ color: "#ffc21a" }));
  const warnYaw = new THREE.Quaternion(), warnTilt = new THREE.Quaternion();
  const warnFwd = new THREE.Vector3(), warnRight = new THREE.Vector3(), warnUp = new THREE.Vector3(), warnC = new THREE.Vector3();
  function buildWarnings(list) {
    S.warns = null;
    if (!list.length) return;
    const all = list.slice(0, 400);
    const frame = new THREE.InstancedMesh(warnTriGeo, MAT.clock, all.length);
    const face = new THREE.InstancedMesh(warnTriGeo, warnFaceMat, all.length);
    const bars = new THREE.InstancedMesh(G.box, MAT.clock, all.length);
    const dots = new THREE.InstancedMesh(G.ball, MAT.clock, all.length);
    all.forEach((w, i) => { frame.setColorAt(i, tmpC.set("#1b1b1b")); bars.setColorAt(i, tmpC.set("#1b1b1b")); dots.setColorAt(i, tmpC.set("#1b1b1b")); });
    [frame, face, bars, dots].forEach((m) => { if (m.instanceColor) m.instanceColor.needsUpdate = true; m.frustumCulled = false; m.castShadow = true; world.add(m); });
    S.warns = { list: all, frame, face, bars, dots };
    placeWarnings(0);
  }
  function placeWarnings(t0) {
    const W = S.warns;
    if (!W) return;
    const t = reduced ? 0 : t0;
    W.list.forEach((w, i) => {
      const R = WARN_R * w.k;
      const yaw = Math.atan2(camera.position.x - w.x, camera.position.z - w.z);
      // Balancement lent de ±4°, déphasé d'un panneau à l'autre.
      const rock = reduced ? 0 : Math.sin(t * 2.2 + w.ph * 6.283) * 0.07;
      warnYaw.setFromAxisAngle(UP, yaw);
      warnTilt.setFromAxisAngle(warnC.set(0, 0, 1), rock);
      warnYaw.multiply(warnTilt);
      warnFwd.set(0, 0, 1).applyQuaternion(warnYaw);
      warnRight.set(1, 0, 0).applyQuaternion(warnYaw);
      warnUp.set(0, 1, 0).applyQuaternion(warnYaw);
      // Centre de gravité du triangle : la base repose sur w.base.
      const cx = w.x, cy = w.base + R / 2, cz = w.z;
      const at = (dx, dy, dz) => tmpP.set(cx, cy, cz).addScaledVector(warnRight, dx).addScaledVector(warnUp, dy).addScaledVector(warnFwd, dz);
      W.frame.setMatrixAt(i, tmpM.compose(at(0, 0, 0), warnYaw, tmpS.set(R, R, 0.12 * R)));
      W.face.setMatrixAt(i, tmpM.compose(at(0, -0.02 * R, 0), warnYaw, tmpS.set(0.76 * R, 0.76 * R, 0.2 * R)));
      // Point d'exclamation : barre (base à -0.1 R) et point, en saillie.
      W.bars.setMatrixAt(i, tmpM.compose(at(0, -0.1 * R, 0.12 * R), warnYaw, tmpS.set(0.13 * R, 0.5 * R, 0.06 * R)));
      W.dots.setMatrixAt(i, tmpM.compose(at(0, -0.35 * R, 0.12 * R), warnYaw, tmpS.set(0.15 * R, 0.15 * R, 0.08 * R)));
    });
    [W.frame, W.face, W.bars, W.dots].forEach((m) => { m.instanceMatrix.needsUpdate = true; });
    // Clignotement franc de la face jaune.
    const on = reduced || Math.sin(t0 * 5.2) > -0.35;
    warnFaceMat.color.set(on ? "#ffc21a" : "#5c4708");
  }

  // ---------- Animations persistantes (#425 à #436) ----------
  // Toutes lisent une donnée de Nexora et tournent en continu ; chacune est un
  // maillage instancié plafonné. Animations réduites : mouvement ralenti.
  const ambM = new THREE.Matrix4(), ambL = new THREE.Matrix4(), ambQ = new THREE.Quaternion(), ambE = new THREE.Euler(), ambP = new THREE.Vector3(), ambS = new THREE.Vector3();
  // Pose une pièce dans le repère d'un objet (position, cap, échelle).
  function putPart(mesh, i, base, lx, ly, lz, rx, ry2, rz, sx, sy, sz) {
    ambQ.setFromEuler(ambE.set(rx || 0, ry2 || 0, rz || 0));
    ambL.compose(ambP.set(lx, ly, lz), ambQ, ambS.set(sx, sy, sz));
    mesh.setMatrixAt(i, ambM.multiplyMatrices(base, ambL));
  }
  const baseOf = (m, x, y, z, yaw, k) => m.compose(tmpP.set(x, y, z), tmpQ.setFromAxisAngle(UP, yaw || 0), tmpS.set(k, k, k));
  const ambMesh = (geo, material, n, colors) => {
    const m = new THREE.InstancedMesh(geo, material, Math.max(1, n));
    m.count = n; m.frustumCulled = false;
    if (colors) { for (let i = 0; i < n; i++) m.setColorAt(i, tmpC.set(colors(i))); if (m.instanceColor) m.instanceColor.needsUpdate = true; }
    world.add(m);
    return m;
  };
  const WORKER_C = { vest: "#f08a24", skin: "#f1c9a5", helmet: "#ffd23f", wood: "#6b4a2e", iron: "#5d6470", crate: "#a8743f" };
  function buildAmbient(src) {
    S.amb = null;
    S.daylightWindows = null;
    if (!S.ambient || !S.data) return;
    const A = { workers: [], pigeons: [], lanterns: [], flags: [], convoys: [], windows: [] };
    const low = S.effQuality === "low";
    const taskList = src.tasks;
    const byId = {};
    taskList.forEach((e) => { byId[e.t.id] = e; });
    // Ouvriers (#429) et pigeons (#430) : tâches en cours / en attente.
    taskList.forEach((e) => {
      const st = e.t.state;
      if ((st === "doing" || st === "waiting") && A.workers.length < (low ? 120 : 300)) {
        const c = Math.cos(e.ry), sn = Math.sin(e.ry), lx = 0.62, lz = 0.2;
        A.workers.push({ x: e.x + (lx * c + lz * sn) * e.k, y: e.y, z: e.z + (-lx * sn + lz * c) * e.k, k: e.k, yaw: Math.atan2(-(lx * c + lz * sn), -(-lx * sn + lz * c)), waiting: st === "waiting", ph: carteRand("w" + e.t.id) * 6.283 });
      }
      if (st === "waiting" && A.pigeons.length < (low ? 60 : 150)) {
        const ang = carteRand("pg" + e.t.id) * 6.283;
        A.pigeons.push({ x: e.x, y: e.top + 0.6, z: e.z, dx: Math.cos(ang), dz: Math.sin(ang), speed: cartePigeonSpeed(e.t.idleDays), ph: carteRand("pp" + e.t.id) * 6.283, k: Math.max(0.8, e.k) });
      }
      const rate = carteLanternRate(e.t);
      if (rate != null && A.lanterns.length < 400) {
        const sz = carteTaskSize(e.t), c = Math.cos(e.ry), sn = Math.sin(e.ry), lx = -0.36 * sz, lz = 0.36 * sz;
        A.lanterns.push({ x: e.x + (lx * c + lz * sn) * e.k, y: e.y + 0.52 * sz * e.k, z: e.z + (-lx * sn + lz * c) * e.k, k: e.k, rate, ph: carteRand("ln" + e.t.id) });
      }
      // Fenêtres allumées le soir (#436) : échéance aujourd'hui, tâche ouverte.
      if (e.t.dueIn === 0 && e.t.state !== "done" && e.t.state !== "info" && e.t.state !== "todo") A.windows.push({ x: e.x, y: e.y + (e.top - e.y) * 0.5, z: e.z, k: e.k });
    });
    // Drapeaux (#433) : un par totem.
    src.hubs.forEach((h) => {
      if (h.x == null) return;
      const st = S.stats[h.tr.projectId] || { pct: 0 };
      const dim = S.dimmed && S.dimmed.has(h.tr.projectId);
      A.flags.push({ x: h.x + 0.95, base: h.base, top: src.summit - 0.2, z: h.z, pct: Math.max(0, Math.min(100, st.pct || 0)) / 100, color: dim ? "#aeb3ba" : h.p.color || "#C08A3E", ph: carteRand("fl" + h.tr.projectId) * 6.283 });
    });
    // Convois permanents (#425) : une charrette par dépendance affichée.
    taskList.forEach((e) => {
      (e.t.dependsOn || []).forEach((d) => {
        const pr = byId[d];
        if (!pr || A.convoys.length >= (low ? 80 : 200)) return;
        const a = new THREE.Vector3(pr.x, pr.y + 0.15, pr.z), b = new THREE.Vector3(e.x, e.y + 0.15, e.z);
        const mid = a.clone().lerp(b, 0.5); mid.y += 0.6 + a.distanceTo(b) * 0.12;
        const curve = new THREE.QuadraticBezierCurve3(a, mid, b);
        A.convoys.push({ curve, blocked: pr.t.state !== "done", ph: carteRand("cv" + d + e.t.id) });
      });
    });
    if (A.convoys.length) {
      const pts = [];
      A.convoys.forEach((cv) => { const q = cv.curve.getPoints(24); for (let i = 1; i < q.length; i++) pts.push(q[i - 1], q[i]); });
      const line = new THREE.LineSegments(new THREE.BufferGeometry().setFromPoints(pts), MAT.route);
      line.computeLineDistances(); line.userData.ownGeo = true; line.frustumCulled = false;
      world.add(line);
      A.carts = ambMesh(G.box, MAT.l, A.convoys.length, (i) => (A.convoys[i].blocked ? "#b0493a" : "#8a5a35"));
      const nb = A.convoys.filter((c) => c.blocked).length;
      if (nb) {
        const bars = ambMesh(G.box, MAT.g, nb, () => "#DC2626");
        let bi = 0;
        A.convoys.forEach((cv) => { if (!cv.blocked) return; const p = cv.curve.getPoint(0.86); bars.setMatrixAt(bi++, tmpM.compose(tmpP.copy(p), tmpQ.identity(), tmpS.set(0.5, 0.06, 0.06))); });
        bars.instanceMatrix.needsUpdate = true;
      }
    }
    if (A.workers.length) {
      const n = A.workers.length;
      A.wCyl = ambMesh(G.cyl, MAT.l, n * 2, (i) => (i % 2 ? WORKER_C.helmet : WORKER_C.vest));
      A.wBall = ambMesh(G.ball, MAT.l, n, () => WORKER_C.skin);
      A.wBox = ambMesh(G.box, MAT.l, n * 3, (i) => { const w = A.workers[Math.floor(i / 3)], j = i % 3; return w.waiting ? (j === 0 ? WORKER_C.crate : "#3a3a3a") : j === 0 ? WORKER_C.wood : WORKER_C.iron; });
    }
    if (A.pigeons.length) {
      A.pBody = ambMesh(G.ball, MAT.l, A.pigeons.length, () => "#e8e8ee");
      A.pWing = ambMesh(G.box, MAT.l, A.pigeons.length * 2, () => "#9aa3b2");
    }
    if (A.lanterns.length) A.lMesh = ambMesh(G.ball, MAT.g, A.lanterns.length, () => "#ffcf5a");
    if (A.flags.length) {
      A.fMast = ambMesh(G.cyl, MAT.l, A.flags.length, () => "#5a4030");
      A.fCloth = ambMesh(G.box, MAT.l, A.flags.length, (i) => A.flags[i].color);
      A.flags.forEach((f, i) => A.fMast.setMatrixAt(i, tmpM.compose(tmpP.set(f.x, f.base, f.z), tmpQ.identity(), tmpS.set(0.06, Math.max(0.5, f.top - f.base + 0.2), 0.06))));
      A.fMast.instanceMatrix.needsUpdate = true;
    }
    if (A.windows.length) {
      A.winMesh = ambMesh(G.box, MAT.g, A.windows.length, () => "#ffd27a");
      A.windows.forEach((wn, i) => A.winMesh.setMatrixAt(i, tmpM.compose(tmpP.set(wn.x, wn.y, wn.z), tmpQ.identity(), tmpS.set(0.62 * wn.k, 0.34 * wn.k, 0.62 * wn.k))));
      A.winMesh.instanceMatrix.needsUpdate = true;
      S.daylightWindows = A.winMesh;
    }
    S.amb = A;
    placeAmbient(S.time);
  }
  function placeAmbient(t0) {
    const A = S.amb;
    if (!A) return;
    const t = reduced ? t0 * 0.3 : t0;
    // Ouvriers : marteau qui frappe (en cours), pied qui tapote (en attente).
    if (A.wCyl) {
      A.workers.forEach((w, i) => {
        baseOf(tmpM, w.x, w.y, w.z, w.yaw, w.k);
        if (w.waiting) {
          putPart(A.wBox, i * 3, tmpM, 0, 0, 0, 0, 0, 0, 0.3, 0.22, 0.3);
          putPart(A.wCyl, i * 2, tmpM, 0, 0.22, 0, 0, 0, 0, 0.22, 0.3, 0.2);
          putPart(A.wBall, i, tmpM, 0, 0.52, 0, 0, 0, 0, 0.2, 0.2, 0.2);
          putPart(A.wCyl, i * 2 + 1, tmpM, 0, 0.68, 0, 0, 0, 0, 0.22, 0.06, 0.22);
          const tap = Math.max(0, Math.sin(t * 7 + w.ph)) * 0.06;
          putPart(A.wBox, i * 3 + 1, tmpM, 0.06, 0.02 + tap, 0.2, 0, 0, 0, 0.08, 0.05, 0.16);
          putPart(A.wBox, i * 3 + 2, tmpM, -0.06, 0.02, 0.2, 0, 0, 0, 0.08, 0.05, 0.16);
        } else {
          putPart(A.wCyl, i * 2, tmpM, 0, 0, 0, 0, 0, 0, 0.24, 0.42, 0.2);
          putPart(A.wBall, i, tmpM, 0, 0.4, 0, 0, 0, 0, 0.2, 0.2, 0.2);
          putPart(A.wCyl, i * 2 + 1, tmpM, 0, 0.56, 0, 0, 0, 0, 0.22, 0.06, 0.22);
          const swing = -0.4 - 1.1 * Math.pow(0.5 + 0.5 * Math.sin(t * 5 + w.ph), 3);
          const c = Math.cos(swing), sn = Math.sin(swing), L = 0.34;
          putPart(A.wBox, i * 3, tmpM, 0.14, 0.34, 0, swing, 0, 0, 0.03, L, 0.03);
          putPart(A.wBox, i * 3 + 1, tmpM, 0.14, 0.34 + L * c, L * sn, swing, 0, 0, 0.12, 0.07, 0.07);
          putPart(A.wBox, i * 3 + 2, tmpM, 0, -1, 0, 0, 0, 0, 0.001, 0.001, 0.001);
        }
      });
      [A.wCyl, A.wBall, A.wBox].forEach((m) => { m.instanceMatrix.needsUpdate = true; });
    }
    // Pigeons : allers-retours vers le large, plus lents quand l'attente dure.
    if (A.pBody) {
      A.pigeons.forEach((p, i) => {
        const ph = t * 0.55 * p.speed + p.ph;
        const u = 0.5 - 0.5 * Math.cos(ph), dir = Math.sin(ph) >= 0 ? 1 : -1;
        const x = p.x + p.dx * u * 6, z = p.z + p.dz * u * 6, y = p.y + Math.sin(u * Math.PI) * 1.2;
        const yaw = Math.atan2(p.dx * dir, p.dz * dir);
        baseOf(tmpM, x, y, z, yaw, p.k);
        putPart(A.pBody, i, tmpM, 0, 0, 0, 0, 0, 0, 0.18, 0.14, 0.3);
        const flap = Math.sin(t * 14 * Math.max(0.4, p.speed) + p.ph) * 0.7;
        putPart(A.pWing, i * 2, tmpM, 0.14, 0.08, 0, 0, 0, flap, 0.26, 0.02, 0.12);
        putPart(A.pWing, i * 2 + 1, tmpM, -0.14, 0.08, 0, 0, 0, -flap, 0.26, 0.02, 0.12);
      });
      A.pBody.instanceMatrix.needsUpdate = true; A.pWing.instanceMatrix.needsUpdate = true;
    }
    // Lanternes : pulsation de plus en plus rapide à l'approche de l'échéance.
    if (A.lMesh) {
      A.lanterns.forEach((l, i) => {
        const pulse = 0.5 + 0.5 * Math.sin((t * l.rate + l.ph) * 6.283);
        const sz = (0.16 + 0.05 * pulse) * l.k;
        A.lMesh.setMatrixAt(i, tmpM.compose(tmpP.set(l.x, l.y, l.z), tmpQ.identity(), tmpS.set(sz, sz * 1.2, sz)));
        A.lMesh.setColorAt(i, tmpC.set("#7a4a10").lerp(tmpC2.set("#fff1a8"), 0.25 + 0.75 * pulse));
      });
      A.lMesh.instanceMatrix.needsUpdate = true; if (A.lMesh.instanceColor) A.lMesh.instanceColor.needsUpdate = true;
    }
    // Drapeaux : hissés au pourcentage d'avancement, flottant au vent.
    if (A.fCloth) {
      A.flags.forEach((f, i) => {
        const y = f.base + 0.1 + f.pct * Math.max(0.2, f.top - f.base - 0.5);
        const wave = Math.sin(t * 2.2 + f.ph) * 0.35;
        baseOf(tmpM, f.x, y, f.z, wave, 1);
        putPart(A.fCloth, i, tmpM, 0.34, 0, 0, 0, 0, 0, 0.64 * (0.9 + 0.1 * Math.cos(t * 3 + f.ph)), 0.38, 0.03);
      });
      A.fCloth.instanceMatrix.needsUpdate = true;
    }
    // Convois : la charrette avance ; bloquée, elle attend devant la barrière.
    if (A.carts) {
      A.convoys.forEach((cv, i) => {
        const u = cv.blocked ? Math.min(0.8, (t * 0.18 + cv.ph) % 1) : (t * 0.18 + cv.ph) % 1;
        const p = cv.curve.getPoint(u);
        A.carts.setMatrixAt(i, tmpM.compose(p, tmpQ.identity(), tmpS.set(0.22, 0.16, 0.3)));
      });
      A.carts.instanceMatrix.needsUpdate = true;
    }
  }
  // Mode Fil d'Ariane (#435) : un chemin de points lumineux relie les
  // prochaines échéances, dans l'ordre. Indépendant des animations persistantes.
  function buildTrail() {
    S.trail = null;
    if (!S.trailIds || !S.data) return;
    // Deux échéances sur la même case ne font qu'un point du chemin.
    const pts = [];
    S.trailIds.forEach((id) => { const q = S.poi[id]; if (!q) return; const v = new THREE.Vector3(q.x, q.y + 0.45, q.z); if (!pts.length || pts[pts.length - 1].distanceTo(v) > 0.3) pts.push(v); });
    if (pts.length < 2) return;
    const curve = new THREE.CatmullRomCurve3(pts);
    const n = Math.min(120, 16 * (pts.length - 1));
    S.trail = { curve, n, mesh: ambMesh(G.ball, MAT.g, n, () => "#ffd23f") };
    placeTrail(S.time);
  }
  function placeTrail(t0) {
    const T = S.trail;
    if (!T) return;
    const t = reduced ? t0 * 0.3 : t0;
    for (let i = 0; i < T.n; i++) {
      const u = ((i / T.n + t * 0.035) % 1 + 1) % 1;
      const p = T.curve.getPoint(u);
      const pulse = 0.11 + 0.04 * Math.sin(t * 3 + i);
      T.mesh.setMatrixAt(i, tmpM.compose(p, tmpQ.identity(), tmpS.setScalar(pulse)));
    }
    T.mesh.instanceMatrix.needsUpdate = true;
  }
  // Jour et nuit à l'heure réelle (#436) ; les fenêtres des échéances du jour
  // ne s'allument que le soir.
  function applyDaylight(force) {
    S.lightAt = S.time;
    const d = S.ambient ? carteDaylight(new Date().getHours() + new Date().getMinutes() / 60) : carteDaylight(12);
    if (!force && S.lightKey === d.sky + d.k) { if (S.daylightWindows) S.daylightWindows.visible = d.evening; return; }
    S.lightKey = d.sky + d.k;
    renderer.setClearColor(d.sky);
    scene.fog.color.set(d.sky);
    hemi.intensity = d.hemi;
    sun.intensity = d.sunI; sun.color.set(d.sun);
    if (S.daylightWindows) S.daylightWindows.visible = d.evening;
  }
  const tmpC2 = new THREE.Color();

  // Anneau de progression des jalons (#437) : couronne de segments posée au
  // sol autour de la borne ; la part allumée suit l'avancement, l'anneau est
  // complet et vert quand le jalon est terminé. Toujours affiché.
  const MS_SEGS = 28;
  function buildMilestoneRings(list) {
    const ms = list.filter((e) => e.t.kind === "milestone" && e.t.state !== "info").slice(0, 400);
    if (!ms.length) return;
    const ring = new THREE.InstancedMesh(G.box, MAT.g, ms.length * MS_SEGS);
    ring.frustumCulled = false;
    ms.forEach((e, i) => {
      const done = e.t.state === "done";
      const lit = done ? MS_SEGS : Math.round((carteMilestoneProgress(e.t) / 100) * MS_SEGS);
      const R = Math.min(0.86, 0.62 * e.k), w = (2 * Math.PI * R) / MS_SEGS * 0.72;
      for (let j = 0; j < MS_SEGS; j++) {
        // Départ à midi, sens horaire vu du dessus.
        const a = (j + 0.5) / MS_SEGS * Math.PI * 2;
        tmpQ.setFromAxisAngle(UP, -a);
        ring.setMatrixAt(i * MS_SEGS + j, tmpM.compose(tmpP.set(e.x + Math.sin(a) * R, e.y + 0.07, e.z - Math.cos(a) * R), tmpQ, tmpS.set(w, 0.035, 0.16 * Math.min(1, e.k))));
        ring.setColorAt(i * MS_SEGS + j, tmpC.set(j < lit ? (done ? "#1FA971" : "#ffb020") : "#3b3f46"));
      }
    });
    ring.instanceMatrix.needsUpdate = true; if (ring.instanceColor) ring.instanceColor.needsUpdate = true;
    world.add(ring);
  }

  function animate() {
    const t = S.time;
    placeStorms(t); placeFires(t); placeClocks(t); placeWarnings(t); placeAmbient(t); placeTrail(t);
    // Lave (#408) : pulsation lente, très atténuée si les animations sont réduites.
    const glow = Math.sin(t * (reduced ? 0.6 : 1.8)) * (reduced ? 0.04 : 0.12);
    MAT.lava.color.setRGB(1, 0.88 + glow, 0.8 + glow);
    if (reduced) { MAT.alarm.opacity = 0.85; return; }
    MAT.alarm.opacity = 0.15 + 0.8 * (0.5 + 0.5 * Math.sin(t * 6.5));
    S.spin.forEach((sp) => {
      tmpE.set(0, sp.rot, t * 1.6 + sp.ph, "YXZ");
      tmpQ.setFromEuler(tmpE);
      sp.mesh.setMatrixAt(sp.i, tmpM.compose(tmpP.set(sp.p[0], sp.p[1], sp.p[2]), tmpQ, tmpS.set(sp.s[0], sp.s[1], sp.s[2])));
      sp.mesh.instanceMatrix.needsUpdate = true;
    });
    (S.convoys || []).forEach((c) => {
      const u = c.blocked ? Math.min(0.8, (t * 0.25) % 1) : (t * 0.25) % 1;
      c.cart.position.copy(c.curve.getPoint(u));
    });
  }

  // ---------- Étiquettes HTML sans chevauchement ----------
  const tip = document.createElement("div");
  tip.className = "lp-carte-tip";
  tip.hidden = true;
  tip.setAttribute("role", "tooltip");
  container.appendChild(tip);
  const labels = document.createElement("div");
  labels.className = "lp-carte-labels";
  labels.setAttribute("aria-hidden", "true");
  container.appendChild(labels);
  const pool = {};
  const esc = (s) => String(s == null ? "" : s).replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));
  const projV = new THREE.Vector3();
  function updateLabels() {
    const W = canvas.clientWidth, H = canvas.clientHeight;
    const far = S.dist > 48;
    const cand = [];
    // Noms des projets (#399, #410) : le totem survolé (ou touché) et celui
    // du territoire de l'arpenteur, puis les totems proches du centre de la
    // vue, dans un rayon qui suit le zoom (plus on s'approche, plus il se
    // resserre ; en vue très lointaine, les noms de dossiers au sol suffisent).
    // Les projets écartés par les filtres restent muets.
    const shown = {}, detailed = {};
    if (S.hovered && S.hovered.startsWith("p:")) { shown[S.hovered.slice(2)] = 3000; detailed[S.hovered.slice(2)] = true; }
    if (S.pinnedHub && !shown[S.pinnedHub]) { shown[S.pinnedHub] = 2500; detailed[S.pinnedHub] = true; }
    if (S.territory && !shown[S.territory]) { shown[S.territory] = 2000; detailed[S.territory] = true; }
    const reach = S.dist > CARTE_TOTEM_LABEL_FAR ? 0 : Math.max(10, Math.min(40, S.dist * 0.9));
    S.layout.territories.forEach((tr) => {
      if (!tr.anchor || shown[tr.projectId] || !reach) return;
      if (S.dimmed && S.dimmed.has(tr.projectId)) return;
      const d = Math.hypot(tr.anchor.x - S.target.x, tr.anchor.z - S.target.z);
      if (d <= reach) shown[tr.projectId] = 1000 - d;
    });
    S.layout.territories.forEach((tr) => {
      if (!tr.anchor || !shown[tr.projectId]) return;
      cand.push({ id: "p:" + tr.projectId, kind: "project", pid: tr.projectId, pos: tr.anchor, base: tr.world, prio: shown[tr.projectId], meta: !!detailed[tr.projectId] });
    });
    // Mode Fil d'Ariane (#435) : les étapes restent nommées et numérotées,
    // même de loin.
    const step = {};
    if (S.trailIds) S.trailIds.forEach((id, i) => { step[id] = i + 1; });
    if (far && S.trailIds) S.trailIds.forEach((id, i) => { const p = S.poi[id]; if (p) cand.push({ id: "t:" + id, kind: "task", tid: id, pos: projV.clone().set(p.x, p.labelTop || p.top, p.z), prio: 600 - i }); });
    if (!far) {
      const ids = {};
      if (S.trailIds) S.trailIds.forEach((id, i) => { ids[id] = 600 - i; });
      if (S.selected) { ids[S.selected] = 900; const st = S.data.taskById[S.selected]; if (st) st.dependsOn.forEach((d) => { ids[d] = 700; }); }
      if (S.near) ids[S.near] = 800;
      if (S.hovered && S.hovered.startsWith("t:")) ids[S.hovered.slice(2)] = 850;
      if (S.dist < 17) {
        const kp = keeper.position;
        Object.keys(S.poi).forEach((id) => { const p = S.poi[id]; const d = Math.hypot(p.x - kp.x, p.z - kp.z); if (d < 5 && !ids[id]) ids[id] = 300 - d * 10; });
      }
      // #444 : zoom suffisant, chaque tâche porte son nom au-dessus de sa
      // case. Les plus proches du centre de la vue passent d'abord ; le
      // placement sans chevauchement écarte celles qui n'ont pas la place.
      if (S.dist <= CARTE_TASK_LABEL_NEAR) {
        const reachT = S.dist * 1.3;
        const near = [];
        Object.keys(S.poi).forEach((id) => {
          if (ids[id]) return;
          const p = S.poi[id];
          const d = Math.hypot(p.x - S.target.x, p.z - S.target.z);
          if (d <= reachT) near.push([id, d]);
        });
        near.sort((a, b) => a[1] - b[1]).slice(0, CARTE_TASK_LABEL_MAX).forEach(([id, d]) => { ids[id] = 250 - d; });
      }
      Object.keys(ids).forEach((id) => { const p = S.poi[id]; if (p) cand.push({ id: "t:" + id, kind: "task", tid: id, pos: projV.clone().set(p.x, p.labelTop || p.top, p.z), prio: ids[id] }); });
    }
    cand.sort((a, b) => b.prio - a.prio);
    const seen = {};
    // Les commandes posées sur la carte (ruban, pastilles, fiche…) sont des
    // obstacles : aucun libellé ne passe dessous. Relevées 4 fois par seconde.
    if (!S.obstacleAt || S.time - S.obstacleAt > 0.25) {
      S.obstacleAt = S.time;
      const cr = canvas.getBoundingClientRect();
      S.obstacles = (o.obstacles ? o.obstacles() : []).filter((r) => r && r.width && r.height).map((r) => ({ x: r.left - cr.left, y: r.top - cr.top, w: r.width, h: r.height }));
    }
    const placed = (S.obstacles || []).slice();
    cand.forEach((c) => {
      projV.copy(c.pos).project(camera);
      let sx = (projV.x + 1) / 2 * W, sy = (1 - projV.y) / 2 * H;
      let clampTop = false, floor = sy + 40;
      // Un nom de totem peut glisser jusqu'au-dessus du pied du totem.
      if (c.kind === "project" && c.base) { tmpP.copy(c.base).project(camera); if (tmpP.z <= 1) floor = Math.max(floor, (1 - tmpP.y) / 2 * H - 10); }
      if (projV.z > 1 || Math.abs(projV.x) > 1.1 || Math.abs(projV.y) > 1.1) {
        // Totem trop haut pour l'écran (vue rapprochée, #410) : si son pied
        // est visible, le nom se cale en haut de la vue, à son aplomb.
        if (c.kind !== "project" || !c.base) return;
        projV.copy(c.base).project(camera);
        if (projV.z > 1 || Math.abs(projV.x) > 1 || Math.abs(projV.y) > 1) return;
        sx = (projV.x + 1) / 2 * W; floor = (1 - projV.y) / 2 * H - 10; sy = 0; clampTop = true;
      }
      let l = pool[c.id];
      if (!l) { l = document.createElement("div"); l.className = "lp-carte-label lp-carte-label--" + c.kind; labels.appendChild(l); pool[c.id] = l; }
      let html;
      if (c.kind === "project") {
        const p = S.layout.projectById[c.pid];
        const s = S.stats[c.pid] || { todo: 0, doing: 0, done: 0, pct: 0, stage: 0, overdue: 0 };
        const emoji = carteEmojiIcon(p.icon);
        html = '<span class="lp-carte-dot" style="background:' + esc(p.color) + '"></span><span class="lp-carte-name">' + esc(emoji ? emoji + " " : "") + esc(p.name) + "</span>";
        if (c.meta) html += '<span class="lp-carte-meta">' + s.pct + " %" + (s.overdue ? ' · <b>' + s.overdue + " en retard</b>" : "") + "</span>";
      } else {
        const t = S.data.taskById[c.tid];
        const n = S.layout.occupancy[S.poi[c.tid].key] || 1;
        const building = t.state === "doing" || t.state === "waiting" || (t.state === "todo" && t.progress > 0);
        html = (step[c.tid] ? '<b class="lp-carte-step">' + step[c.tid] + "</b>" : "") + '<span class="lp-carte-state" style="background:' + esc(t.statusColor) + '"></span>' + esc(t.title) + (building ? ' <b class="lp-carte-pct">' + t.progress + " %</b>" : "") + (n > 1 ? ' <b class="lp-carte-stack">+' + (n - 1) + "</b>" : "");
      }
      if (l._html !== html) { l.innerHTML = html; l._html = html; l._w = l.offsetWidth; l._h = l.offsetHeight; }
      l.classList.toggle("is-selected", c.tid != null && c.tid === S.selected);
      l.classList.toggle("is-dim", c.pid != null && !!S.dimmed && S.dimmed.has(c.pid));
      l.classList.toggle("is-near", c.tid != null && c.tid === S.near);
      const box = { x: sx - l._w / 2, y: clampTop ? 6 : sy - l._h - 4, w: l._w, h: l._h };
      if (c.kind === "project" && box.y < 6) box.y = 6;
      if (box.x < 2 || box.y < 2 || box.x + box.w > W - 2 || box.y + box.h > H - 2) return;
      const hit = () => placed.find((q2) => box.x < q2.x + q2.w + 4 && box.x + box.w + 4 > q2.x && box.y < q2.y + q2.h + 2 && box.y + box.h + 2 > q2.y);
      // Un nom de totem gêné (ruban, pastilles, autre nom) glisse vers le bas
      // le long du totem plutôt que de disparaître (#410).
      let blocker = hit();
      for (let n = 0; blocker && c.kind === "project" && n < 8; n++) {
        box.y = blocker.y + blocker.h + 6;
        if (box.y + box.h > Math.min(H - 2, floor)) break;
        blocker = hit();
      }
      if (blocker) return;
      placed.push(box);
      seen[c.id] = true;
      l.style.transform = "translate(" + Math.round(box.x) + "px," + Math.round(box.y) + "px)";
      l.style.visibility = "visible";
    });
    Object.keys(pool).forEach((id) => { if (!seen[id]) pool[id].style.visibility = "hidden"; });
    // Les étiquettes des territoires disparus sont retirées du DOM.
    if (Object.keys(pool).length > 600) Object.keys(pool).forEach((id) => { if (!seen[id]) { pool[id].remove(); delete pool[id]; } });
  }

  // ---------- API ----------
  function resolveQuality() {
    const n = S.data ? S.data.tasks.length : 0;
    S.effQuality = S.quality === "auto" ? (n > 3000 ? "low" : n > 800 ? "medium" : "high") : S.quality;
    S.detail = n > 3000 ? 0 : n > 1200 ? 1 : 2;
    const ratio = { low: 1, medium: 1.5, high: 2 }[S.effQuality];
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, ratio));
    const shade = S.effQuality === "high";
    renderer.shadowMap.enabled = shade;
    sun.castShadow = shade;
  }
  function setData(d) {
    S.data = d.data; S.layout = d.layout; S.stats = d.stats || {}; S.visible = d.visible || null; S.dimmed = d.dimmed || null;
    S.trailIds = d.trail || null;
    resolveQuality();
    build();
    // Carte resserrée (#401) : l'arpenteur resté hors des terres rejoint le
    // premier territoire.
    if (S.placedKeeper && groundAt(keeper.position.x, keeper.position.z) == null) S.placedKeeper = false;
    if (!S.placedKeeper && S.layout.territories.length) {
      const first = S.layout.territories.find((t) => !S.layout.projectById[t.projectId].unknown) || S.layout.territories[0];
      const w = carteToWorld(first.q + 1, first.r);
      keeper.position.set(w.x, 1, w.z);
      S.placedKeeper = true;
      updateCamera(1, true);
    }
    if (S.selected && !S.poi[S.selected]) select(null);
    o.onQuality && o.onQuality(S.effQuality);
  }
  function select(id) {
    S.selected = id || null;
    drawSelection();
    o.onSelect && o.onSelect(S.selected);
  }
  function focusProject(pid) {
    const tr = S.layout && S.layout.territories.find((t) => t.projectId === pid);
    if (!tr) return false;
    const w = carteToWorld(tr.q, tr.r + 1);
    // Au-delà de quelques tuiles, l'arpenteur est « porté » à destination
    // (la caméra glisse) : la recherche ne doit pas imposer une longue marche.
    if (Math.hypot(w.x - keeper.position.x, w.z - keeper.position.z) > 12) {
      const g = groundAt(w.x, w.z);
      keeper.position.set(w.x, g == null ? 1 : g, w.z);
      S.walkTo = null;
    } else walkTo(w.x, w.z);
    S.follow = true; S.focusGoal = null;
    S.dist = Math.min(S.dist, 22);
    return true;
  }
  function recenter() { S.follow = true; S.walkTo = null; S.dist = 19; S.pitch = 0.92; S.focusGoal = null; }
  function overview() {
    const ts = S.layout ? S.layout.territories : [];
    if (!ts.length) return;
    let xs = 0, zs = 0, maxd = 0;
    ts.forEach((t) => { const w = carteToWorld(t.q, t.r); xs += w.x; zs += w.z; });
    const cx = xs / ts.length, cz = zs / ts.length;
    ts.forEach((t) => { const w = carteToWorld(t.q, t.r); maxd = Math.max(maxd, Math.hypot(w.x - cx, w.z - cz)); });
    S.follow = false;
    S.focusGoal = new THREE.Vector3(cx, 0, cz);
    S.dist = Math.min(150, Math.max(32, maxd * 2.3 + 18));
  }
  // Cadre la caméra sur un ensemble de tâches (mode Fil d'Ariane, #435).
  function frameTasks(ids) {
    const ps = (ids || []).map((id) => S.poi[id]).filter(Boolean);
    if (!ps.length) return false;
    let x0 = Infinity, x1 = -Infinity, z0 = Infinity, z1 = -Infinity;
    ps.forEach((p) => { x0 = Math.min(x0, p.x); x1 = Math.max(x1, p.x); z0 = Math.min(z0, p.z); z1 = Math.max(z1, p.z); });
    S.follow = false; S.walkTo = null;
    S.focusGoal = new THREE.Vector3((x0 + x1) / 2, 0, (z0 + z1) / 2);
    S.dist = Math.min(150, Math.max(18, Math.hypot(x1 - x0, z1 - z0) * 1.15 + 14));
    return true;
  }
  function setQuality(q) { S.quality = q; if (S.layout) { resolveQuality(); build(); } o.onQuality && o.onQuality(S.effQuality); }
  // Décalage de la vue (en pixels) : la tâche reste visible à côté du volet
  // (ordinateur) ou au-dessus de la fiche (téléphone).
  S.viewOffset = [0, 0];
  function applyViewOffset() {
    const w = container.clientWidth || 300, h = container.clientHeight || 300;
    if (S.viewOffset[0] || S.viewOffset[1]) camera.setViewOffset(w, h, S.viewOffset[0], S.viewOffset[1], w, h);
    else camera.clearViewOffset();
    camera.updateProjectionMatrix();
  }
  // Bonshommes des responsables (#398), masquables dans « Affichage ».
  function setPeople(on) {
    if (S.people === !!on) return;
    S.people = !!on;
    if (S.layout) build();
  }
  // Animations persistantes (#425 à #436), désactivables dans « Affichage ».
  function setAmbient(on) {
    if (S.ambient === !!on) return;
    S.ambient = !!on;
    if (S.layout) build();
    applyDaylight(true);
  }
  function resize() {
    const w = container.clientWidth || 300, h = container.clientHeight || 300;
    renderer.setSize(w, h);
    camera.aspect = w / h;
    applyViewOffset();
  }
  const ro = new ResizeObserver(resize);
  ro.observe(container);
  resize();
  // Hors de l'écran (widget d'un tableau de bord qu'on a fait défiler, #418),
  // la carte ne se redessine plus : aucune animation ne tourne pour rien.
  S.onScreen = true;
  const io = typeof IntersectionObserver === "function" ? new IntersectionObserver((entries) => { entries.forEach((e) => { S.onScreen = e.isIntersecting; }); }) : null;
  if (io) io.observe(container);

  let last = performance.now(), fpsT = 0, fpsN = 0;
  function frame(now) {
    if (S.disposed) return;
    S.raf = requestAnimationFrame(frame);
    if (document.hidden || !S.onScreen) { last = now; return; }
    const dt = Math.min(0.05, (now - last) / 1000); last = now;
    S.time += dt;
    S.lastDt = dt;
    if (!S.layout) return;
    step(dt);
    updateCamera(dt);
    if (!S.lightAt || S.time - S.lightAt > 30) applyDaylight();
    animate();
    renderer.render(scene, camera);
    updateLabels();
    fpsT += dt; fpsN++;
    if (fpsT > 2) { o.onFps && o.onFps(Math.round(fpsN / fpsT)); fpsT = 0; fpsN = 0; }
  }
  S.raf = requestAnimationFrame(frame);

  return {
    setData, select, focusProject, walkToTask, recenter, overview, frameTasks, setQuality, setPeople, setAmbient, zoomBy,
    rotate: (d) => { S.yaw += d; },
    setPanMode: (on) => { S.panMode = !!on; canvas.style.cursor = "grab"; },
    setViewOffset: (dx, dy) => { const nx = Math.round(dx || 0), ny = Math.round(dy || 0); if (nx === S.viewOffset[0] && ny === S.viewOffset[1]) return; S.viewOffset = [nx, ny]; applyViewOffset(); },
    setJoystick: (x, y) => { S.joy.x = x; S.joy.y = y; if (x || y) { S.follow = true; S.walkTo = null; } },
    nearTask: () => S.near,
    selected: () => S.selected,
    dispose() {
      S.disposed = true;
      cancelAnimationFrame(S.raf);
      ro.disconnect();
      if (io) io.disconnect();
      keyTarget.removeEventListener("keydown", kd);
      keyTarget.removeEventListener("keyup", ku);
      keyTarget.removeEventListener("blur", blur, true);
      canvas.removeEventListener("wheel", onWheel);
      canvas.removeEventListener("contextmenu", onMenu);
      canvas.removeEventListener("mousedown", onAux);
      clearGroup(world); clearGroup(overlay);
      geos.forEach((g) => g.dispose());
      mats.forEach((m) => m.dispose());
      checkTex.dispose();
      renderer.dispose();
      Object.keys(avatarCache).forEach((k) => { avatarCache[k].map.dispose(); avatarCache[k].dispose(); });
      canvas.remove();
      labels.remove();
      tip.remove();
    },
  };
}
function carteWebglAvailable() {
  try {
    const c = document.createElement("canvas");
    return !!(window.WebGLRenderingContext && (c.getContext("webgl2") || c.getContext("webgl")));
  } catch (e) { return false; }
}
// === NEXORA:CARTE-ENGINE:END ===

// Widget « Carte (complet) » (#418) : la vue Carte intégrale dans un tableau
// de bord. Ses réglages (Affichage, filtres, thèmes, panneau) vivent dans la
// configuration DU widget : ils survivent au rechargement et suivent le widget
// quand on le duplique. En dessous de ~500 × 400 px, un bandeau invite à
// agrandir le widget.
const CARTE_WIDGET_MIN_W = 500;
const CARTE_WIDGET_MIN_H = 400;
function WidgetEmbedCarte({ widget, tasks, ctx, onOpen, onUpdateWidget, onUpdateTask, onToggleDone, setProjectFolders }) {
  // Le panneau du territoire est replié par défaut : la place est comptée.
  const stored = widget && widget.cartePrefs && typeof widget.cartePrefs === "object" ? widget.cartePrefs : { panel: false };
  const [local, setLocal] = useState(stored);
  useEffect(() => { setLocal(stored); }, [JSON.stringify(stored)]); // eslint-disable-line react-hooks/exhaustive-deps
  const setPrefs = (patch) => {
    const next = { ...local, ...(typeof patch === "function" ? patch(local) : patch) };
    setLocal(next);
    if (onUpdateWidget) onUpdateWidget({ cartePrefs: next });
  };
  return (
    <div className="lp-widget-embed lp-widget-embed-carte">
      <CarteView tasks={tasks} tasksWithDone={tasks} ctx={ctx} onOpen={onOpen} prefs={local} setPrefs={setPrefs}
        setProjectFolders={setProjectFolders} onUpdateTask={onUpdateTask} onToggleDone={onToggleDone} embedded />
    </div>
  );
}

// Vue Carte (#361) : exploration 3D des projets et des tâches. Lecture seule :
// la seule action qui peut mener à une modification est « Ouvrir la fiche »,
// qui ouvre la fiche Nexora habituelle (onOpen).
const CARTE_THREE_URL = "https://esm.sh/three@0.158.0";
const CARTE_MEMORY_KEY = "nexora:carte:layout";
let carteThreePromise = null;
function loadCarteThree() {
  if (!carteThreePromise) carteThreePromise = import(CARTE_THREE_URL).catch((e) => { carteThreePromise = null; throw e; });
  return carteThreePromise;
}
// Une disposition mémorisée par regroupement (#438) : passer par les
// responsables ne bouscule pas la carte des dossiers.
const carteMemoryKey = (groupBy) => (groupBy && groupBy !== "folder" ? CARTE_MEMORY_KEY + ":" + groupBy : CARTE_MEMORY_KEY);
function readCarteMemory(groupBy) {
  try { const raw = window.localStorage && window.localStorage.getItem(carteMemoryKey(groupBy)); return raw ? JSON.parse(raw) : {}; } catch (e) { return {}; }
}
function writeCarteMemory(mem, groupBy) {
  try { window.localStorage && window.localStorage.setItem(carteMemoryKey(groupBy), JSON.stringify(mem)); } catch (e) { /* stockage indisponible : la carte reste déterministe */ }
}
function carteDueText(t) {
  if (t.end == null) return "Sans échéance";
  if (t.state === "done") return "Terminée · échéance le " + fmtCarteDate(t.endIso);
  if (t.dueIn < 0) return "En retard de " + (-t.dueIn) + " j";
  if (t.dueIn === 0) return "Échéance aujourd'hui";
  return "Échéance dans " + t.dueIn + " j";
}
function fmtCarteDate(isoDate) {
  if (!isoDate) return "—";
  const m = /^(\d{4})-(\d{2})-(\d{2})/.exec(isoDate);
  if (!m) return isoDate;
  return new Date(+m[1], +m[2] - 1, +m[3]).toLocaleDateString("fr-FR", { day: "numeric", month: "short" });
}
const CARTE_WORLD_TEXT = { todo: "todo", waiting: "waiting", doing: "doing", done: "done", info: "info" };

function carteRecurrenceText(r) {
  if (!r || !r.unit) return "";
  const n = Math.max(1, Number(r.interval) || 1);
  const unit = { day: ["jour", "jours"], week: ["semaine", "semaines"], month: ["mois", "mois"] }[r.unit] || [r.unit, r.unit];
  return n === 1 ? "Chaque " + unit[0] : "Tous les " + n + " " + unit[1];
}
function carteFieldValue(v) {
  if (v == null || v === "") return "";
  if (typeof v === "boolean") return v ? "Oui" : "Non";
  if (Array.isArray(v)) return v.map(carteFieldValue).filter(Boolean).join(", ");
  if (typeof v === "object") return v.label || v.name || v.value || "";
  return String(v);
}
function fmtCarteStamp(v) {
  const t = carteParseTime(v);
  return t == null ? "" : new Date(t).toLocaleDateString("fr-FR", { day: "numeric", month: "short", year: "numeric" });
}

// Explication du volet en lecture seule pour une tâche de calendrier public
// synchronisé (Carte et Cosmos, #402).
const CARTE_SYNCED_LOCK_REASON = "Tâche issue d'un calendrier synchronisé : elle est reconstruite à chaque synchronisation et ne se modifie pas ici.";

// Volet de détail (#361, enrichi à la demande de Quentin) : tous les champs
// de la tâche et sa description complète. Depuis #371 et #447, les champs
// courants (titre, statut, type, criticité, dates, avancement, responsable,
// description, sous-tâches) se modifient sur place, chacun une seule fois ;
// le reste passe par « Ouvrir la fiche ».
// Réutilisé par la vue Cosmos (#402) : `worldText` remplace la ligne propre à
// la carte, `walkLabel` le libellé « Y aller », et `lockReason` rend le volet
// en lecture seule en expliquant pourquoi.
function CarteTaskDetail({ task, raw, norm, layout, ctx, onOpen, onGo, onWalk, onClose, onUpdate, onPreview, onToggleDone, worldText, walkLabel, lockReason }) {
  const r = raw || {};
  // Édition directe (#371) : chaque champ s'enregistre à la validation
  // (sortie du champ, Entrée, lâcher du curseur) par les mécanismes Nexora.
  const gcal = isGoogleCalendarProjectId(r.projectId, ctx.projects || []);
  const editable = !!onUpdate && !gcal && !lockReason;
  const statusLocked = !!restrictedStatusForType(ctx.taskTypes || [], ctx.statuses || [], r.taskTypeId);
  const statusOptions = getStatusesForTask(ctx.statuses || [], ctx.projects || [], ctx.taskTypes || [], r.projectId, r.taskTypeId, r.statusId);
  const typeOptions = sortedByName(getTaskTypesForProject(ctx.taskTypes || [], ctx.projects || [], r.projectId, r.taskTypeId));
  const [title, setTitle] = useState(r.title || "");
  const [descDraft, setDescDraft] = useState(typeof r.desc === "string" ? r.desc : "");
  const [prog, setProg] = useState(task.progress);
  const progRef = useRef(task.progress);
  useEffect(() => { setTitle(r.title || ""); }, [task.id, r.title]);
  useEffect(() => { setDescDraft(typeof r.desc === "string" ? r.desc : ""); }, [task.id, r.desc]);
  useEffect(() => { setProg(r.progress || 0); progRef.current = r.progress || 0; }, [task.id, r.progress]);
  const commitTitle = () => { const v = title.trim(); if (v && v !== r.title) onUpdate({ title: v }); else setTitle(r.title || ""); };
  const commitDesc = () => { if (descDraft !== (r.desc || "")) onUpdate({ desc: descDraft }); };
  const commitProg = () => { const v = progRef.current; if (v !== (r.progress || 0)) onUpdate({ progress: v }); if (onPreview) onPreview(null); };
  const p = layout.projectById[task.projectId || "__terre-inconnue__"] || {};
  const th = worldText == null ? carteLook(layout.themes[p.id]) : null;
  const crit = CRITICALITIES.find((c) => c.id === task.criticality);
  const deps = task.dependsOn.map((id) => norm.taskById[id]).filter(Boolean);
  const dependents = norm.tasks.filter((o) => o.dependsOn.indexOf(task.id) !== -1);
  const sec = task.secondaryProjectId && layout.projectById[task.secondaryProjectId];
  const checklist = Array.isArray(r.checklist) ? r.checklist : [];
  const attachments = Array.isArray(r.attachments) ? r.attachments : [];
  const custom = r.customFields && typeof r.customFields === "object" ? Object.keys(r.customFields).map((k) => [k, carteFieldValue(r.customFields[k])]).filter((e) => e[1]) : [];
  const msType = r.milestoneTypeId && (ctx.milestoneTypes || []).find((m) => m.id === r.milestoneTypeId);
  const desc = typeof r.desc === "string" ? r.desc.trim() : "";
  const report = typeof r.meetingReport === "string" ? r.meetingReport.trim() : "";
  const safeUrl = (u) => (typeof u === "string" && /^https?:\/\//i.test(u) ? u : null);
  return (
    <aside className="lp-carte-detail" aria-label="Détail de la tâche">
      <div className="lp-carte-detail-head">
        <span className="lp-carte-detail-project"><span className="lp-carte-dot" style={{ background: p.color }} />{p.name}{p.folderName ? <span className="lp-carte-muted"> · {p.folderName}</span> : null}</span>
        <button type="button" className="lp-icon-btn" aria-label="Fermer le détail" onClick={onClose}><X size={16} /></button>
      </div>
      <div className="lp-carte-detail-body">
        {editable ? (
          <input className="lp-carte-title-input" aria-label="Titre de la tâche" value={title} onChange={(e) => setTitle(e.target.value)}
            onBlur={commitTitle} onKeyDown={(e) => { if (e.key === "Enter") e.currentTarget.blur(); if (e.key === "Escape") { setTitle(r.title || ""); e.currentTarget.blur(); } }} />
        ) : null}
        <h3 className={"lp-carte-detail-title" + (editable ? " lp-carte-sr" : "")}>{task.milestone && <span className="lp-carte-ms" title="Jalon">◆ </span>}{task.title}</h3>
        {gcal && <p className="lp-carte-muted" style={{ margin: "0 0 8px", fontSize: 12 }}>Tâche issue de Google Calendar : elle se modifie dans Google Calendar.</p>}
        {!gcal && lockReason && <p className="lp-carte-muted" style={{ margin: "0 0 8px", fontSize: 12 }}>{lockReason}</p>}
        {/* #447 : en édition, statut, type et criticité se lisent et se
            modifient dans la grille des champs ; les pastilles ne servent plus
            qu'au volet en lecture seule. Chaque champ n'apparaît qu'une fois. */}
        {!editable && (
          <div className="lp-carte-chips">
            <span className="lp-carte-chip"><i style={{ background: task.statusColor }} />{task.statusName}</span>
            <span className="lp-carte-chip"><i style={{ background: task.typeColor }} />{task.typeName}</span>
            {crit && <span className="lp-carte-chip lp-carte-chip-crit" style={{ "--c": crit.color }}>Criticité {crit.name.toLowerCase()}</span>}
          </div>
        )}
        <div className="lp-carte-actions lp-carte-actions-top">
          <button type="button" className="lp-btn lp-btn-primary" onClick={() => onOpen(task.id)}><ExternalLink size={14} /> Ouvrir la fiche</button>
          {editable && onToggleDone && task.state !== "info" && (
            <button type="button" className={"lp-btn" + (task.state === "done" ? "" : " lp-carte-btn-done")} onClick={() => onToggleDone(task.id)}>
              {task.state === "done" ? "Rouvrir" : <><Check size={14} /> Marquer terminée</>}
            </button>
          )}
          <button type="button" className="lp-btn" onClick={() => onWalk(task.id)}>{walkLabel || "Y aller"}</button>
        </div>

        <div className="lp-carte-section-title">Champs</div>
        <dl className="lp-carte-grid">
          {editable && (
            <>
              <dt><label htmlFor={"lp-carte-st-" + task.id}>Statut</label></dt>
              <dd><select id={"lp-carte-st-" + task.id} className="lp-carte-input" value={r.statusId || ""} disabled={statusLocked} title={statusLocked ? "Statut imposé par le type de tâche" : undefined} onChange={(e) => onUpdate({ statusId: e.target.value })}>
                {statusOptions.map((st) => <option key={st.id} value={st.id}>{st.name}</option>)}
              </select></dd>
              <dt><label htmlFor={"lp-carte-ty-" + task.id}>Type</label></dt>
              <dd><select id={"lp-carte-ty-" + task.id} className="lp-carte-input" value={r.taskTypeId || ""} onChange={(e) => onUpdate({ taskTypeId: e.target.value })}>
                {!r.taskTypeId && <option value="">—</option>}
                {typeOptions.map((ty) => <option key={ty.id} value={ty.id}>{ty.name}</option>)}
              </select></dd>
              <dt><label htmlFor={"lp-carte-cr-" + task.id}>Criticité</label></dt>
              <dd><select id={"lp-carte-cr-" + task.id} className="lp-carte-input" value={r.criticality || ""} onChange={(e) => onUpdate({ criticality: e.target.value || null })}>
                <option value="">Aucune</option>{CRITICALITIES.map((c) => <option key={c.id} value={c.id}>{c.name}</option>)}
              </select></dd>
            </>
          )}
          {/* #448 : la date ne s'enregistre qu'une fois complète et plausible
              (la frappe chiffre par chiffre ne déplace plus la tâche en l'an 2,
              hors des filtres, ce qui refermait le volet). */}
          <dt>{editable ? <label htmlFor={"lp-carte-ds-" + task.id}>Début</label> : "Début"}</dt>
          <dd>{editable ? <DateInput key={"ds" + task.id} id={"lp-carte-ds-" + task.id} className="lp-carte-input" debounce={700} value={r.start || ""} onChange={(v) => onUpdate({ start: v })} /> : (task.startIso ? fmtCarteDate(task.startIso) : "—")}{task.startTime ? " · " + task.startTime : ""}</dd>
          <dt>{editable ? <label htmlFor={"lp-carte-de-" + task.id}>Fin</label> : "Fin"}</dt>
          <dd>{editable ? <DateInput key={"de" + task.id} id={"lp-carte-de-" + task.id} className="lp-carte-input" debounce={700} value={r.end || ""} onChange={(v) => onUpdate({ end: v })} /> : (task.endIso ? fmtCarteDate(task.endIso) : "—")}{task.endTime ? " · " + task.endTime : ""}</dd>
          <dt>Échéance</dt><dd className={task.overdue ? "is-late" : ""}>{carteDueText(task)}</dd>
          <dt>{editable ? <label htmlFor={"lp-carte-prog-" + task.id}>Avancement</label> : "Avancement"}</dt>
          <dd>{editable ? (
            <div className="lp-carte-progress-edit">
              <div className="lp-carte-progress-row">
                <input id={"lp-carte-prog-" + task.id} type="range" min={0} max={100} step={5} value={prog}
                  onChange={(e) => { const v = Number(e.target.value); progRef.current = v; setProg(v); if (onPreview) onPreview({ id: task.id, progress: v }); }}
                  onPointerUp={commitProg} onKeyUp={commitProg} onBlur={commitProg} />
                <b>{prog} %</b>
              </div>
              <small className="lp-carte-muted">Palier {carteStage(prog)} sur 5{worldText == null && task.state === "todo" && prog === 0 ? " · augmente l'avancement : la tâche passe en chantier sur la carte" : ""}</small>
            </div>
          ) : <><span className="lp-carte-bar"><span style={{ width: task.progress + "%" }} /></span>{task.progress} %</>}</dd>
          <dt>{editable ? <label htmlFor={"lp-carte-as-" + task.id}>Responsable</label> : "Responsable"}</dt>
          <dd>{editable ? (
            // #449 : annuaire trié par ordre alphabétique, recherche rapide.
            <AssigneeSelect compact id={"lp-carte-as-" + task.id} members={ctx.teamMembers || []} value={r.assignee || ""} emptyLabel="Non attribuée" onChange={(name) => onUpdate({ assignee: name })} />
          ) : task.assignee ? <><span className="lp-carte-dot lp-carte-dot-round" style={{ background: cartePersonColor(task.assignee, task.assigneeColor) }} />{task.assignee}</> : "Non attribuée"}</dd>
          {task.milestone && <><dt>Jalon</dt><dd>{msType ? msType.name : "Oui"}</dd></>}
          {r.recurrence && r.recurrence.unit && <><dt>Récurrence</dt><dd>{carteRecurrenceText(r.recurrence)}</dd></>}
          {sec && <><dt>Partagée avec</dt><dd><span className="lp-carte-dot" style={{ background: sec.color }} />{sec.name}</dd></>}
          {r.completedAt && task.state === "done" && <><dt>Terminée le</dt><dd>{fmtCarteStamp(r.completedAt)}</dd></>}
          {r.lastInteraction && <><dt>Dernière activité</dt><dd>{fmtCarteStamp(r.lastInteraction)}{task.stale ? " · oubliée" : ""}</dd></>}
          {(r.source || r.sourceSender || r.sourceUrl) && <><dt>Origine</dt><dd>{[r.source, r.sourceSender].filter(Boolean).join(" · ")}{safeUrl(r.sourceUrl) ? <> {" "}<a href={safeUrl(r.sourceUrl)} target="_blank" rel="noreferrer">lien</a></> : null}</dd></>}
          {custom.map(([k, v]) => <React.Fragment key={"cf-" + k}><dt>{k}</dt><dd>{v}</dd></React.Fragment>)}
        </dl>

        <div className="lp-carte-section-title">Description</div>
        {editable ? (
          <textarea className="lp-carte-desc-input" aria-label="Description" rows={Math.min(10, Math.max(3, (descDraft.match(/\n/g) || []).length + 2))}
            value={descDraft} placeholder="Ajouter une description…" onChange={(e) => setDescDraft(e.target.value)} onBlur={commitDesc} />
        ) : desc ? <p className="lp-carte-desc">{desc}</p> : <p className="lp-carte-muted lp-carte-desc">Aucune description.</p>}

        {checklist.length > 0 && (
          <>
            <div className="lp-carte-section-title">Sous-tâches · {task.checklistDone} / {task.checklistTotal}</div>
            <ul className="lp-carte-checklist">
              {checklist.map((c, i) => (
                <li key={c.id || i} className={c.done ? "is-done" : ""}>
                  {editable ? (
                    <input type="checkbox" checked={!!c.done} aria-label={(c.done ? "Rouvrir : " : "Terminer : ") + (c.text || "Sans intitulé")}
                      onChange={() => onUpdate({ checklist: checklist.map((x, j) => (j === i ? { ...x, done: !x.done } : x)) })} />
                  ) : <span aria-hidden="true">{c.done ? "✓" : "○"}</span>}
                  <span>{c.text || "Sans intitulé"}{c.end ? <small> · {fmtCarteDate(c.end)}</small> : null}{c.assignee ? <small> · {c.assignee}</small> : null}</span>
                </li>
              ))}
            </ul>
          </>
        )}

        {(deps.length > 0 || dependents.length > 0) && (
          <>
            <div className="lp-carte-section-title">Dépendances</div>
            <div className="lp-carte-links">
              {deps.map((o) => <button key={"d" + o.id} type="button" className="lp-carte-link" onClick={() => onGo(o.id)}><span className="lp-carte-link-tag is-in">Attend</span>{o.title}</button>)}
              {dependents.map((o) => <button key={"b" + o.id} type="button" className="lp-carte-link" onClick={() => onGo(o.id)}><span className="lp-carte-link-tag is-out">Bloque</span>{o.title}</button>)}
            </div>
          </>
        )}

        {attachments.length > 0 && (
          <>
            <div className="lp-carte-section-title">Pièces jointes · {attachments.length}</div>
            <ul className="lp-carte-attachments">
              {attachments.map((a, i) => <li key={a.id || i}>{safeUrl(a.url) ? <a href={safeUrl(a.url)} target="_blank" rel="noreferrer">{a.name || "Pièce jointe"}</a> : (a.name || "Pièce jointe")}</li>)}
            </ul>
          </>
        )}

        {report && (
          <>
            <div className="lp-carte-section-title">Compte rendu</div>
            <p className="lp-carte-desc">{report}</p>
          </>
        )}

        <p className="lp-carte-world">{worldText != null ? worldText : <>Sur la carte ({th.label}) : {th.lg[CARTE_WORLD_TEXT[task.state]]}{task.state === "doing" || task.state === "waiting" ? ", palier " + carteStage(task.progress) + " sur 5" : ""}.</>}</p>
      </div>
    </aside>
  );
}

// Panneau de droite (#365) : les projets de la région (dossier) où se trouve
// l'arpenteur ; le projet courant déplie ses tâches.
function CarteSidePanel({ layout, norm, stats, visible, dimmed, territory, onFocus, onGo, onClose }) {
  const here = territory && layout.projectById[territory];
  const group = here ? here.group : null;
  const members = here ? layout.territories.filter((t) => (group ? layout.projectById[t.projectId].group === group : t.projectId === territory)) : [];
  const theme = here ? carteLook(layout.themes[here.id]) : null;
  const tasksOf = (pid) => norm.tasks.filter((t) => (t.projectId || "__terre-inconnue__") === pid && visible.has(t.id))
    .sort((a, b) => (b.overdue - a.overdue) || ((a.state === "done") - (b.state === "done")) || ((a.end == null ? 1e9 : a.end) - (b.end == null ? 1e9 : b.end)));
  const current = here ? tasksOf(here.id) : [];
  return (
    <aside className="lp-carte-panel" aria-label="Contenu du territoire">
      <div className="lp-carte-panel-head">
        <div>
          <div className="lp-carte-panel-kicker">{here ? (group ? "Région · " + (here.folderName || "Dossier") : "Territoire isolé") + (theme ? " · " + theme.label : "") : "Exploration"}</div>
          <strong>{here ? members.length + " projet" + (members.length > 1 ? "s" : "") : "Aucun territoire"}</strong>
        </div>
        <button type="button" className="lp-icon-btn" aria-label="Masquer la liste" onClick={onClose}><X size={16} /></button>
      </div>
      {!here && <p className="lp-carte-muted lp-carte-panel-empty">Marchez sur un territoire, ou choisissez-le dans le ruban, pour lister ses projets et ses tâches.</p>}
      <div className="lp-carte-panel-body">
        {members.map((tr) => {
          const p = layout.projectById[tr.projectId];
          const st = stats[tr.projectId] || { pct: 0, stage: 0, overdue: 0, total: 0 };
          const isHere = tr.projectId === territory;
          return (
            <div key={tr.projectId} className={"lp-carte-panel-proj" + (isHere ? " is-here" : "") + (dimmed && dimmed.has(tr.projectId) ? " is-dim" : "")} title={dimmed && dimmed.has(tr.projectId) ? "Aucune tâche de ce projet ne ressort des filtres" : undefined}>
              <button type="button" className="lp-carte-panel-proj-head" onClick={() => onFocus(tr.projectId)}>
                <span className="lp-carte-panel-icon" style={{ borderColor: p.color }}>{p.icon ? <IconGlyph icon={p.icon} size={14} /> : (p.name || "?").slice(0, 1)}</span>
                <span className="lp-carte-panel-name">{p.name}<small>{st.pct} % terminé{st.overdue ? " · " : ""}{st.overdue ? <b>{st.overdue} en retard</b> : null}</small></span>
                <span className="lp-carte-bar"><span style={{ width: st.pct + "%" }} /></span>
              </button>
              {isHere && (
                <ul className="lp-carte-panel-tasks">
                  {current.length === 0 && <li className="lp-carte-muted">Aucune tâche affichée (filtres).</li>}
                  {current.slice(0, 200).map((t) => (
                    <li key={t.id}>
                      <button type="button" onClick={() => onGo(t.id)} className={t.criticality === "urgent" && t.state !== "done" ? "is-urgent" : ""}>
                        <span className="lp-carte-state" style={{ background: t.statusColor }} />
                        <span className="lp-carte-panel-task">{t.milestone ? "◆ " : ""}{t.title}</span>
                        <small className={t.overdue ? "is-late" : ""}>{t.state === "done" ? "Terminée" : carteDueText(t)}</small>
                      </button>
                    </li>
                  ))}
                  {current.length > 200 && <li className="lp-carte-muted">… et {current.length - 200} autres</li>}
                </ul>
              )}
            </div>
          );
        })}
      </div>
    </aside>
  );
}

function CarteThemeSettings({ ctx, layout, prefs, setPrefs, setProjectFolders, onClose }) {
  const used = new Set((ctx.projects || []).map((p) => (p.folderId && p.folderId !== CARTE_UNSORTED_FOLDER ? p.folderId : null)).filter(Boolean));
  const folders = (ctx.projectFolders || []).filter((f) => used.has(f.id));
  const themeOf = (fid) => { const f = (ctx.projectFolders || []).find((x) => x.id === fid); return (f && f.mapTheme) || prefs.folderThemes[fid] || ""; };
  // Le thème vit sur le dossier (#368), comme dans ses réglages ; l'ancienne
  // préférence de vue est effacée pour ne garder qu'une source.
  const setTheme = (fid, value) => {
    if (setProjectFolders && (ctx.projectFolders || []).some((f) => f.id === fid)) {
      setProjectFolders((prev) => prev.map((f) => { if (f.id !== fid) return f; const n = { ...f }; if (value) n.mapTheme = value; else delete n.mapTheme; return n; }));
    }
    setPrefs((v) => { const next = { ...(v.folderThemes || {}) }; delete next[fid]; if (value && !(ctx.projectFolders || []).some((f) => f.id === fid)) next[fid] = value; return { folderThemes: next }; });
  };
  return (
    <Modal title="Thèmes de la carte" onClose={onClose} footer={<button type="button" className="lp-btn lp-btn-primary" onClick={onClose}>Fermer</button>}>
      <p className="lp-carte-muted" style={{ marginTop: 0 }}>Chaque dossier forme une région d'un seul thème. Ce réglage ne concerne que l'affichage de la carte et ne modifie aucun projet.</p>
      {folders.length === 0 && <p className="lp-empty">Aucun dossier ne contient de projet.</p>}
      <div className="lp-carte-theme-list">
        {folders.map((f) => (
          <label key={f.id} className="lp-carte-theme-row">
            <span>{f.name}</span>
            <select value={themeOf(f.id)} onChange={(e) => setTheme(f.id, e.target.value)}>
              <option value="">Automatique ({(CARTE_THEME_BY_ID[layout && layout.groupThemes[f.id]] || {}).label || "—"})</option>
              {CARTE_THEMES.map((t) => <option key={t.id} value={t.id}>{t.label}</option>)}
            </select>
          </label>
        ))}
        <label className="lp-carte-theme-row">
          <span>À trier et projets sans dossier</span>
          <select value={themeOf(CARTE_UNSORTED_FOLDER)} onChange={(e) => setTheme(CARTE_UNSORTED_FOLDER, e.target.value)}>
            <option value="">Automatique (Île tropicale)</option>
            {CARTE_THEMES.map((t) => <option key={t.id} value={t.id}>{t.label}</option>)}
          </select>
        </label>
      </div>
    </Modal>
  );
}

function CarteFallback({ reason, norm, layout, onOpen, onRetry }) {
  const byProject = {};
  norm.tasks.forEach((t) => { const k = t.projectId || "__terre-inconnue__"; (byProject[k] = byProject[k] || []).push(t); });
  return (
    <div className="lp-carte-fallback">
      <p className="lp-carte-fallback-lead"><AlertTriangle size={16} /> {reason === "nowebgl"
        ? "La carte 3D n'est pas disponible sur cet appareil (WebGL désactivé ou non pris en charge). Voici les mêmes territoires sous forme de liste."
        : "La carte 3D n'a pas pu être chargée (connexion interrompue ?). Voici les mêmes territoires sous forme de liste."}
        {onRetry && <button type="button" className="lp-btn" onClick={onRetry}><RefreshCw size={13} /> Réessayer</button>}
      </p>
      {layout.territories.map((tr) => {
        const p = layout.projectById[tr.projectId];
        const list = byProject[tr.projectId] || [];
        const st = carteTerritoryStats(list);
        return (
          <details key={tr.projectId} className="lp-carte-fallback-proj">
            <summary><span className="lp-carte-dot" style={{ background: p.color }} />{p.name}<span className="lp-carte-muted"> · {st.pct} % terminé</span></summary>
            <ul>{list.map((t) => <li key={t.id}><button type="button" className="lp-carte-link-inline" onClick={() => onOpen(t.id)}>{t.title}</button> <span className="lp-carte-muted">{t.statusName}{t.overdue ? " · en retard" : ""}</span></li>)}</ul>
          </details>
        );
      })}
    </div>
  );
}

// Pastille d'une région selon le regroupement (#438).
function CarteGroupGlyph({ kind, color, size }) {
  if (kind === "assignee") return <User size={size} color={color} />;
  if (kind === "type") return <Tag size={size} color={color} />;
  if (kind === "status" || kind === "criticality") return <CircleDot size={size} color={color} />;
  return <Folder size={size} color={color} />;
}
function CarteView({ tasks, tasksWithDone, ctx, onOpen, prefs, setPrefs, setProjectFolders, onUpdateTask, onToggleDone, toolbarSlot, embedded }) {
  const cfg = normalizeCarteViewPrefs(prefs);
  const stageRef = useRef(null);
  const glRef = useRef(null);
  const engineRef = useRef(null);
  const [status, setStatus] = useState("loading");
  const [attempt, setAttempt] = useState(0);
  const [selected, setSelected] = useState(null);
  const [near, setNear] = useState(null);
  const [territory, setTerritory] = useState(null);
  const [quality, setQualityLabel] = useState("");
  const [query, setQuery] = useState("");
  const [themesOpen, setThemesOpen] = useState(false);
  const [filtersOpen, setFiltersOpen] = useState(false);
  // Suggestions en position fixe : la barre défile horizontalement sur mobile.
  const searchRef = useRef(null);
  // Aperçu en direct de l'avancement (#371) : la construction suit le curseur
  // avant même l'enregistrement.
  const [preview, setPreview] = useState(null);
  // Sur petit écran, la liste reste repliée tant qu'on ne l'ouvre pas.
  const [narrow] = useState(() => !!(window.matchMedia && window.matchMedia("(max-width: 767px)").matches));
  const [panelMobile, setPanelMobile] = useState(false);
  const panelOn = narrow ? panelMobile : cfg.panel;
  const setPanelOn = (on) => (narrow ? setPanelMobile(on) : setPrefs({ panel: on }));
  const [log, setLog] = useState({ tasks: 0, territories: 0 });
  const logRef = useRef({ tasks: new Set(), territories: new Set() });
  const [coarse] = useState(() => !!(window.matchMedia && window.matchMedia("(pointer: coarse)").matches));
  // Mode « main » (#396) : le clic gauche fait glisser la vue.
  const [panMode, setPanMode] = useState(false);
  useEffect(() => { if (status === "ready" && engineRef.current) engineRef.current.setPanMode(panMode); }, [status, panMode]);

  // Tous les projets et toutes les tâches servent à la disposition (stabilité :
  // un filtre ne déplace rien) ; `tasks` (filtres Nexora) + filtres de la vue
  // décident de ce qui est dessiné.
  const allTasks = ctx.tasks || tasks || [];
  const norm = useMemo(() => {
    // Regroupement variable (#438) : régions par responsable, statut, etc.
    const n = carteRegroup(carteNormalize(ctx, allTasks), cfg.groupBy, ctx);
    n.taskById = {};
    n.tasks.forEach((t) => { n.taskById[t.id] = t; });
    return n;
  }, [allTasks, ctx.projects, ctx.projectFolders, ctx.statuses, ctx.taskTypes, ctx.teamMembers, ctx.milestoneTypes, cfg.groupBy]);
  const grouping = CARTE_GROUPING_BY_ID[cfg.groupBy];
  // Filtre général de Nexora (#364) : le même moteur que les widgets et le
  // Calendrier, appliqué par-dessus les filtres de la page.
  const generalFilter = cfg.filter ? { ...widgetDefaultFilter(), ...cfg.filter } : null;
  const filterCount = generalFilter ? activeWidgetFilterCount(generalFilter) : 0;
  const visibleBase = useMemo(() => {
    const pageScope = tasksWithDone || tasks || [];
    const scoped = generalFilter ? applyWidgetFilter(pageScope, generalFilter, ctx) : pageScope;
    const scope = new Set(scoped.map((t) => t.id));
    const set = new Set();
    norm.tasks.forEach((t) => { if (scope.has(t.id) && carteMatches(t, cfg)) set.add(t.id); });
    return set;
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [norm, tasks, tasksWithDone, cfg.crit, cfg.hideOldDone, JSON.stringify(cfg.filter), ctx]);
  // Mode fil d'Ariane (#435) : seules les prochaines échéances (parmi les
  // tâches retenues par les filtres) restent affichées, dans l'ordre, reliées
  // par le fil lumineux ; les autres projets sont grisés.
  const trailIds = useMemo(() => (cfg.ariadne ? carteAriadne(norm.tasks.filter((t) => visibleBase.has(t.id)), CARTE_ARIADNE_MAX).map((t) => t.id) : null), [cfg.ariadne, norm, visibleBase]);
  const visible = useMemo(() => (trailIds ? new Set(trailIds) : visibleBase), [trailIds, visibleBase]);

  // Carte simplifiée (#401) : quand un filtre écarte des tâches, seuls les
  // projets qui en gardent au moins une sont cartographiés, sur une carte
  // resserrée. La disposition mémorisée de la carte complète n'est ni lue ni
  // réécrite : elle revient à l'identique quand l'option est levée.
  const keepKey = useMemo(() => {
    if (!cfg.simplify || visible.size >= norm.tasks.length) return "";
    const keep = new Set();
    norm.tasks.forEach((t) => { if (visible.has(t.id)) keep.add(t.projectId == null ? "__terre-inconnue__" : t.projectId); });
    return [...keep].sort().join("\n") || "∅";
  }, [cfg.simplify, visible, norm]);
  const themeOverrides = carteThemeOverrides(ctx.projectFolders, cfg.folderThemes);
  const layout = useMemo(() => {
    if (!keepKey) return carteBuild({ projects: norm.projects, tasks: norm.tasks, memory: readCarteMemory(cfg.groupBy), themeOverrides });
    const keep = new Set(keepKey.split("\n"));
    const mem = readCarteMemory(cfg.groupBy);
    const l = carteBuild({
      projects: norm.projects.filter((p) => keep.has(p.id)),
      tasks: norm.tasks.filter((t) => keep.has(t.projectId == null ? "__terre-inconnue__" : t.projectId)),
      memory: { tasks: mem.tasks || {} }, themeOverrides,
    });
    l.simplified = true;
    return l;
  },
    // eslint-disable-next-line react-hooks/exhaustive-deps
    [norm, keepKey, JSON.stringify(themeOverrides)]);
  useEffect(() => { if (!layout.simplified) writeCarteMemory(layout.memory, norm.groupBy); }, [layout]); // eslint-disable-line react-hooks/exhaustive-deps
  const stats = useMemo(() => {
    const by = {};
    norm.tasks.forEach((t) => { const k = t.projectId || "__terre-inconnue__"; (by[k] = by[k] || []).push(t); });
    const out = {};
    layout.territories.forEach((tr) => { out[tr.projectId] = carteTerritoryStats(by[tr.projectId] || []); });
    return out;
  }, [norm, layout]);
  // Hauteur : tout l'espace sous la barre d'outils, sans défilement de page.
  // Intégrée dans un widget (#418), la carte suit le cadre du widget (CSS).
  const [small, setSmall] = useState(false);
  useLayoutEffect(() => {
    const el = stageRef.current;
    if (!el) return undefined;
    if (embedded) {
      const ro = new ResizeObserver(() => { const r = el.getBoundingClientRect(); setSmall(r.width < CARTE_WIDGET_MIN_W || r.height < CARTE_WIDGET_MIN_H); });
      ro.observe(el);
      return () => ro.disconnect();
    }
    const fit = () => {
      const top = el.getBoundingClientRect().top;
      // Sur mobile, la barre de navigation basse recouvre le bas de l'écran.
      const bar = document.querySelector(".lp-mobile-tabbar");
      const barH = bar && bar.getBoundingClientRect().height && getComputedStyle(bar).display !== "none" ? bar.getBoundingClientRect().height : 0;
      el.style.height = Math.max(360, window.innerHeight - Math.max(0, top) - barH - 12) + "px";
    };
    fit();
    window.addEventListener("resize", fit);
    return () => window.removeEventListener("resize", fit);
  }, []);

  // Chargement de three.js à la demande, puis création du moteur.
  useEffect(() => {
    if (!carteWebglAvailable()) { setStatus("nowebgl"); return undefined; }
    let cancelled = false;
    setStatus("loading");
    loadCarteThree().then((THREE) => {
      if (cancelled || !glRef.current) return;
      try {
        engineRef.current = createCarteEngine(THREE, glRef.current, {
          keyTarget: stageRef.current,
          quality: cfg.quality,
          people: cfg.people,
          ambient: cfg.ambient,
          obstacles: () => (stageRef.current ? [...stageRef.current.querySelectorAll(".lp-carte-badge, .lp-carte-folder-pop, .lp-carte-small-hint, .lp-carte-hud > *, .lp-carte-near, .lp-carte-zoom, .lp-carte-detail, .lp-carte-panel, .lp-carte-panel-toggle, .lp-carte-joy, .lp-carte-act, .lp-carte-quality-tag")].map((e) => e.getBoundingClientRect()) : []),
          onSelect: (id) => setSelected(id),
          onNear: (id) => {
            setNear(id);
            if (id && !logRef.current.tasks.has(id)) { logRef.current.tasks.add(id); setLog((l) => ({ ...l, tasks: logRef.current.tasks.size })); }
          },
          onTerritoryEnter: (pid) => {
            setTerritory(pid);
            if (pid && !logRef.current.territories.has(pid)) { logRef.current.territories.add(pid); setLog((l) => ({ ...l, territories: logRef.current.territories.size })); }
          },
          onTerritory: (pid) => setTerritory(pid),
          onQuality: (q) => setQualityLabel(q),
        });
        setStatus("ready");
      } catch (e) {
        console.error("[Nexora Carte]", e);
        setStatus("nowebgl");
      }
    }).catch((e) => { console.error("[Nexora Carte] three.js", e); if (!cancelled) setStatus("error"); });
    return () => { cancelled = true; if (engineRef.current) { engineRef.current.dispose(); engineRef.current = null; } };
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [attempt]);

  const dimmed = useMemo(() => carteDimmedProjects(norm.tasks, visible), [norm, visible]);
  const normView = useMemo(() => {
    if (!preview || !norm.taskById[preview.id]) return norm;
    const t = { ...norm.taskById[preview.id], progress: preview.progress };
    const taskById = { ...norm.taskById, [t.id]: t };
    return { ...norm, taskById, tasks: norm.tasks.map((x) => (x.id === t.id ? t : x)) };
  }, [norm, preview]);
  useEffect(() => {
    if (status === "ready" && engineRef.current) engineRef.current.setData({ data: normView, layout, stats, visible, dimmed, trail: trailIds });
  }, [status, normView, layout, stats, visible, dimmed, trailIds]);
  // En entrant dans le mode fil d'Ariane, la caméra cadre le parcours.
  useEffect(() => { if (status === "ready" && engineRef.current && trailIds && trailIds.length) engineRef.current.frameTasks(trailIds); }, [status, cfg.ariadne]); // eslint-disable-line react-hooks/exhaustive-deps
  useEffect(() => { if (status === "ready" && engineRef.current) engineRef.current.setQuality(cfg.quality); }, [status, cfg.quality]);
  // La vue se décale pour que la tâche ne passe pas sous le volet ou la fiche.
  useEffect(() => {
    const e = engineRef.current, stage = stageRef.current;
    if (status !== "ready" || !e || !stage) return undefined;
    const update = () => {
      const side = stage.querySelector(".lp-carte-detail, .lp-carte-panel");
      if (!side) { e.setViewOffset(0, 0); return; }
      const sr = stage.getBoundingClientRect(), r = side.getBoundingClientRect();
      if (r.width >= sr.width * 0.8) e.setViewOffset(0, Math.min(r.height, sr.height * 0.6) / 2);
      else e.setViewOffset(r.width / 2, 0);
    };
    update();
    const ro = new ResizeObserver(update);
    ro.observe(stage);
    const side = stage.querySelector(".lp-carte-detail, .lp-carte-panel");
    if (side) ro.observe(side);
    return () => ro.disconnect();
  });
  useEffect(() => { if (status === "ready" && engineRef.current) engineRef.current.setPeople(cfg.people); }, [status, cfg.people]);
  useEffect(() => { if (status === "ready" && engineRef.current) engineRef.current.setAmbient(cfg.ambient); }, [status, cfg.ambient]);

  const openFiche = (id) => { const raw = allTasks.find((t) => t.id === id); if (raw) onOpen(raw); };
  const go = (id) => { const e = engineRef.current; if (!e) return; e.walkToTask(id); e.select(id); };
  const focus = (pid) => { const e = engineRef.current; if (e) e.focusProject(pid); setQuery(""); if (stageRef.current) stageRef.current.focus({ preventScroll: true }); };

  const suggestions = useMemo(() => {
    const q = carteNorm(query);
    if (!q) return [];
    return layout.territories.map((t) => layout.projectById[t.projectId]).filter((p) => carteNorm(p.name).indexOf(q) !== -1).slice(0, 8);
  }, [query, layout]);

  // Joystick tactile.
  const joyRef = useRef(null);
  const joyState = useRef(null);
  const joyMove = (e) => {
    const el = joyRef.current; if (!el || !engineRef.current) return;
    const r = el.getBoundingClientRect();
    let dx = e.clientX - (r.left + r.width / 2), dy = e.clientY - (r.top + r.height / 2);
    const max = r.width / 2 - 12, len = Math.hypot(dx, dy);
    if (len > max) { dx = dx / len * max; dy = dy / len * max; }
    el.firstChild.style.transform = "translate(" + dx + "px," + dy + "px)";
    engineRef.current.setJoystick(dx / max, dy / max);
  };
  const joyEnd = () => { joyState.current = null; if (joyRef.current) joyRef.current.firstChild.style.transform = ""; if (engineRef.current) engineRef.current.setJoystick(0, 0); };

  // Ruban par dossier (#392) : le survol ou le clic d'une pastille déroule les
  // projets du dossier. Un clic épingle le menu (écran tactile, clavier).
  const folderGroups = useMemo(() => carteFolderGroups(layout, stats, ctx.projectFolders), [layout, stats, ctx.projectFolders]);
  const [folderPop, setFolderPop] = useState(null);
  const popTimer = useRef(null);
  const openFolder = (g, el, pinned) => {
    clearTimeout(popTimer.current);
    const r = el.getBoundingClientRect();
    setFolderPop({ id: g.id, pinned: !!pinned, left: Math.max(8, Math.min(r.left + r.width / 2 - 140, window.innerWidth - 296)), top: r.bottom + 6 });
  };
  const closeFolderSoon = () => { clearTimeout(popTimer.current); popTimer.current = setTimeout(() => setFolderPop((f) => (f && f.pinned ? f : null)), 220); };
  useEffect(() => () => clearTimeout(popTimer.current), []);
  useEffect(() => {
    if (!folderPop || !folderPop.pinned) return undefined;
    const away = (e) => { if (!e.target.closest || !e.target.closest(".lp-carte-folder-pop, .lp-carte-badge")) setFolderPop(null); };
    const esc = (e) => { if (e.key === "Escape") setFolderPop(null); };
    document.addEventListener("pointerdown", away, true);
    document.addEventListener("keydown", esc);
    return () => { document.removeEventListener("pointerdown", away, true); document.removeEventListener("keydown", esc); };
  }, [folderPop]);
  const hereGroup = territory && layout.projectById[territory] ? layout.projectById[territory].group || CARTE_NO_FOLDER : null;
  const popGroup = folderPop && folderGroups.find((g) => g.id === folderPop.id);
  // Filtres propres à la vue (#400) : toujours signalés, remis à zéro d'un clic.
  const viewFilterCount = carteViewFilterCount(cfg) + filterCount;
  const shownCount = visible.size, totalCount = norm.tasks.length;
  const empty = norm.projects.length === 0 && norm.tasks.length === 0;
  const selTask = selected && normView.taskById[selected];
  const selRaw = selTask ? allTasks.find((t) => t.id === selTask.id) : null;
  // Tâche d'un calendrier public synchronisé : reconstruite à chaque
  // synchronisation, une modification locale serait perdue (#402).
  const lockReason = selRaw && selRaw.syncedCalendarImported ? CARTE_SYNCED_LOCK_REASON : null;
  const nearTask = near && norm.taskById[near];
  const terrTheme = territory && layout.themes[territory];
  const legend = terrTheme ? carteLegend(terrTheme) : null;
  const terrStats = territory && stats[territory];

  return (
    <section className={"lp-carte-view" + (embedded ? " is-embedded" : "")} aria-label="Carte">
      <ViewToolbarPortal slot={toolbarSlot} />
      <div className="lp-carte-toolbar">
          <div className="lp-carte-search" ref={searchRef}>
            <Search size={14} />
            <input type="search" value={query} placeholder="Aller au projet…" aria-label="Rechercher un projet sur la carte" onChange={(e) => setQuery(e.target.value)}
              onKeyDown={(e) => { if (e.key === "Enter" && suggestions[0]) focus(suggestions[0].id); if (e.key === "Escape") setQuery(""); }} />
            {suggestions.length > 0 && (
              <ul className="lp-carte-sugg" role="listbox" aria-label="Projets trouvés" style={searchRef.current ? (() => { const r = searchRef.current.getBoundingClientRect(); return { position: "fixed", left: Math.max(8, Math.min(r.left, window.innerWidth - 248)), top: r.bottom + 4 }; })() : undefined}>
                {suggestions.map((p) => <li key={p.id}><button type="button" onClick={() => focus(p.id)}><span className="lp-carte-dot" style={{ background: p.color }} />{p.name}{p.groupKind ? <span className="lp-carte-muted"> · {p.folderName}</span> : null}</button></li>)}
              </ul>
            )}
          </div>
          <button type="button" className={"lp-btn" + (filterCount ? " lp-btn-primary" : "")} onClick={() => setFiltersOpen(true)}><Filter size={13} /> Filtres{filterCount > 0 ? " (" + filterCount + ")" : ""}</button>
          <select className="lp-carte-select" aria-label="Criticité" value={cfg.crit} onChange={(e) => setPrefs({ crit: e.target.value })}>
            <option value="all">Toute criticité</option><option value="urgent">Urgentes</option><option value="moyen">Moyennes</option><option value="bas">Basses</option>
          </select>
          <DropdownButton label="Affichage" icon={<SlidersHorizontal size={13} />} title="Regroupement, responsables, carte simplifiée, qualité graphique et thèmes" panelClassName="lp-carte-display-menu" noSearch>
            <label className="lp-carte-groupby" title="Ce qui forme les régions de la carte ; les projets restent les territoires de chaque région">
              <span>Regrouper par</span>
              <select aria-label="Regrouper la carte par" value={cfg.groupBy} onChange={(e) => setPrefs({ groupBy: e.target.value })}>
                {CARTE_GROUPINGS.map((g) => <option key={g.id} value={g.id}>{g.label}</option>)}
              </select>
            </label>
            <hr className="lp-divider" style={{ margin: "6px 0" }} />
            <label className="lp-checkbox-line"><input type="checkbox" checked={cfg.people} onChange={(e) => setPrefs({ people: e.target.checked })} /> Afficher les responsables des tâches</label>
            <label className="lp-checkbox-line" title="Convois, ouvriers, pigeons, lanternes, drapeaux, jour et nuit"><input type="checkbox" checked={cfg.ambient} onChange={(e) => setPrefs({ ambient: e.target.checked })} /> Animations d'ambiance</label>
            <label className="lp-checkbox-line" title="Carte simplifiée : les dossiers et projets écartés par les filtres disparaissent, la carte se resserre sur ce qui reste"><input type="checkbox" checked={cfg.simplify} onChange={(e) => setPrefs({ simplify: e.target.checked })} /> Masquer les dossiers et projets écartés par les filtres</label>
            <label className="lp-checkbox-line"><input type="checkbox" checked={cfg.hideOldDone} onChange={(e) => setPrefs({ hideOldDone: e.target.checked })} /> Masquer les tâches terminées depuis plus de 30 jours</label>
            <hr className="lp-divider" style={{ margin: "6px 0" }} />
            <div className="lp-carte-quality" role="group" aria-label="Qualité graphique">
              {CARTE_QUALITIES.map((q) => <button key={q} type="button" className={"lp-btn" + (cfg.quality === q ? " lp-btn-primary" : "")} onClick={() => setPrefs({ quality: q })}>{{ auto: "Auto", high: "Haute", medium: "Moyenne", low: "Basse" }[q]}</button>)}
            </div>
            {cfg.groupBy === "folder" && (<>
              <hr className="lp-divider" style={{ margin: "6px 0" }} />
              <button type="button" className="lp-dropdown-action-row" onClick={() => setThemesOpen(true)}><Palette size={13} /> Thèmes par dossier…</button>
            </>)}
          </DropdownButton>
          <button type="button" className="lp-btn" onClick={() => engineRef.current && engineRef.current.overview()} disabled={status !== "ready"}><Maximize2 size={13} /> Vue d'ensemble</button>
          <button type="button" className={"lp-btn" + (cfg.ariadne ? " lp-btn-primary" : "")} aria-pressed={cfg.ariadne} onClick={() => setPrefs({ ariadne: !cfg.ariadne })} disabled={status !== "ready"}
            title="Mode fil d'Ariane : seules les prochaines échéances restent affichées, dans l'ordre, reliées par un fil lumineux"><Footprints size={13} /> Fil d'Ariane</button>
          <button type="button" className="lp-btn lp-btn-primary" onClick={() => engineRef.current && engineRef.current.recenter()} disabled={status !== "ready"}><Crosshair size={13} /> Recentrer</button>
      </div>

      <div ref={stageRef} className={"lp-carte-stage" + (selTask || (panelOn && status === "ready") ? " has-detail" : "")} tabIndex={0}
        data-carte-status={status} data-carte-group={cfg.groupBy} data-carte-dimmed={dimmed.size} data-carte-territories={layout.territories.length} data-carte-shown={shownCount} data-carte-near={near || ""} data-carte-selected={selected || ""} data-carte-territory={territory || ""}
        aria-label="Carte des projets. Flèches ou Z Q S D pour marcher, Entrée pour lire la tâche proche, E et R pour pivoter, plus et moins pour zoomer, C pour recentrer. Clic molette ou clic droit glissé pour déplacer la vue.">
        {embedded && small && status === "ready" && <div className="lp-carte-small-hint" role="note">Agrandissez le widget pour explorer la carte confortablement.</div>}
        {empty ? (
          <div className="lp-empty lp-carte-empty">
            <strong>Aucun projet à cartographier.</strong>
            <span>Créez un projet et quelques tâches : chaque projet deviendra un territoire, chaque tâche un lieu à visiter.</span>
          </div>
        ) : (status === "nowebgl" || status === "error") ? (
          <CarteFallback reason={status} norm={norm} layout={layout} onOpen={openFiche} onRetry={status === "error" ? () => setAttempt((a) => a + 1) : null} />
        ) : (
          <>
            <div ref={glRef} className="lp-carte-gl" />
            {status === "loading" && <div className="lp-carte-loading" role="status"><div className="lp-skeleton lp-carte-skeleton" />Chargement de la carte 3D…</div>}
            {status === "ready" && (
              <>
                <nav className="lp-carte-ribbon" aria-label={grouping.ribbon}>
                  {folderGroups.map((g) => {
                    const dim = g.projects.every((pid) => dimmed.has(pid));
                    const open = folderPop && folderPop.id === g.id;
                    return (
                      <button key={g.id} type="button" className={"lp-carte-badge" + (hereGroup === g.id ? " is-here" : "") + (dim ? " is-dim" : "") + (open ? " is-open" : "")} style={{ "--p": g.pct, "--c": g.color }}
                        aria-haspopup="true" aria-expanded={!!open} data-folder={g.id}
                        onMouseEnter={(e) => { if (!folderPop || !folderPop.pinned) openFolder(g, e.currentTarget, false); }} onMouseLeave={closeFolderSoon}
                        onClick={(e) => { if (open && folderPop.pinned) setFolderPop(null); else openFolder(g, e.currentTarget, true); }}
                        title={g.name + " — " + g.projects.length + " projet" + (g.projects.length > 1 ? "s" : "") + " · " + g.pct + " % terminé"} aria-label={g.name + ", " + g.projects.length + " projet" + (g.projects.length > 1 ? "s" : "") + ", " + g.pct + " % terminé"}>
                        <span className="lp-carte-badge-ring"><span className="lp-carte-badge-core">{g.icon ? <IconGlyph icon={g.icon} size={18} /> : <CarteGroupGlyph kind={g.kind} color={g.color} size={17} />}<i className="lp-carte-badge-count">{g.projects.length}</i></span></span>
                        <small>{g.name}</small>
                      </button>
                    );
                  })}
                </nav>
                {popGroup && (
                  <div className="lp-carte-folder-pop" role="menu" aria-label={"Projets — " + grouping.one + " " + popGroup.name} style={{ left: folderPop.left, top: folderPop.top }}
                    onMouseEnter={() => clearTimeout(popTimer.current)} onMouseLeave={closeFolderSoon}>
                    <div className="lp-carte-folder-pop-head"><CarteGroupGlyph kind={popGroup.kind} color={popGroup.color} size={13} /><b>{popGroup.name}</b><span>{popGroup.pct} %{popGroup.overdue ? " · " + popGroup.overdue + " en retard" : ""}</span></div>
                    {popGroup.projects.map((pid) => {
                      const p = layout.projectById[pid];
                      const s = stats[pid] || { pct: 0, overdue: 0 };
                      return (
                        <button key={pid} type="button" role="menuitem" className={"lp-carte-folder-proj" + (territory === pid ? " is-here" : "") + (dimmed.has(pid) ? " is-dim" : "")}
                          onClick={() => { setFolderPop(null); focus(pid); }} title={dimmed.has(pid) ? "Aucune tâche de ce projet ne ressort des filtres" : undefined}>
                          <span className="lp-carte-panel-icon" style={{ borderColor: p.color }}>{p.icon ? <IconGlyph icon={p.icon} size={13} /> : (p.name || "?").slice(0, 1)}</span>
                          <span className="lp-carte-folder-name">{p.name}<small>{s.pct} %{s.overdue ? " · " : ""}{s.overdue ? <b>{s.overdue} en retard</b> : null}</small></span>
                        </button>
                      );
                    })}
                  </div>
                )}
                <div className="lp-carte-hud" aria-live="polite">
                  <span className="lp-carte-pill" title="Ce que vous avez regardé pendant cette visite. Rien n'est enregistré dans Nexora.">Relevés : {log.tasks} tâche{log.tasks > 1 ? "s" : ""} · {log.territories} territoire{log.territories > 1 ? "s" : ""}</span>
                  {cfg.ariadne && (
                    <span className="lp-carte-pill lp-carte-filtered" data-carte-ariadne={trailIds ? trailIds.length : 0} title="Les prochaines échéances parmi les tâches retenues par les filtres, dans l'ordre">
                      {trailIds && trailIds.length ? "Fil d'Ariane : " + trailIds.length + " prochaine" + (trailIds.length > 1 ? "s" : "") + " échéance" + (trailIds.length > 1 ? "s" : "") : "Fil d'Ariane : aucune échéance à venir"}
                      <button type="button" onClick={() => setPrefs({ ariadne: false })}>Quitter</button>
                    </span>
                  )}
                  {shownCount < totalCount && !cfg.ariadne && (
                    <span className="lp-carte-pill lp-carte-filtered" title="Filtres de la page, filtre général et filtres de la carte combinés">
                      {shownCount} / {totalCount} tâches affichées
                      {viewFilterCount > 0 && <button type="button" onClick={() => setPrefs(carteViewFilterReset())}>Tout afficher</button>}
                    </span>
                  )}
                  {legend && terrStats && (
                    <details className="lp-carte-legend">
                      <summary><span className="lp-carte-dot" style={{ background: layout.projectById[territory].color }} />{layout.projectById[territory].name} · {terrStats.pct} %</summary>
                      <ul>
                        <li><b>Thème</b><span>{legend.label} · {legend.hub[terrStats.stage]}</span></li>
                        {legend.lines.map((l) => <li key={l[0]}><b>{l[0]}</b><span>{l[1]}</span></li>)}
                        {legend.signals.map((l) => <li key={"s-" + l[0]}><b>{l[0]}</b><span>{l[1]}</span></li>)}
                      </ul>
                    </details>
                  )}
                </div>
                {nearTask && !selTask && (
                  <div className="lp-carte-near">
                    <span className="lp-carte-state" style={{ background: nearTask.statusColor }} />
                    <span className="lp-carte-near-title">{nearTask.title}</span>
                    <button type="button" className="lp-btn lp-btn-primary" onClick={() => engineRef.current && engineRef.current.select(near)}>Lire <kbd>Entrée</kbd></button>
                  </div>
                )}
                <div className="lp-carte-zoom">
                  <button type="button" className="lp-icon-btn" aria-label="Zoomer" onClick={() => engineRef.current.zoomBy(0.8)}><Plus size={16} /></button>
                  <button type="button" className="lp-icon-btn" aria-label="Dézoomer" onClick={() => engineRef.current.zoomBy(1.25)}><Minus size={16} /></button>
                  <button type="button" className="lp-icon-btn" aria-label="Pivoter la caméra" onClick={() => engineRef.current.rotate(Math.PI / 4)}><RotateCcw size={15} /></button>
                  <button type="button" className={"lp-icon-btn" + (panMode ? " is-active" : "")} aria-pressed={panMode} aria-label="Déplacer la vue à la souris"
                    title="Déplacer la vue : clic gauche glissé (sinon clic molette, clic droit ou Maj + clic). Recentrer revient à l'arpenteur." onClick={() => setPanMode((v) => !v)}><Hand size={15} /></button>
                </div>
                {coarse && (
                  <>
                    <div ref={joyRef} className="lp-carte-joy" aria-hidden="true"
                      onPointerDown={(e) => { joyState.current = e.pointerId; e.currentTarget.setPointerCapture(e.pointerId); joyMove(e); }}
                      onPointerMove={(e) => { if (joyState.current === e.pointerId) joyMove(e); }}
                      onPointerUp={joyEnd} onPointerCancel={joyEnd}><span /></div>
                    <button type="button" className="lp-carte-act" disabled={!near} onClick={() => engineRef.current && engineRef.current.select(near)}>Lire</button>
                  </>
                )}
                {quality && <span className="lp-carte-quality-tag">Qualité {({ high: "haute", medium: "moyenne", low: "basse" })[quality]}{cfg.quality === "auto" ? " (auto)" : ""}</span>}
              </>
            )}
            {status === "ready" && !selTask && panelOn && (
              <CarteSidePanel layout={layout} norm={norm} stats={stats} visible={visible} dimmed={dimmed} territory={territory}
                onFocus={focus} onGo={go} onClose={() => setPanelOn(false)} />
            )}
            {status === "ready" && !selTask && !panelOn && (
              <button type="button" className="lp-carte-panel-toggle" onClick={() => setPanelOn(true)}>Liste du territoire</button>
            )}
            {selTask && (
              <CarteTaskDetail task={selTask} raw={selRaw} norm={norm} layout={layout} ctx={ctx} onOpen={openFiche} onGo={go} lockReason={lockReason}
                onUpdate={onUpdateTask && !lockReason ? (patch) => onUpdateTask(selTask.id, patch) : null} onPreview={setPreview} onToggleDone={lockReason ? null : onToggleDone}
                onWalk={(id) => engineRef.current && engineRef.current.walkToTask(id)} onClose={() => engineRef.current && engineRef.current.select(null)} />
            )}
          </>
        )}
      </div>
      {themesOpen && <CarteThemeSettings ctx={ctx} layout={layout} prefs={cfg} setPrefs={setPrefs} setProjectFolders={setProjectFolders} onClose={() => setThemesOpen(false)} />}
      {filtersOpen && (
        <Modal title="Filtrer la carte" onClose={() => setFiltersOpen(false)} wide footer={<>
          <button type="button" className="lp-btn" onClick={() => setPrefs({ filter: null })} disabled={!filterCount}>Tout afficher</button>
          <button type="button" className="lp-btn lp-btn-primary" onClick={() => setFiltersOpen(false)}>Terminé</button>
        </>}>
          <p className="lp-carte-muted" style={{ marginTop: 0 }}>Le même filtre que partout ailleurs dans Nexora. Les tâches écartées disparaissent de la carte ; les territoires ne bougent pas.</p>
          <TaskFilterFields filter={generalFilter || widgetDefaultFilter()} setFilter={(next) => setPrefs({ filter: typeof next === "function" ? next(generalFilter || widgetDefaultFilter()) : next })} ctx={ctx} />
        </Modal>
      )}
    </section>
  );
}

// === NEXORA:COSMOS-ENGINE:START ===
// Moteur 3D de la vue Cosmos (#402), direction « Diorama céleste » validée :
// ciel ivoire et bleu pâle, mer de nuages, galaxies en disques de verre,
// planètes stylisées, satellites-cubes. three.js est chargé à la demande
// (loadCarteThree, partagé avec la Carte) et passé en paramètre.
// Le moteur ne modifie jamais une tâche : il signale seulement ce que
// l'utilisateur vise (onSelect, onLevel). Les orbites animées sont un effet
// visuel, coupé par « réduire les animations » et en qualité basse.
const COSMOS_PLANET_PALETTES = {
  earth: [[-1, "#2f7fc4"], [0, "#4aa3dd"], [0.035, "#e6d49a"], [0.07, "#78bd5c"], [0.14, "#3f8f4c"], [0.2, "#9c9282"], [0.26, "#f2f0ea"]],
  desert: [[-1, "#3a8fc0"], [0, "#5fb3d6"], [0.03, "#f0cf86"], [0.08, "#e3a94f"], [0.15, "#c98336"], [0.22, "#a86a33"]],
  city: [[-1, "#1f3f86"], [0, "#2c58a8"], [0.03, "#8fa4be"], [0.1, "#b9c6d6"], [0.18, "#e4e9f0"]],
  ocean: [[-1, "#1d6fb8"], [0, "#3b9ad6"], [0.06, "#7cc7e8"], [0.1, "#f1e4b3"], [0.14, "#6fbf73"], [0.22, "#4c9a55"]],
  ice: [[-1, "#4f8fc4"], [0, "#8cc4e6"], [0.03, "#dfeef7"], [0.1, "#f7fbff"], [0.2, "#c9d6e3"]],
  volcano: [[-1, "#3d6fa6"], [0, "#5d93c2"], [0.03, "#9a8a7a"], [0.1, "#6d5f55"], [0.17, "#4a3f3a"], [0.23, "#e2683c"]],
};
const COSMOS_DECOR = { earth: "tree", ocean: "tree", desert: "rock", volcano: "rock", city: "block", ice: "rock" };

function createCosmosEngine(THREE, container, opts) {
  const o = opts || {};
  const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true, powerPreference: "high-performance" });
  renderer.setClearColor(0x000000, 0);
  renderer.outputColorSpace = THREE.SRGBColorSpace;
  const canvas = renderer.domElement;
  canvas.className = "lp-cosmos-canvas";
  canvas.setAttribute("aria-hidden", "true");
  container.appendChild(canvas);

  const scene = new THREE.Scene();
  const FOG = new THREE.Color("#f1ece2");
  scene.fog = new THREE.Fog(FOG, 60, 400);
  scene.add(new THREE.HemisphereLight("#fff7e8", "#a9bcd4", 1.3));
  const sun = new THREE.DirectionalLight("#fff0d4", 1.75);
  sun.position.set(-30, 50, 25);
  scene.add(sun);
  const camera = new THREE.PerspectiveCamera(38, 1, 0.1, 4000);
  const envGroup = new THREE.Group(), galaxyGroup = new THREE.Group(), detailGroup = new THREE.Group(), fxGroup = new THREE.Group();
  scene.add(envGroup, galaxyGroup, detailGroup, fxGroup);

  const reduced = !!(window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches);
  const S = {
    model: null, norm: null, visible: null, dimmed: new Set(), level: "universe", galaxyId: null, planetId: null,
    selected: null, hovered: null, quality: o.quality || "auto", effQuality: "high", animate: o.animate !== false,
    yaw: 0.35, pitch: 0.72, dist: 120, target: new THREE.Vector3(), goal: null, goalDist: null,
    time: 0, raf: 0, disposed: false, dirty: true, preview: null,
  };

  // ---------- Ressources partagées ----------
  const disposables = [];
  const keep = (x) => { disposables.push(x); return x; };
  function radialTexture(stops, size) {
    const c = document.createElement("canvas");
    c.width = c.height = size || 128;
    const g = c.getContext("2d");
    if (g) {
      const gr = g.createRadialGradient(c.width / 2, c.height / 2, 0, c.width / 2, c.height / 2, c.width / 2);
      stops.forEach((s) => gr.addColorStop(s[0], s[1]));
      g.fillStyle = gr; g.fillRect(0, 0, c.width, c.height);
    }
    const t = new THREE.CanvasTexture(c);
    t.colorSpace = THREE.SRGBColorSpace;
    return keep(t);
  }
  const texCloud = radialTexture([[0, "rgba(255,255,255,.95)"], [0.35, "rgba(255,255,255,.7)"], [1, "rgba(255,255,255,0)"]], 128);
  const texWarm = radialTexture([[0, "rgba(255,236,170,1)"], [0.35, "rgba(255,226,150,.55)"], [1, "rgba(255,220,150,0)"]], 128);
  const texBlue = radialTexture([[0, "rgba(120,170,255,.95)"], [0.35, "rgba(150,190,255,.45)"], [1, "rgba(120,170,255,0)"]], 128);
  const texWhite = radialTexture([[0, "rgba(255,255,255,.9)"], [0.35, "rgba(255,255,255,.35)"], [1, "rgba(255,255,255,0)"]], 128);
  const texDot = radialTexture([[0, "rgba(255,255,255,1)"], [0.4, "rgba(255,255,255,.9)"], [1, "rgba(255,255,255,0)"]], 32);
  // Soleil-tableau de bord (#421) : disque clair au centre et orangé au bord,
  // couronne de rayons fins, halo et flaque de lumière sur le disque.
  const texSunDisc = radialTexture([[0, "#fffdf2"], [0.45, "#fff0a8"], [0.78, "#ffc94a"], [0.93, "#ffa531"], [0.985, "rgba(255,150,40,.9)"], [1, "rgba(255,150,40,0)"]], 256);
  const texSunHalo = radialTexture([[0, "rgba(255,222,140,.85)"], [0.35, "rgba(255,215,130,.35)"], [1, "rgba(255,215,140,0)"]], 128);
  const texSunPool = radialTexture([[0, "rgba(255,214,120,.75)"], [0.35, "rgba(255,220,150,.3)"], [1, "rgba(255,214,120,0)"]], 128);
  const texCorona = (() => {
    const c = document.createElement("canvas"); c.width = c.height = 512;
    const g = c.getContext("2d");
    if (g) {
      let seed = carteHash("couronne");
      const rnd = () => { seed = (Math.imul(seed ^ (seed >>> 15), 0x2c1b3c6d) + 0x297a2d39) >>> 0; return seed / 4294967296; };
      for (let i = 0; i < 90; i++) {
        const a = (i / 90) * Math.PI * 2 + rnd() * 0.05, len = 256 * (0.55 + rnd() * 0.45);
        const gr = g.createLinearGradient(256, 256, 256 + Math.cos(a) * len, 256 + Math.sin(a) * len);
        gr.addColorStop(0, "rgba(255,214,110,0)"); gr.addColorStop(0.28, "rgba(255,205,90,.55)"); gr.addColorStop(1, "rgba(255,190,80,0)");
        g.strokeStyle = gr; g.lineWidth = 1.2 + rnd() * 3;
        g.beginPath(); g.moveTo(256 + Math.cos(a) * 56, 256 + Math.sin(a) * 56); g.lineTo(256 + Math.cos(a) * len, 256 + Math.sin(a) * len); g.stroke();
      }
    }
    const t = new THREE.CanvasTexture(c); t.colorSpace = THREE.SRGBColorSpace; return keep(t);
  })();
  // Tâches (#421, variante E) : aura orange des urgentes, fumée des retards.
  const texAura = radialTexture([[0, "rgba(255,150,30,1)"], [0.35, "rgba(255,170,60,.45)"], [1, "rgba(255,150,30,0)"]], 128);
  const texSmoke = radialTexture([[0, "rgba(120,120,130,.55)"], [0.35, "rgba(140,140,150,.3)"], [1, "rgba(120,120,130,0)"]], 64);
  const geoDisc = keep(new THREE.CircleGeometry(1, 96).rotateX(-Math.PI / 2));
  const geoSphereLow = keep(new THREE.IcosahedronGeometry(1, 2));
  const geoCore = keep(new THREE.SphereGeometry(1, 24, 16));
  const geoCube = keep(new THREE.BoxGeometry(1, 1, 1));
  const geoWing = keep(new THREE.BoxGeometry(2.6, 0.06, 0.55));
  const geoAlert = keep(new THREE.TorusGeometry(0.9, 0.09, 6, 28).rotateX(Math.PI / 2));
  const geoRock = keep(new THREE.DodecahedronGeometry(1, 0));
  const ribbonGeo = (r, w, start, len) => keep(new THREE.RingGeometry(r - w / 2, r + w / 2, 96, 1, start || 0, len == null ? Math.PI * 2 : len).rotateX(-Math.PI / 2));
  const mats = [];
  const mat = (m) => { mats.push(m); return m; };
  const matBasic = (color, opacity, extra) => mat(new THREE.MeshBasicMaterial(Object.assign({ color, transparent: opacity < 1, opacity, depthWrite: opacity >= 1, side: THREE.DoubleSide }, extra || {})));
  const matLambert = mat(new THREE.MeshLambertMaterial({ vertexColors: true, flatShading: true }));
  const matInst = mat(new THREE.MeshLambertMaterial({ flatShading: true }));
  const matCore = mat(new THREE.MeshBasicMaterial({ color: "#ffe39a" }));
  const matRock = mat(new THREE.MeshLambertMaterial({ color: "#bba88f", flatShading: true }));
  const matWing = mat(new THREE.MeshLambertMaterial({ color: "#4f7fd6" }));
  const matAlert = mat(new THREE.MeshBasicMaterial({ color: "#dc2626" }));
  const decorMats = {
    tree: mat(new THREE.MeshLambertMaterial({ color: "#2f7a3e", flatShading: true })),
    block: mat(new THREE.MeshLambertMaterial({ color: "#f4f1ea" })),
    rock: mat(new THREE.MeshLambertMaterial({ color: "#b87a3c", flatShading: true })),
  };
  const spriteMat = (map, opacity, color) => mat(new THREE.SpriteMaterial({ map, transparent: true, opacity: opacity == null ? 1 : opacity, depthWrite: false, color: color || "#ffffff" }));

  // ---------- Bruit et planètes procédurales ----------
  function vhash(x, y, z, seed) { let h = Math.imul(x, 374761393) + Math.imul(y, 668265263) + Math.imul(z, 2147483647) + Math.imul(seed, 144665); h = Math.imul(h ^ (h >>> 13), 1274126177); return ((h ^ (h >>> 16)) >>> 0) / 4294967296; }
  function noise3(x, y, z, seed) {
    const xi = Math.floor(x), yi = Math.floor(y), zi = Math.floor(z);
    const sm = (t) => t * t * (3 - 2 * t);
    const u = sm(x - xi), v = sm(y - yi), w = sm(z - zi);
    let r = 0;
    for (let dx = 0; dx < 2; dx++) for (let dy = 0; dy < 2; dy++) for (let dz = 0; dz < 2; dz++)
      r += vhash(xi + dx, yi + dy, zi + dz, seed) * (dx ? u : 1 - u) * (dy ? v : 1 - v) * (dz ? w : 1 - w);
    return r;
  }
  const fbm = (x, y, z, s) => 0.55 * noise3(x, y, z, s) + 0.3 * noise3(x * 2.1, y * 2.1, z * 2.1, s + 7) + 0.15 * noise3(x * 4.3, y * 4.3, z * 4.3, s + 13);
  const tmpC = new THREE.Color(), tintC = new THREE.Color();
  const planetCache = {};
  // Planète « diorama » : icosaèdre en relief, couleurs par sommet teintées
  // par la couleur du projet, décor instancié (arbres, immeubles, rochers).
  function planetMesh(p, detail, decor) {
    const key = p.id + "|" + p.kind + "|" + detail + "|" + (decor ? 1 : 0) + "|" + p.color;
    if (planetCache[key]) return planetCache[key];
    const seed = carteHash("seed:" + p.id) % 9973;
    const geo = new THREE.IcosahedronGeometry(1, detail);
    const pos = geo.attributes.position;
    const colors = new Float32Array(pos.count * 3);
    const heights = new Float32Array(pos.count);
    const pal = COSMOS_PLANET_PALETTES[p.kind] || COSMOS_PLANET_PALETTES.earth;
    tintC.set(p.color || "#94A3B8");
    const v = new THREE.Vector3();
    for (let i = 0; i < pos.count; i++) {
      v.fromBufferAttribute(pos, i).normalize();
      const h = (fbm(v.x * 1.7 + 3, v.y * 1.7, v.z * 1.7, seed) - 0.5) * (p.kind === "city" ? 0.5 : 0.8);
      heights[i] = h;
      v.multiplyScalar(h > 0 ? 1 + h * 0.22 : 1);
      pos.setXYZ(i, v.x, v.y, v.z);
      let c = pal[0][1];
      for (let k = 0; k < pal.length; k++) if (h >= pal[k][0]) c = pal[k][1];
      tmpC.set(c).lerp(tintC, 0.18);
      colors[i * 3] = tmpC.r; colors[i * 3 + 1] = tmpC.g; colors[i * 3 + 2] = tmpC.b;
    }
    geo.setAttribute("color", new THREE.BufferAttribute(colors, 3));
    geo.computeVertexNormals();
    const group = new THREE.Group();
    const mesh = new THREE.Mesh(geo, matLambert);
    mesh.userData.pickPlanet = p.id;
    group.add(mesh);
    const owned = [geo];
    if (decor) {
      const kind = COSMOS_DECOR[p.kind] || "tree";
      const land = [];
      for (let i = 0; i < pos.count; i++) if (heights[i] > 0.06) land.push(i);
      const count = Math.min(kind === "block" ? 70 : 64, land.length);
      if (count) {
        const dg = kind === "tree" ? new THREE.ConeGeometry(0.024, 0.055, 5) : kind === "block" ? new THREE.BoxGeometry(0.06, 0.1, 0.06) : new THREE.DodecahedronGeometry(0.035, 0);
        owned.push(dg);
        const inst = new THREE.InstancedMesh(dg, decorMats[kind], count);
        const up = new THREE.Vector3(0, 1, 0), q = new THREE.Quaternion(), m4 = new THREE.Matrix4(), n = new THREE.Vector3(), sc = new THREE.Vector3();
        let r = carteHash("decor:" + p.id);
        const rnd = () => { r = (Math.imul(r ^ (r >>> 15), 0x2c1b3c6d) + 0x297a2d39) >>> 0; return r / 4294967296; };
        for (let k = 0; k < count; k++) {
          const i = land[Math.floor(rnd() * land.length)];
          v.fromBufferAttribute(pos, i);
          n.copy(v).normalize();
          q.setFromUnitVectors(up, n);
          const s = 0.7 + rnd() * 0.8, hh = kind === "block" ? s * (0.6 + rnd() * 1.6) : s;
          sc.set(s, hh, s);
          m4.compose(v.clone().add(n.clone().multiplyScalar(0.04 * hh)), q, sc);
          inst.setMatrixAt(k, m4);
        }
        inst.userData.pickPlanet = p.id;
        group.add(inst);
      }
    }
    group.userData.owned = owned;
    planetCache[key] = group;
    return group;
  }

  // ---------- Qualité ----------
  function resolveQuality() {
    const tasks = S.norm ? S.norm.tasks.length : 0;
    const projects = S.model ? Object.keys(S.model.planets).length : 0;
    S.effQuality = cosmosResolveQuality(S.quality, tasks, projects);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, { high: 2, medium: 1.5, low: 1 }[S.effQuality]));
    o.onQuality && o.onQuality(S.effQuality);
  }
  const animOn = () => S.animate && !reduced && S.effQuality !== "low";

  // ---------- Décor : nuages et rochers ----------
  function rng(seed) { let s = carteHash(String(seed)) || 1; return () => { s = (Math.imul(s ^ (s >>> 15), 0x2c1b3c6d) + 0x297a2d39) >>> 0; return s / 4294967296; }; }
  function buildEnvironment() {
    clearGroup(envGroup);
    const ext = Math.max(80, S.model.extent);
    const q = S.effQuality;
    const nClouds = { high: 110, medium: 60, low: 18 }[q];
    const r = rng("nuages");
    const cm = [spriteMat(texCloud, 0.8), spriteMat(texWarm, 0.7), spriteMat(texCloud, 0.35, "#b9c9dd")];
    for (let i = 0; i < nClouds; i++) {
      const sp = new THREE.Sprite(cm[r() > 0.4 ? 0 : 1]);
      const sc = (12 + r() * 26) * Math.max(1, ext / 120);
      // Le haut du nuage reste sous le disque des galaxies : vu de près, il
      // ne voile jamais une planète.
      const x = (r() - 0.5) * ext * 3, z = (r() - 0.5) * ext * 3, y = -sc * 0.5 - 6 - r() * 6;
      sp.scale.set(sc * 1.8, sc, 1);
      sp.position.set(x, y, z);
      envGroup.add(sp);
      if (q !== "low") { const sh = new THREE.Sprite(cm[2]); sh.scale.set(sc * 1.9, sc * 0.9, 1); sh.position.set(x, y - 2.2, z + 0.5); sh.renderOrder = -1; envGroup.add(sh); }
    }
    const nRocks = { high: 60, medium: 30, low: 0 }[q];
    if (nRocks) {
      const inst = new THREE.InstancedMesh(geoRock, matRock, nRocks);
      const m4 = new THREE.Matrix4(), qq = new THREE.Quaternion(), e = new THREE.Euler();
      for (let i = 0; i < nRocks; i++) {
        const s = 0.25 + r() * r() * 2.2;
        e.set(r() * 6, r() * 6, r() * 6); qq.setFromEuler(e);
        // Loin des galaxies : les rochers flottent entre elles, jamais dessus.
        let x = 0, z = 0;
        for (let t = 0; t < 6; t++) {
          x = (r() - 0.5) * ext * 2.4; z = (r() - 0.5) * ext * 2.4;
          if (!S.model.galaxies.some((g) => Math.hypot(g.pos.x - x, g.pos.z - z) < g.radius + 3)) break;
        }
        m4.compose(new THREE.Vector3(x, (r() - 0.5) * 12 - 2, z), qq, new THREE.Vector3(s * (0.8 + r() * 0.6), s * (0.55 + r() * 0.4), s * (0.8 + r() * 0.5)));
        inst.setMatrixAt(i, m4);
      }
      envGroup.add(inst);
    }
  }
  function clearGroup(g) {
    while (g.children.length) {
      const c = g.children.pop();
      if (c.userData && c.userData.cached) continue;
      c.traverse && c.traverse((x) => { if (x.userData && x.userData.ownGeo && x.geometry) x.geometry.dispose(); });
    }
  }

  // ---------- Galaxies (toujours visibles) ----------
  // Soleil-tableau de bord (#421) : le soleil du dossier porte, dans un anneau,
  // la répartition de ses tâches par état et, à l'extérieur, la part des retards.
  // Matériaux partagés par tous les soleils : rien ne s'accumule quand
  // l'univers est reconstruit après une modification.
  const sunGeoPool = keep(new THREE.PlaneGeometry(1, 1).rotateX(-Math.PI / 2));
  const sunMatPool = mat(new THREE.MeshBasicMaterial({ map: texSunPool, transparent: true, depthWrite: false }));
  const sunMatHalo = spriteMat(texSunHalo, 0.5), sunMatDisc = spriteMat(texSunDisc, 1);
  const coronaMats = [spriteMat(texCorona, 0.85), spriteMat(texCorona, 0.55)];
  coronaMats[0].rotation = 0.3; coronaMats[1].rotation = 1.1;
  const arcMats = {};
  const arcMat = (color) => arcMats[color] || (arcMats[color] = mat(new THREE.MeshLambertMaterial({ color, emissive: color, emissiveIntensity: 0.25 })));
  const sunMatLate = matBasic("#dc2626", 1);
  function buildSun(g) {
    const sun = new THREE.Group();
    sun.userData.sun = g.id;
    const rc = Math.max(1, g.radius * 0.075);
    const at = new THREE.Vector3(g.pos.x, rc * 1.1, g.pos.z);
    const pool = new THREE.Mesh(sunGeoPool, sunMatPool);
    pool.scale.set(rc * 11, 1, rc * 11);
    pool.position.set(g.pos.x, 0.04, g.pos.z);
    sun.add(pool);
    const sp = (m, s) => { const x = new THREE.Sprite(m); x.scale.set(s, s, 1); x.position.copy(at); sun.add(x); return x; };
    sp(sunMatHalo, rc * 7.5);
    sp(coronaMats[0], rc * 4.4);
    sp(coronaMats[1], rc * 3.6);
    sp(sunMatDisc, rc * 1.8);
    const seg = cosmosSunSegments(g.stats);
    seg.segments.forEach((s) => {
      const arc = new THREE.Mesh(new THREE.TorusGeometry(rc * 2.1, rc * 0.14, 8, Math.max(8, Math.round(64 * s.len / Math.PI)), s.len), arcMat(s.color));
      arc.userData.ownGeo = true;
      arc.position.set(g.pos.x, rc * 0.45, g.pos.z);
      arc.rotation.set(-Math.PI / 2, 0, s.start);
      sun.add(arc);
    });
    if (seg.late > 0) {
      const late = new THREE.Mesh(new THREE.TorusGeometry(rc * 2.55, rc * 0.06, 6, 64, Math.PI * 2 * seg.late), sunMatLate);
      late.userData.ownGeo = true;
      late.position.set(g.pos.x, rc * 0.45, g.pos.z);
      late.rotation.set(-Math.PI / 2, 0, Math.PI / 2 - Math.PI * 2 * seg.late);
      sun.add(late);
    }
    return sun;
  }
  const pick = { galaxies: [], planets: [], satMesh: null, satIds: [] };
  function buildGalaxies() {
    clearGroup(galaxyGroup);
    pick.galaxies = [];
    const M = S.model;
    const discMat = matBasic("#fbfdff", 0.34, { depthWrite: false });
    const rimMat = matBasic("#ffffff", 0.95, { depthWrite: false });
    const haloMat = matBasic("#c9dbf5", 0.35, { depthWrite: false });
    const orbitMat = mat(new THREE.LineBasicMaterial({ color: "#8aa6cc", transparent: true, opacity: 0.7 }));
    const orbitPts = [];
    M.galaxies.forEach((g) => {
      const disc = new THREE.Mesh(geoDisc, discMat);
      disc.scale.set(g.radius, 1, g.radius);
      disc.position.set(g.pos.x, 0, g.pos.z);
      disc.userData.pickGalaxy = g.id;
      disc.renderOrder = -2;
      galaxyGroup.add(disc);
      pick.galaxies.push(disc);
      const rim = new THREE.Mesh(ribbonGeo(g.radius, Math.max(0.22, g.radius * 0.014)), rimMat);
      rim.userData.ownGeo = true;
      rim.position.copy(disc.position).setY(0.02);
      galaxyGroup.add(rim);
      // Bord de verre : un halo bleuté juste au-delà du disque.
      const halo = new THREE.Mesh(ribbonGeo(g.radius + g.radius * 0.035, g.radius * 0.05), haloMat);
      halo.userData.ownGeo = true;
      halo.position.copy(disc.position).setY(0.01);
      galaxyGroup.add(halo);
      g.orbits.forEach((ob) => {
        const seg = 96;
        for (let i = 0; i < seg; i++) {
          const a0 = (i / seg) * Math.PI * 2, a1 = ((i + 1) / seg) * Math.PI * 2;
          orbitPts.push(g.pos.x + ob.x + Math.cos(a0) * ob.r, 0.03, g.pos.z + ob.z + Math.sin(a0) * ob.r, g.pos.x + ob.x + Math.cos(a1) * ob.r, 0.03, g.pos.z + ob.z + Math.sin(a1) * ob.r);
        }
      });
      g.amas.forEach((a) => {
        const am = new THREE.Mesh(geoDisc, discMat);
        am.scale.set(a.radius, 1, a.radius);
        am.position.set(g.pos.x + a.center.x, 0.01, g.pos.z + a.center.z);
        am.renderOrder = -1;
        galaxyGroup.add(am);
      });
      galaxyGroup.add(buildSun(g));
    });
    if (orbitPts.length) {
      const lg = new THREE.BufferGeometry();
      lg.setAttribute("position", new THREE.Float32BufferAttribute(orbitPts, 3));
      const lines = new THREE.LineSegments(lg, orbitMat);
      lines.userData.ownGeo = true;
      galaxyGroup.add(lines);
    }
    // Poussière d'étoiles sur les disques.
    const dust = [], r = rng("poussiere");
    M.galaxies.forEach((g) => {
      const n = Math.min(400, Math.round(g.radius * g.radius * 0.35));
      for (let i = 0; i < n; i++) { const a = r() * Math.PI * 2, d = Math.sqrt(r()) * g.radius * 0.96; dust.push(g.pos.x + Math.cos(a) * d, 0.08 + r() * 0.35, g.pos.z + Math.sin(a) * d); }
    });
    if (dust.length) {
      const dg = new THREE.BufferGeometry();
      dg.setAttribute("position", new THREE.Float32BufferAttribute(dust, 3));
      const pts = new THREE.Points(dg, mat(new THREE.PointsMaterial({ map: texDot, size: 0.45, color: "#fff6dc", transparent: true, depthWrite: false })));
      pts.userData.ownGeo = true;
      galaxyGroup.add(pts);
    }
  }

  // ---------- Planètes, satellites, sélection (selon l'échelle) ----------
  let farPlanets = null, dustPts = null;
  const detailed = {};
  function planetY(p) { return p.radius * 0.95; }
  function detailedSet() {
    const M = S.model, all = Object.keys(M.planets);
    const out = new Set();
    if (all.length <= 40 && S.effQuality !== "low") all.forEach((id) => out.add(id));
    else if (S.galaxyId) M.galaxyById[S.galaxyId].projectIds.forEach((id) => out.add(id));
    if (S.planetId) out.add(S.planetId);
    return out;
  }
  function buildPlanets() {
    clearGroup(detailGroup);
    Object.keys(detailed).forEach((k) => delete detailed[k]);
    pick.planets = [];
    const M = S.model, set = detailedSet();
    const ids = Object.keys(M.planets);
    // Planètes lointaines : une seule instance par planète, teintée.
    if (farPlanets) { farPlanets.dispose && farPlanets.dispose(); }
    farPlanets = new THREE.InstancedMesh(geoSphereLow, matInst, Math.max(1, ids.length));
    farPlanets.userData.ids = ids;
    const m4 = new THREE.Matrix4(), q = new THREE.Quaternion(), sc = new THREE.Vector3(), pv = new THREE.Vector3();
    ids.forEach((id, i) => {
      const p = M.planets[id];
      const hide = set.has(id);
      sc.setScalar(hide ? 0.0001 : p.radius);
      pv.set(p.world.x, planetY(p), p.world.z);
      m4.compose(pv, q, sc);
      farPlanets.setMatrixAt(i, m4);
      tmpC.set(p.color || "#94A3B8").lerp(new THREE.Color("#ffffff"), S.dimmed.has(id) ? 0.6 : 0.15);
      farPlanets.setColorAt(i, tmpC);
    });
    farPlanets.instanceMatrix.needsUpdate = true;
    if (farPlanets.instanceColor) farPlanets.instanceColor.needsUpdate = true;
    farPlanets.userData.cachedFar = true;
    detailGroup.add(farPlanets);
    pick.planets.push(farPlanets);
    const q2 = S.effQuality;
    set.forEach((id) => {
      const p = M.planets[id];
      const focus = id === S.planetId;
      const detail = focus ? { high: 5, medium: 4, low: 3 }[q2] : { high: 3, medium: 2, low: 2 }[q2];
      const grp = planetMesh(p, detail, q2 !== "low");
      const holder = new THREE.Group();
      holder.add(grp);
      grp.userData.cached = true;
      holder.scale.setScalar(p.radius);
      holder.position.set(p.world.x, planetY(p), p.world.z);
      holder.rotation.y = carteRand("rot:" + id) * Math.PI * 2;
      detailGroup.add(holder);
      grp.children.forEach((c) => pick.planets.push(c));
      detailed[id] = holder;
      // Anneau d'avancement du projet (arc = % terminé), dans sa couleur.
      const pct = (p.stats.pct || 0) / 100;
      const track = new THREE.Mesh(ribbonGeo(p.radius * 1.42, p.radius * 0.12), matBasic("#ffffff", 0.55, { depthWrite: false }));
      track.userData.ownGeo = true;
      track.position.set(p.world.x, 0.06, p.world.z);
      detailGroup.add(track);
      if (pct > 0) {
        const arc = new THREE.Mesh(ribbonGeo(p.radius * 1.42, p.radius * 0.12, Math.PI / 2, Math.PI * 2 * pct), matBasic(p.color || "#245EDB", 0.95, { depthWrite: false }));
        arc.userData.ownGeo = true;
        arc.position.set(p.world.x, 0.08, p.world.z);
        detailGroup.add(arc);
      }
    });
    buildSatellites();
    buildDust();
    buildSelection();
  }

  // Satellites : ceux de la galaxie courante (échelle galaxie ou planète).
  // Une seule géométrie instanciée pour les cubes, une pour les panneaux,
  // une pour les anneaux de retard.
  let satCubes = null, satWings = null, satAlerts = null;
  const satList = [];
  function satVisible(t) { return !S.visible || S.visible.has(t.id); }
  function buildSatellites() {
    clearAlertFx();
    [satCubes, satWings, satAlerts].forEach((m) => { if (m) { fxGroup.remove(m); m.dispose(); } });
    satCubes = satWings = satAlerts = null;
    satList.length = 0;
    pick.satMesh = null;
    if (S.level === "universe" || !S.galaxyId) return;
    const M = S.model, g = M.galaxyById[S.galaxyId];
    if (!g) return;
    g.projectIds.forEach((pid) => {
      const p = M.planets[pid];
      const tasks = p.taskIds.map((id) => S.norm.taskById[id]).filter((t) => t && satVisible(t));
      const grouped = pid === S.planetId && cosmosDetailLevel("planet", tasks.length) === "grouped-done";
      tasks.forEach((t) => {
        if (grouped && t.state === "done" && !(S.selected && S.selected.id === t.id)) return;
        satList.push({ t, p, s: M.satellites[t.id], focus: pid === S.planetId, f: cosmosTaskFlags(t) });
      });
    });
    const n = Math.max(1, satList.length);
    satCubes = new THREE.InstancedMesh(geoCube, matInst, n);
    satWings = new THREE.InstancedMesh(geoWing, matWing, n);
    satAlerts = new THREE.InstancedMesh(geoAlert, matAlert, n);
    satList.forEach((it, i) => {
      tmpC.set(it.t.statusColor || "#94A3B8");
      // Une tâche en retard se ternit (variante E, #421).
      if (it.f.late) tmpC.lerp(greyC, 0.45);
      satCubes.setColorAt(i, tmpC);
      tmpC.set(it.t.state === "done" ? "#c9d2de" : "#4f7fd6");
      satWings.setColorAt(i, tmpC);
    });
    satCubes.count = satWings.count = satAlerts.count = satList.length;
    [satCubes, satWings, satAlerts].forEach((m) => { if (m.instanceColor) m.instanceColor.needsUpdate = true; fxGroup.add(m); });
    pick.satMesh = satCubes;
    pick.satIds = satList.map((it) => it.t.id);
    buildAlertFx();
    placeSatellites();
  }
  // Signalétique des urgences et des retards (#421, variante E).
  // Urgente : aura orange (toute la galaxie courante) ; sur la planète
  // visitée, double anneau pulsant et étincelles. En retard : orbite basse en
  // pointillés rouges et fumée, sur la planète visitée.
  const greyC = new THREE.Color("#9aa0a8");
  const alertFx = new THREE.Group();
  scene.add(alertFx);
  const auraMat = spriteMat(texAura, 0.8), smokeMat = spriteMat(texSmoke, 0.55);
  const ringGeoA = keep(new THREE.TorusGeometry(1, 0.06, 8, 48)), ringGeoB = keep(new THREE.TorusGeometry(1.42, 0.05, 8, 48));
  const ringMatA = mat(new THREE.MeshBasicMaterial({ color: "#f59f00" })), ringMatB = mat(new THREE.MeshBasicMaterial({ color: "#ff6b35" }));
  const lowOrbitMat = mat(new THREE.LineDashedMaterial({ color: "#c92a2a", dashSize: 0.28, gapSize: 0.2, transparent: true, opacity: 0.85 }));
  const sparkMat = mat(new THREE.PointsMaterial({ map: texDot, size: 0.16, color: "#ff8c1a", transparent: true, depthWrite: false }));
  const fx = { auras: [], rings: [], smokes: [], sparks: null, sparkBase: [] };
  function clearAlertFx() {
    while (alertFx.children.length) { const c = alertFx.children.pop(); if (c.userData.ownGeo && c.geometry) c.geometry.dispose(); }
    fx.auras = []; fx.rings = []; fx.smokes = []; fx.sparks = null; fx.sparkBase = [];
  }
  function buildAlertFx() {
    clearAlertFx();
    const rich = S.effQuality !== "low";
    const lowRadii = {};
    satList.forEach((it) => {
      if (it.f.urgent) {
        const a = new THREE.Sprite(auraMat); a.userData.id = it.t.id; alertFx.add(a); fx.auras.push(a);
        if (it.focus && rich) {
          const r1 = new THREE.Mesh(ringGeoA, ringMatA), r2 = new THREE.Mesh(ringGeoB, ringMatB);
          r1.userData.id = r2.userData.id = it.t.id;
          alertFx.add(r1, r2); fx.rings.push(r1, r2);
          for (let k = 0; k < 14; k++) fx.sparkBase.push({ id: it.t.id, a: carteRand(it.t.id + "s" + k) * Math.PI * 2, d: 0.9 + carteRand(it.t.id + "d" + k) * 0.9, y: carteRand(it.t.id + "y" + k) - 0.3 });
        }
      }
      if (it.f.late && it.focus) {
        lowRadii[lowOrbit(it).toFixed(2)] = it.p;
        if (rich) for (let k = 1; k <= 4; k++) { const sm = new THREE.Sprite(smokeMat); sm.userData = { id: it.t.id, k }; alertFx.add(sm); fx.smokes.push(sm); }
      }
    });
    Object.keys(lowRadii).forEach((rs) => {
      const p = lowRadii[rs], r = Number(rs), pts = [];
      const tilt = 0.12 + carteRand("tilt:" + p.id) * 0.1;
      for (let i = 0; i <= 128; i++) { const a = (i / 128) * Math.PI * 2; pts.push(new THREE.Vector3(p.world.x + Math.cos(a) * r, planetY(p) + Math.sin(a) * r * tilt, p.world.z + Math.sin(a) * r)); }
      const line = new THREE.Line(new THREE.BufferGeometry().setFromPoints(pts), lowOrbitMat);
      line.computeLineDistances();
      line.userData.ownGeo = true;
      alertFx.add(line);
    });
    if (fx.sparkBase.length) {
      const g = new THREE.BufferGeometry();
      g.setAttribute("position", new THREE.Float32BufferAttribute(new Float32Array(fx.sparkBase.length * 3), 3));
      fx.sparks = new THREE.Points(g, sparkMat);
      fx.sparks.userData.ownGeo = true;
      alertFx.add(fx.sparks);
    }
  }
  // Orbite basse d'une tâche en retard : elle « décroche » vers la planète.
  function lowOrbit(it) { return Math.max(it.p.radius * 1.45, it.s.orbit - Math.max(0.9, it.p.radius * 0.45)); }
  function satSize(it) { const sel = S.selected && S.selected.kind === "task" && S.selected.id === it.t.id; return (it.focus ? 0.34 : 0.2) * Math.max(1, it.p.radius * 0.55) * (sel ? 1.3 : 1); }
  function placeAlertFx() {
    if (!alertFx.children.length) return;
    const pulse = animOn() ? 1 + 0.12 * Math.sin(S.time * 4) : 1;
    const byId = {};
    satList.forEach((it) => { byId[it.t.id] = it; });
    fx.auras.forEach((a) => { const it = byId[a.userData.id], p = satPos[a.userData.id]; if (!it || !p) return; a.position.copy(p); a.scale.setScalar(satSize(it) * 6 * pulse); });
    fx.rings.forEach((r, i) => { const it = byId[r.userData.id], p = satPos[r.userData.id]; if (!it || !p) return; r.position.copy(p); r.scale.setScalar(satSize(it) * 1.25 * (i % 2 ? 2 - pulse : pulse)); r.lookAt(camera.position); });
    fx.smokes.forEach((sm) => {
      const it = byId[sm.userData.id]; if (!it) return;
      const k = sm.userData.k, a = satAngle(it) - k * 0.11, r = lowOrbit(it), tilt = 0.12 + carteRand("tilt:" + it.p.id) * 0.1;
      sm.position.set(it.p.world.x + Math.cos(a) * r, planetY(it.p) + Math.sin(a) * r * tilt + k * 0.07, it.p.world.z + Math.sin(a) * r);
      sm.scale.setScalar(satSize(it) * (1.1 + k * 0.4));
    });
    if (fx.sparks) {
      const arr = fx.sparks.geometry.attributes.position.array;
      fx.sparkBase.forEach((b, i) => {
        const it = byId[b.id], p = satPos[b.id]; if (!it || !p) return;
        const s = satSize(it), a = b.a + (animOn() ? S.time * 0.8 : 0);
        arr[i * 3] = p.x + Math.cos(a) * b.d * s * 2.2; arr[i * 3 + 1] = p.y + b.y * s * 2.4; arr[i * 3 + 2] = p.z + Math.sin(a) * b.d * s * 2.2;
      });
      fx.sparks.geometry.attributes.position.needsUpdate = true;
      fx.sparks.geometry.computeBoundingSphere();
    }
  }
  const satPos = {};
  const m4s = new THREE.Matrix4(), qs = new THREE.Quaternion(), es = new THREE.Euler(), vs = new THREE.Vector3(), ss = new THREE.Vector3();
  function satAngle(it) {
    const speed = animOn() ? 0.05 / Math.max(1, it.s.orbit * 0.35) : 0;
    return it.s.angle + S.time * speed;
  }
  function satWorld(it, out) {
    const p = it.p;
    const a = satAngle(it);
    const r = it.f.late && it.focus ? lowOrbit(it) : it.s.orbit;
    const tilt = 0.12 + carteRand("tilt:" + p.id) * 0.1;
    out.set(p.world.x + Math.cos(a) * r, planetY(p) + Math.sin(a) * r * tilt, p.world.z + Math.sin(a) * r);
    return a;
  }
  function placeSatellites() {
    if (!satCubes) return;
    let alerts = 0;
    satList.forEach((it, i) => {
      const a = satWorld(it, vs);
      satPos[it.t.id] = satPos[it.t.id] || new THREE.Vector3();
      satPos[it.t.id].copy(vs);
      const sel = S.selected && S.selected.kind === "task" && S.selected.id === it.t.id;
      const size = (it.focus ? 0.34 : 0.2) * Math.max(1, it.p.radius * 0.55) * (sel ? 1.3 : 1);
      es.set(0.5 + a, a, 0.3); qs.setFromEuler(es);
      ss.setScalar(size);
      m4s.compose(vs, qs, ss);
      satCubes.setMatrixAt(i, m4s);
      // Panneaux solaires : déployés selon l'avancement de la tâche.
      const prog = S.preview && S.preview.id === it.t.id ? S.preview.progress : it.t.progress;
      ss.set(size * (0.35 + 0.65 * prog / 100), size, size);
      m4s.compose(vs, qs, ss);
      satWings.setMatrixAt(i, m4s);
    });
    satAlerts.count = alerts;
    placeAlertFx();
    satCubes.instanceMatrix.needsUpdate = true;
    satWings.instanceMatrix.needsUpdate = true;
    satAlerts.instanceMatrix.needsUpdate = true;
    satCubes.computeBoundingSphere && satCubes.computeBoundingSphere();
  }
  // Tâches vues de loin : des points colorés par statut, sans libellé.
  function buildDust() {
    if (dustPts) { fxGroup.remove(dustPts); dustPts.geometry.dispose(); dustPts = null; }
    const M = S.model, pos = [], col = [];
    Object.keys(M.planets).forEach((pid) => {
      const p = M.planets[pid];
      if (S.level !== "universe" && p.galaxyId === S.galaxyId) return;
      p.taskIds.forEach((tid) => {
        const t = S.norm.taskById[tid];
        if (!t || !satVisible(t)) return;
        const s = M.satellites[tid];
        pos.push(p.world.x + Math.cos(s.angle) * s.orbit, planetY(p) + Math.sin(s.angle) * s.orbit * 0.15, p.world.z + Math.sin(s.angle) * s.orbit);
        tmpC.set(t.statusColor || "#94A3B8");
        col.push(tmpC.r, tmpC.g, tmpC.b);
      });
    });
    if (!pos.length) return;
    const g = new THREE.BufferGeometry();
    g.setAttribute("position", new THREE.Float32BufferAttribute(pos, 3));
    g.setAttribute("color", new THREE.Float32BufferAttribute(col, 3));
    dustPts = new THREE.Points(g, dustMat);
    fxGroup.add(dustPts);
  }
  const dustMat = mat(new THREE.PointsMaterial({ size: 0.55, map: texDot, vertexColors: true, transparent: true, depthWrite: false }));

  // Marques de sélection : halo et anneaux tournés vers la caméra.
  const selFx = new THREE.Group();
  scene.add(selFx);
  const selGlow = new THREE.Sprite(spriteMat(texBlue, 0.9));
  const selRing1 = new THREE.Mesh(keep(new THREE.RingGeometry(0.75, 0.86, 64)), matBasic("#245edb", 0.9, { depthWrite: false }));
  const selRing2 = new THREE.Mesh(keep(new THREE.RingGeometry(1.05, 1.1, 64)), matBasic("#ffffff", 0.95, { depthWrite: false }));
  const selGround = new THREE.Mesh(keep(new THREE.RingGeometry(0.97, 1, 128).rotateX(-Math.PI / 2)), matBasic("#245edb", 0.85, { depthWrite: false }));
  const selGroundHalo = new THREE.Mesh(keep(new THREE.RingGeometry(1, 1.07, 128).rotateX(-Math.PI / 2)), matBasic("#9dbcff", 0.3, { depthWrite: false }));
  const planetGlow = new THREE.Sprite(spriteMat(texWhite, 0.7));
  selFx.add(selGlow, selRing1, selRing2, selGround, selGroundHalo, planetGlow);
  function buildSelection() {
    selFx.children.forEach((c) => { c.visible = false; });
    // Sur une planète, le soleil de sa galaxie peut passer devant elle : son
    // halo s'efface pour ne pas la voiler.
    galaxyGroup.children.forEach((c) => {
      if (c.userData.sun) c.visible = !(S.level === "planet" && c.userData.sun === S.galaxyId);
    });
    const M = S.model;
    if (!M) return;
    const sel = S.selected;
    // Galaxie ciblée (univers) ou galaxie courante : liseré bleu au sol.
    const gid = sel && sel.kind === "galaxy" ? sel.id : S.level === "universe" ? null : S.galaxyId;
    const g = gid && M.galaxyById[gid];
    if (g && S.level === "universe") {
      selGround.visible = selGroundHalo.visible = true;
      selGround.scale.setScalar(g.radius + 0.6); selGround.position.set(g.pos.x, 0.05, g.pos.z);
      selGroundHalo.scale.setScalar(g.radius + 0.6); selGroundHalo.position.copy(selGround.position);
    }
    if (sel && sel.kind === "planet" && M.planets[sel.id]) {
      const p = M.planets[sel.id];
      selGround.visible = selGroundHalo.visible = true;
      selGround.scale.setScalar(p.reach + 0.4); selGround.position.set(p.world.x, 0.1, p.world.z);
      selGroundHalo.scale.setScalar(p.reach + 0.4); selGroundHalo.position.copy(selGround.position);
    }
    if (S.planetId && M.planets[S.planetId]) {
      const p = M.planets[S.planetId];
      planetGlow.visible = true;
      planetGlow.scale.setScalar(p.radius * 3.6);
    }
    if (sel && sel.kind === "task" && satPos[sel.id]) selGlow.visible = selRing1.visible = selRing2.visible = true;
    S.dirty = true;
  }
  function updateSelectionFx() {
    // Halo de la planète visitée : toujours DERRIÈRE elle, dans l'axe de la vue.
    if (planetGlow.visible && S.planetId && S.model.planets[S.planetId]) {
      const p = S.model.planets[S.planetId];
      pv.set(p.world.x, planetY(p), p.world.z);
      planetGlow.position.copy(pv).sub(camera.position).normalize().multiplyScalar(p.radius * 1.6).add(pv);
    }
    const sel = S.selected;
    if (!(sel && sel.kind === "task" && satPos[sel.id])) { selGlow.visible = selRing1.visible = selRing2.visible = false; return; }
    const it = satList.find((x) => x.t.id === sel.id);
    const size = it ? (it.focus ? 0.34 : 0.2) * Math.max(1, it.p.radius * 0.55) * 1.3 : 0.5;
    const pos = satPos[sel.id];
    selGlow.visible = selRing1.visible = selRing2.visible = true;
    selGlow.position.copy(pos); selGlow.scale.setScalar(size * 7);
    [selRing1, selRing2].forEach((r) => { r.position.copy(pos); r.scale.setScalar(size * 1.9); r.lookAt(camera.position); });
  }

  // ---------- Caméra ----------
  function frameFor(level, id) { return cosmosFrame(S.model, level, id); }
  function goTo(fr, instant) {
    S.goal = new THREE.Vector3(fr.x, fr.y, fr.z);
    S.goalDist = fr.dist;
    if (instant || reduced) { S.target.copy(S.goal); S.dist = S.goalDist; S.goal = null; S.goalDist = null; }
    S.dirty = true;
  }
  function limits() {
    const fr = frameFor(S.level, S.level === "galaxy" ? S.galaxyId : S.planetId);
    return { min: fr.dist * 0.35, max: fr.dist * 2.1, base: fr.dist };
  }
  function updateCamera(dt) {
    if (S.goal) {
      const k = 1 - Math.pow(0.0015, dt);
      S.target.lerp(S.goal, k);
      S.dist += (S.goalDist - S.dist) * k;
      if (S.target.distanceTo(S.goal) < 0.02 && Math.abs(S.dist - S.goalDist) < 0.02) { S.target.copy(S.goal); S.dist = S.goalDist; S.goal = null; S.goalDist = null; }
      S.dirty = true;
    }
    const cp = Math.cos(S.pitch), sp = Math.sin(S.pitch);
    camera.position.set(S.target.x + Math.sin(S.yaw) * cp * S.dist, S.target.y + sp * S.dist, S.target.z + Math.cos(S.yaw) * cp * S.dist);
    camera.lookAt(S.target);
    camera.far = Math.max(400, S.dist * 8);
    camera.near = Math.max(0.05, S.dist * 0.01);
    camera.updateProjectionMatrix();
    scene.fog.near = S.dist * 1.3;
    scene.fog.far = S.dist * 3.4 + 60;
  }

  // ---------- Navigation entre échelles ----------
  function emitLevel() { o.onLevel && o.onLevel({ level: S.level, galaxyId: S.galaxyId, planetId: S.planetId }); }
  function setLevel(level, galaxyId, planetId, keepSel) {
    const changedGalaxy = galaxyId !== S.galaxyId, changedPlanet = planetId !== S.planetId;
    S.level = level; S.galaxyId = galaxyId || null; S.planetId = planetId || null;
    if (!keepSel) setSelected(null);
    if (changedGalaxy || changedPlanet || !farPlanets) buildPlanets(); else buildSelection();
    goTo(frameFor(level, level === "galaxy" ? galaxyId : planetId));
    emitLevel();
  }
  function setSelected(sel, silent) {
    const same = (S.selected && sel && S.selected.kind === sel.kind && S.selected.id === sel.id) || (!S.selected && !sel);
    S.selected = sel;
    if (!same) {
      if (satCubes) placeSatellites();
      buildSelection();
      if (!silent) o.onSelect && o.onSelect(sel);
    }
  }
  function enterGalaxy(gid) { if (S.model.galaxyById[gid]) setLevel("galaxy", gid, null); }
  function enterPlanet(pid) { const p = S.model.planets[pid]; if (p) setLevel("planet", p.galaxyId, pid); }
  function universe() { const g = S.galaxyId; setLevel("universe", null, null); if (g) setSelected({ kind: "galaxy", id: g }); }
  // Échap : d'abord fermer la tâche ouverte, puis remonter d'une échelle.
  function up() {
    if (S.selected && S.selected.kind === "task") { setSelected(null); return; }
    levelUp();
  }
  function levelUp() {
    if (S.level === "planet") { const pid = S.planetId; setLevel("galaxy", S.galaxyId, null); setSelected({ kind: "planet", id: pid }); }
    else if (S.level === "galaxy") universe();
  }
  // Rejoindre un objet trouvé par la recherche ou dans un panneau.
  function reveal(kind, id) {
    const path = cosmosPathOf(S.model, kind, id);
    if (!path) return false;
    if (kind === "galaxy") {
      if (S.level !== "universe") setLevel("universe", null, null);
      setSelected({ kind: "galaxy", id });
      const fr = frameFor("galaxy", id);
      goTo({ x: fr.x, y: fr.y, z: fr.z, dist: fr.dist * 1.6 });
      return true;
    }
    if (kind === "planet") { enterPlanet(id); return true; }
    if (path.planetId !== S.planetId) setLevel("planet", path.galaxyId, path.planetId, false);
    // Une tâche masquée par les filtres n'a pas de satellite : rien à viser.
    if (!satList.some((it) => it.t.id === id)) { setSelected(null); return false; }
    setSelected({ kind: "task", id });
    return true;
  }
  // Clic : sélectionner ; clic sur l'objet déjà sélectionné : y entrer.
  function activate(hit) {
    if (!hit) { if (S.selected && S.selected.kind !== "task") setSelected(null); return; }
    const cur = S.selected;
    const again = cur && cur.kind === hit.kind && cur.id === hit.id;
    if (hit.kind === "galaxy") {
      if (S.level === "universe") {
        if (again) { enterGalaxy(hit.id); return; }
        setSelected(hit);
        // La galaxie choisie vient au centre ; le zoom ne change pas.
        const g = S.model.galaxyById[hit.id];
        goTo({ x: g.pos.x, y: 0, z: g.pos.z, dist: Math.min(S.dist, Math.max(frameFor("galaxy", hit.id).dist * 2.2, frameFor("universe").dist * 0.8)) });
      }
      else if (hit.id !== S.galaxyId) { setLevel("universe", null, null); setSelected(hit); }
      return;
    }
    if (hit.kind === "planet") {
      const p = S.model.planets[hit.id];
      if (S.level === "universe") { if (cur && cur.kind === "galaxy" && cur.id === p.galaxyId) enterGalaxy(p.galaxyId); else setSelected({ kind: "galaxy", id: p.galaxyId }); return; }
      if (S.level === "planet" && hit.id === S.planetId) return;
      if (again || S.level === "planet") enterPlanet(hit.id); else setSelected(hit);
      return;
    }
    if (hit.kind === "task") {
      const s = S.model.satellites[hit.id];
      if (S.level !== "planet" || s.planetId !== S.planetId) { enterPlanet(s.planetId); setSelected(hit); return; }
      setSelected(hit);
    }
  }

  // ---------- Entrées souris, molette, clavier ----------
  const ray = new THREE.Raycaster(), ndc = new THREE.Vector2();
  function hitAt(cx, cy) {
    if (!S.model) return null;
    const rect = canvas.getBoundingClientRect();
    ndc.set(((cx - rect.left) / rect.width) * 2 - 1, -((cy - rect.top) / rect.height) * 2 + 1);
    ray.setFromCamera(ndc, camera);
    if (pick.satMesh && satList.length) {
      // Les satellites sont petits : on les vise avec une tolérance à l'écran.
      let best = null, bd = 18;
      const W = rect.width, H = rect.height;
      satList.forEach((it) => {
        const p = satPos[it.t.id]; if (!p) return;
        pv.copy(p).project(camera);
        if (pv.z > 1) return;
        const d = Math.hypot((pv.x + 1) / 2 * W - (cx - rect.left), (1 - pv.y) / 2 * H - (cy - rect.top));
        if (d < bd) { bd = d; best = it.t.id; }
      });
      if (best) return { kind: "task", id: best };
    }
