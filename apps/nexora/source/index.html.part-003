  box-shadow: inset 3px 0 0 var(--life-blue); font-weight: 650;
}
body[data-life-app="budget"] :is(.sidebar-collapse, .sidebar-expand-btn):hover { background: var(--life-soft); }
body[data-life-app="budget"] :is(.panel, .card, .grid-stack-item-content) {
  background: var(--life-surface); border-color: var(--life-border);
  border-radius: var(--life-card-radius) !important; box-shadow: var(--life-shadow);
}
body[data-life-app="budget"] .dash-widget-body .card { box-shadow: none; }
body[data-life-app="budget"] :is(.panel-title h2, .dash-widget-head) {
  font-family: var(--life-font); font-size: 14px; font-weight: 650; letter-spacing: -.015em;
}
body[data-life-app="budget"] .dash-widget-head { border-color: var(--life-border); }
body[data-life-app="budget"] :is(.card-label, .wealth-account-summary-name) { font-size: 13px; font-weight: 500; }
body[data-life-app="budget"] :is(.card-value, .wealth-account-summary-balance) {
  font-family: var(--life-font); font-weight: 700; letter-spacing: -.04em; font-variant-numeric: tabular-nums;
}
body[data-life-app="budget"] :is(.card-sub, .panel-note, .wealth-account-summary-type, .legend-note) {
  font-size: 12px; color: var(--life-muted); line-height: 1.45;
}
body[data-life-app="budget"] .wealth-account-summary-card {
  background: var(--life-surface) !important; border-radius: 12px !important; box-shadow: var(--life-shadow) !important;
}
body[data-life-app="budget"] :is(.button, .input, .select) { border-radius: 9px; font-size: 14px; }
body[data-life-app="budget"] :is(.icon-button, .widget-settings-toggle, .edit-btn) {
  border-radius: 8px; color: var(--life-secondary); border-color: var(--life-border);
}
body[data-life-app="budget"] .button.primary,
body[data-life-app="budget"] .fab {
  background: var(--life-blue) !important; border-color: var(--life-blue) !important; color: #fff !important;
}
body[data-life-app="budget"] .button.primary:hover,
body[data-life-app="budget"] .fab:hover { background: var(--life-blue-hover) !important; }
body[data-life-app="budget"] .button:not(.primary):not(.danger):hover { background: var(--life-soft); }
body[data-life-app="budget"] :is(.compact-filters, .connection-panel) { background: var(--life-soft); border-color: var(--life-border); }
body[data-life-app="budget"] :is(.compact-filters > summary, .field label) { font-size: 12px; letter-spacing: 0; text-transform: none; }
body[data-life-app="budget"] :is(.table-wrap, .modal-card, .dropdown-multiselect-panel, .transaction-visual-select-panel) {
  border-color: var(--life-border); border-radius: 12px;
}
body[data-life-app="budget"] th { background: var(--life-soft); color: var(--life-secondary); font-weight: 600; }
body[data-life-app="budget"] td { border-bottom-color: #edf1f6; }
body[data-life-app="budget"] tbody tr:hover { background: var(--life-soft); }
body[data-life-app="budget"] .modal { background: rgba(24,38,61,.42); }
body[data-life-app="budget"] .modal-card { box-shadow: var(--life-menu-shadow); }

/* Health360 — shared typography and surfaces; metric hues retain their meaning. */
body[data-life-app="health"] {
  --bg: var(--life-bg); --panel: var(--life-surface); --panel-2: var(--life-soft);
  --border: var(--life-border); --border-soft: #e8edf4; --grid-line: #e5ebf3;
  --text: var(--life-text); --text-muted: var(--life-secondary); --text-dim: var(--life-secondary); --text-faint: var(--life-muted);
  --font-body: var(--life-font); --font-display: var(--life-font); --font-mono: var(--life-font);
  --radius: 9px; --radius-lg: 14px; --card-shadow: var(--life-shadow);
}
body[data-life-app="health"] .header {
  background: var(--life-surface) !important; border: 1px solid var(--life-border) !important;
  border-radius: 14px !important; padding: 16px 18px; box-shadow: var(--life-shadow) !important;
  align-items: center;
}
body[data-life-app="health"] .header-title { font-size: 23px; font-weight: 750; letter-spacing: -.045em; }
body[data-life-app="health"] .header-title strong { color: var(--life-blue) !important; font-weight: inherit; }
body[data-life-app="health"] :is(.header-sub, .header-sub b, .header-refresh-status) { font-size: 12px; color: var(--life-secondary) !important; }
body[data-life-app="health"] .header .global-controls { background: var(--life-soft) !important; border-radius: 10px; }
body[data-life-app="health"] .header .control-label { font-size: 12px; text-transform: none; letter-spacing: 0; }
body[data-life-app="health"] :is(.header-icon-btn, .chart-settings-btn, .reglages-close-btn) {
  background: var(--life-surface) !important; border-color: var(--life-border) !important;
  border-radius: 9px !important; color: var(--life-secondary) !important; transform: none !important;
}
body[data-life-app="health"] :is(.header-icon-btn, .chart-settings-btn):hover { background: var(--life-blue-soft) !important; }
body[data-life-app="health"] .tabs {
  background: var(--life-surface) !important; border: 1px solid var(--life-border) !important;
  border-radius: 12px; padding: 5px; gap: 4px;
}
body[data-life-app="health"] .tab-btn {
  font-size: 14px; font-weight: 550 !important; padding: 9px 14px; border-radius: 9px;
  color: var(--life-secondary) !important;
}
body[data-life-app="health"] .tab-btn:hover { background: var(--life-soft); }
body[data-life-app="health"] .tab-btn.active { background: var(--life-blue-soft); color: var(--life-blue) !important; font-weight: 650 !important; }
body[data-life-app="health"] .tab-btn.active::after { display: none; }
body[data-life-app="health"] :is(.range-select button, .plotbox-controls button) { font-size: 12px; border-radius: 7px !important; }
body[data-life-app="health"] .range-select button.active,
body[data-life-app="health"] .header .range-select.agg-select button.active,
body[data-life-app="health"] .plotbox-controls button.active,
body[data-life-app="health"] .reglages-save-btn {
  background: var(--life-blue) !important; border-color: var(--life-blue) !important; color: #fff !important;
  animation: none !important; transform: none !important;
}
body[data-life-app="health"] :is(.kpi-card, .chart-card, .boxplot-card, .hero-chart-card, .explorer-card, .today-band-card, .cq-widget) {
  border-color: var(--life-border) !important; box-shadow: var(--life-shadow) !important;
  background: var(--life-surface); border-radius: 14px !important;
}
body[data-life-app="health"] :is(.chart-card-head h3, .chart-title, .hero-chart-head h3, .explorer-card-head h3, .section-head h2) {
  font-size: 14px; font-weight: 650; letter-spacing: -.015em;
}
body[data-life-app="health"] :is(.kpi-label, .kpi-delta, .section-head .hint, .explorer-card-head .hint, .boxplot-meta) {
  font-size: 12px; text-transform: none; letter-spacing: 0;
}
body[data-life-app="health"] .kpi-value { font-family: var(--life-font) !important; font-size: 24px; font-weight: 700; letter-spacing: -.04em; }
body[data-life-app="health"] .fold-toggle {
  font-size: 13px; font-weight: 600; color: var(--life-secondary); border-color: var(--life-border);
  background: var(--life-surface); border-radius: 9px;
}
body[data-life-app="health"] .fold-chevron { color: var(--life-blue); }
body[data-life-app="health"] :is(.reglages-modal, .settings-modal, .chart-tooltip, .boxplot-tooltip) { box-shadow: var(--life-menu-shadow); }
body[data-life-app="health"] .reglages-modal-backdrop { background: rgba(24,38,61,.42); }
body[data-life-app="health"] .cq-widget { gap: 16px; }
body[data-life-app="health"] .cq-level-badge { animation: none; }
body[data-life-app="health"] .cq-level-badge::before { background: var(--life-blue); }
body[data-life-app="health"] .cq-xp-fill { background: var(--life-blue); animation: none; }
body[data-life-app="health"] .cq-rank-name { font-size: 12px; color: var(--life-blue); letter-spacing: 0; text-transform: none; }
body[data-life-app="health"] :is(.cq-stat-name, .cq-quest-title, .cq-xp-caption, .cq-stat-num) { font-size: 12px; letter-spacing: 0; }
body[data-life-app="health"] :is(.cq-quest-sub, .cq-quest-tag) { font-size: 12px; }
body[data-life-app="health"] .cq-quest { border-radius: 9px; }
body[data-life-app="health"] .cq-quest:hover { transform: none; box-shadow: none; border-color: var(--life-border-strong); }
body[data-life-app="health"] .cq-quest:hover .cq-quest-icon { transform: none; }
body[data-life-app="health"] :is(.cq-sparkle, .cq-quest-confetti) { display: none; }
body[data-life-app="health"] .cq-stat-row { grid-template-columns: 18px minmax(88px,auto) minmax(20px,1fr) 46px 22px; }
body[data-life-app="health"] table.week-table th { background: var(--life-soft); color: var(--life-secondary); }

/* Nexora — apply tokens to both the React root and body-mounted menus. */
body[data-life-app="nexora"],
body[data-life-app="nexora"] :is(.lp-theme, .lp-app) {
  --bg: var(--life-bg); --surface: var(--life-surface); --surface-elevated: var(--life-surface);
  --border: var(--life-border); --border-strong: var(--life-border-strong);
  --text-primary: var(--life-text); --text-secondary: var(--life-secondary); --text-muted: var(--life-muted);
  --graphite: #53647b; --line-blue: var(--life-blue); --quai: var(--life-bg); --quai-clair: #edf1f7;
  --quai-elevated: var(--life-blue-soft); --paper: var(--life-bg); --paper-soft: var(--life-soft);
  --font-body: var(--life-font); --font-display: var(--life-font); --font-mono: var(--life-font);
  --radius: 14px; --radius-sm: 9px; --radius-lg: 14px;
  --fs-body: 14px; --fs-caption: 12px;
}
body[data-life-app="nexora"] .lp-topbar { background: var(--life-surface); border-color: var(--life-border); }
body[data-life-app="nexora"] .lp-topbar h2 { font-size: 20px; font-weight: 700; letter-spacing: -.03em; }
body[data-life-app="nexora"] .lp-sidebar { background: var(--life-surface); }
body[data-life-app="nexora"] .lp-logo { min-height: 32px; padding-bottom: 8px; border-bottom: 1px solid var(--life-border); }
body[data-life-app="nexora"] .lp-side-label { font-size: 11.5px; font-weight: 600; text-transform: none; letter-spacing: 0; margin-top: 9px; margin-bottom: 4px; }
body[data-life-app="nexora"] .lp-project-item { font-size: 13px; border-radius: 8px; min-height: 27px; }
body[data-life-app="nexora"] .lp-folder-item { border-radius: 8px; min-height: 24px; }
body[data-life-app="nexora"] .lp-project-item.active { background: var(--life-blue-soft); color: var(--life-blue); }
body[data-life-app="nexora"] .lp-tabs { background: var(--life-soft); border: 1px solid var(--life-border); border-radius: 10px; }
body[data-life-app="nexora"] .lp-tab { font-size: 13px; border-radius: 7px; }
body[data-life-app="nexora"] .lp-tab.active { background: var(--life-blue-soft); color: var(--life-blue); }
body[data-life-app="nexora"] .lp-create-icon-btn { border-style: solid; border-color: var(--life-border); background: var(--life-soft); border-radius: 9px; }
body[data-life-app="nexora"] .lp-dashboard-grid { background-image: none; }
body[data-life-app="nexora"] .lp-widget-card {
  border: 1px solid var(--life-border); border-radius: 14px; box-shadow: var(--life-shadow);
}
body[data-life-app="nexora"] .lp-widget-card-dragging { border-color: var(--life-blue); box-shadow: var(--life-menu-shadow); }
body[data-life-app="nexora"] .lp-widget-head { border-color: var(--life-border); }
body[data-life-app="nexora"] .lp-widget-title {
  font-family: var(--life-font); font-size: 14px; font-weight: 650; text-transform: none; letter-spacing: -.015em;
}
body[data-life-app="nexora"] .lp-widget-title:not([style*="color"]) { color: var(--life-text); }
body[data-life-app="nexora"] :is(.lp-btn, .lp-search-input) { border-radius: 9px; }
body[data-life-app="nexora"] .lp-btn-primary,
body[data-life-app="nexora"] .lp-global-add-task { background: var(--life-blue); border-color: var(--life-blue); color: #fff; }
body[data-life-app="nexora"] .lp-btn-primary:hover,
body[data-life-app="nexora"] .lp-global-add-task:hover { background: var(--life-blue-hover); }
body[data-life-app="nexora"] .lp-table thead th { background: var(--life-soft); font-size: 12px; font-weight: 600; text-transform: none; letter-spacing: 0; }
body[data-life-app="nexora"] .lp-modal { border-radius: 16px; box-shadow: var(--life-menu-shadow); }
body[data-life-app="nexora"] .lp-modal-head h3 { font-size: 18px; font-weight: 7
