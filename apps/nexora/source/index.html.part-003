  // éditable ici ; seules les relations complètes sont enregistrées.
  const [orgChartRelations, setOrgChartRelations] = useState(() => (Array.isArray(widget?.orgChartRelations) ? widget.orgChartRelations.map((r) => ({ ...r })) : []));
  const orgChartRelationChoices = useMemo(() => orgChartRelationOptions(ctx.teams, ctx.teamMembers), [ctx.teams, ctx.teamMembers]);
  const updateOrgRelation = (id, patch) => setOrgChartRelations((prev) => prev.map((r) => (r.id === id ? { ...r, ...patch } : r)));
  const [orgChartRootLabel, setOrgChartRootLabel] = useState(
    typeof widget?.orgChartRootLabel === "string" ? widget.orgChartRootLabel : ""
  );
