const WIDGET_TYPE_META = [
  // #140 : « Chiffre clé » devient un préréglage de la Carte (un bloc
  // Agrégation seul, en emphase Grande) plutôt qu'un type séparé.
  { key: "customCard", label: "Carte personnalisable", icon: LayoutDashboard, group: "Indicateurs" },
  { key: "chart", label: "Graphique", icon: BarChart3, group: "Indicateurs" },
  { key: "list", label: "Liste", icon: List, group: "Indicateurs" },
  { key: "taskDetail", label: "Tâche détaillée", icon: List, group: "Indicateurs" },
  { key: "minigantt", label: "Mini-Gantt", icon: GanttChartSquare, group: "Planning" },
  { key: "bubbles", label: "Bulles", icon: CircleDot, group: "Planning" },
  { key: "staffing", label: "Charge personnel", icon: Users, group: "Ressources Humaines" },
  { key: "orgchart", label: "Organigramme", icon: Network, group: "Ressources Humaines" },
  { key: "userProfile", label: "Utilisateur", icon: User, group: "Ressources Humaines" },
  // #228 : gérer utilisateurs et équipes (Réglages > Équipe) sans ouvrir les
  // Réglages — reprend TeamAndUserManagerPanel tel quel (voir WidgetTeamCatalog).
  { key: "teamCatalog", label: "Utilisateurs & Équipes", icon: Users, group: "Ressources Humaines" },
  { key: "criticalPath", label: "Chemin critique", icon: GitBranch, group: "Planning" },
  // #294 : grille continue + frise horaire du jour, version dense de la vue.
  { key: "calendar", label: "Calendrier", icon: CalendarDays, group: "Planning" },
  // #333 : mono-jour, sans grille au-dessus — même frise que le zoom jour du
  // Calendrier (CalendarDayTimeline), avec sa propre date affichée.
  { key: "focusDay", label: "Focus Journée", icon: Target, group: "Planning" },
  { key: "nextBestAction", label: "Next Best Action", icon: Zap, group: "Intelligence" },
  { key: "dailyBriefing", label: "Daily Briefing", icon: Sunrise, group: "Intelligence" },
  { key: "heatmapMonth", label: "Heat map mensuelle", icon: Grid3x3, group: "Suivi" },
  // #140 : « Compte à rebours » devient un bloc « Jours restants » de la Carte.
  { key: "budget", label: "Budget", icon: Wallet, group: "Suivi" },
  { key: "note", label: "Note libre", icon: StickyNote, group: "Suivi" },
  { key: "dominoEffect", label: "Domino Effect", icon: GitBranch, group: "Intelligence" },
  { key: "budgetBurnRate", label: "Budget Burn Rate", icon: Flame, group: "Suivi" },
  { key: "projectTreemap", label: "Treemap projets", icon: Grid3x3, group: "Suivi" },
  { key: "heatmapGrid", label: "Heat map croisée", icon: Grid3x3, group: "Suivi" },
  // Habit Tracker (#193) : Quick Habit coche le jour, l'autre en fait le
  // heatmap — un seul widget avec bascule Mensuel/Annuel, pas deux.
  { key: "habitQuick", label: "Quick Habit", icon: CheckCircle2, group: "Suivi" },
  { key: "habitHeatmap", label: "Heatmap habitudes", icon: Grid3x3, group: "Suivi" },
  { key: "habitPixel", label: "Pixel des habitudes", icon: LayoutDashboard, group: "Suivi" },
  { key: "embedMetro", label: "Métro (complet)", icon: TrainTrack, group: "Planning" },
  { key: "embedRadar", label: "Radar (complet)", icon: Crosshair, group: "Planning" },
  { key: "embedCarte", label: "Carte (complet)", icon: MapIcon, group: "Planning" },
  { key: "embedCosmos", label: "Cosmos (complet)", icon: Orbit, group: "Planning" },
  { key: "embedTimeline3d", label: "Timeline 3D (complet)", icon: TrainFront, group: "Planning" },
  // Finance PRO (#267, lot #275) : widgets dans le moteur de dashboard
  // existant — aucun second système de tableau de bord créé.
  { key: "financeProSynthese", label: "Finance PRO — Synthèse", icon: Wallet, group: "Suivi" },
  { key: "financeProEcheances", label: "Finance PRO — Échéances de facturation", icon: CalendarClock, group: "Suivi" },
