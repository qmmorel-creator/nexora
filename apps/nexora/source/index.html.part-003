  { key: "cloturee", label: "Clôturée", color: "var(--text-muted)" },
  { key: "archivee", label: "Archivée", color: "var(--text-muted)" },
];

// Ordre du bandeau de phase de la vue Mission (§ tableau de bord par mission)
// — "archivee" n'y figure pas comme étape : c'est un classement final au même
// niveau que "cloturee", jamais une phase du cycle de vie qu'on "atteint".
