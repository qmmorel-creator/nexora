      keyTarget.removeEventListener("keydown", onKey);
      canvas.removeEventListener("wheel", onWheel);
      labels.removeEventListener("click", onLabelClick);
      labels.removeEventListener("dblclick", onLabelClick);
      [envGroup, galaxyGroup, detailGroup, fxGroup].forEach(clearGroup);
      clearAlertFx();
      [satCubes, satWings, satAlerts, farPlanets].forEach((m) => m && m.dispose && m.dispose());
      if (dustPts) dustPts.geometry.dispose();
      Object.keys(planetCache).forEach((k) => (planetCache[k].userData.owned || []).forEach((g) => g.dispose()));
      disposables.forEach((x) => x.dispose());
