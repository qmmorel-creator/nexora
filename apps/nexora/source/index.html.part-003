    message: d.mode === "deadlineEnd" ? "Échéance modifiée." : "Dates modifiées.",
          actionLabel: "Annuler",
          onAction: () => setTasks((prev) => prev.map((t) => (t.id === taskId ? { ...t, start: origStart, end: origEnd } : t))),
        });
      } else if (d && !d.moved && d.task) {
        onOpen(d.task);
      }
    }
    window.addEventListener("mousemove", onMove);
    window.addEventListener("mouseup", onUp);
    window.addEventListener("touchmove", onMove, { passive: false });
    window.addEventListener("touchend", onUp);
    window.addEventListener("touchcancel", onUp);
    return () => {
      window.removeEventListener("mousemove", onMove); window.removeEventListener("mouseup", onUp);
      window.removeEventListener("touchmove", onMove); window.removeEventListener("touchend", onUp); window.removeEventListener("touchcancel", onUp);
    };
  }, [setTasks, pushToast, onOpen]);

  // Glisser-déposer dédié aux sous-tâches : ne modifie que leur propre date de fin,
  // au sein de la checklist de leur tâche parente.
  const subDragRef = useRef(null);
  const startDragSubtask = (e, taskId, subId, origEnd) => {
    e.stopPropagation();
    e.preventDefault();
    const touch = e.touches && e.touches[0];
    subDragRef.current = { taskId, subId, startClientX: touch ? touch.clientX : e.clientX, origEnd, dw: dayWidth, moved: false };
  };
  useEffect(() => {
    function onMove(e) {
      const d = subDragRef.current;
      if (!d) return;
      const point = e.touches ? e.touches[0] : e;
      if (!point) return;
      if (e.cancelable) e.preventDefault();
      const deltaDays = Math.round((point.clientX - d.startClientX) / d.dw);
      if (deltaDays !== 0) d.moved = true;
      const newEnd = addDays(d.origEnd, deltaDays);
      setTasks((prev) => prev.map((t) => {
        if (t.id !== d.taskId) return t;
        return { ...t, checklist: (t.checklist || []).map((s) => (s.id === d.subId ? { ...s, end: newEnd } : s)) };
      }));
    }
    function onUp() {
      const d = subDragRef.current;
      subDragRef.current = null;
      if (d && d.moved && pushToast) {
        const { taskId, subId, origEnd } = d;
        pushToast({
          message: "Date de sous-tâche modifiée.",
          actionLabel: "Annuler",
          onAction: () => setTasks((prev) => prev.map((t) => (t.id === taskId ? { ...t, checklist: (t.checklist || []).map((s) => (s.id === subId ? { ...s, end: origEnd } : s)) } : t))),
        });
      }
    }
    window.addEventListener("mousemove", onMove);
    window.addEventListener("mouseup", onUp);
    window.addEventListener("touchmove", onMove, { passive: false });
    window.addEventListener("touchend", onUp);
    window.addEventListener("touchcancel", onUp);
    return () => {
      window.removeEventListener("mousemove", onMove); window.removeEventListener("mouseup", onUp);
      window.removeEventListener("touchmove", onMove); window.removeEventListener("touchend", onUp); window.removeEventListener("touchcancel", onUp);
    };
  }, [setTasks, pushToast]);

  // Barre de progression modifiable directement dans le graphique
  const progressDragRef = useRef(null);
  const setProgressFromClientX = (taskId, barX0, barW, clientX) => {
    const pct = Math.max(0, Math.min(100, Math.round(((clientX - barX0) / barW) * 100)));
    setTasks((prev) => prev.map((t) => (t.id === taskId ? { ...t, progress: pct } : t)));
  };
  const startDragProgress = (e, t, barX0, barW) => {
    e.stopPropagation();
    e.preventDefault();
    const svgRect = e.currentTarget.closest("svg").getBoundingClientRect();
    const screenBarX0 = svgRect.left + barX0;
    progressDragRef.current = { taskId: t.id, barX0: screenBarX0, barW };
    setProgressFromClientX(t.id, screenBarX0, barW, e.clientX);
  };
  useEffect(() => {
    function onMove(e) {
      const d = progressDragRef.current;
      if (!d) return;
      setProgressFromClientX(d.taskId, d.barX0, d.barW, e.clientX);
    }
    function onUp() { progressDragRef.current = null; }
    window.addEventListener("mousemove", onMove);
    window.addEventListener("mouseup", onUp);
    return () => { window.removeEventListener("mousemove", onMove); window.removeEventListener("mouseup", onUp); };
  }, [setTasks]);

  const ProjectRow = ({ row }) => {
    const { project: p, minDate, maxDate, items, mainY, ROW_H, avgProgress } = row;
    const color = p.color || "var(--text-muted)";
    const isCollapsed = collapsed[p.id];
    const textHaloStyle = { paintOrder: "stroke fill", stroke: "var(--surface)", strokeWidth: 4, strokeLinejoin: "round" };
    // Position de chaque tâche (au sein de CE projet) pour les flèches de dépendance —
    // seules les dépendances entre tâches du même projet peuvent être tracées, une
    // flèche ne pouvant pas relier deux <svg> distincts (un par projet).
    const posMap = {};
    items.forEach(({ t, side, branchDist, isMilestone, activityOffset = 0 }) => {
      const branchY = getTaskType(t) === "activity"
        ? mainY + activityOffset
        : (mainY + side * branchDist);
      posMap[t.id] = { x0:xFor(t.start), x1:xFor(t.end), y:branchY, activityOffset };
    });
    // Couleur de chaque tâche : normalement la couleur du statut (comme les
    // bifurcations) ; mais quand la ligne fusionne plusieurs projets (regroupement
    // par dossier), on utilise plutôt la couleur du PROJET D'ORIGINE de chaque
    // tâche — c'est le seul repère visuel qui permette encore de distinguer les
    // tâches de projets différents sur cette même ligne fusionnée.
    const taskColorMap = {};
    items.forEach(({ t: it }) => {
      if (p.isFolderGroup) {
        const ownProject = ctx.projects.find((pr) => pr.id === it.projectId);
        taskColorMap[it.id] = ownProject?.color || color;
      } else {
        const st = ctx.statuses.find((s) => s.id === it.statusId);
        taskColorMap[it.id] = st?.color || color;
      }
    });
    // Point de départ réel du tracé d'une tâche : si elle dépend d'une tâche du MÊME
    // projet, son embranchement part du cercle de fin de cette dernière (celle dont la
    // fin est la plus tardive, si plusieurs dépendances — c'est elle qui détermine la
    // date de début auto-calculée) plutôt que de l'axe principal du projet. Les
    // dépendances inter-projets restent matérialisées par la flèche pointillée globale,
    // un embranchement ne pouvant pas franchir deux <svg> distincts.
    const originFor = (t) => {
      if (getTaskType(t) === "action" && t.linkedActivityId) {
        const act = posMap[t.linkedActivityId];
        if (act) {
          const rel = t.activityRelation || "contributes";
          const x = rel === "blocks_start" ? act.x0 : rel === "blocks_end" ? act.x1 : (act.x0 + act.x1) / 2;
          return { x, y:act.y, fromPred:false, fromActivity:true, relation:rel };
        }
      }
      if (t.dependsOn && t.dependsOn.length) {
        let best = null;
        t.dependsOn.forEach((depId) => {
          const p = posMap[depId];
          if (p && (!best || p.x1 > best.x1)) best = p;
        });
        if (best) return { x: best.x1, y: best.y, fromPred: true };
      }
      return { x: xFor(t.start), y: mainY, fromPred: false };
    };
    return (
      <g>
        {/* Flèches de dépendance, tracées en tout premier pour rester TOUJOURS derrière
            le texte (et son halo blanc) — uniquement entre tâches du même projet, une
            flèche ne pouvant pas relier deux <svg> distincts (un par projet). Dégradé
            entre la couleur de la tâche de départ et celle de la tâche d'arrivée,
            épaisseur alignée sur la ligne de métro principale du projet. */}
        {!isCollapsed && items.filter((it) => it.t.dependsOn && it.t.dependsOn.length).flatMap(({ t }) => {
          const primaryOrigin = originFor(t); // dépendance déjà matérialisée par la bifurcation elle-même
          return t.dependsOn.map((depId) => {
            const from = posMap[depId];
            const to = posMap[t.id];
            if (!from || !to || depId === t.id) return null;
            if (primaryOrigin.fromPred && from.x1 === primaryOrigin.x && from.y === primaryOrigin.y) return null; // déjà visible via la bifurcation
            const startX = from.x1 + 6; // sort visiblement du cercle de la tâche de départ, plutôt que de son centre
            const midX = (startX + to.x0) / 2;
            const bend = Math.min(8, Math.abs(to.y - from.y) / 2 || 6);
            const dir = to.y > from.y ? 1 : -1;
            const d = Math.abs(to.y - from.y) < 1
              ? `M ${startX} ${from.y} L ${to.x0 - 3} ${to.y}`
              : `M ${startX} ${from.y} L ${midX - bend} ${from.y} Q ${midX} ${from.y} ${midX} ${from.y + dir * bend} L ${midX} ${to.y - dir * bend} Q ${midX} ${to.y} ${midX + bend} ${to.y} L ${to.x0 - 3} ${to.y}`;
            const gradId = `pm-dep-grad-${depId}-${t.id}`;
            const markerId = `pm-dep-arrow-${depId}-${t.id}`;
            return (
              <React.Fragment key={depId + "-" + t.id}>
                <defs>
                  <linearGradient id={gradId} gradientUnits="userSpaceOnUse" x1={startX} y1={from.y} x2={to.x0} y2={to.y}>
                    <stop offset="0%" stopColor={accent} stopOpacity="0.45" />
                    <stop offset="100%" stopColor={accent} />
                  </linearGradient>
                  <marker id={markerId} markerWidth="5" markerHeight="5" refX="3.5" refY="1.75" orient="auto">
                    <path d="M0,0 L3.5,1.75 L0,3.5 Z" fill={accent} />
                  </marker>
                </defs>
                {/* Contour blanc en dessous, comme pour les flèches inter-projets — sans
                    lui, le trait fin se perd dans la ligne de métro et les autres
                    éléments de la même rangée. */}
                <path d={d} fill="none" stroke="#fff" strokeWidth="4.5" strokeLinecap="round" opacity="0.9" />
                <path d={d} fill="none" stroke={`url(#${gradId})`} strokeWidth="2.2" strokeDasharray="5 4" opacity="0.95" markerEnd={`url(#${markerId})`} strokeLinecap="round" />
              </React.Fragment>
            );
          });
        })}

        {verticalSeparators.map((sx, i) => (
          <line key={"sep-" + i} x1={sx} y1={0} x2={sx} y2={ROW_H} stroke="var(--border)" strokeWidth="1" opacity="0.4" />
        ))}
        {todayX !== null && (
          <g>
            {appearance?.animTodayPulse && (
              <line
                x1={todayX} y1={0} x2={todayX} y2={ROW_H}
                stroke="var(--accent)"
                strokeWidth="4"
                strokeLinecap="round"
                strokeOpacity="0.08"
                className="lp-pm-today-pulse-halo"
              />
            )}
            <line x1={todayX} y1={0} x2={todayX} y2={ROW_H} stroke="var(--accent)" strokeWidth="2.5" strokeLinecap="round" opacity="0.95" className="lp-pm-today-line" />
            <path
              d={`M ${todayX - 5} 0 L ${todayX + 5} 0 L ${todayX} 8 Z`}
              fill="var(--accent)"
              className={"lp-pm-today-marker" + (appearance?.animTodayPulse ? " lp-anim-on" : "")}
            />
          </g>
        )}

        <line x1={xFor(minDate)} y1={mainY} x2={xFor(maxDate)} y2={mainY} stroke={color} strokeWidth="3.2" strokeLinecap="round" opacity="0.55" />
        {avgProgress > 0 && <line x1={xFor(minDate)} y1={mainY} x2={xFor(minDate) + (xFor(maxDate) - xFor(minDate)) * (avgProgress / 100)} y2={mainY} stroke={color} strokeWidth="5.5" strokeLinecap="round" />}
        <Station x={xFor(minDate)} y={mainY} color={color} r={7} />

        {!isCollapsed && items.filter((it) => getTaskType(it.t) === "activity" && !isFullyShared(it.t)).map(({ t, activityOffset = 0 }) => {
          const x0 = xFor(t.start), x1 = xFor(t.end);
          const activityY = mainY + activityOffset;
          const done = isTaskDoneGlobal(t, ctx);

          // IMPORTANT : on compte toutes les Actions liées, même si elles n'ont
          // aucune date. C'était la cause du compteur absent malgré "Actions liées (4)"
          // visible dans la fiche Activité.
          const linked = tasks.filter((a) => getTaskType(a) === "action" && a.linkedActivityId === t.id);
          const linkedDone = linked.filter((a) => isTaskDoneGlobal(a, ctx)).length;
          const isExpanded = expandedActivities.has(t.id);
          const critical = !!criticalPathIds && criticalPathIds.has(t.id);
          const stroke = critical ? PM_CRITICAL_COLOR : color;
          const mid = (x0 + x1) / 2;
          const titleW = pmMeasureText(t.title, TITLE_FONT);
          const hasDescription = !!String(t.desc ?? t.description ?? "").trim();
          return (
            <g key={"activity-" + t.id} opacity={dimOpacity(t.id)}>
              {activityOffset !== 0 && (
                <>
                  <path d={branchPath(x0, mainY, x0, activityY)} fill="none" stroke={stroke} strokeWidth="2" strokeLinecap="round" opacity=".52" />
                  <path d={branchPath(x1, mainY, x1, activityY)} fill="none" stroke={stroke} strokeWidth="2" strokeLinecap="round" opacity=".52" />
                </>
              )}
              <line x1={x0} y1={activityY} x2={x1} y2={activityY} stroke="var(--surface)" strokeWidth="12" strokeLinecap="round" />
              <line x1={x0} y1={activityY} x2={x1} y2={activityY} stroke={stroke} strokeWidth={critical ? "8.5" : "7"} strokeLinecap="round" opacity={done ? .48 : .92} />
              <circle cx={x0} cy={activityY} r="6.5" fill="var(--surface)" stroke={stroke} strokeWidth="1.8" />
              <circle cx={x1} cy={activityY} r="6.5" fill="var(--surface)" stroke={stroke} strokeWidth="1.8" />

              <rect x={mid - titleW/2 - 6} y={activityY - 27} width={titleW + 12} height="18" rx="3" fill="var(--surface)" opacity=".98" />
              <text x={mid} y={activityY - 14} textAnchor="middle" className="lp-pm-activity-label" fill="var(--text-900)" onClick={() => onOpen(t)} style={{ cursor:"pointer" }}>
                {t.title}
              </text>
              {hasDescription && (
                <g
                  className="lp-pm-note-trigger"
                  transform={`translate(${mid + titleW/2 + 9}, ${activityY - 25})`}
                  onClick={(e)=>{
                    e.stopPropagation();
                    setDescriptionPopup({task:t,x:e.clientX,y:e.clientY});
                  }}
                  style={{cursor:"pointer"}}
                >
                  <title>Afficher la description</title>
                  <rect x="0" y="0" width="17" height="16" rx="4" fill="var(--surface)" stroke="var(--border)" strokeWidth="1"/>
                  <path d="M4.5 4.5h8M4.5 7.5h8M4.5 10.5h5.5" fill="none" stroke="var(--text-600)" strokeWidth="1.25" strokeLinecap="round"/>
                  <path d="M11.2 1.9v2.7h2.7" fill="none" stroke="var(--text-600)" strokeWidth="1.05" strokeLinecap="round" strokeLinejoin="round" opacity=".7"/>
                </g>
              )}

              {/* Toujours visible : même une activité sans action affiche 0/0 afin
                  que la logique Action ↔ Activité soit immédiatement compréhensible. */}
              <g className="lp-pm-activity-actions" onClick={(e) => { e.stopPropagation(); if (linked.length) toggleActivityActions(t.id); }} style={{ cursor:linked.length ? "pointer" : "default" }}>
                <line x1={mid} y1={activityY + 7} x2={mid} y2={activityY + 21} stroke={stroke} strokeWidth={isExpanded ? "2.4" : "1.4"} strokeDasharray={isExpanded ? "0" : "2 3"} opacity={linked.length ? .9 : .38} />
                <rect x={mid - 29} y={activityY + 20} width="58" height="19" rx="9.5" fill="var(--surface)" stroke={stroke} strokeWidth="1.2" opacity={linked.length ? 1 : .55} />
                <text x={mid} y={activityY + 33} textAnchor="middle" fill={stroke}>{linkedDone}/{linked.length} actions</text>
              </g>
            </g>
          );
        })}

        {!isCollapsed && items.filter((it) =>
          getTaskType(it.t) === "action" &&
          !isFullyShared(it.t) &&
          (!it.t.linkedActivityId || expandedActivities.has(it.t.linkedActivityId))
        ).map(({ t, side, branchDist, subtasks }) => {
          const branchY = mainY + side * branchDist;
          const x0 = xFor(t.start), x1 = xFor(t.end);
          const origin = originFor(t);
          const st = ctx.statuses.find((s) => s.id === t.statusId);
          // Regroupement par dossier : la couleur du statut ne différencie plus rien
          // (toutes les tâches de la ligne peuvent avoir le même statut) — on bascule
          // sur la couleur du PROJET D'ORIGINE de la tâche, seul repère qui distingue
          // encore les tâches entre elles sur cette ligne fusionnée.
          const taskColor = p.isFolderGroup
            ? (ctx.projects.find((pr) => pr.id === t.projectId)?.color || "var(--text-muted)")
            : (st?.color || "var(--text-muted)");
          const done = isTaskDoneGlobal(t, ctx);
          const pct = Math.max(0, Math.min(100, done ? 100 : t.progress || 0));
          const xProgress = x0 + (x1 - x0) * (pct / 100); // portion réalisée mesurée sur la vraie durée de la tâche
          const isCritical = !!criticalPathIds && criticalPathIds.has(t.id);
          const atRisk = showRiskBadges && !done && isAtRisk(t);
          const blockingRelation = origin.fromActivity && ["blocks_start","blocks_end"].includes(t.activityRelation);
          const lineColor = isCritical ? PM_CRITICAL_COLOR : taskColor;
          // La tâche est TOUJOURS dessinée sur ses propres dates réelles (x0 → x1) : une
          // dépendance ne déplace jamais visuellement son début ou sa fin. Seule la façon
          // dont elle rejoint le reste du plan change : si elle dépend d'une tâche du même
          // projet, un connecteur discret part du cercle de fin de cette dernière et
          // rejoint le début réel de la tâche (sur sa propre ligne) — plutôt que de faire
          // partir la tâche elle-même de ce point, ce qui aurait déplacé sa date affichée.
          const actionAnchorX = origin.fromActivity ? origin.x : x0;
          const mainPath = origin.fromPred
            ? `M ${x0} ${branchY} L ${x1} ${branchY}`
            : origin.fromActivity
              ? branchPath(actionAnchorX, origin.y, x1, branchY)
              : branchPath(x0, mainY, x1, branchY);
          const progressPath = origin.fromPred
            ? `M ${x0} ${branchY} L ${xProgress} ${branchY}`
            : origin.fromActivity
              ? branchPath(actionAnchorX, origin.y, xProgress, branchY)
              : branchPath(x0, mainY, xProgress, branchY);
          const startStationY = origin.fromPred ? branchY : mainY;
          return (
            <g key={"line-" + t.id} opacity={dimOpacity(t.id)}>
              {/* Connecteur de dépendance : part du cercle de fin de la tâche prédécesseure
                  et rejoint le début réel de cette tâche-ci, sur sa propre ligne — visuellement
                  distinct (plus fin, pointillé) de la tâche elle-même pour ne jamais laisser
                  penser que la tâche démarre à la date du prédécesseur. */}
              {origin.fromPred && (
                <path d={branchPath(origin.x, origin.y, x0, branchY)} fill="none" stroke={lineColor} strokeWidth="1.8" strokeLinecap="round" strokeDasharray="1 4" opacity={done ? 0.3 : 0.5} />
              )}
              {/* Épaisseur du trait : plus épais sur la portion déjà réalisée, un peu plus fin sur le reste.
                  En chemin critique, le trait est plus épais et dans la couleur "express" pour ressortir
                  nettement de la ligne, même quand la vue est chargée. */}
              <path d={mainPath} fill="none" stroke={lineColor} strokeWidth={isCritical ? "4" : (blockingRelation ? "3.8" : "2.2")} strokeLinecap="round" opacity={done ? (isCritical ? 0.55 : 0.4) : (isCritical ? 0.8 : 0.55)} pathLength={appearance?.animLineDraw ? "1" : undefined} strokeDasharray={appearance?.animLineDraw ? "1" : undefined} className={appearance?.animLineDraw ? "lp-pm-line-draw" : undefined} />
              {/* Animation du disque déplacée dans le calque SVG global final.
                  Ne jamais la rendre dans le SVG propre à cette ligne : un autre SVG de
                  projet pourrait sinon être peint au-dessus du disque. */}
              {pct > 0 && <path d={progressPath} fill="none" stroke={lineColor} strokeWidth={isCritical ? "6" : "4.5"} strokeLinecap="round" opacity={done ? 0.55 : 0.95} />}
              {/* Poignée sur la limite épais/fin : glisser horizontalement ajuste
                  l'avancement de la tâche, en suivant la largeur réelle affichée à
                  l'écran (donc cohérent quel que soit le niveau de zoom). Un simple
                  clic (sans glisser) ouvre la fiche, comme partout ailleurs. Absente
                  pile à 0% ou 100% : elle coïnciderait alors exactement avec la
                  poignée de début/fin de tâche, qui passe devant dans le DOM. */}
              {!t.milestone && pct > 0 && pct < 100 && (
                <g
                  onMouseDown={(e) => startDragTask(e, t, "progress", { taskPxWidth: x1 - x0 })}
                  onTouchStart={(e) => startDragTask(e, t, "progress", { taskPxWidth: x1 - x0 })}
                  style={{ cursor: "ew-resize" }}
                  className="lp-pm-progress-handle"
                >
                  <rect x={xProgress - 7} y={branchY - 8} width="14" height="16" fill="transparent" />
                  <line x1={xProgress} y1={branchY - 5} x2={xProgress} y2={branchY + 5} stroke={lineColor} strokeWidth="2" strokeLinecap="round" opacity={done ? 0.55 : 0.95} />
                </g>
              )}
              {/* Point de glisser du début : toujours posé sur la vraie date de début de la
                  tâche — sur l'axe du projet si elle est indépendante, ou sur sa propre ligne
                  (juste après le connecteur) si elle dépend d'une autre tâche. */}
              <g onMouseDown={(e) => startDragTask(e, t, "start")} onTouchStart={(e) => startDragTask(e, t, "start")} style={{ cursor: "ew-resize" }} data-pm-task-start-id={t.id}>
                <circle cx={x0} cy={startStationY} r="10" fill="transparent" />
                <Station x={x0} y={startStationY} color={lineColor} r={3.5} />
              </g>
              <g
                onMouseDown={(e) => startDragTask(e, t, "end")}
                onTouchStart={(e) => startDragTask(e, t, "end")}
                onClick={(e) => { if (e.metaKey || e.ctrlKey || e.shiftKey) { e.stopPropagation(); toggleSelect(t.id); } }}
                style={{ cursor: "ew-resize" }}
                data-pm-task-id={t.id}
              >
                <circle cx={x1} cy={branchY} r="11" fill="transparent" />
                {atRisk && appearance?.animLateAlert && (
                  <circle cx={x1} cy={branchY} r="6" fill="none" stroke={PM_RISK_COLOR} strokeWidth="2" className="lp-pm-late-ring" />
                )}
                <Station x={x1} y={branchY} color={lineColor} r={5.5} done={done} icon={p.metroTaskIcons ? resolveMilestoneIcon(t, ctx) : null} justCompleted={justCompletedIds.has(t.id)} />
                {(selectedIds.has(t.id) || focusedId === t.id) && (
                  <circle cx={x1} cy={branchY} r="10" fill="none" stroke={selectedIds.has(t.id) ? "var(--signal)" : "var(--text-muted)"} strokeWidth="2" strokeDasharray={selectedIds.has(t.id) ? "0" : "2 2"} />
                )}
                {atRisk && (
                  <g transform={`translate(${x1 + 7}, ${branchY - 12})`} style={{ cursor: "pointer" }}>
                    <circle r="7" fill="#fff" stroke={PM_RISK_COLOR} strokeWidth="1.4" />
                    <text y="3" textAnchor="middle" fontSize="9" fontWeight="800" fill={PM_RISK_COLOR}>!</text>
                  </g>
                )}
              </g>
              {subtasks.map(({ sub, depth }) => {
                // Une sous-tâche part TOUJOURS du cercle de fin de sa tâche, jamais de la
                // ligne principale du projet — et rejoint sa propre date, passé ou futur.
                const subX = xFor(sub.end || t.end);
                const subY = mainY + side * depth; // profondeur absolue depuis la ligne principale
                return (
                  <g key={"sub-" + sub.id}>
                    <path d={branchPath(x1, branchY, subX, subY)} fill="none" stroke="var(--text-muted)" strokeWidth="1.6" strokeLinecap="round" opacity={sub.done ? 0.4 : 0.65} />
                    <g className="lp-pm-sub-drag" onMouseDown={(e) => startDragSubtask(e, t.id, sub.id, sub.end || t.end)} onTouchStart={(e) => startDragSubtask(e, t.id, sub.id, sub.end || t.end)} style={{ cursor: "ew-resize" }}>
                      <circle cx={subX} cy={subY} r="9" fill="transparent" />
                      <Station x={subX} y={subY} color="var(--text-muted)" r={3} done={sub.done} />
                    </g>
                  </g>
                );
              })}
            </g>
          );
        })}

        {!isCollapsed && items.filter((it) => it.isMilestone && !isFullyShared(it.t)).map(({ t, side, branchDist }) => {
          const branchY = mainY + side * branchDist;
          const mx = xFor(t.end);
          // Même bascule que pour les tâches normales : couleur du projet d'origine
          // du jalon quand la ligne fusionne plusieurs projets (dossier), sinon
          // couleur du statut comme d'habitude.
          const color2 = p.isFolderGroup
            ? (ctx.projects.find((pr) => pr.id === t.projectId)?.color || color)
            : (ctx.statuses.find((s) => s.id === t.statusId)?.color || color);
          const isCritical = !!criticalPathIds && criticalPathIds.has(t.id);
          return (
            <path key={"line-" + t.id} d={branchPath(mx, mainY, mx, branchY)} fill="none" stroke={isCritical ? PM_CRITICAL_COLOR : color2} strokeWidth={isCritical ? "3.5" : "2.5"} strokeLinecap="round" opacity={dimOpacity(t.id) * (isCritical ? 0.95 : 0.85)} strokeDasharray="1 5" onClick={() => onOpen(t)} style={{ cursor: "pointer" }} />
          );
        })}

        {!isCollapsed && items.filter((it) => it.isMilestone && !isFullyShared(it.t)).map(({ t, side, branchDist }) => {
          const branchY = mainY + side * branchDist;
          const mx = xFor(t.end);
          const titleW = pmMeasureText(t.title, MS_TITLE_FONT);
          const hasDescription = !!String(t.desc ?? t.description ?? "").trim();
          const noteX = mx + 17 + titleW + 6;
          const noteBadgeW = hasDescription ? 23 : 0;
          const dateX = mx + 14 + titleW + 6 + noteBadgeW;
          const isCritical = !!criticalPathIds && criticalPathIds.has(t.id);
          const msColor = isCritical ? PM_CRITICAL_COLOR : (ctx.statuses.find((s) => s.id === t.statusId)?.color || color);
          const done = isTaskDoneGlobal(t, ctx);
          const atRisk = showRiskBadges && !done && isAtRisk(t);
          return (
            <g key={"ms-" + t.id} opacity={dimOpacity(t.id)} onClick={(e) => { if (e.metaKey || e.ctrlKey || e.shiftKey) { e.stopPropagation(); toggleSelect(t.id); } }}>
              {/* Point de glisser : ne déclenche jamais l'ouverture de la fiche au clic —
                  glisser pour changer la date et cliquer pour ouvrir sont deux zones
                  distinctes, sinon relâcher après un glisser rouvrait la fiche aussitôt. */}
              <g onMouseDown={(e) => startDragTask(e, t, "end")} onTouchStart={(e) => startDragTask(e, t, "end")} style={{ cursor: "ew-resize" }} data-pm-task-id={t.id}>
                <circle cx={mx} cy={mainY} r="10" fill="transparent" />
                {atRisk && appearance?.animLateAlert && (
                  <circle cx={mx} cy={mainY} r={(isCritical ? 6 : 5) + 1.5} fill="none" stroke={PM_RISK_COLOR} strokeWidth="2" className="lp-pm-late-ring" />
                )}
                <Station x={mx} y={mainY} color={msColor} r={isCritical ? 6 : 5} />
                {(selectedIds.has(t.id) || focusedId === t.id) && (
                  <circle cx={mx} cy={mainY} r="10" fill="none" stroke={selectedIds.has(t.id) ? "var(--signal)" : "var(--text-muted)"} strokeWidth="2" strokeDasharray={selectedIds.has(t.id) ? "0" : "2 2"} />
                )}
                {atRisk && (
                  <g transform={`translate(${mx + 8}, ${mainY - 13})`}>
                    <circle r="7" fill="#fff" stroke={PM_RISK_COLOR} strokeWidth="1.4" />
                    <text y="3" textAnchor="middle" fontSize="9" fontWeight="800" fill={PM_RISK_COLOR}>!</text>
                  </g>
                )}
              </g>
              <foreignObject x={mx - 8} y={branchY - 8} width="16" height="16" style={{ overflow: "visible", cursor: "pointer" }} onClick={() => onOpen(t)}>
                <MilestoneGlyph size={16} icon={resolveMilestoneIcon(t, ctx)} />
              </foreignObject>
              <rect x={mx + 11} y={branchY - 9} width={titleW + 13} height={18} rx="2.5" fill="var(--surface)" opacity="0.99" style={{ cursor: "pointer" }} onClick={() => onOpen(t)} />
              <text x={mx + 17} y={branchY} dominantBaseline="middle" textAnchor="start" fontSize="9.5" fontWeight="700" fill="var(--text-900)" style={{ cursor: "pointer" }} onClick={() => onOpen(t)}>{t.title}</text>
              {hasDescription && (
                <g
                  className="lp-pm-note-trigger"
                  transform={`translate(${noteX}, ${branchY - 8})`}
                  onClick={(e)=>{
                    e.stopPropagation();
                    setDescriptionPopup({task:t,x:e.clientX,y:e.clientY});
                  }}
                  style={{cursor:"pointer"}}
                >
                  <title>Afficher la description</title>
                  <rect x="0" y="0" width="17" height="16" rx="4" fill="var(--surface)" stroke="var(--border)" strokeWidth="1"/>
                  <path d="M4.5 4.5h8M4.5 7.5h8M4.5 10.5h5.5" fill="none" stroke="var(--text-600)" strokeWidth="1.25" strokeLinecap="round"/>
                  <path d="M11.2 1.9v2.7h2.7" fill="none" stroke="var(--text-600)" strokeWidth="1.05" strokeLinecap="round" strokeLinejoin="round" opacity=".7"/>
                </g>
              )}
              {fields.includes("dates") && (
                <>
                  <rect x={dateX - 3} y={branchY - 6} width={pmMeasureText(fmtShort(t.end), MS_TITLE_FONT) + 6} height={12} fill="var(--surface)" />
                  <text x={dateX} y={branchY} dominantBaseline="middle" textAnchor="start" fontFamily="var(--font-mono)" fontSize="9" fontWeight="600" fill="var(--text-600)">{fmtShort(t.end)}</text>
                </>
              )}
            </g>
          );
        })}

        {!isCollapsed && items.filter((it) =>
          getTaskType(it.t) === "action" &&
          !isFullyShared(it.t) &&
          (!it.t.linkedActivityId || expandedActivities.has(it.t.linkedActivityId))
        ).map(({ t, side, branchDist, subtasks }) => {
          const branchY = mainY + side * branchDist;
          const x1 = xFor(t.end);
          const done = isTaskDoneGlobal(t, ctx);
          const chips = fieldChipsFor(t);
          const titleW = pmMeasureText(t.title, TITLE_FONT);
          // Tâche partagée avec un projet actuellement non affiché (repli — voir
          // isFullyShared) : petit repère à côté du titre pour ne pas perdre cette
          // information de partage juste parce que l'autre ligne n'est pas visible.
          const sharedOtherProject = t.secondaryProjectId
            ? ctx.projects.find((pr) => pr.id === (t.projectId === p.id ? t.secondaryProjectId : t.projectId))
            : null;
          const sharedBadgeW = sharedOtherProject ? 18 : 0;
          const hasDescription = !!String(t.desc ?? t.description ?? "").trim();
          const noteBadgeW = hasDescription ? 22 : 0;
          const noteX = x1 + 14 + titleW + 7;
          let cursorX = x1 + 14 + titleW + noteBadgeW + sharedBadgeW + 16;
          const taskColor = p.isFolderGroup
            ? (ctx.projects.find((pr) => pr.id === t.projectId)?.color || "var(--text-muted)")
            : ((ctx.statuses.find((s) => s.id === t.statusId) || {}).color || "var(--text-muted)");
          return (
            <g key={"txt-" + t.id} opacity={dimOpacity(t.id)}>
              {/* Doublon purement visuel de la station, garanti au-dessus de toute ligne
                  (une bulle ne doit jamais être masquée, même partiellement) — mais ne doit
                  surtout pas intercepter les clics/glisser destinés à la vraie station
                  interactive juste en dessous, sous peine de rendre le glisser impossible. */}
              <g style={{ pointerEvents: "none" }}>
                <Station x={x1} y={branchY} color={taskColor} r={5.5} done={done} icon={p.metroTaskIcons ? resolveMilestoneIcon(t, ctx) : null} justCompleted={justCompletedIds.has(t.id)} />
              </g>
              <rect x={x1 + 10} y={branchY - 9} width={titleW + 12} height={18} rx="2.5" fill="var(--surface)" opacity="0.99" />
              <text x={x1 + 14} y={branchY} dominantBaseline="middle" textAnchor="start" fontSize="10.5" fontWeight="700" fontFamily="Inter, sans-serif" fill="var(--text-900)" opacity={done ? 0.55 : 1} onClick={() => onOpen(t)} className="lp-pm-task">{t.title}</text>
              {hasDescription && (
                <g
                  className="lp-pm-note-trigger"
                  transform={`translate(${noteX}, ${branchY - 8})`}
                  onClick={(e) => {
                    e.stopPropagation();
                    setDescriptionPopup({
                      task:t,
                      x:e.clientX,
                      y:e.clientY
                    });
                  }}
                  style={{cursor:"pointer"}}
                >
                  <title>Afficher la description</title>
                  <rect x="0" y="0" width="17" height="16" rx="4" fill="var(--surface)" stroke="var(--border)" strokeWidth="1"/>
                  <path
                    d="M4.5 4.5h8M4.5 7.5h8M4.5 10.5h5.5"
                    fill="none"
                    stroke="var(--text-600)"
                    strokeWidth="1.25"
                    strokeLinecap="round"
                  />
                  <path
                    d="M11.2 1.9v2.7h2.7"
                    fill="none"
                    stroke="var(--text-600)"
                    strokeWidth="1.05"
                    strokeLinecap="round"
                    strokeLinejoin="round"
                    opacity=".7"
                  />
                </g>
              )}
              {sharedOtherProject && (
                <g
                  style={{ cursor: "pointer" }}
                  onClick={(e) => {
                    e.stopPropagation();
                    if ((e.ctrlKey || e.metaKey) && onToggleProject) onToggleProject(sharedOtherProject.id);
                    else if (onSelectProject) onSelectProject(sharedOtherProject.id);
                    else onOpen(t);
                  }}
                >
                  <title>Clic : voir {sharedOtherProject.name} seul · Ctrl/Cmd-clic : l'ajouter à la vue actuelle</title>
                  <circle cx={x1 + 14 + titleW + noteBadgeW + 14} cy={branchY} r="6" fill="#fff" stroke={sharedOtherProject.color || "var(--text-muted)"} strokeWidth="1.6" />
                  <path d={`M ${x1 + 14 + titleW + noteBadgeW + 11} ${branchY} L ${x1 + 14 + titleW + noteBadgeW + 17} ${branchY} M ${x1 + 14 + titleW + noteBadgeW + 15} ${branchY - 2} L ${x1 + 14 + titleW + noteBadgeW + 17} ${branchY} L ${x1 + 14 + titleW + noteBadgeW + 15} ${branchY + 2}`} stroke={sharedOtherProject.color || "var(--text-muted)"} strokeWidth="1.3" fill="none" strokeLinecap="round" strokeLinejoin="round" />
                </g>
              )}
              {chips.map((c, i) => {
                if (c.type === "progress") {
                  const barW = 46, barH = 8;
                  const chipX = cursorX;
                  cursorX += barW + 5;
                  const pct = Math.max(0, Math.min(100, c.task.progress || 0));
                  return (
                    <g key={i} onMouseDown={(e) => startDragProgress(e, c.task, chipX, barW)} style={{ cursor: "pointer" }}>
                      <rect x={chipX} y={branchY - barH / 2} width={barW} height={barH} rx={barH / 2} fill="var(--surface)" />
                      <rect x={chipX} y={branchY - barH / 2} width={barW} height={barH} rx={barH / 2} fill={c.color + "22"} />
                      <rect x={chipX} y={branchY - barH / 2} width={(barW * pct) / 100} height={barH} rx={barH / 2} fill={c.color} />
                    </g>
                  );
                }
                const w = pmMeasureText(c.text, CHIP_FONT) + 16;
                const chipX = cursorX;
                cursorX += w + 5;
                return (
                  <g key={i} onClick={() => onOpen(t)} style={{ cursor: "pointer" }}>
                    <rect x={chipX} y={branchY - 8} width={w} height={16} rx={8} fill="var(--surface)" />
                    <rect x={chipX} y={branchY - 8} width={w} height={16} rx={8} fill={c.color + "22"} />
                    <text x={chipX + w / 2} y={branchY} dominantBaseline="middle" textAnchor="middle" fontSize="8.5" fontWeight="700" fontFamily="Inter, sans-serif" fill={c.color}>{c.text}</text>
                  </g>
                );
              })}
              {subtasks.map(({ sub, depth }) => {
                const subX = xFor(sub.end || t.end);
                const subY = mainY + side * depth; // profondeur absolue depuis la ligne principale
                // Le texte part À GAUCHE de la bulle (jamais à droite) : la marge
                // (au-delà du rayon de la zone de clic invisible, r=9) garantit qu'il
                // ne la recouvre jamais, quelle que soit sa longueur.
                const subTitleW2 = pmMeasureText(truncateTitle(sub.text), SUB_TITLE_FONT);
                const subGap = 12;
                return (
                  <g key={"subtxt-" + sub.id}>
                    <g className="lp-pm-sub-drag" onMouseDown={(e) => startDragSubtask(e, t.id, sub.id, sub.end || t.end)} onTouchStart={(e) => startDragSubtask(e, t.id, sub.id, sub.end || t.end)} style={{ cursor: "ew-resize" }}>
                      <circle cx={subX} cy={subY} r="9" fill="transparent" />
                      <Station x={subX} y={subY} color="var(--text-muted)" r={3} done={sub.done} />
                    </g>
                    <rect x={subX - subGap - subTitleW2} y={subY - 6} width={subTitleW2 + 6} height={12} fill="var(--surface)" />
                    <text x={subX - subGap} y={subY} dominantBaseline="middle" textAnchor="end" fontSize="8" fontWeight="600" fontFamily="Inter, sans-serif" fill="var(--text-600)" opacity={sub.done ? 0.5 : 1} onClick={() => onOpen(t)} className="lp-pm-task">{truncateTitle(sub.text)}</text>
                  </g>
                );
              })}
            </g>
          );
        })}
        {!isCollapsed && (
          <g
            onClick={(e) => { e.stopPropagation(); setProjectSummary({ row, x: e.clientX, y: e.clientY }); }}
            style={{ cursor: "pointer" }}
          >
            {/* Terminus : butoir vectoriel (barre + demi-disque), pas d'emoji. */}
            <circle cx={xFor(maxDate) + 12} cy={mainY} r="14" fill="transparent" />
            <Terminus x={xFor(maxDate) + 6} y={mainY} color={color} />
            {appearance?.animConfetti && <ProjectConfetti x={xFor(maxDate) + 16} y={mainY} active={confettiProjectIds.has(p.id)} />}
          </g>
        )}
      </g>
    );
  };

  // Vue réseau : une ligne compacte par projet, uniquement les jalons (+ un
  // repère de fin de projet), tous alignés sur l'axe temporel commun déjà
  // calculé pour la vue complète — de quoi lire l'état de tous les projets
  // en quelques secondes, sans le détail tâche par tâche.
  const DeadlineRow = ({ row }) => {
    const p = row.project;
    const color = p.color || "var(--text-muted)";
    const statusColorFor = (task) => ctx.statuses.find((st) => st.id === task?.statusId)?.color || color;
    const groups = row.deadlineGroups || [];
    const laneY = row.mainY;
    const isCollapsed = collapsed[p.id];

    if (isCollapsed) {
      return (
        <g>
          {todayX !== null && (
            <line x1={todayX} y1={0} x2={todayX} y2={56} stroke="var(--accent)" strokeWidth="1.8" strokeDasharray="4 5" opacity=".62" />
          )}
          <line x1={xFor(row.minDate)} y1={28} x2={xFor(row.maxDate)} y2={28} stroke={color} strokeWidth="3.2" strokeLinecap="round" opacity=".16" />
          {groups.length > 0 && (
            <g>
              <line x1={xFor(row.minDate)} y1={28} x2={groups[0].x} y2={28} stroke={statusColorFor(groups[0].tasks[0])} strokeWidth="3.2" strokeLinecap="round" opacity=".95" />
              {groups.map((g,gi)=> {
                const next=groups[gi+1];
                if(!next) return null;
                return <line key={`collapsed-seg-${g.date}`} x1={g.x} y1={28} x2={next.x} y2={28} stroke={statusColorFor(g.tasks[0])} strokeWidth="3.2" strokeLinecap="round" opacity=".95"/>;
              })}
              <line x1={groups[groups.length-1].x} y1={28} x2={xFor(row.maxDate)} y2={28} stroke={statusColorFor(groups[groups.length-1].tasks[0])} strokeWidth="3.2" strokeLinecap="round" opacity=".95" />
            </g>
          )}
          {groups.map((g) => {
            const task = g.tasks.find((x) => isTaskLate(x, ctx)) || g.tasks[0];
            const sc = statusColorFor(task);
            const done = isTaskDoneGlobal(task, ctx);
            const collapsedAtRisk = !!task && isTaskLate(task, ctx) && !done;
            return (
              <g key={g.date}>
                {collapsedAtRisk && appearance?.animLateAlert && (
                  <circle
                    cx={g.x}
                    cy={28}
                    r="7"
                    fill="none"
                    stroke={PM_RISK_COLOR}
                    strokeWidth="2"
                    className="lp-pm-late-ring"
                    pointerEvents="none"
                  />
                )}
                <ProjectDeadlineStationGlyph
                  x={g.x}
                  y={28}
                  project={p}
                  task={task}
                  ctx={ctx}
                  color={sc}
                  done={done}
                  radius={6}
                  iconSize={8}
                />
              </g>
            );
          })}
        </g>
      );
    }

    // Connecte deux dates successives. Toutes les branches du jour A convergent
    // vers un nœud virtuel au milieu, puis divergent vers toutes les branches du
    // jour B. Cela produit visuellement :
    // 1 -> N : divergence
    // N -> 1 : convergence
    // N -> M : convergence puis nouvelle divergence
    const transitionPaths = [];
    for (let gi = 0; gi < groups.length - 1; gi++) {
      const a = groups[gi], b = groups[gi + 1];
      const hubX = (a.x + b.x) / 2;
      const bend = Math.min(12, Math.max(5, (b.x - a.x) / 8));

      a.offsets.forEach((off, i) => {
        const y = laneY + off;
        const d = Math.abs(y - laneY) < .5
          ? `M ${a.x} ${y} L ${hubX} ${laneY}`
          : `M ${a.x} ${y} L ${hubX - bend} ${y} Q ${hubX} ${y} ${hubX} ${y + Math.sign(laneY-y)*bend} L ${hubX} ${laneY}`;
        transitionPaths.push(<path key={`in-${gi}-${i}`} d={d} fill="none" stroke={statusColorFor(a.tasks[Math.min(i,a.tasks.length-1)])} strokeWidth="2.2" strokeLinecap="round" opacity=".78" />);
      });

      b.offsets.forEach((off, i) => {
        const y = laneY + off;
        const d = Math.abs(y - laneY) < .5
          ? `M ${hubX} ${laneY} L ${b.x} ${y}`
          : `M ${hubX} ${laneY} L ${hubX} ${y - Math.sign(y-laneY)*bend} Q ${hubX} ${y} ${hubX + bend} ${y} L ${b.x} ${y}`;
        transitionPaths.push(<path key={`out-${gi}-${i}`} d={d} fill="none" stroke={statusColorFor(b.tasks[Math.min(i,b.tasks.length-1)])} strokeWidth="2.2" strokeLinecap="round" opacity=".78" />);
      });

      transitionPaths.push(
        <circle key={`hub-${gi}`} cx={hubX} cy={laneY} r="2.5" fill={color} opacity=".58" />
      );
    }

    return (
      <g>
        {/* Aujourd'hui : repère temporel vertical continu dans chaque ligne.
            Le libellé n'est affiché que sur le premier projet pour éviter la répétition. */}
        {todayX !== null && (
          <g pointerEvents="none">
            <line
              x1={todayX} y1={0} x2={todayX} y2={row.ROW_H}
              stroke="var(--accent)"
              strokeWidth="1.8"
              strokeDasharray="4 5"
              opacity=".62"
            />
            {rowsWithHeights[0]?.project?.id === p.id && (
              <>
                <rect x={todayX - 31} y={5} width="62" height="16" rx="3" fill="var(--surface)" opacity=".96" />
                <text
                  x={todayX} y={16}
                  textAnchor="middle"
                  fontFamily='"Inter", monospace'
                  fontSize="7.5"
                  fontWeight="800"
                  fill="var(--accent)"
                >
                  AUJOURD'HUI
                </text>
              </>
            )}
          </g>
        )}
        {/* Ligne projet : infrastructure temporelle de référence */}
        <line x1={xFor(row.minDate)} y1={laneY} x2={xFor(row.maxDate)} y2={laneY} stroke={color} strokeWidth="3.4" strokeLinecap="round" opacity=".16" />
        {groups.length > 0 && (
          <g>
            <line x1={xFor(row.minDate)} y1={laneY} x2={groups[0].x} y2={laneY} stroke={statusColorFor(groups[0].tasks[0])} strokeWidth="3.4" strokeLinecap="round" opacity=".95"/>
            {groups.map((g,gi)=>{
              const next=groups[gi+1];
              if(!next) return null;
              return <line key={`status-main-${g.date}`} x1={g.x} y1={laneY} x2={next.x} y2={laneY} stroke={statusColorFor(g.tasks[0])} strokeWidth="3.4" strokeLinecap="round" opacity=".95"/>;
            })}
            <line x1={groups[groups.length-1].x} y1={laneY} x2={xFor(row.maxDate)} y2={laneY} stroke={statusColorFor(groups[groups.length-1].tasks[0])} strokeWidth="3.4" strokeLinecap="round" opacity=".95"/>
          </g>
        )}
        {transitionPaths}

        {groups.map((g, gi) => g.tasks.map((t, i) => {
          const y = laneY + g.offsets[i];
          const st = ctx.statuses.find((s) => s.id === t.statusId);
          const done = isTaskDoneGlobal(t, ctx);
          const atRisk = showRiskBadges && !done && isAtRisk(t);
          const stationColor = st?.color || color; // la couleur reflète désormais le statut de la tâche
          const placement = g.placements?.[i] || {
            side:(i % 2 ? "below" : "above"),
            lane:0,
            titleW:120,
            labelX:g.x,
            displayTitle:String(t.title || ""),
            titleTopRel:(i % 2 ? 28 : -56),
          };
          const labelAbove = placement.side === "above";
          const titleW = Math.min(190, Math.max(64, placement.titleW || 120));
          const textX = placement.labelX ?? g.x;
          const titleRectY = laneY + (placement.titleTopRel ?? 0);
          const titleTextY = titleRectY + 11;
          const metaRectY = titleRectY + 16;
          const metaTextY = metaRectY + 10;

          return (
            <g
              key={t.id}
              opacity={dimOpacity(t.id)}
              onMouseDown={(e) => startDragTask(e, t, "deadlineEnd")}
              onTouchStart={(e) => startDragTask(e, t, "deadlineEnd")}
              style={{ cursor:"ew-resize" }}
              data-pm-task-id={t.id}
            >
              {/* Branche de la station depuis la ligne principale */}
              {Math.abs(g.offsets[i]) > .5 && (
                <line x1={g.x} y1={laneY} x2={g.x} y2={y} stroke={stationColor} strokeWidth="1.6" strokeDasharray="2 3" opacity=".30" />
              )}

              {/* Connecteur d'étiquette routé sur une voie dédiée :
                  segments orthogonaux, sans diagonales qui se croisent. */}
              <path
                d={(placement.connectorSegments || []).map((seg, si) =>
                  `${si === 0 ? "M" : "L"} ${si === 0 ? seg.x1 : seg.x2} ${si === 0 ? seg.y1 : seg.y2}`
                ).join(" ")}
                transform={`translate(0 ${laneY})`}
                fill="none"
                stroke={stationColor}
                strokeWidth="1.5"
                strokeLinecap="round"
                strokeLinejoin="round"
                opacity=".38"
                pointerEvents="none"
              />

              <circle cx={g.x} cy={y} r="15" fill="transparent" />
              {atRisk && appearance?.animLateAlert && (
                <circle
                  cx={g.x}
                  cy={y}
                  r="9.5"
                  fill="none"
                  stroke={PM_RISK_COLOR}
                  strokeWidth="2"
                  className="lp-pm-late-ring"
                  pointerEvents="none"
                />
              )}

              <ProjectDeadlineStationGlyph
                x={g.x}
                y={y}
                project={p}
                task={t}
                ctx={ctx}
                color={stationColor}
                done={done}
                radius={8.5}
                iconSize={11}
              />

              {atRisk && (
                <circle
                  cx={g.x}
                  cy={y}
                  r="12"
                  fill="none"
                  stroke={PM_RISK_COLOR}
                  strokeWidth="1.4"
                  strokeDasharray="2 2"
                  pointerEvents="none"
                />
              )}

              {/* Étiquette sur sa propre voie : fond opaque + largeur plafonnée */}
              <rect
                x={textX - titleW/2 - 6}
                y={titleRectY}
                width={titleW + 12}
                height="15"
                rx="3"
                fill="var(--surface)"
                opacity=".985"
              />
              <text
                x={textX}
                y={titleTextY}
                textAnchor="middle"
                fontFamily="Inter, sans-serif"
                fontSize="10"
                fontWeight="700"
                fill="var(--text-900)"
              >
                {placement.displayTitle || (String(t.title || "").length > 30 ? String(t.title).slice(0,29) + "…" : t.title)}
              </text>

              <rect
                x={textX - 43}
                y={metaRectY}
                width="86"
                height="13"
                rx="3"
                fill="var(--surface)"
                opacity=".97"
              />
              <text
                x={textX}
                y={metaTextY}
                textAnchor="middle"
                fontFamily='"Inter", monospace'
                fontSize="7.6"
                fontWeight="700"
                fill={stationColor}
              >
                {fmtShort(t.end)}
              </text>

              <title>{`${t.title} — ${fmtShort(t.end)}${st ? ` — ${st.name}` : ""} — Glisser horizontalement pour modifier l’échéance`}</title>
            </g>
          );
        }))}

        {groups.length > 0 && (
          <>
            <Station x={xFor(row.minDate)} y={laneY} color={color} r={5.5} />
            <Terminus x={xFor(row.maxDate) + 7} y={laneY} color={color} size={.8} />
          </>
        )}
      </g>
    );
  };

  const NetworkRow = ({ row }) => {
    const { project: p, pMilestones, maxDate, avgProgress } = row;
    const color = p.color || "var(--text-muted)";
    const laneY = 30;
    return (
      <g opacity={dimOpacity("net-" + p.id)}>
        <line x1={xFor(row.minDate)} y1={laneY} x2={xFor(maxDate)} y2={laneY} stroke={color} strokeWidth="3" strokeLinecap="round" opacity="0.55" />
        <line x1={xFor(row.minDate)} y1={laneY} x2={xFor(row.minDate) + (xFor(maxDate) - xFor(row.minDate)) * (avgProgress / 100)} y2={laneY} stroke={color} strokeWidth="3" strokeLinecap="round" />
        <Station x={xFor(row.minDate)} y={laneY} color={color} r={6} />
        {pMilestones.map((t) => {
          const mx = xFor(t.end);
          const done = isTaskDoneGlobal(t, ctx);
          const isCritical = !!criticalPathIds && criticalPathIds.has(t.id);
          const atRisk = showRiskBadges && !done && isAtRisk(t);
          return (
            <g key={t.id} onClick={() => onOpen(t)} style={{ cursor: "pointer" }}>
              <foreignObject x={mx - 8} y={laneY - 8} width="16" height="16" style={{ overflow: "visible" }}>
                <MilestoneGlyph size={16} icon={resolveMilestoneIcon(t, ctx)} />
              </foreignObject>
              {isCritical && <circle cx={mx} cy={laneY} r="10" fill="none" stroke={PM_CRITICAL_COLOR} strokeWidth="1.6" />}
              {atRisk && (
                <g transform={`translate(${mx + 8}, ${laneY - 13})`}>
                  <circle r="7" fill="#fff" stroke={PM_RISK_COLOR} strokeWidth="1.4" />
                  <text y="3" textAnchor="middle" fontSize="9" fontWeight="800" fill={PM_RISK_COLOR}>!</text>
                </g>
              )}
            </g>
          );
        })}
        <g onClick={(e) => { e.stopPropagation(); setProjectSummary({ row, x: e.clientX, y: e.clientY }); }} style={{ cursor: "pointer" }}>
          <circle cx={xFor(maxDate) + 12} cy={laneY} r="14" fill="transparent" />
          <Terminus x={xFor(maxDate) + 6} y={laneY} color={color} size={0.85} />
        </g>
      </g>
    );
  };

  const now = iso(new Date());
  // Les widgets de synthèse de l'accueil doivent refléter l'état RÉEL global, pas
  // le sous-ensemble déjà filtré par la vue (ex. "Masquer les tâches terminées",
  // filtre projet actif…) — sinon "Avancement global" peut afficher 0% juste parce
  // que les tâches terminées sont masquées par défaut. On repart donc de
  // ctx.tasks (liste complète, non filtrée) plutôt que de "dated"/"tasks".
  const homeDated = useMemo(() => ((embedded || !isHomepage) ? [] : (ctx.tasks || []).filter((t) => t.start && t.end)), [ctx.tasks, embedded, isHomepage]);
  const lateTasks = useMemo(() => ((embedded || !isHomepage) ? [] : homeDated.filter((t) => isTaskLate(t, ctx)).sort((a, b) => a.end.localeCompare(b.end)).slice(0, 4)), [homeDated, ctx, embedded, isHomepage]);
  const upcomingTasks = useMemo(() => ((embedded || !isHomepage) ? [] : homeDated.filter((t) => !isTaskDoneGlobal(t, ctx) && t.end >= now).sort((a, b) => a.end.localeCompare(b.end)).slice(0, 4)), [homeDated, ctx, embedded, isHomepage, now]);
  const homeStats = useMemo(() => {
    if (embedded || !isHomepage || homeDated.length === 0) return null;
    const doneCount = homeDated.filter((t) => isTaskDoneGlobal(t, ctx)).length;
    const byStatus = {};
    homeDated.forEach((t) => {
      const st = ctx.statuses.find((s) => s.id === t.statusId);
      const key = st?.name || "Sans statut";
      byStatus[key] = byStatus[key] || { count: 0, color: st?.color || "var(--text-muted)" };
      byStatus[key].count++;
    });
    return {
      avgProgress: Math.round((doneCount / homeDated.length) * 100),
      byStatus: Object.entries(byStatus).map(([name, v]) => ({ name, ...v })).sort((a, b) => b.count - a.count),
      total: homeDated.length,
      activeProjects: new Set(homeDated.map((t) => t.projectId)).size,
      lateCount: homeDated.filter((t) => isTaskLate(t, ctx)).length,
    };
  }, [dated, ctx, embedded]);
  const firstName = (ctx.myName || "").split(" ")[0] || "";

  return (
    <>
      {!embedded && isHomepage && homeStats && (
        <div className="lp-metro-home-greet">
          <div>
            <h2 className="lp-display" style={{ fontSize: 22, margin: "0 0 4px" }}>Bonjour{firstName ? `, ${firstName}` : ""} 👋</h2>
            <p style={{ margin: 0, fontSize: 13, color: "var(--text-600)", fontWeight: 500 }}>
              {homeStats.activeProjects} projet{homeStats.activeProjects > 1 ? "s" : ""} actif{homeStats.activeProjects > 1 ? "s" : ""}
              {homeStats.lateCount > 0 ? ` · ${homeStats.lateCount} tâche${homeStats.lateCount > 1 ? "s" : ""} en retard` : " · aucun retard"}
              {upcomingTasks[0] ? ` · prochaine échéance le ${fmtShort(upcomingTasks[0].end)}` : ""}
            </p>
          </div>
        </div>
      )}
      <div className="lp-pm-wrap lp-pm-quai" ref={pmChromeRef}>
      <ViewToolbarPortal slot={toolbarSlot}>
        <DropdownButton label="" icon={<Maximize2 size={14} />} title={`Zoom : ${isAuto ? "Automatique" : zoomDef.label}`}>
          <label className="lp-checkbox-line"><input type="radio" name="lp-pm-zoom" checked={zoomKey === "auto"} onChange={() => setZoomKey("auto")} /> Automatique (pleine largeur)</label>
          <hr className="lp-divider" style={{ margin: "6px 0" }} />
          {PROJECT_METRO_ZOOMS.map((z) => (
            <label className="lp-checkbox-line" key={z.key}><input type="radio" name="lp-pm-zoom" checked={zoomKey === z.key} onChange={() => setZoomKey(z.key)} /> {z.label}</label>
          ))}
        </DropdownButton>
        <DropdownButton label="" icon={<Layers size={14} />} title={`Grouper par : ${metroGroupBy === "folder" ? "Dossier" : "Projet"}`}>
          <label className="lp-checkbox-line"><input type="radio" name="lp-pm-groupby" checked={metroGroupBy === "project"} onChange={() => setMetroGroupBy("project")} /> Projet (une ligne par projet)</label>
          <label className="lp-checkbox-line"><input type="radio" name="lp-pm-groupby" checked={metroGroupBy === "folder"} onChange={() => setMetroGroupBy("folder")} /> Dossier (fusionne les projets d'un même dossier)</label>
        </DropdownButton>
        <button className={"lp-tool-btn" + (leftCollapsed ? " active" : "")} onClick={() => setPrefs((p) => ({ ...p, leftCollapsed: !leftCollapsed }))} title={leftCollapsed ? "Afficher la colonne projet" : "Replier la colonne projet (plus de place pour le diagramme)"}>
          <PanelLeftClose size={14} />
        </button>
        {!embedded && (
          <button className={"lp-tool-btn" + (isAuto ? " active" : "")} onClick={() => setZoomKey("auto")} title="Zoom automatique : utilise toute la largeur disponible">
            <Maximize2 size={14} />
          </button>
        )}
        {!embedded && (
          <button className="lp-tool-btn" onClick={resetZoom} title="Réinitialiser le zoom">
            <RefreshCw size={14} />
          </button>
        )}
        <DropdownButton label="" icon={<Bookmark size={14} />} title="Annotations : blocs temporels, encadrés, jalons, annotations">
          <div className="lp-dropdown-group-label">Annotations</div>
          <button type="button" className="lp-dropdown-action-row" onClick={() => setAnnotationPanel({ section: "blocks", autoCreate: "block" })}><Layers size={13} /> Ajouter un bloc temporel</button>
          <button type="button" className="lp-dropdown-action-row" onClick={() => setAnnotationPanel({ section: "frames", autoCreate: "frame" })}><Crosshair size={13} /> Ajouter un encadré</button>
          <button type="button" className="lp-dropdown-action-row" onClick={() => setAnnotationPanel({ section: "milestones", autoCreate: "milestone" })}><Milestone size={13} /> Ajouter un jalon</button>
          <button type="button" className="lp-dropdown-action-row" onClick={() => setAnnotationPanel({ section: "notes", autoCreate: "note" })}><StickyNote size={13} /> Ajouter une annotation</button>
          <hr className="lp-divider" style={{ margin: "6px 0" }} />
          <button type="button" className="lp-dropdown-action-row" onClick={() => setAnnotationPanel({ section: "blocks" })}><SlidersHorizontal size={13} /> Tout gérer…</button>
        </DropdownButton>
        {!embedded && (
          <DropdownButton label="" icon={<Columns3 size={14} />} title="Champs affichés sur les tâches">
            {PM_FIELD_OPTIONS.map((f) => (
              <label className="lp-checkbox-line" key={f.key}>
                <input type="checkbox" checked={fields.includes(f.key)} onChange={() => setFields((prev) => (prev.includes(f.key) ? prev.filter((x) => x !== f.key) : [...prev, f.key]))} />
                {f.label}
              </label>
            ))}
          </DropdownButton>
        )}
        {!embedded && (
          <button className="lp-tool-btn" onClick={toggleAllCollapsed} title={allCollapsed ? "Tout déplier" : "Tout replier"}>
            {allCollapsed ? <ChevronsDown size={14} /> : <ChevronsUp size={14} />}
          </button>
        )}
        {!embedded && (
          <button className={"lp-tool-btn" + (showSubtasks ? " active" : "")} onClick={() => setPrefs({ showSubtasks: !showSubtasks })} title="Afficher les sous-tâches">
            <GripVertical size={14} />
          </button>
        )}
        {!embedded && (
          <button className={"lp-tool-btn" + (showCriticalPath ? " active" : "")} onClick={() => setShowCriticalPath((v) => !v)} title="Mettre en évidence le chemin critique">
            <Zap size={14} />
          </button>
        )}
        {!embedded && (
          <button className={"lp-tool-btn" + (showRiskBadges ? " active" : "")} onClick={() => setShowRiskBadges((v) => !v)} title="Afficher les alertes de retard">
            <AlertTriangle size={14} />
          </button>
        )}
        {!embedded && (
          <button className={"lp-tool-btn" + (networkMode ? " active" : "")} onClick={() => setPrefs((p) => {
              const next = !p.networkMode;
              return { ...p, networkMode:next, deadlineMode:next ? false : !!p.deadlineMode };
            })} title="Vue réseau : uniquement les jalons de tous les projets, sur un axe commun">
            <Network size={14} />
          </button>
        )}
        {!embedded && (
          <button
            className={"lp-tool-btn" + (deadlineMode ? " active" : "")}
            onClick={() => setPrefs((p) => {
              const next = !p.deadlineMode;
              return { ...p, deadlineMode:next, networkMode:next ? false : !!p.networkMode };
            })}
            title="Échéances : représenter toutes les dates de fin comme des stations de métro"
          >
            <CalendarClock size={14} /> Échéances
          </button>
        )}
        {!embedded && (
          <button className="lp-tool-btn" onClick={exportPoster} title="Exporter en image (affiche)">
            <Download size={14} />
          </button>
        )}
        {embedded && (
          <span className="lp-pm-search lp-pm-search-compact">
            <Search size={12} />
            <input type="text" value={searchQuery} onChange={(e) => setSearchQuery(e.target.value)} placeholder="Rechercher…" />
            {searchQuery && <button className="lp-pm-search-clear" onClick={() => setSearchQuery("")} title="Effacer"><X size={11} /></button>}
          </span>
        )}
        {embedded && (
          <DropdownButton label="" icon={<MoreHorizontal size={14} />} title="Plus d'options">
            <button type="button" className="lp-dropdown-action-row" onClick={() => setZoomKey("auto")}><Maximize2 size={13} /> Zoom automatique</button>
            <button type="button" className="lp-dropdown-action-row" onClick={resetZoom}><RefreshCw size={13} /> Réinitialiser le zoom</button>
            <hr className="lp-divider" style={{ margin: "6px 0" }} />
            <div className="lp-dropdown-group-label">Champs affichés</div>
            {PM_FIELD_OPTIONS.map((f) => (
              <label className="lp-checkbox-line" key={f.key}>
                <input type="checkbox" checked={fields.includes(f.key)} onChange={() => setFields((prev) => (prev.includes(f.key) ? prev.filter((x) => x !== f.key) : [...prev, f.key]))} />
                {f.label}
              </label>
            ))}
            <hr className="lp-divider" style={{ margin: "6px 0" }} />
            <label className="lp-checkbox-line"><input type="checkbox" checked={allCollapsed} onChange={toggleAllCollapsed} /> Tout replier</label>
            <label className="lp-checkbox-line"><input type="checkbox" checked={showSubtasks} onChange={() => setPrefs({ showSubtasks: !showSubtasks })} /> Afficher les sous-tâches</label>
            <label className="lp-checkbox-line"><input type="checkbox" checked={showCriticalPath} onChange={() => setShowCriticalPath((v) => !v)} /> Chemin critique en évidence</label>
            <label className="lp-checkbox-line"><input type="checkbox" checked={showRiskBadges} onChange={() => setShowRiskBadges((v) => !v)} /> Alertes de retard</label>
            <label className="lp-checkbox-line"><input type="checkbox" checked={networkMode} onChange={() => setNetworkMode((v) => !v)} /> Vue réseau (jalons uniquement)</label>
            <hr className="lp-divider" style={{ margin: "6px 0" }} />
            <button type="button" className="lp-dropdown-action-row" onClick={exportPoster}><Download size={13} /> Exporter en image</button>
          </DropdownButton>
        )}
      </ViewToolbarPortal>

      {!embedded && <div className="lp-pm-header-row">
        <h2>Planning Projets</h2>
        <span className="lp-pm-header-sub">Vue d'ensemble des projets et de leurs tâches</span>
        <span className="lp-pm-header-sep">·</span>
        <span className="lp-pm-legend-inline"><span className="lp-pm-legend-line" /> Projet</span>
        <span className="lp-pm-legend-inline"><span className="lp-pm-legend-line" style={{ background: "var(--text-muted)", height: 3 }} /> Tâche (couleur = statut)</span>
        <span className="lp-pm-legend-inline"><svg width="16" height="14" viewBox="-2 -7 16 14"><Terminus x={0} y={0} color="var(--text-600)" size={0.75} /></svg> Fin de projet</span>
        <span className="lp-pm-legend-inline"><svg width="12" height="12" viewBox="0 0 12 12"><rect x="1.5" y="1.5" width="9" height="9" fill="var(--text-600)" transform="rotate(45 6 6)" /></svg> Jalon</span>
      </div>}

      <div className="lp-pm-sticky-axis-shell" aria-hidden="true">
        <div
          className="lp-pm-sticky-axis-inner"
          style={{ width: railLeftW + chartWidth, transform: `translateX(${-pmScrollLeft}px)` }}
        >
          <div className="lp-pm-top-axis" style={{ marginLeft: railLeftW, width: chartWidth }}>
            {(() => {
              const topUnit = dayWidth < 1.5 ? null : "month";
              if (!topUnit) return null;
              const arr = [];
              let cur = unitStart(globalMin, topUnit);
              let guard = 0;
              while (dayIndex(cur) <= dayIndex(globalMax) && guard < 200) {
                const d = new Date(cur + "T00:00:00");
                arr.push({ start: cur, label: `${unitLabel(cur, "month")}${minYear !== maxYear ? " " + d.getFullYear() : ""}` });
                cur = addDays(cur, unitLen(cur, "month"));
                guard++;
              }
              return arr.map((tk, i) => <div key={i} className="lp-pm-top-tick" style={{ left: xFor(tk.start) }}>{tk.label}</div>);
            })()}
          </div>
          <div className="lp-pm-axis" style={{ marginLeft: railLeftW, width: chartWidth }}>
            {(() => {
              const unit = dayWidth < 1.5 ? "year" : dayWidth < 5 ? "month" : dayWidth < 15 ? "week" : "day";
              const arr = [];
              let cur = unitStart(globalMin, unit);
              let guard = 0;
              while (dayIndex(cur) <= dayIndex(globalMax) && guard < 400) {
                const d = new Date(cur + "T00:00:00");
                const showYear = minYear !== maxYear && (unit === "month" || unit === "week" || unit === "day") && d.getMonth() === 0;
                arr.push({ start: cur, label: unitLabel(cur, unit) + (showYear ? ` ${d.getFullYear()}` : "") });
                cur = addDays(cur, unitLen(cur, unit));
                guard++;
              }
              return arr.map((tk, i) => <div key={i} className="lp-pm-axis-tick" style={{ left: xFor(tk.start) }}>{tk.label}</div>);
            })()}
            {minYear !== maxYear && <div className="lp-pm-axis-year-badge">{minYear} → {maxYear}</div>}
          </div>
        </div>
      </div>

      <div className="lp-pm-scroll" ref={scrollRef} style={{ overflowX: isAuto ? "hidden" : "auto" }}>
        <div style={{ minWidth: railLeftW + chartWidth, position: "relative" }}>
          <div className="lp-pm-top-axis lp-pm-original-axis" style={{ marginLeft: railLeftW, width: chartWidth }}>
            {(() => {
              const topUnit = dayWidth < 1.5 ? null : "month";
              if (!topUnit) return null;
              const arr = [];
              let cur = unitStart(globalMin, topUnit);
              let guard = 0;
              while (dayIndex(cur) <= dayIndex(globalMax) && guard < 200) {
                const d = new Date(cur + "T00:00:00");
                arr.push({ start: cur, label: `${unitLabel(cur, "month")}${minYear !== maxYear ? " " + d.getFullYear() : ""}` });
                cur = addDays(cur, unitLen(cur, "month"));
                guard++;
              }
              return arr.map((tk, i) => <div key={i} className="lp-pm-top-tick" style={{ left: xFor(tk.start) }}>{tk.label}</div>);
            })()}
          </div>
          <div className="lp-pm-axis lp-pm-original-axis" style={{ marginLeft: railLeftW, width: chartWidth }}>
            {(() => {
              const unit = dayWidth < 1.5 ? "year" : dayWidth < 5 ? "month" : dayWidth < 15 ? "week" : "day";
              const arr = [];
              let cur = unitStart(globalMin, unit);
              let guard = 0;
              while (dayIndex(cur) <= dayIndex(globalMax) && guard < 400) {
                const d = new Date(cur + "T00:00:00");
                const showYear = minYear !== maxYear && (unit === "month" || unit === "week" || unit === "day") && d.getMonth() === 0;
                arr.push({ start: cur, label: unitLabel(cur, unit) + (showYear ? ` ${d.getFullYear()}` : "") });
                cur = addDays(cur, unitLen(cur, unit));
                guard++;
              }
              return arr.map((tk, i) => <div key={i} className="lp-pm-axis-tick" style={{ left: xFor(tk.start) }}>{tk.label}</div>);
            })()}
            {minYear !== maxYear && (
              <div className="lp-pm-axis-year-badge">{minYear} → {maxYear}</div>
            )}
          </div>

          {deadlineMode && (
            <div style={{
              position:"absolute", top:7, right:12, zIndex:8,
              display:"flex", alignItems:"center", gap:6,
              padding:"4px 7px", border:"1px solid var(--border)",
              background:"var(--surface)", borderRadius:"var(--radius-sm)",
              fontFamily:"var(--font-mono)", fontSize:8.5, fontWeight:800,
              color:"var(--text-secondary)"
            }}>
              <CalendarClock size={11} /> MODE ÉCHÉANCES · glisser une station = modifier la fin
            </div>
          )}
          <div className="lp-pm-bands" style={{ left: railLeftW, width: chartWidth, height: totalChartHeight }}>
            {monthBands.map((b, i) => (
              <div key={i} className="lp-pm-band" style={{ left: b.x0, width: Math.max(0, b.x1 - b.x0), background: accent }} />
            ))}
            {weekendBands.map((b, i) => (
              <div key={"we-" + i} className="lp-pm-weekend-band" style={{ left: b.x0, width: Math.max(0, b.x1 - b.x0) }} />
            ))}
            {/* Blocs temporels : une bande continue sur toute la hauteur utile,
                derrière les lignes de projet comme derrière les tâches. */}
            {temporalBlockShapes.map((shape) => (
              <div
                key={shape.block.id}
                className="lp-pm-tblock"
                style={{
                  left: shape.x0,
                  width: shape.width,
                  background: ganttBlockFill(shape.block),
                  border: ganttBlockBorder(shape.block),
                }}
              />
            ))}
          </div>

          {/* Flèches de dépendance INTER-projets, superposées à toutes les lignes.
              Passe AU-DESSUS des lignes de projet (z-index supérieur à .lp-pm-row) pour
              ne jamais rester invisible sous leur tronc — seul le texte des tâches, qui
              porte son propre halo blanc, peut éventuellement passer par-dessus. */}
          <svg
            className="lp-pm-cross-arrows"
            style={{ position: "absolute", left: LEFT_W, top: 0, width: chartWidth, height: totalChartHeight, pointerEvents: "none", zIndex: 2 }}
          >
            <defs>
              {/* placeholders — chaque flèche définit son propre dégradé/marqueur ci-dessous */}
            </defs>
            {!deadlineMode && dated.filter((t) => t.dependsOn && t.dependsOn.length).flatMap((t) =>
              t.dependsOn.map((depId) => {
                const depTask = dated.find((x) => x.id === depId);
                if (!depTask || depTask.projectId === t.projectId) return null; // intra-projet déjà géré localement
                const from = crossPositionsRef.current[depId];
                // Repli sur la position de fin si la tâche n'a pas de marqueur de début
                // séparé (jalon) — sinon, arrive bien sur le DÉBUT de la tâche suivante.
                const to = crossStartPositionsRef.current[t.id] || crossPositionsRef.current[t.id];
                if (!from || !to) return null;
                const fx = from.x - LEFT_W + 6, fy = from.y, tx = to.x - LEFT_W, ty = to.y;
                const laneX = dependencyLaneX(fx, fy, tx - 4, ty, depId, t.id);
                const bend = Math.min(10, Math.abs(ty - fy) / 2 || 8);
                const dir = ty > fy ? 1 : -1;
                const endX = tx - 4;
                // Routage orthogonal "plan de métro" :
                // 1) on sort à gauche de la station prédécesseure (jamais sous son titre),
                // 2) on descend/remonte dans une voie verticale vérifiée sans texte,
                // 3) on rejoint la tâche suivante par la gauche (son titre est à droite).
                const d = Math.abs(ty - fy) < 1
                  ? `M ${fx} ${fy} L ${endX} ${ty}`
                  : `M ${fx} ${fy} L ${laneX + bend} ${fy} Q ${laneX} ${fy} ${laneX} ${fy + dir * bend} L ${laneX} ${ty - dir * bend} Q ${laneX} ${ty} ${laneX + bend} ${ty} L ${endX} ${ty}`;
                const gradId = `pm-cross-grad-${depId}-${t.id}`;
                return (
                  <React.Fragment key={depId + "-" + t.id}>
                    <defs>
                      <linearGradient id={gradId} gradientUnits="userSpaceOnUse" x1={fx} y1={fy} x2={tx} y2={ty}>
                        <stop offset="0%" stopColor={accent} stopOpacity="0.45" />
                        <stop offset="100%" stopColor={accent} />
                      </linearGradient>
                    </defs>
                    {/* Contour blanc en dessous pour garantir le contraste sur n'importe
                        quel fond (troncs colorés, bandes de mois/week-end...) — sans lui,
                        le trait fin se perdait complètement en longeant les bords des
                        lignes de projet, rendant la dépendance invisible en pratique. */}
                    <path d={d} fill="none" stroke="#fff" strokeWidth="4.5" strokeLinecap="round" opacity="0.9" />
                    <path d={d} fill="none" stroke={`url(#${gradId})`} strokeWidth="2.4" strokeDasharray="5 4" opacity="0.95" strokeLinecap="round" />
                    {/* Station de correspondance façon plan de métro : cercles imbriqués aux
                        deux extrémités, pour renforcer la métaphore d'un changement de ligne
                        plutôt qu'une simple flèche technique. */}
                    <circle cx={fx} cy={fy} r="5.5" fill="#fff" stroke={accent} strokeWidth="1.6" />
                    <circle cx={fx} cy={fy} r="2" fill={accent} />
                    <circle cx={tx - 4} cy={ty} r="6.5" fill="#fff" stroke={accent} strokeWidth="1.8" />
                    <circle cx={tx - 4} cy={ty} r="6.5" fill="none" stroke="#fff" strokeWidth="1" strokeDasharray="0" />
                    <circle cx={tx - 4} cy={ty} r="2.3" fill={accent} />
                  </React.Fragment>
                );
              })
            )}

            {/* Tâches à deux projets : convergence des deux lignes vers un tronc commun
                (couleurs alternées sur UN seul trait), pour la durée de la tâche partagée,
                puis divergence de retour vers chaque ligne de projet. Repli automatique :
                si l'un des deux projets n'est pas dans le périmètre actuel, la tâche est
                déjà rendue normalement par sa propre ligne (voir isFullyShared plus haut) —
                ce bloc ne dessine QUE le cas où les deux lignes sont bien visibles. */}
            {!networkMode && !deadlineMode && dated.filter((t) => isFullyShared(t)).map((t) => {
              const p1 = ctx.projects.find((pr) => pr.id === t.projectId);
              const p2 = ctx.projects.find((pr) => pr.id === t.secondaryProjectId);
              if (!p1 || !p2) return null;
              const y1 = rowAbsoluteMainY[t.projectId], y2 = rowAbsoluteMainY[t.secondaryProjectId];
              const x0 = xFor(t.start);
              const topProjectId = y1 < y2 ? t.projectId : t.secondaryProjectId;
              // Chaque tâche partagée occupe sa propre voie au sein de l'espace dédié
              // (calculée plus haut par répartition gloutonne façon "salle de réunion")
              // — évite que plusieurs tâches partagées concurrentes se superposent sur
              // le même axe quand elles se chevauchent dans le temps.
              const lane = sharedTaskLane[t.id] || 0;
              const gapTop = rowGapTopAfter[topProjectId];
              const midY = gapTop != null ? gapTop + (lane + 0.5) * SHARED_GAP_H : (y1 + y2) / 2;
              const done = isTaskDoneGlobal(t, ctx);
              const color1 = p1.color || "var(--text-muted)", color2 = p2.color || "var(--text-muted)";
              const gradId = "shared-grad-" + t.id;
              const trunkStyle = appearance?.sharedTrunkStyle || "gradient";

              // === Jalon partagé : un point unique, comme n'importe quel jalon — pas
              // de durée, pas de "tronc", une seule jonction par ligne de projet. ===
              if (t.milestone) {
                return (
                  <g key={"shared-" + t.id} style={{ pointerEvents: "auto" }}>
                    <path d={`M ${x0} ${y1} L ${x0} ${midY}`} fill="none" stroke={color1} strokeWidth="1.8" strokeLinecap="round" strokeDasharray="1 4" opacity={done ? 0.35 : 0.6} />
                    <path d={`M ${x0} ${y2} L ${x0} ${midY}`} fill="none" stroke={color2} strokeWidth="1.8" strokeLinecap="round" strokeDasharray="1 4" opacity={done ? 0.35 : 0.6} />
                    <circle cx={x0} cy={y1} r="3.5" fill="var(--surface)" stroke="var(--text-900)" strokeWidth="1.4" />
                    <circle cx={x0} cy={y2} r="3.5" fill="var(--surface)" stroke="var(--text-900)" strokeWidth="1.4" />
                    {/* Anneau de correspondance : marque ce jalon comme un nœud partagé entre
                        deux lignes, plus imposant qu'une station normale (double anneau). */}
                    <circle cx={x0} cy={midY} r="13" fill="none" stroke={color1} strokeWidth="1.4" strokeDasharray="2 2.5" opacity="0.85" />
                    <circle cx={x0} cy={midY} r="10.5" fill="var(--surface)" stroke={color2} strokeWidth="1.4" />
                    <g onMouseDown={(e) => startDragTask(e, t, "start")} style={{ cursor: "ew-resize" }}>
                      <circle cx={x0} cy={midY} r="13" fill="transparent" />
                      <foreignObject x={x0 - 9} y={midY - 9} width="18" height="18" style={{ overflow: "visible" }}>
                        <MilestoneGlyph size={18} icon={resolveMilestoneIcon(t, ctx)} />
                      </foreignObject>
                    </g>
                    {(() => {
                      const sharedTitleW = pmMeasureText(t.title || "", "700 10.5px Inter, sans-serif");
                      const sharedMeta = `${p1.name} + ${p2.name}`;
                      const sharedMetaW = pmMeasureText(sharedMeta, "600 9px Inter, sans-serif");
                      return (
                        <>
                          <rect x={x0 + 12} y={midY - 10} width={sharedTitleW + 10} height={20} rx="3" fill="var(--surface)" opacity="0.98" />
                          <text x={x0 + 16} y={midY} dominantBaseline="middle" fontFamily="Inter, sans-serif" fontSize="10.5" fontWeight="700" fill="var(--text-900)" style={{ cursor: "pointer" }} onClick={() => onOpen(t)}>{t.title}</text>
                          {!!String(t.desc ?? t.description ?? "").trim() && (
                            <g
                              className="lp-pm-note-trigger"
                              transform={`translate(${x0 + 16 + sharedTitleW + 7}, ${midY - 8})`}
                              onClick={(e)=>{e.stopPropagation();setDescriptionPopup({task:t,x:e.clientX,y:e.clientY});}}
                              style={{cursor:"pointer"}}
                            >
                              <title>Afficher la description</title>
                              <rect x="0" y="0" width="17" height="16" rx="4" fill="var(--surface)" stroke="var(--border)" strokeWidth="1"/>
                              <path d="M4.5 4.5h8M4.5 7.5h8M4.5 10.5h5.5" fill="none" stroke="var(--text-600)" strokeWidth="1.25" strokeLinecap="round"/>
                            </g>
                          )}
                          <rect x={x0 + 12} y={midY + 5} width={sharedMetaW + 10} height={16} rx="3" fill="var(--surface)" opacity="0.98" />
                          <text x={x0 + 16} y={midY + 13} dominantBaseline="middle" fontFamily="Inter, sans-serif" fontSize="9" fontWeight="600" fill={color1}>{sharedMeta}</text>
                        </>
                      );
                    })()}
                  </g>
                );
              }

              // === Tâche partagée avec durée : tronc commun en dégradé ===
              const x1raw = xFor(t.end);
              const x1 = Math.max(x1raw, x0 + 30); // largeur minimale pour rester lisible
              const span = x1 - x0;
              const pct = done ? 100 : Math.max(0, Math.min(100, t.progress || 0));
              const xProgress = x0 + (span * pct) / 100;
              const path1 = `M ${x0} ${y1} L ${x0} ${midY}`;
              const path2 = `M ${x0} ${y2} L ${x0} ${midY}`;
              const trunkStart = x0, trunkEnd = x1;
              const path3 = `M ${trunkStart} ${midY} L ${trunkEnd} ${midY}`;
              const path4 = `M ${x1} ${midY} L ${x1} ${y1}`;
              const path5 = `M ${x1} ${midY} L ${x1} ${y2}`;
              const progressTrunkEnd = Math.min(trunkEnd, Math.max(trunkStart, xProgress));

              return (
                <g key={"shared-" + t.id} style={{ pointerEvents: "auto" }}>
                  <defs>
                    <linearGradient id={gradId} gradientUnits="userSpaceOnUse" x1={x0} y1={midY} x2={x1} y2={midY}>
                      <stop offset="0%" stopColor={color1} />
                      <stop offset="100%" stopColor={color2} />
                    </linearGradient>
                  </defs>
                  {/* Jonctions verticales en pointillé entre chaque axe principal et
                      l'espace partagé — même codage que les connecteurs de dépendance
                      existants ailleurs dans cette vue (fin, discret, pointillé). */}
                  <path d={path1} fill="none" stroke={color1} strokeWidth="1.8" strokeLinecap="round" strokeDasharray="1 4" opacity={done ? 0.35 : 0.6} />
                  <path d={path2} fill="none" stroke={color2} strokeWidth="1.8" strokeLinecap="round" strokeDasharray="1 4" opacity={done ? 0.35 : 0.6} />
                  <path d={path4} fill="none" stroke={color1} strokeWidth="1.8" strokeLinecap="round" strokeDasharray="1 4" opacity={done ? 0.35 : 0.6} />
                  <path d={path5} fill="none" stroke={color2} strokeWidth="1.8" strokeLinecap="round" strokeDasharray="1 4" opacity={done ? 0.35 : 0.6} />
                  {/* Petit repère à chaque intersection entre l'axe principal d'un projet
                      et la jonction verticale vers l'espace partagé — cercle blanc à
                      bordure noire, discret, purement indicatif. */}
                  <circle cx={x0} cy={y1} r="3.5" fill="var(--surface)" stroke="var(--text-900)" strokeWidth="1.4" />
                  <circle cx={x0} cy={y2} r="3.5" fill="var(--surface)" stroke="var(--text-900)" strokeWidth="1.4" />
                  <circle cx={x1} cy={y1} r="3.5" fill="var(--surface)" stroke="var(--text-900)" strokeWidth="1.4" />
                  <circle cx={x1} cy={y2} r="3.5" fill="var(--surface)" stroke="var(--text-900)" strokeWidth="1.4" />
                  {/* Tronc commun : deux styles au choix (réglage Apparence) — dégradé
                      fondu (une ligne, transition douce entre les deux couleurs) ou
                      torsade (deux filaments entrelacés, un par couleur de projet). */}
                  {trunkStyle === "braid" ? (
                    <>
                      <path d={buildBraidPath(trunkStart, trunkEnd, midY, 3.2, 26, true)} fill="none" stroke={color1} strokeWidth="2.4" strokeLinecap="round" opacity={done ? 0.45 : 0.7} style={{ cursor: "pointer" }} onClick={() => onOpen(t)} />
                      <path d={buildBraidPath(trunkStart, trunkEnd, midY, 3.2, 26, false)} fill="none" stroke={color2} strokeWidth="2.4" strokeLinecap="round" opacity={done ? 0.45 : 0.7} />
                      {pct > 0 && (
                        <>
                          <path d={buildBraidPath(trunkStart, progressTrunkEnd, midY, 3.2, 26, true)} fill="none" stroke={color1} strokeWidth="4" strokeLinecap="round" opacity={done ? 0.65 : 1} />
                          <path d={buildBraidPath(trunkStart, progressTrunkEnd, midY, 3.2, 26, false)} fill="none" stroke={color2} strokeWidth="4" strokeLinecap="round" opacity={done ? 0.65 : 1} />
                        </>
                      )}
                    </>
                  ) : (
                    <>
                      <path d={path3} fill="none" stroke={`url(#${gradId})`} strokeWidth="2.8" strokeLinecap="round" opacity={done ? 0.4 : 0.55} style={{ cursor: "pointer" }} onClick={() => onOpen(t)} />
                      {pct > 0 && (
                        <path d={`M ${trunkStart} ${midY} L ${progressTrunkEnd} ${midY}`} fill="none" stroke={`url(#${gradId})`} strokeWidth="4.5" strokeLinecap="round" opacity={done ? 0.55 : 0.95} />
                      )}
                    </>
                  )}
                  {/* Chatoiement optionnel : un reflet lumineux qui balaie le tronc en
                      continu, pour renforcer visuellement l'idée de connexion active
                      entre les deux projets (Réglages > Apparence). */}
                  {/* L’animation du disque est rendue dans un calque global final
                      (voir ci-dessous), afin qu’aucune ligne ou géométrie d’une autre
                      tâche partagée ne puisse passer visuellement au-dessus. */}
                  {/* Nœuds de correspondance : géométrie à double anneau — plus imposante
                      qu'une station normale (r=5.5) — pour signaler "changement de ligne",
                      avec un disque intérieur moitié couleur projet 1 / moitié couleur
                      projet 2. Glisser pour changer la date de début/fin, cliquer sans
                      glisser pour ouvrir la fiche — même mécanique que les stations
                      normales de la vue Métro. */}
                  <g onMouseDown={(e) => startDragTask(e, t, "start")} style={{ cursor: "ew-resize" }}>
                    <circle cx={x0} cy={midY} r="13" fill="transparent" />
                    <circle cx={x0} cy={midY} r="10.5" fill="none" stroke={color2} strokeWidth="1.4" strokeDasharray="2 2.5" opacity="0.85" />
                    {done ? (
                      <>
                        <circle cx={x0} cy={midY} r="6.5" fill="var(--success)" />
                        <path d={`M ${x0 - 3} ${midY} L ${x0 - 1} ${midY + 2} L ${x0 + 3.5} ${midY - 2.5}`} stroke="#fff" strokeWidth="1.4" fill="none" strokeLinecap="round" strokeLinejoin="round" />
                      </>
                    ) : (
                      <>
                        <circle cx={x0} cy={midY} r="6.5" fill="#fff" />
                        <path d={`M ${x0} ${midY - 6.5} A 6.5 6.5 0 0 1 ${x0} ${midY + 6.5}`} fill="none" stroke={color1} strokeWidth="2.4" />
                        <path d={`M ${x0} ${midY - 6.5} A 6.5 6.5 0 0 0 ${x0} ${midY + 6.5}`} fill="none" stroke={color2} strokeWidth="2.4" />
                      </>
                    )}
                  </g>
                  <g onMouseDown={(e) => startDragTask(e, t, "end")} style={{ cursor: "ew-resize" }}>
                    <circle cx={x1} cy={midY} r="13" fill="transparent" />
                    <circle cx={x1} cy={midY} r="10.5" fill="none" stroke={color2} strokeWidth="1.4" strokeDasharray="2 2.5" opacity="0.85" />
                    <circle cx={x1} cy={midY} r="6.5" fill="#fff" />
                    <path d={`M ${x1} ${midY - 6.5} A 6.5 6.5 0 0 1 ${x1} ${midY + 6.5}`} fill="none" stroke={color1} strokeWidth="2.4" />
                    <path d={`M ${x1} ${midY - 6.5} A 6.5 6.5 0 0 0 ${x1} ${midY + 6.5}`} fill="none" stroke={color2} strokeWidth="2.4" />
                  </g>
                  {(() => {
                    const sharedTitleW = pmMeasureText(t.title || "", "700 10.5px Inter, sans-serif");
                    const sharedMeta = `${p1.name} + ${p2.name}`;
                    const sharedMetaW = pmMeasureText(sharedMeta, "600 9px Inter, sans-serif");
                    return (
                      <>
                        <rect x={x0 - 4} y={midY - 27} width={sharedTitleW + 10} height={18} rx="3" fill="var(--surface)" opacity="0.98" />
                        <text x={x0} y={midY - 14} fontFamily="Inter, sans-serif" fontSize="10.5" fontWeight="700" fill="var(--text-900)" style={{ cursor: "pointer" }} onClick={() => onOpen(t)}>{t.title}</text>
                        {!!String(t.desc ?? t.description ?? "").trim() && (
                          <g
                            className="lp-pm-note-trigger"
                            transform={`translate(${x0 + sharedTitleW + 7}, ${midY - 22})`}
                            onClick={(e)=>{e.stopPropagation();setDescriptionPopup({task:t,x:e.clientX,y:e.clientY});}}
                            style={{cursor:"pointer"}}
                          >
                            <title>Afficher la description</title>
                            <rect x="0" y="0" width="17" height="16" rx="4" fill="var(--surface)" stroke="var(--border)" strokeWidth="1"/>
                            <path d="M4.5 4.5h8M4.5 7.5h8M4.5 10.5h5.5" fill="none" stroke="var(--text-600)" strokeWidth="1.25" strokeLinecap="round"/>
                          </g>
                        )}
                        <rect x={x0 - 4} y={midY + 11} width={sharedMetaW + 10} height={16} rx="3" fill="var(--surface)" opacity="0.98" />
                        <text x={x0} y={midY + 21} fontFamily="Inter, sans-serif" fontSize="9" fontWeight="600" fill={color1}>{sharedMeta}</text>
                      </>
                    );
                  })()}
                </g>
              );
            })}

          </svg>

          {/* Étiquettes de blocs, bande de repères, encadrés et couloirs de
              risque : un seul calque au-dessus des lignes, sans jamais capter
              le pointeur en dehors de ses propres libellés. */}
          <div
            className="lp-pm-annot-layer"
            style={{ left: LEFT_W, top: 0, width: chartWidth, height: totalChartHeight, zIndex: 3 }}
          >
            {temporalBlockShapes.map((shape) => (
              <span
                key={"lbl-" + shape.block.id}
                className="lp-pm-tblock-label"
                style={{ left: shape.x0 + 4, top: 54 + ANNOT_TOP_H + shape.labelOffset, color: shape.block.color }}
                title={`${shape.block.title} · ${fmtShort(shape.block.startDate)} → ${fmtShort(shape.block.endDate)}${shape.block.meta ? " — méta bloc" : ""}`}
              >
                {shape.block.title}
              </span>
            ))}

            {frameShapes.map((shape) => (
              <div
                key={shape.id}
                className="lp-pm-frame"
                style={{ left: shape.left, top: shape.top, width: shape.width, height: shape.height, borderColor: shape.frame.color, borderStyle: shape.frame.borderStyle }}
              >
                {shape.frame.label && (
                  <span className="lp-pm-frame-label" style={{ background: shape.frame.color }}>{shape.frame.label}</span>
                )}
              </div>
            ))}

            {stripItems.map((item) => (
              <React.Fragment key={item.kind + "-" + item.id}>
                <span
                  className="lp-pm-strip-rule"
                  style={{ left: item.x, top: 50 + item.lane * STRIP_LANE_H + 12, height: Math.max(0, totalChartHeight - (50 + item.lane * STRIP_LANE_H + 12)), borderColor: item.color }}
                />
                <span
                  className={"lp-pm-strip-item is-" + item.kind}
                  style={{ left: item.x - 4, top: 50 + item.lane * STRIP_LANE_H, color: item.color }}
                >
                  <MilestoneSymbol
                    symbol={item.kind === "note" ? "ring" : milestoneTypeFor(ctx.milestoneTypes, item.type).symbol}
                    color={item.color}
                    size={9}
                    style={{ marginTop: 3 }}
                  />
                  <span
                    className="lp-pm-strip-label"
                    style={{ color: item.color }}
                    title={item.kind === "note"
                      ? `${item.data.title}${item.data.text ? " — " + item.data.text : ""}`
                      : `${item.data.title} · ${fmtShort(item.data.date)} · ${milestoneTypeFor(ctx.milestoneTypes, item.type).name}`}
                  >
                    {item.label}
                  </span>
                </span>
              </React.Fragment>
            ))}

            {riskShapes.map(({ seg, left, width, y }) => (
              <React.Fragment key={"risk-" + seg.id}>
                <span
                  className={"lp-pm-risk is-" + seg.style}
                  style={{
                    left, width, top: y,
                    borderColor: seg.color,
                    background: seg.style === "hatched"
                      ? `repeating-linear-gradient(45deg, ${seg.color}40 0 3px, transparent 3px 6px)`
                      : (seg.style === "solid" ? `${seg.color}38` : "transparent"),
                  }}
                  title={`${seg.title || "Risque"} — ${MINIGANTT_RISK_SEVERITY_LABELS[seg.severity]} · ${seg.endIdx - seg.startIdx} j`}
                />
                {seg.title && (
                  <span className="lp-pm-risk-label" style={{ left: left + width + 5, top: y, color: seg.color }}>{seg.title}</span>
                )}
              </React.Fragment>
            ))}
          </div>

          {/* Place RÉELLEMENT réservée dans le flux à la bande de repères : sans
              elle, le calque superposé serait décalé de sa hauteur par rapport
              aux lignes qu'il annote. */}
          {ANNOT_TOP_H > 0 && <div style={{ height: ANNOT_TOP_H }} />}

          {rowsWithHeights.map((row) => (
            <React.Fragment key={row.project.id}>
            <div className="lp-pm-row" style={{ height: networkMode ? 60 : row.ROW_H }}>
              <div
                className={"lp-pm-left" + (leftCollapsed ? " lp-pm-left-collapsed" : "") + (dragOverRowId === row.project.id ? " lp-pm-left-dragover" : "")}
                style={{ width: LEFT_W }}
                draggable={!leftCollapsed}
                onDragStart={(e) => { e.dataTransfer.effectAllowed = "move"; e.dataTransfer.setData("text/plain", row.project.id); setDraggingRowId(row.project.id); }}
                onDragOver={(e) => { e.preventDefault(); if (row.project.id !== draggingRowId) setDragOverRowId(row.project.id); }}
                onDragLeave={() => setDragOverRowId((id) => (id === row.project.id ? null : id))}
                onDrop={(e) => { e.preventDefault(); const draggedId = e.dataTransfer.getData("text/plain"); setDraggingRowId(null); setDragOverRowId(null); reorderRows(draggedId, row.project.id); }}
                onDragEnd={() => { setDraggingRowId(null); setDragOverRowId(null); }}
              >
                {leftCollapsed ? (
                  <span className="lp-pm-left-collapsed-dot" style={{ background: row.project.color }} title={row.project.name}><IconGlyph icon={row.project.icon} size={11} /></span>
                ) : (
                  <>
                    <span className="lp-pm-left-drag-handle" title="Glisser pour réordonner les projets"><GripVertical size={12} /></span>
                    <button className="lp-icon-btn" onClick={() => toggleCollapse(row.project.id)} title={collapsed[row.project.id] ? "Déplier" : "Replier"}>
                      {collapsed[row.project.id] ? <ChevronRight size={14} /> : <ChevronDown size={14} />}
                    </button>
                    <span className="lp-project-dot" style={{ background: row.project.color, width: 34, height: 34, fontSize: 15 }}><IconGlyph icon={row.project.icon} size={16} /></span>
                    <div>
                      <div className="lp-pm-project-name" style={{ color: row.project.color }}>{row.project.name}</div>
                      <div className="lp-pm-progress-row">
                        <div style={{ width: 70 }}><ProgressBar value={row.avgProgress} color={row.project.color} animate={appearance?.animBarFill} /></div>
                        <span className="lp-pm-progress-pct">{row.avgProgress}%</span>
                      </div>
                    </div>
                  </>
                )}
              </div>
              <svg width={Math.max(1, chartWidth)} height={Math.max(1, networkMode ? 60 : row.ROW_H)} viewBox={`0 0 ${Math.max(1, chartWidth)} ${Math.max(1, networkMode ? 60 : row.ROW_H)}`} className="lp-pm-svg">
                <defs>
                  <marker id="lp-pm-arrowhead" markerWidth="7" markerHeight="7" refX="5" refY="2.5" orient="auto">
                    <path d="M0,0 L5,2.5 L0,5 Z" fill="var(--text-muted)" />
                  </marker>
                </defs>
                {networkMode ? <NetworkRow row={row} /> : deadlineMode ? <DeadlineRow row={row} /> : <ProjectRow row={row} />}
              </svg>
            </div>
            {/* Espace dédié réservé au(x) tronc(s) commun(s) d'une tâche à deux projets
                partagée avec la ligne suivante — territoire propre, jamais mélangé aux
                branches de dépendance internes de chaque ligne. */}
            {!deadlineMode && rowGapAfter[row.project.id] > 0 && (
              <div className="lp-pm-shared-gap" style={{ height: rowGapAfter[row.project.id] }} />
            )}
            </React.Fragment>
          ))}

          {/* CALQUE GLOBAL FINAL DES ANIMATIONS — placé hors des SVG de chaque projet.
              Les lignes de chaque projet sont rendues dans des SVG distincts, donc un
              disque animé placé dans le SVG d'une ligne peut passer SOUS le SVG d'une
              ligne voisine. Ce calque global est rendu après toutes les lignes et avec
              un z-index supérieur : les disques restent systématiquement au-dessus des
              troncs communs, jonctions et lignes de projets. */}
          {!deadlineMode && appearance?.animSharedShimmer && (
            <svg
              className="lp-pm-shared-animation-overlay"
              width={Math.max(1, chartWidth)}
              height={Math.max(1, totalChartHeight)}
              viewBox={`0 0 ${Math.max(1, chartWidth)} ${Math.max(1, totalChartHeight)}`}
              style={{ position: "absolute", left: LEFT_W, top: 0, width: Math.max(1, chartWidth), height: Math.max(1, totalChartHeight), pointerEvents: "none", zIndex: 10, overflow: "visible", isolation: "isolate" }}
            >
              {/* TOUS les disques animés sont rendus ici, après les SVG de toutes les
                  lignes. Cela garantit qu'ils restent visuellement au-dessus des rails,
                  y compris lorsqu'ils passent sur une ligne appartenant à un autre projet. */}
              {trainFlows.map((flow, i) => (
                <circle
                  key={"train-flow-overlay-" + i + "-" + flow.id}
                  r="4"
                  fill="#fff"
                  stroke="#000"
                  strokeWidth="1.8"
                  opacity="1"
                >
                  <animateMotion dur={`${flow.duration || 0.35}s`} repeatCount="indefinite" path={flow.path} />
                </circle>
              ))}

              {dated.filter((t) => isFullyShared(t) && !t.milestone).map((t) => {
                const p1 = ctx.projects.find((pr) => pr.id === t.projectId);
                const p2 = ctx.projects.find((pr) => pr.id === t.secondaryProjectId);
                if (!p1 || !p2) return null;
                const x0 = xFor(t.start);
                const x1 = Math.max(xFor(t.end), x0 + 30);
                const y1 = rowAbsoluteMainY[t.projectId], y2 = rowAbsoluteMainY[t.secondaryProjectId];
                const topProjectId = y1 < y2 ? t.projectId : t.secondaryProjectId;
                const lane = sharedTaskLane[t.id] || 0;
                const gapTop = rowGapTopAfter[topProjectId];
                const midY = gapTop != null ? gapTop + (lane + 0.5) * SHARED_GAP_H : (y1 + y2) / 2;
                return (
                  <circle key={"shared-shimmer-overlay-" + t.id} r="5" fill="#fff" stroke="#000" strokeWidth="1.8" opacity="0.98">
                    <animateMotion dur={`${Math.max(0.35, Math.abs(x1 - x0) / TRAIN_PX_PER_SECOND)}s`} repeatCount="indefinite" path={`M ${x0} ${midY} L ${x1} ${midY}`} />
                  </circle>
                );
              })}
            </svg>
          )}

          {rows.length === 0 && <div className="lp-empty" style={{ marginLeft: railLeftW, padding: 30 }}>Aucun projet avec des tâches datées.</div>}
        </div>
      </div>

      {descriptionPopup && (() => {
        const task = descriptionPopup.task;
        const popupW = 380;
        const popupH = 300;
        const vw = typeof window !== "undefined" ? window.innerWidth : 1200;
        const vh = typeof window !== "undefined" ? window.innerHeight : 800;
        const left = Math.max(12, Math.min(descriptionPopup.x + 12, vw - popupW - 12));
        const top = Math.max(12, Math.min(descriptionPopup.y + 12, vh - popupH - 12));
        return (
          <>
            <div className="lp-pm-desc-overlay" onClick={()=>setDescriptionPopup(null)} />
            <div className="lp-pm-desc-popover" style={{left,top}} onClick={(e)=>e.stopPropagation()}>
              <div className="lp-pm-desc-popover-head">
                <StickyNote size={14} style={{color:"var(--text-600)",flex:"0 0 auto"}} />
                <div className="lp-pm-desc-popover-title">{task.title}</div>
                <button className="lp-icon-btn" onClick={()=>setDescriptionPopup(null)} title="Fermer"><X size={13}/></button>
              </div>
              <div
                className="lp-pm-desc-popover-body lp-desc-preview"
                dangerouslySetInnerHTML={{__html:renderMarkdown(task.desc ?? task.description ?? "")}}
              />
            </div>
          </>
        );
      })()}

      {projectSummary && (() => {
        const row = projectSummary.row;
        const p = row.project;
        const budgetStats = expenses ? computeBudgetStats(p.id, ctx.projects, expenses) : null;
        const daysLeft = dayIndex(row.maxDate) - dayIndex(iso(new Date()));
        const lateCount = [...row.pTasks, ...row.pMilestones].filter((t) => isTaskLate(t, ctx)).length;
        const cardLeft = Math.min(projectSummary.x, (typeof window !== "undefined" ? window.innerWidth : 1200) - 300);
        const cardTop = Math.min(projectSummary.y + 12, (typeof window !== "undefined" ? window.innerHeight : 800) - 280);
        return (
          <>
            <div className="lp-pm-summary-overlay" onClick={() => setProjectSummary(null)} />
            <div className="lp-pm-summary-card" style={{ left: cardLeft, top: cardTop }}>
              <div className="lp-pm-summary-head">
                <span className="lp-project-dot" style={{ background: p.color, width: 30, height: 30 }}><IconGlyph icon={p.icon} size={14} /></span>
                <div>
                  <div className="lp-pm-summary-title">{p.name}</div>
                  <div className="lp-pm-summary-sub">Fin : {fmtShort(row.maxDate)}</div>
                </div>
                <button className="lp-icon-btn" onClick={() => setProjectSummary(null)} style={{ marginLeft: "auto" }}><X size={13} /></button>
              </div>
              <div className="lp-pm-summary-grid">
                <div className="lp-pm-summary-metric">
                  <div className="lp-pm-summary-metric-val" style={{ color: p.color }}>{row.avgProgress}%</div>
                  <div className="lp-pm-summary-metric-label">Avancement</div>
                </div>
                <div className="lp-pm-summary-metric">
                  <div className={"lp-pm-summary-metric-val" + (daysLeft < 0 ? " lp-pm-summary-metric-danger" : "")}>{daysLeft >= 0 ? daysLeft : Math.abs(daysLeft)}</div>
                  <div className="lp-pm-summary-metric-label">{daysLeft >= 0 ? "jours restants" : "jours de retard"}</div>
                </div>
                {budgetStats && budgetStats.budgetActuel > 0 && (
                  <div className="lp-pm-summary-metric">
                    <div className={"lp-pm-summary-metric-val" + (budgetStats.pct > 100 ? " lp-pm-summary-metric-danger" : "")}>{budgetStats.pct}%</div>
                    <div className="lp-pm-summary-metric-label">Budget consommé</div>
                  </div>
                )}
                {lateCount > 0 && (
                  <div className="lp-pm-summary-metric">
                    <div className="lp-pm-summary-metric-val lp-pm-summary-metric-danger">{lateCount}</div>
                    <div className="lp-pm-summary-metric-label">en retard</div>
                  </div>
                )}
              </div>
              {(row.pTasks[0] || row.pMilestones[0]) && (
                <button className="lp-btn lp-btn-primary" style={{ width: "100%" }} onClick={() => { onOpen(row.pTasks[0] || row.pMilestones[0]); setProjectSummary(null); }}>Ouvrir une tâche du projet</button>
              )}
            </div>
          </>
        );
      })()}

      {selectedIds.size > 0 && (
        <div className="lp-pm-selection-bar">
          <span className="lp-pm-selection-count">{selectedIds.size} sélectionnée{selectedIds.size > 1 ? "s" : ""}</span>
          <span className="lp-pm-selection-hint">Ctrl/Cmd-clic sur une station pour ajouter ou retirer</span>
          <span style={{ flex: 1 }} />
          {doneStatus && <button className="lp-btn" onClick={markSelectedDone}><CheckCircle2 size={13} style={{ marginRight: 4, verticalAlign: -2 }} />Marquer terminé</button>}
          <button className="lp-btn" onClick={deleteSelected}><Trash2 size={13} style={{ marginRight: 4, verticalAlign: -2 }} />Supprimer</button>
          <button className="lp-btn" onClick={clearSelection}>Désélectionner</button>
        </div>
      )}
    </div>
    {!embedded && isHomepage && homeStats && (
      <div className="lp-metro-home-widgets">
        <div className="lp-metro-home-widget">
          <h4><span className="lp-metro-home-widget-ic" style={{ background: "color-mix(in srgb, var(--danger) 14%, white)", color: "var(--danger)" }}><AlertTriangle size={12} /></span>En retard</h4>
          {lateTasks.length === 0 ? (
            <p className="lp-metro-home-widget-empty">Rien en retard, tout est à jour.</p>
          ) : lateTasks.map((t) => (
            <div key={t.id} className="lp-metro-home-late-row" onClick={() => onOpen(t)}>
              <span className="lp-metro-home-late-dot" style={{ background: ctx.projects.find((p) => p.id === t.projectId)?.color || "var(--text-muted)" }} />
              <span className="lp-metro-home-late-title">{t.title}</span>
              <span className="lp-metro-home-late-days">{Math.max(1, dayIndex(now) - dayIndex(t.end))}j</span>
            </div>
          ))}
        </div>
        <div className="lp-metro-home-widget">
          <h4><span className="lp-metro-home-widget-ic" style={{ background: "color-mix(in srgb, var(--success) 14%, white)", color: "var(--success)" }}><TrendingUp size={12} /></span>Avancement global</h4>
          <div className="lp-metro-home-kpi"><CountUp value={homeStats.avgProgress} animate={appearance?.animCountUp} /><span style={{ fontSize: 16 }}>%</span></div>
          <p className="lp-metro-home-widget-empty">{homeStats.total} tâche{homeStats.total > 1 ? "s" : ""} au total</p>
        </div>
        <div className="lp-metro-home-widget">
          <h4><span className="lp-metro-home-widget-ic" style={{ background: "var(--paper-soft)", color: "var(--text-600)" }}><BarChart3 size={12} /></span>Répartition</h4>
          <div className="lp-metro-home-donut-row">
            <div className="lp-metro-home-donut" style={{ background: `conic-gradient(${(() => {
              let acc = 0;
              return homeStats.byStatus.map((s) => {
                const start = acc, pct = (s.count / homeStats.total) * 100;
                acc += pct;
                return `${s.color} ${start}% ${acc}%`;
              }).join(", ");
            })()})` }} />
            <div className="lp-metro-home-donut-legend">
              {homeStats.byStatus.slice(0, 3).map((s) => (
                <div key={s.name}><span style={{ background: s.color }} />{s.name} · {Math.round((s.count / homeStats.total) * 100)}%</div>
              ))}
            </div>
          </div>
        </div>
        <div className="lp-metro-home-widget">
          <h4><span className="lp-metro-home-widget-ic" style={{ background: "color-mix(in srgb, var(--signal) 14%, white)", color: "var(--signal)" }}><CalendarClock size={12} /></span>Prochaines échéances</h4>
          {upcomingTasks.length === 0 ? (
            <p className="lp-metro-home-widget-empty">Aucune échéance à venir.</p>
          ) : upcomingTasks.map((t) => (
            <div key={t.id} className="lp-metro-home-deadline-row" onClick={() => onOpen(t)}>
              <div className="lp-metro-home-deadline-date">{new Date(t.end + "T00:00:00").getDate()}<small>{new Date(t.end + "T00:00:00").toLocaleDateString("fr-FR", { month: "short" })}</small></div>
              <div>
                <div className="lp-metro-home-deadline-title">{t.title}</div>
                <div className="lp-metro-home-deadline-proj">{ctx.projects.find((p) => p.id === t.projectId)?.name || ""}</div>
              </div>
            </div>
          ))}
        </div>
      </div>
    )}

    {annotationPanel && createPortal(
      <Modal
        title="Annotations du plan de lignes"
        onClose={() => setAnnotationPanel(null)}
        wide
        footer={<button className="lp-btn lp-btn-primary" onClick={() => setAnnotationPanel(null)}>Terminé</button>}
      >
        <p style={{ fontSize: 12, color: "var(--text-600)", marginTop: -6, marginBottom: 10 }}>
          Mêmes objets que le Gantt et le Mini-Gantt. Les blocs, encadrés, jalons et annotations sont enregistrés avec cette vue ;
          les risques de délai appartiennent aux tâches et se modifient dans leur fiche.
        </p>
        <MiniGanttAnnotationsEditor
          blocks={rawTemporalBlocks}
          frames={rawHighlightFrames}
          milestones={rawMilestones}
          risks={taskRisks}
          notes={rawNotes}
          tasks={dated}
          ctx={ctx}
          defaultStart={globalMin}
          defaultEnd={globalMax}
          onChange={applyAnnotations}
          initialSection={annotationPanel.section}
          autoCreate={annotationPanel.autoCreate}
        />
      </Modal>,
      document.body
    )}
    </>
  );
}

// ============================================================================
// Vue "Tableur" — grille de type Airtable/Notion/Coda : édition en ligne,
// sélection multiple, modification en masse, duplication.
// ============================================================================
const TABLE_COL_OPTIONS = [
  { key: "project", label: "Projet", w: 150 },
  { key: "status", label: "Statut", w: 130 },
  { key: "start", label: "Début", w: 110 },
  { key: "end", label: "Fin", w: 110 },
  { key: "progress", label: "Avancement", w: 110 },
  { key: "assignee", label: "Responsable", w: 130 },
  { key: "milestone", label: "Jalon", w: 60 },
  { key: "lastInteraction", label: "Dernière interaction", w: 150 },
  { key: "inactivity", label: "Inactivité", w: 105 },
];

function BulkProgressPicker({ onApply }) {
  const [val, setVal] = useState(50);
  return (
    <DropdownButton label="Avancement" icon={<CheckCircle2 size={14} />}>
      <div style={{ display: "flex", gap: 6, alignItems: "center", padding: "4px 2px" }}>
        <input type="number" min="0" max="100" value={val} onChange={(e) => setVal(e.target.value)} style={{ width: 60 }} />
        <span style={{ fontSize: 12, color: "var(--text-600)" }}>%</span>
        <button className="lp-btn lp-btn-primary" style={{ padding: "5px 10px", fontSize: 12 }} onClick={() => onApply(Math.max(0, Math.min(100, Number(val) || 0)))}>Appliquer</button>
      </div>
    </DropdownButton>
  );
}

function BulkDatesPicker({ onApplyDates, onShift }) {
  const [start, setStart] = useState("");
  const [end, setEnd] = useState("");
  const [shiftDays, setShiftDays] = useState(1);
  return (
    <DropdownButton label="Dates" icon={<CalendarClock size={14} />}>
      <div style={{ display: "flex", flexDirection: "column", gap: 8, padding: "4px 2px", minWidth: 200 }}>
        <div>
          <div style={{ fontSize: 11, fontWeight: 700, color: "var(--text-600)", marginBottom: 4 }}>Définir une date</div>
          <div style={{ display: "flex", gap: 6 }}>
            <input type="date" value={start} onChange={(e) => setStart(e.target.value)} style={{ flex: 1 }} title="Nouvelle date de début" />
            <input type="date" value={end} onChange={(e) => setEnd(e.target.value)} style={{ flex: 1 }} title="Nouvelle date de fin" />
          </div>
          <button className="lp-btn lp-btn-primary" style={{ padding: "5px 10px", fontSize: 12, marginTop: 6, width: "100%" }} onClick={() => onApplyDates(start || null, end || null)} disabled={!start && !end}>Appliquer les dates</button>
        </div>
        <hr className="lp-divider" style={{ margin: "2px 0" }} />
        <div>
          <div style={{ fontSize: 11, fontWeight: 700, color: "var(--text-600)", marginBottom: 4 }}>Décaler de (jours, +/-)</div>
          <div style={{ display: "flex", gap: 6 }}>
            <input type="number" value={shiftDays} onChange={(e) => setShiftDays(e.target.value)} style={{ flex: 1 }} />
            <button className="lp-btn" style={{ padding: "5px 10px", fontSize: 12 }} onClick={() => onShift(Number(shiftDays) || 0)}>Décaler</button>
          </div>
        </div>
      </div>
    </DropdownButton>
  );
}

function TableView({ tasks, ctx, setTasks, onOpen, onAdd, onDelete, onBulkDelete, toolbarSlot, prefs, setPrefs }) {
  const allColOptions = TABLE_COL_OPTIONS;
  const cols = prefs.cols || ["project", "status", "start", "end", "progress", "assignee", "lastInteraction", "inactivity"];
  const setCols = (updater) => setPrefs((p) => ({ ...p, cols: typeof updater === "function" ? updater(p.cols || []) : updater }));
  const groupBy = prefs.groupBy || "none";
  const setGroupBy = (v) => setPrefs((p) => ({ ...p, groupBy: v }));
  const [collapsedGroups, setCollapsedGroups] = useState({});
  const toggleGroupCollapsed = (key) => setCollapsedGroups((c) => ({ ...c, [key]: !c[key] }));
  const [selected, setSelected] = useState(new Set());
  const [newTitle, setNewTitle] = useState("");

  const toggleRow = (id) => setSelected((prev) => { const n = new Set(prev); n.has(id) ? n.delete(id) : n.add(id); return n; });
  const toggleAll = () => setSelected((prev) => (prev.size === tasks.length ? new Set() : new Set(tasks.map((t) => t.id))));
  const clearSelection = () => setSelected(new Set());

  const updateTask = (id, patch) => setTasks((prev) => prev.map((t) => (t.id === id ? { ...t, ...patch } : t)));
  const bulkUpdate = (patch) => setTasks((prev) => prev.map((t) => (selected.has(t.id) ? { ...t, ...patch } : t)));
  const bulkShiftDates = (days) => {
    if (!days) return;
    setTasks((prev) => prev.map((t) => (selected.has(t.id) ? { ...t, start: t.start ? addDays(t.start, days) : t.start, end: t.end ? addDays(t.end, days) : t.end } : t)));
  };
  const bulkSetDates = (start, end) => {
    setTasks((prev) => prev.map((t) => (selected.has(t.id) ? { ...t, ...(start ? { start } : {}), ...(end ? { end } : {}) } : t)));
  };

  const duplicateTask = (t) => {
    const copy = { ...t, id: uid(), title: t.title + " (copie)" };
    setTasks((prev) => {
      const idx = prev.findIndex((x) => x.id === t.id);
      const next = [...prev];
      next.splice(idx + 1, 0, copy);
      return next;
    });
  };
  const duplicateSelected = () => {
    setTasks((prev) => {
      const next = [...prev];
      [...selected].forEach((id) => {
        const idx = next.findIndex((x) => x.id === id);
        if (idx === -1) return;
        next.splice(idx + 1, 0, { ...next[idx], id: uid(), title: next[idx].title + " (copie)" });
      });
      return next;
    });
    clearSelection();
  };

  const addQuickTask = () => {
    if (!newTitle.trim()) return;
    const today = iso(new Date());
    setTasks((prev) => [...prev, withCreationComparison({ id: uid(), title: newTitle.trim(), projectId: ctx.projects[0]?.id || null, statusId: ctx.statuses[0]?.id || null, taskTypeId: getDefaultTaskTypeForProject(ctx.taskTypes, ctx.projects, ctx.projects[0]?.id)?.id || null, start: today, end: today, progress: 0, milestone: false, desc: "", assignee: "", checklist: [], lastInteraction:new Date().toISOString() })]);
    setNewTitle("");
  };

  const allSelected = tasks.length > 0 && selected.size === tasks.length;

  return (
    <div className="lp-table-wrap">
      <ViewToolbarPortal slot={toolbarSlot}>
        <DropdownButton label="" icon={<Layers size={14} />} title={`Grouper par : ${fieldLabel(groupBy, ctx)}`}>
          {GROUP_OPTIONS.map((k) => (
            <label className="lp-checkbox-line" key={k}><input type="radio" name="lp-table-gb" checked={groupBy === k} onChange={() => setGroupBy(k)} /> {fieldLabel(k, ctx)}</label>
          ))}
        </DropdownButton>
        <DropdownButton label="" icon={<Columns3 size={14} />} title="Colonnes affichées">
          {allColOptions.map((c) => (
            <label className="lp-checkbox-line" key={c.key}>
              <input type="checkbox" checked={cols.includes(c.key)} onChange={() => setCols((prev) => (prev.includes(c.key) ? prev.filter((x) => x !== c.key) : [...prev, c.key]))} />
              {c.label}
            </label>
          ))}
        </DropdownButton>
      </ViewToolbarPortal>

      {selected.size > 0 && (
        <div className="lp-table-bulkbar">
          <span className="lp-table-bulkbar-count">{selected.size} sélectionnée{selected.size > 1 ? "s" : ""}</span>
          <DropdownButton label="Statut" icon={<Layers size={14} />}>
            {sortedByName(ctx.statuses).map((s) => (
              <button key={s.id} className="lp-checkbox-line" style={{ cursor: "pointer", border: "none", background: "none", width: "100%", textAlign: "left" }} onClick={() => bulkUpdate({ statusId: s.id })}>
                <span className="swatch small" style={{ background: s.color }} /> {s.name}
              </button>
            ))}
          </DropdownButton>
          <DropdownButton label="Type" icon={<Tag size={14} />}>
            {sortedByName(ctx.taskTypes || []).map((tt) => (
              <button
                key={tt.id}
                className="lp-checkbox-line"
                style={{ cursor: "pointer", border: "none", background: "none", width: "100%", textAlign: "left" }}
                onClick={() => {
                  // Comme pour la modification à l'unité : si le nouveau type impose
                  // un statut automatique (ex. "Information"), on le bascule dans le
                  // même geste pour toute la sélection.
                  const restricted = restrictedStatusForType(ctx.taskTypes, ctx.statuses, tt.id);
                  bulkUpdate(restricted ? { taskTypeId: tt.id, statusId: restricted.id } : { taskTypeId: tt.id });
                }}
              >
                <span className="swatch small" style={{ background: tt.color }} /> {tt.name}
              </button>
            ))}
          </DropdownButton>
          <DropdownButton label="Projet" icon={<Folder size={14} />}>
            {sortedByName(ctx.projects).map((p) => (
              <button key={p.id} className="lp-checkbox-line" style={{ cursor: "pointer", border: "none", background: "none", width: "100%", textAlign: "left" }} onClick={() => bulkUpdate({ projectId: p.id })}>
                <span className="swatch small" style={{ background: p.color }} /> {p.name}
              </button>
            ))}
          </DropdownButton>
          <DropdownButton label="Responsable" icon={<User size={14} />}>
            <button className="lp-checkbox-line" style={{ cursor: "pointer", border: "none", background: "none", width: "100%", textAlign: "left" }} onClick={() => bulkUpdate({ assignee: "" })}>
              <span className="swatch small" style={{ background: "#CBD5E1" }} /> Non assigné
            </button>
            {sortedByName(ctx.teamMembers || []).map((u) => (
              <button key={u.id} className="lp-checkbox-line" style={{ cursor: "pointer", border: "none", background: "none", width: "100%", textAlign: "left" }} onClick={() => bulkUpdate({ assignee: u.name })}>
                {u.avatarDataUrl ? <IconGlyph icon={u.avatarDataUrl} size={13} /> : <span className="swatch small" style={{ background: u.color }} />} {u.name}
              </button>
            ))}
          </DropdownButton>
          <DropdownButton label="Jalon" icon={<Milestone size={14} />}>
            <button className="lp-checkbox-line" style={{ cursor: "pointer", border: "none", background: "none", width: "100%", textAlign: "left" }} onClick={() => bulkUpdate({ milestone: true })}>Oui</button>
            <button className="lp-checkbox-line" style={{ cursor: "pointer", border: "none", background: "none", width: "100%", textAlign: "left" }} onClick={() => bulkUpdate({ milestone: false })}>Non</button>
          </DropdownButton>
          <BulkProgressPicker onApply={(v) => bulkUpdate({ progress: v })} />
          <BulkDatesPicker onApplyDates={bulkSetDates} onShift={bulkShiftDates} />
          <button className="lp-tool-btn" onClick={duplicateSelected} title="Dupliquer la sélection"><Bookmark size={14} /></button>
          <button className="lp-tool-btn lp-filter-btn-danger" onClick={() => { onBulkDelete([...selected], "sélectionnées"); clearSelection(); }} title="Supprimer la sélection"><Trash2 size={14} /></button>
          <button className="lp-tool-btn" onClick={clearSelection} title="Annuler la sélection"><X size={14} /></button>
        </div>
      )}

      <div className="lp-table-scroll">
        <table className="lp-table">
          <thead>
            <tr>
              <th className="lp-table-th-check"><input type="checkbox" checked={allSelected} onChange={toggleAll} /></th>
              <th className="lp-table-th-title">Tâche</th>
              {cols.map((c) => {
                const def = allColOptions.find((x) => x.key === c);
                return <th key={c} style={{ width: def?.w }}>{def?.label}</th>;
              })}
              <th className="lp-table-th-actions"></th>
            </tr>
          </thead>
          <tbody>
            {(() => {
              const Row = (t) => {
                const proj = ctx.projects.find((p) => p.id === t.projectId);
                const st = ctx.statuses.find((s) => s.id === t.statusId);
                const done = isTaskDoneGlobal(t, ctx);
                return (
                  <tr key={t.id} className={selected.has(t.id) ? "lp-table-row-selected" : ""}>
                    <td className="lp-table-th-check"><input type="checkbox" checked={selected.has(t.id)} onChange={() => toggleRow(t.id)} /></td>
                    <td className="lp-table-title-cell">
                      {t.milestone && <MilestoneGlyph size={13} icon={resolveMilestoneIcon(t, ctx)} />}
                      <InlineTextField value={t.title} onCommit={(v) => updateTask(t.id, { title: v })} style={{ fontWeight: 600, textDecoration: done ? "line-through" : "none", color: done ? "var(--text-600)" : "var(--text-900)" }} />
                      {t.dependsOn && t.dependsOn.length > 0 && <span className="lp-dep-badge" title={`Dépend de ${t.dependsOn.length} tâche${t.dependsOn.length > 1 ? "s" : ""}`}><GripVertical size={11} />{t.dependsOn.length}</span>}
                      {t.recurrence && <span className="lp-dep-badge" title="Tâche récurrente"><RefreshCw size={11} /></span>}
                      {getPrimaryGoogleDriveAttachment(t) && (
                        <a className="lp-icon-btn lp-drive-quick-link" href={getPrimaryGoogleDriveAttachment(t).url} target="_blank" rel="noopener noreferrer" onClick={(e) => e.stopPropagation()} title={`Ouvrir dans Google Drive${getGoogleDriveAttachments(t).length > 1 ? ` (${getGoogleDriveAttachments(t).length} liens)` : ""}`}><Folder size={13} /></a>
                      )}
                      <button className="lp-icon-btn lp-table-open-btn" onClick={() => onOpen(t)} title="Ouvrir la fiche complète"><ChevronRight size={13} /></button>
                    </td>
                    {cols.includes("project") && (
                      <td>
                        <InlineChipSelect
                          options={ctx.projects.map((p) => ({ value: p.id, label: p.name, color: p.color }))}
                          value={t.projectId}
                          onChange={(v) => updateTask(t.id, { projectId: v })}
                        />
                      </td>
                    )}
                    {cols.includes("status") && (
                      <td>
                        {(() => {
                          const restrictedStatus = restrictedStatusForType(ctx.taskTypes, ctx.statuses, t.taskTypeId);
                          if (restrictedStatus) {
                            return (
                              <span
                                className="lp-chip"
                                title="Statut automatique — imposé par le type de tâche"
                                style={{
                                  background:(restrictedStatus.color || "var(--text-muted)") + "18",
                                  color:restrictedStatus.color || "var(--text-muted)",
                                  cursor:"default",
                                  border:"1px solid " + ((restrictedStatus.color || "#64748B") + "30")
                                }}
                              >
                                <Lock size={10} /> {restrictedStatus.name}
                              </span>
                            );
                          }
                          return (
                            <InlineChipSelect
                              options={getStatusesForProject(ctx.statuses, ctx.projects, t.projectId, t.statusId).map((s) => ({ value: s.id, label: s.name, color: s.color }))}
                              value={t.statusId}
                              onChange={(v) => updateTask(t.id, { statusId: v })}
                            />
                          );
                        })()}
                      </td>
                    )}
                    {cols.includes("start") && <td>{t.start ? <InlineDateField value={t.start} onCommit={(v) => updateTask(t.id, { start: v })} /> : <span className="lp-empty-cell" onClick={() => updateTask(t.id, { start: iso(new Date()) })}>—</span>}</td>}
                    {cols.includes("end") && <td>{t.end ? <InlineDateField value={t.end} onCommit={(v) => updateTask(t.id, { end: v })} /> : <span className="lp-empty-cell" onClick={() => updateTask(t.id, { end: iso(new Date()) })}>—</span>}</td>}
                    {cols.includes("progress") && (
                      <td>
                        <div className="lp-table-progress-cell">
                          <input type="range" min="0" max="100" value={t.progress || 0} onChange={(e) => updateTask(t.id, { progress: Number(e.target.value) })} />
                          <span>{t.progress || 0}%</span>
                        </div>
                      </td>
                    )}
                    {cols.includes("assignee") && (
                      <td>
                        <InlineChipSelect
                          options={[{ value: "", label: "Non assigné", color: "#CBD5E1" }, ...sortedByName(ctx.teamMembers || []).map((u) => ({ value: u.name, label: u.name, color: u.color }))]}
                          value={t.assignee || ""}
                          onChange={(v) => updateTask(t.id, { assignee: v })}
                        />
                      </td>
                    )}
                    {cols.includes("milestone") && (
                      <td style={{ textAlign: "center" }}><input type="checkbox" checked={getTaskType(t) === "milestone"} onChange={(e) => updateTask(t.id, { type:e.target.checked ? "milestone" : "action", milestone:e.target.checked, end:e.target.checked ? (t.start || t.end) : t.end })} /></td>
                    )}
                    {cols.includes("lastInteraction") && (
                      <td title={formatLastInteraction(t)}><span style={{fontFamily:"var(--font-mono)",fontSize:10}}>{formatLastInteraction(t)}</span></td>
                    )}
                    {cols.includes("inactivity") && (
                      <td><span className="lp-dep-badge" title={`Dernière interaction : ${formatLastInteraction(t)}`}>{formatInteractionAge(t)}</span></td>
                    )}
                    <td className="lp-table-th-actions">
                      <button className="lp-icon-btn" onClick={() => duplicateTask(t)} title="Dupliquer cette tâche"><Bookmark size={13} /></button>
                      <button className="lp-icon-btn" onClick={() => onDelete(t)} title="Supprimer"><Trash2 size={13} /></button>
                    </td>
                  </tr>
                );
              };

              if (!groupBy || groupBy === "none") return tasks.map(Row);

              const groups = groupTasks(tasks, groupBy, ctx).filter((g) => g.tasks.length > 0);
              const totalCols = cols.length + 3;
              return groups.map((g) => {
                const isCollapsed = !!collapsedGroups[g.key];
                return (
                  <React.Fragment key={g.key}>
                    <tr className="lp-table-group-row" onClick={() => toggleGroupCollapsed(g.key)}>
                      <td colSpan={totalCols}>
                        <div className="lp-table-group-head">
                          <ChevronRight size={12} style={{ transform: isCollapsed ? "rotate(0deg)" : "rotate(90deg)" }} />
                          <span className="lp-table-group-dot" style={{ background: g.color || "var(--text-muted)" }} />
                          <span className="lp-table-group-label">{g.label}</span>
                          <span className="lp-table-group-count">{g.tasks.length}</span>
                        </div>
                      </td>
                    </tr>
                    {!isCollapsed && g.tasks.map(Row)}
                  </React.Fragment>
                );
              });
            })()}
            <tr className="lp-table-add-row">
              <td className="lp-table-th-check"></td>
              <td colSpan={cols.length + 2}>
                <div className="lp-table-add-inner">
                  <Plus size={14} />
                  <input
                    type="text"
                    placeholder="Nouvelle tâche… (Entrée pour valider)"
                    value={newTitle}
                    onChange={(e) => setNewTitle(e.target.value)}
                    onKeyDown={(e) => e.key === "Enter" && addQuickTask()}
                  />
                </div>
              </td>
            </tr>
          </tbody>
        </table>
        {tasks.length === 0 && <div className="lp-empty" style={{ padding: 24 }}>Aucune tâche.</div>}
      </div>
    </div>
  );
}

// ============================================================================
// Tableau de bord modulable — widgets configurables (chiffres, graphiques, listes)
// ============================================================================
const WIDGET_METRICS = [
  { key: "count", label: "Nombre de tâches" },
  { key: "avgProgress", label: "Avancement moyen (%)" },
  { key: "milestoneCount", label: "Nombre de jalons" },
  { key: "urgentCount", label: "Nombre de tâches urgentes" },
];

const CUSTOM_CARD_BLOCK_TYPES = [
  { key:"aggregate", label:"Agrégation standard" },
  { key:"taskTitle", label:"Titre de la tâche" },
  { key:"project", label:"Projet" },
  { key:"status", label:"Statut" },
  { key:"start", label:"Date de début" },
  { key:"end", label:"Date de fin" },
  { key:"assignee", label:"Responsable" },
  { key:"progress", label:"Avancement" },
  { key:"description", label:"Description" },
  { key:"staticText", label:"Texte libre" },
];

const CUSTOM_CARD_DEFAULT_ICONS = {
  aggregate:"tabler:calculator",
  taskTitle:"tabler:circle-check",
  project:"tabler:folder",
  status:"tabler:traffic-lights",
  start:"tabler:calendar-event",
  end:"tabler:calendar-due",
  assignee:"tabler:user",
  progress:"tabler:progress",
  description:"tabler:align-left",
  staticText:"tabler:text-size",
};

const customCardDefaultBlocks = () => ([
  { id:uid(), kind:"aggregate", label:"Tâches", metric:"count", emphasis:"hero", showIcon:true, icon:"tabler:calculator", color:"", bgColor:"", showLabel:true, accent:"none" },
  { id:uid(), kind:"progress", label:"Avancement", emphasis:"normal", showIcon:true, icon:"tabler:progress", color:"", bgColor:"", showLabel:true, accent:"none" },
  { id:uid(), kind:"end", label:"Échéance", emphasis:"normal", showIcon:true, icon:"tabler:calendar-due", color:"", bgColor:"", showLabel:true, accent:"none" },
]);
const WIDGET_GROUPBY_FIELDS = ["project", "status", "criticality", "taskType", "assignee", "milestone", "period"];
const CHART_STYLES = [
  { key: "pie", label: "Camembert" },
  { key: "bar", label: "Barres verticales" },
  { key: "barh", label: "Barres horizontales" },
  { key: "gauge", label: "Jauge (%)" },
  { key: "line", label: "Courbe d'évolution" },
  { key: "stackedBar", label: "Barres empilées" },
];
const GAUGE_METRICS = [
  { key: "avgProgress", label: "Avancement moyen" },
  { key: "doneRatio", label: "Taux de tâches terminées" },
];

function widgetDefaultFilter() {
  return { projectIds: [], projectIdsMode: "is", statusIds: [], statusIdsMode: "is", taskTypeIds: [], taskTypeIdsMode: "is", onlyLate: false, onlyMilestone: false, excludeDone: false, assigneeEmpty: false, dueWithinDays: "", pastDays: "", inactivityDays: "", datePresetField: "end", datePreset: "" };
}

// Migration douce : les widgets Mini-Gantt / Mini métro créés avant l'introduction
// du filtre complet stockaient un unique "metroProjectId" / "ganttProjectId". On les
// convertit à la volée en filtre équivalent (un seul projet coché), sans jamais
// avoir besoin de toucher aux données déjà enregistrées.
function widgetFilterFor(w) {
  if (w.filter) return w.filter;
  const legacyId = w.metroProjectId || w.ganttProjectId || null;
  return legacyId ? { ...widgetDefaultFilter(), projectIds: [legacyId] } : widgetDefaultFilter();
}

// Nombre de conditions réellement posées sur un filtre de widget — sert à dire
// d'un coup d'œil, dans une fiche, si un filtre est vide. `activeFilterCount`
// vise le filtre GLOBAL, dont la forme est différente : les deux ne sont pas
// interchangeables.
function activeWidgetFilterCount(filter) {
  const f = { ...widgetDefaultFilter(), ...(filter || {}) };
  let n = 0;
  ["projectIds", "statusIds", "taskTypeIds"].forEach((k) => { if ((f[k] || []).length) n += 1; });
  ["onlyLate", "onlyMilestone", "excludeDone", "assigneeEmpty"].forEach((k) => { if (f[k]) n += 1; });
  ["dueWithinDays", "pastDays", "inactivityDays"].forEach((k) => { if (f[k] !== "" && f[k] != null) n += 1; });
  if (f.datePreset) n += 1;
  n += countFilterGroup(f.advanced);
  return n;
}

function applyWidgetFilter(tasks, filter, ctx) {
  const f = { ...widgetDefaultFilter(), ...(filter || {}) };
  return tasks.filter((t) => {
    if (f.projectIds && f.projectIds.length) {
      // Même règle que le filtre global : une tâche à deux projets matche si SON
      // PRINCIPAL OU SON SECONDAIRE est dans la liste — sinon un widget filtré sur
      // le second projet la faisait disparaître entièrement.
      const hasNoProject = !t.projectId && !t.secondaryProjectId;
      const inList =
        (hasNoProject && f.projectIds.includes(NO_PROJECT_FILTER)) ||
        (!!t.projectId && f.projectIds.includes(t.projectId)) ||
        (!!t.secondaryProjectId && f.projectIds.includes(t.secondaryProjectId));
      if (f.projectIdsMode === "is not" ? inList : !inList) return false;
    }
    if (f.statusIds && f.statusIds.length) {
      const inList = f.statusIds.includes(t.statusId);
      if (f.statusIdsMode === "is not" ? inList : !inList) return false;
    }
    if (f.taskTypeIds && f.taskTypeIds.length) {
      const inList = f.taskTypeIds.includes(t.taskTypeId);
      if (f.taskTypeIdsMode === "is not" ? inList : !inList) return false;
    }
    if (f.onlyLate && !isTaskLate(t, ctx)) return false;
    if (f.onlyMilestone && !t.milestone) return false;
    if (f.excludeDone && isTaskDoneGlobal(t, ctx)) return false;
    if (f.assigneeEmpty && t.assignee) return false;
    {
      const inactivityThreshold = f.inactivityDays !== "" && f.inactivityDays != null
        ? Number(f.inactivityDays)
        : (f.inactivityMinDays !== "" && f.inactivityMinDays != null ? Number(f.inactivityMinDays) : null);
      if (inactivityThreshold != null && !Number.isNaN(inactivityThreshold) && taskInteractionAgeDays(t) <= inactivityThreshold) return false;
    }
    if (f.dueWithinDays !== "" && f.dueWithinDays != null) {
      const days = Number(f.dueWithinDays);
      if (!Number.isNaN(days)) {
        const todayIdx = dayIndex(iso(new Date()));
        const endIdx = dayIndex(t.end);
        if (endIdx < todayIdx || endIdx > todayIdx + days) return false;
      }
    }
    if (f.pastDays !== "" && f.pastDays != null) {
      const days = Number(f.pastDays);
      if (!Number.isNaN(days) && days >= 0 && t.end) {
        const todayIdx = dayIndex(iso(new Date()));
        const endIdx = dayIndex(t.end);
        if (endIdx < todayIdx - days) return false;
      }
    }
    if (f.datePreset) {
      if (!matchesDatePreset(t[f.datePresetField || "end"], f.datePreset)) return false;
    }
    // Groupes de conditions multiples ET/OU (imbriqués) — mécanisme le plus
    // général, utilisé notamment par le filtre de PAGE de tableau de bord.
    if (f.advanced && f.advanced.items && f.advanced.items.length > 0) {
      if (!evalFilterGroup(t, f.advanced)) return false;
    }
    return true;
  });
}

function computeKpiValue(tasks, metric, ctx) {
  if (tasks.length === 0) return metric === "avgProgress" ? "—" : 0;
  if (metric === "avgProgress") return Math.round(tasks.reduce((s, t) => s + (Number(t.progress) || 0), 0) / tasks.length) + "%";
  if (metric === "milestoneCount") return tasks.filter((t) => getTaskType(t) === "milestone").length;
  if (metric === "urgentCount") return tasks.filter((t) => isTaskUrgent(t, ctx)).length;
  return tasks.length;
}

function defaultLayoutForType(type) {
  if (type === "kpi") return { w: 3, h: 2 };
  if (type === "customCard") return { w: 5, h: 4 };
  if (type === "countdown") return { w: 3, h: 3 };
  if (type === "note") return { w: 4, h: 3 };
  if (type === "taskDetail") return { w: 8, h: 7 };
  if (type === "budget") return { w: 4, h: 3 };
  if (type === "criticalPath") return { w: 4, h: 5 };
  if (type === "heatmapMonth") return { w: 9, h: 6 };
  if (type === "milestoneTimeline") return { w: 6, h: 4 };
  if (type === "verticalMetroTimeline") return { w: 6, h: 7 };
  if (type === "metroDeadline") return { w: 8, h: 6 };
  if (type === "blockers") return { w: 5, h: 5 };
  if (type === "nextBestAction") return { w: 4, h: 6 };
  if (type === "dailyBriefing") return { w: 4, h: 7 };
  if (type === "dominoEffect") return { w: 4, h: 6 };
  if (type === "budgetBurnRate") return { w: 4, h: 5 };
  if (type === "projectTreemap") return { w: 8, h: 7 };
  if (type === "deadlineScatter") return { w: 10, h: 7 };
  if (type === "bubbles") return { w: 8, h: 7 };
  if (type === "staffing") return { w: 10, h: 7 };
  if (type === "heatmapGrid") return { w: 9, h: 7 };
  if (type === "embedMetro" || type === "embedTimeline" || type === "embedRadar") return { w: 8, h: 9 };
  return { w: 6, h: 4 }; // chart / list / minigantt
}

// === NEXORA:MINIGANTT-MIGRATION:START ===
/* Compatibilité de lecture strictement isolée (#80). `embedGantt` n'est plus
   un type créable ni rendu ; il peut seulement exister dans une sauvegarde
   antérieure. Cette migration conserve toutes les propriétés inconnues et
   l'identité du widget, afin que synchronisation, imports et duplications ne
   perdent aucune donnée utilisateur. */
const LEGACY_EMBED_GANTT_TYPE = "embed" + "Gantt";
const MINI_GANTT_DEFAULTS = {
  showMilestones: true,
  colorBy: "status",
  miniGanttFields: ["assignee", "status", "taskType", "end", "progress"],
  miniGanttFieldsLayout: "aligned",
  miniGanttSort: "start",
  miniGanttSortDir: "asc",
  miniGanttRange: { mode: "auto", includeToday: true },
  miniGanttWindow: null,
  miniGanttZoomLevel: null,
  miniGanttComparisonEnabled: false,
};
function migrateLegacyMiniGanttWidget(widget) {
  if (!widget || typeof widget !== "object" || widget.type !== LEGACY_EMBED_GANTT_TYPE) return widget;
  const next = { ...widget, type: "minigantt" };
  Object.entries(MINI_GANTT_DEFAULTS).forEach(([key, value]) => {
    if (next[key] === undefined) next[key] = Array.isArray(value) ? [...value] : (value && typeof value === "object" ? { ...value } : value);
  });
  return next;
}
function migrateLegacyMiniGanttData(value) {
  if (Array.isArray(value)) return value.map(migrateLegacyMiniGanttData);
  if (!value || typeof value !== "object") return value;
  if (value.type === LEGACY_EMBED_GANTT_TYPE) return migrateLegacyMiniGanttWidget(value);
  const next = {};
  Object.entries(value).forEach(([key, child]) => { next[key] = migrateLegacyMiniGanttData(child); });
  return next;
}
function normalizeMiniGanttViewPrefs(prefs) {
  const old = prefs && typeof prefs === "object" ? prefs : {};
  return {
    ...old,
    groupBy: old.groupBy || old.ganttGroupBy || "project",
    showMilestones: old.showMilestones !== false,
    colorBy: ["status", "project", "taskType"].includes(old.colorBy) ? old.colorBy : MINI_GANTT_DEFAULTS.colorBy,
    miniGanttFields: old.miniGanttFields || old.ganttCols || MINI_GANTT_DEFAULTS.miniGanttFields,
    miniGanttFieldsLayout: old.miniGanttFieldsLayout || "aligned",
    miniGanttSort: old.miniGanttSort || "start",
    miniGanttSortDir: old.miniGanttSortDir || "asc",
    miniGanttRange: old.miniGanttRange || MINI_GANTT_DEFAULTS.miniGanttRange,
    miniGanttWindow: old.miniGanttWindow || null,
    miniGanttZoomLevel: old.miniGanttZoomLevel ?? null,
    miniGanttComparisonEnabled: !!old.miniGanttComparisonEnabled,
    // Filtre propre à la vue, au même format que celui d'un widget — il
    // s'applique EN PLUS des filtres de la page, jamais à leur place.
    filter: old.filter && typeof old.filter === "object" ? old.filter : null,
  };
}
// === NEXORA:MINIGANTT-MIGRATION:END ===

// === NEXORA:BUBBLES:START ===
/* Widget « Bulles » (#92) — toute la logique SANS rendu vit ici, derrière ces
   sentinelles, et c'est ce bloc que `tests/bubbles.test.mjs` extrait de
   l'interface réellement construite. Aucune copie du code n'est maintenue à
   côté : si le bloc change, les tests suivent.

   Le principe du widget est repris de Bubble Plan — une bulle descriptive par
   tâche, ses champs sous la bulle, des macro-bulles qui enveloppent plusieurs
   tâches — mais tout ce qui touche à l'AXE DU TEMPS, à la fenêtre, au zoom, au
   tri et aux groupes reste celui du Mini-Gantt : ce bloc n'en redéfinit rien.
   Les deux fonctions qui ont besoin d'une brique du Mini-Gantt la reçoivent en
   ARGUMENT (`bubbleMacroSegments`) ou reçoivent son résultat déjà calculé
   (`bubbleColorMap`), plutôt que d'en refaire une variante qui divergerait. */

const BUBBLE_MACRO_DEFAULT_COLOR = "#245EDB"; // life-blue : la couleur d'action de Nexora
const BUBBLE_MACRO_DEFAULT_OPACITY = 12;
const BUBBLE_MACRO_OPACITY_MAX = 60;
const BUBBLE_MACRO_DEFAULT_BORDER_WIDTH = 1.5;
const BUBBLE_MACRO_BORDER_WIDTH_MAX = 6;
/* Marge ajoutée à chaque niveau d'imbrication. Une tâche peut appartenir à
   plusieurs macro-bulles : sans ce pas, les deux enveloppes se confondraient
   en un seul trait épais. */
const BUBBLE_MACRO_NEST_STEP = 5;
/* Dégagement minimal entre le trait d'une enveloppe et la bulle qu'elle
   entoure — même rôle que GANTT_FRAME_BAR_CLEARANCE pour les encadrés. */
const BUBBLE_MACRO_CLEARANCE = 3;
const BUBBLE_SIZES = ["compact", "normal", "large"];
/* Hauteur d'une bulle, par réglage de densité, et hauteur d'une ligne de
   description. Ces nombres vivent ICI et nulle part ailleurs : le rendu les
   pose en variable CSS et l'auto-dimensionnement du widget les relit par
   `bubbleHeightPx`. Recopiés dans la feuille de style, ils auraient fini par
   diverger, et le widget se serait redimensionné à une hauteur qui n'est pas
   celle qu'il dessine. */
const BUBBLE_HEIGHT_PX = { compact: 34, normal: 46, large: 60 };
/* Largeur minimale d'une bulle de tâche, et largeur FIXE d'une bulle de jalon.
   Toutes deux en pixels, parce qu'elles servent la lisibilité d'un titre, pas
   une durée. Elles vivent ici pour une raison précise : le rendu les applique,
   et `bubbleRowExtent` en a besoin pour dire ce qu'une bulle OCCUPE vraiment —
   sans quoi l'enveloppe d'une macro-bulle, calculée sur les seules dates,
   laisse dépasser les bulles courtes et les jalons (#104). */
const BUBBLE_MIN_PX = 90;
const BUBBLE_MILESTONE_W = 120;
const BUBBLE_DESC_LINE_PX = 13;
const BUBBLE_DESC_LINES_MAX = 3;
/* Champs proposés sous la bulle. La liste n'est pas arbitraire : ce sont
   exactement les clés que `FieldValue` — le formateur partagé avec tous les
   autres widgets — sait rendre. En proposer d'autres (un champ personnalisé,
   par exemple) afficherait une case à cocher sans effet. */
const BUBBLE_ROW_FIELD_OPTIONS = [
  "project", "status", "criticality", "taskType", "assignee",
  "start", "end", "period", "milestone", "checklist", "progress",
];
/* Dispositions des champs secondaires.

   « compact » (#122) est la version CONDENSÉE et RATTACHÉE à la bulle : un
   bandeau d'une seule ligne, collé sous elle, exactement à sa largeur, qui
   reprend son trait et sa couleur. Sa hauteur est donc CONNUE — c'est ce qui
   permet à une ligne de couloir (#120) d'avoir une hauteur prévisible sans
   mesurer quoi que ce soit. */
const BUBBLE_FIELDS_LAYOUTS = ["under", "inline", "compact"];
/* Hauteur du bandeau condensé, en pixels. Vit ici, comme BUBBLE_HEIGHT_PX, et
   pour la même raison : le rendu la pose, l'auto-dimensionnement du widget la
   relit, et la hauteur d'un couloir s'en déduit. */
/* Hauteur du bandeau condensé : UNE ligne, et une seule (#122).

   Il est passé par une version à plusieurs lignes, qui repliait les champs à la
   largeur de la bulle et régularisait la hauteur du widget. Elle répondait à la
   lettre au défaut — plus rien n'était coupé — mais le résultat était laid : un
   pavé de pastilles sous chaque bulle, plus haut que la bulle elle-même (retour
   de test). On revient donc à la ligne unique, et c'est l'INFOBULLE qui porte
   la liste complète : elle a la place, elle ne coûte aucune hauteur, et elle
   existait déjà. */
const BUBBLE_FIELDS_COMPACT_PX = 16;
/* Dispositions verticales des bulles (#120).

   « lanes » range les bulles d'un même couloir CÔTE À CÔTE sur la ligne de
   temps, et ne descend d'une ligne que lorsque deux d'entre elles se
   chevauchent vraiment — c'est le principe de Bubble Plan. « rows » garde
   l'ancien comportement, hérité du Mini-Gantt : une tâche, une ligne. */
const BUBBLE_LAYOUTS = ["lanes", "rows"];
/* Écart minimal entre deux bulles voisines d'un même couloir, en pixels. Sans
   lui, deux bulles qui se suivent d'un jour se toucheraient bord à bord et on
   lirait une seule bulle coupée d'un trait. */
const BUBBLE_LANE_GAP_PX = 8;

/* Palette de repli, pour les champs dont les valeurs n'ont PAS de couleur à
   elles (responsable, période, champ personnalisé texte). Ce sont les teintes
   déjà employées ailleurs dans Nexora — jalons, labels, treemap — et non une
   nouvelle gamme. */
const BUBBLE_PALETTE = [
  "#4F6AF5", "#22B07D", "#F2A93B", "#8B5CF6", "#0EA5E9",
  "#D64545", "#EC4899", "#14B8A6", "#6366F1", "#F97316",
];

const BUBBLES_DEFAULTS = {
  bubbleColorBy: "status",
  bubbleFields: ["assignee", "status", "end", "progress"],
  bubbleFieldsLayout: "compact",
  bubbleLayout: "lanes",
  bubbleSize: "normal",
  bubbleShowDates: true,
  bubbleShowProgress: true,
  bubbleShowDescription: false,
  bubbleDescriptionLines: 1,
  bubbleShowLegend: false,
  bubbleTruncateTitles: true,
  bubbleMacroGrouping: true,
  bubbleMacros: [],
};

function normalizeBubbleSize(value) {
  return BUBBLE_SIZES.includes(value) ? value : BUBBLES_DEFAULTS.bubbleSize;
}

/* Lignes de description : 1 à 3 (#97). Le défaut de 1 est ce que faisait la
   feuille de style avant que ce soit réglable — un widget enregistré avant ce
   réglage ne bouge donc pas d'un pixel. Le plafond de 3 n'est pas arbitraire :
   au-delà, la description occupe plus de place que le titre et l'avancement
   réunis, et la bulle cesse d'être une bulle. */
function normalizeBubbleDescriptionLines(value) {
  const n = Number(value);
  if (!Number.isFinite(n)) return BUBBLES_DEFAULTS.bubbleDescriptionLines;
  return Math.min(BUBBLE_DESC_LINES_MAX, Math.max(1, Math.round(n)));
}

/* Hauteur d'une bulle, en pixels. UNE seule fonction, appelée par le rendu
   (qui la pose en variable CSS) et par l'auto-dimensionnement du widget (qui
   calcule la hauteur de ses lignes). Les lignes de description gagnées se
   paient en hauteur : sans elles, la bulle a `overflow:hidden` et c'est le
   pied — statut et avancement — qui disparaîtrait en silence. */
function bubbleHeightPx(widget, titleExtraPx) {
  const cfg = normalizeBubblesWidget(widget);
  const base = BUBBLE_HEIGHT_PX[cfg.bubbleSize] || BUBBLE_HEIGHT_PX.normal;
  const extraLines = cfg.bubbleShowDescription ? cfg.bubbleDescriptionLines - 1 : 0;
  /* Le supplement de titre (#122) est MESURE par le rendu, jamais devine ici :
     le nombre de lignes qu'un titre occupe depend de la largeur reelle de la
     bulle, que cette fonction ne connait pas. Il vaut zero quand les titres
     sont coupes, et zero tant que rien n'a ete mesure. */
  const title = Number(titleExtraPx);
  const titleRoom = cfg.bubbleTruncateTitles || !Number.isFinite(title) ? 0 : Math.max(0, title);
  return base + Math.max(0, extraLines) * BUBBLE_DESC_LINE_PX + titleRoom;
}

/* Étendue RÉELLE d'une ligne, en index de jour : ce que sa bulle occupe, et
   non ce que ses dates disent (#104).

   Une bulle de tâche ne descend jamais sous 90 px — elle s'étend donc à droite
   de sa date de fin quand la tâche est courte. Une bulle de jalon est centrée
   sur sa date unique — elle s'étend donc des deux côtés. Une enveloppe de
   macro-bulle qui ignore ces deux faits laisse la bulle à cheval sur sa
   bordure, et cesse de dire ce qu'elle contient.

   `pxPerDay` vient de la largeur MESURÉE de la piste : sans mesure (premier
   rendu), on rend les dates telles quelles plutôt que d'inventer une marge. */
function bubbleRowExtent(row, pxPerDay) {
  if (!row) return null;
  const startIdx = Number(row.startIdx);
  const endIdx = Number(row.endIdx);
  if (!Number.isFinite(startIdx) || !Number.isFinite(endIdx)) return null;
  const px = Number(pxPerDay);
  if (!Number.isFinite(px) || px <= 0) return { startIdx, endIdx };
  if (row.milestone) {
    const halfDays = (BUBBLE_MILESTONE_W / 2) / px;
    return { startIdx: startIdx - halfDays, endIdx: endIdx + halfDays };
  }
  return { startIdx, endIdx: Math.max(endIdx, startIdx + BUBBLE_MIN_PX / px) };
}

function normalizeBubbleFieldsLayout(value) {
  return BUBBLE_FIELDS_LAYOUTS.includes(value) ? value : BUBBLES_DEFAULTS.bubbleFieldsLayout;
}

function normalizeBubbleLayout(value) {
  return BUBBLE_LAYOUTS.includes(value) ? value : BUBBLES_DEFAULTS.bubbleLayout;
}

/* Disposition RÉELLEMENT appliquée aux champs, une fois le mode de mise en page
   pris en compte (#120 + #122).

   En couloirs, une bulle a des VOISINES sur sa ligne : des champs qui s'étalent
   en plusieurs rangées (« under ») ou qui débordent à droite (« inline »)
   viendraient se poser sur elles. La seule forme qui tienne dans ce cas est le
   bandeau condensé, borné à la largeur de la bulle et haut d'une ligne. On le
   substitue donc, plutôt que d'interdire le réglage : le choix reste vrai dès
   qu'on repasse en « une tâche, une ligne ». */
function bubbleEffectiveFieldsLayout(cfg) {
  const layout = normalizeBubbleFieldsLayout(cfg && cfg.bubbleFieldsLayout);
  return normalizeBubbleLayout(cfg && cfg.bubbleLayout) === "lanes" ? "compact" : layout;
}

/* Hauteur d'une ligne de bulles, en pixels : la bulle, plus le bandeau condensé
   quand il est là. Une seule fonction, relue par le rendu (qui la pose sur la
   piste d'un couloir) et par l'auto-dimensionnement du widget. */
function bubbleLaneHeightPx(widget, titleExtraPx) {
  const cfg = normalizeBubblesWidget(widget);
  const fields = bubbleEffectiveFieldsLayout(cfg) === "compact" && cfg.bubbleFields.length
    ? BUBBLE_FIELDS_COMPACT_PX
    : 0;
  return bubbleHeightPx(widget, titleExtraPx) + fields;
}

/* Liste de champs : on garde l'ORDRE choisi par l'utilisateur (c'est l'ordre
   d'affichage sous la bulle) et on dédoublonne. Une liste vide est un choix
   légitime — la bulle se lit alors seule — et non une absence de réglage : le
   défaut ne s'y substitue que si la valeur n'est pas une liste. */
function normalizeBubbleFields(list) {
  if (!Array.isArray(list)) return [...BUBBLES_DEFAULTS.bubbleFields];
  const seen = new Set();
  const out = [];
  list.forEach((key) => {
    if (typeof key !== "string" || !key || seen.has(key)) return;
    seen.add(key);
    out.push(key);
  });
  return out;
}

function normalizeBubbleOpacity(value) {
  const n = Number(value);
  if (!Number.isFinite(n)) return BUBBLE_MACRO_DEFAULT_OPACITY;
  return Math.min(BUBBLE_MACRO_OPACITY_MAX, Math.max(0, Math.round(n)));
}

// Au demi-pixel, comme l'épaisseur d'un bloc temporel.
function normalizeBubbleBorderWidth(value) {
  const n = Number(value);
  if (!Number.isFinite(n)) return BUBBLE_MACRO_DEFAULT_BORDER_WIDTH;
  return Math.min(BUBBLE_MACRO_BORDER_WIDTH_MAX, Math.max(0, Math.round(n * 2) / 2));
}

function normalizeBubbleMacroBorderStyle(value) { return value === "dashed" ? "dashed" : "solid"; }

function isBubbleHexColor(value) {
  return typeof value === "string" && /^#[0-9a-fA-F]{6}$/.test(value);
}

/* Même style de retour que `validateTemporalBlock` : un message court sous le
   champ, et aucun enregistrement tant qu'il est présent. Une macro-bulle SANS
   tâche est valide — on la crée souvent avant de choisir ses tâches — mais
   l'éditeur signale qu'elle ne sera pas dessinée. */
function validateBubbleMacro(macro) {
  const label = macro && typeof macro.label === "string" ? macro.label.trim() : "";
  if (!label) return { ok: false, error: "Le libellé est obligatoire." };
  return { ok: true, error: "" };
}

function normalizeBubbleMacros(list) {
  if (!Array.isArray(list)) return [];
  return list
    .filter((m) => m && typeof m === "object" && m.id)
    .map((m) => ({
      ...m,
      id: String(m.id),
      label: typeof m.label === "string" ? m.label : "",
      taskIds: Array.isArray(m.taskIds) ? [...new Set(m.taskIds.filter((id) => typeof id === "string" && id))] : [],
      color: isBubbleHexColor(m.color) ? m.color : BUBBLE_MACRO_DEFAULT_COLOR,
      opacity: normalizeBubbleOpacity(m.opacity),
      borderStyle: normalizeBubbleMacroBorderStyle(m.borderStyle),
      borderWidth: normalizeBubbleBorderWidth(m.borderWidth),
      showProgress: m.showProgress !== false,
    }));
}

/* Nettoyage explicite, déclenché depuis l'éditeur uniquement — jamais au
   rendu, pour qu'un simple filtre de widget ne détruise pas une configuration.
   À la différence de `pruneHighlightFrames`, une macro-bulle vidée de toutes
   ses tâches est CONSERVÉE : elle porte un libellé et une couleur choisis à la
   main, et l'éditeur sait dire qu'elle n'est pas dessinée. */
function pruneBubbleMacros(macros, knownTaskIds) {
  const known = new Set(Array.isArray(knownTaskIds) ? knownTaskIds : []);
  return normalizeBubbleMacros(macros).map((m) => ({ ...m, taskIds: m.taskIds.filter((id) => known.has(id)) }));
}

// Remplissage et cadre calculés en UN SEUL endroit, comme ganttBlockFill /
// ganttBlockBorder pour les blocs temporels : les deux couches de rendu et
// l'aperçu de l'éditeur appellent ces fonctions.
function bubbleMacroFill(macro) {
  const color = isBubbleHexColor(macro && macro.color) ? macro.color : BUBBLE_MACRO_DEFAULT_COLOR;
  return `color-mix(in srgb, ${color} ${normalizeBubbleOpacity(macro && macro.opacity)}%, transparent)`;
}

function bubbleMacroBorder(macro) {
  const color = isBubbleHexColor(macro && macro.color) ? macro.color : BUBBLE_MACRO_DEFAULT_COLOR;
  const width = normalizeBubbleBorderWidth(macro && macro.borderWidth);
  if (width === 0) return "none";
  return `${width}px ${normalizeBubbleMacroBorderStyle(macro && macro.borderStyle)} ${color}`;
}

/* Un widget « Bulles » lu depuis le stockage : chaque réglage absent ou
   invalide retombe sur son défaut, et TOUTE propriété inconnue est conservée.
   C'est ce qui permet de passer un widget de Mini-Gantt à Bulles et
   inversement sans rien perdre : fenêtre, zoom, tri, groupes et annotations
   sont les MÊMES clés (`miniGantt*`, `ganttAnnotations`) et ne sont pas
   touchées ici — elles restent normalisées par leurs propres fonctions. */
function normalizeBubblesWidget(widget) {
  const w = widget && typeof widget === "object" ? widget : {};
  return {
    ...w,
    bubbleColorBy: typeof w.bubbleColorBy === "string" && w.bubbleColorBy ? w.bubbleColorBy : BUBBLES_DEFAULTS.bubbleColorBy,
    bubbleFields: normalizeBubbleFields(w.bubbleFields),
    bubbleFieldsLayout: normalizeBubbleFieldsLayout(w.bubbleFieldsLayout),
    bubbleLayout: normalizeBubbleLayout(w.bubbleLayout),
    bubbleSize: normalizeBubbleSize(w.bubbleSize),
    bubbleShowDates: w.bubbleShowDates !== false,
    bubbleShowProgress: w.bubbleShowProgress !== false,
    bubbleShowDescription: w.bubbleShowDescription === true,
    bubbleDescriptionLines: normalizeBubbleDescriptionLines(w.bubbleDescriptionLines),
    bubbleShowLegend: w.bubbleShowLegend === true,
    /* Titres coupes ou entiers (#122). Le defaut est COUPE : c'est le
       comportement de toutes les bulles existantes, et le changer aurait
       rallonge sans prevenir chaque ligne des tableaux de bord deja en place. */
    bubbleTruncateTitles: w.bubbleTruncateTitles !== false,
    bubbleMacroGrouping: w.bubbleMacroGrouping !== false,
    bubbleMacros: normalizeBubbleMacros(w.bubbleMacros),
  };
}

/* Teinte de repli d'une valeur de groupe, par HACHAGE de sa clé et non par son
   rang dans la liste. Le rang change dès qu'une valeur apparaît ou disparaît :
   « Jean » changerait de couleur parce qu'un autre responsable a été ajouté,
   et deux widgets affichant des sous-ensembles différents ne s'accorderaient
   jamais. Le hachage donne la même couleur à la même valeur partout et
   toujours. Deux valeurs peuvent tomber sur la même teinte — c'est le prix
   assumé de cette stabilité, et la légende lève l'ambiguïté. */
function bubblePaletteColor(key) {
  const text = key === undefined || key === null ? "" : String(key);
  let hash = 0;
  for (let i = 0; i < text.length; i += 1) hash = (hash * 31 + text.charCodeAt(i)) % 100000007;
  return BUBBLE_PALETTE[hash % BUBBLE_PALETTE.length];
}

/* La couleur d'une bulle est celle de SON GROUPE, au sens de « grouper par ».

   L'entrée est le résultat de `groupTasks(tasks, colorBy, ctx)` — la fonction
   qui sert déjà aux en-têtes de groupe, aux listes et aux graphiques. Elle
   renvoie pour chaque groupe une `color` quand la valeur en a une (statut,
   projet, type, criticité) et `var(--text-muted)` quand elle n'en a pas
   (responsable, période, texte libre). C'est exactement à ce cas-là, et à lui
   seul, que la palette de repli s'applique : reproduire ici la résolution des
   couleurs par champ serait une seconde vérité.

   Retourne une Map identifiant de tâche → { color, groupKey, groupLabel }. */
function bubbleColorMap(groups) {
  const out = new Map();
  (Array.isArray(groups) ? groups : []).forEach((group) => {
    if (!group || !Array.isArray(group.tasks)) return;
    const own = typeof group.color === "string" && group.color && !group.color.startsWith("var(") ? group.color : "";
    const color = own || bubblePaletteColor(group.key);
    group.tasks.forEach((task) => {
      if (task && task.id) out.set(task.id, { color, groupKey: String(group.key), groupLabel: group.label || "" });
    });
  });
  return out;
}

/* Légende : un rang par groupe RÉELLEMENT représenté, dans l'ordre où
   `groupTasks` les rend, avec la couleur résolue comme ci-dessus. Un groupe
   vide n'y figure pas — il n'y a rien à surligner. */
function bubbleLegendEntries(groups) {
  return (Array.isArray(groups) ? groups : [])
    .filter((group) => group && Array.isArray(group.tasks) && group.tasks.length > 0)
    .map((group) => {
      const own = typeof group.color === "string" && group.color && !group.color.startsWith("var(") ? group.color : "";
      return {
        key: String(group.key),
        label: group.label || "",
        color: own || bubblePaletteColor(group.key),
        count: group.tasks.length,
      };
    });
}

/* Géométrie d'une macro-bulle. Le découpage en séries de LIGNES CONTIGUËS est
   délégué à `ganttFrameSegments`, passée en argument : c'est la fonction déjà
   éprouvée des encadrés du Gantt, qui sait qu'un en-tête de groupe coupe la
   continuité et qui travaille sur les hauteurs MESURÉES des lignes. Des tâches
   non successives produisent donc plusieurs enveloppes, exactement comme un
   encadré — et non une enveloppe géante qui avalerait les tâches voisines.

   `nestLevel` est le rang de la macro-bulle dans la liste : il écarte les
   enveloppes qui se recouvrent, pour que deux macro-bulles partageant une
   tâche restent deux traits lisibles. */
function bubbleMacroSegments(rows, macro, frameSegments, nestLevel) {
  if (typeof frameSegments !== "function") return [];
  const normalized = normalizeBubbleMacros([macro])[0];
  if (!normalized || !normalized.taskIds.length) return [];
  const level = Number.isFinite(Number(nestLevel)) ? Math.max(0, Math.round(Number(nestLevel))) : 0;
  const padding = BUBBLE_MACRO_CLEARANCE + level * BUBBLE_MACRO_NEST_STEP;
  return frameSegments(rows, { taskIds: normalized.taskIds, padding })
    .map((seg, i) => ({ ...seg, macro: normalized, level, key: normalized.id + "-" + i }));
}

/* Avancement agrégé d'une macro-bulle, PONDÉRÉ PAR LA DURÉE : une tâche de
   trois mois à 0 % ne doit pas peser autant qu'un jalon d'un jour à 100 %.
   Les cellules arrivent déjà réduites à ce qui compte (`{ progress, days }`),
   pour que cette fonction ne dépende ni du calendrier ni du modèle de tâche.
   Aucune durée exploitable — que des jalons, par exemple — fait retomber sur
   une moyenne simple plutôt que sur une division par zéro. */
function bubbleMacroProgress(cells) {
  const list = (Array.isArray(cells) ? cells : []).filter((c) => c && typeof c === "object");
  if (!list.length) return null;
  const clamp = (v) => Math.max(0, Math.min(100, Number(v) || 0));
  const weights = list.map((c) => Math.max(0, Number(c.days) || 0));
  const total = weights.reduce((sum, w) => sum + w, 0);
  if (total <= 0) {
    return Math.round(list.reduce((sum, c) => sum + clamp(c.progress), 0) / list.length);
  }
  const weighted = list.reduce((sum, c, i) => sum + clamp(c.progress) * weights[i], 0);
  return Math.round(weighted / total);
}

/* Ordre des lignes quand « regrouper les tâches d'une macro-bulle » est actif :
   les lignes d'une même macro-bulle sont amenées côte à côte, macro-bulles
   dans leur ordre de déclaration, puis tout le reste dans l'ordre du tri
   normal. C'est ce qui donne à une macro-bulle la BANDE unique de Bubble Plan
   au lieu d'une enveloppe trouée.

   Une tâche rattachée à deux macro-bulles ne peut être qu'à un endroit : elle
   suit la PREMIÈRE qui la réclame, et l'autre se segmente autour. Option
   inactive : l'ordre reçu est rendu tel quel, sans copie inutile. */
function bubbleRowOrder(orderedIds, macros, options) {
  const ids = Array.isArray(orderedIds) ? orderedIds.filter((id) => typeof id === "string" && id) : [];
  if (!options || options.grouping === false) return ids;
  const known = new Set(ids);
  const placed = new Set();
  const out = [];
  normalizeBubbleMacros(macros).forEach((macro) => {
    macro.taskIds.forEach((id) => {
      if (!known.has(id) || placed.has(id)) return;
      placed.add(id);
      out.push(id);
    });
  });
  ids.forEach((id) => { if (!placed.has(id)) out.push(id); });
  return out;
}

/* Place libre de part et d'autre de chaque bulle d'un couloir, en pixels (#120).

   Les dates s'écrivent DEHORS, à gauche et à droite de la bulle. Seules sur
   leur ligne, elles ne recouvraient que du vide ; rangées côte à côte, elles se
   posent dans le MÊME intervalle : la date de fin de l'une à droite, la date de
   début de la suivante à gauche. Chacune croyait avoir tout l'écart pour elle,
   et les deux s'écrivaient l'une sur l'autre (retour de test).

   L'écart entre deux voisines est donc PARTAGÉ : chacune n'en compte que la
   moitié, et les deux dates ne s'écrivent que s'il y a la place pour les deux.
   Aux extrémités du couloir, il n'y a pas de voisine à ménager — `Infinity`,
   et c'est le bord de la piste qui borne, dont la bulle se charge déjà.

   L'entrée est la boîte RÉELLEMENT dessinée de chaque bulle, et non ce que
   `bubbleRowExtent` modélise : celle d'un jalon est recalée contre le bord de
   la piste dès qu'elle y dépasserait, et les deux divergent là. */
function bubbleLaneDateRoom(boxes) {
  const list = (Array.isArray(boxes) ? boxes : [])
    .filter((b) => b && b.id !== undefined && b.id !== null
      && Number.isFinite(Number(b.leftPx)) && Number.isFinite(Number(b.rightPx)))
    .map((b) => ({ id: String(b.id), leftPx: Number(b.leftPx), rightPx: Number(b.rightPx) }))
    .sort((a, b) => a.leftPx - b.leftPx);
  const room = new Map();
  list.forEach((box, i) => {
    const prev = list[i - 1];
    const next = list[i + 1];
    room.set(box.id, {
      before: prev ? Math.max(0, (box.leftPx - prev.rightPx) / 2) : Infinity,
      after: next ? Math.max(0, (next.leftPx - box.rightPx) / 2) : Infinity,
    });
  });
  return room;
}

/* Couloirs : les bulles d'un même regroupement, rangées CÔTE À CÔTE (#120).

   Le widget reprenait la géométrie du Mini-Gantt — une tâche, une ligne — et
   dix tâches disjointes dans le temps donnaient dix lignes empilées : un Gantt
   dont les barres ont été remplacées par des bulles. Ce n'est pas ce qu'on
   cherche. Dans Bubble Plan, les bulles d'un couloir se suivent
   HORIZONTALEMENT et on ne descend d'une ligne que lorsqu'il n'y a plus la
   place.

   L'algorithme est le placement au premier emplacement libre : chaque bulle
   part sur la première ligne où elle ne touche aucune de celles déjà posées,
   et une ligne de plus n'apparaît que si aucune ne convient. L'ordre reçu est
   respecté tel quel — c'est le tri choisi par l'utilisateur, et le retrier
   ici ferait mentir la colonne « ordre » du widget.

   Ce qu'on teste, c'est le CHEVAUCHEMENT À L'ÉCRAN, pas celui des dates :
   `bubbleRowExtent` sait qu'une bulle courte ne descend jamais sous 90 px et
   qu'un jalon est centré sur sa date (#104). Deux tâches d'un jour à trois
   jours d'écart ne se chevauchent pas au calendrier, mais leurs bulles se
   recouvrent largement — les mettre sur la même ligne les rendrait illisibles.

   Sans largeur de piste mesurée (premier rendu), `pxPerDay` est absent : on
   retombe sur les dates seules plutôt que d'inventer une géométrie. La mesure
   tombe à la trame suivante et le placement se refait.

   Entrée : des lignes `{ id, groupKey, startIdx, endIdx, milestone }` DÉJÀ
   bornées à la fenêtre affichée. Sortie : des couloirs `{ key, groupKey,
   index, items }`, dans l'ordre d'affichage. */
function bubbleLaneRows(rows, options) {
  const opts = options || {};
  const list = (Array.isArray(rows) ? rows : []).filter((r) => r && r.id);
  if (!list.length) return [];
  // « Une tâche, une ligne » reste un choix : un couloir par bulle, et tout le
  // reste du rendu est identique.
  if (opts.packing === false) {
    return list.map((row, index) => ({ key: String(row.id), groupKey: row.groupKey, index, items: [row] }));
  }
  const pxPerDay = Number(opts.pxPerDay);
  const hasScale = Number.isFinite(pxPerDay) && pxPerDay > 0;
  const gapPx = Number.isFinite(Number(opts.gapPx)) ? Number(opts.gapPx) : BUBBLE_LANE_GAP_PX;
  const halfGap = hasScale ? (gapPx / pxPerDay) / 2 : 0;
  const lanes = [];
  list.forEach((row) => {
    const extent = bubbleRowExtent(row, hasScale ? pxPerDay : null);
    // Une ligne sans dates exploitables n'est pas dessinée : elle ne peut pas
    // non plus réserver de place. Elle garde sa propre ligne, seule.
    if (!extent) {
      lanes.push({ items: [row], slots: [{ from: -Infinity, to: Infinity }] });
      return;
    }
    const from = extent.startIdx - halfGap;
    const to = extent.endIdx + halfGap;
    let lane = lanes.find((l) => l.slots.every((slot) => to <= slot.from || from >= slot.to));
    if (!lane) {
      lane = { items: [], slots: [] };
      lanes.push(lane);
    }
    lane.items.push(row);
    lane.slots.push({ from, to });
  });
  return lanes.map((lane, index) => ({
    key: String(lane.items[0].id) + "::lane" + index,
    groupKey: lane.items[0].groupKey,
    index,
    items: lane.items,
  }));
}
// === NEXORA:BUBBLES:END ===

function computeBudgetStats(projectId, projects, expenses) {
  const project = projects.find((p) => p.id === projectId);
  const budgetInitial = Number(project?.budgetInitial) || 0;
  const budgetActuel = Number(project?.budgetActuel) || budgetInitial;
  const projectExpenses = expenses.filter((e) => e.projectId === projectId);
  const totals = { engagee: 0, facturee: 0, payee: 0 };
  projectExpenses.forEach((e) => { const s = statusOf(e); totals[s] = (totals[s] || 0) + (Number(e.amount) || 0); });
  const consumed = (totals.engagee || 0) + (totals.facturee || 0) + (totals.payee || 0);
  const reste = budgetActuel - consumed;
  const pct = budgetActuel > 0 ? Math.round((consumed / budgetActuel) * 100) : 0;
  return {
    project, budgetInitial, budgetActuel,
    totalEngage: totals.engagee || 0, totalFacturee: totals.facturee || 0, totalPayee: totals.payee || 0,
    consumed, reste, pct, projectExpenses,
  };
}


// ---- Grille libre : chaque widget a une position (x,y) et une taille (w,h)
// exprimées en unités de grille (12 colonnes). Déplacement et redimensionnement
// se font à la souris, avec un aperçu en transform pendant le geste puis un
// "snap" sur la grille au relâchement — même logique que le drag des
// sous-tâches dans la vue Planning Projets (subDragRef plus haut dans ce fichier).
// === NEXORA:DASHBOARD-GRID:START ===
const DASHBOARD_COLS = 12;
const DASHBOARD_ROW_H = 68;
const DASHBOARD_GAP = 14;
/* Hauteur d'un widget, en unités de grille : plancher et plafond (#119).

   Le plafond valait 12 unités — environ 970 px — et il était recopié à QUATRE
   endroits : les deux calculs de redimensionnement, le clamp en pixels de
   l'aperçu pendant le geste, et le dimensionnement automatique. Un widget
   Bulles ou Gantt de trente lignes butait dessus : la poignée descendait, le
   widget ne grandissait plus. Le plafond ne disparaît pas — une valeur infinie
   ferait d'un glissement maladroit un widget de dix écrans — mais il est porté
   assez haut pour qu'on ne le rencontre plus en travaillant, et il vit
   désormais dans UNE constante que tout le monde relit. */
const DASHBOARD_MIN_ROWS = 2;
const DASHBOARD_MAX_ROWS = 60;

/* Hauteur ramenée dans ses bornes. `maxRows` est le plafond LOCAL du geste en
   cours — un redimensionnement par un coin HAUT garde le bord bas où il est, et
   ne peut donc pas dépasser `y + h`. Il ne remplace pas le plafond global : il
   s'y ajoute, et c'est le plus bas des deux qui gagne. */
function clampWidgetRows(rows, maxRows) {
  const n = Number(rows);
  if (!Number.isFinite(n)) return DASHBOARD_MIN_ROWS;
  const local = Number(maxRows);
  const ceiling = Number.isFinite(local)
    ? Math.max(DASHBOARD_MIN_ROWS, Math.min(DASHBOARD_MAX_ROWS, local))
    : DASHBOARD_MAX_ROWS;
  return Math.max(DASHBOARD_MIN_ROWS, Math.min(ceiling, Math.round(n)));
}

// Hauteur en pixels d'un widget de `rows` unités, gouttière comprise : la même
// conversion pour l'aperçu du geste et pour le dimensionnement automatique.
function dashboardRowsToPx(rows) {
  return (DASHBOARD_ROW_H + DASHBOARD_GAP) * Math.max(0, Number(rows) || 0) - DASHBOARD_GAP;
}
// === NEXORA:DASHBOARD-GRID:END ===

// Bin-packing "skyline" : place les widgets sans layout les uns après les
// autres, dans le premier espace libre en partant du haut, comme le ferait un
// mur de briques. Utilisé à l'ouverture (widgets importés d'une session
// précédente) et à l'ajout d'un nouveau widget.
function packWidgets(widgets) {
  const colHeights = new Array(DASHBOARD_COLS).fill(0);
  return widgets.map((w) => {
    if (w.layout && Number.isFinite(w.layout.x) && Number.isFinite(w.layout.y)) {
      const { x, y, w: ww, h } = w.layout;
      for (let c = x; c < x + ww; c++) colHeights[c] = Math.max(colHeights[c], y + h);
      return w;
    }
    const { w: ww, h } = defaultLayoutForType(w.type);
    let bestX = 0, bestY = Infinity;
    for (let x = 0; x <= DASHBOARD_COLS - ww; x++) {
      let y = 0;
      for (let c = x; c < x + ww; c++) y = Math.max(y, colHeights[c]);
      if (y < bestY) { bestY = y; bestX = x; }
    }
    for (let c = bestX; c < bestX + ww; c++) colHeights[c] = bestY + h;
    return { ...w, layout: { x: bestX, y: bestY, w: ww, h } };
  });
}

function WidgetFrame({ title, titleColor, titleEmoji, bandColor, onEdit, onDelete, onDuplicate, onAutoSize, onMoveUp, onMoveDown, onHeaderMouseDown, onResizeMouseDown, children, style, dragging, hasHeaderToolbar, className }) {
  const [headerToolbarNode, setHeaderToolbarNode] = useState(null);
  // onMoveUp/onMoveDown ne sont fournis que par la pile mobile (voir
  // DashboardView) : le glisser-déposer souris (onHeaderMouseDown/
  // onResizeMouseDown) reste le mécanisme de réorganisation ≥640px, inchangé.
  const showMoveButtons = onMoveUp !== undefined || onMoveDown !== undefined;
  return (
    <div className={"lp-widget-card" + (dragging ? " lp-widget-card-dragging" : "") + (className ? " " + className : "")} style={style}>
      <div className="lp-widget-head" onPointerDown={onHeaderMouseDown} style={bandColor ? { background: bandColor } : undefined}>
        <span className="lp-drag-handle" title="Glisser pour déplacer"><GripVertical size={13} /></span>
        {titleEmoji && <IconGlyph icon={titleEmoji} size={14} />}
        <span className="lp-widget-title" style={titleColor ? { color: titleColor } : undefined}>{title}</span>
        {hasHeaderToolbar && <div className="lp-widget-head-toolbar" onMouseDown={(e) => e.stopPropagation()} ref={setHeaderToolbarNode} />}
        {showMoveButtons && (
          <span className="lp-widget-move-group">
            <button className="lp-icon-btn" disabled={!onMoveUp} onMouseDown={(e) => e.stopPropagation()} onClick={onMoveUp} title="Monter ce widget" aria-label="Monter ce widget"><ChevronUp size={15} /></button>
            <button className="lp-icon-btn" disabled={!onMoveDown} onMouseDown={(e) => e.stopPropagation()} onClick={onMoveDown} title="Descendre ce widget" aria-label="Descendre ce widget"><ChevronDown size={15} /></button>
          </span>
        )}
        {onAutoSize && <button className="lp-icon-btn" onMouseDown={(e) => e.stopPropagation()} onClick={onAutoSize} title="Dimensionner automatiquement selon le contenu" style={titleColor ? { color: titleColor } : undefined}><Wand2 size={13} /></button>}
        <button className="lp-icon-btn" onMouseDown={(e) => e.stopPropagation()} onClick={onDuplicate} title="Dupliquer ce widget" style={titleColor ? { color: titleColor } : undefined}><Copy size={13} /></button>
        <button className="lp-icon-btn" onMouseDown={(e) => e.stopPropagation()} onClick={onEdit} title="Configurer ce widget" style={titleColor ? { color: titleColor } : undefined}><Settings size={13} /></button>
        <button className="lp-icon-btn" onMouseDown={(e) => e.stopPropagation()} onClick={onDelete} title="Supprimer ce widget" style={titleColor ? { color: titleColor } : undefined}><Trash2 size={13} /></button>
      </div>
      <div className="lp-widget-body">{typeof children === "function" ? children(headerToolbarNode) : children}</div>
      {/* Redimensionnement par n'importe lequel des 4 coins — le coin opposé reste fixe. */}
      <div className="lp-widget-resize-handle lp-widget-resize-tl" onPointerDown={onResizeMouseDown("tl")} title="Glisser pour redimensionner" />
      <div className="lp-widget-resize-handle lp-widget-resize-tr" onPointerDown={onResizeMouseDown("tr")} title="Glisser pour redimensionner" />
      <div className="lp-widget-resize-handle lp-widget-resize-bl" onPointerDown={onResizeMouseDown("bl")} title="Glisser pour redimensionner" />
      <div className="lp-widget-resize-handle lp-widget-resize-br" onPointerDown={onResizeMouseDown("br")} title="Glisser pour redimensionner" />
    </div>
  );
}

function DashboardView({ tasks, ctx, widgets, setWidgets, onOpen, toolbarSlot, tabsSlot, expenses, expenseCategories, dashboardName, appearance, onViewDay, activityLog, myName, pages, activePageId, onSwitchPage, onAddPage, onRenamePage, onDeletePage, onDuplicatePage, onUpdatePageFilter, onUpdatePageMeta, taskBaselines, setTasks, pushToast, shortcutPrefs, metaTemporalBlocks, dashboardId, onOpenProject, onEditProject, boardId, transferBoards, onTransferWidget, tasksBeforeSearch, staffing, setStaffing, setWorkshops }) {
  const [editingPageId, setEditingPageId] = useState(null); // page en cours de renommage (double-clic)
  const [editingPageName, setEditingPageName] = useState("");
  const [editingWidget, setEditingWidget] = useState(null); // null | "new" | widget à modifier
  const [filterPageTarget, setFilterPageTarget] = useState(null); // page dont le filtre est en cours d'édition

  useEffect(() => {
    const onCreateWidgetShortcut = () => setEditingWidget("new");
    window.addEventListener("nexora:create-widget", onCreateWidgetShortcut);
    return () => window.removeEventListener("nexora:create-widget", onCreateWidgetShortcut);
  }, []);
  const gridRef = useRef(null);
  const [gridWidth, setGridWidth] = useState(960);
  const [gesture, setGesture] = useState(null); // { id, mode: "move"|"resize", dx, dy }
  const gestureRef = useRef(null);
  const activePage = (pages || []).find((p) => p.id === activePageId) || (pages || [])[0];
  // Le filtre de PAGE s'applique en base à tous ses widgets, combiné en ET
  // avec le filtre propre à chaque widget — jamais l'un à la place de l'autre.
  const pageFilteredTasks = useMemo(() => applyWidgetFilter(tasks, activePage?.filter, ctx), [tasks, activePage, ctx]);
  // Méta blocs applicables ici : ceux qui visent ce tableau de bord, et ceux
  // qui valent pour tous. Hors tableau de bord (page « Aujourd'hui »),
  // dashboardId vaut null et seuls les seconds s'appliquent.
  const scopedMetaBlocks = useMemo(
    () => metaBlocksForDashboard(metaTemporalBlocks, dashboardId),
    [metaTemporalBlocks, dashboardId]
  );

  // S'assure que tous les widgets ont un layout (migration douce des tableaux de bord existants).
  useEffect(() => {
    if (widgets.some((w) => !w.layout)) setWidgets((prev) => packWidgets(prev));
  }, [widgets, setWidgets]);

  useEffect(() => {
    const el = gridRef.current;
    if (!el) return;
    const update = () => setGridWidth(el.clientWidth || 960);
    update();
    const ro = new ResizeObserver(update);
    ro.observe(el);
    return () => ro.disconnect();
  }, [widgets.length === 0]); // le conteneur n'existe pas tant qu'aucun widget n'est présent : on retente l'accroche dès qu'il apparaît

  const cellW = (gridWidth - (DASHBOARD_COLS - 1) * DASHBOARD_GAP) / DASHBOARD_COLS;
  const px = (n) => n * (cellW + DASHBOARD_GAP);
  const py = (n) => n * (DASHBOARD_ROW_H + DASHBOARD_GAP);
  const gridHeight = widgets.length ? Math.max(...widgets.map((w) => (w.layout ? w.layout.y + w.layout.h : 0))) : 0;
  // Sous ~640px, la grille libre à positionnement absolu (pensée pour la souris)
  // devient une colonne unique en flux normal — mêmes widgets, mêmes données,
  // juste une autre présentation. gridWidth vient du ResizeObserver déjà en
  // place ci-dessus : pas de nouvel écouteur resize.
  const isMobileStack = gridWidth < 640;
  const stackOrder = (w) => (w.layout ? w.layout.y * 1000 + w.layout.x : 0);
  const stackedWidgets = useMemo(
    () => (isMobileStack ? [...widgets].sort((a, b) => stackOrder(a) - stackOrder(b)) : widgets),
    [isMobileStack, widgets]
  );

  const updateWidget = (id, patch) => setWidgets((prev) => prev.map((w) => (w.id === id ? { ...w, ...patch } : w)));

  const computeResizedLayout = (layout, corner, rawDx, rawDy) => {
    const cellUnit = cellW + DASHBOARD_GAP;
    const rowUnit = DASHBOARD_ROW_H + DASHBOARD_GAP;
    const dCols = Math.round(rawDx / cellUnit);
    const dRows = Math.round(rawDy / rowUnit);

    let { x, y, w, h } = layout;

    if (corner === "br") {
      w = clamp(w + dCols, 2, DASHBOARD_COLS - x);
      h = clampWidgetRows(h + dRows);
    } else if (corner === "bl") {
      const newW = clamp(w - dCols, 2, x + w);
      x = x + w - newW;
      w = newW;
      h = clampWidgetRows(h + dRows);
    } else if (corner === "tr") {
      const newH = clampWidgetRows(h - dRows, y + h);
      y = y + h - newH;
      h = newH;
      w = clamp(w + dCols, 2, DASHBOARD_COLS - x);
    } else if (corner === "tl") {
      const newW = clamp(w - dCols, 2, x + w);
      x = x + w - newW;
      w = newW;
      const newH = clampWidgetRows(h - dRows, y + h);
      y = y + h - newH;
      h = newH;
    }

    x = clamp(x, 0, DASHBOARD_COLS - w);
    y = Math.max(0, y);

    return { x, y, w, h };
  };

  // Conversion d'une taille pixel réelle vers la grille.
  // Le coin opposé est conservé strictement en coordonnées de grille.
  const snapResizeBoxToLayout = (baseLayout, corner, box) => {
    const cellUnit = cellW + DASHBOARD_GAP;
    const rowUnit = DASHBOARD_ROW_H + DASHBOARD_GAP;

    const newW = clamp(
      Math.round((box.width + DASHBOARD_GAP) / cellUnit),
      2,
      DASHBOARD_COLS
    );
    const newH = clampWidgetRows(Math.round((box.height + DASHBOARD_GAP) / rowUnit));

    let x = baseLayout.x;
    let y = baseLayout.y;
    let w = newW;
    let h = newH;

    if (corner === "tl" || corner === "bl") {
      const fixedRight = baseLayout.x + baseLayout.w;
      w = clamp(newW, 2, fixedRight);
      x = fixedRight - w;
    } else {
      w = clamp(newW, 2, DASHBOARD_COLS - baseLayout.x);
    }

    if (corner === "tl" || corner === "tr") {
      const fixedBottom = baseLayout.y + baseLayout.h;
      h = clampWidgetRows(newH, fixedBottom);
      y = Math.max(0, fixedBottom - h);
    }

    return {x,y,w,h};
  };

  const layoutsOverlap = (a, b) => (
    a.x < b.x + b.w &&
    a.x + a.w > b.x &&
    a.y < b.y + b.h &&
    a.y + a.h > b.y
  );

  // Conserve le widget redimensionné à sa place et pousse uniquement les
  // widgets réellement en collision vers le bas. Le traitement est récursif :
  // un widget déplacé peut lui-même pousser celui qui se trouve dessous.
  const applyResizeWithCollisionPush = (widgetId, nextLayout) => {
    setWidgets(prev => {
      const next = prev.map(w => w.id === widgetId ? { ...w, layout: nextLayout } : { ...w, layout: { ...w.layout } });
      const changed = next.find(w => w.id === widgetId);
      if (!changed?.layout) return next;

      const queue = [changed.id];
      const seen = new Set();

      while (queue.length) {
        const sourceId = queue.shift();
        const source = next.find(w => w.id === sourceId);
        if (!source?.layout) continue;

        for (const other of next) {
          if (other.id === source.id || other.id === widgetId || !other.layout) continue;
          if (!layoutsOverlap(source.layout, other.layout)) continue;

          const newY = source.layout.y + source.layout.h;
          if (newY > other.layout.y) {
            other.layout = { ...other.layout, y: newY };
            queue.push(other.id);
          }
        }

        if (seen.has(sourceId)) continue;
        seen.add(sourceId);
      }

      return next;
    });
  };

  // Réorganisation tactile : le glisser-déposer desktop (souris) n'est pas
  // praticable au doigt sur une pile pleine largeur — on échange simplement le
  // rang (layout.y) avec le voisin, au tap, sans toucher x/w/h ni au moteur de
  // glisser-déposer existant (qui reste inchangé et utilisé tel quel ≥640px).
  const moveWidgetInStack = (id, dir) => {
    const idx = stackedWidgets.findIndex((w) => w.id === id);
    const swapWith = stackedWidgets[idx + dir];
    if (idx < 0 || !swapWith) return;
    const current = stackedWidgets[idx];
    setWidgets((prev) => prev.map((w) => {
      if (w.id === current.id) return { ...w, layout: { ...w.layout, y: swapWith.layout.y, x: swapWith.layout.x } };
      if (w.id === swapWith.id) return { ...w, layout: { ...w.layout, y: current.layout.y, x: current.layout.x } };
      return w;
    }));
  };
  const removeWidget = (id) => {
    const removed = widgets.find((w) => w.id === id);
    setWidgets((prev) => prev.filter((w) => w.id !== id));
    if (removed && pushToast) {
      pushToast({
        message: `Widget « ${removed.title || "Widget"} » supprimé.`,
        actionLabel: "Annuler",
        onAction: () => setWidgets((prev) => (prev.some((w) => w.id === removed.id) ? prev : [...prev, removed])),
      });
    }
  };
  const duplicateWidget = (w) => setWidgets((prev) => packWidgets([...prev, { ...w, id: uid(), title: (w.title || "Widget") + " (copie)", layout: undefined }]));
  const saveWidget = (data) => {
    if (editingWidget === "new") setWidgets((prev) => packWidgets([...prev, { id: uid(), ...data }]));
    else setWidgets((prev) => prev.map((w) => (w.id === editingWidget.id ? { ...w, ...data } : w)));
    setEditingWidget(null);
  };
  /* Changer de tableau de bord depuis la fiche du widget (issue #58).

     Le transfert ne passe PAS par setWidgets : celui-ci n'écrit que dans la page
     affichée, alors qu'un transfert touche deux pages — parfois dans deux
     magasins différents. Il remonte donc jusqu'à l'application, qui écrit les
     deux d'un coup. Les réglages en cours dans la fiche (`data`) partent avec le
     widget : sans eux, « Enregistrer » et « Changer de tableau de bord »
     se contrediraient. */
  const transferEditedWidget = ({ data, target, mode }) => {
    if (!editingWidget || editingWidget === "new" || !onTransferWidget) return;
    onTransferWidget({ widgetId: editingWidget.id, target, mode, patch: data });
    setEditingWidget(null);
  };

  // Dimensionnement automatique : recalcule la hauteur idéale d'après le contenu
  // réel du widget (nombre de lignes pour la Liste/le Mini-Gantt, nombre de troncs
  // pour la Mini métro) à la largeur actuelle — sans jamais empêcher un
  // redimensionnement manuel ensuite, puisqu'il ne fait que réécrire layout.h une fois.
  const autoSizeWidget = (w) => {
    const def = defaultLayoutForType(w.type);
    const targetW = w.layout?.w || def.w;
    const FRAME_CHROME_PX = 68; // en-tête + paddings du cadre widget
    let targetHPx;
    if (w.type === "taskDetail") {
      targetHPx = 510;
    } else if (w.type === "metroDeadline") {
      const scoped = applyWidgetFilter(pageFilteredTasks, widgetFilterFor(w), ctx).filter((t) => t.end);
      const projectCount = Math.max(1, new Set(scoped.map((t) => t.projectId).filter(Boolean)).size);
      targetHPx = 54 + projectCount * 82 + FRAME_CHROME_PX;
    } else if (w.type === "minigantt") {
      const scopedAll = applyWidgetFilter(pageFilteredTasks, widgetFilterFor(w), ctx);
      const scoped = scopedAll.filter((t) => !t.milestone && t.start && t.end);
      const scopedMilestones = w.showMilestones !== false ? scopedAll.filter((t) => t.milestone && t.end) : [];
      const rows = Math.max(1, Math.min(20, scoped.length)) + Math.min(12, scopedMilestones.length);
      const groupCount = w.groupBy && w.groupBy !== "none" ? groupTasks([...scoped, ...scopedMilestones], w.groupBy, ctx).filter((g) => g.tasks.length > 0).length : 0;
      targetHPx = 50 /* axe : zoom + actions d'annotation */ + rows * 20 + groupCount * 22 /* en-têtes de groupe */ + FRAME_CHROME_PX;
    } else if (w.type === "bubbles") {
      /* Même comptage de lignes que le Mini-Gantt, mais une ligne de bulles
         est bien plus haute qu'une barre de 9 px : hauteur de la bulle (selon
         le réglage), plus une ligne de champs quand ils sont rangés dessous. */
      const scopedAll = applyWidgetFilter(pageFilteredTasks, widgetFilterFor(w), ctx);
      const scoped = scopedAll.filter((t) => !t.milestone && t.start && t.end);
      const scopedMilestones = w.showMilestones !== false ? scopedAll.filter((t) => t.milestone && t.end) : [];
      const rows = Math.max(1, Math.min(20, scoped.length)) + Math.min(12, scopedMilestones.length);
      const groupCount = w.groupBy && w.groupBy !== "none" ? groupTasks([...scoped, ...scopedMilestones], w.groupBy, ctx).filter((g) => g.tasks.length > 0).length : 0;
      const cfg = normalizeBubblesWidget(w);
      /* En couloirs (#120), une ligne porte PLUSIEURS bulles : compter une
         ligne par tâche réserverait cinq fois la hauteur utile. Le nombre de
         lignes est alors estimé par le plus grand nombre de tâches qui se
         chevauchent au même moment — le plancher théorique du rangement — plus
         une, parce que la largeur minimale d'une bulle en ajoute presque
         toujours une. La largeur de la piste n'est pas connue ici : mieux vaut
         une estimation honnête qu'une mesure inventée, et le
         redimensionnement manuel reste toujours possible ensuite. */
      const packedRows = (list) => {
        const bounds = [];
        list.forEach((t) => {
          const from = new Date(t.milestone ? t.end : t.start).getTime();
          const to = new Date(t.end).getTime();
          if (Number.isFinite(from) && Number.isFinite(to)) bounds.push({ from, to: Math.max(from, to) });
        });
        if (!bounds.length) return 1;
        let peak = 1;
        bounds.forEach((a) => {
          const overlap = bounds.filter((b) => a.from <= b.to && b.from <= a.to).length;
          if (overlap > peak) peak = overlap;
        });
        return Math.min(rows, peak + 1);
      };
      const bubbleRows = normalizeBubbleLayout(cfg.bubbleLayout) === "lanes"
        ? packedRows([...scoped, ...scopedMilestones])
        : rows;
      /* La hauteur d'une LIGNE de bulles dépend de la densité, des lignes de
         description ET du bandeau condensé : une seule fonction la donne,
         celle que le rendu utilise. Les champs « sous la bulle » gardent leur
         rangée de pastilles, plus haute. */
      const laneH = bubbleLaneHeightPx(w);
      const fieldsH = bubbleEffectiveFieldsLayout(cfg) === "under" && cfg.bubbleFields.length ? 20 : 0;
      const legendH = cfg.bubbleShowLegend ? 22 : 0;
      targetHPx = 50 + bubbleRows * (laneH + fieldsH + 10) + groupCount * 22 + legendH + FRAME_CHROME_PX;
    } else if (w.type === "staffing") {
      /* Une ligne par PERSONNE retenue — le widget ne montre pas des tâches,
         son dimensionnement ne se déduit donc pas du filtre de tâches. */
      const cfg = normalizeStaffingWidget(w);
      const rows = Math.max(1, staffingVisibleMembers(ctx.teamMembers, cfg.staffingMembers, cfg.staffingExtraMembers).length);
      targetHPx = 40 /* barre de navigation */ + 28 /* en-tête des jours */
        + rows * 34 + 22 /* pied « personnes affectées » */ + 26 /* légende */ + FRAME_CHROME_PX;
    } else if (w.type === "list") {
      const scoped = applyWidgetFilter(pageFilteredTasks, widgetFilterFor(w), ctx);
      const rows = Math.max(1, Math.min(w.limit || 6, scoped.length));
      const groupCount = w.groupBy && w.groupBy !== "none" ? groupTasks(scoped.slice(0, w.limit || 6), w.groupBy, ctx).filter((g) => g.tasks.length > 0).length : 0;
      targetHPx = rows * 26 + groupCount * 20 + FRAME_CHROME_PX;
    } else {
      updateWidget(w.id, { layout: { ...w.layout, w: def.w, h: def.h } });
      return;
    }
    const targetHUnits = clampWidgetRows(Math.ceil((targetHPx + DASHBOARD_GAP) / (DASHBOARD_ROW_H + DASHBOARD_GAP)));
    updateWidget(w.id, { layout: { ...w.layout, w: targetW, h: targetHUnits } });
  };

  // ==========================================================================
  // Moteur unique déplacement + redimensionnement.
  //
  // Règle essentielle : la géométrie finale vient TOUJOURS de la dernière
  // position effectivement reçue pendant pointermove. On ne recalcule jamais
  // à partir de pointerup : certains navigateurs renvoient alors des coordonnées
  // différentes/stales, ce qui expliquait le "retour" du widget au relâchement.
  // ==========================================================================
  const finishWidgetPointerGesture = (g, cancelled=false) => {
    if (!g) return;

    try {
      if (g.handle?.hasPointerCapture?.(g.pointerId)) {
        g.handle.releasePointerCapture(g.pointerId);
      }
    } catch (_) {}

    g.handle?.removeEventListener("pointermove",g.onMove);
    g.handle?.removeEventListener("pointerup",g.onUp);
    g.handle?.removeEventListener("pointercancel",g.onCancel);
    g.handle?.removeEventListener("lostpointercapture",g.onLostCapture);

    if (!cancelled) {
      if (g.mode === "move") {
        const finalDx = Number(g.lastDx) || 0;
        const finalDy = Number(g.lastDy) || 0;
        const cellUnit = cellW + DASHBOARD_GAP;
        const rowUnit = DASHBOARD_ROW_H + DASHBOARD_GAP;

        const dCols = Math.round(finalDx / cellUnit);
        const dRows = Math.round(finalDy / rowUnit);
        const nx = clamp(g.layout.x + dCols,0,DASHBOARD_COLS-g.layout.w);
        const ny = Math.max(0,g.layout.y + dRows);

        updateWidget(g.id,{layout:{...g.layout,x:nx,y:ny}});
      } else if (g.mode === "resize") {
        const finalBox = g.lastBox || g.baseBox;
        const nextLayout = snapResizeBoxToLayout(g.layout,g.corner,finalBox);
        applyResizeWithCollisionPush(g.id,nextLayout);
      }
    }

    gestureRef.current=null;
    setGesture(null);
    document.body.style.userSelect="";
    document.body.style.cursor="";
  };

  const bindPointerGestureListeners = (g) => {
    const onMove = (ev) => {
      if (ev.pointerId !== g.pointerId) return;
      ev.preventDefault();

      if (g.mode === "move") {
        // Stocké dans la ref : cette valeur est la source de vérité au relâchement.
        g.lastClientX = ev.clientX;
        g.lastClientY = ev.clientY;
        g.lastDx = ev.clientX - g.startX;
        g.lastDy = ev.clientY - g.startY;

        setGesture({
          id:g.id,
          mode:"move",
          dx:g.lastDx,
          dy:g.lastDy,
        });
        return;
      }

      const box = g.boxFromPointer(ev.clientX,ev.clientY);
      g.lastClientX=ev.clientX;
      g.lastClientY=ev.clientY;
      g.lastBox=box;

      setGesture({
        id:g.id,
        mode:"resize-"+g.corner,
        previewPx:box,
      });
    };

    const onUp = (ev) => {
      if (ev.pointerId !== g.pointerId) return;
      ev.preventDefault();
      // IMPORTANT : ne pas utiliser ev.clientX/Y ici.
      finishWidgetPointerGesture(g,false);
    };

    const onCancel = (ev) => {
      if (ev.pointerId !== g.pointerId) return;
      finishWidgetPointerGesture(g,true);
    };

    const onLostCapture = () => {
      // Si pointerup a déjà finalisé, gestureRef est nul. Sinon on valide avec
      // la dernière position connue, plutôt que de jeter le mouvement.
      if (gestureRef.current === g) finishWidgetPointerGesture(g,false);
    };

    g.onMove=onMove;
    g.onUp=onUp;
    g.onCancel=onCancel;
    g.onLostCapture=onLostCapture;

    g.handle.addEventListener("pointermove",onMove,{passive:false});
    g.handle.addEventListener("pointerup",onUp,{passive:false});
    g.handle.addEventListener("pointercancel",onCancel,{passive:false});
    g.handle.addEventListener("lostpointercapture",onLostCapture);
  };

  const startMoveGesture = (widget) => (e) => {
    if (e.button !== undefined && e.button !== 0) return;
    if (!gridRef.current) return;

    // Ne jamais démarrer un déplacement depuis un bouton ou un contrôle contenu
    // dans l'en-tête. Les handlers stopPropagation restent en place, mais ce
    // garde-fou évite les cas où un enfant change entre pointerdown et render.
    if (e.target?.closest?.("button,input,select,textarea,a,.lp-widget-head-toolbar")) return;

    e.preventDefault();
    e.stopPropagation();

    const handle=e.currentTarget;
    const pointerId=e.pointerId;

    try { handle.setPointerCapture(pointerId); } catch (_) {}

    const g={
      id:widget.id,
      mode:"move",
      pointerId,
      handle,
      startX:e.clientX,
      startY:e.clientY,
      lastClientX:e.clientX,
      lastClientY:e.clientY,
      lastDx:0,
      lastDy:0,
      layout:{...widget.layout},
    };

    gestureRef.current=g;
    document.body.style.userSelect="none";
    document.body.style.cursor="grabbing";
    setGesture({id:widget.id,mode:"move",dx:0,dy:0});

    bindPointerGestureListeners(g);
  };

  const startResizeGesture = (corner,widget) => (e) => {
    if (e.button !== undefined && e.button !== 0) return;
    if (!gridRef.current) return;

    e.preventDefault();
    e.stopPropagation();

    const handle=e.currentTarget;
    const card=handle.closest(".lp-widget-card");
    if (!card) return;

    const pointerId=e.pointerId;
    const gridRect=gridRef.current.getBoundingClientRect();
    const cardRect=card.getBoundingClientRect();

    try { handle.setPointerCapture(pointerId); } catch (_) {}

    const baseBox={
      left:cardRect.left-gridRect.left,
      top:cardRect.top-gridRect.top,
      width:cardRect.width,
      height:cardRect.height,
      right:cardRect.right-gridRect.left,
      bottom:cardRect.bottom-gridRect.top,
    };

    const minWidth=Math.max(80,(cellW+DASHBOARD_GAP)*2-DASHBOARD_GAP);
    const minHeight=Math.max(80,dashboardRowsToPx(DASHBOARD_MIN_ROWS));
    const maxHeight=Math.max(minHeight,dashboardRowsToPx(DASHBOARD_MAX_ROWS));

    const boxFromPointer=(clientX,clientY)=>{
      const gx=clientX-gridRect.left;
      const gy=clientY-gridRect.top;

      let left=baseBox.left;
      let top=baseBox.top;
      let width=baseBox.width;
      let height=baseBox.height;

      if(corner==="br"){
        width=clamp(gx-baseBox.left,minWidth,Math.max(minWidth,gridRect.width-baseBox.left));
        height=clamp(gy-baseBox.top,minHeight,maxHeight);
      }else if(corner==="bl"){
        left=clamp(gx,0,baseBox.right-minWidth);
        width=baseBox.right-left;
        height=clamp(gy-baseBox.top,minHeight,maxHeight);
      }else if(corner==="tr"){
        width=clamp(gx-baseBox.left,minWidth,Math.max(minWidth,gridRect.width-baseBox.left));
        top=clamp(gy,0,baseBox.bottom-minHeight);
        height=clamp(baseBox.bottom-top,minHeight,maxHeight);
        top=baseBox.bottom-height;
      }else if(corner==="tl"){
        left=clamp(gx,0,baseBox.right-minWidth);
        width=baseBox.right-left;
        top=clamp(gy,0,baseBox.bottom-minHeight);
        height=clamp(baseBox.bottom-top,minHeight,maxHeight);
        top=baseBox.bottom-height;
      }

      return {left,top,width,height};
    };

    const cursor=({
      tl:"nwse-resize",
      br:"nwse-resize",
      tr:"nesw-resize",
      bl:"nesw-resize",
    })[corner]||"nwse-resize";

    const g={
      id:widget.id,
      mode:"resize",
      corner,
      pointerId,
      handle,
      layout:{...widget.layout},
      baseBox,
      lastBox:baseBox,
      lastClientX:e.clientX,
      lastClientY:e.clientY,
      boxFromPointer,
    };

    gestureRef.current=g;
    document.body.style.userSelect="none";
    document.body.style.cursor=cursor;
    setGesture({id:widget.id,mode:"resize-"+corner,previewPx:baseBox});

    bindPointerGestureListeners(g);
  };

  const pagesBarNode = pages && pages.length > 0 && (
    <div className={"lp-dashboard-pages-bar" + (tabsSlot ? " lp-dashboard-pages-bar-inline" : "")}>
      {pages.map((p) => {
        const hasPageFilter = p.filter && Object.entries(p.filter).some(([k, v]) => {
          if (k === "projectIdsMode" || k === "statusIdsMode" || k === "datePresetField") return false;
          if (k === "advanced") return countFilterGroup(v) > 0;
          return Array.isArray(v) ? v.length > 0 : (v !== "" && v !== false && v != null);
        });
        return (
          <div
            key={p.id}
            className={"lp-dashboard-page-tab" + (p.id === activePageId ? " active" : "")}
            onClick={() => editingPageId !== p.id && onSwitchPage(p.id)}
            onContextMenu={(e) => { e.preventDefault(); setFilterPageTarget(p); }}
          >
            {editingPageId === p.id ? (
              <input
                autoFocus
                className="lp-dashboard-page-tab-input"
                value={editingPageName}
                onClick={(e) => e.stopPropagation()}
                onChange={(e) => setEditingPageName(e.target.value)}
                onBlur={() => { onRenamePage(p.id, editingPageName); setEditingPageId(null); }}
                onKeyDown={(e) => { if (e.key === "Enter") e.currentTarget.blur(); if (e.key === "Escape") setEditingPageId(null); }}
              />
            ) : (
              <span
                className="lp-dashboard-page-tab-label"
                onDoubleClick={(e) => { e.stopPropagation(); setEditingPageId(p.id); setEditingPageName(p.name); }}
                title="Double-clique pour renommer, clic droit pour filtrer"
              >
                {p.icon && <IconGlyph icon={p.icon} size={13} />}
                {p.name}
              </span>
            )}
            {p.id === activePageId && editingPageId !== p.id && (
              <button className="lp-dashboard-page-tab-close lp-mobile-only-inline" onClick={(e) => { e.stopPropagation(); setEditingPageId(p.id); setEditingPageName(p.name); }} title="Renommer cette page"><Pencil size={11} /></button>
            )}
            {p.id === activePageId && (
              <button className="lp-dashboard-page-tab-close" onClick={(e) => { e.stopPropagation(); setFilterPageTarget(p); }} title="Filtre de cette page (s'applique à tous ses widgets)">
                <SlidersHorizontal size={11} />
                {hasPageFilter && <span className="lp-dashboard-page-filter-dot" />}
              </button>
            )}
            {p.id === activePageId && (
              <button className="lp-dashboard-page-tab-close" onClick={(e) => { e.stopPropagation(); onDuplicatePage(p.id); }} title="Dupliquer cette page"><Copy size={11} /></button>
            )}
            {pages.length > 1 && p.id === activePageId && (
              <button className="lp-dashboard-page-tab-close" onClick={(e) => { e.stopPropagation(); onDeletePage(p.id); }} title="Supprimer cette page"><X size={11} /></button>
            )}
          </div>
        );
      })}
      <button className="lp-dashboard-page-add" onClick={onAddPage} title="Ajouter une page"><Plus size={13} /></button>
    </div>
  );

  return (
    <div className="lp-dashboard-wrap">
      <ViewToolbarPortal slot={toolbarSlot}>
        {dashboardName && <span className="lp-dashboard-name-tag">{dashboardName}</span>}
        <button className="lp-tool-btn" onClick={() => setEditingWidget("new")} title="Ajouter un widget"><Plus size={14} /> Ajouter un widget</button>
      </ViewToolbarPortal>

      {/* Les onglets de pages sont "portés" à côté du titre (voir dashboardTabsSlot
          dans le composant parent) quand un emplacement est disponible, pour ne
          plus occuper leur propre rangée pleine largeur. Repli en rangée normale
          si aucun slot n'est fourni (ex. futur usage sans en-tête compatible). */}
      {tabsSlot ? <ViewToolbarPortal slot={tabsSlot}>{pagesBarNode}</ViewToolbarPortal> : pagesBarNode}

      {widgets.length === 0 ? (
        <div className="lp-empty" style={{ padding: 40 }}>
          Aucun widget pour l'instant.
          <div style={{ marginTop: 10 }}>
            <button className="lp-btn lp-btn-primary" onClick={() => setEditingWidget("new")}>Ajouter un widget</button>
          </div>
        </div>
      ) : (
        <div className={"lp-dashboard-grid" + (isMobileStack ? " lp-dashboard-grid-stack" : "")} ref={gridRef} style={isMobileStack ? undefined : { height: py(gridHeight) - DASHBOARD_GAP }}>
          {stackedWidgets.map((w, wIndex) => {
            if (!w.layout) return null;
            let scoped = applyWidgetFilter(pageFilteredTasks, widgetFilterFor(w), ctx);
            if (w.onlyMine && myName) scoped = scoped.filter((t) => t.assignee === myName);
            const isGesturing = !isMobileStack && gesture && gesture.id === w.id;
            const dx = isGesturing && gesture.mode === "move" ? gesture.dx : 0;
            const dy = isGesturing && gesture.mode === "move" ? gesture.dy : 0;
            const resizing = isGesturing && gesture.mode.startsWith("resize");
            const resizePreviewPx = resizing ? gesture.previewPx : null;
            // Pile mobile : plein largeur, en flux normal — plus de positionnement
            // absolu ni de redimensionnement au doigt (voir moveWidgetInStack pour
            // le réordonnancement tactile, via les boutons ↑/↓ de l'en-tête).
            const style = isMobileStack ? {
              position: "static", width: "100%", minHeight: Math.max(160, py(w.layout.h) - DASHBOARD_GAP),
              background: w.bgColor || undefined,
            } : {
              left: resizing ? resizePreviewPx.left : px(w.layout.x) + dx,
              top: resizing ? resizePreviewPx.top : py(w.layout.y) + dy,
              width: resizing ? resizePreviewPx.width : px(w.layout.w) - DASHBOARD_GAP,
              height: resizing ? resizePreviewPx.height : py(w.layout.h) - DASHBOARD_GAP,
              zIndex: isGesturing ? 30 : 1,
              background: w.bgColor || undefined,
              transition: isGesturing ? "none" : undefined,
              willChange: isGesturing ? "left, top, width, height" : undefined,
              ...(appearance?.animCascade && !isGesturing ? { animationDelay: `${Math.min(wIndex, 10) * 70}ms` } : {}),
            };
            return (
              <WidgetFrame
                key={w.id}
                title={w.title || "Widget"}
                titleEmoji={w.titleEmoji}
                titleColor={w.titleColor}
                bandColor={w.bandColor}
                style={style}
                className={appearance?.animCascade ? "lp-anim-cascade-item" : undefined}
                dragging={!!isGesturing}
                onMoveUp={isMobileStack && wIndex > 0 ? () => moveWidgetInStack(w.id, -1) : undefined}
                onMoveDown={isMobileStack && wIndex < stackedWidgets.length - 1 ? () => moveWidgetInStack(w.id, 1) : undefined}
                onEdit={() => setEditingWidget(w)}
                onDelete={() => removeWidget(w.id)}
                onDuplicate={() => duplicateWidget(w)}
                onAutoSize={() => autoSizeWidget(w)}
                onHeaderMouseDown={startMoveGesture(w)}
                onResizeMouseDown={(corner) => startResizeGesture(corner,w)}
                hasHeaderToolbar={w.type === "embedMetro" || w.type === "embedTimeline" || w.type === "embedRadar"}
              >
                {(headerToolbarSlot) => (
                <>
                {w.type === "kpi" && (
                  <div className="lp-widget-kpi">{computeKpiValue(scoped, w.metric || "count", ctx)}</div>
                )}
                {w.type === "customCard" && (
                  <WidgetCustomCard widget={w} tasks={scoped} allTasks={tasks} ctx={ctx} onOpen={onOpen}/>
                )}
                {w.type === "chart" && (
                  <WidgetChart tasks={scoped} groupBy={w.groupBy || "status"} chartStyle={w.chartStyle || "pie"} gaugeMetric={w.gaugeMetric || "avgProgress"} stackBy={w.stackBy || "project"} ctx={ctx} />
                )}
                {w.type === "list" && (
                  <WidgetList tasks={scoped} sortBy={w.sortBy || "end"} limit={w.limit || 6} groupBy={w.groupBy} ctx={ctx} onOpen={onOpen} />
                )}
                {w.type === "taskDetail" && (
                  <WidgetTaskDetail
                    widget={w}
                    tasks={scoped}
                    /* `allTasks` sert à RETROUVER la tâche déjà choisie quand
                       un filtre la masque — c'est tout son objet. Lui donner la
                       liste filtrée par la recherche de la barre du haut (#72)
                       la faisait disparaître dès qu'on tapait : le widget
                       retombait sur son sélecteur et son contenu s'évanouissait
                       sous les yeux. Il reçoit donc la liste D'AVANT cette
                       recherche. */
                    allTasks={tasksBeforeSearch || tasks}
                    ctx={ctx}
                    onOpen={onOpen}
                    shortcutPrefs={shortcutPrefs}
                    onChangeTask={(taskId)=>updateWidget(w.id,{taskDetailTaskId:taskId})}
                    onUpdateTask={(taskId,patch)=>setTasks((prev)=>prev.map((t)=>t.id===taskId ? {...t,...patch,lastInteraction:new Date().toISOString()} : t))}
                  />
                )}
                {w.type === "countdown" && (
                  <WidgetCountdown widget={w} tasks={tasks} ctx={ctx} />
                )}
                {w.type === "note" && (
                  <WidgetNote widget={w} onChange={(content) => updateWidget(w.id, { content })} shortcutPrefs={shortcutPrefs} />
                )}
                {w.type === "budget" && (
                  <WidgetBudget widget={w} projects={ctx.projects} expenses={expenses} expenseCategories={expenseCategories} />
                )}
                {w.type === "minigantt" && (
                  <WidgetMiniGantt
                    widget={w}
                    tasks={scoped}
                    groupBy={w.groupBy}
                    ctx={ctx}
                    onOpen={onOpen}
                    onUpdateWidget={(patch)=>updateWidget(w.id,patch)}
                    onUpdateTask={(taskId,patch)=>setTasks((prev)=>prev.map((t)=>t.id===taskId ? {...t,...patch,lastInteraction:new Date().toISOString()} : t))}
                    metaBlocks={scopedMetaBlocks}
                  />
                )}
                {w.type === "bubbles" && (
                  <WidgetBubbles
                    widget={w}
                    tasks={scoped}
                    groupBy={w.groupBy}
                    ctx={ctx}
                    onOpen={onOpen}
                    onUpdateWidget={(patch)=>updateWidget(w.id,patch)}
                    onUpdateTask={(taskId,patch)=>setTasks((prev)=>prev.map((t)=>t.id===taskId ? {...t,...patch,lastInteraction:new Date().toISOString()} : t))}
                    metaBlocks={scopedMetaBlocks}
                  />
                )}
                {w.type === "staffing" && (
                  <WidgetStaffing
                    widget={w}
                    ctx={ctx}
                    staffing={staffing}
                    onUpdateStaffing={setStaffing}
                    onUpdateWidget={(patch)=>updateWidget(w.id,patch)}
                    onUpdateWorkshops={setWorkshops}
                  />
                )}
                {w.type === "criticalPath" && (
                  <WidgetCriticalPath tasks={scoped} ctx={ctx} onOpen={onOpen} />
                )}
                {w.type === "projectTreemap" && (
                  <WidgetProjectTreemap
                    widget={w}
                    tasks={scoped}
                    ctx={ctx}
                    expenses={expenses}
                    onOpenProject={onOpenProject}
                    onEditProject={onEditProject}
                    onFilterProject={(projectId) => activePage && onUpdatePageFilter && onUpdatePageFilter(activePage.id, { ...(activePage.filter || widgetDefaultFilter()), projectIds: [projectId] })}
                  />
                )}
                {w.type === "deadlineScatter" && (
                  <WidgetDeadlineScatter widget={w} tasks={scoped} ctx={ctx} onOpen={onOpen} />
                )}
                {w.type === "heatmapGrid" && (
                  <WidgetHeatmapGrid widget={w} tasks={scoped} ctx={ctx} onOpen={onOpen} />
                )}
                {w.type === "heatmapMonth" && (
                  <WidgetHeatmapMonth tasks={scoped} ctx={ctx} onOpen={onOpen} appearance={appearance} />
                )}
                {w.type === "milestoneTimeline" && (
                  <WidgetMilestoneTimeline tasks={scoped} ctx={ctx} onOpen={onOpen} />
                )}
                {w.type === "metroDeadline" && (
                  <WidgetMetroDeadline tasks={scoped} ctx={ctx} onOpen={onOpen} />
                )}
                {w.type === "verticalMetroTimeline" && (
                  <WidgetVerticalMetroTimeline
                    tasks={scoped}
                    ctx={ctx}
                    onOpen={onOpen}
                    onUpdateDates={(taskId, patch) => setTasks((prev) => prev.map((t) => t.id === taskId ? { ...t, ...patch } : t))}
                  />
                )}
                {w.type === "blockers" && (
                  <WidgetBlockers tasks={scoped} ctx={ctx} onOpen={onOpen} />
                )}
                {w.type === "nextBestAction" && (
                  <WidgetNextBestAction tasks={scoped} ctx={ctx} onOpen={onOpen} />
                )}
                {w.type === "dailyBriefing" && (
                  <WidgetDailyBriefing tasks={scoped} ctx={ctx} onOpen={onOpen} onViewDay={onViewDay} activityLog={activityLog} />
                )}
                {w.type === "dominoEffect" && (
                  <WidgetDominoEffect tasks={scoped} ctx={ctx} onOpen={onOpen} />
                )}
                {w.type === "budgetBurnRate" && (
                  <WidgetBudgetBurnRate widget={w} ctx={ctx} expenses={expenses || []} onOpen={onOpen} />
                )}
                {w.type === "embedMetro" && (
                  <WidgetEmbedMetro widget={w} tasks={scoped} ctx={ctx} onOpen={onOpen} appearance={appearance} expenses={expenses} setTasks={setTasks} pushToast={pushToast} externalToolbarSlot={headerToolbarSlot} onUpdateWidget={(patch)=>updateWidget(w.id,patch)} metaBlocks={scopedMetaBlocks} />
                )}
                {w.type === "embedTimeline" && (
                  <WidgetEmbedTimeline tasks={scoped} ctx={ctx} onOpen={onOpen} setTasks={setTasks} externalToolbarSlot={headerToolbarSlot} />
                )}
                {w.type === "embedRadar" && (
                  <WidgetEmbedRadar tasks={scoped} ctx={ctx} onOpen={onOpen} appearance={appearance} externalToolbarSlot={headerToolbarSlot} />
                )}
                </>
                )}
              </WidgetFrame>
            );
          })}
        </div>
      )}

      {editingWidget && (
        <WidgetFormModal
          widget={editingWidget === "new" ? null : editingWidget}
          existingWidgets={widgets}
          ctx={ctx}
          pageFilter={activePage?.filter}
          onSave={saveWidget}
          onClose={() => setEditingWidget(null)}
          transferBoards={transferBoards}
          boardId={boardId}
          currentPageId={activePageId}
          onTransfer={onTransferWidget ? transferEditedWidget : undefined}
        />
      )}
      {filterPageTarget && (
        <PageFilterModal
          page={filterPageTarget}
          ctx={ctx}
          onSave={(filter) => onUpdatePageFilter(filterPageTarget.id, filter)}
          onSaveMeta={(patch) => onUpdatePageMeta(filterPageTarget.id, patch)}
          onClose={() => setFilterPageTarget(null)}
        />
      )}
    </div>
  );
}

// Arrondit proprement pour l'affichage : entier si c'en est un, sinon 1 décimale.
function fmtAggregateValue(v) {
  if (!Number.isFinite(v)) return "0";
  const rounded = Math.round(v * 10) / 10;
  return Number.isInteger(rounded) ? String(rounded) : rounded.toFixed(1);
}

function computeStackedData(tasks, groupBy, stackBy, ctx) {
  const primary = groupTasks(tasks, groupBy, ctx).filter((g) => g.tasks.length > 0);
  const stackKeys = groupTasks(tasks, stackBy, ctx).filter((g) => g.tasks.length > 0);
  return primary.map((pg) => ({
    label: pg.label,
    total: pg.tasks.length,
    segments: stackKeys
      .map((sg) => {
        const segTasks = pg.tasks.filter((t) => matchesGroupKey(t, stackBy, sg.key, ctx));
        return { label: sg.label, color: sg.color || "var(--text-muted)", value: segTasks.length };
      })
      .filter((s) => s.value > 0),
  }));
}

function GaugeChart({ value, size = 120, metricLabel, count }) {
  const [hover, setHover] = useState(false);
  const r = size / 2 - 10;
  const cx = size / 2, cy = size / 2;
  const circumference = Math.PI * r; // demi-cercle
  const pct = clamp(value, 0, 100);
  const offset = circumference * (1 - pct / 100);
  return (
    <div style={{ position: "relative", display: "inline-block" }}>
      <svg
        width={size} height={size / 2 + 24} viewBox={`0 0 ${size} ${size / 2 + 24}`}
        onMouseEnter={() => setHover(true)}
        onMouseLeave={() => setHover(false)}
        style={{ cursor: metricLabel ? "default" : undefined }}
      >
        <path d={`M ${cx - r} ${cy} A ${r} ${r} 0 0 1 ${cx + r} ${cy}`} fill="none" stroke="var(--border)" strokeWidth="12" strokeLinecap="round" />
        <path d={`M ${cx - r} ${cy} A ${r} ${r} 0 0 1 ${cx + r} ${cy}`} fill="none" stroke="var(--accent)" strokeWidth="12" strokeLinecap="round" strokeDasharray={circumference} strokeDashoffset={offset} />
        <text x={cx} y={cy - 4} textAnchor="middle" fontSize="22" fontWeight="800" fill="var(--text-900)">{Math.round(pct)}%</text>
      </svg>
      {hover && metricLabel && (
        <div className="lp-pie-tooltip" style={{ position: "absolute", left: "50%", bottom: "100%", transform: "translateX(-50%)", marginBottom: 6, whiteSpace: "nowrap" }}>
          {metricLabel} — {Math.round(pct)}%{Number.isFinite(count) ? ` (${count} tâche${count > 1 ? "s" : ""})` : ""}
        </div>
      )}
    </div>
  );
}

function BarChartSimple({ data, horizontal }) {
  const [hover, setHover] = useState(null); // { d, x, y }
  const max = Math.max(1, ...data.map((d) => d.value));
  const openTip = (d, e) => setHover({ d, x: e.clientX, y: e.clientY });
  const closeTip = () => setHover(null);
  const total = data.reduce((s, d) => s + d.value, 0);
  const pctFor = (v) => (total > 0 ? Math.round((v / total) * 100) : 0);
  const legend = (
    <div className="lp-widget-legend lp-widget-legend-horizontal">
      {data.map((d) => (
        <div key={d.label} className="lp-widget-legend-item">
          <span className="lp-widget-legend-dot" style={{ background: d.color }} />
          <span className="lp-widget-legend-label">{d.label}</span>
          <span className="lp-widget-legend-value">{fmtAggregateValue(d.value)}</span>
        </div>
      ))}
    </div>
  );
  if (horizontal) {
    return (
      <div className="lp-widget-barh-wrap">
        <div className="lp-widget-barh" style={{ position: "relative" }}>
          {data.map((d) => (
            <div className="lp-widget-barh-row" key={d.label} onMouseEnter={(e) => openTip(d, e)} onMouseMove={(e) => openTip(d, e)} onMouseLeave={closeTip} style={{ cursor: "default" }}>
              <span className="lp-widget-barh-label">{d.label}</span>
              <div className="lp-widget-barh-track">
                <div className="lp-widget-barh-fill" style={{ width: `${(d.value / max) * 100}%`, background: d.color }} />
              </div>
              <span className="lp-widget-bar-value">{fmtAggregateValue(d.value)}</span>
            </div>
          ))}
          {hover && (
            <WidgetPointerTooltip x={hover.x} y={hover.y} className="lp-pie-tooltip">
              {hover.d.label} — {fmtAggregateValue(hover.d.value)} ({pctFor(hover.d.value)}%)
            </WidgetPointerTooltip>
          )}
        </div>
        {legend}
      </div>
    );
  }
  return (
    <div className="lp-widget-barv-wrap">
      <div className="lp-widget-barv" style={{ position: "relative" }}>
        {data.map((d) => (
          <div className="lp-widget-barv-col" key={d.label} onMouseEnter={(e) => openTip(d, e)} onMouseMove={(e) => openTip(d, e)} onMouseLeave={closeTip} style={{ cursor: "default" }}>
            <span className="lp-widget-bar-value">{fmtAggregateValue(d.value)}</span>
            <div className="lp-widget-barv-track">
              <div className="lp-widget-barv-fill" style={{ height: `${(d.value / max) * 100}%`, background: d.color }} />
            </div>
            <span className="lp-widget-barv-label">{d.label}</span>
          </div>
        ))}
        {hover && (
          <WidgetPointerTooltip x={hover.x} y={hover.y} className="lp-pie-tooltip">
            {hover.d.label} — {fmtAggregateValue(hover.d.value)} ({pctFor(hover.d.value)}%)
          </WidgetPointerTooltip>
        )}
      </div>
      {legend}
    </div>
  );
}

function LineChartWidget({ data, width = 320, height = 140 }) {
  const [hover, setHover] = useState(null); // { p, x, y }
  if (data.length === 0) return <div className="lp-empty" style={{ padding: 16 }}>Aucune donnée pour ce filtre.</div>;
  const max = Math.max(1, ...data.map((d) => d.value));
  const padX = 8, padY = 14;
  const stepX = data.length > 1 ? (width - padX * 2) / (data.length - 1) : 0;
  const points = data.map((d, i) => {
    const x = padX + i * stepX;
    const y = height - padY - (d.value / max) * (height - padY * 2);
    return { x, y, d };
  });
  const path = points.map((p, i) => `${i === 0 ? "M" : "L"} ${p.x} ${p.y}`).join(" ");
  const area = `${path} L ${points[points.length - 1].x} ${height - padY} L ${points[0].x} ${height - padY} Z`;
  return (
    <div>
      <div style={{ position: "relative" }}>
        <svg width="100%" viewBox={`0 0 ${width} ${height}`} preserveAspectRatio="xMidYMid meet">
          <path d={area} fill="var(--accent)" opacity="0.12" />
          <path d={path} fill="none" stroke="var(--accent)" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round" />
          {points.map((p, i) => (
            <g key={i} onMouseEnter={(e) => setHover({ p, x: e.clientX, y: e.clientY })} onMouseMove={(e) => setHover({ p, x: e.clientX, y: e.clientY })} onMouseLeave={() => setHover(null)} style={{ cursor: "default" }}>
              <circle cx={p.x} cy={p.y} r="9" fill="transparent" />
              <circle cx={p.x} cy={p.y} r="3" fill="var(--accent)" />
              <text x={p.x} y={height - 2} textAnchor="middle" fontSize="9" fill="var(--text-600)">{p.d.label}</text>
            </g>
          ))}
        </svg>
        {hover && (
          <WidgetPointerTooltip x={hover.x} y={hover.y} className="lp-pie-tooltip">
            {hover.p.d.label} — {hover.p.d.value} tâche{hover.p.d.value > 1 ? "s" : ""}
          </WidgetPointerTooltip>
        )}
      </div>
      <div className="lp-widget-legend lp-widget-legend-horizontal">
        <div className="lp-widget-legend-item">
          <span className="lp-widget-legend-dot" style={{ background: "var(--accent)" }} />
          <span className="lp-widget-legend-label">Nombre de tâches par période</span>
        </div>
      </div>
    </div>
  );
}

function StackedBarChart({ data }) {
  const [hover, setHover] = useState(null); // { seg, colLabel, x, y }
  const max = Math.max(1, ...data.map((d) => d.total));
  // Légende dédupliquée : un segment (ex. un statut) peut apparaître dans
  // plusieurs colonnes — un seul badge par label/couleur distincts.
  const legend = useMemo(() => {
    const seen = new Map();
    data.forEach((d) => d.segments.forEach((s) => { if (!seen.has(s.label)) seen.set(s.label, s.color); }));
    return [...seen.entries()].map(([label, color]) => ({ label, color }));
  }, [data]);
  return (
    <div className="lp-widget-stacked" style={{ position: "relative" }}>
      <div className="lp-widget-barv">
        {data.map((d) => (
          <div className="lp-widget-barv-col" key={d.label}>
            <span className="lp-widget-bar-value">{d.total}</span>
            <div className="lp-widget-barv-track lp-widget-barv-track-stacked">
              {d.segments.map((s, i) => (
                <div
                  key={i}
                  className="lp-widget-barv-fill"
                  style={{ height: `${(s.value / max) * 100}%`, background: s.color }}
                  onMouseEnter={(e) => setHover({ seg: s, colLabel: d.label, x: e.clientX, y: e.clientY })}
                  onMouseMove={(e) => setHover({ seg: s, colLabel: d.label, x: e.clientX, y: e.clientY })}
                  onMouseLeave={() => setHover(null)}
                />
              ))}
            </div>
            <span className="lp-widget-barv-label">{d.label}</span>
          </div>
        ))}
      </div>
      {legend.length > 0 && (
        <div className="lp-widget-legend lp-widget-legend-horizontal">
          {legend.map((l) => (
            <div key={l.label} className="lp-widget-legend-item">
              <span className="lp-widget-legend-dot" style={{ background: l.color }} />
              <span className="lp-widget-legend-label">{l.label}</span>
            </div>
          ))}
        </div>
      )}
      {hover && (
        <WidgetPointerTooltip x={hover.x} y={hover.y} className="lp-pie-tooltip">
          {hover.colLabel} · {hover.seg.label} — {hover.seg.value}
        </WidgetPointerTooltip>
      )}
    </div>
  );
}

function WidgetChart({ tasks, groupBy, chartStyle, gaugeMetric, stackBy, ctx }) {
  const [hover, setHover] = useState(null);
  const style = chartStyle || "pie";

  // Tous les hooks sont appelés inconditionnellement (règle des Hooks React) —
  // on calcule les trois formes de données possibles, puis on choisit laquelle
  // afficher selon le style choisi.
  const lineGroups = useMemo(() => groupTasks(tasks, "period", ctx).filter((g) => g.tasks.length > 0), [tasks, ctx]);
  const stackedData = useMemo(() => computeStackedData(tasks, groupBy || "project", stackBy || "status", ctx), [tasks, groupBy, stackBy, ctx]);
  const groups = useMemo(() => groupTasks(tasks, groupBy, ctx).filter((g) => g.tasks.length > 0), [tasks, groupBy, ctx]);

  if (style === "gauge") {
    const metric = gaugeMetric || "avgProgress";
    let value = 0;
    if (tasks.length > 0) {
      if (metric === "doneRatio") value = (tasks.filter((t) => isTaskDoneGlobal(t, ctx)).length / tasks.length) * 100;
      else value = tasks.reduce((s, t) => s + (Number(t.progress) || 0), 0) / tasks.length;
    }
    const metricLabel = GAUGE_METRICS.find((m) => m.key === metric)?.label || "Valeur";
    return (
      <div className="lp-widget-gauge-wrap">
        <GaugeChart value={value} metricLabel={metricLabel} count={tasks.length} />
      </div>
    );
  }

  if (style === "line") {
    const data = lineGroups.map((g) => ({ label: g.label, value: g.tasks.length }));
    return <LineChartWidget data={data} />;
  }

  if (style === "stackedBar") {
    if (stackedData.length === 0) return <div className="lp-empty" style={{ padding: 16 }}>Aucune donnée pour ce filtre.</div>;
    return <StackedBarChart data={stackedData} />;
  }

  const data = groups.map((g) => ({ label: g.label, value: g.tasks.length, color: g.color || "var(--text-muted)" }));
  if (data.length === 0) return <div className="lp-empty" style={{ padding: 16 }}>Aucune donnée pour ce filtre.</div>;

  if (style === "bar" || style === "barh") {
    return <BarChartSimple data={data} horizontal={style === "barh"} />;
  }

  // style === "pie"
  return (
    <div className="lp-widget-chart-row">
      <PieChart data={data} size={120} onHover={(s, e) => setHover({ s, x: e.clientX, y: e.clientY })} onLeave={() => setHover(null)} />
      <div className="lp-widget-legend">
        {data.map((d) => (
          <div key={d.label} className="lp-widget-legend-item">
            <span className="lp-widget-legend-dot" style={{ background: d.color }} />
            <span className="lp-widget-legend-label">{d.label}</span>
            <span className="lp-widget-legend-value">{fmtAggregateValue(d.value)}</span>
          </div>
        ))}
      </div>
      {hover && (
        <WidgetPointerTooltip x={hover.x} y={hover.y} className="lp-pie-tooltip">
          {hover.s.label} — {fmtAggregateValue(hover.s.value)} ({hover.s.pct}%)
        </WidgetPointerTooltip>
      )}
    </div>
  );
}

function WidgetList({ tasks, sortBy, limit, groupBy, ctx, onOpen }) {
  const [collapsed, setCollapsed] = useState({}); // { [groupKey]: true }
  const toggleGroup = (key) => setCollapsed((c) => ({ ...c, [key]: !c[key] }));
  const sorted = useMemo(() => {
    const arr = [...tasks];
    arr.sort((a, b) => {
      if (sortBy === "progress") return (b.progress || 0) - (a.progress || 0);
      if (sortBy === "title") return (a.title || "").localeCompare(b.title || "");
      return (a.end || "").localeCompare(b.end || "");
    });
    return arr.slice(0, limit || 6);
  }, [tasks, sortBy, limit]);
  if (sorted.length === 0) return <div className="lp-empty" style={{ padding: 16 }}>Aucune tâche pour ce filtre.</div>;

  const Row = (t) => {
    const proj = ctx.projects.find((p) => p.id === t.projectId);
    const st = ctx.statuses.find((s) => s.id === t.statusId);
    return (
      <div className="lp-today-row" key={t.id} onClick={() => onOpen(t)}>
        <span className="lp-project-dot" style={{ background: proj?.color || "var(--text-muted)", width: 14, height: 14, fontSize: 9 }}><IconGlyph icon={proj?.icon} size={10} /></span>
        {t.milestone && <MilestoneGlyph size={12} icon={resolveMilestoneIcon(t, ctx)} />}
        <span className="lp-today-row-title">{t.title}</span>
        {st && <span className="lp-chip" style={{ background: st.color + "22", color: st.color }}>{st.name}</span>}
        <span className="lp-today-row-date">{fmtShort(t.end)}</span>
      </div>
    );
  };

  if (!groupBy || groupBy === "none") {
    return <div className="lp-widget-list">{sorted.map(Row)}</div>;
  }

  // Regroupement purement visuel (sur le sous-ensemble déjà trié/limité) : un
  // en-tête coloré par groupe, pliable pour se concentrer sur une section.
  const groups = groupTasks(sorted, groupBy, ctx).filter((g) => g.tasks.length > 0);
  return (
    <div className="lp-widget-list lp-widget-list-grouped">
      {groups.map((g) => {
        const isCollapsed = !!collapsed[g.key];
        return (
          <div className="lp-widget-list-group" key={g.key}>
            <div className="lp-widget-list-group-head" onClick={() => toggleGroup(g.key)}>
              <ChevronRight size={11} className="lp-widget-group-chevron" style={{ transform: isCollapsed ? "rotate(0deg)" : "rotate(90deg)" }} />
              <span className="lp-widget-list-group-dot" style={{ background: g.color || "var(--text-muted)" }} />
              <span className="lp-widget-list-group-label">{g.label}</span>
              <span className="lp-widget-list-group-count">{g.tasks.length}</span>
            </div>
            {!isCollapsed && g.tasks.map(Row)}
          </div>
        );
      })}
    </div>
  );
}



function WidgetCustomCard({ widget, tasks, allTasks, ctx, onOpen }) {
  const blocks = Array.isArray(widget.cardBlocks) && widget.cardBlocks.length ? widget.cardBlocks : customCardDefaultBlocks();
  const columns = Math.max(1,Math.min(3,Number(widget.cardColumns)||2));
  const accentColor = widget.cardAccentColor || "var(--line-blue)";
  const cardRadiusPx = ({none:"0px",small:"6px",medium:"10px",large:"16px"})[widget.cardRadius || "medium"] || "10px";
  const cardSurface = widget.cardSurface || "plain";
  const cardShellStyle = {
    "--custom-card-accent":accentColor,
    "--custom-card-radius":cardRadiusPx,
    background:widget.cardBackground || undefined,
    borderColor:widget.cardBorderColor || undefined,
  };
  const refTask = widget.cardTaskMode === "fixed"
    ? (allTasks || []).find((t)=>t.id===widget.cardTaskId)
    : (tasks || [])[0];

  const projectOf = (t) => ctx.projects.find((p)=>p.id===t?.projectId);
  const statusOfTask = (t) => ctx.statuses.find((st)=>st.id===t?.statusId);

  const valueFor = (b) => {
    if (b.kind==="aggregate") return computeKpiValue(tasks || [],b.metric || "count",ctx);
    if (b.kind==="staticText") return b.text || "—";
    if (!refTask) return "—";
    if (b.kind==="taskTitle") return refTask.title || "Sans titre";
    if (b.kind==="project") return projectOf(refTask)?.name || "Sans projet";
    if (b.kind==="status") return statusOfTask(refTask)?.name || "—";
    if (b.kind==="start") return refTask.start ? fmtShort(refTask.start) : "—";
    if (b.kind==="end") return refTask.end ? fmtShort(refTask.end) : "—";
    if (b.kind==="assignee") return refTask.assignee || "Non assigné";
    if (b.kind==="progress") return `${Math.max(0,Math.min(100,Number(refTask.progress)||0))}%`;
    if (b.kind==="description") return refTask.desc || refTask.description || "—";
    return "—";
  };

  const defaultLabel = (b) => {
    if (b.kind==="aggregate") return WIDGET_METRICS.find((m)=>m.key===(b.metric||"count"))?.label || "Agrégation";
    return ({
      taskTitle:"Tâche", project:"Projet", status:"Statut", start:"Début", end:"Fin",
      assignee:"Responsable", progress:"Avancement", description:"Description", staticText:""
    })[b.kind] || "";
  };

  return (
    <div className={"lp-custom-card surface-"+cardSurface} style={{"--custom-card-cols":columns,...cardShellStyle}}>
      {!refTask && blocks.some((b)=>!["aggregate","staticText"].includes(b.kind)) && (
        <div className="lp-custom-card-warning">Aucune tâche de référence disponible pour les blocs individuels.</div>
      )}
      <div className="lp-custom-card-grid">
        {blocks.map((b)=> {
          const value=valueFor(b);
          const label=(b.label || defaultLabel(b)).trim();
          const project = b.kind==="project" && refTask ? projectOf(refTask) : null;
          const status = b.kind==="status" && refTask ? statusOfTask(refTask) : null;
          const blockColor = b.color || accentColor;
          const blockIcon = b.icon || CUSTOM_CARD_DEFAULT_ICONS[b.kind] || "";
          const blockStyle = {
            color:blockColor,
            background:b.bgColor || undefined,
            "--block-accent":blockColor,
          };
          return (
            <div
              key={b.id}
              className={
                "lp-custom-card-item "+
                (b.emphasis||"normal")+
                (b.span==="full" ? " full" : "")+
                (b.kind==="taskTitle" && refTask ? " clickable" : "")+
                (" accent-"+(b.accent||"none"))
              }
              style={blockStyle}
              onClick={b.kind==="taskTitle" && refTask ? ()=>onOpen(refTask) : undefined}
              title={b.kind==="taskTitle" && refTask ? "Ouvrir la tâche" : undefined}
            >
              {(b.showLabel !== false && label) && <div className="lp-custom-card-label">{label}</div>}
              <div className="lp-custom-card-value">
                {b.showIcon !== false && blockIcon && (
                  <span className={"lp-custom-card-icon"+(b.accent==="icon" ? " in-bubble" : "")}>
                    <IconGlyph icon={blockIcon} size={b.emphasis==="hero" ? 18 : 14}/>
                  </span>
                )}
                {project && <span className="lp-custom-card-dot" style={{background:project.color}}/>}
                {status && <span className="lp-custom-card-dot" style={{background:status.color}}/>}
                <span>{value}</span>
              </div>
              {b.kind==="progress" && refTask && (
                <div className="lp-custom-card-progress"><span style={{width:`${Math.max(0,Math.min(100,Number(refTask.progress)||0))}%`,background:blockColor}}/></div>
              )}
            </div>
          );
        })}
      </div>
    </div>
  );
}

function WidgetTaskDetail({ widget, tasks, allTasks, ctx, onOpen, onUpdateTask, onChangeTask, shortcutPrefs }) {
  // `tasks` est déjà restreint par le filtre du widget (et, en priorité, par
  // celui de l'onglet) — c'est la liste proposée dans le sélecteur déroulant.
  // `allTasks` (non filtré) sert uniquement à retrouver la tâche déjà choisie,
  // pour qu'elle continue de s'afficher si un filtre est modifié après coup.
  const task = (allTasks || tasks).find((t) => t.id === widget.taskDetailTaskId);
  const [descMode, setDescMode] = useState("preview");
  const [writingMode, setWritingMode] = useState(false);
  const [paramsCollapsed, setParamsCollapsed] = useState(false);
  const hoveredRef = useRef(false);
  const rootRef = useRef(null);
  const descRef = useRef(null);
  const metroTimelineRef = useRef(null);
  const metroDateDragRef = useRef(null);
  const [metroDatePreview, setMetroDatePreview] = useState(null);
  const [metroTimelineWidth, setMetroTimelineWidth] = useState(0);

  useEffect(() => {
    const el = metroTimelineRef.current;
    if (!el) return;
    const measure = () => setMetroTimelineWidth(el.clientWidth || 0);
    measure();
    const ro = new ResizeObserver(measure);
    ro.observe(el);
    return () => ro.disconnect();
  }, [task?.id]);

  if (!task) {
    return (
      <div className="lp-task-detail-quick-picker-only" onMouseDown={(e)=>e.stopPropagation()}>
        <TaskDetailPicker
          tasks={tasks}
          projects={ctx.projects}
          value={widget.taskDetailTaskId || ""}
          onChange={onChangeTask}
        />
        <div className="lp-empty" style={{padding:18}}>Choisis une tâche à afficher.</div>
      </div>
    );
  }

  const update = (patch) => onUpdateTask(task.id, patch);
  const project = ctx.projects.find((p)=>p.id===task.projectId);
  const milestoneTimelineIcon = task.milestone ? resolveMilestoneIcon(task,ctx) : null;
  const taskEndTimelineIcon = !task.milestone && project?.metroTaskIcons
    ? (task.milestoneIcon || project?.milestoneIcon || project?.icon || null)
    : null;
  const allowedStatuses = getStatusesForTask(ctx.statuses, ctx.projects, ctx.taskTypes, task.projectId, task.taskTypeId, task.statusId);
  const restrictedStatus = restrictedStatusForType(ctx.taskTypes, ctx.statuses, task.taskTypeId);
  const persistedStart = task.start || task.end || iso(new Date());
  const persistedEnd = task.end || task.start || persistedStart;
  const start = metroDatePreview?.start || persistedStart;
  const end = metroDatePreview?.end || persistedEnd;
  // Pendant un drag, la fenêtre temporelle reste fixe : sinon déplacer le début
  // recentrerait l'axe sous le pointeur et donnerait l'impression que la station
  // refuse de bouger.
  const windowStart = metroDatePreview?.windowStart || addDays(start, -7);
  const windowEnd = metroDatePreview?.windowEnd || addDays(start, 7);
  const windowDays = 14;
  const pctForDate = (date) => clamp(((dayIndex(date) - dayIndex(windowStart)) / windowDays) * 100, 0, 100);
  const durationLeftPct = pctForDate(start);
  const durationRightPct = pctForDate(end);
  const visibleDurationRightPct = clamp(durationRightPct, durationLeftPct, 100);
  const endWithinWindow = end >= windowStart && end <= windowEnd;
  const todayStr = iso(new Date());
  const todayWithinWindow = todayStr >= windowStart && todayStr <= windowEnd;
  const tickMode = metroTimelineWidth >= 560 ? "day" : "week";
  const compactMetro = metroTimelineWidth > 0 && metroTimelineWidth < 430;
  const todaySameAsStart = todayStr === start;
  const startPct = pctForDate(start);
  const todayPct = pctForDate(todayStr);
  // En dessous d'environ 90 px entre les deux stations, les libellés "Début"
  // et "Aujourd’hui" sont écartés de part et d’autre pour ne jamais se chevaucher.
  const startTodayGapPx = metroTimelineWidth
    ? Math.abs(todayPct - startPct) / 100 * metroTimelineWidth
    : 999;
  const startTodayLabelsClose = !todaySameAsStart && todayWithinWindow && startTodayGapPx < 125;
  const tickDates = tickMode === "day"
    ? Array.from({length:15},(_,i)=>addDays(windowStart,i))
    : [windowStart,start,windowEnd];
  const checklist = task.checklist || [];

  const startMetroDateDrag = (kind, e) => {
    e.preventDefault();
    e.stopPropagation();

    const el = metroTimelineRef.current;
    if (!el) return;

    const rect = el.getBoundingClientRect();
    const baseStart = persistedStart;
    const baseEnd = persistedEnd;
    const fixedWindowStart = addDays(baseStart, -7);
    const fixedWindowEnd = addDays(baseStart, 7);
    const baseDuration = Math.max(0, dayIndex(baseEnd) - dayIndex(baseStart));

    const dateFromClientX = (clientX) => {
      const ratio = clamp((clientX - rect.left) / Math.max(1, rect.width), 0, 1);
      const offsetDays = Math.round(ratio * 14);
      return addDays(fixedWindowStart, offsetDays);
    };

    metroDateDragRef.current = {
      kind,
      baseStart,
      baseEnd,
      baseDuration,
      fixedWindowStart,
      fixedWindowEnd,
      dateFromClientX,
    };

    const applyPreview = (clientX) => {
      const drag = metroDateDragRef.current;
      if (!drag) return;
      const picked = drag.dateFromClientX(clientX);

      if (drag.kind === "milestone") {
        setMetroDatePreview({
          start:picked,
          end:picked,
          windowStart:drag.fixedWindowStart,
          windowEnd:drag.fixedWindowEnd,
        });
        return;
      }

      if (drag.kind === "start") {
        const shiftedEnd = addDays(picked, drag.baseDuration);
        setMetroDatePreview({
          start:picked,
          end:shiftedEnd,
          windowStart:drag.fixedWindowStart,
          windowEnd:drag.fixedWindowEnd,
        });
        return;
      }

      const safeEnd = dayIndex(picked) < dayIndex(drag.baseStart) ? drag.baseStart : picked;
      setMetroDatePreview({
        start:drag.baseStart,
        end:safeEnd,
        windowStart:drag.fixedWindowStart,
        windowEnd:drag.fixedWindowEnd,
      });
    };

    applyPreview(e.clientX);

    const onMove = (ev) => {
      ev.preventDefault();
      applyPreview(ev.clientX);
    };

    const onUp = (ev) => {
      ev.preventDefault();
      const drag = metroDateDragRef.current;
      if (!drag) return cleanup();

      const picked = drag.dateFromClientX(ev.clientX);
      if (drag.kind === "milestone") {
        update({start:picked,end:picked});
      } else if (drag.kind === "start") {
        update({start:picked,end:addDays(picked,drag.baseDuration)});
      } else {
        const safeEnd = dayIndex(picked) < dayIndex(drag.baseStart) ? drag.baseStart : picked;
        update({end:safeEnd});
      }

      cleanup();
    };

    const cleanup = () => {
      window.removeEventListener("mousemove", onMove);
      window.removeEventListener("mouseup", onUp);
      metroDateDragRef.current = null;
      setMetroDatePreview(null);
    };

    window.addEventListener("mousemove", onMove);
    window.addEventListener("mouseup", onUp);
  };

  const updateChecklist = (id, patch) => {
    update({ checklist: checklist.map((item)=>item.id===id ? {...item,...patch} : item) });
  };

  useEffect(() => {
    const onHoveredShortcut = (e) => {
      if (!hoveredRef.current) return;
      if (writingMode) return;
      if (!matchesShortcutCombo(e,shortcutPrefs?.markdownPreviewToggle || "Ctrl+ArrowLeft")) return;

      e.preventDefault();
      e.stopPropagation();
      e.stopImmediatePropagation?.();
      setDescMode((m)=>m==="preview" ? "edit" : "preview");

      requestAnimationFrame(()=>{
        rootRef.current?.focus({preventScroll:true});
      });
    };

    window.addEventListener("keydown", onHoveredShortcut, true);
    return () => window.removeEventListener("keydown", onHoveredShortcut, true);
  }, [shortcutPrefs, writingMode]);

  return (
    <div
      ref={rootRef}
      tabIndex={0}
      className={"lp-task-detail"+(paramsCollapsed ? " params-collapsed" : "")}
      onMouseEnter={()=>{ hoveredRef.current = true; }}
      onMouseLeave={()=>{ hoveredRef.current = false; }}
      onMouseDown={(e)=>e.stopPropagation()}
      onKeyDown={(e)=>{
        if(!hoveredRef.current) return;
        if(!matchesShortcutCombo(e,shortcutPrefs?.markdownPreviewToggle || "Ctrl+ArrowLeft")) return;
        e.preventDefault();
        e.stopPropagation();
        setDescMode((m)=>m==="preview" ? "edit" : "preview");
        requestAnimationFrame(()=>{
          rootRef.current?.focus({preventScroll:true});
        });
      }}
    >
      {writingMode && (
        <TaskWritingModeOverlay
          title={task.title}
          project={project}
          status={ctx.statuses.find((st)=>st.id===task.statusId)}
          assignee={task.assignee}
          start={task.start}
          end={task.end}
          progress={task.progress}
          milestone={task.milestone}
          desc={task.desc ?? task.description ?? ""}
          onChangeDesc={(next)=>update({desc:next})}
          onClose={()=>setWritingMode(false)}
          shortcutPrefs={shortcutPrefs}
        />
      )}
      <div className="lp-task-detail-sticky-head">
        <div className="lp-task-detail-topline">
          <span className="lp-project-dot" style={{background:project?.color || "var(--text-muted)",width:20,height:20,flex:"0 0 auto"}}>
            <IconGlyph icon={project?.icon} size={10}/>
          </span>
          <input
            className="lp-task-detail-title-input"
            value={task.title || ""}
            onChange={(e)=>update({title:e.target.value})}
            title="Modifier le titre"
          />
          {task.milestone && <MilestoneGlyph size={16} icon={resolveMilestoneIcon(task,ctx)}/>}
          <button
            type="button"
            className="lp-task-detail-writing-btn"
            onClick={()=>setWritingMode(true)}
            title="Mode écriture"
          >
            <Pencil size={13}/>
          </button>
          <div className="lp-task-detail-quick-picker lp-task-detail-quick-picker-inline" onMouseDown={(e)=>e.stopPropagation()}>
            <TaskDetailPicker
              tasks={tasks}
              projects={ctx.projects}
              value={widget.taskDetailTaskId || ""}
              onChange={onChangeTask}
              compact
            />
          </div>
        </div>

        <div className="lp-task-detail-timeline">
        <div className="lp-task-detail-timeline-head">
          <span>{fmtShort(windowStart)}</span>
          <span>{compactMetro ? (tickMode === "day" ? "Jour" : "Hebdo") : `Métro · ${tickMode === "day" ? "graduation journalière" : "graduation hebdo"}`}</span>
          <span>{fmtShort(windowEnd)}</span>
        </div>

        <div className="lp-task-detail-metro" ref={metroTimelineRef}>
          <div className="lp-task-detail-metro-line"/>

          <div
            className="lp-task-detail-metro-duration"
            style={{
              left:`${durationLeftPct}%`,
              width:`${Math.max(0,visibleDurationRightPct-durationLeftPct)}%`,
              background:`color-mix(in srgb, ${project?.color || "var(--accent)"} 24%, white)`
            }}
            title={`${fmtShort(start)} → ${fmtShort(end)} · ${clamp(Number(task.progress||0),0,100)}%`}
          >
            <div
              className="lp-task-detail-metro-progress"
              style={{
                width:`${clamp(Number(task.progress||0),0,100)}%`,
                background:project?.color || "var(--accent)"
              }}
            />
          </div>

          {tickDates.map((d,idx)=>{
            const left=pctForDate(d);
            const isStart=d===start;
            const major=tickMode==="week" || isStart || idx===0 || idx===tickDates.length-1;
            const isEdgeStart=idx===0;
            const isEdgeEnd=idx===tickDates.length-1;
            const showLabel=compactMetro
              ? (isEdgeStart || isStart || isEdgeEnd)
              : (tickMode==="week" || isStart || isEdgeStart || isEdgeEnd || idx%2===0);
            const labelTransform=isEdgeStart ? "translateX(0)" : isEdgeEnd ? "translateX(-100%)" : "translateX(-50%)";
            return (
              <React.Fragment key={d}>
                <span className={"lp-task-detail-metro-tick"+(major?" major":"")} style={{left:`${left}%`}}/>
                {showLabel && <span className="lp-task-detail-metro-label" style={{left:`${left}%`,transform:labelTransform}}>{fmtShort(d).slice(0,5)}</span>}
              </React.Fragment>
            );
          })}

          {task.milestone ? (
            <span
              className="lp-task-detail-metro-icon-station milestone draggable"
              style={{left:`${startPct}%`,color:project?.color || "var(--accent)"}}
              title={`Jalon · ${fmtShort(start)} · glisser pour déplacer`}
              onMouseDown={(e)=>startMetroDateDrag("milestone",e)}
            >
              <MilestoneGlyph size={16} icon={milestoneTimelineIcon}/>
            </span>
          ) : (
            <span
              className="lp-task-detail-metro-station start draggable"
              style={{left:`${startPct}%`,borderColor:project?.color || "var(--accent)"}}
              title={`Début · ${fmtShort(start)} · glisser pour déplacer`}
              onMouseDown={(e)=>startMetroDateDrag("start",e)}
            />
          )}
          <span
            className="lp-task-detail-metro-station-label"
            style={{
              left:`${startPct}%`,
              transform:startTodayLabelsClose ? "translateX(calc(-100% - 8px))" : "translateX(-50%)",
              textAlign:startTodayLabelsClose ? "right" : "center",
              top:startTodayLabelsClose ? -2 : -1
            }}
          >
            {task.milestone
              ? (todaySameAsStart ? "Jalon · Aujourd’hui" : "Jalon")
              : (todaySameAsStart ? "Début · Aujourd’hui" : "Début")}
          </span>

          {!task.milestone && endWithinWindow && end !== start && (
            taskEndTimelineIcon ? (
              <span
                className="lp-task-detail-metro-icon-station end draggable"
                style={{left:`${pctForDate(end)}%`,color:project?.color || "var(--accent)"}}
                title={`Fin · ${fmtShort(end)} · glisser pour modifier l’échéance`}
                onMouseDown={(e)=>startMetroDateDrag("end",e)}
              >
                <IconGlyph icon={taskEndTimelineIcon} size={14}/>
              </span>
            ) : (
              <span
                className="lp-task-detail-metro-station end draggable"
                style={{left:`${pctForDate(end)}%`,borderColor:project?.color || "var(--accent)"}}
                title={`Fin · ${fmtShort(end)} · glisser pour modifier l’échéance`}
                onMouseDown={(e)=>startMetroDateDrag("end",e)}
              />
            )
          )}

          {todayWithinWindow && (
            <>
              <span className="lp-task-detail-metro-today" style={{left:`${todayPct}%`}}/>
              {!todaySameAsStart && (
                <span
                  className="lp-task-detail-metro-today-label"
                  style={{
                    left:`${todayPct}%`,
                    top:startTodayLabelsClose ? 10 : -1,
                    transform:startTodayLabelsClose ? "translateX(8px)" : "translateX(-50%)",
                    textAlign:startTodayLabelsClose ? "left" : "center"
                  }}
                >
                  Aujourd’hui
                </span>
              )}
            </>
          )}
        </div>
      </div>
      </div>

      <div className="lp-task-detail-main">
        <div className="lp-task-detail-panel">
          <div className="lp-task-detail-panel-title">
            <span>Description</span>
            <div className="lp-density-row" style={{margin:0}}>
              <button type="button" className={"lp-density-btn"+(descMode==="preview"?" active":"")} onClick={()=>{setDescMode("preview");requestAnimationFrame(()=>rootRef.current?.focus({preventScroll:true}));}}>Aperçu</button>
              <button type="button" className={"lp-density-btn"+(descMode==="edit"?" active":"")} onClick={()=>{setDescMode("edit");requestAnimationFrame(()=>descRef.current?.focus({preventScroll:true}));}}>Modifier</button>
            </div>
          </div>

          {descMode==="edit" ? (
            <>
              <div className="lp-callout-insert-row" style={{marginBottom:8}}>
                {Object.entries(CALLOUT_TYPES).map(([key,meta])=>(
                  <button
                    type="button"
                    key={key}
                    className="lp-callout-insert-btn"
                    style={{color:meta.color,borderColor:meta.color+"55"}}
                    title={`Insérer un callout pliable « ${meta.label} » · structure complète ajoutée automatiquement, il ne reste plus qu'à écrire au milieu · ajoute - après le nom pour le fermer par défaut`}
                    onClick={()=>{
                      // Balises begin/end : tout ce qui est tapé entre les deux ":::"
                      // appartient au callout, pas besoin de répéter "> " à chaque ligne.
                      const current=task.desc ?? task.description ?? "";
                      insertMarkdownAtCursor({
                        textarea:descRef.current,
                        value:current,
                        insert:`:::callout-${key} ${meta.label}\n\n:::\n`,
                        onChange:(next)=>update({desc:next}),
                        cursorOffset:-5 // curseur placé sur la ligne vide, entre l'ouverture et ":::"
                      });
                    }}
                  >
                    {meta.icon} {meta.label}
                  </button>
                ))}
                <button
                  type="button"
                  className="lp-callout-insert-btn"
                  style={{color:"var(--text-700)",borderColor:"var(--border-strong)"}}
                  title="Insérer une checklist Markdown"
                  onClick={()=>{
                    const current=task.desc ?? task.description ?? "";
                    insertMarkdownAtCursor({
                      textarea:descRef.current,
                      value:current,
                      insert:"- [ ] ",
                      onChange:(next)=>update({desc:next})
                    });
                  }}
                >
                  ☑ Checklist
                </button>
              </div>
              <textarea
                ref={descRef}
                className="lp-task-detail-desc-edit"
                value={task.desc ?? task.description ?? ""}
                placeholder="Description Markdown…"
                onChange={(e)=>update({desc:e.target.value})}
                onKeyDown={(e)=>{
                  if(!matchesShortcutCombo(e,shortcutPrefs?.markdownChecklist || "Ctrl+Space")) return;
                  e.preventDefault();
                  const current=task.desc ?? task.description ?? "";
                  insertMarkdownAtCursor({
                    textarea:descRef.current,
                    value:current,
                    insert:"- [ ] ",
                    onChange:(next)=>update({desc:next})
                  });
                }}
              />
            </>
          ) : (
            <div
              className="lp-task-detail-desc-preview lp-desc-preview lp-desc-preview-interactive"
              onClick={(e)=>{
                const input=e.target?.closest?.(".lp-md-task-checkbox[data-md-line]");
                if(!input) return;
                e.preventDefault();
                e.stopPropagation();
                const current=task.desc ?? task.description ?? "";
                update({desc:toggleMarkdownTaskLine(current,Number(input.dataset.mdLine),null)});
              }}
              dangerouslySetInnerHTML={{
                __html:renderMarkdown(task.desc ?? task.description ?? "",true) || '<p style="color:var(--text-muted)">Aucune description.</p>'
              }}
            />
          )}

          {checklist.length>0 && (
            <div className="lp-task-detail-checklist">
              <div className="lp-task-detail-panel-title" style={{marginTop:4,marginBottom:2}}><span>Sous-tâches</span></div>
              {checklist.map((item)=>(
                <label key={item.id} className={"lp-task-detail-checkrow"+(item.done?" done":"")}>
                  <input type="checkbox" checked={!!item.done} onChange={(e)=>updateChecklist(item.id,{done:e.target.checked})}/>
                  <span>{item.text || "Sans titre"}</span>
                </label>
              ))}
            </div>
          )}
        </div>

        <div className={"lp-task-detail-panel lp-task-detail-params-panel"+(paramsCollapsed ? " collapsed" : "")}>
          <button
            type="button"
            className="lp-task-detail-panel-title lp-task-detail-collapse-btn"
            onClick={()=>setParamsCollapsed((v)=>!v)}
            title={paramsCollapsed ? "Déplier les paramètres" : "Plier les paramètres"}
            aria-expanded={!paramsCollapsed}
          >
            <span>Paramètres</span>
            <ChevronRight size={13} style={{transform:paramsCollapsed ? "rotate(180deg)" : "rotate(90deg)",transition:"transform .12s ease"}}/>
          </button>
          {!paramsCollapsed && (
          <>
          <div className="lp-task-detail-fields">
            <div className="lp-task-detail-field">
              <label>Projet</label>
              <select value={task.projectId || ""} onChange={(e)=>{
                const nextProjectId=e.target.value;
                const fallback=getDefaultStatusForProject(ctx.statuses,ctx.projects,nextProjectId);
                update({projectId:nextProjectId,statusId:fallback?.id || task.statusId});
              }}>
                {sortedByName(ctx.projects).map((p)=><option key={p.id} value={p.id}>{p.name}</option>)}
              </select>
            </div>

            <div className="lp-task-detail-field">
              <label>Statut{restrictedStatus && <span style={{fontWeight:500,textTransform:"none",color:"var(--text-600)"}}> · automatique</span>}</label>
              <select value={task.statusId || ""} onChange={(e)=>update({statusId:e.target.value})} disabled={!!restrictedStatus} title={restrictedStatus ? "Statut automatique — imposé par le type de tâche" : undefined}>
                {allowedStatuses.map((st)=><option key={st.id} value={st.id}>{st.name}</option>)}
              </select>
            </div>

            <div className="lp-task-detail-field">
              <label>Responsable</label>
              <input value={task.assignee || ""} onChange={(e)=>update({assignee:e.target.value})} placeholder="Non assignée"/>
            </div>

            <div className="lp-task-detail-field">
              <label>Début</label>
              <input type="date" value={task.start || ""} onChange={(e)=>{
                const next=e.target.value;
                update({start:next,end:task.end && task.end<next ? next : task.end});
              }}/>
            </div>

            <div className="lp-task-detail-field">
              <label>Fin / jalon</label>
              <input type="date" value={task.end || ""} onChange={(e)=>{
                const next=e.target.value;
                update(task.milestone ? {start:next,end:next} : {end:next});
              }}/>
            </div>

            <div className="lp-task-detail-field">
              <label>Avancement</label>
              <div className="lp-task-detail-progress-row">
                <input type="range" min="0" max="100" step="5" value={Number(task.progress||0)} onChange={(e)=>update({progress:Number(e.target.value)})}/>
                <input type="number" min="0" max="100" value={Number(task.progress||0)} onChange={(e)=>update({progress:clamp(Number(e.target.value)||0,0,100)})}/>
              </div>
            </div>

            <div className="lp-task-detail-field">
              <label>Type</label>
              <select value={task.milestone ? "milestone" : "task"} onChange={(e)=>{
                const milestone=e.target.value==="milestone";
                update(milestone ? {milestone:true,start:task.end || task.start,end:task.end || task.start} : {milestone:false});
              }}>
                <option value="task">Tâche</option>
                <option value="milestone">Jalon</option>
              </select>
            </div>
          </div>

          <div className="lp-task-detail-actions">
            <button className="lp-btn" type="button" onClick={()=>onOpen(task)}><Pencil size={12}/> Fiche complète</button>
          </div>
          </>
          )}
        </div>
      </div>
    </div>
  );
}

function WidgetCountdown({ widget, tasks, ctx }) {
  let targetDate = widget.countdownDate || null;
  let label = "";
  if (widget.countdownMode === "task" && widget.countdownTaskId) {
    const t = tasks.find((x) => x.id === widget.countdownTaskId);
    if (t) { targetDate = t.end; label = t.title; }
  } else if (widget.countdownMode === "filter") {
    // Cible automatiquement la prochaine échéance parmi les tâches filtrées —
    // pratique pour un compte à rebours qui reste à jour sans jamais avoir à
    // repointer manuellement une tâche précise.
    const scoped = applyWidgetFilter(tasks, widget.filter, ctx).filter((t) => t.end);
    const todayStr = iso(new Date());
    const upcoming = scoped.filter((t) => t.end >= todayStr).sort((a, b) => a.end.localeCompare(b.end));
    const t = upcoming[0] || [...scoped].sort((a, b) => b.end.localeCompare(a.end))[0]; // sinon l'échéance passée la plus récente
    if (t) { targetDate = t.end; label = t.title; }
  }
  if (!targetDate) return <div className="lp-empty" style={{ padding: 16 }}>{widget.countdownMode === "filter" ? "Aucune tâche ne correspond à ce filtre." : "Choisis une date ou une tâche à suivre."}</div>;
  const days = dayIndex(targetDate) - dayIndex(iso(new Date()));
  return (
    <div className="lp-widget-countdown">
      <div className={"lp-widget-countdown-num" + (days < 0 ? " lp-widget-countdown-late" : "")}>
        {days === 0 ? "Aujourd'hui" : days > 0 ? days : Math.abs(days)}
      </div>
      <div className="lp-widget-countdown-sub">
        {days > 0 ? `jour${days > 1 ? "s" : ""} restant${days > 1 ? "s" : ""}` : days < 0 ? `jour${Math.abs(days) > 1 ? "s" : ""} de retard` : ""}
      </div>
      <div className="lp-widget-countdown-date">{label ? `${label} · ` : ""}{fmtShort(targetDate)}</div>
    </div>
  );
}

function WidgetNote({ widget, onChange, shortcutPrefs }) {
  const content = widget.content || "";
  const [mode,setMode] = useState("preview");
  const [writingMode,setWritingMode] = useState(false);
  const rootRef = useRef(null);
  const textareaRef = useRef(null);
  const hoveredRef = useRef(false);

  const insert = (payload,cursorOffset=null) => {
    insertMarkdownAtCursor({
      textarea:textareaRef.current,
      value:content,
      insert:payload,
      onChange,
      cursorOffset,
    });
  };

  // Comme Tâche détaillée : Ctrl+← ne doit agir que sur la Note libre
  // actuellement survolée. Détection explicite pour éviter les différences
  // navigateur autour de e.key / e.code.
  useEffect(()=>{
    const onShortcut=(e)=>{
      if(!hoveredRef.current || writingMode) return;

      const key = String(e.key || "");
      const hardCtrlLeft =
        e.ctrlKey &&
        !e.altKey &&
        !e.shiftKey &&
        !e.metaKey &&
        (key === "ArrowLeft" || e.code === "ArrowLeft");

      const configured =
        matchesShortcutCombo(e,shortcutPrefs?.markdownPreviewToggle || "Ctrl+ArrowLeft");

      if(!hardCtrlLeft && !configured) return;

      e.preventDefault();
      e.stopPropagation();
      e.stopImmediatePropagation?.();

      setMode((current)=>{
        const next = current === "preview" ? "edit" : "preview";
        requestAnimationFrame(()=>{
          if(next === "edit") textareaRef.current?.focus({preventScroll:true});
          else rootRef.current?.focus({preventScroll:true});
        });
        return next;
      });
    };

    // Capture : priorité à la note survolée avant les raccourcis globaux Nexora.
    window.addEventListener("keydown",onShortcut,true);
    return ()=>window.removeEventListener("keydown",onShortcut,true);
  },[shortcutPrefs,writingMode]);

  return (
    <div
      ref={rootRef}
      tabIndex={0}
      className="lp-widget-note-rich"
      onMouseEnter={()=>{hoveredRef.current=true;}}
      onMouseLeave={()=>{hoveredRef.current=false;}}
      onMouseDown={(e)=>e.stopPropagation()}
      onKeyDown={(e)=>{
        const key = String(e.key || "");
        const hardCtrlLeft =
          e.ctrlKey &&
          !e.altKey &&
          !e.shiftKey &&
          !e.metaKey &&
          (key === "ArrowLeft" || e.code === "ArrowLeft");
        if(!hoveredRef.current || writingMode || !hardCtrlLeft) return;
        if(e.defaultPrevented) return;
        e.preventDefault();
        e.stopPropagation();
        setMode((current)=>current === "preview" ? "edit" : "preview");
      }}
    >
      {writingMode && (
        <TaskWritingModeOverlay
          title={widget.title || "Note libre"}
          desc={content}
          onChangeDesc={onChange}
          onClose={()=>setWritingMode(false)}
          shortcutPrefs={shortcutPrefs}
          modeLabel="Mode écriture · Note libre"
          showTaskMeta={false}
        />
      )}

      <div className="lp-widget-note-toolbar">
        <button
          type="button"
          className="lp-writing-mode-launch"
          onClick={()=>setWritingMode(true)}
          title="Ouvrir le mode écriture plein écran"
        >
          <Pencil size={12}/> Mode écriture
        </button>

        <div className="lp-desc-mode-toggle">
          <button type="button" className={mode==="edit" ? "active" : ""} onClick={()=>setMode("edit")}>Écrire</button>
          <button type="button" className={mode==="preview" ? "active" : ""} onClick={()=>setMode("preview")}>Aperçu</button>
        </div>
      </div>

      {mode==="edit" && (
        <div className="lp-widget-note-markdown-tools">
          {Object.entries(CALLOUT_TYPES).map(([key,meta])=>(
            <button
              type="button"
              key={key}
              className="lp-callout-insert-btn"
              style={{color:meta.color,borderColor:meta.color+"55"}}
              onClick={()=>insert(`:::callout-${key} ${meta.label}\n\n:::\n`,-5)}
            >
              {meta.icon} {meta.label}
            </button>
          ))}
          <button type="button" className="lp-callout-insert-btn" onClick={()=>insert("- [ ] ")}>☑ Checklist</button>
        </div>
      )}

      <div className="lp-widget-note-editor">
        {mode==="edit" ? (
          <textarea
            ref={textareaRef}
            className="lp-widget-note lp-widget-note-markdown-edit"
            value={content}
            placeholder="Écris une note… Markdown, callouts et checklists sont pris en charge."
            onChange={(e)=>onChange(e.target.value)}
            onKeyDown={(e)=>{
              if(!matchesShortcutCombo(e,shortcutPrefs?.markdownChecklist || "Ctrl+Space")) return;
              e.preventDefault();
              e.stopPropagation();
              insert("- [ ] ");
            }}
          />
        ) : (
          <div
            className="lp-widget-note-preview lp-desc-preview lp-desc-preview-interactive"
            onClick={(e)=>toggleMarkdownTaskFromClick(e,content,onChange)}
            dangerouslySetInnerHTML={{
              __html:renderMarkdown(content,true) || '<p style="color:var(--text-muted)">Aucune note.</p>'
            }}
          />
        )}
      </div>
    </div>
  );
}

function WidgetBudget({ widget, projects, expenses, expenseCategories }) {
  const projectId = widget.budgetProjectId || projects[0]?.id || null;
  if (!projectId) return <div className="lp-empty" style={{ padding: 16 }}>Aucun projet.</div>;
  const stats = computeBudgetStats(projectId, projects, expenses);
  const categories = stats.project?.budgetCategories || expenseCategories;
  const metric = widget.budgetMetric || "engaged";
  if (metric === "byCategory") {
    const data = categories
      .map((c) => ({ label: c.name, color: c.color || "var(--text-muted)", value: stats.projectExpenses.filter((e) => e.categoryId === c.id).reduce((s, e) => s + (Number(e.amount) || 0), 0) }))
      .filter((d) => d.value > 0);
    if (data.length === 0) return <div className="lp-empty" style={{ padding: 16 }}>Aucune dépense enregistrée.</div>;
    return (
      <div className="lp-widget-chart-row">
        <PieChart data={data} size={110} />
        <div className="lp-widget-legend">
          {data.map((d) => (
            <div key={d.label} className="lp-widget-legend-item">
              <span className="lp-widget-legend-dot" style={{ background: d.color }} />
              <span className="lp-widget-legend-label">{d.label}</span>
              <span className="lp-widget-legend-value">{fmtEuro(d.value)}</span>
            </div>
          ))}
        </div>
      </div>
    );
  }
  const value = metric === "pctConsumed" ? `${stats.pct}%` : metric === "reste" ? fmtEuro(stats.reste) : fmtEuro(stats.consumed);
  return (
    <div>
      <div className="lp-widget-kpi">{value}</div>
      <div className="lp-widget-countdown-sub">{stats.project?.name || ""}</div>
    </div>
  );
}



// Champs optionnels affichables à côté de chaque barre du Mini-Gantt — mêmes clés
// que FieldValue, pour garantir une mise en forme identique au reste de l'app
// (pastille de statut, badge de type, chip responsable, format de date).
const MINIGANTT_ROW_FIELD_OPTIONS = ["assignee", "status", "criticality", "taskType", "end", "progress"];
// Hauteur d'un couloir d'étiquettes de bloc temporel : capsule + interligne.
const MINIGANTT_PHASE_LANE_H = 22;
/* Hauteur d'un couloir de la bande de repères (jalons et annotations), et
   hauteur à laquelle le losange est centré dans son couloir. Le trait vertical
   d'un jalon part de ce point précis : il PROLONGE le losange, il ne flotte pas
   sous lui (#95). */
const MINIGANTT_STRIP_LANE_H = 17;
const MINIGANTT_STRIP_GLYPH_MID = 7.5;

// Anneau de progression du Mini-Gantt : contour coloré selon des paliers fixes
// (rouge <50 %, orange 50-75 %, bleu 75-90 %, vert ≥90 %), remplacé par un
// logo dédié aux deux bornes (0 % / 100 %) plutôt qu'un anneau vide ou plein.
function MiniGanttProgressRing({ progress }) {
  const pct = Math.max(0, Math.min(100, Math.round(progress || 0)));
  if (pct <= 0) {
    return <img src="https://cdn-icons-png.flaticon.com/512/11193/11193291.png" alt="0%" className="lp-widget-minigantt-progress-logo" />;
  }
  if (pct >= 100) {
    return <img src="https://cdn-icons-png.flaticon.com/512/4685/4685238.png" alt="100%" className="lp-widget-minigantt-progress-logo" />;
  }
  const color = pct < 50 ? "#D64545" : pct < 75 ? "#E28A2B" : pct < 90 ? "#2F7FE0" : "#2FA85A";
  const D = 16, R = 6.4, SW = 2.4, C = 2 * Math.PI * R;
  return (
    <svg width={D} height={D} viewBox={`0 0 ${D} ${D}`}>
      <circle cx={D / 2} cy={D / 2} r={R} fill="none" stroke="var(--paper-soft)" strokeWidth={SW} />
      <circle
        cx={D / 2} cy={D / 2} r={R} fill="none" stroke={color} strokeWidth={SW} strokeLinecap="round"
        strokeDasharray={`${(C * pct) / 100} ${C}`}
        transform={`rotate(-90 ${D / 2} ${D / 2})`}
      />
    </svg>
  );
}

/* `bubbleMode` — widget « Bulles » (#92). Le diagramme est le MÊME : axe,
   fenêtre, zoom, groupes repliables, annotations, infobulles, glisser des dates
   et de l'avancement. Seule la LIGNE change : une bulle descriptive au lieu
   d'une barre, ses champs sous la bulle, et des macro-bulles par-dessus. C'est
   un mode de lecture, pas un second diagramme — un clone aurait divergé du
   premier au premier correctif d'axe, comme l'avaient fait les deux
   formulaires de réglages avant #86.
   Hors de ce mode, pas une branche ci-dessous ne s'exécute : le Mini-Gantt rend
   exactement ce qu'il rendait. */
function WidgetMiniGantt({ widget, tasks, ctx, onOpen, onUpdateWidget, onUpdateTask, groupBy, metaBlocks, toolbarSlot, onOpenSettings, bubbleMode, showAllRows }) {
  // Les Mini Gantt existants n'avaient pas toujours de `groupBy`. La vue
  // consolidée doit néanmoins fournir ses en-têtes repliables : Projet devient
  // le défaut de lecture, sans modifier une configuration explicitement à
  // "none" ou vers un autre champ.
  const effectiveGroupBy = groupBy === undefined || groupBy === null || groupBy === ""
    ? "project"
    : groupBy;
  const colorBy = widget.colorBy || "status"; // "status" | "project"
  /* Réglages propres aux bulles, normalisés une fois pour toutes. Ils vivent
     sous leurs propres clés (`bubble*`) et ne remplacent jamais celles du
     Mini-Gantt : un même widget peut donc passer d'un mode à l'autre sans rien
     perdre de sa fenêtre, de son zoom, de son tri ni de ses annotations. */
  const bubbleCfg = bubbleMode ? normalizeBubblesWidget(widget) : null;
  /* Clés STABLES pour les dépendances des mémos : `bubbleCfg` est un objet neuf
     à chaque rendu (il normalise), le donner en dépendance reviendrait à tout
     recalculer à chaque trame. */
  const bubbleColorByKey = bubbleMode ? bubbleCfg.bubbleColorBy : "";
  const bubbleMacroGroupingOn = !!(bubbleMode && bubbleCfg.bubbleMacroGrouping);
  const bubbleMacrosKey = bubbleMode ? JSON.stringify(bubbleCfg.bubbleMacros) : "";

  /* Regroupement des lignes d'une macro-bulle. Déclaré ICI, avant le premier
     mémo qui l'appelle : une fonction en `const` invoquée pendant le rendu
     d'un useMemo situé plus haut lèverait une ReferenceError de zone morte. */
  const bubbleMacroReorder = (list) => {
    if (!bubbleMacroGroupingOn || !bubbleCfg.bubbleMacros.length) return list;
    const byId = new Map(list.map((t) => [t.id, t]));
    return bubbleRowOrder(list.map((t) => t.id), bubbleCfg.bubbleMacros, { grouping: true })
      .map((id) => byId.get(id))
      .filter(Boolean);
  };

  const rowFields = bubbleMode
    ? bubbleCfg.bubbleFields
    : (widget.miniGanttFields || ["assignee", "status", "taskType", "end", "progress"]);
  // Clé STABLE de la liste de champs : la donner telle quelle en dépendance
  // relancerait la mesure à chaque trame, le tableau étant neuf à chaque rendu.
  const rowFieldsKey = rowFields.join("|");
  // "aligned" = colonne à largeur fixe alignée à droite (les barres restent
  // alignées d'une ligne à l'autre) ; "inline" = juste après la barre/le
  // jalon, ancré sur sa position réelle dans le temps.
  // En mode bulles, "under" range les champs SOUS la bulle : il n'y a alors
  // aucune colonne de droite, et la piste occupe toute la largeur.
  // En mode bulles, « compact » (#122) est le bandeau condensé rattaché à la
  // bulle, et les couloirs (#120) l'imposent : c'est la seule forme de champs
  // qui ne déborde pas sur la bulle voisine.
  const fieldsLayout = bubbleMode
    ? bubbleEffectiveFieldsLayout(bubbleCfg)
    : (widget.miniGanttFieldsLayout === "inline" ? "inline" : "aligned");
  /* Bulles rangées en couloirs plutôt qu'une par ligne (#120). */
  const bubblePacked = bubbleMode && normalizeBubbleLayout(bubbleCfg.bubbleLayout) === "lanes";
  /* Largeur de la colonne de champs alignée à droite. Elle ne peut pas rester
     FIXE : quatre champs plus l'anneau d'avancement dépassent largement
     deux cents pixels, et le surplus débordait hors du widget, où le cadre le
     coupait — l'anneau finissait tronqué (#31). Elle est donc MESURÉE sur le
     contenu réel, puis réutilisée à l'identique par l'en-tête, la légende et la
     couche des blocs : c'est ce qui garde les barres alignées d'une ligne à
     l'autre.

     Il n'y a plus de PLANCHER. Celui de 232 px, hérité de #31, réservait la
     même bande pour un seul anneau que pour cinq champs : la piste était
     écrasée de près de deux cents pixels pour rien (#66). Le plafond
     (rootW * 0.46) et la mesure suffisent à traiter le cas inverse — c'est lui
     qui empêche la colonne d'avaler la piste, pas le plancher.

     Le départ à zéro est délibéré : la mesure arrive à la trame suivante, et
     partir large ferait rétrécir la colonne sous les yeux à chaque ouverture,
     alors que partir à zéro ne la fait grandir que là où il y a vraiment des
     champs à loger. */
  const [fieldsColWidth, setFieldsColWidth] = useState(0);
  const fieldNodes = useRef({});
  const FIELDS_COL_WIDTH = fieldsColWidth;
  /* Largeur de la colonne d'ÉTIQUETTES, mesurée sur son contenu comme celle
     des champs l'est déjà. Elle valait 26 % de la largeur, quoi qu'il y ait
     dedans : sur des titres courts, cent cinquante pixels de blanc séparaient
     le dernier mot de la piste (retour de test).

     Le plafond reste ces 26 % : la colonne ne peut que RÉTRÉCIR, jamais
     grandir — un titre long est tronqué exactement comme avant, et le
     diagramme ne perd pas un pixel de piste par rapport à aujourd'hui. Pas de
     plancher, pour la même raison que la colonne de champs : une colonne large
     réservée à un titre court, c'est précisément le défaut qu'on corrige.

     `null` = pas encore mesurée : la feuille de style garde ses 26 % le temps
     d'une trame, plutôt qu'un diagramme qui s'ouvre sur une colonne à zéro. */
  const [labelColWidth, setLabelColWidth] = useState(null);
  const [hover, setHover] = useState(null); // { t, x, y }
  // Surlignage par la légende du mode bulles : clé de groupe mise en avant, ou
  // null. C'est une mise en avant, jamais un filtre — rien ne disparaît.
  const [bubbleHighlight, setBubbleHighlight] = useState(null);
  const [collapsed, setCollapsed] = useState({}); // { [groupKey]: true }
  const toggleGroup = (key) => setCollapsed((c) => ({ ...c, [key]: !c[key] }));
  const showMilestones = widget.showMilestones !== false;
  /* Plafond d'affichage : une TUILE de tableau de bord, haute de quelques
     centimètres, ne peut pas montrer deux cents lignes — d'où ces vingt barres
     et ces douze jalons. La VUE Gantt, elle, occupe la page entière et n'a
     aucune raison de s'y tenir : le même plafond y faisait disparaître des
     tâches qu'on voyait dans le Tableur et dans le Métro, sans le dire, y
     compris à statut identique (#115). `showAllRows` lève la limite ; il n'est
     posé que par la vue plein écran, aucun widget enregistré ne change de
     rendu. */
  const rowLimits = showAllRows
    ? { bars: Infinity, milestones: Infinity }
    : { bars: MINIGANTT_WIDGET_MAX_BARS, milestones: MINIGANTT_WIDGET_MAX_MILESTONES };
  const barLimit = rowLimits.bars;
  const milestoneLimit = rowLimits.milestones;
  // Le choix des lignes retenues sous le plafond vit dans miniGanttCapRows :
  // une barre a besoin d'un début ET d'une fin, un jalon d'une fin, et la date
  // qui les ordonne n'est pas la même — le reste est commun.
  const projTasks = useMemo(
    () => miniGanttCapRows(tasks.filter((t) => !t.milestone && t.start && t.end), barLimit, "start", iso(new Date())),
    [tasks, barLimit]
  );
  const milestoneTasks = useMemo(
    () => (showMilestones ? miniGanttCapRows(tasks.filter((t) => t.milestone && t.end), milestoneLimit, "end", iso(new Date())) : []),
    [tasks, showMilestones, milestoneLimit]
  );
  /* Ce que le diagramme NE MONTRE PAS, dit à voix haute. Deux causes, un seul
     nombre : le plafond ci-dessus, et les tâches dont il manque une date — une
     barre a besoin d'un début ET d'une fin, un jalon d'une fin. Les jalons
     masqués par le réglage « afficher les jalons » ne comptent pas : ils sont
     cachés à la demande, pas à l'insu de l'utilisateur. */
  const hiddenCount = useMemo(() => {
    const considered = showMilestones ? (tasks || []) : (tasks || []).filter((t) => !t.milestone);
    return Math.max(0, considered.length - projTasks.length - milestoneTasks.length);
  }, [tasks, projTasks, milestoneTasks, showMilestones]);
  /* Ordre d'affichage : UNE seule liste triée, barres et jalons confondus.

     Auparavant les jalons étaient tous rendus après toutes les barres : un
     jalon de 2022 se retrouvait sous une tâche de 2026, quel que soit le tri
     (retour de test). Le partage barres/jalons ne sert plus qu'à deux choses —
     choisir le composant de rendu, et appliquer à chacun son propre plafond
     d'affichage. */
  const sortKey = normalizeMiniGanttSort(widget.miniGanttSort);
  const sortDir = normalizeMiniGanttSortDir(widget.miniGanttSortDir);
  const orderedTasks = useMemo(
    /* Mode bulles : « regrouper les tâches d'une macro-bulle » amène leurs
       lignes côte à côte, pour qu'une macro-bulle forme une bande d'un seul
       tenant au lieu d'une enveloppe trouée. C'est le SEUL endroit qui décide
       de l'ordre des lignes — le regroupement par champ repart de cette liste
       et le réapplique groupe par groupe (voir macroOrderedGroups). */
    () => bubbleMacroReorder(miniGanttSortTasks([...projTasks, ...milestoneTasks], sortKey, sortDir)),
    [projTasks, milestoneTasks, sortKey, sortDir, bubbleMacroGroupingOn, bubbleMacrosKey]
  );
  // Index des tâches rendues, par identifiant. Servait déjà, recalculé sur
  // place, à l'ancrage des annotations ; la pastille d'un encadré en a besoin
  // elle aussi, pour lire l'icône choisie dans la fiche de la tâche.
  const tasksById = useMemo(
    () => new Map([...projTasks, ...milestoneTasks].map((t) => [t.id, t])),
    [projTasks, milestoneTasks]
  );

  // IMPORTANT : tous les Hooks doivent être appelés à chaque rendu, dans le
  // même ordre — le early-return "aucune tâche" est donc repoussé après TOUS
  // les Hooks (voir plus bas), avec des valeurs de repli sûres ici plutôt que
  // de sauter des Hooks (ce qui provoquait un crash React #310 dès qu'un
  // widget filtré ne matchait plus aucune tâche).
  const isEmpty = projTasks.length === 0 && milestoneTasks.length === 0;
  const today = iso(new Date());
  const todayIdx = dayIndex(today);
  const allForRange = isEmpty ? [] : [...projTasks, ...milestoneTasks];

  // Mode Comparaison du widget. Propriété absente = mode Standard : un widget
  // enregistré avant ce changement rend exactement comme avant, sans migration.
  const comparisonOn = miniGanttComparisonEnabledOn(widget);
  const setComparisonMode = (on) => {
    if (onUpdateWidget) onUpdateWidget({ miniGanttComparisonEnabled: !!on });
  };
  // Les dates de RÉFÉRENCE élargissent la plage automatique au même titre que
  // les dates actuelles : une barre fantôme antérieure ou postérieure ne doit
  // jamais être coupée par le bord du diagramme. Volontairement calculé sans
  // Hook — c'est un parcours de quelques dizaines d'éléments, et aucun Hook
  // conditionnel ne peut se glisser avant le retour anticipé « aucune tâche ».
  const comparisonRangeIdx = miniGanttComparisonRangeIndices(allForRange, comparisonOn);

  const naturalMinIdx = isEmpty
    ? todayIdx
    : Math.min(...allForRange.map((t) => dayIndex(t.start || t.end)), ...comparisonRangeIdx);
  const naturalMaxIdx = isEmpty
    ? todayIdx
    : Math.max(...allForRange.map((t) => dayIndex(t.end)), ...comparisonRangeIdx);

  /* Cadrage temporel du widget. Trois modes, un seul réglage :
       auto    — l'étendue des tâches retenues ;
       rolling — une fenêtre glissante autour d'aujourd'hui, en mois ;
       fixed   — deux dates arrêtées à la main.
     Absent, c'est `auto` : un widget d'avant ce réglage ne bouge pas. */
  const rangeCfg = normalizeMiniGanttRange(widget.miniGanttRange);

  /* Le filtre « X jours dans le passé » choisit les TÂCHES, pas le cadrage.
     Il bornait aussi le côté GAUCHE de l'axe — et lui seul : une tâche démarrée
     en 2022 et terminée cette année passait le filtre (qui ne regarde que la
     date de FIN) mais se retrouvait amputée de son début, hors cadre, pendant
     que rien ne bornait le côté droit. D'où un cadrage automatique qui cachait
     le passé tout en réservant des années vides à l'avenir (retour de test).
     Le mode automatique se cale désormais sur la plus ancienne et la plus
     lointaine des dates réellement dessinées, sans exception.

     La ligne « aujourd'hui » reste visible dans l'axe même si toutes les tâches
     affichées sont entièrement passées ou entièrement futures — sauf si le
     cadrage automatique demande explicitement le contraire. */
  const filteredMinIdx = naturalMinIdx;
  const autoWindow = miniGanttRangeWindow(rangeCfg, {
    minIdx: filteredMinIdx, maxIdx: naturalMaxIdx, todayIdx, todayIso: today,
  }) || { minIdx: filteredMinIdx, maxIdx: Math.max(filteredMinIdx + 1, naturalMaxIdx) };
  const autoMinIdx = autoWindow.minIdx;
  const autoMaxIdx = Math.max(autoMinIdx + 1, autoWindow.maxIdx);
  const autoSpan = Math.max(1, autoMaxIdx - autoMinIdx);
  /* Bornes utiles pour le zoom manuel : tout ce qu'il y a à montrer, dates de
     référence et repère « Aujourd'hui » compris. Au-delà, la piste est vide. */
  const usefulMinIdx = Math.min(filteredMinIdx, autoMinIdx, todayIdx);
  const usefulMaxIdx = Math.max(naturalMaxIdx, autoMaxIdx, todayIdx);

  // Zoom manuel persistant du widget :
  // null/undefined = automatique ; -2..+2 = niveaux relatifs à l'étendue auto.
  // + = zoom avant (moins de jours), - = zoom arrière (plus de jours).
  const zoomLevel = Number.isFinite(Number(widget.miniGanttZoomLevel))
    ? clamp(Number(widget.miniGanttZoomLevel), -2, 2)
    : null;
  const zoomIsAuto = zoomLevel == null;
  const zoomFactor = zoomIsAuto ? 1 : Math.pow(1.65, -zoomLevel);
  const manualSpan = Math.max(2, Math.round(autoSpan * zoomFactor));
  const autoCenter = todayIdx >= autoMinIdx && todayIdx <= autoMaxIdx
    ? todayIdx
    : Math.round((autoMinIdx + autoMaxIdx) / 2);

  /* Fenêtre à dates fixes. C'est le cadrage « Dates fixes » des paramètres —
     et c'est aussi la fenêtre qu'un widget enregistré avant le retrait du
     bouton de cadrage (#48) a pu garder. Elle prime sur le zoom automatique
     comme sur les niveaux manuels, et les boutons − / Auto / + la relâchent. */
  const pinnedWindow = miniGanttPinnedWindow(widget);

  /* Le zoom manuel était CENTRÉ SUR AUJOURD'HUI, sans borne : à un niveau
     large, il réservait la moitié de la piste à des années vides pendant qu'il
     coupait les tâches les plus anciennes (retour de test). La fenêtre est
     désormais ramenée dans les bornes utiles — on la fait GLISSER, pas rétrécir,
     pour ne pas trahir le zoom demandé. */
  const manualWindow = miniGanttClampWindow(
    { minIdx: autoCenter - Math.floor(manualSpan / 2), maxIdx: autoCenter - Math.floor(manualSpan / 2) + manualSpan },
    { minIdx: usefulMinIdx, maxIdx: usefulMaxIdx }
  );

  const minIdx = pinnedWindow ? pinnedWindow.minIdx : (zoomIsAuto ? autoMinIdx : manualWindow.minIdx);
  const maxIdx = pinnedWindow
    ? Math.max(pinnedWindow.minIdx + 1, pinnedWindow.maxIdx)
    : (zoomIsAuto ? autoMaxIdx : Math.max(minIdx + 1, manualWindow.maxIdx));
  const span = Math.max(1, maxIdx - minIdx);

  const setZoomLevel = (next) => {
    if (!onUpdateWidget) return;
    // Poser un niveau de zoom relâche toujours la fenêtre épinglée : sinon les
    // boutons − / Auto / + resteraient sans effet visible.
    if (next == null) onUpdateWidget({miniGanttZoomLevel:null, miniGanttWindow:null});
    else onUpdateWidget({miniGanttZoomLevel:clamp(next,-2,2), miniGanttWindow:null});
  };
  const zoomIn = () => setZoomLevel(zoomIsAuto ? 1 : zoomLevel + 1);
  const zoomOut = () => setZoomLevel(zoomIsAuto ? -1 : zoomLevel - 1);
  const resetZoom = () => setZoomLevel(null);

  // dayIndex() est relatif au 01/01/2020 : il ne faut surtout pas
  // reconvertir cet index comme un timestamp Unix, sinon l'axe part vers 1970.
  const minDateStr = addDays("2020-01-01", minIdx);
  const maxDateStr = addDays("2020-01-01", maxIdx);
  const ticks = isEmpty ? [] : widgetAxisTicks(minDateStr, maxDateStr);
  /* DEUX lignes, pas une.

     Les bornes exactes de la fenêtre et les graduations de l'axe partageaient
     la même ligne, dédoublonnées par la seule égalité des dates : une borne au
     12/03/2022 et la graduation « 2022 » sont deux dates différentes, elles se
     superposaient donc à quelques pixels près, et l'on lisait « 20222022 »
     (retour de test). Elles n'ont pas non plus le même rôle : l'unité de l'axe
     est la MÉTRIQUE, les bornes ne sont qu'un repère de cadrage.

     Ligne du haut — l'unité (années, trimestres, mois…), accentuée.
     Ligne du bas — les deux bornes, discrètes, chacune calée sur son bord. */
  const axisEdges = useMemo(() => {
    if (isEmpty) return [];
    const dayLabel = (d) => {
      const dt = new Date(d + "T00:00:00");
      return `${String(dt.getDate()).padStart(2,"0")}/${String(dt.getMonth()+1).padStart(2,"0")}/${dt.getFullYear()}`;
    };
    if (minDateStr === maxDateStr) return [{ date: minDateStr, label: dayLabel(minDateStr), edge: "start" }];
    return [
      { date: minDateStr, label: dayLabel(minDateStr), edge: "start" },
      { date: maxDateStr, label: dayLabel(maxDateStr), edge: "end" },
    ];
  }, [isEmpty, minDateStr, maxDateStr]);
  const secondaryTicks = useMemo(() => (isEmpty ? [] : widgetSecondaryTicks(minDateStr, maxDateStr)), [minDateStr, maxDateStr, isEmpty]);
  /* Troisième niveau, un cran plus fin encore : année → trimestre → mois,
     trimestre → mois → semaine, mois → semaine → jour. Il se tait de lui-même
     quand il deviendrait un peigne illisible (voir widgetTertiaryTicks). */
  const tertiaryTicks = useMemo(() => (isEmpty ? [] : widgetTertiaryTicks(minDateStr, maxDateStr)), [minDateStr, maxDateStr, isEmpty]);
  // Contexte supplémentaire : à un zoom suffisamment large (peu de jours affichés),
  // on ajoute le jour de la semaine sous chaque étiquette de date, et on teinte
  // légèrement les week-ends — comme dans la vue Planning Projets complète.
  const showDayContext = span <= 45;
  const DOW_SHORT = ["dim.", "lun.", "mar.", "mer.", "jeu.", "ven.", "sam."];
  const weekendBands = useMemo(() => {
    if (isEmpty || !showDayContext) return [];
    const arr = [];
    let cur = minDateStr;
    let guard = 0;
    while (dayIndex(cur) <= dayIndex(maxDateStr) && guard < 400) {
      const dow = new Date(cur + "T00:00:00").getDay();
      if (dow === 0 || dow === 6) arr.push(dayIndex(cur));
      cur = addDays(cur, 1);
      guard++;
    }
    return arr;
  }, [minDateStr, maxDateStr, showDayContext, isEmpty]);
  const showToday = todayIdx >= minIdx && todayIdx <= maxIdx;
  const pctFor = (idx) => `${((idx - minIdx) / span) * 100}%`;
  // La pastille de projet ne s'affiche que si plusieurs projets sont réellement
  // mélangés dans ce widget — inutile (et redondant) pour un widget mono-projet,
  // et redondante aussi quand le regroupement se fait déjà par projet.
  const multiProject = new Set([...projTasks, ...milestoneTasks].map((t) => t.projectId)).size > 1;
  const showRowProj = multiProject && groupBy !== "project";
  /* L'infobulle ne s'ouvre NI pendant un glisser, NI au survol d'une poignée
     (#106). Elle se pose 14 px en bas à droite du curseur, et la poignée
     d'avancement vit sur le bord inférieur d'une bulle : s'en approcher la
     faisait disparaître sous l'infobulle, et l'on glissait à l'aveugle. La
     poignée porte son propre libellé au survol, qui dit déjà quoi faire.
     `dragStateRef` est une ref : elle est déjà posée quand ce survol arrive. */
  const openTip = (t, e) => {
    if (dragStateRef.current) return;
    setHover({ t, x: e.clientX, y: e.clientY });
  };
  /* Posé sur chaque poignée : referme l'infobulle, et empêche la ligne de la
     rouvrir aussitôt par son propre survol. */
  const handleHoverGuard = {
    onMouseEnter: (e) => { e.stopPropagation(); setHover(null); },
    onMouseMove: (e) => { e.stopPropagation(); setHover(null); },
  };

  // Glisser-déposer directement sur la barre : bord gauche = date de début,
  // bord droit = date de fin (ou position du jalon), poignée ronde sur le
  // remplissage = avancement. Le delta en jours/en % est calculé à partir de
  // la largeur en pixels RÉELLE de la piste au moment du clic (capturée dans
  // la ref de glisser), jamais depuis une valeur de state qui pourrait devenir
  // périmée pendant le geste — même principe que le glisser-déposer de la vue
  // Gantt complète.
  const dragStateRef = useRef(null);
  const suppressClickRef = useRef(false);
  useEffect(() => {
    function onMove(e) {
      const d = dragStateRef.current;
      if (!d || !onUpdateTask) return;
      const point = e.touches ? e.touches[0] : e;
      if (!point) return;
      if (e.cancelable) e.preventDefault();
      if (d.mode === "progress") {
        // Mesuré sur la barre : 0 % à son bord gauche, 100 % à son bord droit,
        // donc la poignée reste exactement sous le pointeur.
        const pct = Math.round(Math.max(0, Math.min(1, (point.clientX - d.refLeft) / d.refWidth)) * 100);
        if (pct !== d.lastProgress) { d.moved = true; d.lastProgress = pct; onUpdateTask(d.taskId, { progress: pct }); }
        return;
      }
      const deltaDays = Math.round((point.clientX - d.startX) / d.dayWidth);
      if (deltaDays === d.lastDelta) return;
      d.moved = true; d.lastDelta = deltaDays;
      if (d.mode === "move-milestone") {
        const nd = addDays(d.origStart, deltaDays);
        onUpdateTask(d.taskId, { start: nd, end: nd });
      } else if (d.mode === "start") {
        let nd = addDays(d.origStart, deltaDays);
        if (dayIndex(nd) > dayIndex(d.origEnd)) nd = d.origEnd;
        onUpdateTask(d.taskId, { start: nd });
      } else if (d.mode === "end") {
        let nd = addDays(d.origEnd, deltaDays);
        if (dayIndex(nd) < dayIndex(d.origStart)) nd = d.origStart;
        onUpdateTask(d.taskId, { end: nd });
      }
    }
    function onUp() {
      const d = dragStateRef.current;
      if (d && d.moved) suppressClickRef.current = true;
      dragStateRef.current = null;
      document.body.style.cursor = "";
    }
    window.addEventListener("mousemove", onMove);
    window.addEventListener("mouseup", onUp);
    window.addEventListener("touchmove", onMove, { passive: false });
    window.addEventListener("touchend", onUp);
    window.addEventListener("touchcancel", onUp);
    return () => {
      window.removeEventListener("mousemove", onMove); window.removeEventListener("mouseup", onUp);
      window.removeEventListener("touchmove", onMove); window.removeEventListener("touchend", onUp); window.removeEventListener("touchcancel", onUp);
    };
  }, [onUpdateTask]);

  // `refEl` est l'élément SUR LEQUEL le geste se mesure, et il n'est pas le
  // même selon le mode :
  //  - dates (début, fin, jalon) : la PISTE, puisqu'un déplacement se convertit
  //    en jours via la largeur d'une journée ;
  //  - avancement : la BARRE, puisque la poignée est positionnée en pourcentage
  //    de la barre (`left: pct%` dans .lp-widget-minigantt-bar).
  // Mesurer l'avancement sur la piste entière faisait avancer la poignée d'une
  // simple fraction du déplacement de la souris : plus la barre était courte
  // par rapport à la fenêtre affichée, plus le pointeur s'éloignait d'elle.
  const startBarDrag = (e, task, mode, refEl) => {
    if (!onUpdateTask || !refEl) return;
    const touch = e.touches && e.touches[0];
    if (!touch && e.button !== 0) return;
    e.preventDefault(); e.stopPropagation();
    const rect = refEl.getBoundingClientRect();
    dragStateRef.current = {
      taskId: task.id, mode,
      startX: touch ? touch.clientX : e.clientX,
      origStart: task.start, origEnd: task.end,
      refLeft: rect.left, refWidth: rect.width || 1,
      dayWidth: (rect.width / span) || 1,
      lastDelta: 0, lastProgress: task.progress || 0, moved: false,
    };
    document.body.style.cursor = mode === "progress" ? "ew-resize" : (mode === "move-milestone" ? "grabbing" : "ew-resize");
  };
  const openTaskUnlessDragged = (t) => () => {
    if (suppressClickRef.current) { suppressClickRef.current = false; return; }
    onOpen(t);
  };

  // --- Annotations : blocs temporels et encadrés ---------------------------
  // Mêmes données et même logique pure que le Mini Gantt
  // (widget.ganttAnnotations) : un seul jeu de règles sert les deux diagrammes.
  // Tous ces Hooks restent AVANT le retour anticipé « aucune tâche » ci-dessous.
  const annotationStore = ganttAnnotationsOf(widget);
  const rawTemporalBlocks = useMemo(() => (Array.isArray(annotationStore.temporalBlocks) ? annotationStore.temporalBlocks : []), [annotationStore.temporalBlocks]);
  const rawHighlightFrames = useMemo(() => (Array.isArray(annotationStore.highlightFrames) ? annotationStore.highlightFrames : []), [annotationStore.highlightFrames]);
  // Méta blocs des Réglages : dessinés comme les autres mais non modifiables
  // ici. Leur identifiant est préfixé pour ne jamais entrer en collision avec
  // un bloc propre au widget, et pour que le clic n'ouvre pas son éditeur.
  const scopedMetaBlocks = useMemo(
    () => normalizeMetaTemporalBlocks(metaBlocks).map((b) => ({ ...b, id: "meta:" + b.id, meta: true })),
    [metaBlocks]
  );
  const temporalBlocks = useMemo(
    () => [...normalizeTemporalBlocks(rawTemporalBlocks), ...scopedMetaBlocks],
    [rawTemporalBlocks, scopedMetaBlocks]
  );
  const highlightFrames = useMemo(() => normalizeHighlightFrames(rawHighlightFrames), [rawHighlightFrames]);
  const applyAnnotations = (patch) => {
    if (!onUpdateWidget) return;
    onUpdateWidget({ ganttAnnotations: {
      temporalBlocks: rawTemporalBlocks,
      highlightFrames: rawHighlightFrames,
      milestones: rawMilestones,
      risks: rawRisks,
      notes: rawNotes,
      spans: rawSpans,
      ...patch,
    } });
  };
  const [annotationPanel, setAnnotationPanel] = useState(null); // null | { section, autoCreate, focusId }

  /* « Supprimer focus et présenter, la checkbox ne sert qu'à mettre un encadré
     autour de la tâche » (#48).

     Les modes Focus et Présentation sont retirés, et avec eux le bouton Zoom,
     seul autre usage que la coche avait. Les réglages que ces deux modes
     enregistraient sur le widget ne sont plus lus du tout : un widget sauvegardé
     alors que l'un des deux était actif s'ouvre désormais normalement au lieu de
     rester figé dedans sans plus aucun bouton pour en sortir.

     La coche ne porte plus d'état éphémère : elle LIT les encadrés posés. Une
     sélection en mémoire se vidait au rechargement pendant que l'encadré, lui,
     survivait — la case revenait décochée sur une tâche visiblement encadrée. */
  const emphasisOn = widget.miniGanttEmphasis !== false;
  const editable = !!onUpdateWidget;

  const rawMilestones = useMemo(() => (Array.isArray(annotationStore.milestones) ? annotationStore.milestones : []), [annotationStore.milestones]);
  // Les risques viennent des tâches. Les listes héritées, enregistrées sur le
  // widget avant ce changement, sont encore rendues puis reversées sur les
  // tâches par l'effet de reprise ci-dessous — rien n'est perdu.
  const legacyWidgetRisks = useMemo(() => (Array.isArray(annotationStore.risks) ? annotationStore.risks : []), [annotationStore.risks]);
  const taskRisks = useMemo(() => collectTaskDelayRisks(tasks), [tasks]);
  const rawRisks = useMemo(
    () => [...taskRisks, ...legacyWidgetRisks.filter((r) => !taskRisks.some((x) => x.id === r.id))],
    [taskRisks, legacyWidgetRisks]
  );
  const rawNotes = useMemo(() => (Array.isArray(annotationStore.notes) ? annotationStore.notes : []), [annotationStore.notes]);
  const rawSpans = useMemo(() => (Array.isArray(annotationStore.spans) ? annotationStore.spans : []), [annotationStore.spans]);
  // Catalogue des types de jalon, réglé dans les Réglages : le diagramme le lit
  // pour le symbole, la couleur et le nom de chaque repère (#94).
  const milestoneTypes = useMemo(() => normalizeMilestoneTypes(ctx.milestoneTypes), [ctx.milestoneTypes]);
  const configSpans = useMemo(() => normalizeMiniGanttSpans(rawSpans), [rawSpans]);
  const configMilestones = useMemo(() => normalizeMiniGanttMilestones(rawMilestones), [rawMilestones]);
  const configRisks = useMemo(() => normalizeMiniGanttRisks(rawRisks), [rawRisks]);
  const configNotes = useMemo(() => normalizeMiniGanttNotes(rawNotes), [rawNotes]);

  // Les listes déroulantes de l'éditeur portent sur TOUTES les tâches retenues
  // par les filtres du widget, pas seulement sur celles que le plafond
  // d'affichage laisse voir : sinon une tâche filtrée « in » mais tronquée de
  // la vue deviendrait impossible à désigner.
  /* Une tâche-jalon n'a qu'une date de FIN : l'exiger des deux côtés vidait le
     sélecteur de « Tâche rattachée » sur un widget qui n'affiche que des
     jalons (#94). On garde donc toute tâche datée d'un bout au moins — une
     tâche sans aucune date ne peut, elle, être placée nulle part. */
  const editorTasks = useMemo(() => tasks.filter((t) => t.start || t.end), [tasks]);

  // Reprise unique des risques enregistrés sur le widget avant qu'ils ne soient
  // rattachés aux tâches : ils sont reversés sur leur tâche puis effacés du
  // widget. Sans quoi ils resteraient invisibles depuis les autres Mini-Gantt.
  const migratedRisks = useRef(false);
  useEffect(() => {
    if (migratedRisks.current || !legacyWidgetRisks.length || !onUpdateTask || !onUpdateWidget) return;
    migratedRisks.current = true;
    // Un risque hérité dont la tâche n'est pas affichée ici reste sur le widget :
    // un autre Mini-Gantt qui montre cette tâche s'en chargera.
    const movable = legacyWidgetRisks.filter((r) => tasks.some((t) => t.id === r.taskId));
    if (!movable.length) return;
    const remaining = legacyWidgetRisks.filter((r) => !movable.includes(r));
    applyTaskDelayRisks([...taskRisks, ...movable], tasks, onUpdateTask);
    onUpdateWidget({ ganttAnnotations: { ...annotationStore, risks: remaining } });
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [legacyWidgetRisks, onUpdateTask, onUpdateWidget]);

  // Ordre d'affichage réel des lignes, regroupement et replis compris : c'est
  // lui qui définit l'adjacence, donc le découpage d'un encadré en cadres
  // continus. Le regroupement est calculé une seule fois ici et réutilisé au
  // rendu, plutôt que recalculé en deux endroits.
  const rowGroups = useMemo(() => (
    !effectiveGroupBy || effectiveGroupBy === "none"
      ? [{ key: "all", label: "", color: null, tasks: orderedTasks }]
      // Le regroupement redistribue les lignes : chaque groupe est retrié, sinon
      // l'ordre choisi ne vaudrait qu'à l'intérieur du premier d'entre eux.
      : groupTasks(orderedTasks, effectiveGroupBy, ctx)
          .filter((g) => g.tasks.length > 0)
          .map((g) => ({ ...g, tasks: miniGanttSortTasks(g.tasks, sortKey, sortDir) }))
  ), [orderedTasks, effectiveGroupBy, ctx, sortKey, sortDir]);

  /* Mode bulles : « regrouper les tâches d'une macro-bulle » amène leurs lignes
     côte à côte, DANS chaque groupe — une macro-bulle forme alors une bande
     d'un seul tenant au lieu d'une enveloppe trouée. Le regroupement ne
     traverse jamais une frontière de groupe : l'en-tête resterait au-dessus de
     lignes qui ne lui appartiennent pas. */
  const macroOrderedGroups = useMemo(() => {
    if (!bubbleMacroGroupingOn || !bubbleCfg.bubbleMacros.length) return rowGroups;
    return rowGroups.map((g) => ({ ...g, tasks: bubbleMacroReorder(g.tasks) }));
  }, [rowGroups, bubbleMacrosKey, bubbleMacroGroupingOn]);

  /* Couleur des bulles : celle du GROUPE au sens de « grouper par », mais avec
     SON champ à elle (`bubbleColorBy`), indépendant du regroupement des lignes
     — on peut grouper par projet et colorer par statut. `groupTasks` est la
     seule source : elle sait déjà quelle couleur porte un statut, un projet, un
     type ou une criticité. `bubbleColorMap` n'y ajoute que la teinte de repli
     des valeurs qui n'en ont pas (responsable, période, texte libre). */
  const bubbleGroups = useMemo(
    () => (bubbleMode ? groupTasks(orderedTasks, bubbleColorByKey, ctx).filter((g) => g.tasks.length > 0) : []),
    [bubbleMode, orderedTasks, bubbleColorByKey, ctx]
  );
  const bubbleColors = useMemo(() => bubbleColorMap(bubbleGroups), [bubbleGroups]);
  const bubbleLegend = useMemo(() => bubbleLegendEntries(bubbleGroups), [bubbleGroups]);

  const visibleRows = useMemo(() => {
    const rows = [];
    macroOrderedGroups.forEach((g) => {
      if (collapsed[g.key]) return;
      g.tasks.forEach((t) => rows.push({ id: t.id, groupKey: g.key, start: t.milestone ? t.end : t.start, end: t.end, milestone: !!t.milestone }));
    });
    return rows;
  }, [macroOrderedGroups, collapsed]);

  // Les cadres suivent la mise en page mesurée plutôt qu'un second calcul de
  // disposition : un zoom, un filtre, un repli de groupe ou un déplacement de
  // tâche déplace les lignes, et les cadres suivent. Une ligne non rendue (jalon
  // hors fenêtre, groupe replié) n'est simplement pas mesurée.
  const rootRef = useRef(null);
  const rowNodes = useRef({});
  const stripTrackRef = useRef(null);
  /* Titres entiers (#122) : le nombre de lignes qu'un titre occupe depend de la
     largeur REELLE de sa bulle — il se mesure, il ne se devine pas. On retient
     le plus grand supplement du widget et on l'applique a TOUTES les lignes :
     des lignes de hauteurs differentes se liraient en escalier, et les couloirs
     de #120 n'auraient plus de hauteur connue. C'est la meme regle que la
     hauteur reguliere demandee pour le bandeau condense. */
  const [titleExtraPx, setTitleExtraPx] = useState(0);
  /* La mesure des titres. Elle ne tourne QUE quand les titres sont entiers :
     coupes, ils tiennent par construction dans la hauteur posee, et mesurer
     coutait alors une lecture de mise en page a chaque rendu pour zero. */
  useLayoutEffect(() => {
    if (!bubbleMode || bubbleCfg.bubbleTruncateTitles) {
      setTitleExtraPx((prev) => (prev === 0 ? prev : 0));
      return;
    }
    const root = rootRef.current;
    if (!root) return;
    const titles = root.querySelectorAll(".lp-bubble-title, .lp-bubble-milestone-title");
    let tallest = 0;
    let lineH = 0;
    titles.forEach((el) => {
      tallest = Math.max(tallest, el.scrollHeight);
      const parsed = parseFloat(window.getComputedStyle(el).lineHeight);
      if (Number.isFinite(parsed)) lineH = Math.max(lineH, parsed);
    });
    /* La bulle reserve deja DEUX lignes de titre — une seule en hauteur
       compacte, ou le pied ne laisse pas la place a la seconde. Le supplement
       est ce qui depasse cette reserve, et rien d'autre. */
    const reserved = lineH * (bubbleCfg.bubbleSize === "compact" ? 1 : 2);
    const extra = Math.max(0, Math.ceil(tallest - reserved));
    setTitleExtraPx((prev) => (prev === extra ? prev : extra));
  });

  const [rowRects, setRowRects] = useState({});
  /* Sommet de la bande de repères, mesuré comme les lignes : c'est de là que
     part le trait vertical d'un jalon (#95). `null` tant qu'aucune bande n'est
     montée — un widget sans jalon ni annotation n'en a pas. */
  const [stripTop, setStripTop] = useState(null);
  /* Ce que la DERNIÈRE ligne peint sous sa propre boîte. Le rail de
     comparaison, les couloirs de risque et leurs étiquettes vivent dans
     l'interligne — qui n'existe pas après la dernière ligne. Le widget étant
     en `overflow:hidden`, tout cela y était coupé net : la dernière ligne
     n'apparaissait qu'à moitié (retour de test). On mesure le débord plutôt
     que de le supposer, et on réserve exactement autant en pied. */
  const [rowsTail, setRowsTail] = useState(0);
  // Les étiquettes de repères sont placées en PIXELS : estimer leur largeur en
  // pourcentage de la piste donnait des collisions dès que le widget était
  // étroit, la même étiquette n'occupant pas la même fraction d'une piste de
  // 270 px et d'une piste de 900 px.
  const [trackWidth, setTrackWidth] = useState(0);
  /* Largeur de la piste en pixels, avec repli tant que la mesure n'est pas
     tombée. Déclarée ICI, juste après la mesure dont elle dépend, et non plus
     dans la section de rendu des bulles : la géométrie des macro-bulles la lit
     depuis un useMemo situé plus haut, et une fonction en `const` invoquée
     depuis un mémo antérieur lève une ReferenceError de zone morte — le même
     piège que `bubbleMacroReorder` avant elle. */
  const bubbleTrackPx = trackWidth || 420;

  const measureRows = useCallback(() => {
    const root = rootRef.current;
    if (!root) return;
    const base = root.getBoundingClientRect();
    const next = {};
    visibleRows.forEach((row) => {
      const el = rowNodes.current[row.id];
      if (!el || !el.isConnected) return;
      const rect = el.getBoundingClientRect();
      next[row.id] = { top: Math.round(rect.top - base.top), height: Math.round(rect.height) };
    });
    setRowRects((prev) => {
      const prevKeys = Object.keys(prev);
      const nextKeys = Object.keys(next);
      const same = prevKeys.length === nextKeys.length
        && nextKeys.every((k) => prev[k] && prev[k].top === next[k].top && prev[k].height === next[k].height);
      return same ? prev : next;
    });
    /* Largeur de la PISTE. Elle se mesurait sur la bande des repères — qui
       n'existe que si le widget porte des jalons de configuration ou des
       annotations. Sans eux, la mesure ne tombait jamais et tout le monde
       retombait sur le repli de 420 px : les étiquettes de bloc temporel se
       centraient alors sur une piste imaginaire, loin de leur bande (retour de
       test), et les étiquettes de risque et d'écart avec elles.

       On prend donc la PREMIÈRE piste présente dans le widget, quelle qu'elle
       soit : celle des titres de bloc, celle des repères, ou celle d'une ligne.
       Toutes trois partagent exactement la même géométrie — gouttière de 26 %,
       même gap, même colonne de champs — et il y en a toujours au moins une dès
       qu'il y a quelque chose à aligner. */
    const track = root.querySelector(
      ".lp-widget-minigantt-phases-track, .lp-widget-minigantt-strip-track, .lp-widget-minigantt-track"
    );
    if (track) {
      const width = Math.round(track.getBoundingClientRect().width);
      setTrackWidth((prev) => (prev === width ? prev : width));
    }
    /* Débord de la dernière ligne. Mesuré sur la ligne elle-même, et non
       déduit des constantes de placement : un habillage ajouté demain sous une
       barre sera réservé sans que personne ait à y penser. Une seule ligne est
       parcourue, celle du bas — c'est la seule qui n'ait pas de suivante pour
       l'accueillir. */
    let tail = 0;
    for (let i = visibleRows.length - 1; i >= 0; i -= 1) {
      const el = rowNodes.current[visibleRows[i].id];
      if (!el || !el.isConnected) continue;
      const bottom = el.getBoundingClientRect().bottom;
      el.querySelectorAll("*").forEach((child) => {
        const r = child.getBoundingClientRect();
        if (!r.width && !r.height) return;
        tail = Math.max(tail, r.bottom - bottom);
      });
      break;
    }
    const nextTail = Math.ceil(Math.max(0, tail));
    setRowsTail((prev) => (prev === nextTail ? prev : nextTail));

    // Même mesure, même repère : le sommet de la bande de repères est pris dans
    // le référentiel de la racine, comme les lignes ci-dessus.
    const strip = stripTrackRef.current;
    const nextStripTop = strip && strip.isConnected
      ? Math.round(strip.getBoundingClientRect().top - base.top)
      : null;
    setStripTop((prev) => (prev === nextStripTop ? prev : nextStripTop));
  }, [visibleRows]);
  useEffect(() => {
    const id = requestAnimationFrame(measureRows);
    return () => cancelAnimationFrame(id);
  }, [measureRows, span, minIdx, fieldsLayout]);

  /* La mesure ci-dessus est un instantané : elle ne retombe que si le nombre de
     lignes change. Or la piste, elle, bouge encore après — la barre d'outils qui
     se replie, la colonne de champs qui trouve sa largeur, une police web qui
     arrive, le widget qu'on redimensionne. La valeur gardée devenait alors plus
     large que la piste réelle, et tout ce qui se positionne à partir d'elle
     dérivait : titres de blocs, étiquettes d'écart, et étiquettes de risque —
     jusqu'à s'y recouvrir, le calcul les croyant au large (retour de test).
     Un ResizeObserver suit la piste elle-même : la mesure ne peut plus vieillir. */
  useEffect(() => {
    const root = rootRef.current;
    if (!root || typeof ResizeObserver === "undefined") return undefined;
    const track = root.querySelector(
      ".lp-widget-minigantt-phases-track, .lp-widget-minigantt-strip-track, .lp-widget-minigantt-track"
    );
    if (!track) return undefined;
    const observer = new ResizeObserver(() => {
      const width = Math.round(track.getBoundingClientRect().width);
      if (width > 0) setTrackWidth((prev) => (prev === width ? prev : width));
    });
    observer.observe(track);
    return () => observer.disconnect();
  }, [visibleRows, fieldsLayout]);

  // Largeur RÉELLEMENT occupée par les champs d'une ligne. `scrollWidth` ne
  // sert à rien ici : la colonne est en overflow visible, elle ne défile pas et
  // déclare donc la largeur qu'on lui impose. On mesure le bord droit du
  // dernier champ, seul témoin fiable de ce qui dépasse.
  const measureFieldsColumn = useCallback(() => {
    if (fieldsLayout !== "aligned") return;
    /* « Aucune ligne montée » et « des lignes montées, sans aucun champ » sont
       deux réponses différentes, et l'ancienne mesure les confondait dans un
       `needed` à zéro qu'elle abandonnait. La première ne conclut rien — la
       mesure reviendra à la trame suivante. La seconde vaut zéro, et c'est
       ainsi que la colonne disparaît quand aucun champ n'est configuré. */
    let mesurable = false;
    let needed = 0;
    Object.values(fieldNodes.current).forEach((el) => {
      if (!el || !el.isConnected) return;
      mesurable = true;
      if (!el.children.length) return;
      const left = el.getBoundingClientRect().left;
      const last = el.children[el.children.length - 1].getBoundingClientRect();
      needed = Math.max(needed, Math.ceil(last.right - left) + 2);
    });
    if (!mesurable) return;
    // Plafond : la colonne ne doit jamais avaler la piste. Au-delà, mieux vaut
    // une colonne large mais bornée qu'un diagramme réduit à un trait.
    const rootW = rootRef.current ? rootRef.current.getBoundingClientRect().width : 0;
    const cap = rootW ? Math.round(rootW * 0.46) : Infinity;
    const next = Math.min(cap, needed);
    setFieldsColWidth((prev) => (Math.abs(prev - next) <= 1 ? prev : next));
  }, [fieldsLayout]);
  useEffect(() => {
    const id = requestAnimationFrame(measureFieldsColumn);
    return () => cancelAnimationFrame(id);
  });

  /* Mesure de la colonne d'étiquettes. Le titre est un `flex:1` : sa boîte
     épouse la colonne, et `scrollWidth` comme `getBoundingClientRect` rendent
     donc la largeur de la COLONNE, jamais celle du texte — mesurer ainsi
     revenait à demander à la colonne sa propre largeur, et elle ne rétrécissait
     jamais. On mesure le TEXTE lui-même, par un Range : sa largeur ne dépend
     pas de la boîte qui le contient, et la mesure ne peut donc pas entrer en
     boucle avec ce qu'elle décide. Une case à cocher n'a pas de texte : elle
     garde la largeur de sa boîte. */
  const measureLabelColumn = useCallback(() => {
    const root = rootRef.current;
    if (!root || bubbleMode) return;
    const labels = root.querySelectorAll(".lp-widget-minigantt-label");
    if (!labels.length) return;
    const range = document.createRange();
    let needed = 0;
    labels.forEach((el) => {
      const gap = parseFloat(getComputedStyle(el).columnGap) || 0;
      let width = 0;
      [...el.children].forEach((child) => {
        range.selectNodeContents(child);
        const texte = range.getBoundingClientRect().width;
        width += Math.ceil(texte || child.getBoundingClientRect().width);
      });
      needed = Math.max(needed, width + Math.max(0, el.children.length - 1) * gap + 2);
    });
    const rootW = root.getBoundingClientRect().width;
    const cap = rootW ? Math.round(rootW * 0.26) : Infinity;
    const next = Math.min(cap, Math.ceil(needed));
    setLabelColWidth((prev) => (prev !== null && Math.abs(prev - next) <= 1 ? prev : next));
  }, [bubbleMode]);
  useEffect(() => {
    const id = requestAnimationFrame(measureLabelColumn);
    return () => cancelAnimationFrame(id);
  });

  // Largeur RÉELLE de chaque capsule de bloc temporel. L'estimation ne sert
  // qu'au tout premier rendu : la centrer sur une estimation trop généreuse
  // décalait visiblement l'étiquette par rapport à sa bande.
  const phaseLabelNodes = useRef({});
  const [phaseLabelWidths, setPhaseLabelWidths] = useState({});
  useEffect(() => {
    const id = requestAnimationFrame(() => {
      const next = {};
      Object.entries(phaseLabelNodes.current).forEach(([id2, el]) => {
        if (el && el.isConnected) next[id2] = Math.ceil(el.getBoundingClientRect().width);
      });
      setPhaseLabelWidths((prev) => {
        const keys = Object.keys(next);
        const same = keys.length === Object.keys(prev).length && keys.every((k) => prev[k] === next[k]);
        return same ? prev : next;
      });
    });
    return () => cancelAnimationFrame(id);
  });
  useEffect(() => {
    if (typeof ResizeObserver === "undefined") return undefined;
    const root = rootRef.current;
    if (!root) return undefined;
    // Ne provoque un rendu que si une position change réellement : pas de
    // boucle de recalcul permanente.
    const ro = new ResizeObserver(() => measureRows());
    ro.observe(root);
    return () => ro.disconnect();
  }, [measureRows]);

  const rowsBand = useMemo(() => {
    const rects = Object.values(rowRects);
    if (!rects.length) return null;
    const top = Math.min(...rects.map((r) => r.top));
    const bottom = Math.max(...rects.map((r) => r.top + r.height));
    return { top, height: Math.max(0, bottom - top) };
  }, [rowRects]);

  const frameShapes = useMemo(() => {
    if (!highlightFrames.length) return [];
    const rows = visibleRows
      .map((row) => {
        const rect = rowRects[row.id];
        if (!rect) return null;
        const startIdx = dayIndex(row.start);
        const endIdx = dayIndex(row.end);
        if (!Number.isFinite(startIdx) || !Number.isFinite(endIdx)) return null;
        return { id: row.id, groupKey: row.groupKey, top: rect.top, height: rect.height, startIdx, endIdx };
      })
      .filter(Boolean);
    if (!rows.length) return [];
    const shapes = [];
    highlightFrames.forEach((frame) => {
      ganttFrameSegments(rows, frame).forEach((seg, i) => shapes.push({ ...seg, frame, key: frame.id + "-" + i }));
    });
    // Même règle que le Mini Gantt : deux étiquettes qui se superposeraient
    // sont décalées vers le bas.
    const placed = [];
    shapes.slice().sort((a, b) => a.top - b.top || a.startIdx - b.startIdx).forEach((shape) => {
      shape.labelOffset = placed.filter((x) => Math.abs(x.top - shape.top) < 26 && Math.abs(x.startIdx - shape.startIdx) / span < 0.12).length * 11;
      placed.push(shape);
    });
    return shapes;
  }, [highlightFrames, visibleRows, rowRects, span]);

  /* Annotations horizontales : le trait est placé en X comme une barre —
     pourcentage de la piste, borné à la fenêtre affichée — et en Y sur la ligne
     mesurée de sa tâche de rattachement (#93). Une annotation dont la tâche
     n'est pas montée (filtrée, groupe replié, hors plafond) ou dont les dates
     tombent entièrement hors de la fenêtre n'est pas dessinée. */
  const spanShapes = useMemo(() => {
    if (!configSpans.length) return [];
    const rows = visibleRows
      .map((row) => {
        const rect = rowRects[row.id];
        return rect ? { id: row.id, top: rect.top, height: rect.height } : null;
      })
      .filter(Boolean);
    if (!rows.length) return [];
    return miniGanttSpanRows(rows, configSpans)
      .map(({ span: annot, y }) => {
        const startIdx = dayIndex(annot.startDate);
        const endIdx = dayIndex(annot.endDate);
        if (!Number.isFinite(startIdx) || !Number.isFinite(endIdx)) return null;
        if (endIdx < minIdx || startIdx > maxIdx) return null;
        const from = Math.max(minIdx, Math.min(maxIdx, startIdx));
        const to = Math.max(minIdx, Math.min(maxIdx, endIdx));
        return {
          annot, y,
          leftPct: ((from - minIdx) / span) * 100,
          // Même plancher que la barre d'une tâche d'un jour : sans lui, une
          // annotation d'une journée se réduirait à ses deux ronds collés.
          widthPct: Math.max(2, ((to - from) / span) * 100),
        };
      })
      .filter(Boolean);
  }, [configSpans, visibleRows, rowRects, minIdx, maxIdx, span]);

  /* Annotations horizontales en mode BULLES : un couloir réservé, en tête du
     diagramme (#93).

     Le rattachement à une tâche décide de la hauteur d'un trait. En Gantt, une
     tâche est une ligne fine et le trait se pose dessus proprement. En bulles,
     une tâche est une BOÎTE de quarante à soixante pixels, et le trait lui
     passait en plein milieu — « ça passe en plein à travers » (retour de test).

     Les traits quittent donc les lignes et se rangent dans leur propre couloir,
     L'UN SOUS L'AUTRE, triés par date de début. Le rattachement à une tâche
     reste réglable et vaut toujours pour la vue Gantt : le même widget peut
     passer d'un mode à l'autre, et cacher le champ ferait perdre le réglage au
     retour. Il est simplement IGNORÉ ici. */
  const bubbleSpanRows = useMemo(() => {
    if (!bubbleMode) return [];
    return configSpans
      .map((annot) => {
        const startIdx = dayIndex(annot.startDate);
        const endIdx = dayIndex(annot.endDate);
        if (!Number.isFinite(startIdx) || !Number.isFinite(endIdx)) return null;
        if (endIdx < minIdx || startIdx > maxIdx) return null;
        const from = Math.max(minIdx, Math.min(maxIdx, startIdx));
        const to = Math.max(minIdx, Math.min(maxIdx, endIdx));
        return {
          annot,
          startIdx,
          leftPct: ((from - minIdx) / span) * 100,
          // Même plancher qu'ailleurs : sans lui, une annotation d'une journée
          // se réduirait à ses deux bouts collés.
          widthPct: Math.max(2, ((to - from) / span) * 100),
        };
      })
      .filter(Boolean)
      .sort((a, b) => (
        a.startIdx - b.startIdx
        || String(a.annot.label || "").localeCompare(String(b.annot.label || ""), "fr")
      ));
  }, [bubbleMode, configSpans, minIdx, maxIdx, span]);

  /* Macro-bulles (#92). La géométrie vient de `bubbleMacroSegments`, qui
     délègue le découpage en séries de lignes CONTIGUËS à `ganttFrameSegments` —
     la fonction des encadrés, qui sait qu'un en-tête de groupe coupe la
     continuité et qui travaille sur les hauteurs MESURÉES. Des tâches non
     successives donnent donc plusieurs enveloppes, jamais une enveloppe géante
     qui avalerait les tâches voisines.

     Le rang de la macro-bulle dans la liste sert de niveau d'imbrication : deux
     macro-bulles qui partagent une tâche restent deux traits lisibles. */
  const bubbleMacroShapes = useMemo(() => {
    if (!bubbleMode || !bubbleCfg.bubbleMacros.length) return [];
    /* Les bornes d'une ligne sont ici celles de sa BULLE, pas celles de ses
       dates : `bubbleRowExtent` y ajoute la largeur minimale d'une bulle courte
       et la demi-largeur d'un jalon centré (#104). Les encadrés du Gantt, eux,
       gardent les dates — ce sont des barres, et leur géométrie est juste. */
    const pxPerDay = bubbleTrackPx / span;
    const rows = visibleRows
      .map((row) => {
        const rect = rowRects[row.id];
        if (!rect) return null;
        const extent = bubbleRowExtent(
          { startIdx: dayIndex(row.start), endIdx: dayIndex(row.end), milestone: row.milestone },
          pxPerDay,
        );
        if (!extent) return null;
        return { id: row.id, groupKey: row.groupKey, top: rect.top, height: rect.height, startIdx: extent.startIdx, endIdx: extent.endIdx };
      })
      .filter(Boolean);
    if (!rows.length) return [];
    const shapes = [];
    bubbleCfg.bubbleMacros.forEach((macro, level) => {
      bubbleMacroSegments(rows, macro, ganttFrameSegments, level).forEach((seg) => shapes.push(seg));
    });
    // Deux libellés qui se superposeraient sont décalés vers le bas — même
    // règle que les étiquettes d'encadré.
    const placed = [];
    shapes.slice().sort((a, b) => a.top - b.top || a.startIdx - b.startIdx).forEach((shape) => {
      shape.labelOffset = placed.filter((x) => Math.abs(x.top - shape.top) < 26 && Math.abs(x.startIdx - shape.startIdx) / span < 0.12).length * 12;
      placed.push(shape);
    });
    return shapes;
  }, [bubbleMode, bubbleMacrosKey, visibleRows, rowRects, span]);

  /* Avancement agrégé d'une enveloppe : moyenne PONDÉRÉE PAR LA DURÉE des
     tâches qu'elle contient. Une tâche de trois mois à 0 % ne doit pas peser
     autant qu'un jalon d'un jour à 100 %. */
  const bubbleMacroPct = (seg) => {
    if (!seg.macro.showProgress) return null;
    const cells = seg.ids.map((id) => {
      const task = tasksById.get(id);
      if (!task) return null;
      const startIdx = dayIndex(task.milestone ? task.end : task.start);
      const endIdx = dayIndex(task.end);
      return { progress: task.progress, days: Number.isFinite(startIdx) && Number.isFinite(endIdx) ? Math.max(0, endIdx - startIdx) : 0 };
    }).filter(Boolean);
    return bubbleMacroProgress(cells);
  };

  // Les blocs sont exprimés en pourcentage, comme les barres du Mini-Gantt, et
  // bornés à la fenêtre affichée : le zoom et le filtre « jours dans le passé »
  // les recadrent sans code supplémentaire.
  const temporalBlockShapes = useMemo(() => {
    const shapes = [];
    temporalBlocks.forEach((block) => {
      const startIdx = dayIndex(block.startDate);
      const endIdx = dayIndex(block.endDate);
      if (!Number.isFinite(startIdx) || !Number.isFinite(endIdx)) return;
      if (endIdx < minIdx || startIdx > maxIdx) return;
      const from = Math.max(minIdx, startIdx);
      const to = Math.min(maxIdx, endIdx);
      shapes.push({
        block,
        leftPct: ((from - minIdx) / span) * 100,
        widthPct: Math.max(0.6, ((to - from) / span) * 100),
      });
    });
    // Les titres vivent sur une bande d'en-tête, sous les dates : deux blocs
    // dont les TITRES se chevauchent sont répartis sur deux lignes. C'est bien
    // l'étiquette qui décide, pas la bande : centrée et jamais tronquée, elle
    // déborde de part et d'autre d'une bande étroite, et deux blocs pourtant
    // disjoints dans le temps verraient leurs titres se recouvrir. Le calcul se
    // fait donc en pixels, sur la largeur réellement mesurée de la piste.
    const trackPx = trackWidth || 420;
    const laneEnds = [];
    shapes
      .map((shape) => {
        const leftPx = (shape.leftPct / 100) * trackPx;
        const widthPx = (shape.widthPct / 100) * trackPx;
        /* L'étiquette a SA propre largeur : la capsule épouse le titre au lieu
           d'épouser la bande. Une bande de trois jours ne doit pas produire une
           capsule de trois jours de large dont le texte déborde de part et
           d'autre de sa propre bordure.

           Le CENTRAGE, lui, ne passe plus par cette largeur : c'est
           `translateX(-50%)` qui centre, donc le navigateur, donc exactement.
           Le calculer en pixels revenait à dépendre d'une largeur mesurée UNE
           FOIS — avant le chargement de la police, quand la capsule est encore
           plus étroite qu'elle ne le sera. Rien ne provoquant de second rendu
           quand la police arrive, la valeur restait périmée et l'étiquette
           gardait son décalage (retour de test).

           La largeur ne sert donc plus qu'à deux choses qu'une estimation suffit
           à traiter : répartir les capsules en lignes pour qu'elles ne se
           recouvrent pas, et retenir celles qui sortiraient de la piste. */
        const measured = phaseLabelWidths[shape.block.id];
        const labelPx = Math.min(trackPx, measured || (20 + String(shape.block.title || "").length * 8.6));
        const centerPx = leftPx + widthPx / 2;
        // Ramenée dans la piste : une capsule ne sort jamais du diagramme, même
        // pour un bloc collé au bord.
        const clampedCenterPx = Math.max(labelPx / 2, Math.min(trackPx - labelPx / 2, centerPx));
        const labelLeftPx = clampedCenterPx - labelPx / 2;
        shape.labelCenterPct = trackPx > 0 ? (clampedCenterPx / trackPx) * 100 : 0;
        return {
          shape,
          fromPx: Math.min(leftPx, labelLeftPx),
          toPx: Math.max(leftPx + widthPx, labelLeftPx + labelPx),
        };
      })
      .sort((a, b) => a.fromPx - b.fromPx)
      .forEach((item) => {
        let lane = laneEnds.findIndex((end) => item.fromPx >= end + 4);
        if (lane === -1) { lane = laneEnds.length; laneEnds.push(0); }
        laneEnds[lane] = item.toPx;
        item.shape.lane = lane;
      });
    return shapes;
  }, [temporalBlocks, minIdx, maxIdx, span, trackWidth, phaseLabelWidths]);

  // Chemin critique : même calcul que la vue Planning Projets et le widget
  // Chemin critique (computeCriticalIds), jamais une seconde heuristique.
  const criticalIds = useMemo(
    () => (emphasisOn && projTasks.length ? computeCriticalIds(projTasks) : null),
    [projTasks, emphasisOn]
  );

  // Couloirs d'incertitude : bornés aux lignes réellement visibles, donc
  // insensibles à une tâche supprimée, filtrée ou repliée.
  const riskSegments = useMemo(() => {
    if (!configRisks.length) return [];
    const rows = visibleRows.map((row) => ({ id: row.id, startIdx: dayIndex(row.start), endIdx: dayIndex(row.end) }));
    return miniGanttRiskSegments(rows, configRisks);
  }, [configRisks, visibleRows]);

  const risksByTask = useMemo(() => {
    const map = new Map();
    riskSegments.forEach((seg) => {
      if (!map.has(seg.taskId)) map.set(seg.taskId, []);
      map.get(seg.taskId).push(seg);
    });
    return map;
  }, [riskSegments]);

  // Comparaisons EXPLOITABLES, tâche par tâche. Une tâche sans référence, ou
  // dont la référence est incomplète ou invalide, n'entre simplement pas dans
  // cette table : elle garde le rendu standard, sans message d'erreur dans le
  // diagramme et sans changer de hauteur de ligne.
  const comparisonByTask = useMemo(() => {
    const map = new Map();
    if (!comparisonOn) return map;
    [...projTasks, ...milestoneTasks].forEach((t) => {
      const cmp = miniGanttTaskComparison(t);
      if (cmp) map.set(t.id, cmp);
    });
    return map;
  }, [comparisonOn, projTasks, milestoneTasks]);

  /* La colonne de droite existe-t-elle dans CE widget ? Une seule réponse pour
     l'axe, la bande des titres de bloc, celle des repères, la légende, la
     grille et chaque ligne : sans quoi les uns réservent la gouttière que les
     autres n'ont pas, et les repères tombent à côté. */
  const fieldsColumnShown = fieldsLayout === "aligned"
    && (rowFields.length > 0 || comparisonByTask.size > 0);

  /* Retrait de gauche des couches en superposition — grille, ligne du jour,
     blocs temporels, encadrés, macro-bulles — en UN SEUL endroit. C'est la
     colonne d'étiquettes PLUS la gouttière de 6 px que le flex met entre elle
     et la piste.

     Le mode bulles n'a ni l'une ni l'autre : le titre vit dans la bulle, et une
     ligne sans étiquette n'a qu'un enfant, donc aucune gouttière (la feuille de
     style annule celle de l'axe et des bandes de repères, qui gardaient la leur
     autour d'une cale de largeur nulle). Le retrait y est donc NUL — le
     compter quand même décalait toutes les couches de 6 px vers la droite,
     y compris le cadre des macro-bulles, d'où des bulles qui semblaient en
     sortir (#104). */
  const layerInsetLeft = bubbleMode ? 0 : "calc(var(--mg-label-w, 26%) + 6px)";
  const layerInsets = {
    left: layerInsetLeft,
    right: fieldsColumnShown ? `calc(${FIELDS_COL_WIDTH}px + 6px)` : 0,
  };

  const emphasisFor = (taskId) => (emphasisOn ? miniGanttRowEmphasis(taskId, riskSegments, criticalIds) : "none");

  // Cochée = encadrée, et rien d'autre. L'état vient des annotations, donc il
  // survit au rechargement comme l'encadré qu'il décrit.
  const selectedSet = useMemo(
    () => new Set(rawHighlightFrames.filter((f) => f && f.autoTaskId).map((f) => f.autoTaskId)),
    [rawHighlightFrames]
  );
  const toggleSelected = (taskId) => {
    const willSelect = !selectedSet.has(taskId);
    const nextFrames = miniGanttToggleTaskFrame(rawHighlightFrames, taskId, willSelect, uid);
    if (nextFrames !== rawHighlightFrames) applyAnnotations({ highlightFrames: nextFrames });
  };

  // Jalons de configuration et annotations partagent la même bande, sous les
  // titres de bloc : un seul mécanisme de placement, donc un seul traitement
  // des collisions. Une annotation est ramenée à la date de son ancre — tâche,
  // risque, jalon ou date libre.
  const stripShapes = useMemo(() => {
    const items = [];
    configMilestones.forEach((m) => {
      const idx = dayIndex(m.date);
      if (!Number.isFinite(idx) || idx < minIdx || idx > maxIdx) return;
      items.push({ kind: "milestone", id: m.id, idx, label: m.title, color: m.color || milestoneTypeFor(milestoneTypes, m.type).color, type: m.type, rule: !!m.rule, ruleThickness: normalizeMiniGanttRuleThickness(m.ruleThickness), data: m });
    });
    const taskById = tasksById;
    configNotes.forEach((n) => {
      let idx = null;
      if (n.anchor.kind === "date") idx = dayIndex(n.anchor.date);
      else if (n.anchor.kind === "task") { const t = taskById.get(n.anchor.id); if (t) idx = dayIndex(t.end); }
      else if (n.anchor.kind === "milestone") { const m = configMilestones.find((x) => x.id === n.anchor.id); if (m) idx = dayIndex(m.date); }
      else if (n.anchor.kind === "risk") { const seg = riskSegments.find((x) => x.id === n.anchor.id); if (seg) idx = seg.endIdx; }
      if (idx == null || !Number.isFinite(idx) || idx < minIdx || idx > maxIdx) return;
      items.push({ kind: "note", id: n.id, idx, label: n.title, color: "#64748B", data: n });
    });
    items.sort((a, b) => a.idx - b.idx);
    // Largeur estimée en pixels : le losange, la gouttière, puis le texte à
    // ~5,6 px par caractère pour la graisse utilisée.
    const trackPx = trackWidth || 420;
    const laneEnds = [];
    items.forEach((item) => {
      const leftPx = ((item.idx - minIdx) / span) * trackPx;
      const widthPx = 18 + String(item.label).length * 5.6;
      let lane = laneEnds.findIndex((end) => leftPx >= end + 8);
      if (lane === -1) { lane = laneEnds.length; laneEnds.push(0); }
      laneEnds[lane] = leftPx + widthPx;
      item.lane = lane;
      item.leftPct = ((item.idx - minIdx) / span) * 100;
    });
    return items;
  }, [configMilestones, configNotes, riskSegments, tasksById, minIdx, maxIdx, span, trackWidth]);

  const stripLaneCount = stripShapes.length ? Math.max(...stripShapes.map((s) => s.lane)) + 1 : 0;

  /* Barre d'outils du widget : TOUS les réglages d'affichage côte à côte, sur
     une bande pleine largeur au-dessus de l'axe. Ils étaient empilés en colonne
     dans la gouttière de 26 % à gauche de l'axe — trois blocs superposés qui
     mangeaient la hauteur du diagramme pendant que la bande du haut restait
     vide (retour de test).

     Chaque commande écrit la MÊME propriété que son réglage des paramètres,
     jamais un état local : les deux ne peuvent pas se contredire. */
  const sortMenuLabel = `${MINIGANTT_SORT_LABELS[sortKey]} ${sortDir === "asc" ? "\u2191" : "\u2193"}`;
  const rangeMenuLabel = miniGanttRangeLabel(rangeCfg, !!pinnedWindow);
  const rangePresetKey = miniGanttRangePresetKey(rangeCfg);
  const setRange = (patch, releaseWindow) => {
    if (!onUpdateWidget) return;
    const next = { miniGanttRange: normalizeMiniGanttRange({ ...rangeCfg, ...patch }) };
    // Une fenêtre à dates fixes prime sur tout : la relâcher est indispensable
    // dès qu'on choisit un autre cadrage, sinon le clic reste sans effet.
    if (releaseWindow) next.miniGanttWindow = null;
    onUpdateWidget(next);
  };

  const toolbar = (
    <div className="lp-widget-minigantt-toolbar" onMouseDown={(e) => e.stopPropagation()}>
      {editable && (
        <div className="lp-widget-minigantt-zoom lp-widget-minigantt-cmpmode" role="group" aria-label="Mode d'affichage du Mini-Gantt">
          <button type="button" className={comparisonOn ? "" : "active"} aria-pressed={!comparisonOn} onClick={() => setComparisonMode(false)} title="Mode standard — dates actuelles seules">Standard</button>
          <button type="button" className={comparisonOn ? "active" : ""} aria-pressed={comparisonOn} onClick={() => setComparisonMode(true)} title="Mode comparaison — dates de référence, dates actuelles et écarts en jours">Comparaison</button>
        </div>
      )}
      {editable && (
        <DropdownButton label={sortMenuLabel} icon={<RefreshCw size={12} style={{ transform: "rotate(90deg)" }} />} title={`Ordre des lignes : ${sortMenuLabel}`}>
          <div className="lp-widget-minigantt-menu-group">
            <div className="lp-dropdown-group-label">Trier par</div>
            {MINIGANTT_SORT_KEYS.map((k) => (
              <label className="lp-checkbox-line" key={k}>
                <input type="radio" name={`mg-sort-${widget.id}`} checked={sortKey === k} onChange={() => onUpdateWidget({ miniGanttSort: k })} />
                {" "}{MINIGANTT_SORT_LABELS[k]}
              </label>
            ))}
          </div>
          <hr className="lp-divider" style={{ margin: "6px 0" }} />
          <div className="lp-widget-minigantt-menu-group">
            <label className="lp-checkbox-line">
              <input type="radio" name={`mg-sortdir-${widget.id}`} checked={sortDir === "asc"} onChange={() => onUpdateWidget({ miniGanttSortDir: "asc" })} /> Croissant
            </label>
            <label className="lp-checkbox-line">
              <input type="radio" name={`mg-sortdir-${widget.id}`} checked={sortDir === "desc"} onChange={() => onUpdateWidget({ miniGanttSortDir: "desc" })} /> Décroissant
            </label>
            <p className="lp-gantt-annot-hint" style={{ margin: "4px 2px 0" }}>À position égale, les jalons passent devant les barres.</p>
          </div>
        </DropdownButton>
      )}
      {editable && (
        <DropdownButton label={rangeMenuLabel} icon={<CalendarClock size={12} />} title={`Étendue temporelle : ${rangeMenuLabel}`}>
          <div className="lp-widget-minigantt-menu-group">
            <div className="lp-dropdown-group-label">Étendue temporelle</div>
            <label className="lp-checkbox-line">
              <input type="radio" name={`mg-range-${widget.id}`} checked={rangeCfg.mode === "auto" && !pinnedWindow} onChange={() => setRange({ mode: "auto" }, true)} /> Automatique (étendue des tâches)
            </label>
            <label className="lp-checkbox-line" style={{ marginLeft: 18 }}>
              <input type="checkbox" checked={rangeCfg.includeToday} disabled={rangeCfg.mode !== "auto"} onChange={(e) => setRange({ includeToday: e.target.checked })} /> Inclure « Aujourd'hui »
            </label>
          </div>
          <hr className="lp-divider" style={{ margin: "6px 0" }} />
          <div className="lp-widget-minigantt-menu-group">
            <div className="lp-dropdown-group-label">Fenêtre glissante</div>
            {MINIGANTT_RANGE_PRESETS.map((preset) => (
              <label className="lp-checkbox-line" key={preset.key}>
                <input
                  type="radio"
                  name={`mg-range-${widget.id}`}
                  checked={rangeCfg.mode === "rolling" && !pinnedWindow && rangePresetKey === preset.key}
                  onChange={() => setRange({ mode: "rolling", beforeMonths: preset.before, afterMonths: preset.after }, true)}
                />
                {" "}{preset.label}
              </label>
            ))}
            {rangeCfg.mode === "rolling" && !rangePresetKey && (
              <p className="lp-gantt-annot-hint" style={{ margin: "4px 2px 0" }}>
                Réglage sur mesure : {rangeCfg.beforeMonths} mois avant, {rangeCfg.afterMonths} après.
              </p>
            )}
          </div>
          {pinnedWindow && (
            <div className="lp-widget-minigantt-menu-group">
              <hr className="lp-divider" style={{ margin: "6px 0" }} />
              <label className="lp-checkbox-line">
                <input type="radio" name={`mg-range-${widget.id}`} checked={rangeCfg.mode === "fixed"} onChange={() => setRange({ mode: "fixed" })} />
                {" "}Dates fixes ({fmtShort(widget.miniGanttWindow.start)} → {fmtShort(widget.miniGanttWindow.end)})
              </label>
            </div>
          )}
          <p className="lp-gantt-annot-hint" style={{ margin: "4px 2px 0" }}>
            Des dates fixes ou des mois sur mesure se posent dans les paramètres du widget.
          </p>
        </DropdownButton>
      )}
      <div className="lp-widget-minigantt-zoom" role="group" aria-label="Zoom du Mini-Gantt">
        <button type="button" onClick={zoomOut} disabled={!zoomIsAuto && zoomLevel<=-2} title="Zoom arrière">−</button>
        <button type="button" onClick={resetZoom} className={zoomIsAuto ? "active" : ""} title="Retour au zoom automatique">
          Auto
        </button>
        <button type="button" onClick={zoomIn} disabled={!zoomIsAuto && zoomLevel>=2} title="Zoom avant">+</button>
        {!zoomIsAuto && <span className="lp-widget-minigantt-zoom-level">{zoomLevel>0?`+${zoomLevel}`:zoomLevel}</span>}
      </div>
      {editable && (
        <div className="lp-widget-minigantt-zoom lp-widget-minigantt-annot-buttons">
          <button type="button" onClick={() => setAnnotationPanel({ section: "blocks", autoCreate: "block" })} title="Ajouter un bloc temporel (grande phase transverse)">+ Bloc</button>
          <button type="button" onClick={() => setAnnotationPanel({ section: "frames", autoCreate: "frame" })} title="Ajouter un encadré autour d'une ou plusieurs tâches">+ Encadré</button>
          <button type="button" onClick={() => setAnnotationPanel({ section: "milestones", autoCreate: "milestone" })} title="Ajouter un jalon ou une décision">+ Jalon</button>
          <button type="button" onClick={() => setAnnotationPanel({ section: "spans", autoCreate: "span" })} title="Ajouter une annotation horizontale (trait d'une date à une autre, à la hauteur d'une tâche)">+ Trait</button>
        </div>
      )}
    </div>
  );

  /* La vue Gantt porte désormais la MÊME barre d'outils que le widget — mode,
     tri, étendue, zoom, annotations —, rendue comme une bande pleine largeur
     au-dessus de l'axe. Elle n'en avait qu'un extrait dans l'en-tête de page
     (zoom, regroupement, annotations), et il fallait ouvrir les réglages pour
     le reste : un même diagramme se pilotait de deux façons différentes selon
     qu'on le regardait dans un tableau de bord ou en pleine page (#80).

     L'en-tête de page ne garde donc que ce qui lui est PROPRE et n'a pas de
     place dans la bande : le regroupement (déjà une commande de page ailleurs)
     et l'accès aux réglages de la vue. */
  const viewToolbar = toolbarSlot ? (
    <ViewToolbarPortal slot={toolbarSlot}>
      {onOpenSettings && <button className="lp-tool-btn" type="button" onClick={onOpenSettings} title="Réglages de la vue"><Settings size={14} /> Réglages</button>}
      {/* Mêmes regroupements que le formulaire des réglages — inactivité et
          champs personnalisés compris : le menu rapide ne peut pas offrir moins
          que la fiche pour un moteur de regroupement qui sait tout faire. */}
      <DropdownButton label="Regrouper" icon={<Layers size={14} />} title="Regroupement des lignes">
        {miniGanttGroupByKeys(ctx).map((key) => <button key={key} type="button" className="lp-dropdown-action-row" onClick={() => onUpdateWidget?.({ groupBy: key })}>{key === "none" ? "Aucun regroupement" : fieldLabel(key, ctx)}</button>)}
      </DropdownButton>
    </ViewToolbarPortal>
  ) : null;

  /* Éclaircie des étiquettes de l'unité : deux voisines qui se toucheraient ne
     sont pas rendues toutes les deux — on garde la première et on saute la
     suivante. Volontairement calculé SANS Hook, juste avant le rendu de l'axe :
     il dépend de la largeur mesurée de la piste, qui n'est connue qu'ici, et
     c'est un parcours de quelques dizaines de graduations. */
  const axisUnitTicks = (() => {
    if (isEmpty) return [];
    const trackPx = trackWidth || 420;
    const kept = [];
    let occupeJusqua = -Infinity;
    ticks.forEach((t) => {
      const x = ((dayIndex(t.date) - minIdx) / span) * trackPx;
      const demi = widgetAxisLabelWidth(t.label) / 2;
      if (x - demi < occupeJusqua) return;
      occupeJusqua = x + demi + MINIGANTT_AXIS_LABEL_GAP;
      kept.push(t);
    });
    return kept;
  })();

  const Axis = () => (
    <div className="lp-widget-minigantt-axis">
      <div className="lp-widget-minigantt-axis-spacer" />
      <div className="lp-widget-minigantt-axis-track">
        <span className="lp-widget-minigantt-axis-baseline" />
        {/* Sous-graduations : le pas intermédiaire est porté par l'axe LUI-MÊME,
            pas seulement par la grille de fond. Sans elles, l'axe annuel
            n'offrait que sept traits sur sept ans. */}
        {tertiaryTicks.map((d) => (
          <span key={"axis-sub3-" + d} className="lp-widget-minigantt-axis-subtick is-fine" style={{ left: pctFor(dayIndex(d)) }} />
        ))}
        {secondaryTicks.map((d) => (
          <span key={"axis-sub-" + d} className="lp-widget-minigantt-axis-subtick" style={{ left: pctFor(dayIndex(d)) }} />
        ))}
        {weekendBands.map((idx) => (
          <span key={"we-" + idx} className="lp-widget-minigantt-weekend" style={{ left: pctFor(idx), width: `${(1 / span) * 100}%`, top:18, bottom:0 }} />
        ))}
        {axisUnitTicks.map((tick) => {
          const left = pctFor(dayIndex(tick.date));
          return (
            <React.Fragment key={"unit-" + tick.date}>
              <span className="lp-widget-minigantt-axis-tick" style={{ left }} />
              <span className="lp-widget-minigantt-axis-tick-label" style={{ left }}>
                {tick.label}
                {showDayContext && <span className="lp-widget-minigantt-axis-dow">{DOW_SHORT[new Date(tick.date + "T00:00:00").getDay()]}</span>}
              </span>
            </React.Fragment>
          );
        })}
        {/* Ligne du bas : les bornes de la fenêtre, et rien d'autre. Elles
            disent OÙ l'on est, pas ce qu'on mesure. */}
        {axisEdges.map((tick) => (
          <span
            key={"edge-" + tick.edge}
            className={"lp-widget-minigantt-axis-edge-label edge-" + tick.edge}
            style={{ left: pctFor(dayIndex(tick.date)) }}
          >
            {tick.label}
          </span>
        ))}
        {showToday && (
          <span className="lp-widget-minigantt-axis-today" style={{ left: pctFor(todayIdx) }}>Aujourd'hui</span>
        )}
      </div>
      {/* Même réserve que la bande des titres de bloc et celle des repères :
          sans elle, l'axe est plus large que les pistes et toutes ses
          graduations tombent à côté. */}
      {fieldsColumnShown && <span className="lp-widget-minigantt-phases-fields" style={{ width: FIELDS_COL_WIDTH }} />}
    </div>
  );

  /* Plus de légende. Elle occupait une ligne pleine largeur pour redire ce que
     le diagramme montre déjà — un losange est un jalon, une trame rouge est un
     retard — et elle poussait les barres vers le bas à chaque repère de plus.
     Les couleurs et les trames restent expliquées par les infobulles de chaque
     objet, là où la question se pose. */

  const RowLabel = ({ t, proj }) => (
    <span className="lp-widget-minigantt-label">
      {editable && (
        <input
          type="checkbox"
          className="lp-widget-minigantt-select"
          checked={selectedSet.has(t.id)}
          title="Sélectionner pour cadrer la vue"
          onMouseDown={(e) => e.stopPropagation()}
          onClick={(e) => e.stopPropagation()}
          onChange={() => toggleSelected(t.id)}
        />
      )}
      <span className="lp-widget-minigantt-label-title">{t.title}</span>
      {showRowProj && proj && <span className="lp-widget-minigantt-label-proj">{proj.name}</span>}
    </span>
  );

  // Position horizontale de chaque étiquette de risque, calculée une seule fois
  // pour tout le widget : deux étiquettes d'une même tâche ne se recouvrent
  // jamais, quel que soit l'empilement de leurs couloirs.
  const riskLabelLayout = useMemo(
    () => miniGanttRiskLabelLayout(riskSegments, { trackPx: trackWidth || 420, minIdx, maxIdx, span }),
    [riskSegments, trackWidth, minIdx, maxIdx, span]
  );

  // Couloirs d'incertitude d'une ligne : rendus dans sa piste, après la barre,
  // donc suivant sans effort le scroll, le zoom et tout déplacement de la tâche.
  // Ce retour se trouvait plus haut, AVANT les deux useMemo ci-dessus. React compte
  // les hooks à chaque rendu : passer de « des tâches » à « aucune tâche » en
  // exécutait donc deux de moins que le rendu précédent, et l'application tombait sur
  // l'erreur React #310 au lieu d'afficher l'état vide. N'importe quel filtre ne
  // ramenant rien suffisait à le déclencher.
  //
  // Le retour est descendu sous le dernier hook plutôt que les hooks remontés :
  // stripShapes et riskLabelLayout ne font que parcourir des collections, et les
  // valeurs intermédiaires (stripLaneCount, toolbar) se gardent déjà elles-mêmes
  // contre une liste vide. C'est aussi la convention du composant, dont les hooks
  // antérieurs (axisUnitTicks, weekendBands) testent isEmpty À L'INTÉRIEUR.
  if (isEmpty) return <div className="lp-empty" style={{ padding: 16 }}>Aucune tâche pour ce filtre.</div>;

  // Largeur RÉELLE de la piste, déjà mesurée pour les étiquettes de risque :
  // c'est elle qui décide si un libellé chiffré tient, en pixels et non en
  // pourcentage — le même « +8 j » n'occupe pas la même fraction d'une piste de
  // 270 px et d'une piste de 900 px.
  const comparisonTrackPx = trackWidth || 420;
  const comparisonTodayPct = showToday ? ((todayIdx - minIdx) / span) * 100 : null;

  const RowRisks = ({ taskId }) => {
    const segments = risksByTask.get(taskId);
    if (!segments || !segments.length) return null;
    return (
      <>
        {segments.map((seg) => {
          const from = Math.max(minIdx, seg.startIdx);
          const to = Math.min(maxIdx, seg.endIdx);
          if (to <= from) return null;
          const left = ((from - minIdx) / span) * 100;
          const width = Math.max(0.6, ((to - from) / span) * 100);
          const label = seg.title || "Risque";
          const tip = `${label} — ${MINIGANTT_RISK_SEVERITY_LABELS[seg.severity]} · ${seg.endIdx - seg.startIdx} j`;
          return (
            <React.Fragment key={seg.id}>
              <span
                className={"lp-widget-minigantt-risk is-" + seg.style}
                style={{
                  left: left + "%",
                  width: width + "%",
                  top: `calc(50% + ${seg.lane * 5}px)`,
                  color: seg.color,
                  borderColor: seg.color,
                  background: seg.style === "hatched"
                    ? `repeating-linear-gradient(45deg, ${seg.color}40 0 3px, transparent 3px 6px)`
                    : (seg.style === "solid" ? `${seg.color}38` : "transparent"),
                }}
                title={tip}
              />
              {riskLabelLayout.has(seg.id) && (
                <span
                  className="lp-widget-minigantt-risk-label"
                  style={{
                    left: `${riskLabelLayout.get(seg.id).leftPct}%`,
                    top: `calc(50% + ${riskLabelLayout.get(seg.id).line * MINIGANTT_RISK_LABEL_LINE_H}px)`,
                    color: seg.color,
                  }}
                  title={tip}
                >
                  {seg.title}
                </span>
              )}
            </React.Fragment>
          );
        })}
      </>
    );
  };

  // Grille verticale commune à toutes les lignes d'un même bloc (widget entier
  // en mode non groupé, ou chaque groupe en mode groupé) : rendue UNE SEULE
  // FOIS en superposition plutôt que dupliquée dans chaque piste — évite à la
  // fois la surcharge visuelle et les micros désalignements d'une ligne à
  // l'autre. Les insets gauche/droite reproduisent exactement la largeur de
  // la piste telle que la donne le flex de chaque ligne (étiquette 26% + les
  // 6px de gap ; colonne de champs fixe + son gap en mode "aligned").
  const GridOverlay = () => (
    <div
      className="lp-widget-minigantt-gridoverlay"
      style={layerInsets}
    >
      {weekendBands.map((idx) => (
        <span key={"we-" + idx} className="lp-widget-minigantt-weekend" style={{ left: pctFor(idx), width: `${(1 / span) * 100}%` }} />
      ))}
      {tertiaryTicks.map((d) => (
        <span key={"ter-" + d} className="lp-widget-minigantt-sub-sep is-fine" style={{ left: pctFor(dayIndex(d)) }} />
      ))}
      {secondaryTicks.map((d) => (
        <span key={"sec-" + d} className="lp-widget-minigantt-sub-sep" style={{ left: pctFor(dayIndex(d)) }} />
      ))}
      {ticks.map((tick) => (
        <span key={tick.date} className="lp-widget-minigantt-gridline" style={{ left: pctFor(dayIndex(tick.date)) }} />
      ))}
      {showToday && <span className="lp-widget-minigantt-todayline" style={{ left: pctFor(todayIdx) }} />}
    </div>
  );

  /* Indicateur latéral d'écart : l'écart de FIN (ou de jalon), qui est l'écart
     principal. Il vit avec les autres champs de la ligne, donc il suit les deux
     dispositions sans code de placement supplémentaire. Le signe et le nombre
     le rendent lisible sans voir la couleur, et `aria-label` le dit en toutes
     lettres aux lecteurs d'écran. */
  const ComparisonChip = ({ t }) => {
    const cmp = comparisonByTask.get(t.id);
    if (!cmp) return null;
    const color = miniGanttComparisonToneColor(cmp.endTone);
    const quoi = cmp.milestone ? "Jalon" : "Fin";
    return (
      <span
        className="lp-widget-minigantt-cmpchip"
        style={{ color, borderColor: color, background: `color-mix(in srgb, ${color} 10%, transparent)` }}
        title={`${quoi} — référence ${fmtShort(cmp.referenceEnd)}, actuel ${fmtShort(cmp.currentEnd)} · ${miniGanttComparisonDeltaLabel(cmp.endDeltaDays)} (${miniGanttComparisonToneLabel(cmp.endTone)})`}
        aria-label={miniGanttComparisonDeltaAria(cmp.endDeltaDays, quoi)}
      >
        <span
          className="lp-widget-minigantt-cmpchip-mark"
          style={{
            borderColor: color,
            borderStyle: cmp.endTone === "ahead" ? "dashed" : cmp.endTone === "late" ? "solid" : "dotted",
            background: cmp.endTone === "ontime" ? "transparent" : miniGanttComparisonZonePattern(cmp.endTone),
          }}
          aria-hidden="true"
        />
        {miniGanttComparisonDeltaLabel(cmp.endDeltaDays)}
      </span>
    );
  };

  // Champs facultatifs — chaque champ (hors "progress", rendu séparément en
  // anneau) passe par le composant FieldValue partagé avec le reste de
  // Nexora, pour garder exactement la même mise en forme (pastille de
  // statut, badge de type, chip responsable...). En disposition "aligned",
  // c'est une colonne à largeur fixe après la piste ; en "inline", un bloc
  // positionné juste après la barre/le jalon, ancré sur sa position réelle.
  // L'indicateur d'écart ci-dessus les suit : il s'affiche même quand aucun
  // champ facultatif n'est configuré.
  const RowFields = ({ t, anchorPct, box, color, inSlot }) => {
    const hasComparison = comparisonByTask.has(t.id);
    /* En disposition alignée, la colonne se rend sur TOUTES les lignes dès
       qu'elle existe pour une seule — même celles qui n'ont rien à y mettre.
       Sinon la ligne perd l'élément ET la gouttière de 6 px du flex, et sa
       piste devient plus large que celles de ses voisines, de l'axe et de la
       grille. Deux lignes du même widget n'avaient alors pas la même échelle
       dès qu'une seule portait un indicateur d'écart.
       Aucune colonne pour personne reste le cas de l'issue #66 : là, rien
       n'est rendu nulle part, et la piste va jusqu'au bord. */
    if (fieldsLayout === "under" || fieldsLayout === "compact") {
      if (!rowFields.length) return null;
    } else {
      if (!fieldsColumnShown && !hasComparison) return null;
      if (fieldsLayout === "inline" && !rowFields.length && !hasComparison) return null;
    }
    const content = (
      <>
        {rowFields.filter((f) => f !== "progress").map((f) => (
          <FieldValue key={f} fieldKey={f} task={t} ctx={ctx} />
        ))}
        {rowFields.includes("progress") && (
          <span className="lp-widget-minigantt-ring-wrap" title={`Avancement : ${Math.round(t.progress || 0)}%`}>
            <MiniGanttProgressRing progress={t.progress} />
          </span>
        )}
        <ComparisonChip t={t} />
      </>
    );
    if (fieldsLayout === "compact") {
      /* Bandeau CONDENSÉ, rattaché à la bulle (#122).

         Une seule ligne, exactement la largeur de la bulle, le même trait et la
         même couleur qu'elle, sans bord haut : on lit un bandeau qui APPARTIENT
         à cette bulle-là, et non une rangée de pastilles posée dessous. Les
         valeurs restent celles de `FieldValue` — la mise en forme partagée avec
         tout Nexora — simplement condensées par la feuille de style : un second
         formateur, propre aux bulles, aurait fini par ne plus dire la même
         chose que les autres widgets.

         Trop de champs pour la largeur : la ligne est coupée à droite, et
         l'infobulle de la bulle continue de tout dire.

         En couloir, le bandeau est déjà DANS l'emplacement de la bulle : il n'a
         rien à se placer. Hors couloir, il se pose comme les champs « sous la
         bulle », à sa hauteur et à sa largeur. */
      const compactBox = inSlot
        ? null
        : (box || { left: (Number(anchorPct) || 0) + "%", width: (100 - (Number(anchorPct) || 0)) + "%" });
      return (
        <div
          className="lp-bubble-fields is-compact"
          style={{
            borderColor: color || "var(--border)",
            background: color ? `color-mix(in srgb, ${color} 8%, var(--surface))` : "var(--surface)",
            /* Hors couloir, le bandeau est EN FLUX sous la bulle, décalé de sa
               hauteur — le même procédé que les champs « sous la bulle » (#103) :
               c'est lui qui fait grandir la piste, donc la ligne, donc la
               hauteur mesurée dont vivent les macro-bulles et les encadrés. */
            ...(compactBox ? { marginTop: "var(--lp-bubble-h)", marginLeft: compactBox.left, width: compactBox.width } : null),
          }}
          onMouseDown={(e) => e.stopPropagation()}
          onClick={(e) => e.stopPropagation()}
        >
          {content}
        </div>
      );
    }
    if (fieldsLayout === "under") {
      /* En FLUX sous la bulle, et non en position absolue : c'est ce qui fait
         grandir la piste, donc la ligne, donc la hauteur mesurée dont vivent
         les macro-bulles et les encadrés.

         Les champs tiennent EXACTEMENT la boîte de la bulle — même bord gauche,
         même bord droit (#103). Ils s'étalaient auparavant jusqu'au bord de la
         piste : une bulle courte portait une rangée bien plus large qu'elle,
         qui empiétait sur la place des voisines et ne se rattachait plus à rien
         à l'œil. Trop étroits pour tenir sur une ligne, ils passent à la ligne
         et la ligne du diagramme grandit d'autant. */
      const fieldsBox = box || { left: (Number(anchorPct) || 0) + "%", width: (100 - (Number(anchorPct) || 0)) + "%" };
      return (
        <div
          className="lp-bubble-fields"
          style={{ marginTop: "var(--lp-bubble-h)", marginLeft: fieldsBox.left, width: fieldsBox.width }}
          onMouseDown={(e) => e.stopPropagation()}
          onClick={(e) => e.stopPropagation()}
        >
          {content}
        </div>
      );
    }
    if (fieldsLayout === "inline") {
      return (
        <div
          className="lp-widget-minigantt-fields lp-widget-minigantt-fields-inline"
          style={{ left: `calc(${anchorPct}% + 6px)` }}
          onMouseDown={(e) => e.stopPropagation()}
          onClick={(e) => e.stopPropagation()}
        >
          {content}
        </div>
      );
    }
    return (
      <div
        className="lp-widget-minigantt-fields lp-widget-minigantt-fields-aligned"
        style={{ width: FIELDS_COL_WIDTH }}
        ref={(el) => { if (el) fieldNodes.current[t.id] = el; else delete fieldNodes.current[t.id]; }}
        onMouseDown={(e) => e.stopPropagation()}
        onClick={(e) => e.stopPropagation()}
      >
        {content}
      </div>
    );
  };

  /* --- Mode bulles (#92) : la ligne, et rien d'autre -----------------------

     Une bulle occupe la piste comme une barre — même calcul de position, même
     écrêtage à la fenêtre — mais porte son titre, son avancement et, en
     option, sa description. Les champs choisis se rangent SOUS elle, en flux :
     la piste grandit d'elle-même, la hauteur de ligne est donc MESURÉE, et les
     macro-bulles comme les encadrés suivent sans second calcul de disposition.

     Largeur : proportionnelle à la durée, avec un plancher en PIXELS (et non en
     pourcentage) pour qu'un titre reste lisible sur une tâche d'un jour, puis
     ramenée dans la piste pour qu'une bulle de fin de fenêtre ne déborde pas du
     cadre du widget. */
  // Place minimale, en pixels, pour écrire une date à côté d'une bulle.
  const BUBBLE_DATE_ROOM_PX = 46;
  const bubbleWidthPct = (leftPct, rawWidthPct) => {
    const minPct = Math.min(60, (BUBBLE_MIN_PX / bubbleTrackPx) * 100);
    return Math.max(0.4, Math.min(Math.max(rawWidthPct, minPct), 100 - leftPct));
  };
  // Surlignage par la légende : cliquer une valeur atténue les bulles des
  // autres groupes. C'est une mise en avant, pas un filtre — rien ne disparaît.
  const bubbleDimmed = (taskId) => {
    if (!bubbleHighlight) return false;
    const entry = bubbleColors.get(taskId);
    return !entry || entry.groupKey !== bubbleHighlight;
  };
  const bubbleColorOf = (t) => (bubbleColors.get(t.id) || {}).color || "var(--text-muted)";
  /* Boîte d'une bulle de JALON. Sa largeur est fixe — c'est ce qui permet à ses
     champs de tenir exactement la même largeur qu'elle (#103), et à
     `bubbleRowExtent` de dire ce qu'elle occupe. Centrée sur sa date, sauf tout
     au bord de la piste où elle s'aligne sur le bord : à moitié dehors, le
     cadre du widget la coupait. */
  const bubbleMilestoneBox = (leftPct) => {
    const leftPx = (leftPct / 100) * bubbleTrackPx;
    const half = BUBBLE_MILESTONE_W / 2;
    if (leftPx < half) return { left: "0px", transform: "none", fieldsLeft: "0px" };
    if (bubbleTrackPx - leftPx < half) {
      return { left: "100%", transform: "translateX(-100%)", fieldsLeft: `calc(100% - ${BUBBLE_MILESTONE_W}px)` };
    }
    return { left: leftPct + "%", transform: "translateX(-50%)", fieldsLeft: `calc(${leftPct}% - ${half}px)` };
  };

  const BubbleFoot = ({ t, color, pct }) => {
    if (!bubbleCfg.bubbleShowProgress) return null;
    const st = ctx.statuses.find((s) => s.id === t.statusId);
    return (
      <div className="lp-bubble-foot">
        <span className="lp-bubble-foot-dot" style={{ background: st?.color || color }} />
        <span className="lp-bubble-foot-label">{st?.name || "Sans statut"}</span>
        <span className="lp-bubble-foot-pct">{pct}%</span>
      </div>
    );
  };

  const BubbleEdgeDates = ({ t, leftPct, widthPct, inSlot, laneRoom }) => {
    // Les dates s'écrivent DEHORS, à gauche et à droite de la bulle : dedans,
    // elles mangeraient le titre dès que la tâche est courte. Sous 44 px de
    // piste, il n'y a pas la place pour les deux : on n'en écrit aucune plutôt
    // que de les superposer.
    if (!bubbleCfg.bubbleShowDates || (widthPct / 100) * bubbleTrackPx < 44) return null;
    /* Chaque date ne s'écrit que s'il reste la place de l'écrire DANS la piste :
       collée au bord, elle sortait de la piste et le cadre du widget la
       coupait. Une seule des deux peut donc manquer. */
    /* La place disponible est celle de la piste ET celle que laisse la bulle
       VOISINE quand il y en a une (#120) : une date écrite dehors ne doit pas
       venir se poser sur la bulle d'à côté. Hors couloir, il n'y a pas de
       voisine — le couloir ne contient qu'une bulle. */
    const roomLeftPx = Math.min(
      (leftPct / 100) * bubbleTrackPx,
      laneRoom && Number.isFinite(laneRoom.before) ? laneRoom.before : Infinity,
    );
    const roomRightPx = Math.min(
      ((100 - leftPct - widthPct) / 100) * bubbleTrackPx,
      laneRoom && Number.isFinite(laneRoom.after) ? laneRoom.after : Infinity,
    );
    /* En couloir (#120), la date est posée dans l'EMPLACEMENT de la bulle et
       non dans la piste : ses bords sont ceux de la bulle, donc 0 % et 100 %.
       La place disponible, elle, se mesure toujours sur la piste — c'est bien
       du cadre du widget qu'il s'agit de ne pas sortir. */
    return (
      <>
        {roomLeftPx >= BUBBLE_DATE_ROOM_PX && (
          <span className="lp-bubble-date is-start" style={{ left: inSlot ? "0%" : leftPct + "%" }}>{fmtShort(t.start)}</span>
        )}
        {roomRightPx >= BUBBLE_DATE_ROOM_PX && (
          <span className="lp-bubble-date is-end" style={{ left: inSlot ? "100%" : (leftPct + widthPct) + "%" }}>{fmtShort(t.end)}</span>
        )}
      </>
    );
  };

  /* Boîte d'une bulle de tâche dans la piste, bornée à la fenêtre affichée et
     largeur plancher comprise. `null` quand la tâche est entièrement hors
     fenêtre : il n'y a alors rien à dessiner, ni à placer dans un couloir. */
  const bubbleTaskBox = (t) => {
    const rawStartIdx = dayIndex(t.start);
    const rawEndIdx = dayIndex(t.end);
    if (!Number.isFinite(rawStartIdx) || !Number.isFinite(rawEndIdx)) return null;
    if (rawEndIdx < minIdx || rawStartIdx > maxIdx) return null;
    const visibleStartIdx = Math.max(minIdx, rawStartIdx);
    const visibleEndIdx = Math.min(maxIdx, rawEndIdx);
    const leftPct = ((visibleStartIdx - minIdx) / span) * 100;
    const widthPct = bubbleWidthPct(leftPct, ((Math.max(visibleStartIdx, visibleEndIdx) - visibleStartIdx) / span) * 100);
    return { leftPct, widthPct };
  };

  /* Boîte RÉELLEMENT occupée par un emplacement, en pixels de piste. Elle ne
     se déduit pas de `bubbleRowExtent` : celle-là modélise ce qu'une bulle
     occupe pour le RANGEMENT, à partir des seules dates, quand la boîte d'un
     jalon, elle, est recalée contre le bord de la piste dès qu'elle y
     dépasserait (`bubbleMilestoneBox`). C'est la boîte dessinée qu'il faut
     pour savoir ce qui reste de place entre deux voisines. */
  const bubbleSlotBoxPx = (t) => {
    if (t.milestone) {
      const idx = dayIndex(t.end);
      if (!Number.isFinite(idx) || idx < minIdx || idx > maxIdx) return null;
      const centerPx = ((idx - minIdx) / span) * bubbleTrackPx;
      const half = BUBBLE_MILESTONE_W / 2;
      const leftPx = centerPx < half
        ? 0
        : (bubbleTrackPx - centerPx < half ? bubbleTrackPx - BUBBLE_MILESTONE_W : centerPx - half);
      return { leftPx, rightPx: leftPx + BUBBLE_MILESTONE_W };
    }
    const geo = bubbleTaskBox(t);
    if (!geo) return null;
    const leftPx = (geo.leftPct / 100) * bubbleTrackPx;
    return { leftPx, rightPx: leftPx + (geo.widthPct / 100) * bubbleTrackPx };
  };

  /* La bulle elle-même. `inSlot` ne change QU'UNE chose : qui porte la
     position. Posée directement dans la piste, la bulle s'y place en
     pourcentage ; posée dans un emplacement de couloir (#120), c'est
     l'emplacement qui est placé et la bulle le remplit. Tout le reste — lavis
     d'avancement, en-tête, description, pied, poignées — est identique, et
     doit le rester : deux copies divergeraient au premier correctif. */
  const BubbleTaskShape = ({ t, leftPct, widthPct, inSlot }) => {
    const color = bubbleColorOf(t);
    const pct = Math.max(0, Math.min(100, Math.round(t.progress || 0)));
    const dimmed = bubbleDimmed(t.id);
    const late = isTaskLate(t, ctx);
    const desc = String(t.desc ?? t.description ?? "").trim();
    const showDesc = !!(bubbleCfg.bubbleShowDescription && desc);
    /* Deux étages de teinte quand la description est là (#121). L'en-tête garde
       la couleur de base ; le corps — description et pied — passe en
       transparence légère de LA MÊME couleur. Sans description, la bulle garde
       son lavis unique : un widget qui ne l'affiche pas ne bouge pas d'un pixel.

       L'en-tête est peint en `transparent` et non sur la surface du thème :
       posé en aplat, il aurait masqué le lavis d'avancement qui court derrière
       lui, et une bulle à 40 % n'aurait plus montré son avancement que sous son
       titre. */
    const headTint = `color-mix(in srgb, ${color} 26%, transparent)`;
    const headStyle = showDesc
      ? { background: headTint, borderBottom: `1px solid color-mix(in srgb, ${color} 38%, transparent)` }
      : undefined;
    return (
      <div
        className={"lp-bubble" + (late ? " is-late" : "") + (dimmed ? " is-dimmed" : "") + (showDesc ? " has-desc" : "")}
        style={{
          ...(inSlot ? null : { left: leftPct + "%", width: widthPct + "%" }),
          borderColor: color,
          // Lavis de la couleur du groupe sur la surface du thème : le texte
          // garde --text-900 et reste lisible en thème clair comme sombre,
          // ce qu'un aplat de couleur pleine ne garantirait pas. Allégé quand
          // l'en-tête porte déjà la couleur (#121), pour que les deux étages
          // se distinguent.
          background: `color-mix(in srgb, ${color} ${showDesc ? 5 : 10}%, var(--surface))`,
        }}
        title={t.title}
      >
        <span className="lp-bubble-progress" style={{ width: pct + "%", background: color }} />
        <div className="lp-bubble-head" style={headStyle}>
          <span className="lp-bubble-title">{t.title}</span>
        </div>
        {showDesc && <div className="lp-bubble-desc">{desc}</div>}
        <BubbleFoot t={t} color={color} pct={pct} />
        {onUpdateTask && (
          <>
            <div
              className="lp-bubble-handle left" title="Glisser pour changer la date de début"
              {...handleHoverGuard}
              onMouseDown={(e) => startBarDrag(e, t, "start", e.currentTarget.closest(".lp-widget-minigantt-track"))}
              onTouchStart={(e) => startBarDrag(e, t, "start", e.currentTarget.closest(".lp-widget-minigantt-track"))}
            />
            <div
              className="lp-bubble-handle right" title="Glisser pour changer la date de fin"
              {...handleHoverGuard}
              onMouseDown={(e) => startBarDrag(e, t, "end", e.currentTarget.closest(".lp-widget-minigantt-track"))}
              onTouchStart={(e) => startBarDrag(e, t, "end", e.currentTarget.closest(".lp-widget-minigantt-track"))}
            />
            {/* L'avancement se mesure sur la BULLE, pas sur la piste : la
                poignée reste exactement sous le pointeur, comme celle de la
                barre se mesure sur la barre. */}
            <div
              className={"lp-bubble-progress-handle" + (pct >= 100 ? " is-done" : "")}
              style={{ left: pct + "%" }}
              {...handleHoverGuard}
              title={pct >= 100 ? "Avancement à 100 % — glisser pour revenir en arrière" : `Glisser pour changer l'avancement (${pct}%)`}
              onMouseDown={(e) => startBarDrag(e, t, "progress", e.currentTarget.closest(".lp-bubble"))}
              onTouchStart={(e) => startBarDrag(e, t, "progress", e.currentTarget.closest(".lp-bubble"))}
            >
              {pct >= 100 && <Check size={7} strokeWidth={4} aria-hidden="true" />}
            </div>
          </>
        )}
      </div>
    );
  };

  /* Bulle de JALON. Même partage que ci-dessus : le contenu ne sait pas s'il
     est seul sur sa ligne ou rangé dans un couloir. */
  const BubbleMilestoneShape = ({ t, msBox, inSlot }) => {
    const color = bubbleColorOf(t);
    const icon = resolveMilestoneIcon(t, ctx);
    const dimmed = bubbleDimmed(t.id);
    const dragHandlers = onUpdateTask ? {
      onMouseDown: (e) => startBarDrag(e, t, "move-milestone", e.currentTarget.closest(".lp-widget-minigantt-track")),
      onTouchStart: (e) => startBarDrag(e, t, "move-milestone", e.currentTarget.closest(".lp-widget-minigantt-track")),
    } : {};
    return (
      <div
        className={"lp-bubble-milestone" + (dimmed ? " is-dimmed" : "")}
        style={{
          ...(inSlot ? { position: "relative", transform: "none", width: "100%" } : { left: msBox.left, transform: msBox.transform }),
          borderColor: color,
          background: `color-mix(in srgb, ${color} 10%, var(--surface))`,
        }}
        title={`${t.title} · ${fmtShort(t.end)}`}
        {...dragHandlers}
      >
        {icon
          ? <IconGlyph icon={icon} size={12} />
          : <span className="lp-bubble-milestone-glyph" style={{ background: color }} />}
        <span className="lp-bubble-milestone-title">{t.title}</span>
        {bubbleCfg.bubbleShowDates && <span className="lp-bubble-milestone-date">{fmtShort(t.end)}</span>}
      </div>
    );
  };

  /* --- Une tâche, une ligne (disposition « rows ») ------------------------ */

  const BubbleRow = (t) => {
    const geo = bubbleTaskBox(t);
    if (!geo) return null;
    const { leftPct, widthPct } = geo;
    return (
      <div
        className={"lp-widget-minigantt-row is-" + emphasisFor(t.id)}
        key={t.id}
        ref={(el) => { if (el) rowNodes.current[t.id] = el; else delete rowNodes.current[t.id]; }}
        onClick={openTaskUnlessDragged(t)}
        onMouseEnter={(e) => openTip(t, e)}
        onMouseMove={(e) => openTip(t, e)}
        onMouseLeave={() => setHover(null)}
      >
        <div className="lp-widget-minigantt-track">
          <BubbleEdgeDates t={t} leftPct={leftPct} widthPct={widthPct} />
          <BubbleTaskShape t={t} leftPct={leftPct} widthPct={widthPct} />
          {fieldsLayout === "inline" && <RowFields t={t} anchorPct={leftPct + widthPct} />}
          {(fieldsLayout === "under" || fieldsLayout === "compact")
            && <RowFields t={t} box={{ left: leftPct + "%", width: widthPct + "%" }} color={bubbleColorOf(t)} />}
        </div>
      </div>
    );
  };

  const BubbleMilestoneRow = (t) => {
    const idx = dayIndex(t.end);
    if (idx < minIdx || idx > maxIdx) return null;
    const leftPct = ((idx - minIdx) / span) * 100;
    const msBox = bubbleMilestoneBox(leftPct);
    return (
      <div
        className="lp-widget-minigantt-row"
        key={t.id}
        ref={(el) => { if (el) rowNodes.current[t.id] = el; else delete rowNodes.current[t.id]; }}
        onClick={openTaskUnlessDragged(t)}
        onMouseEnter={(e) => openTip(t, e)}
        onMouseMove={(e) => openTip(t, e)}
        onMouseLeave={() => setHover(null)}
      >
        <div className="lp-widget-minigantt-track">
          {/* Un jalon n'a qu'une date : sa bulle est compacte et CENTRÉE sur
              cette date — lui donner une largeur fabriquerait une durée. */}
          <BubbleMilestoneShape t={t} msBox={msBox} />
          {fieldsLayout === "inline" && <RowFields t={t} anchorPct={leftPct} />}
          {(fieldsLayout === "under" || fieldsLayout === "compact")
            && <RowFields t={t} box={{ left: msBox.fieldsLeft, width: BUBBLE_MILESTONE_W + "px" }} color={bubbleColorOf(t)} />}
        </div>
      </div>
    );
  };

  /* --- Couloirs : les bulles côte à côte (disposition « lanes », #120) ----

     Une LIGNE porte ici plusieurs bulles, chacune dans son emplacement. C'est
     l'emplacement qui est placé dans la piste — la bulle le remplit — et c'est
     lui qui porte le clic, l'infobulle et la mise en avant : la ligne n'est
     plus l'affaire d'une seule tâche.

     La hauteur d'une ligne de couloir est POSÉE et non mesurée : tout y est en
     position absolue, donc rien ne la fait grandir. Elle vaut exactement la
     bulle plus, s'il y a lieu, le bandeau condensé — d'où l'obligation, en
     couloirs, que les champs prennent cette forme-là (bubbleEffectiveFieldsLayout). */
  const bubbleLaneStyle = { minHeight: bubbleLaneHeightPx(widget, titleExtraPx) + "px" };

  const BubbleSlot = (t, laneRoom) => {
    const geo = bubbleTaskBox(t);
    if (!geo) return null;
    const { leftPct, widthPct } = geo;
    return (
      <div
        className={"lp-bubble-slot is-" + emphasisFor(t.id)}
        key={t.id}
        style={{ left: leftPct + "%", width: widthPct + "%" }}
        onClick={openTaskUnlessDragged(t)}
        onMouseEnter={(e) => openTip(t, e)}
        onMouseMove={(e) => openTip(t, e)}
        onMouseLeave={() => setHover(null)}
      >
        <BubbleEdgeDates t={t} leftPct={leftPct} widthPct={widthPct} inSlot laneRoom={laneRoom} />
        <BubbleTaskShape t={t} leftPct={leftPct} widthPct={widthPct} inSlot />
        <RowFields t={t} color={bubbleColorOf(t)} inSlot />
      </div>
    );
  };

  const BubbleMilestoneSlot = (t) => {
    const idx = dayIndex(t.end);
    if (idx < minIdx || idx > maxIdx) return null;
    const leftPct = ((idx - minIdx) / span) * 100;
    const msBox = bubbleMilestoneBox(leftPct);
    return (
      <div
        className={"lp-bubble-slot is-" + emphasisFor(t.id)}
        key={t.id}
        style={{ left: msBox.fieldsLeft, width: BUBBLE_MILESTONE_W + "px" }}
        onClick={openTaskUnlessDragged(t)}
        onMouseEnter={(e) => openTip(t, e)}
        onMouseMove={(e) => openTip(t, e)}
        onMouseLeave={() => setHover(null)}
      >
        <BubbleMilestoneShape t={t} msBox={msBox} inSlot />
        <RowFields t={t} color={bubbleColorOf(t)} inSlot />
      </div>
    );
  };

  /* Les lignes d'un regroupement, rangées en couloirs. La mesure des lignes
     (`rowNodes`) reste indexée PAR TÂCHE : toutes celles d'un même couloir
     pointent sur le même élément, et les macro-bulles comme les encadrés
     continuent de lire `rowRects[idDeTâche]` sans rien savoir des couloirs. */
  const BubbleLanes = (tasks) => {
    const byId = new Map(tasks.map((t) => [t.id, t]));
    const lanes = bubbleLaneRows(
      tasks
        .map((t) => {
          const startIdx = dayIndex(t.milestone ? t.end : t.start);
          const endIdx = dayIndex(t.end);
          if (!Number.isFinite(startIdx) || !Number.isFinite(endIdx)) return null;
          if (endIdx < minIdx || startIdx > maxIdx) return null;
          return {
            id: t.id,
            milestone: !!t.milestone,
            startIdx: Math.max(minIdx, Math.min(maxIdx, startIdx)),
            endIdx: Math.max(minIdx, Math.min(maxIdx, endIdx)),
          };
        })
        .filter(Boolean),
      { pxPerDay: bubbleTrackPx / span, packing: true },
    );
    /* Place LIBRE de part et d'autre de chaque bulle, mesurée sur les boîtes
       RÉELLEMENT dessinées du couloir, et PARTAGÉE entre deux voisines :
       `bubbleLaneDateRoom` dit pourquoi. */
    const laneRoom = new Map();
    lanes.forEach((lane) => {
      const boxes = lane.items
        .map((row) => {
          const t = byId.get(row.id);
          const box = t ? bubbleSlotBoxPx(t) : null;
          return box ? { id: row.id, ...box } : null;
        })
        .filter(Boolean);
      bubbleLaneDateRoom(boxes).forEach((value, id) => laneRoom.set(id, value));
    });
    return lanes.map((lane) => (
      <div
        className="lp-widget-minigantt-row lp-bubble-lane"
        key={lane.key}
        ref={(el) => {
          lane.items.forEach((row) => {
            if (el) rowNodes.current[row.id] = el;
            else delete rowNodes.current[row.id];
          });
        }}
      >
        <div className="lp-widget-minigantt-track" style={bubbleLaneStyle}>
          {lane.items.map((row) => {
            const t = byId.get(row.id);
            if (!t) return null;
            return t.milestone ? BubbleMilestoneSlot(t) : BubbleSlot(t, laneRoom.get(row.id));
          })}
        </div>
      </div>
    ));
  };

  /* Les lignes d'une liste de tâches — c'est ici, et nulle part ailleurs, que
     se décide « une tâche, une ligne » ou « des bulles côte à côte » (#120).
     Les deux vues groupée et non groupée passent par là. */
  const renderRows = (list) => (
    bubblePacked
      ? BubbleLanes(list)
      : list.map((t) => (t.milestone ? MilestoneRow(t) : Row(t)))
  );

  const Row = (t) => {
    if (bubbleMode) return BubbleRow(t);
    const rawStartIdx = dayIndex(t.start);
    const rawEndIdx = dayIndex(t.end);
    const visibleStartIdx = Math.max(minIdx, rawStartIdx);
    const visibleEndIdx = Math.min(maxIdx, rawEndIdx);
    const left = ((visibleStartIdx - minIdx) / span) * 100;
    const width = Math.max(2, ((Math.max(visibleStartIdx, visibleEndIdx) - visibleStartIdx) / span) * 100);
    const proj = ctx.projects.find((p) => p.id === t.projectId);
    const st = ctx.statuses.find((s) => s.id === t.statusId);
    const tt = (ctx.taskTypes || []).find((x) => x.id === t.taskTypeId);
    const barColor = (colorBy === "project" ? proj?.color : colorBy === "taskType" ? tt?.color : st?.color) || proj?.color || st?.color || "var(--text-muted)";
    const paleBg = typeof barColor === "string" && barColor.startsWith("#") ? barColor + "3a" : "var(--paper-soft)";
    const pct = Math.max(0, Math.min(100, Math.round(t.progress || 0)));
    // Comparaison : la référence et les écarts se dessinent sur un RAIL FIN
    // sous la barre, dans la même piste. La barre actuelle reste donc seule sur
    // sa ligne. Aucune ligne ne grandit — tout est en position absolue dans une
    // piste en `overflow:visible`.
    const cmp = comparisonByTask.get(t.id) || null;
    /* Une tâche entièrement HORS de la fenêtre affichée n'est pas dessinée. Un
       cadrage glissant ou à dates fixes en exclut forcément, et les écraser
       contre le bord donnait une barre de 2 % qui ne voulait rien dire. Les
       jalons appliquaient déjà cette règle ; les barres la rejoignent. Une
       référence encore dans la fenêtre suffit à garder la ligne : c'est elle
       qu'on est venu comparer. */
    const cmpInWindow = !!cmp && cmp.referenceEndIdx >= minIdx && cmp.referenceStartIdx <= maxIdx;
    if ((rawEndIdx < minIdx || rawStartIdx > maxIdx) && !cmpInWindow) return null;
    const cmpBars = cmp ? miniGanttComparisonBars(cmp, { minIdx, maxIdx, span }) : null;
    const cmpStrip = cmp ? miniGanttComparisonStrip(cmp, { minIdx, maxIdx, span }) : null;
    const cmpHasRisks = risksByTask.has(t.id);
    const cmpLabelVisible = (zone) => miniGanttComparisonLabelVisible(zone, {
      trackPx: comparisonTrackPx, todayPct: comparisonTodayPct, hasRisks: cmpHasRisks,
    });
    /* La VALEUR en jours d'un écart, posée au centre de la zone concernée si la
       place le permet. Le dessin de la zone, lui, appartient au ruban : ce sont
       les mêmes bornes, mais le ruban les rend d'une seule pièce.
       `freed` — la part de référence que la tâche n'atteint pas — est une
       AVANCE : elle porte son chiffre en vert comme les autres. Elle partageait
       la couleur de la référence, et une tâche terminée en avance n'affichait
       alors rien de vert (retour de test). */
    const cmpZoneLabel = (zone, kind, days) => {
      if (!zone || !cmpLabelVisible(zone)) return null;
      return (
        <span
          key={"cmp-" + kind}
          className="lp-widget-minigantt-cmplabel"
          /* Sur le bord EXTÉRIEUR de la zone — celui qui s'éloigne de la barre —
             et jamais en son centre : centrée, elle masquait la trame qu'elle
             commente et, sur une zone courte, débordait des deux côtés. Un
             démarrage anticipé s'écrit donc à gauche, un retard de fin à droite. */
          style={kind === "ahead"
            ? { left: zone.leftPct + "%", transform: "translate(calc(-100% - 3px), -50%)", color: miniGanttComparisonZoneColor(kind) }
            : { left: (zone.leftPct + zone.widthPct) + "%", transform: "translate(3px, -50%)", color: miniGanttComparisonZoneColor(kind) }}
          aria-hidden="true"
        >
          {miniGanttComparisonDeltaLabel(days)}
        </span>
      );
    };
    return (
      <div
        className={"lp-widget-minigantt-row is-" + emphasisFor(t.id) + (selectedSet.has(t.id) ? " is-selected" : "")}
        key={t.id}
        ref={(el) => { if (el) rowNodes.current[t.id] = el; else delete rowNodes.current[t.id]; }}
        onClick={openTaskUnlessDragged(t)}
        onMouseEnter={(e) => openTip(t, e)}
        onMouseMove={(e) => openTip(t, e)}
        onMouseLeave={() => setHover(null)}
      >
        <RowLabel t={t} proj={proj} />
        <div className="lp-widget-minigantt-track">
          {cmpStrip && (
            <span
              className={"lp-widget-minigantt-cmpstrip"
                + (cmpStrip.clippedStart ? " is-clipped-start" : "")
                + (cmpStrip.clippedEnd ? " is-clipped-end" : "")}
              style={{ left: cmpStrip.leftPct + "%", width: cmpStrip.widthPct + "%" }}
              aria-hidden="true"
            >
              {cmpStrip.segments.map((seg, i) => (
                <span
                  key={seg.kind + "-" + i}
                  className={"lp-widget-minigantt-cmpseg is-" + seg.kind}
                  style={{
                    left: seg.leftPct + "%",
                    width: seg.widthPct + "%",
                    background: miniGanttComparisonZonePattern(seg.kind),
                  }}
                />
              ))}
            </span>
          )}
          {/* La durée initiale, cerclée par-dessus les trames. Rendue À CÔTÉ du
              ruban et non dedans : les deux anneaux partagent alors la même
              géométrie et se superposent, au lieu d'accoler leurs deux traits. */}
          {cmpStrip && cmpStrip.reference && (
            <span
              className={"lp-widget-minigantt-cmpref"
                + (cmpStrip.reference.clippedStart ? " is-clipped-start" : "")
                + (cmpStrip.reference.clippedEnd ? " is-clipped-end" : "")}
              style={{ left: cmpStrip.reference.leftPct + "%", width: cmpStrip.reference.widthPct + "%" }}
              aria-hidden="true"
            />
          )}
          <div className={"lp-widget-minigantt-bar" + (cmp ? " is-compared" : "")} style={{ left: left + "%", width: width + "%", background: `linear-gradient(${paleBg}, ${paleBg}), var(--surface)` }}>
            {/* Progression visuelle : portion remplie de la couleur pleine du
                statut/projet/type, sur fond pâle de la même couleur pour le
                reste de la durée — cohérent avec le diagramme du Mini Gantt. */}
            <div className="lp-widget-minigantt-bar-fill" style={{ width: `${pct}%`, background: barColor }} />
            {onUpdateTask && (
              <>
                <div
                  className="lp-widget-minigantt-handle left" title="Glisser pour changer la date de début"
                  {...handleHoverGuard}
                  onMouseDown={(e) => startBarDrag(e, t, "start", e.currentTarget.closest(".lp-widget-minigantt-track"))}
                  onTouchStart={(e) => startBarDrag(e, t, "start", e.currentTarget.closest(".lp-widget-minigantt-track"))}
                />
                <div
                  className="lp-widget-minigantt-handle right" title="Glisser pour changer la date de fin"
                  {...handleHoverGuard}
                  onMouseDown={(e) => startBarDrag(e, t, "end", e.currentTarget.closest(".lp-widget-minigantt-track"))}
                  onTouchStart={(e) => startBarDrag(e, t, "end", e.currentTarget.closest(".lp-widget-minigantt-track"))}
                />
                {/* À 100 %, la poignée devient une pastille de validation :
                    la barre pleine se lit alors d'un coup d'œil, sans avoir à
                    comparer le rond à l'extrémité de la barre. Elle reste une
                    poignée — c'est par elle qu'on revient en arrière. */}
                <div
                  className={"lp-widget-minigantt-progress-handle" + (pct >= 100 ? " is-done" : "")}
                  style={{ left: `${pct}%` }}
                  {...handleHoverGuard}
                  title={pct >= 100 ? "Avancement à 100 % — glisser pour revenir en arrière" : `Glisser pour changer l'avancement (${pct}%)`}
                  onMouseDown={(e) => startBarDrag(e, t, "progress", e.currentTarget.closest(".lp-widget-minigantt-bar"))}
                  onTouchStart={(e) => startBarDrag(e, t, "progress", e.currentTarget.closest(".lp-widget-minigantt-bar"))}
                >
                  {pct >= 100 && <Check size={8} strokeWidth={4} aria-hidden="true" />}
                </div>
              </>
            )}
          </div>
          {cmpBars && cmpZoneLabel(cmpBars.freed, "freed", cmp.endDeltaDays)}
          {cmpBars && cmpZoneLabel(cmpBars.ahead, "ahead", cmp.startDeltaDays)}
          {cmpBars && cmpZoneLabel(cmpBars.late, "late", cmp.endDeltaDays)}
          <RowRisks taskId={t.id} />
          {fieldsLayout === "inline" && <RowFields t={t} anchorPct={left + width} />}
        </div>
        {fieldsLayout === "aligned" && <RowFields t={t} />}
      </div>
    );
  };

  const MilestoneRow = (t) => {
    if (bubbleMode) return BubbleMilestoneRow(t);
    const proj = ctx.projects.find((p) => p.id === t.projectId);
    const st = ctx.statuses.find((s) => s.id === t.statusId);
    const tt = (ctx.taskTypes || []).find((x) => x.id === t.taskTypeId);
    const milestoneIdx = dayIndex(t.end);
    if (milestoneIdx < minIdx || milestoneIdx > maxIdx) return null;
    const posIdxPct = ((milestoneIdx - minIdx) / span) * 100;
    const posPct = `${posIdxPct}%`;
    const customMsIcon = resolveMilestoneIcon(t, ctx);
    // Jalon comparé : un losange fantôme gris à la date de référence, le jalon
    // actuel inchangé, et un segment fin entre les deux. Aucune durée n'est
    // fabriquée — un jalon n'en a pas.
    const cmp = comparisonByTask.get(t.id) || null;
    const cmpMs = cmp ? miniGanttComparisonMilestone(cmp, { minIdx, maxIdx, span }) : null;
    const cmpMsColor = cmp ? miniGanttComparisonToneColor(cmp.endTone) : null;
    const dragHandlers = onUpdateTask ? {
      onMouseDown: (e) => startBarDrag(e, t, "move-milestone", e.currentTarget.closest(".lp-widget-minigantt-track")),
      onTouchStart: (e) => startBarDrag(e, t, "move-milestone", e.currentTarget.closest(".lp-widget-minigantt-track")),
    } : {};
    return (
      <div
        className={"lp-widget-minigantt-row lp-widget-minigantt-row-milestone" + (selectedSet.has(t.id) ? " is-selected" : "")}
        key={t.id}
        ref={(el) => { if (el) rowNodes.current[t.id] = el; else delete rowNodes.current[t.id]; }}
        onClick={openTaskUnlessDragged(t)}
        onMouseEnter={(e) => openTip(t, e)}
        onMouseMove={(e) => openTip(t, e)}
        onMouseLeave={() => setHover(null)}
      >
        <RowLabel t={t} proj={proj} />
        <div className="lp-widget-minigantt-track">
          {cmpMs && cmpMs.link && (
            <span
              className="lp-widget-minigantt-ms-link"
              style={{ left: cmpMs.link.leftPct + "%", width: cmpMs.link.widthPct + "%", borderTopColor: cmpMsColor }}
              aria-hidden="true"
            />
          )}
          {cmpMs && cmpMs.referenceVisible && (
            <span
              className="lp-widget-minigantt-ms-ghost"
              style={{ left: cmpMs.referenceLeftPct + "%", borderColor: MINIGANTT_COMPARISON_REF_COLOR }}
              aria-hidden="true"
            />
          )}
          {cmpMs && cmpMs.link && miniGanttComparisonLabelVisible(cmpMs.link, { trackPx: comparisonTrackPx, todayPct: comparisonTodayPct }) && (
            <span
              className="lp-widget-minigantt-cmplabel is-milestone"
              style={{ left: (cmpMs.link.leftPct + cmpMs.link.widthPct / 2) + "%", transform: "translate(-50%, -50%)", color: cmpMsColor }}
              aria-hidden="true"
            >
              {miniGanttComparisonDeltaLabel(cmp.endDeltaDays)}
            </span>
          )}
          {customMsIcon ? (
            <span className="lp-widget-minigantt-milestone-icon" style={{ left: posPct }} title="Glisser pour changer la date du jalon" {...dragHandlers}><IconGlyph icon={customMsIcon} size={13} /></span>
          ) : (
            <span className="lp-widget-minigantt-milestone" style={{ left: posPct, background: (colorBy === "project" ? proj?.color : colorBy === "taskType" ? tt?.color : st?.color) || proj?.color || st?.color || "var(--text-muted)" }} title="Glisser pour changer la date du jalon" {...dragHandlers} />
          )}
          {fieldsLayout === "inline" && <RowFields t={t} anchorPct={posIdxPct} />}
        </div>
        {fieldsLayout === "aligned" && <RowFields t={t} />}
      </div>
    );
  };

  const Tooltip = () => {
    if (!hover) return null;
    // Aucune infobulle persistante : elle n'existe que tant que `hover` est
    // posé, et `onMouseLeave` le vide. Le mode Comparaison ne fait qu'ajouter
    // des lignes à celle qui existe déjà.
    const hoverCmp = comparisonByTask.get(hover.t.id) || null;
    const cmpLines = hoverCmp ? miniGanttComparisonTooltipLines(hoverCmp, fmtShort) : [];
    const tipW = hoverCmp ? 236 : 190;
    const tipFields = bubbleMode ? rowFields.length : 0;
    // Deux pastilles par ligne environ, plus le filet de séparation : sans ce
    // supplément, une infobulle ouverte en bas d'écran se retournerait trop tard
    // et sortirait de la fenêtre.
    const tipH = (hover.t.milestone ? 54 : 62) + cmpLines.length * 15
      + (tipFields ? 12 + Math.ceil(tipFields / 2) * 17 : 0);
    const gap = 8;
    const viewportW = window.innerWidth || document.documentElement.clientWidth || 1024;
    const viewportH = window.innerHeight || document.documentElement.clientHeight || 768;
    let left = hover.x + gap;
    let top = hover.y + gap;
    if (left + tipW + 8 > viewportW) left = hover.x - tipW - gap;
    if (top + tipH + 8 > viewportH) top = hover.y - tipH - gap;
    left = Math.max(8, left);
    top = Math.max(8, top);

    const node = (
      <div className="lp-pie-tooltip lp-widget-metro-tooltip" style={{ position: "fixed", left, top, zIndex: 100000, maxWidth: tipW, pointerEvents: "none" }}>
        <div className="lp-widget-metro-tooltip-head">
          <span className="lp-widget-metro-tooltip-dot" style={{ background: ctx.statuses.find((s) => s.id === hover.t.statusId)?.color || ctx.projects.find((p) => p.id === hover.t.projectId)?.color || "var(--text-muted)" }} />
          <span className="lp-widget-metro-tooltip-title">{hover.t.title}</span>
        </div>
        <div className="lp-widget-metro-tooltip-meta">
          {hover.t.milestone ? fmtShort(hover.t.end) : <>{fmtShort(hover.t.start)} → {fmtShort(hover.t.end)}</>}
          {multiProject && ctx.projects.find((p) => p.id === hover.t.projectId) && ` · ${ctx.projects.find((p) => p.id === hover.t.projectId).name}`}
          {ctx.statuses.find((s) => s.id === hover.t.statusId) && ` · ${ctx.statuses.find((s) => s.id === hover.t.statusId).name}`}
        </div>
        {!hover.t.milestone && (
          <div className="lp-widget-metro-tooltip-bar">
            <div className="lp-widget-metro-tooltip-bar-fill" style={{ width: `${Math.max(0, Math.min(100, hover.t.progress || 0))}%` }} />
          </div>
        )}
        {cmpLines.length > 0 && (
          <div className="lp-widget-minigantt-tooltip-cmp">
            {cmpLines.map((line) => (
              <div key={line.key} className="lp-widget-minigantt-tooltip-cmp-line">
                <span className="lp-widget-minigantt-tooltip-cmp-label">{line.label}</span>
                <span
                  className="lp-widget-minigantt-tooltip-cmp-value"
                  style={line.tone ? { color: miniGanttComparisonToneColor(line.tone), fontWeight: 800 } : undefined}
                >
                  {line.value}
                </span>
              </div>
            ))}
          </div>
        )}
        {/* Les champs choisis, en entier (#122). Le bandeau sous la bulle tient
            sur une ligne et coupe ce qui dépasse : c'est ici que la liste
            complète se lit, sans coûter de hauteur au diagramme. Les valeurs
            restent celles de `FieldValue`, comme partout ailleurs. */}
        {bubbleMode && rowFields.length > 0 && (
          <div className="lp-widget-minigantt-tooltip-fields">
            {rowFields.map((f) => (
              <FieldValue key={f} fieldKey={f} task={hover.t} ctx={ctx} />
            ))}
          </div>
        )}
        {(risksByTask.get(hover.t.id) || []).map((seg) => (
          <div key={seg.id} className="lp-widget-minigantt-tooltip-risk">
            <span className="lp-widget-minigantt-legend-mark" style={{ background: seg.color, borderColor: seg.color }} />
            {seg.title || "Risque"} — {MINIGANTT_RISK_SEVERITY_LABELS[seg.severity]} · +{seg.endIdx - seg.startIdx} j
          </div>
        ))}
      </div>
    );
    return createPortal(node, document.body);
  };

  // Un bloc temporel est UNE bande continue sur toute la hauteur utile, en
  // arrière-plan de toutes les lignes — en-têtes de groupe et espaces entre
  // groupes compris. Le rendre dans la grille de fond le découpait en autant de
  // morceaux que de groupes, avec une bande blanche à chaque en-tête.
  // Les lignes portent z-index 1 : la bande reste donc sous les barres et les
  // jalons sans avoir à s'insérer dans chaque piste.
  const phaseLaneCount = temporalBlockShapes.length
    ? Math.max(...temporalBlockShapes.map((shape) => shape.lane)) + 1
    : 0;

  // Titre du bloc : une bande propre placée sous le contexte de dates et
  // au-dessus des lignes, plutôt qu'une étiquette verticale posée sur les
  // barres. Les proportions reprennent exactement celles d'une ligne
  // (étiquette 26 %, gouttière 6 px, colonne de champs fixe) pour rester
  // alignées sur la piste.
  const phasesHeader = !temporalBlockShapes.length ? null : (
    <div className="lp-widget-minigantt-phases" style={{ height: phaseLaneCount * MINIGANTT_PHASE_LANE_H - 3 }}>
      <span className="lp-widget-minigantt-phases-spacer" />
      <div className="lp-widget-minigantt-phases-track">
        {temporalBlockShapes.map((shape) => (
          <button
            key={shape.block.id}
            type="button"
            className={"lp-widget-minigantt-phase" + (shape.block.kind === "decision" ? " is-decision" : "") + (shape.block.meta ? " is-meta" : "")}
            data-block-id={shape.block.id}
            ref={(el) => { if (el) phaseLabelNodes.current[shape.block.id] = el; else delete phaseLabelNodes.current[shape.block.id]; }}
            style={{
              left: `${shape.labelCenterPct}%`,
              transform: "translateX(-50%)",
              maxWidth: "100%",
              top: shape.lane * MINIGANTT_PHASE_LANE_H,
              color: shape.block.color,
              borderColor: shape.block.color,
              // « Continue » doit vraiment donner du continu : la pastille du
              // titre imposait ses pointillés (décision) ou ses points (méta
              // bloc) par la feuille de style, quel que soit le réglage du bloc.
              borderStyle: shape.block.borderStyle,
              background: "color-mix(in srgb, " + shape.block.color + " 16%, var(--surface))",
            }}
            title={shape.block.meta
              ? `${shape.block.title} · ${fmtShort(shape.block.startDate)} → ${fmtShort(shape.block.endDate)} — méta bloc, réglable ${shape.block.id.startsWith("meta:" + TASK_META_BLOCK_ID_PREFIX) ? "dans la fiche de la tâche" : "dans Réglages > Méta blocs temporels"}`
              : `${shape.block.title} · ${fmtShort(shape.block.startDate)} → ${fmtShort(shape.block.endDate)} — cliquer pour modifier`}
            onClick={() => { if (!shape.block.meta) setAnnotationPanel({ section: "blocks", focusId: shape.block.id }); }}
          >
            <span className="lp-widget-minigantt-phase-text">{shape.block.title}</span>
          </button>
        ))}
      </div>
      {fieldsColumnShown && <span className="lp-widget-minigantt-phases-fields" style={{ width: FIELDS_COL_WIDTH }} />}
    </div>
  );

  // Jalons de configuration et annotations : une bande dédiée sous les titres
  // de bloc, avec le même placement en lignes que ces derniers.
  const stripHeader = !stripShapes.length ? null : (
    <div className="lp-widget-minigantt-strip" style={{ height: stripLaneCount * MINIGANTT_STRIP_LANE_H }}>
      <span className="lp-widget-minigantt-phases-spacer" />
      <div className="lp-widget-minigantt-strip-track" ref={stripTrackRef}>
        {stripShapes.map((item) => (
          <span
            key={item.kind + "-" + item.id}
            className={"lp-widget-minigantt-marker is-" + item.kind + (item.type ? " type-" + item.type : "")}
            style={{ left: `${item.leftPct}%`, top: item.lane * MINIGANTT_STRIP_LANE_H }}
          >
            <MilestoneSymbol
              symbol={item.kind === "note" ? "ring" : milestoneTypeFor(milestoneTypes, item.type).symbol}
              color={item.color}
              size={9}
            />
            <button
              type="button"
              className="lp-widget-minigantt-marker-label"
              style={{ color: item.color }}
              title={item.kind === "note"
                ? `${item.data.title}${item.data.text ? " — " + item.data.text : ""}`
                : `${item.data.title} · ${fmtShort(item.data.date)} · ${milestoneTypeFor(milestoneTypes, item.type).name}`}
              onClick={() => editable && setAnnotationPanel({ section: item.kind === "note" ? "notes" : "milestones", focusId: item.id })}
            >
              {item.label}
            </button>
          </span>
        ))}
      </div>
      {fieldsColumnShown && <span className="lp-widget-minigantt-phases-fields" style={{ width: FIELDS_COL_WIDTH }} />}
    </div>
  );

  /* Le bloc temporel se dessine en DEUX couches, et non plus en une.

     Le remplissage doit rester DERRIÈRE les barres — c'est une teinte de fond,
     elle situe, elle ne masque pas. Le cadre, lui, doit passer DEVANT tout :
     posé avec le remplissage, il était recouvert par la moindre barre qui le
     traversait, et « Continue » ne donnait jamais un trait continu à l'œil
     (retour de test). Séparer les deux est la seule façon d'avoir un vrai
     cadre sans rendre la teinte opaque.

     Les deux couches partagent exactement la même géométrie : même gouttière,
     même réserve de champs, mêmes bornes. */
  /* La hauteur comprend le DÉBORD de la dernière ligne (#113). Le pied de
     réserve a été ajouté sous les lignes pour que leur habillage ne soit plus
     tranché ; les blocs temporels, eux, sont une bande continue posée en couche
     absolue, calculée sur les seules boîtes de lignes. Ils s'arrêtaient donc où
     s'arrêtaient les lignes, et non où s'arrête désormais le diagramme — un
     bloc qui court sur toute la hauteur laissait voir du vide sous lui (retour
     de test). `rowsTail` est la mesure, pas une marge inventée : elle vaut zéro
     quand rien ne déborde, et la couche retrouve alors exactement sa hauteur
     d'avant. */
  const bandGeometry = !rowsBand ? null : {
    ...layerInsets,
    top: rowsBand.top,
    height: rowsBand.height + rowsTail,
  };

  const bandLayer = (!bandGeometry || !temporalBlockShapes.length) ? null : (
    <div className="lp-widget-minigantt-band-layer" style={bandGeometry}>
      {temporalBlockShapes.map((shape) => (
        <span
          key={shape.block.id}
          data-block-id={shape.block.id}
          className="lp-widget-minigantt-tblock"
          style={{
            left: `${shape.leftPct}%`,
            width: `${shape.widthPct}%`,
            background: ganttBlockFill(shape.block),
          }}
        />
      ))}
    </div>
  );

  const bandFrameLayer = (!bandGeometry || !temporalBlockShapes.length) ? null : (
    <div className="lp-widget-minigantt-band-frames" style={bandGeometry}>
      {temporalBlockShapes.map((shape) => (
        <span
          key={shape.block.id}
          data-block-frame-id={shape.block.id}
          className="lp-widget-minigantt-tblock-frame"
          style={{
            left: `${shape.leftPct}%`,
            width: `${shape.widthPct}%`,
            border: ganttBlockBorder(shape.block),
          }}
        />
      ))}
    </div>
  );

  /* Trait vertical d'un jalon — le choix appartient au JALON (#95).

     Il PROLONGE le losange : la couche part du sommet de la bande de repères,
     et chaque trait démarre au couloir de SON repère, exactement comme la vue
     Métro le fait déjà. Il descend jusqu'au bas des lignes, en z-index 0 comme
     le remplissage d'un bloc temporel : derrière les barres, derrière les
     textes, derrière le losange dont il part.

     Aucun jalon coché, aucune couche : le rendu ne bouge pas d'un pixel. */
  const ruleShapes = stripShapes.filter((item) => item.kind === "milestone" && item.rule);
  const ruleTop = stripTop != null && stripTop < (bandGeometry ? bandGeometry.top : 0)
    ? stripTop
    : (bandGeometry ? bandGeometry.top : 0);
  const milestoneRuleLayer = (!bandGeometry || !ruleShapes.length) ? null : (
    <div
      className="lp-widget-minigantt-rule-layer"
      style={{ ...layerInsets, top: ruleTop, height: Math.max(0, bandGeometry.top + bandGeometry.height - ruleTop) }}
    >
      {ruleShapes.map((item) => (
        <span
          key={"rule-" + item.id}
          className="lp-widget-minigantt-rule"
          style={{
            left: `${item.leftPct}%`,
            // Départ au losange de CE repère : son couloir dans la bande, puis
            // le milieu du losange. Sans bande mesurée, le trait reprend la
            // hauteur des lignes, comme avant.
            top: stripTop != null && ruleTop === stripTop
              ? item.lane * MINIGANTT_STRIP_LANE_H + MINIGANTT_STRIP_GLYPH_MID
              : 0,
            borderLeftColor: item.color,
            // Épaisseur propre au jalon, comme sa couleur (#95).
            borderLeftWidth: item.ruleThickness,
          }}
        />
      ))}
    </div>
  );


  const bubbleSpanLane = (!bubbleMode || !bubbleSpanRows.length) ? null : (
    <div className="lp-widget-minigantt-rows lp-bubble-annot-rows">
        {bubbleSpanRows.map(({ annot, leftPct, widthPct }) => (
          <div className="lp-widget-minigantt-row lp-bubble-annot-row" key={"annot-" + annot.id}>
            <div className="lp-widget-minigantt-track">
              <span
                className="lp-widget-minigantt-span"
                style={{ left: `${leftPct}%`, width: `${widthPct}%`, top: "50%", opacity: annot.opacity / 100 }}
              >
                <SpanCapGlyph cap={annot.capStart} side="start" color={annot.color} />
                <span
                  className="lp-widget-minigantt-span-line"
                  style={{ borderTopWidth: annot.thickness, borderTopStyle: annot.borderStyle, borderTopColor: annot.color }}
                />
                <SpanCapGlyph cap={annot.capEnd} side="end" color={annot.color} />
                {annot.label && (
                  <button
                    type="button"
                    className="lp-widget-minigantt-span-label"
                    style={{ color: annot.color }}
                    title={`${annot.label} · ${fmtShort(annot.startDate)} → ${fmtShort(annot.endDate)}`}
                    onClick={() => editable && setAnnotationPanel({ section: "spans", focusId: annot.id })}
                  >
                    {annot.label}
                  </button>
                )}
              </span>
            </div>
          </div>
      ))}
    </div>
  );

  /* Annotations horizontales : au-dessus des barres, comme les cadres — un
     trait posé DERRIÈRE la barre de sa propre ligne serait invisible. Le
     calque ne capte pas le pointeur, seule l'étiquette est cliquable.

     En mode bulles, ce calque ne sert plus : les traits vivent dans leur propre
     couloir (`bubbleSpanLane`), et les y laisser AUSSI les ferait passer au
     travers des bulles. */
  const spanLayer = (bubbleMode || !rowsBand || !spanShapes.length) ? null : (
    <div
      className="lp-widget-minigantt-span-layer"
      style={{ ...layerInsets, top: 0, bottom: 0 }}
    >
      {spanShapes.map(({ annot, y, leftPct, widthPct }) => (
        <span
          key={"span-" + annot.id}
          className="lp-widget-minigantt-span"
          style={{ left: `${leftPct}%`, width: `${widthPct}%`, top: y, opacity: annot.opacity / 100 }}
        >
          <SpanCapGlyph cap={annot.capStart} side="start" color={annot.color} />
          <span
            className="lp-widget-minigantt-span-line"
            style={{ borderTopWidth: annot.thickness, borderTopStyle: annot.borderStyle, borderTopColor: annot.color }}
          />
          <SpanCapGlyph cap={annot.capEnd} side="end" color={annot.color} />
          {annot.label && (
            <button
              type="button"
              className="lp-widget-minigantt-span-label"
              style={{ color: annot.color }}
              title={`${annot.label} · ${fmtShort(annot.startDate)} → ${fmtShort(annot.endDate)}`}
              onClick={() => editable && setAnnotationPanel({ section: "spans", focusId: annot.id })}
            >
              {annot.label}
            </button>
          )}
        </span>
      ))}
    </div>
  );

  /* Macro-bulles, en DEUX couches comme un bloc temporel : le remplissage
     derrière les bulles (il situe, il ne masque pas), le cadre et son libellé
     devant. Posé avec le remplissage, le cadre serait recouvert par la moindre
     bulle qui le traverse, et « bordure continue » ne donnerait pas un trait
     continu à l'œil. */
  const bubbleMacroGeometry = (seg) => {
    const from = Math.max(minIdx, Math.min(maxIdx, seg.startIdx));
    const to = Math.max(minIdx, Math.min(maxIdx, seg.endIdx));
    const leftPct = ((from - minIdx) / span) * 100;
    const widthPct = Math.max(1, ((to - from) / span) * 100);
    const inset = seg.padding;
    return {
      leftPct, widthPct, inset,
      left: `calc(${leftPct}% - ${inset}px)`,
      width: `calc(${widthPct}% + ${inset * 2}px)`,
    };
  };

  const bubbleMacroLayer = !bubbleMacroShapes.length ? null : (
    <div className="lp-bubble-macro-layer" style={{ ...layerInsets, top: 0, bottom: 0 }}>
      {bubbleMacroShapes.map((seg) => {
        const g = bubbleMacroGeometry(seg);
        return (
          <span
            key={"macro-fill-" + seg.key}
            className="lp-bubble-macro"
            style={{ left: g.left, width: g.width, top: seg.top, height: seg.height, background: bubbleMacroFill(seg.macro) }}
          />
        );
      })}
    </div>
  );

  const bubbleMacroFrameLayer = !bubbleMacroShapes.length ? null : (
    <div className="lp-bubble-macro-frames" style={{ ...layerInsets, top: 0, bottom: 0 }}>
      {bubbleMacroShapes.map((seg) => {
        const g = bubbleMacroGeometry(seg);
        const pct = bubbleMacroPct(seg);
        return (
          <React.Fragment key={"macro-" + seg.key}>
            <span
              className="lp-bubble-macro-frame"
              style={{ left: g.left, width: g.width, top: seg.top, height: seg.height, border: bubbleMacroBorder(seg.macro) }}
            />
            {/* Libellé centré sur l'enveloppe PAR LE NAVIGATEUR
                (translateX(-50%) en feuille de style) : un centrage calculé en
                pixels resterait périmé jusqu'au chargement de la police. */}
            <span
              className="lp-bubble-macro-label"
              style={{
                left: (g.leftPct + g.widthPct / 2) + "%",
                top: Math.max(0, seg.top - 9) + (seg.labelOffset || 0),
                background: seg.macro.color,
              }}
              title={`${seg.macro.label}${pct === null ? "" : ` — avancement agrégé ${pct} %`}`}
            >
              {seg.macro.label}
            </span>
            {pct !== null && (
              <>
                <span
                  className="lp-bubble-macro-progress"
                  style={{ left: g.left, width: g.width, top: seg.top + seg.height - 5 }}
                >
                  <span className="lp-bubble-macro-progress-fill" style={{ width: pct + "%", background: seg.macro.color }} />
                </span>
                <span
                  className="lp-bubble-macro-progress-label"
                  style={{ left: `calc(${g.leftPct + g.widthPct}% + ${seg.padding + 3}px)`, top: seg.top + seg.height - 9, color: seg.macro.color }}
                >
                  {pct}%
                </span>
              </>
            )}
          </React.Fragment>
        );
      })}
    </div>
  );

  /* Légende du champ qui colore. Elle ne redit pas ce que le diagramme montre
     déjà — elle NOMME les couleurs, ce qu'aucune bulle ne peut faire seule dès
     que l'on colore par responsable ou par période. Cliquer un rang met son
     groupe en avant ; recliquer relâche. */
  const bubbleLegendBar = (!bubbleMode || !bubbleCfg.bubbleShowLegend || !bubbleLegend.length) ? null : (
    <div className="lp-bubble-legend">
      {bubbleLegend.map((entry) => (
        <button
          key={entry.key}
          type="button"
          className={"lp-bubble-legend-item" + (bubbleHighlight && bubbleHighlight !== entry.key ? " is-dimmed" : "")}
          title={`${entry.label} — ${entry.count} tâche${entry.count > 1 ? "s" : ""}${bubbleHighlight === entry.key ? " (mise en avant : cliquer pour relâcher)" : ""}`}
          onClick={() => setBubbleHighlight((cur) => (cur === entry.key ? null : entry.key))}
        >
          <span className="lp-bubble-legend-mark" style={{ background: entry.color }} />
          <span className="lp-bubble-legend-label">{entry.label}</span>
        </button>
      ))}
    </div>
  );

  // Étiquettes de blocs et cadres : une seule couche au-dessus des lignes,
  // sur la même bande horizontale que la grille de fond. Ce sont des variables
  // et non des composants définis ici : un composant recréé à chaque rendu
  // remonterait l'éditeur et lui ferait perdre son état de saisie.
  const annotationLayer = (!rowsBand || !frameShapes.length) ? null : (
    <div
      className="lp-widget-minigantt-annot-layer"
      style={layerInsets}
    >
      {frameShapes.map((seg) => {
        const from = Math.max(minIdx, Math.min(maxIdx, seg.startIdx));
        const to = Math.max(minIdx, Math.min(maxIdx, seg.endIdx));
        const leftPct = ((from - minIdx) / span) * 100;
        // Le plancher doit être celui de la BARRE (voir Row : Math.max(2, …)),
        // pas un plancher plus bas : sur une tâche d'un jour, la barre était
        // tracée à 2 % et le cadre à 1,2 %, si bien que le cadre passait au
        // milieu de la barre au lieu de l'entourer.
        const widthPct = Math.max(2, ((to - from) / span) * 100);
        // Dégagement en pixels de chaque côté, en plus du padding du cadre :
        // le trait ne doit jamais se poser sur la barre.
        const frameInsetPx = seg.padding + GANTT_FRAME_BAR_CLEARANCE;
        // Étiquette juste au-dessus du cadre, ou dans sa partie supérieure
        // gauche quand il n'y a pas la place sans mordre sur l'axe.
        const labelTop = (seg.top >= rowsBand.top + 12 ? seg.top - 11 : seg.top + 1) + (seg.labelOffset || 0);
        return (
          <React.Fragment key={seg.key}>
            <div
              className="lp-widget-minigantt-frame"
              style={{
                left: `calc(${leftPct}% - ${frameInsetPx}px)`,
                width: `calc(${widthPct}% + ${frameInsetPx * 2}px)`,
                top: seg.top,
                height: seg.height,
                border: `1.5px ${seg.frame.borderStyle} ${seg.frame.color}`,
              }}
            />
            {miniGanttFrameCornerIcon(seg.frame, tasksById.get(seg.frame.autoTaskId)) && (
              <img
                src={miniGanttFrameCornerIcon(seg.frame, tasksById.get(seg.frame.autoTaskId))}
                alt=""
                className="lp-widget-minigantt-frame-corner"
                referrerPolicy="no-referrer"
                style={{
                  left: `calc(${leftPct}% + ${widthPct}% + ${frameInsetPx}px)`,
                  top: seg.top,
                }}
              />
            )}
            {/* Un encadré posé par la coche n'a NI étiquette NI icône de
                gauche depuis le retour de Quentin sur #48 : rien ne se peint
                donc ici, et sa seule marque est la pastille du coin ci-dessus.
                Le `|| iconUrl` reste pour un encadré auquel on aurait donné une
                icône à la main — sans lui, elle ne serait jamais rendue. */}
            {(seg.frame.label || seg.frame.iconUrl) && (
              <button
                type="button"
                className="lp-widget-minigantt-frame-label"
                style={{ left: `calc(${leftPct}% - ${frameInsetPx}px)`, top: labelTop, background: seg.frame.color }}
                title={`${seg.frame.label || "Encadré"} — cliquer pour modifier`}
                onClick={() => setAnnotationPanel({ section: "frames", focusId: seg.frame.id })}
              >
                {seg.frame.iconUrl
                  ? <img src={seg.frame.iconUrl} alt="" className="lp-widget-minigantt-frame-icon" referrerPolicy="no-referrer" />
                  : seg.frame.label}
              </button>
            )}
          </React.Fragment>
        );
      })}
    </div>
  );

  const annotationModal = !annotationPanel ? null : createPortal(
    <Modal
      title="Annotations du Mini-Gantt"
      onClose={() => setAnnotationPanel(null)}
      wide
      footer={<button className="lp-btn lp-btn-primary" onClick={() => setAnnotationPanel(null)}>Terminé</button>}
    >
      <MiniGanttAnnotationsEditor
        blocks={rawTemporalBlocks}
        frames={rawHighlightFrames}
        milestones={rawMilestones}
        risks={rawRisks}
        notes={rawNotes}
        spans={rawSpans}
        allowSpans
        tasks={editorTasks}
        ctx={ctx}
        defaultStart={minDateStr}
        defaultEnd={maxDateStr}
        onChange={applyAnnotations}
        initialSection={annotationPanel.section}
        autoCreate={annotationPanel.autoCreate}
        focusId={annotationPanel.focusId}
      />
    </Modal>,
    document.body
  );

  /* Classe racine : le mode bulles y ajoute sa bascule de largeur d'étiquette
     et sa hauteur de bulle. Rien d'autre ne change dans la mise en page. */
  const rootClass = "lp-widget-minigantt"
    + (bubbleMode ? " is-bubbles size-" + bubbleCfg.bubbleSize : "")
    + (bubbleMode && !bubbleCfg.bubbleTruncateTitles ? " is-title-full" : "");
  /* Hauteur de bulle et nombre de lignes de description : posés en variables
     CSS sur la racine, depuis `bubbleHeightPx` — la même fonction que celle
     dont l'auto-dimensionnement du widget se sert. */
  const rootStyle = bubbleMode
    ? {
        position: "relative",
        "--lp-bubble-h": bubbleHeightPx(widget, titleExtraPx) + "px",
        "--lp-bubble-desc-lines": bubbleCfg.bubbleDescriptionLines,
      }
    /* La colonne d'étiquettes est posée en PIXELS dès qu'elle est mesurée :
       étiquettes, cale de l'axe, cale des bandes de repères et retrait des
       couches lisent tous cette même variable, et ne peuvent donc pas se
       désaligner. Tant qu'elle vaut `null`, la feuille de style garde ses
       26 %. Le mode bulles, lui, la met à zéro par sa classe — on n'y touche
       pas. */
    : { position: "relative", ...(labelColWidth === null ? null : { "--mg-label-w": labelColWidth + "px" }) };

  /* Pied de réserve : exactement le débord mesuré de la dernière ligne, et
     rien quand elle ne déborde pas. Le widget coupe à son bord
     (`overflow:hidden`), et la dernière ligne s'y trouvait à fleur : son rail
     de comparaison, ses couloirs de risque et leurs étiquettes étaient
     tranchés (retour de test). Les lignes précédentes, elles, débordent dans
     l'interligne de la suivante — il n'y a donc rien à réserver ailleurs. */
  const rowsTailSpacer = rowsTail > 0
    ? <span className="lp-widget-minigantt-rows-tail" style={{ height: rowsTail }} aria-hidden="true" />
    : null;

  /* Le silence était la moitié du défaut de #115 : une tâche absente du
     diagramme ne se distingue pas d'une tâche qu'aucun filtre ne retient. Ce
     pied dit combien il en manque, et pourquoi. Dans la vue plein écran il n'y
     a plus de plafond : ce qui reste ne peut venir que d'une date manquante. */
  const hiddenNote = hiddenCount > 0
    ? (
      <div className="lp-widget-minigantt-hidden-note">
        {hiddenCount} tâche{hiddenCount > 1 ? "s" : ""} {hiddenCount > 1 ? "ne sont pas affichées" : "n'est pas affichée"}
        {showAllRows
          ? " : il leur manque une date de début ou de fin."
          : ` : ce widget montre au plus ${MINIGANTT_WIDGET_MAX_BARS} barres et ${MINIGANTT_WIDGET_MAX_MILESTONES} jalons, et une tâche sans date de début ou de fin n'a pas de barre. La vue Gantt les affiche toutes.`}
      </div>
    )
    : null;

  if (!groupBy || groupBy === "none") {
    return (
      <div className={rootClass} style={rootStyle} ref={rootRef}>
        {viewToolbar}
        {bandLayer}
        {milestoneRuleLayer}
        {bubbleMacroLayer}
        {toolbar}
        <Axis />
        {phasesHeader}
        {stripHeader}
        {bubbleSpanLane}
        <div className="lp-widget-minigantt-rows">
          <GridOverlay />
          {renderRows(orderedTasks)}
        </div>
        {rowsTailSpacer}
        {hiddenNote}
        {bandFrameLayer}
        {annotationLayer}
        {spanLayer}
        {bubbleMacroFrameLayer}
        {bubbleLegendBar}
        <Tooltip />
        {annotationModal}
      </div>
    );
  }

  const groups = macroOrderedGroups;
  // Fond d'un groupe : une teinte très diluée de la couleur du champ de
  // regroupement — projet, statut… — pour remplacer les larges aplats blancs
  // qui séparaient les groupes. Un champ sans couleur propre (responsable,
  // date…) retombe sur la couleur d'accentuation de l'application.
  //
  // Le fond d'un bloc non positionné se peint AVANT les descendants
  // positionnés : la teinte reste donc sous la bande des blocs temporels
  // (couche absolue) et sous les lignes (z-index 1). Rien de ce qui compte —
  // barres, jalons, progression, couloirs de risque — ne perd en contraste.
  const groupTint = (color) => {
    const base = color && color !== "var(--text-muted)" ? color : "var(--accent)";
    return `color-mix(in srgb, ${base} 7%, transparent)`;
  };
  return (
    <div className={rootClass + " lp-widget-minigantt-grouped"} style={rootStyle} ref={rootRef}>
      {viewToolbar}
      {bandLayer}
      {milestoneRuleLayer}
      {bubbleMacroLayer}
      {toolbar}
      <Axis />
      {phasesHeader}
      {stripHeader}
      {bubbleSpanLane}
      {groups.map((g) => {
        const isCollapsed = !!collapsed[g.key];
        return (
          <div className="lp-widget-minigantt-group" key={g.key} style={{ background: groupTint(g.color) }}>
            <div className="lp-widget-minigantt-group-head" onClick={() => toggleGroup(g.key)} style={{ cursor: "pointer" }}>
              <ChevronRight size={11} className="lp-widget-group-chevron" style={{ transform: isCollapsed ? "rotate(0deg)" : "rotate(90deg)" }} />
              <span className="lp-widget-minigantt-group-dot" style={{ background: g.color || "var(--text-muted)" }} />
              <span className="lp-widget-minigantt-group-label">{g.label}</span>
              <span className="lp-widget-minigantt-group-count">{g.tasks.length}</span>
            </div>
            {!isCollapsed && (
              <div className="lp-widget-minigantt-rows">
                <GridOverlay />
                {renderRows(g.tasks)}
              </div>
            )}
          </div>
        );
      })}
      {rowsTailSpacer}
      {hiddenNote}
      {bandFrameLayer}
      {annotationLayer}
      {spanLayer}
      {bubbleMacroFrameLayer}
      {bubbleLegendBar}
      <Tooltip />
      {annotationModal}
    </div>
  );
}

/* Widget « Bulles » (#92). Volontairement une ENVELOPPE de trois lignes, et non
   un second diagramme : l'axe, la fenêtre, le zoom, les groupes repliables, les
   annotations, les infobulles et le glisser des dates sont ceux du Mini-Gantt,
   et le rester est la seule façon qu'un correctif d'axe profite aux deux.
   Ce qui est propre aux bulles vit dans le bloc NEXORA:BUBBLES (logique) et
   dans les branches `bubbleMode` de WidgetMiniGantt (rendu de la ligne). */
function WidgetBubbles(props) {
  return <WidgetMiniGantt {...props} bubbleMode />;
}

/* Widget « Charge personnel » (#124). Les personnes en lignes, les jours en
   colonnes, et dans chaque case les ateliers du jour — plusieurs par jour si
   besoin.

   Le graphisme est celui de la heat map, délibérément : cases arrondies posées
   sur une trame régulière, liseré d'accent sur aujourd'hui, week-end atténué,
   légende en pied. Ce n'est pas une coquetterie — c'est la même lecture « une
   case = une journée » que Nexora propose déjà ailleurs, et l'apprendre deux
   fois n'apporterait rien.

   Toute la logique sans rendu vit dans le bloc NEXORA:STAFFING : ce composant
   ne fait que mesurer, placer et écouter. */
/* Trois longueurs pour le même jour, choisies sur la largeur MESURÉE d'une
   case : « lun » quand il y a la place, « lu » en vue mois — où « M » seul ne
   distinguerait pas mardi de mercredi — et l'initiale en dernier recours. */
const STAFFING_DOW_LABELS = ["lun", "mar", "mer", "jeu", "ven", "sam", "dim"];
const STAFFING_DOW_SHORT = ["lu", "ma", "me", "je", "ve", "sa", "di"];
const STAFFING_GRID_GAP = 3;

function WidgetStaffing({ widget, ctx, staffing, onUpdateStaffing, onUpdateWidget, onUpdateWorkshops }) {
  const cfg = normalizeStaffingWidget(widget);
  const catalogue = useMemo(() => normalizeWorkshops(ctx.workshops), [ctx.workshops]);
  const knownIds = useMemo(() => catalogue.map((w) => w.id), [catalogue]);
  const todayIso = useMemo(() => iso(new Date()), []);
  const frame = useMemo(
    () => staffingWindow(cfg.staffingRange, cfg.staffingOffset, todayIso, { start: cfg.staffingStart, end: cfg.staffingEnd }),
    [cfg.staffingRange, cfg.staffingOffset, todayIso, cfg.staffingStart, cfg.staffingEnd]
  );
  const days = useMemo(
    () => staffingDays(frame, todayIso, { showWeekends: cfg.staffingShowWeekends }),
    [frame, todayIso, cfg.staffingShowWeekends]
  );
  const members = useMemo(
    () => staffingVisibleMembers(ctx.teamMembers, cfg.staffingMembers, cfg.staffingExtraMembers),
    [ctx.teamMembers, cfg.staffingMembers, cfg.staffingExtraMembers]
  );
  const cells = useMemo(() => staffingByCell(staffing), [staffing]);

  /* La largeur d'une case est MESURÉE, pas supposée : c'est elle qui décide si
     une bande peut porter le nom de son atelier, son code, ou rien du tout. En
     vue mois, trente et une colonnes laissent une quinzaine de pixels chacune —
     y écrire quoi que ce soit donnerait une bouillie de lettres coupées. */
  const gridRef = useRef(null);
  const [gridPx, setGridPx] = useState(0);
  useEffect(() => {
    const el = gridRef.current;
    if (!el || typeof ResizeObserver === "undefined") return undefined;
    const observer = new ResizeObserver(() => {
      const width = Math.round(el.getBoundingClientRect().width);
      setGridPx((prev) => (prev === width ? prev : width));
    });
    observer.observe(el);
    return () => observer.disconnect();
  }, []);

  const nameW = days.length > 16 ? 146 : 188;
  const loadW = cfg.staffingShowLoad ? 64 : 0;
  const colCount = Math.max(1, days.length);
  const gutters = STAFFING_GRID_GAP * (colCount + (loadW ? 1 : 0));
  const cellPx = gridPx > 0 ? Math.max(0, (gridPx - nameW - loadW - gutters) / colCount) : 0;
  const gridTemplate = nameW + "px repeat(" + colCount + ", minmax(0, 1fr))" + (loadW ? " " + loadW + "px" : "");

  const [picker, setPicker] = useState(null); // { member, date, rect }
  const [query, setQuery] = useState("");
  const [hover, setHover] = useState(null);   // { x, y, member, day }

  // Le panneau se ferme au clic dehors et à Échap, comme tous les menus de
  // Nexora. Il vit en portail : le widget coupe à son bord, et un panneau
  // rendu dedans serait tranché dès la dernière ligne.
  useEffect(() => {
    if (!picker) return undefined;
    const onKey = (e) => { if (e.key === "Escape") setPicker(null); };
    const onDown = (e) => { if (!e.target.closest || !e.target.closest(".lp-cp-picker")) setPicker(null); };
    document.addEventListener("keydown", onKey);
    document.addEventListener("mousedown", onDown);
    return () => { document.removeEventListener("keydown", onKey); document.removeEventListener("mousedown", onDown); };
  }, [picker]);

  const periodLabel = cfg.staffingRange === "month"
    ? monthLabel(frame.start)
    : fmtShort(frame.start) + " – " + fmtShort(frame.end);

  const shiftPeriod = (dir) => {
    if (!onUpdateWidget) return;
    onUpdateWidget({ staffingOffset: normalizeStaffingOffset(cfg.staffingOffset + dir) });
  };
  const setRange = (range) => {
    if (!onUpdateWidget) return;
    onUpdateWidget({ staffingRange: range, staffingOffset: 0 });
  };

  const openPicker = (member, date, e) => {
    if (!onUpdateStaffing) return;
    setHover(null);
    setQuery("");
    setPicker({ member, date, rect: e.currentTarget.getBoundingClientRect() });
  };

  const currentIds = picker ? (cells.get(staffingCellId(picker.member, picker.date)) || []) : [];
  const toggleWorkshop = (id) => {
    if (!picker || !onUpdateStaffing) return;
    const next = currentIds.includes(id) ? currentIds.filter((x) => x !== id) : [...currentIds, id];
    onUpdateStaffing((prev) => staffingSetCell(prev, picker.member, picker.date, next, knownIds));
  };
  const clearCell = () => {
    if (!picker || !onUpdateStaffing) return;
    onUpdateStaffing((prev) => staffingSetCell(prev, picker.member, picker.date, [], knownIds));
  };

  /* Créer un atelier SANS quitter la case (#124) : le besoin se découvre en
     affectant — « tiens, il manque Grue » —, et renvoyer dans les Réglages
     pour revenir ensuite ferait perdre la case qu'on était en train de
     remplir. L'atelier créé est aussitôt posé sur elle : c'est pour elle qu'on
     l'a créé.

     Il entre dans le MÊME catalogue que les autres, marqué `custom` : un second
     magasin aurait donné deux endroits où chercher « Grue », et deux règles de
     suppression. */
  const [draft, setDraft] = useState(null); // { name, color }
  const openDraft = () => setDraft({ name: query.trim(), color: STAFFING_COLOR_CHOICES[0] });
  const createWorkshop = () => {
    if (!draft || !picker || !onUpdateWorkshops || !onUpdateStaffing) return;
    const name = String(draft.name || "").trim();
    if (!name) return;
    const made = staffingAddCustomWorkshop(catalogue, name, draft.color);
    if (!made.workshop) return;
    if (made.created) onUpdateWorkshops(made.catalogue);
    const nextIds = currentIds.includes(made.workshop.id) ? currentIds : [...currentIds, made.workshop.id];
    onUpdateStaffing((prev) => staffingSetCell(prev, picker.member, picker.date, nextIds, made.catalogue.map((w) => w.id)));
    setDraft(null);
    setQuery("");
  };

  const dayTitle = (dayIso) => {
    const d = new Date(dayIso + "T00:00:00");
    return d.toLocaleDateString("fr-FR", { weekday: "long", day: "numeric", month: "long" });
  };

  if (!members.length) {
    return (
      <div className="lp-empty">
        {(ctx.teamMembers || []).length === 0
          ? "Aucun utilisateur : ajoute des personnes dans Réglages › Utilisateurs, ou directement dans les réglages de ce widget."
          : "Personne n'est encore affiché : ouvre les réglages du widget pour cocher les personnes à suivre — « Tout cocher » les prend toutes — ou pour en ajouter à la main."}
      </div>
    );
  }

  const tooltip = !hover ? null : createPortal(
    <div
      className="lp-pie-tooltip lp-widget-metro-tooltip"
      style={{ position: "fixed", left: hover.x, top: hover.y, zIndex: 100000, maxWidth: 240, pointerEvents: "none" }}
    >
      <div className="lp-widget-metro-tooltip-head">
        <span className="lp-widget-metro-tooltip-dot" style={{ background: hover.color || "var(--text-muted)" }} />
        <span className="lp-widget-metro-tooltip-title">{hover.member}</span>
      </div>
      <div className="lp-widget-metro-tooltip-meta">{dayTitle(hover.date)}</div>
      {hover.ids.length === 0 ? (
        <div className="lp-cp-tip-empty">Aucun atelier — cliquer pour en poser</div>
      ) : (
        <>
          {hover.ids.map((id) => {
            const shop = workshopFor(catalogue, id);
            if (!shop) return null;
            return (
              <div className="lp-cp-tip-line" key={id}>
                <span className="lp-cp-dot" style={{ background: shop.color }} />
                <span>{shop.name}</span>
              </div>
            );
          })}
          <div className="lp-cp-tip-foot">
            {hover.ids.length > 1 ? hover.ids.length + " postes ce jour-là" : "1 poste ce jour-là"}
          </div>
        </>
      )}
    </div>,
    document.body
  );

  /* Le panneau de sélection. Ancré sous la case, ramené dans la fenêtre quand
     il en sortirait — une case de fin de mois ouvrait sinon son panneau hors
     de l'écran. */
  const pickerNode = !picker ? null : (() => {
    const W = 264;
    const H = 330;
    const left = Math.max(8, Math.min(picker.rect.left, (typeof window !== "undefined" ? window.innerWidth : 1200) - W - 8));
    const below = picker.rect.bottom + 6;
    const fitsBelow = below + H < (typeof window !== "undefined" ? window.innerHeight : 900);
    const top = fitsBelow ? below : Math.max(8, picker.rect.top - H - 6);
    const picked = staffingPickerGroups(catalogue, currentIds, query);
    return createPortal(
      <div className="lp-cp-picker" style={{ position: "fixed", left, top, width: W, zIndex: 100001 }}>
        <div className="lp-cp-picker-head">
          <div className="lp-cp-picker-head-text">
            <span className="lp-cp-picker-who">{picker.member}</span>
            <span className="lp-cp-picker-when">{dayTitle(picker.date)}</span>
          </div>
          <button type="button" className="lp-icon-btn" aria-label="Fermer" onClick={() => setPicker(null)}>
            <X size={14} />
          </button>
        </div>
        <div className="lp-cp-picker-search">
          <Search size={13} />
          <input
            type="text"
            autoFocus
            value={query}
            onChange={(e) => setQuery(e.target.value)}
            placeholder="Rechercher un atelier…"
            aria-label="Rechercher un atelier"
          />
        </div>
        <div className="lp-cp-picker-list">
          {picked.groups.length === 0 && <div className="lp-cp-picker-empty">Aucun atelier ne correspond.</div>}
          {picked.groups.map((group) => (
            <div key={group.key}>
              {group.label && <div className="lp-cp-picker-group">{group.label}</div>}
              {group.items.map((item) => (
                <label className={"lp-cp-picker-opt" + (item.checked ? " is-on" : "")} key={item.id}>
                  <input type="checkbox" checked={item.checked} onChange={() => toggleWorkshop(item.id)} />
                  <span className="lp-cp-dot" style={{ background: item.color }} />
                  <span className="lp-cp-picker-opt-name">{item.name}</span>
                </label>
              ))}
            </div>
          ))}
          {picked.hiddenSelected.length > 0 && (
            <div className="lp-cp-picker-note">
              {picked.hiddenSelected.join(", ")} {picked.hiddenSelected.length > 1 ? "restent cochés" : "reste coché"} : {picked.hiddenSelected.length > 1 ? "ils sortent" : "il sort"} du filtre, pas de la sélection.
            </div>
          )}
          {onUpdateWorkshops && !draft && (
            <button type="button" className="lp-cp-picker-new" onClick={openDraft}>
              <Plus size={13} />
              {query.trim() ? "Créer l’atelier « " + query.trim() + " »" : "Créer un atelier personnalisé"}
            </button>
          )}
          {onUpdateWorkshops && draft && (
            <div className="lp-cp-draft">
              <input
                type="text"
                autoFocus
                value={draft.name}
                onChange={(e) => setDraft({ ...draft, name: e.target.value })}
                onKeyDown={(e) => {
                  if (e.key === "Enter") { e.preventDefault(); createWorkshop(); }
                  if (e.key === "Escape") { e.preventDefault(); setDraft(null); }
                }}
                placeholder="Nom de l’atelier"
                aria-label="Nom du nouvel atelier"
              />
              <div className="lp-cp-draft-colors">
                {STAFFING_COLOR_CHOICES.map((c) => (
                  <button
                    key={c}
                    type="button"
                    className={"lp-cp-swatch" + (draft.color === c ? " is-on" : "")}
                    style={{ background: c }}
                    aria-label={"Couleur " + c}
                    aria-pressed={draft.color === c}
                    onClick={() => setDraft({ ...draft, color: c })}
                  />
                ))}
              </div>
              <div className="lp-cp-draft-foot">
                <button type="button" className="lp-btn lp-btn-mini" onClick={() => setDraft(null)}>Annuler</button>
                <button type="button" className="lp-btn lp-btn-mini lp-btn-primary" onClick={createWorkshop} disabled={!draft.name.trim()}>
                  Créer et poser
                </button>
              </div>
            </div>
          )}
        </div>
        <div className="lp-cp-picker-foot">
          <span className="lp-cp-picker-count">
            {currentIds.length === 0 ? "Aucun atelier" : currentIds.length > 1 ? currentIds.length + " ateliers" : "1 atelier"}
          </span>
          {currentIds.length > 0 && (
            <button type="button" className="lp-btn lp-btn-mini" onClick={clearCell}>Tout retirer</button>
          )}
          <button type="button" className="lp-btn lp-btn-mini lp-btn-primary" onClick={() => setPicker(null)}>Terminé</button>
        </div>
      </div>,
      document.body
    );
  })();

  return (
    <div className="lp-cp">
      <div className="lp-cp-bar">
        <div className="lp-cp-nav">
          <button type="button" className="lp-tool-btn lp-cp-nav-btn" aria-label="Période précédente" onClick={() => shiftPeriod(-1)}>
            <ChevronLeft size={13} />
          </button>
          <span className="lp-cp-period">{periodLabel}</span>
          <button type="button" className="lp-tool-btn lp-cp-nav-btn" aria-label="Période suivante" onClick={() => shiftPeriod(1)}>
            <ChevronRight size={13} />
          </button>
        </div>
        <div className="lp-zoom-group">
          {STAFFING_RANGES.map((r) => (
            <button
              key={r}
              type="button"
              className={"lp-zoom-btn" + (cfg.staffingRange === r ? " active" : "")}
              onClick={() => setRange(r)}
            >
              {staffingRangeLabel(r)}
            </button>
          ))}
        </div>
        {cfg.staffingOffset !== 0 && onUpdateWidget && (
          <button type="button" className="lp-tool-btn" onClick={() => onUpdateWidget({ staffingOffset: 0 })}>Aujourd'hui</button>
        )}
      </div>

      <div className="lp-cp-grid" ref={gridRef} style={{ gridTemplateColumns: gridTemplate, gap: STAFFING_GRID_GAP }}>
        <div className="lp-cp-corner">Personne</div>
        {days.map((day) => (
          <div
            key={day.iso}
            className={"lp-cp-head" + (day.today ? " is-today" : "") + (day.weekend ? " is-weekend" : "")}
            title={dayTitle(day.iso)}
          >
            <span className="lp-cp-head-dow">
              {cellPx >= 30
                ? STAFFING_DOW_LABELS[day.dow]
                : cellPx >= 17
                  ? STAFFING_DOW_SHORT[day.dow]
                  : STAFFING_DOW_SHORT[day.dow].charAt(0).toUpperCase()}
            </span>
            <span className="lp-cp-head-num">{day.num}</span>
          </div>
        ))}
        {cfg.staffingShowLoad && <div className="lp-cp-corner lp-cp-corner-right">Postes</div>}

        {members.map((member) => {
          const load = staffingMemberLoad(staffing, member.name, days);
          return (
            <React.Fragment key={member.name}>
              <div className="lp-cp-person">
                <span className="lp-cp-avatar" style={{ background: member.color || staffingMemberColor(member.name) }}>
                  {member.avatarDataUrl
                    ? <IconGlyph icon={member.avatarDataUrl} size={16} />
                    : member.name.split(/\s+/).map((part) => part.charAt(0)).join("").slice(0, 2).toUpperCase()}
                </span>
                <span className="lp-cp-person-name">{member.name}</span>
              </div>
              {days.map((day) => {
                const ids = cells.get(staffingCellId(member.name, day.iso)) || [];
                const fill = staffingCellFill(ids, catalogue);
                const label = staffingCellLabel(fill, cellPx);
                return (
                  <button
                    type="button"
                    key={day.iso}
                    className={"lp-cp-cell" + (ids.length ? " is-filled" : " is-empty") + (day.today ? " is-today" : "") + (day.weekend ? " is-weekend" : "")}
                    style={fill ? { background: fill.background } : undefined}
                    aria-label={member.name + " — " + dayTitle(day.iso) + " — " + (ids.length ? ids.map((id) => (workshopFor(catalogue, id) || {}).name).filter(Boolean).join(", ") : "aucun atelier")}
                    onClick={(e) => openPicker(member.name, day.iso, e)}
                    onMouseEnter={(e) => setHover({ member: member.name, color: member.color, date: day.iso, ids, x: e.clientX + 14, y: e.clientY + 16 })}
                    onMouseMove={(e) => setHover((prev) => (prev ? { ...prev, x: e.clientX + 14, y: e.clientY + 16 } : prev))}
                    onMouseLeave={() => setHover(null)}
                  >
                    {label && <span className="lp-cp-label">{label}</span>}
                    {ids.length === 0 && <span className="lp-cp-plus" aria-hidden="true">+</span>}
                  </button>
                );
              })}
              {cfg.staffingShowLoad && (
                <div className="lp-cp-load">
                  <span className="lp-cp-load-track">
                    <span
                      className="lp-cp-load-fill"
                      style={{ width: Math.min(100, days.length ? (load / (days.length * 1.4)) * 100 : 0) + "%", background: member.color || "var(--text-muted)" }}
                    />
                  </span>
                  <span className="lp-cp-load-value">{load}</span>
                </div>
              )}
            </React.Fragment>
          );
        })}

        <div className="lp-cp-corner lp-cp-foot-label">Personnes affectées</div>
        {days.map((day) => {
          const count = staffingDayCount(staffing, members, day.iso);
          return (
            <div key={day.iso} className={"lp-cp-foot" + (count === 0 ? " is-zero" : "") + (day.today ? " is-today" : "")}>
              {count}
            </div>
          );
        })}
        {cfg.staffingShowLoad && <div />}
      </div>

      <div className="lp-cp-legend">
        {catalogue.map((shop) => (
          <span className="lp-cp-legend-item" key={shop.id}>
            <span className="lp-cp-dot" style={{ background: shop.color }} />
            {shop.name}
          </span>
        ))}
      </div>

      {tooltip}
      {pickerNode}
    </div>
  );
}

// Axe temporel compact, partagé par les widgets Mini-Gantt et Mini métro : choisit
// automatiquement le pas d'affichage (jour/semaine/mois/trimestre/année) selon
// l'étendue réelle des dates du widget, pour rester lisible quel que soit le zoom
// — même logique d'ajustement automatique que la vue Planning Projets complète.
/* Largeur estimée d'une étiquette d'axe, en pixels. Mono 10 px gras : ~6,2 px
   par caractère, volontairement un peu généreux — sous-estimer laisserait deux
   étiquettes se toucher, ce que l'éclaircie est précisément là pour éviter. */
const MINIGANTT_AXIS_LABEL_GAP = 10;
function widgetAxisLabelWidth(label) {
  return 4 + String(label || "").length * 6.2;
}

function widgetAxisUnit(spanDays) {
  return spanDays <= 18 ? "day" : spanDays <= 70 ? "week" : spanDays <= 550 ? "month" : spanDays <= 1500 ? "quarter" : "year";
}
function widgetAxisTicks(minDate, maxDate) {
  const spanDays = Math.max(1, dayIndex(maxDate) - dayIndex(minDate));
  const unit = widgetAxisUnit(spanDays);
  const dayLabel = (d) => { const dt = new Date(d + "T00:00:00"); return `${dt.getDate()}/${dt.getMonth() + 1}`; };
  const ticks = [];
  let cur = unitStart(minDate, unit);
  let guard = 0;
  while (dayIndex(cur) <= dayIndex(maxDate) && guard < 80) {
    if (dayIndex(cur) >= dayIndex(minDate)) ticks.push({ date: cur, label: unit === "day" ? dayLabel(cur) : unitLabel(cur, unit) });
    cur = addDays(cur, unitLen(cur, unit));
    guard++;
  }
  // Pour un pas "jour", on ne garde qu'une étiquette sur N pour ne jamais surcharger un widget étroit.
  if (unit === "day" && ticks.length > 7) {
    const step = Math.ceil(ticks.length / 7);
    return ticks.filter((_, i) => i % step === 0);
  }
  return ticks;
}
// Séparateurs intermédiaires, plus fins que les étiquettes principales : à un pas
// "semaine", un repère par jour ; à un pas "mois", un repère par semaine ; à un pas
// "trimestre", un repère par mois — pour garder un sens de l'échelle même quand les
// étiquettes principales sont grossières, sans jamais surcharger le widget.
/* Sous-grille verticale : un repère intermédiaire entre deux graduations
   étiquetées, pour donner du contexte temporel sans surcharger l'axe.

   Le pas ANNUEL n'en avait aucun : sur un diagramme de sept ans, on voyait sept
   traits et rien entre eux — impossible de situer une barre au trimestre près
   (retour de test). Il reçoit donc les trimestres, comme le pas trimestriel
   reçoit les mois. Le pas JOURNALIER reste sans sous-grille : il n'y a rien de
   plus fin qu'un jour à montrer.

   Le garde-fou passe de 300 à 600 : sept ans de trimestres tiennent largement,
   mais une fenêtre à dates fixes de vingt ans en demanderait quatre-vingts de
   plus, et la boucle doit rester bornée quoi qu'il arrive. */
/* Échelle des graduations, du plus large au plus fin. Descendre « d'un cran »,
   c'est avancer d'une case dans cette suite — l'axe porte donc jusqu'à TROIS
   niveaux : son unité, puis deux sous-grilles de plus en plus fines. */
const WIDGET_AXIS_SCALE = ["year", "quarter", "month", "week", "day"];

function widgetFinerUnit(unit, crans) {
  const i = WIDGET_AXIS_SCALE.indexOf(unit);
  if (i === -1) return null;
  return WIDGET_AXIS_SCALE[i + crans] || null;
}

/* Sous-graduations à `crans` niveaux sous l'unité de l'axe.

   Un garde-fou de densité, et pas seulement de boucle : sous une échelle
   mensuelle, le troisième niveau est le JOUR, soit jusqu'à 550 traits sur une
   piste de quelques centaines de pixels — un aplat gris, pas un repère. Au-delà
   de MINIGANTT_SUBGRID_MAX traits, le niveau se tait, et l'axe reste lisible à
   tous les zooms sans qu'on ait à le régler. */
const MINIGANTT_SUBGRID_MAX = 180;

function widgetSubTicks(minDate, maxDate, crans) {
  const spanDays = Math.max(1, dayIndex(maxDate) - dayIndex(minDate));
  const unit = widgetAxisUnit(spanDays);
  const subUnit = widgetFinerUnit(unit, crans);
  if (!subUnit) return [];
  const ticks = [];
  let cur = unitStart(minDate, subUnit);
  let guard = 0;
  while (dayIndex(cur) <= dayIndex(maxDate) && guard < 1200) {
    if (dayIndex(cur) >= dayIndex(minDate)) ticks.push(cur);
    cur = addDays(cur, unitLen(cur, subUnit));
    guard++;
  }
  return ticks.length > MINIGANTT_SUBGRID_MAX ? [] : ticks;
}

// Un cran sous l'unité de l'axe : année → trimestre, mois → semaine…
function widgetSecondaryTicks(minDate, maxDate) {
  return widgetSubTicks(minDate, maxDate, 1);
}

// Deux crans : année → mois, trimestre → semaine, mois → jour. C'est ce niveau
// qui se tait le premier quand la piste ne peut plus le porter.
function widgetTertiaryTicks(minDate, maxDate) {
  return widgetSubTicks(minDate, maxDate, 2);
}

// Heat map mensuelle compacte : grille calendrier sur 3 mois consécutifs, navigable
// de mois en mois, colorée par PROJET (et non plus par densité) — chaque case avec
// des tâches se terminant ce jour-là est teintée avec la couleur du projet ; quand
// plusieurs projets se terminent le même jour, la case est partagée en quartiers
// (conic-gradient) selon la couleur de chacun. Les jours en retard gardent un
// contour rouge distinct, pour rester un signal d'alerte reconnaissable même si la
// couleur de fond est désormais celle du projet plutôt qu'un dégradé de charge.
function WidgetHeatmapMonth({ tasks, ctx, onOpen, appearance }) {
  const [monthOffset, setMonthOffset] = useState(0);
  const [hoverDay, setHoverDay] = useState(null); // { day, x, y }
  const [selectedDay, setSelectedDay] = useState(null); // jour cliqué : ouvre le panneau de liste à droite
  // null = pas encore glissé par l'utilisateur → répartition 50/50 exacte (flex
  // égal des deux côtés). Un nombre = largeur en px du volet liste, fixée par un
  // glisser-déposer explicite sur la poignée.
  const [listWidth, setListWidth] = useState(null);
  const dragRef = useRef(null);
  const wrapRef = useRef(null);
  const daylistRef = useRef(null);
  const startResize = (e) => {
    e.preventDefault();
    const startWidth = listWidth != null ? listWidth : (daylistRef.current?.getBoundingClientRect().width || 400);
    dragRef.current = { startX: e.clientX, startWidth };
    const onMove = (ev) => {
      if (!dragRef.current) return;
      const wrapWidth = wrapRef.current?.getBoundingClientRect().width || 800;
      const delta = dragRef.current.startX - ev.clientX; // glisser vers la gauche agrandit la liste
      const next = Math.max(220, Math.min(wrapWidth - 180, dragRef.current.startWidth + delta));
      setListWidth(next);
    };
    const onUp = () => {
      dragRef.current = null;
      window.removeEventListener("mousemove", onMove);
      window.removeEventListener("mouseup", onUp);
    };
    window.addEventListener("mousemove", onMove);
    window.addEventListener("mouseup", onUp);
  };
  const dated = useMemo(() => tasks.filter((t) => t.start && t.end), [tasks]);
  const today = iso(new Date());
  const MONTHS_FULL = ["Janvier", "Février", "Mars", "Avril", "Mai", "Juin", "Juillet", "Août", "Septembre", "Octobre", "Novembre", "Décembre"];
  const DOW = ["L", "M", "M", "J", "V", "S", "D"];

  // Les 3 mois affichés côte à côte : le mois courant (+ monthOffset) d'abord, puis
  // les deux suivants — jamais de mois isolé au milieu, pour rester lisible comme
  // un vrai calendrier trimestriel qu'on fait glisser mois par mois.
  const months = useMemo(() => {
    return [0, 1, 2].map((i) => {
      const base = new Date();
      base.setDate(1);
      base.setMonth(base.getMonth() + monthOffset + i);
      const year = base.getFullYear(), month = base.getMonth();
      const firstOfMonth = new Date(year, month, 1);
      const startDow = (firstOfMonth.getDay() + 6) % 7; // lundi = 0
      const gridStart = new Date(firstOfMonth);
      gridStart.setDate(gridStart.getDate() - startDow);
      const cells = [];
      for (let d = 0; d < 42; d++) {
        const dt = new Date(gridStart);
        dt.setDate(dt.getDate() + d);
        cells.push(iso(dt));
      }
      // On n'affiche que les semaines nécessaires (5 ou 6 selon le mois) pour ne
      // pas gaspiller une ligne entière de cases vides quand ce n'est pas utile.
      let neededRows = 6;
      for (let r = 6; r >= 5; r--) {
        const lastCellOfRow = cells[r * 7 - 1];
        if (lastCellOfRow && new Date(lastCellOfRow + "T00:00:00").getMonth() !== month) neededRows = r;
      }
      return { year, month, visibleCells: cells.slice(0, neededRows * 7), neededRows };
    });
  }, [monthOffset]);
  const rangeLabel = `${MONTHS_FULL[months[0].month]} ${months[0].year} — ${MONTHS_FULL[months[2].month]} ${months[2].year}`;

  // Uniquement les dates de FIN de tâche et les dates de JALON — jamais les dates
  // de début ni une date intermédiaire. Un jalon a start === end, donc il est déjà
  // naturellement inclus via t.end ; ce filtre exclut explicitement toute autre
  // lecture possible pour rester sans ambiguïté.
  const { tasksByDay, lateCounts } = useMemo(() => {
    const byDay = {}, late = {};
    dated.forEach((t) => {
      (byDay[t.end] || (byDay[t.end] = [])).push(t);
      if (!isTaskDoneGlobal(t, ctx) && t.end < today) late[t.end] = (late[t.end] || 0) + 1;
    });
    return { tasksByDay: byDay, lateCounts: late };
  }, [dated, ctx, today]);

  const tasksForDay = (day) => tasksByDay[day] || [];

  // Couleur(s) d'une case : la ou les couleurs des projets ayant une tâche qui se
  // termine ce jour-là. Un seul projet → aplat. Plusieurs projets → la case est
  // divisée en quartiers égaux (un par projet, dans l'ordre d'apparition) via un
  // conic-gradient orienté en diagonale, pour que le partage saute aux yeux même
  // sur une petite case.
  const cellBackground = (day) => {
    const dayTasks = tasksForDay(day);
    if (!dayTasks.length) return null;
    const projIds = [];
    dayTasks.forEach((t) => { if (t.projectId && !projIds.includes(t.projectId)) projIds.push(t.projectId); });
    const colors = (projIds.length ? projIds : [null]).map(
      (pid) => ctx.projects.find((p) => p.id === pid)?.color || "var(--text-muted)"
    );
    if (colors.length === 1) return colors[0];
    const seg = 360 / colors.length;
    const stops = colors.map((c, i) => `${c} ${i * seg}deg ${(i + 1) * seg}deg`).join(", ");
    return `conic-gradient(from 45deg, ${stops})`;
  };

  const selectedTasks = selectedDay ? tasksForDay(selectedDay) : [];

  // Légende : un point par projet ayant au moins une tâche visible dans ce widget,
  // dans l'ordre de première apparition — pour associer couleur ↔ projet d'un
  // coup d'œil sans avoir à cliquer sur chaque case.
  const legendProjects = useMemo(() => {
    const seen = new Set(), list = [];
    dated.forEach((t) => {
      if (t.projectId && !seen.has(t.projectId)) {
        seen.add(t.projectId);
        const p = ctx.projects.find((pr) => pr.id === t.projectId);
        if (p) list.push(p);
      }
    });
    return list;
  }, [dated, ctx.projects]);

  return (
    <div className="lp-widget-heatmap-wrap" ref={wrapRef}>
      <div className="lp-widget-heatmap">
        <div className="lp-widget-heatmap-head">
          <button className="lp-icon-btn" onClick={() => setMonthOffset((m) => m - 1)} title="Mois précédent"><ChevronRight size={13} style={{ transform: "rotate(180deg)" }} /></button>
          <span className="lp-widget-heatmap-title">{rangeLabel}</span>
          <button className="lp-icon-btn" onClick={() => setMonthOffset((m) => m + 1)} title="Mois suivant"><ChevronRight size={13} /></button>
          {monthOffset !== 0 && <button className="lp-icon-btn" onClick={() => setMonthOffset(0)} title="Revenir au mois en cours"><RefreshCw size={11} /></button>}
        </div>
        {legendProjects.length > 0 && (
          <div className="lp-widget-heatmap-legend">
            {legendProjects.map((p) => (
              <span className="lp-widget-heatmap-legend-item" key={p.id}>
                <span className="lp-widget-heatmap-legend-dot" style={{ background: p.color || "var(--text-muted)" }} />
                {p.name}
              </span>
            ))}
          </div>
        )}
        <div className="lp-widget-heatmap-months">
          {months.map(({ year, month, visibleCells, neededRows }) => (
            <div className="lp-widget-heatmap-month" key={`${year}-${month}`}>
              <div className="lp-widget-heatmap-month-title">{MONTHS_FULL[month]} {year}</div>
              <div className="lp-widget-heatmap-dow">
                {DOW.map((d, i) => <span key={i}>{d}</span>)}
              </div>
              {/* Plancher de hauteur par ligne : les mois ne s'étirent plus pour
                  remplir la hauteur depuis qu'ils se répartissent en grille
                  (#68), et sans lui les cases se tasseraient jusqu'à cacher le
                  numéro du jour quand plusieurs lignes de mois se partagent la
                  hauteur. Le « 1fr » reste : là où il y a de la place, les cases
                  la prennent toujours. */}
              <div className="lp-widget-heatmap-grid" style={{ gridTemplateRows: `repeat(${neededRows}, minmax(16px, 1fr))` }}>
                {visibleCells.map((day) => {
                  const inMonth = new Date(day + "T00:00:00").getMonth() === month;
                  const bg = cellBackground(day);
                  const dayTasks = tasksForDay(day);
                  const isLate = (lateCounts[day] || 0) > 0;
                  /* Passé au sens strict : aujourd'hui n'est pas du passé, et
                     doit rester au premier plan avec les jours à venir (#68). */
                  const isPast = day < today;
                  return (
                    <div
                      key={day}
                      className={"lp-widget-heatmap-cell" + (!inMonth ? " lp-widget-heatmap-cell-out" : "") + (day === today ? " lp-widget-heatmap-cell-today" : "") + (day === selectedDay ? " lp-widget-heatmap-cell-selected" : "") + (isLate ? " lp-widget-heatmap-cell-late" : "") + (isPast && bg ? " lp-widget-heatmap-cell-past" : "")}
                      style={bg ? { background: bg } : undefined}
                      onMouseEnter={(e) => dayTasks.length && setHoverDay({ day, tasks: dayTasks, x: e.clientX, y: e.clientY })}
                      onMouseMove={(e) => dayTasks.length && setHoverDay({ day, tasks: dayTasks, x: e.clientX, y: e.clientY })}
                      onMouseLeave={() => setHoverDay(null)}
                      onClick={() => setSelectedDay((d) => (d === day ? null : (dayTasks.length ? day : null)))}
                    >
                      {/* Sur une case lavée, le blanc devient illisible : le
                          numéro reprend la couleur du texte ordinaire. */}
                      <span className="lp-widget-heatmap-daynum" style={bg ? { color: isPast ? "var(--text-900)" : "#fff" } : undefined}>{new Date(day + "T00:00:00").getDate()}</span>
                    </div>
                  );
                })}
              </div>
            </div>
          ))}
        </div>
        {hoverDay && (
          <WidgetPointerTooltip x={hoverDay.x} y={hoverDay.y} className="lp-pie-tooltip lp-widget-metro-tooltip">
            <div className="lp-widget-metro-tooltip-title">{fmtShort(hoverDay.day)}</div>
            <div className="lp-widget-metro-tooltip-meta">{hoverDay.tasks.slice(0, 5).map((t) => t.title).join(", ")}{hoverDay.tasks.length > 5 ? ` +${hoverDay.tasks.length - 5} autres` : ""}</div>
          </WidgetPointerTooltip>
        )}
      </div>
      {/* Poignée de glisser : ajuste la part respective du calendrier et de la
          liste. Tant qu'elle n'a pas été utilisée, les deux volets se partagent
          l'espace disponible à parts strictement égales (flex 1 1 0 des deux
          côtés) — un glisser-déposer explicite fixe ensuite une largeur en px. */}
      <div className="lp-widget-heatmap-resize-handle" onMouseDown={startResize} title="Glisser pour redimensionner" />
      {/* Panneau de liste : toujours apparent (même sans jour sélectionné, avec un
          message d'invite), pour que sa présence soit prévisible plutôt que de
          faire réapparaître/disparaître le calendrier à chaque clic. */}
      <div className="lp-widget-heatmap-daylist" ref={daylistRef} style={listWidth == null ? { flex: "1 1 0" } : { flex: `0 0 ${listWidth}px` }}>
        <div className="lp-widget-heatmap-daylist-head">
          <span>{selectedDay ? fmtShort(selectedDay) : "Aucun jour sélectionné"}</span>
          {selectedDay && <button className="lp-icon-btn" onClick={() => setSelectedDay(null)}><X size={12} /></button>}
        </div>
        {selectedDay ? (
          <div className="lp-widget-heatmap-daylist-items">
            {selectedTasks.map((t) => {
              const proj = ctx.projects.find((p) => p.id === t.projectId);
              const st = ctx.statuses.find((s) => s.id === t.statusId);
              return (
                <div className="lp-widget-heatmap-daylist-item" key={t.id} onClick={() => onOpen(t)}>
                  <span className="lp-project-dot" style={{ background: proj?.color || "var(--text-muted)", width: 12, height: 12, flex: "0 0 auto" }} />
                  <span className="lp-widget-heatmap-daylist-title">{t.title}</span>
                  {st && <span className="lp-widget-heatmap-daylist-status" style={{ color: st.color }}>{st.name}</span>}
                </div>
              );
            })}
          </div>
        ) : (
          <div className="lp-widget-heatmap-daylist-empty">Clique sur un jour du calendrier pour voir les tâches qui s'y terminent.</div>
        )}
      </div>
    </div>
  );
}

// Timeline des prochains jalons : tous les jalons à venir (toutes projets confondus
// dans la sélection filtrée), sur un axe temporel commun avec repère "aujourd'hui" —
// pour voir d'un coup d'œil ce qui approche.
// Widget "Timeline des jalons" — disposition en zigzag (alternance haut/bas)
// pour éviter que les jalons rapprochés ne se chevauchent, avec le titre et
// la date visibles directement (plus besoin de survoler chaque repère), et
// l'icône personnalisée du jalon si elle existe (cohérent avec les autres
// vues déjà corrigées pour ça).
// Widget "Timeline des jalons" — feuille de route verticale : chaque jalon
// est une LIGNE de texte HTML normale (pas de positionnement SVG calculé à
// partir des dates), donc structurellement impossible à faire chevaucher
// quelle que soit la densité de dates rapprochées. Relié par un rail vertical
// coloré, avec l'icône personnalisée du jalon si elle existe.


function WidgetMetroDeadline({ tasks, ctx, onOpen }) {
  const wrapRef = useRef(null);
  const scrollRef = useRef(null);
  const [width, setWidth] = useState(760);
  const [zoom, setZoom] = useState(1);
  const [scaleMode, setScaleMode] = useState("auto");
  const [centerTodayToken, setCenterTodayToken] = useState(0);
  const today = iso(new Date());

  useEffect(() => {
    if (!wrapRef.current) return;
    const apply = () => setWidth(Math.max(320, wrapRef.current.clientWidth || 760));
    apply();
    const ro = new ResizeObserver(apply);
    ro.observe(wrapRef.current);
    return () => ro.disconnect();
  }, []);

  const dated = useMemo(
    () => tasks.filter((t) => t.end).sort((a,b) => a.end.localeCompare(b.end) || (a.title || "").localeCompare(b.title || "")),
    [tasks]
  );

  const rows = useMemo(() => {
    const projectIds = [...new Set(dated.map((t) => t.projectId).filter(Boolean))];
    return projectIds
      .map((pid) => {
        const project = ctx.projects.find((p) => p.id === pid);
        if (!project) return null;
        const pTasks = dated.filter((t) => t.projectId === pid);
        return { project, tasks:pTasks };
      })
      .filter(Boolean)
      .sort((a,b) => (a.project.name || "").localeCompare(b.project.name || "", "fr"));
  }, [dated, ctx.projects]);

  // Étendue réelle des données. Elle inclut toujours aujourd'hui afin que
  // le repère temporel reste visible.
  const dataBounds = useMemo(() => {
    if (!dated.length) return { min:today, max:addDays(today,30) };
    let min = dated[0].end;
    let max = dated[dated.length - 1].end;
    if (today < min) min = today;
    if (today > max) max = today;
    if (min === max) max = addDays(max,1);
    return { min, max };
  }, [dated, today]);

  const dataSpanDays = Math.max(1, dayIndex(dataBounds.max) - dayIndex(dataBounds.min));

  const autoScale = useMemo(() => {
    if (dataSpanDays <= 21) return "day";
    if (dataSpanDays <= 90) return "week";
    if (dataSpanDays <= 400) return "month";
    if (dataSpanDays <= 900) return "quarter";
    return "year";
  }, [dataSpanDays]);
  const effectiveScale = scaleMode === "auto" ? autoScale : scaleMode;

  // Fenêtres temporelles de référence du widget, centrées autour d'aujourd'hui.
  // Ces trois niveaux ne dépendent plus de l'étendue des données :
  // - Jour    : J-10  → J+20
  // - Semaine : J-7   → J+70  (1 semaine avant, 10 après)
  // - Mois    : M-1   → M+6
  // Trimestre / Année conservent une logique plus large basée sur les données.
  const bounds = useMemo(() => {
    const todayDate = new Date(today + "T00:00:00");

    if (scaleMode === "day") {
      return { min:addDays(today, -10), max:addDays(today, 20) };
    }

    if (scaleMode === "week") {
      return { min:addDays(today, -7), max:addDays(today, 70) };
    }

    if (scaleMode === "month") {
      const minD = new Date(todayDate.getFullYear(), todayDate.getMonth() - 1, todayDate.getDate());
      const maxD = new Date(todayDate.getFullYear(), todayDate.getMonth() + 6, todayDate.getDate());
      return { min:iso(minD), max:iso(maxD) };
    }

    if (scaleMode === "auto") return dataBounds;

    const minVisibleSpan = {
      quarter: 730,
      year: 1825,
    }[scaleMode] || dataSpanDays;

    if (dataSpanDays >= minVisibleSpan) return dataBounds;

    const dataMin = dayIndex(dataBounds.min);
    const dataMax = dayIndex(dataBounds.max);
    const center = Math.round((dataMin + dataMax) / 2);
    const half = Math.floor(minVisibleSpan / 2);
    const startIdx = center - half;
    const endIdx = startIdx + minVisibleSpan;

    const epoch = new Date("2020-01-01T00:00:00");
    const toIsoFromIndex = (idx) => {
      const d = new Date(epoch);
      d.setDate(d.getDate() + idx);
      return iso(d);
    };

    return { min:toIsoFromIndex(startIdx), max:toIsoFromIndex(endIdx) };
  }, [today, dataBounds.min, dataBounds.max, dataSpanDays, scaleMode]);

  const PAD_L = width < 520 ? 118 : 152;
  const PAD_R = 22;
  const basePlotW = Math.max(180, width - PAD_L - PAD_R);
  const plotW = Math.max(basePlotW, basePlotW * zoom);
  const canvasW = PAD_L + plotW + PAD_R;
  const minIdx = dayIndex(bounds.min);
  const spanDays = Math.max(1, dayIndex(bounds.max) - minIdx);
  const xFor = (date) => PAD_L + ((dayIndex(date) - minIdx) / spanDays) * plotW;
  const todayX = xFor(today);

  const tickDates = useMemo(() => {
    const outTicks = [];
    const minDate = new Date(bounds.min + "T00:00:00");
    const maxDate = new Date(bounds.max + "T00:00:00");
    const push = (d, major=false) => {
      const ds = iso(d);
      if (ds >= bounds.min && ds <= bounds.max) outTicks.push({ date:ds, major });
    };

    if (effectiveScale === "day") {
      const d = new Date(minDate);
      while (d <= maxDate) {
        push(d, d.getDate() === 1);
        d.setDate(d.getDate()+1);
      }
    } else if (effectiveScale === "week") {
      const d = new Date(minDate);
      const day = (d.getDay()+6)%7;
      d.setDate(d.getDate()-day);
      while (d <= maxDate) {
        push(d, d.getDate() <= 7);
        d.setDate(d.getDate()+7);
      }
    } else if (effectiveScale === "month") {
      const d = new Date(minDate.getFullYear(), minDate.getMonth(), 1);
      while (d <= maxDate) {
        push(d, d.getMonth() === 0);
        d.setMonth(d.getMonth()+1);
      }
    } else if (effectiveScale === "quarter") {
      const q = Math.floor(minDate.getMonth()/3)*3;
      const d = new Date(minDate.getFullYear(), q, 1);
      while (d <= maxDate) {
        push(d, d.getMonth() === 0);
        d.setMonth(d.getMonth()+3);
      }
    } else {
      const d = new Date(minDate.getFullYear(),0,1);
      while (d <= maxDate) {
        push(d, true);
        d.setFullYear(d.getFullYear()+1);
      }
    }
    return outTicks;
  }, [bounds.min, bounds.max, effectiveScale]);

  const formatTick = (date) => {
    const d = new Date(date + "T00:00:00");
    if (effectiveScale === "day") return d.toLocaleDateString("fr-FR",{day:"2-digit",month:"short"});
    if (effectiveScale === "week") {
      const first = new Date(d.getFullYear(),0,1);
      const wk = Math.ceil((((d-first)/86400000)+first.getDay()+1)/7);
      return `S${String(wk).padStart(2,"0")}`;
    }
    if (effectiveScale === "month") return d.toLocaleDateString("fr-FR",{month:"short",year:"2-digit"});
    if (effectiveScale === "quarter") return `T${Math.floor(d.getMonth()/3)+1} ${String(d.getFullYear()).slice(-2)}`;
    return String(d.getFullYear());
  };

  const monthBands = useMemo(() => {
    if (effectiveScale !== "day" && effectiveScale !== "week") return [];
    const bands = [];
    let cur = new Date(bounds.min + "T00:00:00");
    cur = new Date(cur.getFullYear(), cur.getMonth(), 1);
    while (iso(cur) <= bounds.max) {
      const start = iso(cur) < bounds.min ? bounds.min : iso(cur);
      const next = new Date(cur.getFullYear(),cur.getMonth()+1,1);
      const endD = addDays(iso(next), -1);
      const end = endD > bounds.max ? bounds.max : endD;
      bands.push({
        start, end,
        label:cur.toLocaleDateString("fr-FR",{month:"long",year:"numeric"})
      });
      cur = next;
    }
    return bands;
  }, [bounds.min,bounds.max,effectiveScale]);

  const layoutRow = (row) => {
    const byDate = new Map();
    row.tasks.forEach((t) => {
      if (!byDate.has(t.end)) byDate.set(t.end, []);
      byDate.get(t.end).push(t);
    });

    const rawGroups = [...byDate.entries()].sort((a,b) => a[0].localeCompare(b[0]));
    const maxSameDay = Math.max(1, ...rawGroups.map(([,ts]) => ts.length));

    // Les stations d'une même date restent proches, mais jamais assez pour que
    // leurs anneaux ou icônes se touchent.
    const stationLaneGap = 31;
    const spread = (n) => {
      if (n <= 1) return [0];
      const c = (n - 1) / 2;
      return Array.from({length:n},(_,i)=>(i-c)*stationLaneGap);
    };

    const groups = rawGroups.map(([date,ts]) => ({
      date,
      tasks:ts,
      x:xFor(date),
      offsets:spread(ts.length),
      labels:[]
    }));

    // ---------------------------------------------------------------------
    // Placement 2D des libellés
    // ---------------------------------------------------------------------
    const LABEL_H = 15;
    const LABEL_GAP_X = 10;
    const LABEL_GAP_Y = 5;
    const LANE_GAP = 22;
    const BASE_OFFSET = 25;
    const MIN_LABEL_X = PAD_L + 70; // protège le nom du projet
    const MAX_LABEL_X = canvasW - PAD_R - 70;

    // La ligne principale est à y=0 pendant le calcul local.
    const stationBoxes = [];
    groups.forEach((g) => {
      g.offsets.forEach((off) => {
        stationBoxes.push({
          x1:g.x-13, x2:g.x+13,
          y1:off-13, y2:off+13
        });
      });
    });

    const placed = [];
    const intersects = (a,b,padX=0,padY=0) =>
      !(a.x2 + padX <= b.x1 || a.x1 - padX >= b.x2 ||
        a.y2 + padY <= b.y1 || a.y1 - padY >= b.y2);

    const collides = (box) => {
      if (placed.some((p) => intersects(box,p,LABEL_GAP_X,LABEL_GAP_Y))) return true;
      // Une étiquette ne peut pas recouvrir une station, même si elle se trouve
      // sur une voie différente.
      if (stationBoxes.some((s) => intersects(box,s,5,4))) return true;
      return false;
    };

    let seq = 0;
    let maxAbove = 0;
    let maxBelow = 0;

    groups.forEach((g) => {
      g.tasks.forEach((t,i) => {
        const rawTitle = t.title || "Sans titre";
        const label = rawTitle.length > 25 ? rawTitle.slice(0,24) + "…" : rawTitle;
        const labelW = Math.min(
          160,
          Math.max(58, pmMeasureText(label, "700 8.4px Inter, sans-serif") + 12)
        );

        const stationY = g.offsets[i];
        const preferredSide = (seq++ % 2 === 0) ? "above" : "below";

        // Plusieurs positions horizontales candidates. Le décalage s'amplifie
        // seulement quand la zone est dense ; on conserve donc une lecture
        // proche de la station en temps normal.
        const shifts = [0, -34, 34, -68, 68, -102, 102];
        const sides = [preferredSide, preferredSide === "above" ? "below" : "above"];

        let chosen = null;

        outer:
        for (const side of sides) {
          for (let lane=0; lane<8; lane++) {
            const dy = BASE_OFFSET + lane * LANE_GAP;
            const y = side === "above"
              ? stationY - dy - LABEL_H
              : stationY + dy;

            for (const shift of shifts) {
              const labelX = Math.max(
                MIN_LABEL_X + labelW/2,
                Math.min(MAX_LABEL_X - labelW/2, g.x + shift)
              );
              const box = {
                x1:labelX-labelW/2,
                x2:labelX+labelW/2,
                y1:y,
                y2:y+LABEL_H
              };
              if (!collides(box)) {
                chosen = { side,lane,label,labelW,labelX,labelY:y,box };
                break outer;
              }
            }
          }
        }

        // Cas extrême : si 8 voies ne suffisent pas, on ajoute une voie dédiée
        // plus loin. La hauteur du projet augmentera automatiquement.
        if (!chosen) {
          const side = preferredSide;
          let lane = 8;
          while (!chosen && lane < 20) {
            const dy = BASE_OFFSET + lane * LANE_GAP;
            const y = side === "above"
              ? stationY - dy - LABEL_H
              : stationY + dy;
            const labelX = Math.max(
              MIN_LABEL_X + labelW/2,
              Math.min(MAX_LABEL_X - labelW/2, g.x)
            );
            const box = {
              x1:labelX-labelW/2,
              x2:labelX+labelW/2,
              y1:y,
              y2:y+LABEL_H
            };
            if (!collides(box)) chosen = { side,lane,label,labelW,labelX,labelY:y,box };
            lane++;
          }
        }

        if (!chosen) {
          chosen = {
            side:preferredSide,lane:20,label,labelW,labelX:g.x,
            labelY:preferredSide==="above" ? stationY-480 : stationY+480,
            box:{x1:g.x-labelW/2,x2:g.x+labelW/2,y1:0,y2:LABEL_H}
          };
          chosen.box.y1 = chosen.labelY;
          chosen.box.y2 = chosen.labelY + LABEL_H;
        }

        placed.push(chosen.box);
        if (chosen.side === "above") maxAbove = Math.max(maxAbove, -chosen.box.y1);
        else maxBelow = Math.max(maxBelow, chosen.box.y2);

        g.labels.push(chosen);
      });
    });

    // Calcule l'emprise des branches multi-stations.
    const maxStationUp = Math.max(0, ...groups.flatMap((g)=>g.offsets.map((v)=>Math.max(0,-v))));
    const maxStationDown = Math.max(0, ...groups.flatMap((g)=>g.offsets.map((v)=>Math.max(0,v))));

    // Marge stricte entre lignes projets : aucun libellé du projet courant ne
    // peut empiéter sur la ligne suivante.
    const topExtent = Math.max(maxAbove, maxStationUp + 15);
    const bottomExtent = Math.max(maxBelow, maxStationDown + 15);
    const rowH = Math.max(78, topExtent + bottomExtent + 22);
    const cy = topExtent + 11;

    return {
      rowH,
      cy,
      groups,
      labelHeight:LABEL_H
    };
  };

  const layouts = useMemo(
    () => rows.map((r) => ({...r,...layoutRow(r)})),
    [rows, width, bounds.min, bounds.max, zoom]
  );
  const rowsHeight = Math.max(100, layouts.reduce((s,r)=>s+r.rowH,0));
  const AXIS_H = 46;
  const totalH = AXIS_H + rowsHeight;

  // Chaque bouton d'échelle reprend explicitement la main sur le zoom.
  // Le cadrage temporel est géré par `bounds` ci-dessus ; le zoom ci-dessous
  // contrôle ensuite la densité / le scrolling horizontal à l'intérieur de ce cadrage.
  const SCALE_ZOOM = {
    day: 1.35,
    week: 1.18,
    month: 1.08,
    quarter: 1.0,
    year: 1.0,
    auto: 1.0,
  };
  const zoomForScale = (mode) => SCALE_ZOOM[mode] || 1;
  const selectScale = (mode) => {
    setScaleMode(mode);
    setZoom(zoomForScale(mode));
    setCenterTodayToken((n) => n + 1);
  };
  const zoomOut = () => setZoom((z) => Math.max(.55, Math.round((z-.15)*100)/100));
  const zoomIn = () => setZoom((z) => Math.min(6, Math.round((z+.15)*100)/100));
  const resetZoom = () => setZoom(zoomForScale(scaleMode));

  // Après changement d'échelle, attendre le nouveau SVG puis centrer le viewport
  // sur la ligne Aujourd'hui. Deux frames garantissent que largeur/canvas/bounds
  // ont bien été recalculés avant le scroll.
  useEffect(() => {
    if (!centerTodayToken) return;
    const timer = setTimeout(() => {
      requestAnimationFrame(() => {
        const el = scrollRef.current;
        if (!el) return;
        const target = Math.max(0, Math.min(el.scrollWidth - el.clientWidth, todayX - el.clientWidth / 2));
        if (typeof el.scrollTo === "function") el.scrollTo({ left:target, behavior:"smooth" });
        else el.scrollLeft = target;
      });
    }, 40);
    return () => clearTimeout(timer);
  }, [centerTodayToken, todayX, canvasW, scaleMode, zoom]);

  if (!dated.length) {
    return (
      <div className="lp-widget-metro-deadline-empty" ref={wrapRef}>
        <TrainTrack size={24}/>
        <span>Aucune échéance dans le filtre actuel.</span>
      </div>
    );
  }

  let yCursor = AXIS_H;
  const renderedRows = layouts.map((row) => {
    const y0 = yCursor;
    yCursor += row.rowH;
    const cy = y0 + row.cy;
    const color = row.project.color || "var(--line-blue)";
    const statusColorFor = (task) => ctx.statuses.find((st) => st.id === task?.statusId)?.color || color;
    const transitions = [];

    for (let gi=0; gi<row.groups.length-1; gi++) {
      const a=row.groups[gi], b=row.groups[gi+1];
      const hubX=(a.x+b.x)/2;
      a.offsets.forEach((off,i)=>{
        transitions.push(
          <path key={`a-${row.project.id}-${gi}-${i}`} d={`M ${a.x} ${cy+off} C ${hubX-12} ${cy+off}, ${hubX-8} ${cy}, ${hubX} ${cy}`} fill="none" stroke={statusColorFor(a.tasks[Math.min(i,a.tasks.length-1)])} strokeWidth="2" opacity=".78"/>
        );
      });
      b.offsets.forEach((off,i)=>{
        transitions.push(
          <path key={`b-${row.project.id}-${gi}-${i}`} d={`M ${hubX} ${cy} C ${hubX+8} ${cy}, ${hubX+12} ${cy+off}, ${b.x} ${cy+off}`} fill="none" stroke={statusColorFor(b.tasks[Math.min(i,b.tasks.length-1)])} strokeWidth="2" opacity=".78"/>
        );
      });
    }

    return (
      <g key={row.project.id}>
        {y0>AXIS_H && <line x1="0" y1={y0} x2={canvasW} y2={y0} stroke="var(--border)" strokeWidth=".8" opacity=".55"/>}

        <circle cx={16} cy={cy-4} r="4.5" fill={color}/>
        <text x={27} y={cy-1} fontFamily="Inter,sans-serif" fontSize={width<520?"9":"10"} fontWeight="800" fill="var(--text-primary)">
          {(row.project.name || "").length > (width<520?10:17) ? (row.project.name || "").slice(0,width<520?9:16)+"…" : row.project.name}
        </text>

        <line x1={PAD_L-12} y1={cy} x2={canvasW-PAD_R} y2={cy} stroke={color} strokeWidth="3" strokeLinecap="round" opacity=".14"/>
        {row.groups.length > 0 && (
          <g>
            <line x1={PAD_L-12} y1={cy} x2={row.groups[0].x} y2={cy} stroke={statusColorFor(row.groups[0].tasks[0])} strokeWidth="3" strokeLinecap="round" opacity=".95"/>
            {row.groups.map((g,gi)=>{
              const next=row.groups[gi+1];
              if(!next) return null;
              return <line key={`status-widget-${row.project.id}-${gi}`} x1={g.x} y1={cy} x2={next.x} y2={cy} stroke={statusColorFor(g.tasks[0])} strokeWidth="3" strokeLinecap="round" opacity=".95"/>;
            })}
            <line x1={row.groups[row.groups.length-1].x} y1={cy} x2={canvasW-PAD_R} y2={cy} stroke={statusColorFor(row.groups[row.groups.length-1].tasks[0])} strokeWidth="3" strokeLinecap="round" opacity=".95"/>
          </g>
        )}
        {transitions}

        {row.groups.flatMap((g) => g.tasks.map((t,i) => {
          const y=cy+g.offsets[i];
          const done=isTaskDoneGlobal(t,ctx);
          const st=ctx.statuses.find((s)=>s.id===t.statusId);
          const stationColor = st?.color || color;
          const placement = g.labels?.[i] || { side:"above", lane:0, label:t.title || "Sans titre", labelW:90, labelX:g.x };
          const label = placement.label;
          const labelW = placement.labelW;
          const labelX = placement.labelX;
          const above = placement.side === "above";
          const labelY = y + (placement.labelY - g.offsets[i]);
          return (
            <g key={t.id} className="lp-widget-md-station-group" onClick={()=>onOpen(t)} style={{cursor:"pointer"}}>
              {Math.abs(g.offsets[i])>.5 && <line x1={g.x} y1={cy} x2={g.x} y2={y} stroke={stationColor} strokeWidth="1.5" strokeDasharray="2 3" opacity=".55"/>}
              <line
                x1={g.x}
                y1={y}
                x2={labelX}
                y2={above ? labelY+15 : labelY}
                stroke={stationColor}
                strokeWidth="1.25"
                strokeDasharray="2 3"
                opacity=".28"
              />
              <rect
                x={labelX-labelW/2}
                y={labelY}
                width={labelW}
                height="15"
                rx="3"
                fill="var(--surface)"
                stroke="var(--border-strong)"
                strokeWidth=".8"
                opacity="1"
              />
              <text
                x={labelX}
                y={labelY+10.4}
                textAnchor="middle"
                fontFamily="Inter,sans-serif"
                fontSize="8.4"
                fontWeight="700"
                fill="var(--text-primary)"
              >
                {label}
              </text>
              <ProjectDeadlineStationGlyph
                x={g.x}
                y={y}
                project={row.project}
                task={t}
                ctx={ctx}
                color={stationColor}
                done={done}
                radius={8}
                iconSize={10}
              />
              <title>{`${t.title} · ${fmtShort(t.end)}${st ? " · "+st.name : ""} · ${row.project.name}`}</title>
            </g>
          );
        }))}

        {row.groups.length>0 && (
          <>
            <circle cx={PAD_L-12} cy={cy} r="4.5" fill="var(--surface)" stroke={color} strokeWidth="2"/>
            <line x1={canvasW-PAD_R-7} y1={cy-6} x2={canvasW-PAD_R-7} y2={cy+6} stroke={color} strokeWidth="2"/>
            <line x1={canvasW-PAD_R-2} y1={cy-6} x2={canvasW-PAD_R-2} y2={cy+6} stroke={color} strokeWidth="2"/>
          </>
        )}
      </g>
    );
  });

  return (
    <div className="lp-widget-metro-deadline" ref={wrapRef}>
      <div className="lp-widget-md-toolbar">
        <div className="lp-widget-md-zoom">
          <span>Zoom</span>
          <button type="button" onClick={zoomOut} title="Dézoomer"><Minus size={12}/></button>
          <button type="button" onClick={zoomIn} title="Zoomer"><Plus size={12}/></button>
          <button
            type="button"
            className="lp-widget-md-zoom-value"
            onClick={resetZoom}
            title="Revenir au zoom recommandé pour l’échelle sélectionnée"
          >
            {Math.round(zoom*100)}%
          </button>
        </div>
        <div className="lp-widget-md-scale">
          {[
            ["day","Jour"],["week","Semaine"],["month","Mois"],["quarter","Trim."],["year","Année"],["auto","Auto"]
          ].map(([k,l]) => (
            <button
              key={k}
              type="button"
              className={scaleMode===k?"active":""}
              onClick={()=>selectScale(k)}
              title={`Échelle ${l} — ajuste automatiquement le zoom`}
            >
              {l}
            </button>
          ))}
        </div>
      </div>

      <div className="lp-widget-md-svgwrap" ref={scrollRef}>
        <svg width={canvasW} height={totalH} viewBox={`0 0 ${canvasW} ${totalH}`} role="img" aria-label="Métro des échéances">
          <rect x="0" y="0" width={canvasW} height={AXIS_H} fill="var(--surface)"/>
          <line x1={0} y1={AXIS_H-1} x2={canvasW} y2={AXIS_H-1} stroke="var(--border)" strokeWidth="1"/>

          {monthBands.map((b,idx) => {
            const x1=xFor(b.start), x2=xFor(b.end);
            return (
              <g key={`month-${b.start}`}>
                <rect x={x1} y={0} width={Math.max(1,x2-x1)} height={AXIS_H} fill={idx%2 ? "var(--surface)" : "var(--paper)"} opacity=".72"/>
                <text x={(x1+x2)/2} y={11} textAnchor="middle" fontFamily="Inter,sans-serif" fontSize="8" fontWeight="800" fill="var(--text-muted)">{b.label}</text>
              </g>
            );
          })}

          {tickDates.map((tk) => {
            const x=xFor(tk.date);
            return (
              <g key={tk.date}>
                <line x1={x} y1={22} x2={x} y2={totalH} stroke="var(--border)" strokeWidth={tk.major ? "1.2" : ".8"} opacity={tk.major ? ".7" : ".38"}/>
                <text x={x} y={35} textAnchor="middle" fontFamily='"Inter",monospace' fontSize="7.2" fontWeight={tk.major?"800":"650"} fill="var(--text-muted)">{formatTick(tk.date)}</text>
              </g>
            );
          })}

          {todayX >= PAD_L && todayX <= canvasW-PAD_R && (
            <g pointerEvents="none">
              <line x1={todayX} y1={AXIS_H} x2={todayX} y2={totalH} stroke="var(--accent)" strokeWidth="1.7" strokeDasharray="4 5" opacity=".7"/>
              <rect x={todayX-27} y={AXIS_H+3} width="54" height="14" rx="3" fill="var(--surface)" opacity=".97"/>
              <text x={todayX} y={AXIS_H+13} textAnchor="middle" fontFamily='"Inter",monospace' fontSize="6.8" fontWeight="800" fill="var(--accent)">AUJOURD'HUI</text>
            </g>
          )}

          {renderedRows}
        </svg>
      </div>

      <div className="lp-widget-md-foot">
        <span>{dated.length} échéance{dated.length>1?"s":""}</span>
        <span>{layouts.length} projet{layouts.length>1?"s":""}</span>
        <span>Échelle : {effectiveScale === "day" ? "jour" : effectiveScale === "week" ? "semaine" : effectiveScale === "month" ? "mois" : effectiveScale === "quarter" ? "trimestre" : "année"}</span>
      </div>
    </div>
  );
}


function WidgetMilestoneTimeline({ tasks, ctx, onOpen }) {
  const today = iso(new Date());
  const upcoming = useMemo(
    () => tasks.filter((t) => t.milestone && t.end && t.end >= today && !isTaskDoneGlobal(t, ctx)).sort((a, b) => a.end.localeCompare(b.end)).slice(0, 12),
    [tasks, ctx, today]
  );
  const isEmpty = upcoming.length === 0;

  const relLabel = (d) => {
    const n = dayIndex(d) - dayIndex(today);
    if (n === 0) return "Aujourd'hui";
    if (n === 1) return "Demain";
    if (n <= 6) return `Dans ${n} jours`;
    if (n <= 13) return "La semaine prochaine";
    return `Dans ${Math.round(n / 7)} semaines`;
  };

  // Position verticale PROPORTIONNELLE à l'écart de dates entre jalons — mais
  // toujours au moins ROW_MIN_GAP entre deux repères consécutifs, pour que des
  // jalons rapprochés (voire à la même date) ne se chevauchent jamais : on
  // calcule la position "idéale" puis on la repousse au minimum nécessaire si
  // besoin (le même principe qu'un algorithme d'évitement d'étiquettes).
  // IMPORTANT : tous les Hooks doivent être appelés à chaque rendu, dans le
  // même ordre — le early-return "aucun jalon" est donc repoussé après TOUS
  // les Hooks (voir plus bas), avec des valeurs de repli sûres ici plutôt que
  // de sauter des Hooks (ce qui provoquait un crash React dès qu'un filtre ne
  // matchait plus aucun jalon).
  const ROW_MIN_GAP = 58;
  const PX_PER_DAY = 15;
  const MAX_SPAN_HEIGHT = 640; // évite un widget interminable si les dates s'étalent sur des mois
  const GUTTER = 34; // colonne de contexte de date, à gauche du rail
  const firstIdx = isEmpty ? dayIndex(today) : dayIndex(upcoming[0].end);
  const lastIdx = isEmpty ? dayIndex(today) : dayIndex(upcoming[upcoming.length - 1].end);
  const totalDays = Math.max(1, lastIdx - firstIdx);
  const pxPerDay = Math.min(PX_PER_DAY, MAX_SPAN_HEIGHT / totalDays);
  const idealY = (d) => (dayIndex(d) - firstIdx) * pxPerDay;
  const positions = useMemo(() => {
    if (isEmpty) return [];
    let prevY = 0;
    return upcoming.map((t, i) => {
      const y = i === 0 ? idealY(t.end) : Math.max(idealY(t.end), prevY + ROW_MIN_GAP);
      prevY = y;
      return y;
    });
  }, [upcoming, isEmpty]);
  const totalHeight = isEmpty ? 0 : positions[positions.length - 1] + 44;

  // Contexte de date à gauche du rail — semaine / mois / trimestre / année
  // choisis automatiquement selon l'écart total couvert (même logique que les
  // axes des autres widgets), positionné à sa date réelle sur l'échelle
  // proportionnelle (indépendant du repoussement anti-chevauchement des jalons,
  // ce ne sont que des repères de contexte, jamais cliquables).
  const dateTicks = useMemo(() => (isEmpty ? [] : widgetAxisTicks(upcoming[0].end, upcoming[upcoming.length - 1].end)), [upcoming, isEmpty]);

  if (isEmpty) return <div className="lp-empty" style={{ padding: 16 }}>Aucun jalon à venir pour ce filtre.</div>;

  return (
    <div className="lp-widget-msltl-list">
      <div className="lp-widget-msltl-track" style={{ height: totalHeight }}>
        {dateTicks.map((tick) => (
          <div key={tick.date} className="lp-widget-msltl-tick" style={{ top: idealY(tick.date), width: GUTTER - 8 }}>{tick.label}</div>
        ))}
        <div className="lp-widget-msltl-spine" style={{ left: GUTTER + 13, top: 13, height: Math.max(0, positions[positions.length - 1]) }} />
        {upcoming.map((t, i) => {
          const proj = ctx.projects.find((p) => p.id === t.projectId);
          const color = proj?.color || "var(--text-muted)";
          const icon = resolveMilestoneIcon(t, ctx);
          return (
            <div className="lp-widget-msltl-row" key={t.id} style={{ top: positions[i], left: GUTTER }} onClick={() => onOpen(t)}>
              <div className="lp-widget-msltl-marker" style={{ borderColor: color }}>
                {icon ? <IconGlyph icon={icon} size={13} /> : <span className="lp-widget-msltl-dot" style={{ background: color }} />}
              </div>
              <div className="lp-widget-msltl-info">
                <div className="lp-widget-msltl-title">{t.title}</div>
                <div className="lp-widget-msltl-meta">
                  {proj && <div className="lp-widget-msltl-project" style={{ color }}>{proj.name}</div>}
                  <div className="lp-widget-msltl-date">{fmtShort(t.end)} · {relLabel(t.end)}</div>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  );
}


// Timeline verticale "métro" : reprend le principe de la Timeline des jalons,
// mais ajoute toutes les tâches datées avec durée. Les jalons sont des stations
// rondes ; les tâches à durée sont des tronçons épais de ligne de métro avec
// roundels blancs aux extrémités. Les libellés sont décalés verticalement par
// un algorithme anti-chevauchement et reliés à leur position temporelle réelle.
function WidgetVerticalMetroTimeline({ tasks, ctx, onOpen, onUpdateDates }) {
  const today = iso(new Date());
  const todayIdx = dayIndex(today);
  const viewportRef = useRef(null);
  const trackRef = useRef(null);
  const [viewportHeight, setViewportHeight] = useState(0);
  const [drag, setDrag] = useState(null);
  const [preview, setPreview] = useState({});
  const [hoveredId, setHoveredId] = useState(null);

  // Le widget utilise toute sa hauteur disponible. Quand le filtre ramène les
  // données sur une période courte, l'échelle temporelle s'étire au lieu de
  // laisser les éléments tassés en haut avec une grande zone vide dessous.
  useEffect(() => {
    const el = viewportRef.current;
    if (!el) return;
    const update = () => {
      const h = Math.round(el.getBoundingClientRect().height || 0);
      setViewportHeight((prev) => Math.abs(prev - h) > 2 ? h : prev);
    };
    update();
    if (typeof ResizeObserver === "undefined") return;
    const ro = new ResizeObserver(update);
    ro.observe(el);
    return () => ro.disconnect();
  }, []);

  const visible = useMemo(() => {
    return tasks
      .filter((t) => t.start && t.end && t.end >= today)
      .filter((t) => !isTaskDoneGlobal(t, ctx) || t.milestone)
      .sort((a, b) => a.start.localeCompare(b.start) || a.end.localeCompare(b.end))
      .slice(0, 40);
  }, [tasks, ctx, today]);

  const isEmpty = visible.length === 0;
  const firstDate = isEmpty ? today : visible.reduce((m, t) => (t.start < m ? t.start : m), visible[0].start);
  const lastDate = isEmpty ? today : visible.reduce((m, t) => (t.end > m ? t.end : m), visible[0].end);
  const firstIdx = dayIndex(firstDate);
  const lastIdx = Math.max(firstIdx + 1, dayIndex(lastDate));
  const spanDays = Math.max(1, lastIdx - firstIdx);
  const MIN_HEIGHT = 360;
  // Réserve une vraie zone d'en-tête à l'intérieur du graphe : les premières
  // graduations et la première station ne viennent plus se coller sous le
  // bandeau du widget.
  const TOP_PAD = 72;
  const BOTTOM_PAD = 34;

  // Hauteur réellement exploitable dans le widget (on réserve le petit footer
  // d'aide au drag). Pour une période courte, chaque jour reçoit davantage de
  // pixels afin que la première et la dernière échéance occupent naturellement
  // toute la hauteur. Pour une période longue, on conserve au minimum 6 px/jour
  // et le widget devient scrollable comme auparavant.
  const availableAxisHeight = Math.max(
    MIN_HEIGHT,
    viewportHeight > 0 ? viewportHeight - 42 : MIN_HEIGHT
  );
  const fillPxPerDay = (availableAxisHeight - TOP_PAD - BOTTOM_PAD) / spanDays;
  const PX_PER_DAY = Math.max(6, fillPxPerDay);
  const axisHeight = Math.max(
    availableAxisHeight,
    TOP_PAD + BOTTOM_PAD + spanDays * PX_PER_DAY
  );
  const yFor = (d) => TOP_PAD + (dayIndex(d) - firstIdx) * PX_PER_DAY;

  const effectiveTask = (t) => ({ ...t, ...(preview[t.id] || {}) });
  const milestones = visible.filter((t) => t.milestone).map(effectiveTask);
  const durations = visible.filter((t) => !t.milestone).map(effectiveTask);

  // One duration lane per selected/visible project. Stable ordering follows ctx.projects.
  const durationProjectIds = useMemo(() => {
    const ids = new Set(durations.map((t) => t.projectId).filter(Boolean));
    return ctx.projects.filter((p) => ids.has(p.id)).map((p) => p.id);
  }, [durations, ctx.projects]);

  const DURATION_X_BASE = 390;
  // Une largeur réellement réservée à chaque projet : les titres restent
  // centrés au-dessus de leur ligne et ne peuvent plus se chevaucher.
  const DURATION_PROJECT_GAP = 86;
  const durationXForProject = (projectId) => {
    const idx = Math.max(0, durationProjectIds.indexOf(projectId));
    return DURATION_X_BASE + idx * DURATION_PROJECT_GAP;
  };

  // Persistent milestone labels: same temporal order, evenly spaced so they never
  // collide. They stay visible at all times, unlike duration details.
  const milestoneLabelLayout = useMemo(() => {
    const ordered = milestones
      .map((t) => ({ t, ideal:yFor(t.end) }))
      .sort((a,b) => a.ideal - b.ideal);

    const MIN_GAP = 42;
    const TOP = TOP_PAD;
    const BOTTOM = Math.max(TOP, axisHeight - BOTTOM_PAD);
    if (!ordered.length) return {};

    // First pass: forward packing.
    const ys = [];
    ordered.forEach((item, i) => {
      ys[i] = i === 0 ? Math.max(TOP, item.ideal) : Math.max(item.ideal, ys[i-1] + MIN_GAP);
    });

    // If packed beyond bottom, redistribute evenly over the available height.
    if (ys[ys.length - 1] > BOTTOM && ordered.length > 1) {
      const step = Math.max(MIN_GAP, (BOTTOM - TOP) / (ordered.length - 1));
      for (let i = 0; i < ordered.length; i++) ys[i] = TOP + i * step;
    }

    return Object.fromEntries(ordered.map((item, i) => [item.t.id, {
      ideal:item.ideal,
      y:ys[i],
      side:i % 2 === 0 ? "left" : "right",
    }]));
  }, [milestones, firstIdx, PX_PER_DAY, axisHeight]);

  const dateTicks = useMemo(() => {
    if (isEmpty) return [];
    const raw = widgetAxisTicks(firstDate,lastDate);
    if (raw.length <= 1) return raw;

    // Les graduations sont verticales : on impose un espacement visuel minimal,
    // indépendamment du pas temporel choisi par widgetAxisTicks.
    const MIN_TICK_GAP_PX = 28;
    const kept = [];
    raw.forEach((tick,idx)=>{
      const y = TOP_PAD + (dayIndex(tick.date)-firstIdx)*PX_PER_DAY;
      const prev = kept[kept.length-1];
      const isFirst = idx === 0;
      const isLast = idx === raw.length - 1;
      if (isFirst || !prev || y - prev._y >= MIN_TICK_GAP_PX) {
        kept.push({...tick,_y:y});
      } else if (isLast && kept.length) {
        // La dernière date reste visible, mais remplace la précédente si elles
        // seraient trop proches visuellement.
        kept[kept.length-1] = {...tick,_y:y};
      }
    });
    return kept.map(({_y,...tick})=>tick);
  }, [isEmpty, firstDate, lastDate, firstIdx, PX_PER_DAY]);

  const totalHeight = Math.max(
    axisHeight,
    ...Object.values(milestoneLabelLayout).map((x) => x.y + 30),
    380
  );

  const relativeDate = (start, end, milestone) => {
    if (milestone) {
      const n = dayIndex(end) - todayIdx;
      if (n === 0) return "Aujourd’hui";
      if (n === 1) return "Demain";
      if (n > 1 && n < 7) return `J+${n}`;
      return fmtShort(end);
    }
    if (start <= today && end >= today) return `En cours · jusqu’au ${fmtShort(end)}`;
    return `${fmtShort(start)} → ${fmtShort(end)}`;
  };

  const dateFromPointer = (clientY) => {
    const rect = trackRef.current?.getBoundingClientRect();
    if (!rect) return today;
    const y = clientY - rect.top;
    const idx = firstIdx + Math.round((y - TOP_PAD) / PX_PER_DAY);
    return addDays(firstDate, idx - firstIdx);
  };

  const beginDrag = (e, t, mode) => {
    e.preventDefault();
    e.stopPropagation();
    const task = effectiveTask(t);
    setDrag({
      taskId:t.id,
      mode,
      originalStart:task.start,
      originalEnd:task.end,
      pointerDate:dateFromPointer(e.clientY)
    });
    setPreview((p) => ({ ...p, [t.id]: { start:task.start, end:task.end } }));
  };

  useEffect(() => {
    if (!drag) return;

    const onMove = (e) => {
      const current = dateFromPointer(e.clientY);
      const delta = dayIndex(current) - dayIndex(drag.pointerDate);
      let nextStart = drag.originalStart;
      let nextEnd = drag.originalEnd;

      if (drag.mode === "move") {
        nextStart = addDays(drag.originalStart, delta);
        nextEnd = addDays(drag.originalEnd, delta);
      } else if (drag.mode === "start") {
        nextStart = current <= drag.originalEnd ? current : drag.originalEnd;
      } else if (drag.mode === "end") {
        nextEnd = current >= drag.originalStart ? current : drag.originalStart;
      } else if (drag.mode === "milestone") {
        nextStart = current;
        nextEnd = current;
      }

      setPreview((p) => ({ ...p, [drag.taskId]: { start:nextStart, end:nextEnd } }));
    };

    const onUp = () => {
      const patch = preview[drag.taskId];
      if (patch && onUpdateDates) onUpdateDates(drag.taskId, patch);
      setDrag(null);
      setPreview((p) => {
        const n = { ...p };
        delete n[drag.taskId];
        return n;
      });
    };

    window.addEventListener("pointermove", onMove);
    window.addEventListener("pointerup", onUp, { once:true });
    return () => {
      window.removeEventListener("pointermove", onMove);
      window.removeEventListener("pointerup", onUp);
    };
  }, [drag, preview, firstIdx, PX_PER_DAY, firstDate, onUpdateDates]);

  if (isEmpty) {
    return <div className="lp-widget-vmetro-empty">Aucun jalon ou événement daté à venir pour ce filtre.</div>;
  }

  const minWidth = 560 + Math.max(0, durationProjectIds.length - 1) * DURATION_PROJECT_GAP + 120;

  return (
    <div ref={viewportRef} className="lp-widget-vmetro">
      <div
        ref={trackRef}
        className="lp-widget-vmetro-track"
        style={{ height:totalHeight, minWidth }}
      >
        <div className="lp-widget-vmetro-column-title milestones">Jalons</div>
        <div className="lp-widget-vmetro-column-title events">Jalons & repères</div>
        <div className="lp-widget-vmetro-column-title durations">Durées par projet</div>

        <div className="lp-widget-vmetro-axis milestones" />

        {durationProjectIds.map((projectId) => {
          const p = ctx.projects.find((x) => x.id === projectId);
          const x = durationXForProject(projectId);
          const color = p?.color || "var(--line-blue)";
          return (
            <React.Fragment key={"lane-" + projectId}>
              <div
                className="lp-widget-vmetro-project-lane"
                style={{ left:x, "--vmetro-color":color }}
              />
              <div
                className="lp-widget-vmetro-project-lane-label"
                style={{ left:x, "--vmetro-color":color }}
                title={p?.name || ""}
              >
                {p?.name || "Projet"}
              </div>
            </React.Fragment>
          );
        })}

        {dateTicks.map((tick) => (
          <div key={tick.date} className="lp-widget-vmetro-tick" style={{ top:yFor(tick.date) }}>
            {tick.label}
          </div>
        ))}

        {today >= firstDate && today <= lastDate && (
          <>
            <div className="lp-widget-vmetro-today-label" style={{ top:yFor(today) }}>Aujourd’hui</div>
            <div className="lp-widget-vmetro-today-line" style={{ top:yFor(today) }} />
          </>
        )}

        {milestones.map((t) => {
          const proj = ctx.projects.find((p) => p.id === t.projectId);
          const color = proj?.color || "var(--line-blue)";
          const icon = resolveMilestoneIcon(t, ctx);
          return (
            <div
              key={"station-" + t.id}
              className={
                "lp-widget-vmetro-milestone lp-widget-vmetro-focusable" +
                (hoveredId && hoveredId !== t.id ? " is-dimmed" : "") +
                (hoveredId === t.id ? " is-focused" : "")
              }
              style={{ top:yFor(t.end), "--vmetro-color":color, cursor:"ns-resize" }}
              onMouseEnter={() => setHoveredId(t.id)}
              onMouseLeave={() => setHoveredId(null)}
              onPointerDown={(e) => beginDrag(e, t, "milestone")}
              onDoubleClick={() => onOpen(t)}
              title={`${t.title} · glisser pour déplacer le jalon`}
            >
              {icon ? <IconGlyph icon={icon} size={10} /> : <span className="lp-widget-vmetro-milestone-inner" />}
            </div>
          );
        })}

        {milestones.map((t) => {
          const proj = ctx.projects.find((p) => p.id === t.projectId);
          const st = ctx.statuses.find((s) => s.id === t.statusId);
          const color = proj?.color || "var(--line-blue)";
          const layout = milestoneLabelLayout[t.id];
          if (!layout) return null;
          const anchorX = 94;
          const labelX = 104;
          const dx = labelX - anchorX;
          const dy = layout.y - layout.ideal;
          const len = Math.sqrt(dx*dx + dy*dy);
          const angle = Math.atan2(dy,dx) * 180 / Math.PI;

          return (
            <React.Fragment key={"milabel-" + t.id}>
              <div
                className={
                  "lp-widget-vmetro-link lp-widget-vmetro-focusable" +
                  (hoveredId && hoveredId !== t.id ? " is-dimmed" : "") +
                  (hoveredId === t.id ? " is-focused" : "")
                }
                style={{
                  left:anchorX,
                  top:layout.ideal,
                  width:len,
                  transform:`rotate(${angle}deg)`,
                  "--link-color":color
                }}
              />
              <div
                className={
                  "lp-widget-vmetro-milestone-label lp-widget-vmetro-focusable " + layout.side +
                  (hoveredId && hoveredId !== t.id ? " is-dimmed" : "") +
                  (hoveredId === t.id ? " is-focused" : "")
                }
                style={{ top:layout.y, "--vmetro-color":color }}
                onMouseEnter={() => setHoveredId(t.id)}
                onMouseLeave={() => setHoveredId(null)}
                onClick={() => onOpen(t)}
              >
                <div className="lp-widget-vmetro-milestone-label-title">{t.title}</div>
                <div className="lp-widget-vmetro-milestone-label-meta">
                  {relativeDate(t.start,t.end,true)}
                  {proj ? ` · ${proj.name}` : ""}
                  {st ? ` · ${st.name}` : ""}
                </div>
              </div>
            </React.Fragment>
          );
        })}

        {durations.map((t) => {
          const proj = ctx.projects.find((p) => p.id === t.projectId);
          const st = ctx.statuses.find((s) => s.id === t.statusId);
          const color = proj?.color || "var(--line-blue)";
          const x = durationXForProject(t.projectId);
          const y1 = yFor(t.start);
          const y2 = yFor(t.end);
          const h = Math.max(28, y2 - y1);
          const done = isTaskDoneGlobal(t, ctx);
          const late = isTaskLate(t, ctx);
          const isDragging = drag?.taskId === t.id;

          return (
            <div
              key={"bar-" + t.id}
              className={
                "lp-widget-vmetro-duration lp-widget-vmetro-focusable" +
                (done ? " done" : "") +
                (late ? " late" : "") +
                (isDragging ? " dragging" : "") +
                (hoveredId && hoveredId !== t.id ? " is-dimmed" : "") +
                (hoveredId === t.id ? " is-focused" : "")
              }
              style={{ left:x, top:y1, height:h, background:color, "--vmetro-color":color }}
              onMouseEnter={() => setHoveredId(t.id)}
              onMouseLeave={() => setHoveredId(null)}
              onPointerDown={(e) => beginDrag(e, t, "move")}
              onDoubleClick={() => onOpen(t)}
              title=""
            >
              <span
                className="lp-widget-vmetro-duration-handle start"
                onPointerDown={(e) => beginDrag(e, t, "start")}
              />
              <span
                className="lp-widget-vmetro-duration-handle end"
                onPointerDown={(e) => beginDrag(e, t, "end")}
              />
              <div className="lp-widget-vmetro-duration-tooltip">
                <div className="lp-widget-vmetro-tooltip-title">{t.title}</div>
                <div className="lp-widget-vmetro-tooltip-meta">
                  {relativeDate(t.start,t.end,false)}
                  {proj ? ` · ${proj.name}` : ""}
                  {st ? ` · ${st.name}` : ""}
                  {late ? " · En retard" : ""}
                </div>
              </div>
            </div>
          );
        })}
      </div>

      <div className="lp-widget-vmetro-drag-hint">
        <span>Jalons : informations persistantes</span>
        <span>Durées : détails au survol</span>
        <span>Glisser = déplacer · extrémités = début / fin</span>
      </div>
    </div>
  );
}

// Tâches les plus bloquantes : classe par ordre décroissant les tâches non
// terminées qui bloquent le plus d'autres tâches (elles-mêmes non terminées) via
// le champ dependsOn — avec, pour chacune, le détail des tâches qu'elle bloque.
function WidgetBlockers({ tasks, ctx, onOpen }) {
  const notDone = useMemo(() => tasks.filter((t) => !isTaskDoneGlobal(t, ctx)), [tasks, ctx]);
  const blockers = useMemo(() => {
    const byId = Object.fromEntries(notDone.map((t) => [t.id, t]));
    const blockedBy = {}; // blockerId -> [tâches bloquées]
    notDone.forEach((t) => {
      (t.dependsOn || []).forEach((depId) => {
        if (byId[depId]) (blockedBy[depId] = blockedBy[depId] || []).push(t);
      });
    });
    return Object.entries(blockedBy)
      .map(([id, blocked]) => ({ task: byId[id], blocked }))
      .filter((b) => b.task)
      .sort((a, b) => b.blocked.length - a.blocked.length)
      .slice(0, 10);
  }, [notDone]);

  if (blockers.length === 0) return <div className="lp-empty" style={{ padding: 16 }}>Aucune tâche bloquante pour ce filtre — pas de dépendance en cours entre tâches non terminées.</div>;

  return (
    <div className="lp-widget-blockers">
      {blockers.map(({ task: t, blocked }, i) => {
        const proj = ctx.projects.find((p) => p.id === t.projectId);
        const late = isTaskLate(t, ctx);
        return (
          <div className="lp-widget-blockers-row" key={t.id} onClick={() => onOpen(t)}>
            <span className="lp-widget-blockers-rank">{i + 1}</span>
            <div className="lp-widget-blockers-info">
              <div className="lp-widget-blockers-title">
                {proj && <span className="lp-widget-minigantt-dot" style={{ background: proj.color || "var(--text-muted)" }} />}
                {t.title}
                {late && <AlertTriangle size={11} className="lp-widget-blockers-late-icon" />}
              </div>
              <div className="lp-widget-blockers-detail">bloque {blocked.map((b) => b.title).join(", ")}</div>
            </div>
            <span className="lp-widget-blockers-count">{blocked.length}</span>
          </div>
        );
      })}
    </div>
  );
}

// Widget "Next Best Action" : détermine l'action la plus utile à réaliser
// maintenant parmi toutes les tâches éligibles, et explique pourquoi. Le moteur
// (getNextBestAction) est totalement séparé de ce composant, qui ne fait que
// l'afficher et gérer les interactions (§20 de la demande).
function WidgetNextBestAction({ tasks, ctx, onOpen }) {
  const [showWhy, setShowWhy] = useState(false);
  const [showAlternatives, setShowAlternatives] = useState(false);
  const { candidates, blocked } = useMemo(() => getNextBestAction({ tasks, ctx }), [tasks, ctx]);

  if (candidates.length === 0 && blocked.length === 0) {
    return (
      <div className="lp-widget-nba-empty">
        <CheckCircle2 size={22} color="var(--success)" />
        <div className="lp-widget-nba-empty-title">Tout est à jour</div>
        <div className="lp-widget-nba-empty-sub">Aucune action en attente ne requiert ton attention.</div>
      </div>
    );
  }
  if (candidates.length === 0) {
    return (
      <div className="lp-widget-nba-empty">
        <Lock size={22} color="var(--text-muted)" />
        <div className="lp-widget-nba-empty-title">Tout est bloqué</div>
        <div className="lp-widget-nba-empty-sub">{blocked.length} tâche{blocked.length > 1 ? "s" : ""} en attente d'une dépendance non terminée — aucune n'est exécutable dans l'immédiat.</div>
      </div>
    );
  }

  const top = candidates[0];
  if (top.totalScore < NBA_WEIGHTS.noHighImpactThreshold) {
    return (
      <div className="lp-widget-nba-empty">
        <Search size={20} color="var(--text-muted)" />
        <div className="lp-widget-nba-empty-title">Aucune action à fort impact</div>
        <div className="lp-widget-nba-empty-sub">Rien ne se distingue particulièrement pour l'instant parmi les {candidates.length} tâche{candidates.length > 1 ? "s" : ""} disponible{candidates.length > 1 ? "s" : ""}.</div>
      </div>
    );
  }

  const proj = ctx.projects.find((p) => p.id === top.task.projectId);
  const st = ctx.statuses.find((s) => s.id === top.task.statusId);
  const reasonIcon = (icon) => {
    if (icon === "late" || icon === "due") return <AlertTriangle size={11} />;
    if (icon === "block") return <Zap size={11} />;
    if (icon === "critical") return <Network size={11} />;
    if (icon === "milestone") return <Milestone size={11} />;
    if (icon === "quick") return <CheckCircle2 size={11} />;
    return null;
  };
  const impactLabel = top.totalScore >= 70 ? "HIGH IMPACT" : top.totalScore >= 40 ? "MEDIUM IMPACT" : "LOW IMPACT";
  const alternatives = candidates.slice(1, 5);

  return (
    <div className="lp-widget-nba">
      <div className="lp-widget-nba-card">
        <div className="lp-widget-nba-title" onClick={() => onOpen(top.task)}>{top.task.title}</div>
        <div className="lp-widget-nba-project">
          {proj && <span className="lp-project-dot" style={{ background: proj.color || "var(--text-muted)", width: 12, height: 12 }} />}
          {proj?.name}{st ? ` · ${st.name}` : ""}
        </div>
        <div className="lp-widget-nba-scorebar-row">
          <div className="lp-widget-nba-scorebar-track"><div className="lp-widget-nba-scorebar-fill" style={{ width: `${top.totalScore}%` }} /></div>
          <span className="lp-widget-nba-scoreval">{top.totalScore}</span>
        </div>
        <span className={"lp-widget-nba-impact-tag" + (top.totalScore >= 70 ? " high" : top.totalScore >= 40 ? " medium" : " low")}>{impactLabel}</span>
        <div className="lp-widget-nba-reasons">
          {top.reasons.map((r, i) => (
            <div className="lp-widget-nba-reason" key={i}>{reasonIcon(r.icon)} {r.text}</div>
          ))}
        </div>
        <div className="lp-widget-nba-effort">{top.effortDays > 0 ? `Estimation : ${top.effortDays} jour${top.effortDays > 1 ? "s" : ""}` : "Effort inconnu"}</div>
        <div className="lp-widget-nba-actions">
          <button className="lp-btn lp-btn-primary" onClick={() => onOpen(top.task)}>Commencer</button>
          <button className="lp-btn" onClick={() => setShowWhy((v) => !v)}>Pourquoi ?</button>
        </div>
        {showWhy && (
          <div className="lp-widget-nba-why">
            <div className="lp-widget-nba-why-title">Pourquoi cette tâche ?</div>
            {[
              ["Urgence", top.factors.urgency, 40],
              ["Impact sur les dépendances", top.factors.dependencyImpact, 55],
              ["Chemin critique", top.factors.criticalPathScore, 25],
              ["Impact jalon", top.factors.milestoneScore, 20],
              ["Priorité du projet", top.factors.projectImportanceScore, 15],
            ].map(([label, val, max]) => (
              <div className="lp-widget-nba-why-row" key={label}>
                <span className="lp-widget-nba-why-label">{label}</span>
                <div className="lp-widget-nba-why-track"><div className="lp-widget-nba-why-fill" style={{ width: `${max ? (val / max) * 100 : 0}%` }} /></div>
                <span className="lp-widget-nba-why-val">{val > 0 ? "+" : ""}{val}</span>
              </div>
            ))}
            {top.factors.effortPenalty > 0 && (
              <div className="lp-widget-nba-why-row">
                <span className="lp-widget-nba-why-label">Pénalité d'effort</span>
                <div className="lp-widget-nba-why-track"><div className="lp-widget-nba-why-fill lp-widget-nba-why-fill-neg" style={{ width: `${(top.factors.effortPenalty / 18) * 100}%` }} /></div>
                <span className="lp-widget-nba-why-val">−{top.factors.effortPenalty}</span>
              </div>
            )}
            <div className="lp-widget-nba-why-summary">
              {top.blockedCount > 0 && <div>{top.blockedCount} tâche{top.blockedCount > 1 ? "s dépendent" : " dépend"} de cette action.</div>}
              <div>Impact potentiel : {top.totalScore >= 70 ? "élevé" : top.totalScore >= 40 ? "moyen" : "faible"}.</div>
            </div>
          </div>
        )}
      </div>
      {alternatives.length > 0 && (
        <div className="lp-widget-nba-alts">
          <button className="lp-widget-nba-alts-toggle" onClick={() => setShowAlternatives((v) => !v)}>
            <ChevronRight size={12} style={{ transform: showAlternatives ? "rotate(90deg)" : "none" }} /> Autres actions recommandées
          </button>
          {showAlternatives && (
            <div className="lp-widget-nba-alts-list">
              {alternatives.map((c, i) => (
                <div className="lp-widget-nba-alt-row" key={c.task.id} onClick={() => onOpen(c.task)}>
                  <span className="lp-widget-nba-alt-rank">{i + 2}</span>
                  <span className="lp-widget-nba-alt-title">{c.task.title}</span>
                  <span className="lp-widget-nba-alt-score">{c.totalScore}</span>
                </div>
              ))}
            </div>
          )}
        </div>
      )}
    </div>
  );
}

// Widget "Daily Briefing" : synthèse opérationnelle du jour. Le moteur
// (getDailyBriefing) est séparé de l'affichage ; il réutilise directement le
// moteur Next Best Action sans dupliquer de logique de priorisation.
function WidgetDailyBriefing({ tasks, ctx, onOpen, onViewDay, activityLog }) {
  const [openAlert, setOpenAlert] = useState(null);
  const briefing = useMemo(() => getDailyBriefing({ tasks, ctx, activityLog }), [tasks, ctx, activityLog]);
  const dateLabel = new Date(briefing.date + "T00:00:00").toLocaleDateString("fr-FR", { weekday: "long", day: "numeric", month: "long" });

  const summaryText = {
    none: "Rien ne requiert d'attention immédiate aujourd'hui.",
    calm: "La journée s'annonce calme.",
    busy: "Journée chargée — plusieurs points à surveiller.",
    critical: "Attention requise sur plusieurs points aujourd'hui.",
  }[briefing.priorityLevel];

  return (
    <div className="lp-widget-briefing">
      <div className="lp-widget-briefing-date">{dateLabel}</div>
      <div className="lp-widget-briefing-summary">{summaryText}</div>

      {briefing.alerts.length > 0 && (
        <div className="lp-widget-briefing-alerts">
          {briefing.alerts.map((a) => (
            <div key={a.key}>
              <div className="lp-widget-briefing-alert" onClick={() => setOpenAlert((k) => (k === a.key ? null : a.key))}>
                <span>{a.icon} {a.label}</span>
                <ChevronRight size={12} style={{ transform: openAlert === a.key ? "rotate(90deg)" : "none" }} />
              </div>
              {openAlert === a.key && (
                <div className="lp-widget-briefing-alert-list">
                  {(a.tasks || []).slice(0, 8).map((t) => (
                    <div key={t.id} className="lp-widget-briefing-alert-item" onClick={() => onOpen(t)}>{t.title}</div>
                  ))}
                  {(a.projects || []).slice(0, 8).map((p) => (
                    <div key={p.id} className="lp-widget-briefing-alert-item" onClick={() => onOpen(null)}>
                      <span className="lp-project-dot" style={{ background: p.color || "var(--text-muted)", width: 10, height: 10, marginRight: 5 }} />{p.name}
                    </div>
                  ))}
                </div>
              )}
            </div>
          ))}
        </div>
      )}

      {briefing.todayItems.length > 0 && (
        <div className="lp-widget-briefing-section">
          <div className="lp-widget-briefing-section-title">Aujourd'hui</div>
          {briefing.todayItems.slice(0, 6).map((t) => {
            const proj = ctx.projects.find((p) => p.id === t.projectId);
            return (
              <div className="lp-widget-briefing-item" key={t.id} onClick={() => onOpen(t)}>
                {t.milestone ? <Milestone size={12} /> : <span className="lp-project-dot" style={{ background: proj?.color || "var(--text-muted)", width: 10, height: 10 }} />}
                <span className="lp-widget-briefing-item-title">{t.title}</span>
                {proj && <span className="lp-widget-briefing-item-proj">{proj.name}</span>}
              </div>
            );
          })}
        </div>
      )}

      {briefing.recentChanges.length > 0 && (
        <div className="lp-widget-briefing-section">
          <div className="lp-widget-briefing-section-title">Changements récents (24h)</div>
          {briefing.recentChanges.map((c) => (
            <div className="lp-widget-briefing-change" key={c.key}>{c.icon} {c.text}</div>
          ))}
        </div>
      )}


      {briefing.nextBestAction && (
        <div className="lp-widget-briefing-nba">
          <div className="lp-widget-briefing-section-title"><Zap size={11} style={{ verticalAlign: -2 }} /> Next Best Action</div>
          <div className="lp-widget-briefing-nba-title" onClick={() => onOpen(briefing.nextBestAction.task)}>{briefing.nextBestAction.task.title}</div>
          {briefing.nextBestAction.reasons.slice(0, 2).map((r, i) => (
            <div key={i} className="lp-widget-briefing-nba-reason">→ {r.text}</div>
          ))}
        </div>
      )}

      {onViewDay && (
        <button className="lp-btn" style={{ width: "100%" }} onClick={onViewDay}>Voir la journée</button>
      )}
    </div>
  );
}

const PM_LEVEL_META = {
  veryHigh: { label: "TRÈS ÉLEVÉ", arrow: "↗", cls: "very-high" },
  high: { label: "ÉLEVÉ", arrow: "↗", cls: "high" },
  stable: { label: "STABLE", arrow: "→", cls: "stable" },
  low: { label: "FAIBLE", arrow: "↘", cls: "low" },
  critical: { label: "CRITIQUE", arrow: "↓", cls: "critical" },
};


// Mini radar : version compacte de la vue Radar (planning circulaire annuel) —
// chaque tâche devient un arc sur l'année, réparti sur quelques anneaux pour
// limiter les recouvrements, les jalons en losanges sur le pourtour. Survol
// pour le détail, clic pour ouvrir — même langage que les autres widgets.
// Widget "Domino Effect" : classe les tâches par effet d'entraînement réel
// (combien de travail elles débloquent), pas seulement par urgence — repose sur
// getDominoEffect, qui réutilise le même graphe de dépendances que Next Best
// Action. Reste lisible avec beaucoup de tâches grâce à un simple classement
// (plutôt qu'un graphe de nœuds, qui deviendrait illisible au-delà de
// quelques éléments) — la même liste sert de vue desktop et mobile.
/* Réglages d'affichage du Mini-Gantt — UN SEUL formulaire, servi à la fois par
   la fiche du widget et par les réglages de la vue pleine page.

   Les deux en portaient chacun leur copie, et elles avaient divergé : la vue
   ignorait l'inactivité et les champs personnalisés dans le regroupement, ne
   validait pas la fenêtre à dates fixes, et avait perdu en route toutes les
   explications de la fiche (#86). Un composant partagé rend la divergence
   impossible : un réglage ajouté ici apparaît des deux côtés.

   Contrat : `value` porte les MÊMES clés que le widget enregistré, `onChange`
   reçoit un correctif partiel de ces clés. La fiche du widget les range dans
   son état local jusqu'à l'enregistrement, la vue les écrit aussitôt dans ses
   préférences — le formulaire, lui, ne connaît que les clés. */
function MiniGanttDisplayFields({ value, onChange, ctx, scope }) {
  const fields = value.miniGanttFields || MINI_GANTT_DEFAULTS.miniGanttFields;
  const fieldsLayout = value.miniGanttFieldsLayout === "inline" ? "inline" : "aligned";
  const sortKey = normalizeMiniGanttSort(value.miniGanttSort);
  const sortDir = normalizeMiniGanttSortDir(value.miniGanttSortDir);
  const range = normalizeMiniGanttRange(value.miniGanttRange);
  const windowStart = value.miniGanttWindow?.start || "";
  const windowEnd = value.miniGanttWindow?.end || "";
  const windowError = miniGanttWindowMessage(range, windowStart, windowEnd);
  const colorBy = value.colorBy === "project" || value.colorBy === "taskType" ? value.colorBy : "status";
  const patchRange = (patch) => onChange({ miniGanttRange: normalizeMiniGanttRange({ ...range, ...patch }) });
  const patchWindow = (patch) => onChange({ miniGanttWindow: { start: windowStart, end: windowEnd, ...patch } });
  const toggleField = (key) => onChange({ miniGanttFields: fields.includes(key) ? fields.filter((f) => f !== key) : [...fields, key] });
  return (
    <>
      <p style={{ fontSize: 12, color: "var(--text-600)", marginTop: -6, marginBottom: 8 }}>Choisis un ou plusieurs projets ci-dessous — chaque tâche affiche le projet en label si plusieurs sont mélangés.</p>
      <div className="lp-field">
        <label>Grouper par <span style={{ fontWeight: 400, textTransform: "none", color: "var(--text-600)" }}>(sections repliables, qui distinguent visuellement les tâches)</span></label>
        <select value={value.groupBy || "none"} onChange={(e) => onChange({ groupBy: e.target.value })}>
          {miniGanttGroupByKeys(ctx).map((key) => (
            <option key={key} value={key}>{key === "none" ? "Aucun regroupement" : fieldLabel(key, ctx)}</option>
          ))}
        </select>
      </div>
      <label className="lp-checkbox-line">
        <input type="checkbox" checked={value.showMilestones !== false} onChange={(e) => onChange({ showMilestones: e.target.checked })} /> Afficher les jalons (avec leur émoji propre s'ils en ont un)
      </label>
      {/* Le trait vertical d'un jalon ne se règle PAS ici : c'est un choix
          propre à chaque repère, dans les Annotations, jalon par jalon (#95).
          Un réglage unique pour tout le diagramme imposait le trait sous tous
          les jalons ou sous aucun. */}
      <div className="lp-field" style={{ marginTop: 10 }}>
        <label>Couleur des barres</label>
        <div className="lp-density-row">
          <button type="button" className={"lp-density-btn" + (colorBy === "status" ? " active" : "")} onClick={() => onChange({ colorBy: "status" })}>Par statut</button>
          <button type="button" className={"lp-density-btn" + (colorBy === "project" ? " active" : "")} onClick={() => onChange({ colorBy: "project" })}>Par projet</button>
          <button type="button" className={"lp-density-btn" + (colorBy === "taskType" ? " active" : "")} onClick={() => onChange({ colorBy: "taskType" })}>Par type</button>
        </div>
      </div>
      <div className="lp-field" style={{ marginTop: 10 }}>
        <label>Informations affichées à côté de la barre</label>
        <p style={{ fontSize: 11.5, color: "var(--text-600)", marginTop: -2, marginBottom: 6 }}>Chaque champ garde la même mise en forme (pastille, badge, format de date…) que partout ailleurs dans Nexora.</p>
        {MINIGANTT_ROW_FIELD_OPTIONS.map((f) => (
          <label className="lp-checkbox-line" key={f}>
            <input type="checkbox" checked={fields.includes(f)} onChange={() => toggleField(f)} /> {fieldLabel(f, ctx)}
          </label>
        ))}
      </div>
      <div className="lp-field" style={{ marginTop: 10 }}>
        <label>Disposition de ces informations</label>
        <div className="lp-density-row">
          <button type="button" className={"lp-density-btn" + (fieldsLayout === "aligned" ? " active" : "")} onClick={() => onChange({ miniGanttFieldsLayout: "aligned" })}>Alignées à droite</button>
          <button type="button" className={"lp-density-btn" + (fieldsLayout === "inline" ? " active" : "")} onClick={() => onChange({ miniGanttFieldsLayout: "inline" })}>À la suite de la barre</button>
        </div>
      </div>
      <div className="lp-field" style={{ marginTop: 10 }}>
        <label>Ordre des lignes</label>
        <div className="lp-density-row">
          {MINIGANTT_SORT_KEYS.map((k) => (
            <button key={k} type="button" className={"lp-density-btn" + (sortKey === k ? " active" : "")} onClick={() => onChange({ miniGanttSort: k })}>
              {MINIGANTT_SORT_LABELS[k]}
            </button>
          ))}
        </div>
        <div className="lp-density-row" style={{ marginTop: 6 }}>
          <button type="button" className={"lp-density-btn" + (sortDir === "asc" ? " active" : "")} onClick={() => onChange({ miniGanttSortDir: "asc" })}>Croissant</button>
          <button type="button" className={"lp-density-btn" + (sortDir === "desc" ? " active" : "")} onClick={() => onChange({ miniGanttSortDir: "desc" })}>Décroissant</button>
        </div>
        <p style={{ fontSize: 11.5, color: "var(--text-600)", marginTop: 6, marginBottom: 0 }}>
          À position égale dans le tri, les jalons passent devant les barres — quel que soit le sens.
        </p>
      </div>
      <div className="lp-field" style={{ marginTop: 10 }}>
        <label>Étendue temporelle</label>
        <div className="lp-density-row">
          <button type="button" className={"lp-density-btn" + (range.mode === "auto" ? " active" : "")} onClick={() => patchRange({ mode: "auto" })}>Automatique</button>
          <button type="button" className={"lp-density-btn" + (range.mode === "rolling" ? " active" : "")} onClick={() => patchRange({ mode: "rolling" })}>Fenêtre glissante</button>
          <button type="button" className={"lp-density-btn" + (range.mode === "fixed" ? " active" : "")} onClick={() => patchRange({ mode: "fixed" })}>Dates fixes</button>
        </div>
        {range.mode === "auto" && (
          <>
            <label className="lp-checkbox-line" style={{ marginTop: 8 }}>
              <input type="checkbox" checked={range.includeToday} onChange={(e) => patchRange({ includeToday: e.target.checked })} />
              {" "}Toujours inclure la ligne « Aujourd'hui »
            </label>
            <p style={{ fontSize: 11.5, color: "var(--text-600)", marginTop: 6, marginBottom: 0 }}>
              L'axe couvre exactement l'étendue des tâches affichées. Décoché, un diagramme entièrement passé ou entièrement futur se cadre sur ses tâches et perd son repère du jour.
            </p>
          </>
        )}
        {range.mode === "rolling" && (
          <>
            <div className="lp-row2" style={{ marginTop: 8 }}>
              <div className="lp-field">
                <label>Mois avant aujourd'hui</label>
                <input type="number" min="0" max={MINIGANTT_RANGE_MAX_MONTHS} value={range.beforeMonths} onChange={(e) => patchRange({ beforeMonths: e.target.value })} />
              </div>
              <div className="lp-field">
                <label>Mois après aujourd'hui</label>
                <input type="number" min="0" max={MINIGANTT_RANGE_MAX_MONTHS} value={range.afterMonths} onChange={(e) => patchRange({ afterMonths: e.target.value })} />
              </div>
            </div>
            <p style={{ fontSize: 11.5, color: "var(--text-600)", marginTop: 6, marginBottom: 0 }}>
              L'axe suit le calendrier : la fenêtre avance toute seule jour après jour. Une tâche hors fenêtre n'est pas dessinée.
            </p>
          </>
        )}
        {range.mode === "fixed" && (
          <>
            <div className="lp-row2" style={{ marginTop: 8 }}>
              <div className="lp-field">
                <label>Du</label>
                <input type="date" value={windowStart} onChange={(e) => patchWindow({ start: e.target.value })} />
              </div>
              <div className="lp-field">
                <label>Au</label>
                <input type="date" value={windowEnd} min={windowStart || undefined} onChange={(e) => patchWindow({ end: e.target.value })} />
              </div>
            </div>
            {windowError && <p className="lp-gantt-annot-error">{windowError}</p>}
            <p style={{ fontSize: 11.5, color: "var(--text-600)", marginTop: 6, marginBottom: 0 }}>
              L'axe ne bouge plus. Les boutons − / Auto / + de la barre d'outils relâchent ce cadrage.
            </p>
          </>
        )}
      </div>
      <div className="lp-field" style={{ marginTop: 10 }}>
        <label>Mode d'affichage</label>
        <div className="lp-density-row">
          <button type="button" className={"lp-density-btn" + (value.miniGanttComparisonEnabled ? "" : " active")} onClick={() => onChange({ miniGanttComparisonEnabled: false })}>Standard</button>
          <button type="button" className={"lp-density-btn" + (value.miniGanttComparisonEnabled ? " active" : "")} onClick={() => onChange({ miniGanttComparisonEnabled: true })}>Comparaison</button>
        </div>
        <p style={{ fontSize: 11.5, color: "var(--text-600)", marginTop: 6, marginBottom: 0 }}>
          En mode Comparaison, les tâches dont la fiche porte des dates de référence affichent la période initiale en arrière-plan, la période actuelle au premier plan, et l'écart en jours. Les autres gardent le rendu standard.
          {scope === "view" ? " Ce réglage est propre à la vue Gantt et se retient d'une session à l'autre." : " Ce réglage est propre à ce widget et suit sa duplication."}
        </p>
      </div>
    </>
  );
}


/* Réglages d'affichage du widget « Bulles » (#92) — UN SEUL formulaire, comme
   `MiniGanttDisplayFields` dont il est le pendant (la leçon de #86 : deux
   copies d'un formulaire divergent toujours). Contrat identique : `value`
   porte les MÊMES clés que le widget enregistré, `onChange` reçoit un
   correctif partiel de ces clés.

   Tout ce qui concerne le CADRAGE — étendue temporelle, fenêtre à dates fixes,
   ordre des lignes — passe par les normalisateurs du Mini-Gantt, sans copie :
   c'est le même axe, ce sont donc les mêmes réglages, et un widget qui change
   de type les garde. */
/* Réglages du widget « Charge personnel » (#124).

   La SÉLECTION DE PERSONNES est propre au widget, et c'est le point : deux
   widgets côte à côte suivent deux équipes différentes. Aucune personne cochée
   veut dire « tout le monde » — et non « personne », qui ferait d'un widget
   neuf une grille vide sans rien expliquer. */
function StaffingDisplayFields({ value, onChange, ctx }) {
  const cfg = normalizeStaffingWidget(value);
  const [newMember, setNewMember] = useState("");
  const team = (ctx.teamMembers || [])
    .filter((m) => m && String(m.name || "").trim())
    .map((m) => ({ name: String(m.name).trim(), color: m.color || "" }));
  const toggleMember = (name) => {
    const on = cfg.staffingMembers.includes(name);
    onChange({ staffingMembers: on ? cfg.staffingMembers.filter((n) => n !== name) : [...cfg.staffingMembers, name] });
  };
  /* Une personne AJOUTÉE À LA MAIN n'entre pas dans l'annuaire (#124) : un
     intérimaire, un sous-traitant, quelqu'un qui n'a pas de compte. L'inscrire
     dans Réglages › Utilisateurs pour le planifier reviendrait à lui ouvrir
     Nexora. */
  const [newColor, setNewColor] = useState(STAFFING_COLOR_CHOICES[0]);
  const addMember = () => {
    const name = newMember.trim();
    if (!name) return;
    onChange({ staffingExtraMembers: [...cfg.staffingExtraMembers, { name, color: newColor }] });
    setNewMember("");
  };
  const removeMember = (name) => onChange({
    staffingExtraMembers: cfg.staffingExtraMembers.filter((m) => m.name !== name),
  });
  /* Recolorer quelqu'un ne touche QUE sa couleur : le nom est la cle de ses
     affectations, et le reecrire ici les detacherait de leur personne. */
  const recolorMember = (name, color) => onChange({
    staffingExtraMembers: cfg.staffingExtraMembers.map((m) => (m.name === name ? { ...m, color } : m)),
  });
  return (
    <>
      <div className="lp-field" style={{ marginTop: 10 }}>
        <label>Granularité par défaut</label>
        <div className="lp-density-row">
          {STAFFING_RANGES.map((r) => (
            <button
              key={r}
              type="button"
              className={"lp-density-btn" + (cfg.staffingRange === r ? " active" : "")}
              onClick={() => onChange({ staffingRange: r, staffingOffset: 0 })}
            >
              {staffingRangeLabel(r)}
            </button>
          ))}
        </div>
        <p style={{ fontSize: 11.5, color: "var(--text-600)", marginTop: 6, marginBottom: 0 }}>
          La navigation se fait ensuite période par période depuis le widget, et son bouton « Aujourd'hui » y revient.
        </p>
        {cfg.staffingRange === "custom" && (
          <>
            <div style={{ display: "flex", gap: 6, marginTop: 8 }}>
              <label style={{ flex: "1 1 0", minWidth: 0, display: "flex", flexDirection: "column", gap: 3 }}>
                <span style={{ fontSize: 11, fontWeight: 700, color: "var(--text-600)" }}>Début</span>
                <input type="date" value={cfg.staffingStart} onChange={(e) => onChange({ staffingStart: e.target.value, staffingOffset: 0 })} />
              </label>
              <label style={{ flex: "1 1 0", minWidth: 0, display: "flex", flexDirection: "column", gap: 3 }}>
                <span style={{ fontSize: 11, fontWeight: 700, color: "var(--text-600)" }}>Fin</span>
                <input type="date" value={cfg.staffingEnd} onChange={(e) => onChange({ staffingEnd: e.target.value, staffingOffset: 0 })} />
              </label>
            </div>
            <p style={{ fontSize: 11.5, color: "var(--text-600)", marginTop: 6, marginBottom: 0 }}>
              {!cfg.staffingStart || !cfg.staffingEnd
                ? "Tant que l’une des deux dates manque, le widget montre le mois en cours."
                : "Les flèches font ensuite glisser la plage de sa propre durée. Au-delà de " + STAFFING_CUSTOM_MAX_DAYS + " jours, elle est ramenée à cette longueur : les colonnes tomberaient sous le pixel."}
            </p>
          </>
        )}
      </div>

      <div className="lp-field" style={{ marginTop: 10 }}>
        <label>Personnes affichées</label>
        <p style={{ fontSize: 11.5, color: "var(--text-600)", marginTop: -2, marginBottom: 6 }}>
          {cfg.staffingMembers.length === 0
            ? "Aucune coche : personne n’est affiché. Coche les personnes à suivre, ou ajoute-en à la main plus bas."
            : `${cfg.staffingMembers.length} personne${cfg.staffingMembers.length > 1 ? "s" : ""} sur ${team.length}.`}
        </p>
        {team.length === 0 && (
          <p style={{ fontSize: 11.5, color: "var(--text-600)", margin: 0 }}>
            Aucun utilisateur : ajoute des personnes dans Réglages › Utilisateurs.
          </p>
        )}
        {team.map((member) => (
          <label className="lp-checkbox-line" key={member.name}>
            <input
              type="checkbox"
              checked={cfg.staffingMembers.includes(member.name)}
              onChange={() => toggleMember(member.name)}
            /> {member.name}
          </label>
        ))}
        {team.length > 0 && (
          <button
            type="button"
            className="lp-btn lp-btn-mini"
            style={{ marginTop: 6 }}
            onClick={() => onChange({ staffingMembers: cfg.staffingMembers.length === team.length ? [] : team.map((m) => m.name) })}
          >
            {cfg.staffingMembers.length === team.length ? "Tout décocher" : "Tout cocher"}
          </button>
        )}
      </div>

      <div className="lp-field" style={{ marginTop: 10 }}>
        <label>Personnes ajoutées à la main</label>
        <p style={{ fontSize: 11.5, color: "var(--text-600)", marginTop: -2, marginBottom: 6 }}>
          Quelqu'un qui n'a pas de compte Nexora — intérimaire, sous-traitant, renfort. Ces personnes
          n'existent que dans ce widget, et l'inscrire dans Réglages › Utilisateurs reviendrait à lui
          ouvrir l'application.
        </p>
        {cfg.staffingExtraMembers.map((person) => (
          <div className="lp-cp-person-row" key={person.name}>
            <div className="lp-manage-item" style={{ flex: "1 1 auto", minWidth: 0 }}>
              <span
                className="lp-workshop-swatch"
                style={{ background: person.color || staffingMemberColor(person.name), borderRadius: "50%" }}
                aria-hidden="true"
              />
              <span className="lp-manage-name">{person.name}</span>
              <button className="lp-icon-btn" onClick={() => removeMember(person.name)} aria-label={"Retirer " + person.name}>
                <Trash2 size={15} />
              </button>
            </div>
            <div className="lp-cp-draft-colors">
              {STAFFING_COLOR_CHOICES.map((c) => (
                <button
                  key={c}
                  type="button"
                  className={"lp-cp-swatch" + ((person.color || staffingMemberColor(person.name)) === c ? " is-on" : "")}
                  style={{ background: c }}
                  aria-label={"Couleur " + c + " pour " + person.name}
                  aria-pressed={(person.color || staffingMemberColor(person.name)) === c}
                  onClick={() => recolorMember(person.name, c)}
                />
              ))}
            </div>
          </div>
        ))}
        <div style={{ display: "flex", gap: 6, marginTop: 6 }}>
          <input
            type="text"
            value={newMember}
            onChange={(e) => setNewMember(e.target.value)}
            onKeyDown={(e) => { if (e.key === "Enter") { e.preventDefault(); addMember(); } }}
            placeholder="Ex. Intérim — Sofiane"
            aria-label="Nom de la personne à ajouter"
            style={{ flex: "1 1 auto", minWidth: 0 }}
          />
          <button type="button" className="lp-btn" onClick={addMember} disabled={!newMember.trim()}>Ajouter</button>
        </div>
        <div className="lp-cp-draft-colors" style={{ marginTop: 6 }}>
          {STAFFING_COLOR_CHOICES.map((c) => (
            <button
              key={c}
              type="button"
              className={"lp-cp-swatch" + (newColor === c ? " is-on" : "")}
              style={{ background: c }}
              aria-label={"Couleur " + c + " pour la personne à ajouter"}
              aria-pressed={newColor === c}
              onClick={() => setNewColor(c)}
            />
          ))}
        </div>
      </div>

      <div className="lp-field" style={{ marginTop: 10 }}>
        <label>Affichage</label>
        <label className="lp-checkbox-line">
          <input type="checkbox" checked={cfg.staffingShowWeekends} onChange={(e) => onChange({ staffingShowWeekends: e.target.checked })} /> Afficher les week-ends
        </label>
        <label className="lp-checkbox-line">
          <input type="checkbox" checked={cfg.staffingShowLoad} onChange={(e) => onChange({ staffingShowLoad: e.target.checked })} /> Colonne « Postes » à droite
        </label>
        <p style={{ fontSize: 11.5, color: "var(--text-600)", marginTop: 6, marginBottom: 0 }}>
          Un week-end masqué reste affectable depuis une autre granularité : la case disparaît de la vue, jamais l'affectation.
        </p>
      </div>
    </>
  );
}

function BubblesDisplayFields({ value, onChange, ctx }) {
  const cfg = normalizeBubblesWidget(value || {});
  const sortKey = normalizeMiniGanttSort(value.miniGanttSort);
  const sortDir = normalizeMiniGanttSortDir(value.miniGanttSortDir);
  const range = normalizeMiniGanttRange(value.miniGanttRange);
  const windowStart = value.miniGanttWindow?.start || "";
  const windowEnd = value.miniGanttWindow?.end || "";
  const windowError = miniGanttWindowMessage(range, windowStart, windowEnd);
  const patchRange = (patch) => onChange({ miniGanttRange: normalizeMiniGanttRange({ ...range, ...patch }) });
  const patchWindow = (patch) => onChange({ miniGanttWindow: { start: windowStart, end: windowEnd, ...patch } });
  const toggleField = (key) => onChange({
    bubbleFields: cfg.bubbleFields.includes(key)
      ? cfg.bubbleFields.filter((f) => f !== key)
      : [...cfg.bubbleFields, key],
  });
  return (
    <>
      <p style={{ fontSize: 12, color: "var(--text-600)", marginTop: -6, marginBottom: 8 }}>
        Chaque tâche devient une bulle posée sur l'axe du temps, à sa date et à sa durée. Les champs cochés plus bas se rangent sous la bulle.
      </p>
      <div className="lp-field">
        <label>Grouper par <span style={{ fontWeight: 400, textTransform: "none", color: "var(--text-600)" }}>(sections repliables, qui séparent visuellement les bulles)</span></label>
        <select value={value.groupBy || "none"} onChange={(e) => onChange({ groupBy: e.target.value })}>
          {miniGanttGroupByKeys(ctx).map((key) => (
            <option key={key} value={key}>{key === "none" ? "Aucun regroupement" : fieldLabel(key, ctx)}</option>
          ))}
        </select>
      </div>
      <div className="lp-field">
        <label>Colorer par <span style={{ fontWeight: 400, textTransform: "none", color: "var(--text-600)" }}>(indépendant du regroupement)</span></label>
        <select value={cfg.bubbleColorBy} onChange={(e) => onChange({ bubbleColorBy: e.target.value })}>
          {miniGanttGroupByKeys(ctx).filter((key) => key !== "none").map((key) => (
            <option key={key} value={key}>{fieldLabel(key, ctx)}</option>
          ))}
        </select>
        <p style={{ fontSize: 11.5, color: "var(--text-600)", marginTop: 4, marginBottom: 0 }}>
          La bulle prend la couleur de sa valeur — celle du statut, du projet, du type ou de la criticité. Un champ dont les valeurs n'ont pas de couleur à elles (responsable, période…) reçoit une teinte stable, la même partout pour la même valeur.
        </p>
      </div>
      <label className="lp-checkbox-line">
        <input type="checkbox" checked={cfg.bubbleShowLegend} onChange={(e) => onChange({ bubbleShowLegend: e.target.checked })} /> Afficher la légende des couleurs (cliquer un rang met son groupe en avant)
      </label>
      <label className="lp-checkbox-line">
        <input type="checkbox" checked={cfg.bubbleTruncateTitles} onChange={(e) => onChange({ bubbleTruncateTitles: e.target.checked })} /> Tronquer les titres
      </label>
      <p style={{ fontSize: 11.5, color: "var(--text-600)", marginTop: -2, marginBottom: 8 }}>
        {cfg.bubbleTruncateTitles
          ? "Un titre trop long est coupé à deux lignes — une seule en hauteur compacte. Décoche pour l’afficher en entier : les bulles gagnent alors la hauteur nécessaire."
          : "Les titres s’affichent en entier, sur autant de lignes qu’il faut. Toutes les lignes prennent la hauteur du titre le plus long, pour que la grille ne se lise pas en escalier."}
      </p>
      <label className="lp-checkbox-line">
        <input type="checkbox" checked={value.showMilestones !== false} onChange={(e) => onChange({ showMilestones: e.target.checked })} /> Afficher les jalons (bulle compacte centrée sur leur date, avec leur icône propre)
      </label>
      <div className="lp-field" style={{ marginTop: 10 }}>
        <label>Dans la bulle</label>
        <label className="lp-checkbox-line">
          <input type="checkbox" checked={cfg.bubbleShowProgress} onChange={(e) => onChange({ bubbleShowProgress: e.target.checked })} /> Statut et avancement en pied de bulle
        </label>
        <label className="lp-checkbox-line">
          <input type="checkbox" checked={cfg.bubbleShowDescription} onChange={(e) => onChange({ bubbleShowDescription: e.target.checked })} /> Description de la tâche
        </label>
        {/* Réglage sans objet tant que la description n'est pas affichée : il
            n'apparaît qu'alors, plutôt que d'occuper le formulaire pour rien. */}
        {cfg.bubbleShowDescription && (
          <div className="lp-field" style={{ marginTop: 6, marginBottom: 2 }}>
            <label>Lignes de description</label>
            <div className="lp-density-row">
              {[1, 2, 3].map((n) => (
                <button
                  key={n}
                  type="button"
                  className={"lp-density-btn" + (cfg.bubbleDescriptionLines === n ? " active" : "")}
                  onClick={() => onChange({ bubbleDescriptionLines: n })}
                >
                  {n} ligne{n > 1 ? "s" : ""}
                </button>
              ))}
            </div>
            <p style={{ fontSize: 11.5, color: "var(--text-600)", marginTop: 6, marginBottom: 0 }}>
              La bulle gagne la hauteur des lignes demandées : le statut et l'avancement en pied restent visibles.
            </p>
          </div>
        )}
        <label className="lp-checkbox-line">
          <input type="checkbox" checked={cfg.bubbleShowDates} onChange={(e) => onChange({ bubbleShowDates: e.target.checked })} /> Dates de début et de fin aux extrémités
        </label>
      </div>
      <div className="lp-field" style={{ marginTop: 10 }}>
        <label>Hauteur des bulles</label>
        <div className="lp-density-row">
          {BUBBLE_SIZES.map((size) => (
            <button
              key={size}
              type="button"
              className={"lp-density-btn" + (cfg.bubbleSize === size ? " active" : "")}
              onClick={() => onChange({ bubbleSize: size })}
            >
              {size === "compact" ? "Compacte" : size === "large" ? "Haute" : "Normale"}
            </button>
          ))}
        </div>
      </div>
      <div className="lp-field" style={{ marginTop: 10 }}>
        <label>Champs affichés</label>
        <p style={{ fontSize: 11.5, color: "var(--text-600)", marginTop: -2, marginBottom: 6 }}>
          Chaque champ garde la même mise en forme (pastille, badge, format de date…) que partout ailleurs dans Nexora. Un champ vide ne laisse pas de trou.
        </p>
        {BUBBLE_ROW_FIELD_OPTIONS.map((f) => (
          <label className="lp-checkbox-line" key={f}>
            <input type="checkbox" checked={cfg.bubbleFields.includes(f)} onChange={() => toggleField(f)} /> {fieldLabel(f, ctx)}
          </label>
        ))}
      </div>
      <div className="lp-field" style={{ marginTop: 10 }}>
        <label>Disposition de ces champs</label>
        <div className="lp-density-row">
          <button type="button" className={"lp-density-btn" + (cfg.bubbleFieldsLayout === "compact" ? " active" : "")} onClick={() => onChange({ bubbleFieldsLayout: "compact" })}>Condensée, rattachée</button>
          <button type="button" className={"lp-density-btn" + (cfg.bubbleFieldsLayout === "under" ? " active" : "")} onClick={() => onChange({ bubbleFieldsLayout: "under" })}>Sous la bulle</button>
          <button type="button" className={"lp-density-btn" + (cfg.bubbleFieldsLayout === "inline" ? " active" : "")} onClick={() => onChange({ bubbleFieldsLayout: "inline" })}>À la suite de la bulle</button>
        </div>
        <p style={{ fontSize: 11.5, color: "var(--text-600)", marginTop: 6, marginBottom: 0 }}>
          {bubbleEffectiveFieldsLayout(cfg) === "compact" && cfg.bubbleFieldsLayout !== "compact"
            ? "En couloirs, les champs prennent la forme condensée : c'est la seule qui ne déborde pas sur la bulle voisine."
            : "Condensée : une seule ligne collée sous la bulle, à sa largeur exacte, valeurs séparées par un point médian."}
        </p>
      </div>
      <div className="lp-field" style={{ marginTop: 10 }}>
        <label>Disposition des bulles</label>
        <div className="lp-density-row">
          <button type="button" className={"lp-density-btn" + (cfg.bubbleLayout === "lanes" ? " active" : "")} onClick={() => onChange({ bubbleLayout: "lanes" })}>Côte à côte (couloirs)</button>
          <button type="button" className={"lp-density-btn" + (cfg.bubbleLayout === "rows" ? " active" : "")} onClick={() => onChange({ bubbleLayout: "rows" })}>Une tâche, une ligne</button>
        </div>
        <p style={{ fontSize: 11.5, color: "var(--text-600)", marginTop: 6, marginBottom: 0 }}>
          En couloirs, les bulles d'un même regroupement se rangent au maximum côte à côte sur la ligne de temps ; on ne descend d'une ligne que lorsque deux d'entre elles se chevauchent.
        </p>
      </div>
      <div className="lp-field" style={{ marginTop: 10 }}>
        <label>Ordre des lignes</label>
        <div className="lp-density-row">
          {MINIGANTT_SORT_KEYS.map((k) => (
            <button key={k} type="button" className={"lp-density-btn" + (sortKey === k ? " active" : "")} onClick={() => onChange({ miniGanttSort: k })}>
              {MINIGANTT_SORT_LABELS[k]}
            </button>
          ))}
        </div>
        <div className="lp-density-row" style={{ marginTop: 6 }}>
          <button type="button" className={"lp-density-btn" + (sortDir === "asc" ? " active" : "")} onClick={() => onChange({ miniGanttSortDir: "asc" })}>Croissant</button>
          <button type="button" className={"lp-density-btn" + (sortDir === "desc" ? " active" : "")} onClick={() => onChange({ miniGanttSortDir: "desc" })}>Décroissant</button>
        </div>
      </div>
      <div className="lp-field" style={{ marginTop: 10 }}>
        <label>Étendue temporelle</label>
        <div className="lp-density-row">
          <button type="button" className={"lp-density-btn" + (range.mode === "auto" ? " active" : "")} onClick={() => patchRange({ mode: "auto" })}>Automatique</button>
          <button type="button" className={"lp-density-btn" + (range.mode === "rolling" ? " active" : "")} onClick={() => patchRange({ mode: "rolling" })}>Fenêtre glissante</button>
          <button type="button" className={"lp-density-btn" + (range.mode === "fixed" ? " active" : "")} onClick={() => patchRange({ mode: "fixed" })}>Dates fixes</button>
        </div>
        {range.mode === "auto" && (
          <label className="lp-checkbox-line" style={{ marginTop: 8 }}>
            <input type="checkbox" checked={range.includeToday} onChange={(e) => patchRange({ includeToday: e.target.checked })} />
            {" "}Toujours inclure la ligne « Aujourd'hui »
          </label>
        )}
        {range.mode === "rolling" && (
          <div className="lp-row2" style={{ marginTop: 8 }}>
            <div className="lp-field">
              <label>Mois avant aujourd'hui</label>
              <input type="number" min="0" max={MINIGANTT_RANGE_MAX_MONTHS} value={range.beforeMonths} onChange={(e) => patchRange({ beforeMonths: e.target.value })} />
            </div>
            <div className="lp-field">
              <label>Mois après aujourd'hui</label>
              <input type="number" min="0" max={MINIGANTT_RANGE_MAX_MONTHS} value={range.afterMonths} onChange={(e) => patchRange({ afterMonths: e.target.value })} />
            </div>
          </div>
        )}
        {range.mode === "fixed" && (
          <div className="lp-row2" style={{ marginTop: 8 }}>
            <div className="lp-field">
              <label>Du</label>
              <input type="date" value={windowStart} onChange={(e) => patchWindow({ start: e.target.value })} />
            </div>
            <div className="lp-field">
              <label>Au</label>
              <input type="date" value={windowEnd} min={windowStart || undefined} onChange={(e) => patchWindow({ end: e.target.value })} />
            </div>
          </div>
        )}
        {windowError && <p className="lp-gantt-annot-error">{windowError}</p>}
      </div>
    </>
  );
}

/* Éditeur des macro-bulles. Plusieurs par widget, chacune avec son libellé, sa
   couleur, son habillage et sa multisélection de tâches AVEC RECHERCHE —
   `GanttTaskMultiSelect`, la liste déjà utilisée par les encadrés du Gantt :
   elle groupe par projet, compte les tâches retenues et signale celles qui ont
   disparu. La réécrire aurait donné une seconde ergonomie pour le même geste. */
function BubbleMacrosEditor({ macros, tasks, ctx, onChange }) {
  const list = normalizeBubbleMacros(macros);
  const [open, setOpen] = useState(false);
  const [editingId, setEditingId] = useState(null);
  const [pendingDelete, setPendingDelete] = useState(null);
  const knownTaskIds = useMemo(() => new Set(tasks.map((t) => t.id)), [tasks]);

  const patchMacro = (id, values) => onChange(list.map((m) => (m.id === id ? { ...m, ...values } : m)));
  const move = (id, dir) => {
    const i = list.findIndex((m) => m.id === id);
    const j = i + dir;
    if (i < 0 || j < 0 || j >= list.length) return;
    const next = [...list];
    [next[i], next[j]] = [next[j], next[i]];
    onChange(next);
  };
  const add = () => {
    const created = {
      id: uid(), label: "Nouvelle macro-bulle", color: BUBBLE_MACRO_DEFAULT_COLOR,
      opacity: BUBBLE_MACRO_DEFAULT_OPACITY, borderStyle: "solid",
      borderWidth: BUBBLE_MACRO_DEFAULT_BORDER_WIDTH, taskIds: [], showProgress: true,
    };
    onChange([...list, created]);
    setOpen(true);
    setEditingId(created.id);
  };
  const duplicate = (macro) => {
    const copy = { ...macro, id: uid(), label: `${macro.label} (copie)` };
    const i = list.findIndex((m) => m.id === macro.id);
    onChange([...list.slice(0, i + 1), copy, ...list.slice(i + 1)]);
    setEditingId(copy.id);
  };

  return (
    <>
      <MiniGanttListSection
        icon={<Layers size={13} />} title="Macro-bulles" count={list.length}
        hint="Une enveloppe colorée autour des bulles de plusieurs tâches : une phase, un lot, un chantier. Elle vit dans ce widget et ne modifie aucune tâche. L'ordre ci-dessous est celui de l'imbrication et du regroupement des lignes."
        open={open} onToggle={() => setOpen((o) => !o)} onAdd={add} addLabel="Ajouter une macro-bulle"
      >
        {list.map((macro) => {
          const check = validateBubbleMacro(macro);
          const missing = macro.taskIds.filter((id) => !knownTaskIds.has(id));
          return (
            <MiniGanttAnnotationRow
              key={macro.id} item={macro} list={list} editing={editingId === macro.id}
              onToggleEdit={() => setEditingId(editingId === macro.id ? null : macro.id)}
              onMove={(dir) => move(macro.id, dir)}
              onDuplicate={() => duplicate(macro)}
              onDelete={() => setPendingDelete(macro)}
              warning={!check.ok}
              swatch={<span className="lp-bubble-macro-swatch" style={{ background: bubbleMacroFill(macro), borderColor: macro.color }} />}
              title={macro.label || "Sans libellé"}
              subtitle={macro.taskIds.length === 0
                ? "aucune tâche — non dessinée"
                : `${macro.taskIds.length} tâche${macro.taskIds.length > 1 ? "s" : ""}${missing.length ? ` · ${missing.length} introuvable${missing.length > 1 ? "s" : ""}` : ""}`}
            >
              <div className="lp-field">
                <label>Libellé</label>
                <input type="text" value={macro.label} onChange={(e) => patchMacro(macro.id, { label: e.target.value })} placeholder="Phase essais, Lot 1, Marche probatoire…" />
              </div>
              {!check.ok && <p className="lp-gantt-annot-error">{check.error}</p>}
              <div className="lp-field">
                <label>Couleur</label>
                <ColorPicker value={macro.color} onChange={(color) => patchMacro(macro.id, { color })} />
              </div>
              <GanttBlockOpacityRow
                block={{ ...macro, kind: "phase" }}
                onChange={(values) => patchMacro(macro.id, values)}
              />
              <GanttAnnotationBorderRow value={macro.borderStyle} onChange={(borderStyle) => patchMacro(macro.id, { borderStyle })} />
              <GanttBlockBorderWidthRow block={macro} onChange={(values) => patchMacro(macro.id, values)} />
              <label className="lp-checkbox-line">
                <input type="checkbox" checked={macro.showProgress !== false} onChange={(e) => patchMacro(macro.id, { showProgress: e.target.checked })} /> Afficher l'avancement agrégé (moyenne pondérée par la durée)
              </label>
              <GanttTaskMultiSelect
                tasks={tasks} ctx={ctx} value={macro.taskIds}
                onChange={(taskIds) => patchMacro(macro.id, { taskIds })}
                label="Tâches rattachées"
                hint="Les tâches non successives produisent plusieurs enveloppes."
              />
            </MiniGanttAnnotationRow>
          );
        })}
      </MiniGanttListSection>
      {pendingDelete && (
        <ConfirmModal
          title="Supprimer cette macro-bulle ?"
          message={`« ${pendingDelete.label || "Sans libellé"} » ne sera plus dessinée. Les tâches qu'elle rassemblait ne changent pas.`}
          confirmLabel="Supprimer"
          onConfirm={() => { onChange(list.filter((m) => m.id !== pendingDelete.id)); setPendingDelete(null); }}
          onClose={() => setPendingDelete(null)}
        />
      )}
    </>
  );
}
/* Vue principale : elle adapte uniquement la persistance de vue au contrat du
   widget. Toute la préparation temporelle et le rendu restent dans
   WidgetMiniGantt, ce qui interdit un second moteur Gantt. */
function MiniGanttViewSettings({ prefs, setPrefs, tasks, ctx, onClose }) {
  const annotations = ganttAnnotationsOf(prefs);
  // Même règle que la modale du widget : une tâche-jalon n'a qu'une date de
  // fin, l'exiger des deux côtés vidait les sélecteurs (#94).
  const datedTasks = (tasks || []).filter((task) => task.start || task.end);
  const defaultStart = datedTasks.reduce((value, task) => (task.start && task.start < value ? task.start : value), iso(new Date()));
  const defaultEnd = datedTasks.reduce((value, task) => (task.end && task.end > value ? task.end : value), iso(new Date()));
  const patchAnnotations = (patch) => setPrefs({ ganttAnnotations: { ...annotations, ...patch } });
  return (
    <Modal title="Réglages de la vue Gantt" onClose={onClose} wide footer={<button className="lp-btn lp-btn-primary" onClick={onClose}>Terminé</button>}>
      {/* Exactement le formulaire de la fiche du widget — mêmes réglages, mêmes
          libellés, mêmes explications, même validation des dates fixes : c'est
          LE MÊME composant, pas une copie qui pourrait s'en écarter (#86). */}
      <div className="lp-widget-config-section">
        <div className="lp-widget-config-title"><Settings size={12} /> Affichage</div>
        <MiniGanttDisplayFields value={prefs} onChange={setPrefs} ctx={ctx} scope="view" />
      </div>
      {/* Le filtre du widget, à l'identique : c'est le même composant de
          formulaire, donc les mêmes champs et les mêmes règles. Il resserre ce
          que la page laisse passer, il ne s'y substitue pas. */}
      <div className="lp-widget-config-section">
        <div className="lp-widget-config-title"><Search size={12} /> Filtrer les tâches prises en compte</div>
        <TaskFilterFields
          filter={{ ...widgetDefaultFilter(), ...(prefs.filter || {}) }}
          setFilter={(next) => setPrefs({ filter: typeof next === "function" ? next({ ...widgetDefaultFilter(), ...(prefs.filter || {}) }) : next })}
          ctx={ctx}
        />
      </div>
      <div className="lp-widget-config-section"><div className="lp-widget-config-title"><StickyNote size={12} /> Annotations</div>
        <p style={{ fontSize: 12, color: "var(--text-600)", marginTop: -6, marginBottom: 8 }}>
          Les annotations ci-dessous sont enregistrées avec la vue Gantt : elles la suivent d'une session à l'autre, sans jamais modifier les tâches.
        </p>
        <MiniGanttAnnotationsEditor blocks={annotations.temporalBlocks || []} frames={annotations.highlightFrames || []} milestones={annotations.milestones || []} risks={collectTaskDelayRisks(tasks || [])} notes={annotations.notes || []} spans={annotations.spans || []} allowSpans tasks={datedTasks} ctx={ctx} defaultStart={defaultStart} defaultEnd={defaultEnd} onChange={patchAnnotations} /></div>
    </Modal>
  );
}

function MiniGanttView({ tasks, ctx, onOpen, setTasks, prefs, setPrefs, metaBlocks, toolbarSlot }) {
  const widget = normalizeMiniGanttViewPrefs(prefs);
  const [settingsOpen, setSettingsOpen] = useState(false);
  /* Le filtre de la vue s'applique EN PLUS de ceux de la page, jamais à leur
     place : `tasks` arrive déjà filtré par la page, on ne fait que resserrer. */
  const scoped = useMemo(
    () => (widget.filter ? applyWidgetFilter(tasks || [], widget.filter, ctx) : (tasks || [])),
    [tasks, widget.filter, ctx]
  );
  return (
    <section className="lp-minigantt-view" aria-label="Gantt">
      <WidgetMiniGantt
        widget={widget}
        tasks={scoped}
        ctx={ctx}
        /* La vue occupe la page : elle montre TOUT ce que les filtres laissent
           passer, sans le plafond des tuiles de tableau de bord (#115). */
        showAllRows
        groupBy={widget.groupBy}
        onOpen={onOpen}
        onUpdateWidget={(patch) => setPrefs(patch)}
        onUpdateTask={(taskId, patch) => setTasks((prev) => prev.map((task) => task.id === taskId ? { ...task, ...patch, lastInteraction: new Date().toISOString() } : task))}
        metaBlocks={metaBlocks || []}
        toolbarSlot={toolbarSlot}
        onOpenSettings={() => setSettingsOpen(true)}
      />
      {settingsOpen && <MiniGanttViewSettings prefs={widget} setPrefs={setPrefs} tasks={scoped} ctx={ctx} onClose={() => setSettingsOpen(false)} />}
    </section>
  );
}

// Widget "Chemin critique" — regroupe par projet, puis affiche chaque niveau
// du chemin (computeCriticalLevels, déjà utilisé par la vue Planning Projets
// complète) sous forme de chaîne verticale ; plusieurs tâches dans un même
// niveau = branches parallèles à égalité, affichées côte à côte.
function WidgetCriticalPath({ tasks, ctx, onOpen }) {
  const byProject = useMemo(() => {
    const groups = new Map();
    tasks.filter((t) => t.start && t.end).forEach((t) => {
      if (!groups.has(t.projectId)) groups.set(t.projectId, []);
      groups.get(t.projectId).push(t);
    });
    return [...groups.entries()]
      .map(([projectId, projTasks]) => ({ project: ctx.projects.find((p) => p.id === projectId), levels: computeCriticalLevels(projTasks) }))
      .filter((g) => g.levels.length > 0);
  }, [tasks, ctx]);

  if (byProject.length === 0) return <div className="lp-empty" style={{ padding: 16 }}>Aucun chemin critique détecté — nécessite des tâches liées par des dépendances.</div>;

  return (
    <div className="lp-widget-critpath">
      {byProject.map(({ project, levels }) => (
        <div key={project?.id || "none"}>
          <div className="lp-widget-critpath-project">
            <span className="lp-project-dot" style={{ background: project?.color || "var(--text-muted)", width: 14, height: 14, fontSize: 8 }}><IconGlyph icon={project?.icon} size={8} /></span>
            {project?.name || "Sans projet"}
          </div>
          {levels.map((levelTasks, i) => {
            const isLast = i === levels.length - 1;
            const isBranch = levelTasks.length > 1;
            return (
              <div className={"lp-widget-critpath-level" + (isBranch ? " lp-widget-critpath-level-branch" : "")} key={i}>
                {isBranch && <div className="lp-widget-critpath-branch-label"><GitBranch size={10} /> {levelTasks.length} tâches en parallèle</div>}
                <div className="lp-widget-critpath-branch-row">
                  {levelTasks.map((t) => {
                    const done = isTaskDoneGlobal(t, ctx);
                    return (
                      <div className="lp-widget-critpath-step" key={t.id} onClick={() => onOpen(t)}>
                        <div className="lp-widget-critpath-rail">
                          <div className={"lp-widget-critpath-dot" + (done ? " done" : "")} />
                          {!isLast && <div className="lp-widget-critpath-line" />}
                        </div>
                        <div className="lp-widget-critpath-info">
                          <div className="lp-widget-critpath-title">
                            {t.milestone && <MilestoneGlyph size={11} icon={resolveMilestoneIcon(t, ctx)} style={{ marginRight: 3, verticalAlign: -2 }} />}
                            {t.title}
                          </div>
                          <div className="lp-widget-critpath-dates">{t.milestone ? fmtShort(t.end) : `${fmtShort(t.start)} → ${fmtShort(t.end)}`}</div>
                        </div>
                      </div>
                    );
                  })}
                </div>
              </div>
            );
          })}
        </div>
      ))}
    </div>
  );
}


function WidgetDominoEffect({ tasks, ctx, onOpen }) {
  const [expandedId, setExpandedId] = useState(null);
  const results = useMemo(() => getDominoEffect({ tasks, ctx }), [tasks, ctx]);
  const top = results.slice(0, 8);

  if (results.length === 0) {
    return (
      <div className="lp-widget-domino-empty">
        <GitBranch size={20} color="var(--text-muted)" />
        <div className="lp-widget-domino-empty-title">Aucune chaîne de dépendances</div>
        <div className="lp-widget-domino-empty-sub">Ce filtre ne contient aucune tâche qui en bloque une autre pour l'instant.</div>
      </div>
    );
  }

  return (
    <div className="lp-widget-domino">
      <div className="lp-widget-domino-sub">See what is blocking the most work</div>
      {top.map((r, i) => {
        const t = r.task;
        const proj = ctx.projects.find((p) => p.id === t.projectId);
        const st = ctx.statuses.find((s) => s.id === t.statusId);
        const expanded = expandedId === t.id;
        return (
          <div className="lp-widget-domino-item" key={t.id}>
            <div className="lp-widget-domino-row" onClick={() => setExpandedId(expanded ? null : t.id)}>
              <span className="lp-widget-domino-rank">{i + 1}</span>
              <div className="lp-widget-domino-info">
                <div className="lp-widget-domino-title">
                  {proj && <span className="lp-project-dot" style={{ background: proj.color || "var(--text-muted)", width: 10, height: 10 }} />}
                  {t.title}
                </div>
                <div className="lp-widget-domino-meta">
                  {r.directImpact} directe{r.directImpact > 1 ? "s" : ""}{r.indirectImpact > 0 ? ` · ${r.indirectImpact} en cascade` : ""}
                  {r.onCriticalPath && " · chemin critique"}
                </div>
              </div>
              <span className="lp-widget-domino-count">{r.totalImpact}</span>
              <ChevronRight size={13} style={{ transform: expanded ? "rotate(90deg)" : "none", flex: "0 0 auto", color: "var(--text-600)" }} />
            </div>
            {expanded && (
              <div className="lp-widget-domino-detail">
                <div className="lp-widget-domino-detail-grid">
                  <div><span className="lp-widget-domino-detail-label">Statut</span><span>{st?.name || "—"}</span></div>
                  <div><span className="lp-widget-domino-detail-label">Responsable</span><span>{t.assignee || "Non assigné"}</span></div>
                  <div><span className="lp-widget-domino-detail-label">Échéance</span><span>{fmtShort(t.end)}</span></div>
                  <div><span className="lp-widget-domino-detail-label">Impact total</span><span>{r.totalImpact} tâche{r.totalImpact > 1 ? "s" : ""}</span></div>
                </div>
                {r.milestoneUnlocked && <div className="lp-widget-domino-detail-note">Débloque le jalon « {r.milestoneUnlocked.title} »</div>}
                {r.directTasks.length > 0 && (
                  <div className="lp-widget-domino-detail-deps">
                    <div className="lp-widget-domino-detail-label">Bloque directement</div>
                    {r.directTasks.slice(0, 6).map((dt) => (
                      <div key={dt.id} className="lp-widget-domino-dep-item" onClick={(e) => { e.stopPropagation(); onOpen(dt); }}>{dt.title}</div>
                    ))}
                    {r.directTasks.length > 6 && <div className="lp-widget-domino-dep-more">+{r.directTasks.length - 6} autres</div>}
                  </div>
                )}
                <button className="lp-btn lp-btn-primary" style={{ width: "100%", marginTop: 8 }} onClick={() => onOpen(t)}>Open task</button>
              </div>
            )}
          </div>
        );
      })}
    </div>
  );
}

const PROJECT_STORY_LEVEL_META = {
  major: { size: 11, weight: 800 },
  normal: { size: 9, weight: 700 },
  minor: { size: 7, weight: 600 },
};



// Widget "Budget Burn Rate" : rythme de consommation réel d'UN projet et
// autonomie budgétaire restante — réutilise calculateBudgetBurnRate, le même
// moteur que l'en-tête du tableau de bord financier, pour ne jamais dupliquer
// ce calcul entre les deux endroits où il est affiché.
function WidgetBudgetBurnRate({ widget, ctx, expenses, onOpen }) {
  const project = ctx.projects.find((p) => p.id === widget.burnRateProjectId) || ctx.projects[0];
  const br = useMemo(() => (project ? calculateBudgetBurnRate({ project, expenses }) : null), [project, expenses]);

  if (!project) return <div className="lp-empty" style={{ padding: 16 }}>Choisis un projet.</div>;
  if (!br || br.status === "noDates") {
    return (
      <div className="lp-widget-burn-empty">
        <div className="lp-widget-burn-empty-title">{project.name}</div>
        <div className="lp-widget-burn-empty-sub">Aucune dépense datée pour ce projet — le rythme de consommation n'est pas encore calculable.</div>
      </div>
    );
  }

  return (
    <div className="lp-widget-burn">
      <div className="lp-widget-burn-project" onClick={() => onOpen(null)}>{project.name}</div>
      <div className="lp-widget-burn-pct">{br.pctConsumed}%<span> du budget consommé</span></div>
      <div className="lp-widget-burn-track"><div className={"lp-widget-burn-fill" + (br.healthStatus === "over" ? " over" : br.healthStatus === "risk" ? " risk" : "")} style={{ width: `${Math.min(100, br.pctConsumed)}%` }} /></div>
      <div className="lp-widget-burn-figures">
        <div><span className="lp-widget-burn-figure-label">Dépensé</span><span className="lp-widget-burn-figure-value">{fmtEuro(br.totalSpent)}</span></div>
        <div><span className="lp-widget-burn-figure-label">Budget</span><span className="lp-widget-burn-figure-value">{fmtEuro(br.budgetActuel)}</span></div>
        <div><span className="lp-widget-burn-figure-label">Reste</span><span className={"lp-widget-burn-figure-value" + (br.remaining < 0 ? " negative" : "")}>{fmtEuro(br.remaining)}</span></div>
      </div>
      <div className="lp-widget-burn-rate">
        <span className="lp-widget-burn-rate-label">Rythme</span>
        <span className="lp-widget-burn-rate-value">{fmtEuro(br.weeklyRate)} / semaine</span>
      </div>
      {br.weeksRemaining !== null && (
        <div className={"lp-widget-burn-insight" + (br.healthStatus === "over" ? " danger" : br.healthStatus === "risk" ? " warn" : " ok")}>
          {br.healthStatus === "over"
            ? <>🔴 Dépassement de {fmtEuro(Math.abs(br.remaining))}</>
            : <>{br.healthStatus === "risk" ? "⚠️" : "✓"} ≈ {br.weeksRemaining} semaine{br.weeksRemaining > 1 ? "s" : ""} d'autonomie au rythme actuel</>}
        </div>
      )}
    </div>
  );
}

// Widget "Matrice des risques" : grille 5×5 probabilité × impact pour UN
// projet, avec le nombre de risques par case et leur détail au survol —
// réutilise le même moteur (riskScoreOf/riskLevelOf) que le registre complet.
// Anneau de progression : un cercle SVG dont la taille suit celle de la tuile.
// Défini au niveau module pour ne pas être recréé à chaque rendu du Treemap.
function TreemapProgressRing({ value, size, color, trackColor, textColor }) {
  const v = Math.max(0, Math.min(100, Number(value) || 0));
  const stroke = size >= 34 ? 3.5 : 2.5;
  const r = (size - stroke) / 2;
  const c = 2 * Math.PI * r;
  return (
    <span className="lp-widget-treemap-ring" style={{ width: size, height: size }}>
      <svg width={size} height={size} aria-hidden="true">
        <circle cx={size / 2} cy={size / 2} r={r} fill="none" stroke={trackColor} strokeWidth={stroke} />
        <circle
          cx={size / 2} cy={size / 2} r={r} fill="none" stroke={color} strokeWidth={stroke} strokeLinecap="round"
          strokeDasharray={`${(c * v) / 100} ${c}`}
          transform={`rotate(-90 ${size / 2} ${size / 2})`}
        />
      </svg>
      {textColor && size >= 30 && <span className="lp-widget-treemap-ring-text" style={{ color: textColor }}>{Math.round(v)}%</span>}
    </span>
  );
}

// Widget « Treemap projets ».
//
// UNE TUILE = UN PROJET. La surface vient du COUNT() des tâches du projet
// retenues par le filtre de taille ; la couleur du même filtre, d'un second
// filtre, ou de la criticité moyenne. `tasks` arrive déjà réduit par les
// méta-filtres, le filtre de page et le filtre du widget : ce composant ne
// refiltre jamais le périmètre, il ne fait que compter à l'intérieur.
function WidgetProjectTreemap({ widget, tasks, ctx, expenses, onOpenProject, onEditProject, onFilterProject }) {
  const cfg = useMemo(() => normalizeProjectTreemapConfig(widget), [widget]);
  const [search, setSearch] = useState("");
  const [selectedId, setSelectedId] = useState(null);
  const [activeBucket, setActiveBucket] = useState(null);
  const [hover, setHover] = useState(null);
  const [menu, setMenu] = useState(null);

  // La mosaïque est calculée sur la taille RÉELLEMENT mesurée : à aucun moment
  // une estimation ne décide du pavage, sinon les tuiles déborderaient du cadre
  // dès qu'on redimensionne le widget.
  const scrollRef = useRef(null);
  const [box, setBox] = useState({ w: 0, h: 0 });
  useEffect(() => {
    const el = scrollRef.current;
    if (!el || typeof ResizeObserver === "undefined") return;
    const measure = () => {
      const rect = el.getBoundingClientRect();
      setBox((prev) => {
        const w = Math.round(rect.width), h = Math.round(rect.height);
        return prev.w === w && prev.h === h ? prev : { w, h };
      });
    };
    measure();
    const ro = new ResizeObserver(measure);
    ro.observe(el);
    return () => ro.disconnect();
  }, []);

  const todayIdx = dayIndex(iso(new Date()));
  // Faits d'une tâche, tels que le bloc pur les attend. Toutes ces notions
  // existent déjà dans Nexora : aucune donnée n'est inventée ici.
  const factsOf = useCallback((t) => ({
    done: isTaskDoneGlobal(t, ctx),
    late: isTaskLate(t, ctx),
    urgent: isTaskUrgent(t, ctx),
    milestone: getTaskType(t) === "milestone",
    daysToDue: t.end ? dayIndex(t.end) - todayIdx : null,
    inactivityDays: taskInteractionAgeDays(t),
    // Lue sur le projet DE LA TÂCHE, pas sur l'entité de la tuile : sinon le
    // score de criticité d'une même tâche changerait selon l'axe choisi.
    projectPriority: ((ctx.projects || []).find((p) => p.id === t.projectId) || {}).priority || "normal",
  }), [ctx, todayIdx]);

  // Entités qui portent les tuiles, et rattachement d'une tâche à la sienne.
  // Les quatre champs partagent la forme { id, name, color } attendue par le
  // bloc pur ; la tuile « sans valeur » évite qu'une tâche disparaisse du
  // comptage sans qu'on puisse le voir.
  const { tileEntities, bucketIdOf } = useMemo(() => {
    if (cfg.tileBy === "status") {
      return {
        tileEntities: [...(ctx.statuses || []), { id: "__none__", name: "Sans statut", color: "#94A3B8" }],
        bucketIdOf: (t) => t.statusId || "__none__",
      };
    }
    if (cfg.tileBy === "taskType") {
      return {
        tileEntities: [...(ctx.taskTypes || []), { id: "__none__", name: "Sans type", color: "#94A3B8" }],
        bucketIdOf: (t) => t.taskTypeId || "__none__",
      };
    }
    if (cfg.tileBy === "criticality") {
      return {
        tileEntities: [...CRITICALITIES, { id: "__none__", name: "Sans criticité", color: "#94A3B8" }],
        bucketIdOf: (t) => t.criticality || "__none__",
      };
    }
    return { tileEntities: ctx.projects || [], bucketIdOf: (t) => t.projectId };
  }, [cfg.tileBy, ctx.projects, ctx.statuses, ctx.taskTypes]);
  const tilesAreProjects = cfg.tileBy === "project";

  // Les deux filtres sont évalués UNE fois sur l'ensemble du périmètre, puis
  // consultés par identifiant : pas de re-filtrage par projet ni par rendu.
  const sizeIds = useMemo(
    () => new Set(applyWidgetFilter(tasks, cfg.sizeFilter, ctx).map((t) => t.id)),
    [tasks, cfg.sizeFilter, ctx]
  );
  const colorIds = useMemo(
    () => (cfg.colorMode === "secondaryFilterGradient"
      ? new Set(applyWidgetFilter(tasks, cfg.colorFilter, ctx).map((t) => t.id))
      : sizeIds),
    [tasks, cfg.colorFilter, cfg.colorMode, ctx, sizeIds]
  );

  const extras = useMemo(() => {
    const map = {};
    // Risques et budget appartiennent au projet : sur une tuile de statut, il
    // n'y a rien à y rattacher (les champs correspondants sont d'ailleurs
    // retirés par le normalisateur).
    if (!tilesAreProjects) return map;
    (ctx.projects || []).forEach((p) => {
      const stats = computeBudgetStats(p.id, ctx.projects, expenses || []);
      map[p.id] = {
        budgetConsumed: stats.consumed,
        budgetTotal: stats.budgetActuel,
        budgetPct: stats.pct,
      };
    });
    return map;
  }, [ctx.projects, expenses, tilesAreProjects]);

  const rows = useMemo(() => computeTreemapProjects({
    projects: tileEntities,
    tasks,
    sizeMatch: (t) => sizeIds.has(t.id),
    colorMatch: (t) => colorIds.has(t.id),
    factsOf,
    extras,
    bucketIdOf,
    colorMode: cfg.colorMode,
    showZeroProjects: cfg.showZeroProjects,
  }), [tileEntities, bucketIdOf, tasks, sizeIds, colorIds, factsOf, extras, cfg.colorMode, cfg.showZeroProjects]);

  const domain = useMemo(() => treemapColorDomain(rows, cfg.colorMode), [rows, cfg.colorMode]);
  const legend = useMemo(
    () => (cfg.showLegend ? treemapLegendBuckets(rows, cfg.colorMode, cfg.palette, cfg.direction) : []),
    [rows, cfg.colorMode, cfg.palette, cfg.direction, cfg.showLegend]
  );

  const visibleRows = useMemo(() => {
    const q = search.trim().toLowerCase();
    return rows.filter((r) => {
      if (q && !String(r.project.name || "").toLowerCase().includes(q)) return false;
      if (activeBucket) {
        const bucket = legend.find((b) => b.key === activeBucket);
        if (bucket && !(r.colorValue >= bucket.min && r.colorValue < bucket.max)) return false;
      }
      return true;
    });
  }, [rows, search, activeBucket, legend]);

  const groupLabelOf = (row) => {
    if (cfg.groupBy === "folder") return (ctx.projectFolders || []).find((f) => f.id === row.project.folderId)?.name || "Sans dossier";
    if (cfg.groupBy === "priority") return { high: "Prioritaire", low: "Priorité faible" }[row.project.priority] || "Priorité normale";
    if (cfg.groupBy === "owner") return row.owner || "Non assigné";
    if (cfg.groupBy === "criticality") return row.criticality.level.label;
    return "";
  };

  const groups = useMemo(() => {
    if (cfg.groupBy === "none") return [{ key: "all", label: "", rows: visibleRows }];
    const map = new Map();
    visibleRows.forEach((r) => {
      const label = groupLabelOf(r);
      if (!map.has(label)) map.set(label, []);
      map.get(label).push(r);
    });
    return [...map.entries()]
      .map(([label, list]) => ({ key: label, label, rows: list }))
      .sort((a, b) => b.rows.length - a.rows.length || a.label.localeCompare(b.label));
  }, [visibleRows, cfg.groupBy, ctx.projectFolders]);

  const GROUP_HEADER_H = 20;
  const GROUP_GAP = 10;
  const layout = useMemo(() => {
    const W = box.w, H = box.h;
    if (W <= 0 || H <= 0) return { height: H, blocks: [] };
    const asItems = (list) => list.map((r) => ({ row: r, weight: r.weight }));
    if (cfg.groupBy === "none") {
      return { height: H, blocks: [{ key: "all", label: "", headerRect: null, tiles: squarifyTreemap(asItems(visibleRows), { x: 0, y: 0, w: W, h: H }) }] };
    }
    const rects = treemapGroupRects(groups, { x: 0, y: 0, w: W, h: H }, { headerH: GROUP_HEADER_H, gap: GROUP_GAP, minBodyH: 70 });
    const blocks = rects.map(({ group, headerRect, bodyRect }) => ({
      key: group.key,
      label: group.label,
      headerRect,
      tiles: squarifyTreemap(asItems(group.rows), bodyRect),
    }));
    const bottom = rects.length ? rects[rects.length - 1].bodyRect.y + rects[rects.length - 1].bodyRect.h : H;
    return { height: Math.max(H, bottom), blocks };
  }, [box, visibleRows, groups, cfg.groupBy]);

  const statusOfId = (id) => (ctx.statuses || []).find((s) => s.id === id);
  const memberOf = (name) => (ctx.teamMembers || []).find((m) => m.name === name);
  const fmtNumber = (n) => (Number.isInteger(n) ? n.toLocaleString("fr-FR") : Number(n).toLocaleString("fr-FR", { maximumFractionDigits: 2 }));

  // Valeur textuelle d'un champ, dans la présentation propre à son type.
  const renderField = (key, row, dark) => {
    const chipClass = "lp-widget-treemap-chip" + (dark ? " is-dark" : "");
    if (key === "dominantStatus") {
      const st = statusOfId(row.dominantStatusId);
      if (!st) return null;
      return <span className={chipClass} key={key} title={`Statut dominant : ${st.name}`}><span className="lp-widget-treemap-chip-dot" style={{ background: st.color }} />{st.name}</span>;
    }
    if (key === "owner") {
      if (!row.owner) return null;
      const u = memberOf(row.owner);
      const initials = row.owner.split(/\s+/).map((p) => p[0]).join("").slice(0, 2).toUpperCase();
      return (
        <span className={chipClass} key={key} title={`Responsable principal : ${row.owner}`}>
          <span className="lp-widget-treemap-chip-avatar" style={{ background: u?.color || "var(--text-muted)" }}>{initials}</span>
          {row.owner}
        </span>
      );
    }
    if (key === "sizeCount") return <span className={chipClass} key={key} title="Tâches retenues par le filtre de taille">{row.sizeCount} tâche{row.sizeCount > 1 ? "s" : ""}</span>;
    if (key === "colorCount") return <span className={chipClass} key={key} title="Tâches retenues par le filtre de coloration">{row.colorCount} ciblée{row.colorCount > 1 ? "s" : ""}</span>;
    if (key === "progress") return <span className={chipClass} key={key} title="Progression moyenne des tâches retenues">{row.progress}%</span>;
    if (key === "averageCriticality") {
      const lvl = row.criticality.level;
      return <span className={chipClass} key={key} title={`Criticité moyenne : ${row.criticality.score}/100`}><span className="lp-widget-treemap-chip-dot" style={{ background: lvl.color }} />{lvl.label}</span>;
    }
    if (key === "lateTaskCount") {
      if (!row.lateCount) return null;
      return <span className={chipClass} key={key} style={{ color: "var(--danger)" }} title="Tâches en retard"><AlertTriangle size={9} />{row.lateCount}</span>;
    }
    if (key === "urgentTaskCount") {
      if (!row.urgentCount) return null;
      return <span className={chipClass} key={key} style={{ color: "var(--danger)" }} title="Tâches de criticité urgente"><Flame size={9} />{row.urgentCount}</span>;
    }
    if (key === "nextMilestone") {
      if (!row.nextMilestone) return null;
      return <span className={chipClass} key={key} title={`Prochain jalon : ${row.nextMilestone.title} (${fmtShort(row.nextMilestone.date)})`}>◆ {fmtShort(row.nextMilestone.date)}</span>;
    }
    if (key === "endDate") {
      if (!row.endDate) return null;
      return <span className={chipClass} key={key} title="Dernière échéance des tâches retenues"><CalendarClock size={9} />{fmtShort(row.endDate)}</span>;
    }
    if (key === "budget") {
      if (!row.budgetTotal) return null;
      return <span className={chipClass} key={key} title={`Budget consommé : ${fmtNumber(row.budgetConsumed)} € sur ${fmtNumber(row.budgetTotal)} €`}><Wallet size={9} />{row.budgetPct}%</span>;
    }
    if (key === "priority") {
      const label = { high: "Prioritaire", low: "Priorité faible" }[row.project.priority] || "Priorité normale";
      return <span className={chipClass} key={key} title="Priorité du projet">{label}</span>;
    }
    if (key === "folder") {
      const folder = (ctx.projectFolders || []).find((f) => f.id === row.project.folderId);
      if (!folder) return null;
      return <span className={chipClass} key={key} title="Dossier du projet">{folder.name}</span>;
    }
    return null;
  };

  const openRow = (row) => { if (tilesAreProjects && cfg.openOnClick && onOpenProject) onOpenProject(row.projectId); };

  const tooltipNode = () => {
    if (!hover) return null;
    const row = hover.row;
    const worst = row.criticality.level;
    const node = (
      <div className="lp-widget-treemap-tooltip" style={{ left: Math.min(hover.x + 14, (typeof window !== "undefined" ? window.innerWidth : 1200) - 300), top: hover.y + 14 }}>
        <div className="lp-widget-treemap-tooltip-title">{row.project.name}</div>
        <div className="lp-widget-treemap-tooltip-row"><span>Taille — tâches du filtre</span><strong>{row.sizeCount}</strong></div>
        {cfg.colorMode === "secondaryFilterGradient" && <div className="lp-widget-treemap-tooltip-row"><span>Couleur — second filtre</span><strong>{row.colorCount}</strong></div>}
        {cfg.colorMode === "averageCriticality" && <div className="lp-widget-treemap-tooltip-row"><span>Couleur — criticité moyenne</span><strong>{row.criticality.score}/100 · {worst.label}</strong></div>}
        {cfg.colorMode === "sizeFilterGradient" && <div className="lp-widget-treemap-tooltip-row"><span>Couleur — même filtre</span><strong>{row.sizeCount}</strong></div>}
        <div className="lp-widget-treemap-tooltip-sep" />
        <div className="lp-widget-treemap-tooltip-row"><span>Tâches de la tuile (périmètre)</span><strong>{row.taskCount}</strong></div>
        <div className="lp-widget-treemap-tooltip-row"><span>Terminées</span><strong>{row.doneCount}</strong></div>
        <div className="lp-widget-treemap-tooltip-row"><span>En retard</span><strong>{row.lateCount}</strong></div>
        <div className="lp-widget-treemap-tooltip-row"><span>Urgentes</span><strong>{row.urgentCount}</strong></div>
        <div className="lp-widget-treemap-tooltip-row"><span>Progression moyenne</span><strong>{row.progress}%</strong></div>
        {row.nextMilestone && <div className="lp-widget-treemap-tooltip-row"><span>Prochain jalon</span><strong>{fmtShort(row.nextMilestone.date)}</strong></div>}
        <div className="lp-widget-treemap-tooltip-note">
          Criticité = moyenne, sur les tâches retenues, de : retard {TREEMAP_CRITICALITY_WEIGHTS.late},
          criticité urgente {TREEMAP_CRITICALITY_WEIGHTS.urgent}, échéance ≤ {TREEMAP_DUE_SOON_DAYS} j {TREEMAP_CRITICALITY_WEIGHTS.dueSoon},
          jalon {TREEMAP_CRITICALITY_WEIGHTS.milestone}, inactivité ≥ {TREEMAP_STALE_DAYS} j {TREEMAP_CRITICALITY_WEIGHTS.stale},
          projet prioritaire {TREEMAP_CRITICALITY_WEIGHTS.projectPriorityHigh}. Une tâche terminée vaut 0.
        </div>
      </div>
    );
    return createPortal(node, document.body);
  };

  const secondaryFields = cfg.fields.filter((f) => f !== "projectName");
  const radiusPx = { sharp: 2, medium: 8, round: 14 }[cfg.radius];

  const renderTile = (tile) => {
    const row = tile.row;
    const inset = cfg.gap / 2;
    const w = Math.max(0, tile.w - cfg.gap);
    const h = Math.max(0, tile.h - cfg.gap);
    if (w < 6 || h < 6) return null;
    const density = treemapTileDensity(w, h, cfg.compact);
    const bg = row.sizeCount === 0 ? TREEMAP_NEUTRAL_COLOR : treemapTileColor(row.colorValue, domain, cfg.palette, cfg.direction);
    const fg = treemapTextColor(bg);
    const dark = fg === "#FFFFFF";
    const budget = treemapSecondaryFieldBudget(density);
    const chips = budget === 0 ? [] : secondaryFields.map((f) => renderField(f, row, dark)).filter(Boolean).slice(0, budget);
    const showRing = cfg.showProgressRing && cfg.fields.includes("progress") && density !== "small";
    const ringSize = density === "large" ? 38 : 26;
    // Place déjà prise avant la liste : marges, nom du projet, bloc principal,
    // et la rangée de capsules qui reste ancrée en bas de la tuile.
    const reserved = 16
      + (density === "small" ? 15 : 17)
      + (density === "small" ? 18 : (density === "large" ? 44 : 32))
      + (chips.length ? 20 : 0);
    const upcomingMax = cfg.showUpcoming ? treemapUpcomingCapacity(h, reserved, w) : 0;
    const upcoming = upcomingMax > 0 ? row.upcoming.slice(0, upcomingMax) : [];
    // Le rouge doit rester lisible : sur une tuile foncée, le rouge plein
    // deviendrait illisible, on prend donc sa version claire.
    const lateColor = dark ? "#FFC9C9" : "#C23232";
    const hiddenUpcoming = row.upcomingTotal - upcoming.length;
    return (
      <div
        key={row.projectId}
        className={
          "lp-widget-treemap-tile is-" + density
          + (cfg.openOnClick ? " is-clickable" : "")
          + (cfg.border ? " is-bordered" : "")
          + (selectedId === row.projectId ? " is-selected" : "")
          + (row.sizeCount === 0 ? " is-zero" : "")
          + (selectedId && selectedId !== row.projectId ? " is-dimmed" : "")
        }
        style={{ left: tile.x + inset, top: tile.y + inset, width: w, height: h, background: bg, color: fg, borderRadius: radiusPx }}
        onClick={() => { setSelectedId((prev) => (prev === row.projectId ? null : row.projectId)); openRow(row); }}
        onContextMenu={(e) => { if (!tilesAreProjects) return; e.preventDefault(); setHover(null); setMenu({ row, x: e.clientX, y: e.clientY }); }}
        onMouseEnter={(e) => setHover({ row, x: e.clientX, y: e.clientY })}
        onMouseMove={(e) => setHover((prev) => (prev && prev.row === row ? { row, x: e.clientX, y: e.clientY } : prev))}
        onMouseLeave={() => setHover((prev) => (prev && prev.row === row ? null : prev))}
        title={density === "small" ? `${row.project.name} — ${row.sizeCount} tâche${row.sizeCount > 1 ? "s" : ""}` : undefined}
      >
        <div className="lp-widget-treemap-tile-head">
          <span className="lp-widget-treemap-tile-dot" style={{ background: row.project.color || "var(--text-muted)" }} />
          <span className="lp-widget-treemap-tile-name">{row.project.name}</span>
        </div>
        {density !== "small" ? (
          <div className="lp-widget-treemap-tile-main">
            {showRing && (
              <TreemapProgressRing
                value={row.progress}
                size={ringSize}
                color={fg}
                trackColor={dark ? "rgba(255,255,255,.28)" : "rgba(11,21,38,.16)"}
                textColor={density === "large" ? fg : null}
              />
            )}
            <span className="lp-widget-treemap-tile-metric">
              <span className="lp-widget-treemap-tile-metric-value">{row.sizeCount}</span>
              <span className="lp-widget-treemap-tile-metric-label">tâche{row.sizeCount > 1 ? "s" : ""}</span>
            </span>
          </div>
        ) : (
          <span className="lp-widget-treemap-tile-metric-value">{row.sizeCount}</span>
        )}
        {upcoming.length > 0 && (
          <div className="lp-widget-treemap-upcoming">
            {upcoming.map((u) => (
              <span className={"lp-widget-treemap-upcoming-item" + (u.late ? " is-late" : "")} key={u.id} title={`${u.title} — ${fmtShort(u.end)}${u.late ? " · en retard" : ""}`}>
                <span className="lp-widget-treemap-upcoming-dot" style={{ background: u.late ? lateColor : "currentColor", opacity: u.late ? 1 : 0.55 }} />
                <span className="lp-widget-treemap-upcoming-title" style={u.late ? { color: lateColor } : undefined}>{u.title || "Sans titre"}</span>
                <span className="lp-widget-treemap-upcoming-date" style={u.late ? { color: lateColor, opacity: 1 } : undefined}>{fmtShort(u.end)}</span>
              </span>
            ))}
            {hiddenUpcoming > 0 && upcomingMax > 1 && (
              <span className="lp-widget-treemap-upcoming-more">+{hiddenUpcoming} autre{hiddenUpcoming > 1 ? "s" : ""}</span>
            )}
          </div>
        )}
        {chips.length > 0 && <div className="lp-widget-treemap-tile-fields">{chips}</div>}
      </div>
    );
  };

  // États vides — jamais un cadre blanc muet : on dit pourquoi il n'y a rien et
  // quel réglage changerait la réponse.
  const emptyState = (() => {
    // Les messages nomment le champ qui porte les tuiles : « aucun projet »
    // serait faux, et surtout inutile, sur un Treemap groupé par statut.
    const noun = TREEMAP_TILE_BY_LABELS[cfg.tileBy].plural;
    if (!tileEntities.length) {
      return tilesAreProjects
        ? { title: "Aucun projet", sub: "Crée un projet pour que le Treemap ait quelque chose à représenter." }
        : { title: `Aucun de ces ${noun}`, sub: `Aucun ${TREEMAP_TILE_BY_LABELS[cfg.tileBy].label.toLowerCase()} n'est défini : le Treemap n'a rien à représenter.` };
    }
    if (rows.length === 0) {
      return tasks.length === 0
        ? { title: "Aucune tâche dans ce périmètre", sub: `Le filtre du widget et celui de l'onglet ne laissent passer aucune tâche : aucun de ces ${noun} ne peut donc être mesuré.` }
        : { title: `Aucun de ces ${noun} ne porte de tâche correspondante`, sub: "Le filtre de taille exclut toutes les tâches. Élargis-le, ou coche « Afficher les tuiles sans tâche correspondante » pour les garder en tuile minimale." };
    }
    if (visibleRows.length === 0) return { title: `Aucun de ces ${noun} pour cette sélection`, sub: `La recherche ou la tranche de légende active ne retient aucun de ces ${noun}.` };
    return null;
  })();

  return (
    <div className="lp-widget-treemap">
      {(cfg.showSearch || legend.length > 0) && (
        <div className="lp-widget-treemap-toolbar">
          {cfg.showSearch && (
            <span className="lp-widget-treemap-search">
              <Search size={11} color="var(--text-muted)" />
              <input type="text" value={search} onChange={(e) => setSearch(e.target.value)} placeholder="Rechercher un projet…" />
              {search && <button type="button" className="lp-icon-btn" onClick={() => setSearch("")} title="Effacer"><X size={11} /></button>}
            </span>
          )}
          {legend.length > 0 && (
            <span className="lp-widget-treemap-legend">
              {legend.map((b) => (
                <button
                  type="button"
                  key={b.key}
                  className={"lp-widget-treemap-legend-item" + (activeBucket === b.key ? " is-active" : "") + (b.count === 0 ? " is-empty" : "")}
                  onClick={() => { if (b.count > 0) setActiveBucket((prev) => (prev === b.key ? null : b.key)); }}
                  title={b.count === 0 ? "Aucun projet dans cette tranche" : "Ne garder que cette tranche"}
                >
                  <span className="lp-widget-treemap-legend-mark" style={{ background: b.color }} />
                  {b.label} · {b.count}
                </button>
              ))}
            </span>
          )}
        </div>
      )}
      <div className="lp-widget-treemap-scroll" ref={scrollRef}>
        {emptyState ? (
          <div className="lp-widget-treemap-empty">
            <LayoutDashboard size={20} color="var(--text-muted)" />
            <div className="lp-widget-treemap-empty-title">{emptyState.title}</div>
            <div className="lp-widget-treemap-empty-sub">{emptyState.sub}</div>
          </div>
        ) : (
          <div className="lp-widget-treemap-canvas" style={{ height: layout.height }}>
            {layout.blocks.map((block) => (
              <React.Fragment key={block.key}>
                {block.headerRect && (
                  <div className="lp-widget-treemap-group-label" style={{ left: block.headerRect.x, top: block.headerRect.y, width: block.headerRect.w, height: block.headerRect.h }}>
                    {block.label}
                  </div>
                )}
                {block.tiles.map(renderTile)}
              </React.Fragment>
            ))}
          </div>
        )}
      </div>
      {tooltipNode()}
      {menu && (
        <QuickContextMenu
          x={menu.x}
          y={menu.y}
          onClose={() => setMenu(null)}
          items={[
            { icon: <ExternalLink size={13} />, label: "Ouvrir le projet", onClick: () => { setMenu(null); onOpenProject && onOpenProject(menu.row.projectId); } },
            { icon: <Settings size={13} />, label: "Modifier le projet", onClick: () => { setMenu(null); onEditProject && onEditProject(menu.row.project); } },
            { icon: <Search size={13} />, label: "Filtrer cet onglet sur ce projet", onClick: () => { setMenu(null); onFilterProject && onFilterProject(menu.row.projectId); } },
          ]}
        />
      )}
    </div>
  );
}




// avec sa propre mini barre d'outils (portée dans un slot local) et son propre
// jeu de préférences (zoom, groupement...), indépendant de la vue plein écran.
// L'édition par glisser-déposer reste active (setTasks réel) ; en revanche
// créer/supprimer une tâche ou basculer son statut en un clic reste réservé à
// la vue plein écran et à la fiche tâche (onOpen), pour ne pas dupliquer toute
// la mécanique d'actions rapides dans un espace réduit.
function EmbeddedViewShell({ children, initialPrefs, externalToolbarSlot }) {
  const [toolbarSlot, setToolbarSlot] = useState(null);
  const [prefsState, setPrefsState] = useState(initialPrefs || {});
  const setPrefs = (patch) => setPrefsState((p) => ({ ...p, ...(typeof patch === "function" ? patch(p) : patch) }));
  // Si WidgetFrame fournit un emplacement dans son propre en-tête (pour fusionner
  // titre + barre d'outils sur une seule ligne), on l'utilise directement plutôt
  // que de créer un second emplacement en dessous.
  const effectiveSlot = externalToolbarSlot || toolbarSlot;
  return (
    <div className="lp-widget-embed">
      {!externalToolbarSlot && <div className="lp-widget-embed-toolbar" ref={setToolbarSlot} />}
      <div className="lp-widget-embed-body">
        {children({ toolbarSlot: effectiveSlot, prefs: prefsState, setPrefs })}
      </div>
    </div>
  );
}

function WidgetEmbedMetro({ widget, tasks, ctx, onOpen, appearance, expenses, setTasks, pushToast, externalToolbarSlot, onUpdateWidget, metaBlocks }) {
  // Mêmes règles que le Gantt embarqué : les annotations vivent dans la
  // configuration DU WIDGET, pas dans les préférences éphémères de la vue.
  const annotations = ganttAnnotationsOf(widget);
  return (
    <EmbeddedViewShell externalToolbarSlot={externalToolbarSlot}>
      {({ toolbarSlot, prefs, setPrefs }) => (
        <ProjectMetroView
          tasks={tasks} ctx={ctx} onOpen={onOpen} toolbarSlot={toolbarSlot}
          appearance={appearance} prefs={prefs} setPrefs={setPrefs}
          setTasks={setTasks || (() => {})} pushToast={pushToast || (() => {})} expenses={expenses || []}
          metaTemporalBlocks={metaBlocks}
          annotations={annotations}
          onAnnotationsChange={onUpdateWidget ? ((next) => onUpdateWidget({ ganttAnnotations: next })) : undefined}
          embedded
        />
      )}
    </EmbeddedViewShell>
  );
}

// Les annotations du Gantt embarqué vivent dans la configuration DU WIDGET
// (widget.ganttAnnotations) et non dans les préférences éphémères de la vue :
// elles survivent au rechargement et suivent le widget lors de la duplication
// d'un widget, d'un onglet ou d'un tableau de bord. Les autres réglages
// (zoom, colonnes, bulles) restent locaux au widget affiché, comme avant.
function ganttAnnotationsOf(widget) {
  const stored = widget && widget.ganttAnnotations;
  return stored && typeof stored === "object" ? stored : {};
}

function WidgetEmbedTimeline({ tasks, ctx, onOpen, setTasks, externalToolbarSlot }) {
  const [listPrefs, setListPrefsState] = useState({ visibleFields: ["project", "status"], sortBy: "none" });
  const setListPrefs = (patch) => setListPrefsState((p) => ({ ...p, ...(typeof patch === "function" ? patch(p) : patch) }));
  return (
    <EmbeddedViewShell externalToolbarSlot={externalToolbarSlot}>
      {({ toolbarSlot, prefs, setPrefs }) => (
        <TimelineView
          tasks={tasks} ctx={ctx} onOpen={onOpen} prefs={prefs} setPrefs={setPrefs}
          gradient={{}} progressColorByStatus={{}} setTasks={setTasks || (() => {})}
          onAdd={() => {}} onDelete={() => {}} onMarkDone={() => {}} onCycleStatus={() => {}} onBulkDelete={() => {}}
          listPrefs={listPrefs} setListPrefs={setListPrefs}
          toolbarSlot={toolbarSlot}
          embedded
        />
      )}
    </EmbeddedViewShell>
  );
}

function WidgetEmbedRadar({ tasks, ctx, onOpen, appearance, externalToolbarSlot }) {
  return (
    <EmbeddedViewShell externalToolbarSlot={externalToolbarSlot}>
      {({ toolbarSlot, prefs, setPrefs }) => (
        <RadarView tasks={tasks} ctx={ctx} onOpen={onOpen} appearance={appearance} prefs={prefs} setPrefs={setPrefs} toolbarSlot={toolbarSlot} embedded />
      )}
    </EmbeddedViewShell>
  );
}

// Sélecteur de type de widget, organisé par catégorie plutôt qu'en liste plate —
// chaque type garde une icône reconnaissable pour un repérage plus rapide.
const WIDGET_TYPE_GROUPS = ["Indicateurs", "Planning", "Intelligence", "Suivi"];
const WIDGET_TYPE_META = [
  { key: "kpi", label: "Chiffre clé", icon: Hash, group: "Indicateurs" },
  { key: "customCard", label: "Carte personnalisable", icon: LayoutDashboard, group: "Indicateurs" },
  { key: "chart", label: "Graphique", icon: BarChart3, group: "Indicateurs" },
  { key: "list", label: "Liste", icon: List, group: "Indicateurs" },
  { key: "taskDetail", label: "Tâche détaillée", icon: List, group: "Indicateurs" },
  { key: "minigantt", label: "Mini-Gantt", icon: GanttChartSquare, group: "Planning" },
  { key: "bubbles", label: "Bulles", icon: CircleDot, group: "Planning" },
  { key: "staffing", label: "Charge personnel", icon: Users, group: "Planning" },
  { key: "milestoneTimeline", label: "Timeline des jalons", icon: Milestone, group: "Planning" },
  { key: "verticalMetroTimeline", label: "Timeline verticale métro", icon: TrainTrack, group: "Planning" },
  { key: "metroDeadline", label: "Métro / Échéances", icon: CalendarClock, group: "Planning" },
  { key: "criticalPath", label: "Chemin critique", icon: GitBranch, group: "Planning" },
  { key: "nextBestAction", label: "Next Best Action", icon: Zap, group: "Intelligence" },
  { key: "dailyBriefing", label: "Daily Briefing", icon: Sunrise, group: "Intelligence" },
  { key: "blockers", label: "Tâches bloquantes", icon: ShieldAlert, group: "Intelligence" },
  { key: "heatmapMonth", label: "Heat map mensuelle", icon: Grid3x3, group: "Suivi" },
  { key: "countdown", label: "Compte à rebours", icon: CalendarClock, group: "Suivi" },
  { key: "budget", label: "Budget", icon: Wallet, group: "Suivi" },
  { key: "note", label: "Note libre", icon: StickyNote, group: "Suivi" },
  { key: "dominoEffect", label: "Domino Effect", icon: GitBranch, group: "Intelligence" },
  { key: "budgetBurnRate", label: "Budget Burn Rate", icon: Flame, group: "Suivi" },
  { key: "projectTreemap", label: "Treemap projets", icon: Grid3x3, group: "Suivi" },
  { key: "deadlineScatter", label: "Nuage des échéances", icon: Crosshair, group: "Suivi" },
  { key: "heatmapGrid", label: "Heat map croisée", icon: Grid3x3, group: "Suivi" },
  { key: "embedMetro", label: "Métro (complet)", icon: TrainTrack, group: "Planning" },
  { key: "embedTimeline", label: "Timeline + Liste (complet)", icon: Waypoints, group: "Planning" },
  { key: "embedRadar", label: "Radar (complet)", icon: Crosshair, group: "Planning" },
];

// Champs de filtre de tâches réutilisables — mêmes réglages (projets, statuts,
// retard, jalons, échéance, période automatique, champs personnalisés) que
// pour un widget, réutilisés à l'identique pour le filtre de PAGE de tableau
// de bord, afin de ne jamais dupliquer cette UI ni le moteur d'évaluation
// (applyWidgetFilter sert aux deux).
function TaskFilterFields({ filter, setFilter, ctx }) {
  const toggleInList = (key, id) => setFilter((f) => {
    const list = f[key] || [];
    return { ...f, [key]: list.includes(id) ? list.filter((x) => x !== id) : [...list, id] };
  });
  return (
    <>
      <FilterMultiSelect
        label="Projets"
        options={[
          { id:NO_PROJECT_FILTER, name:"Sans projet", color:"#94A3B8" },
          ...sortedByName(ctx.projects),
        ]}
        selectedIds={filter.projectIds || []}
        mode={filter.projectIdsMode || "is"}
        onModeChange={(m) => setFilter((f) => ({ ...f, projectIdsMode: m }))}
        onToggle={(id) => toggleInList("projectIds", id)}
        onSelectAll={() => setFilter((f) => ({ ...f, projectIds: [NO_PROJECT_FILTER, ...ctx.projects.map((p) => p.id)] }))}
        onDeselectAll={() => setFilter((f) => ({ ...f, projectIds: [] }))}
        metaGroups={ctx.projectFolders}
        onSelectGroup={(folderId) => setFilter((f) => {
          const groupIds = ctx.projects.filter((p) => p.folderId === folderId).map((p) => p.id);
          return { ...f, projectIds: [...new Set([...(f.projectIds || []), ...groupIds])] };
        })}
      />
      <FilterMultiSelect
        label="Statuts"
        options={sortedByName(ctx.statuses)}
        selectedIds={filter.statusIds || []}
        mode={filter.statusIdsMode || "is"}
        onModeChange={(m) => setFilter((f) => ({ ...f, statusIdsMode: m }))}
        onToggle={(id) => toggleInList("statusIds", id)}
        onSelectAll={() => setFilter((f) => ({ ...f, statusIds: ctx.statuses.map((s) => s.id) }))}
        onDeselectAll={() => setFilter((f) => ({ ...f, statusIds: [] }))}
      />
      <FilterMultiSelect
        label="Types"
        options={sortedByName(ctx.taskTypes || [])}
        selectedIds={filter.taskTypeIds || []}
        mode={filter.taskTypeIdsMode || "is"}
        onModeChange={(m) => setFilter((f) => ({ ...f, taskTypeIdsMode: m }))}
        onToggle={(id) => toggleInList("taskTypeIds", id)}
        onSelectAll={() => setFilter((f) => ({ ...f, taskTypeIds: (ctx.taskTypes || []).map((s) => s.id) }))}
        onDeselectAll={() => setFilter((f) => ({ ...f, taskTypeIds: [] }))}
      />
      <div className="lp-row2">
        <label className="lp-checkbox-row"><input type="checkbox" checked={!!filter.onlyLate} onChange={(e) => setFilter((f) => ({ ...f, onlyLate: e.target.checked }))} /><span style={{ textTransform: "none", fontWeight: 500 }}>Uniquement en retard</span></label>
        <label className="lp-checkbox-row"><input type="checkbox" checked={!!filter.onlyMilestone} onChange={(e) => setFilter((f) => ({ ...f, onlyMilestone: e.target.checked }))} /><span style={{ textTransform: "none", fontWeight: 500 }}>Uniquement les jalons</span></label>
      </div>
      <div className="lp-row2">
        <label className="lp-checkbox-row"><input type="checkbox" checked={!!filter.excludeDone} onChange={(e) => setFilter((f) => ({ ...f, excludeDone: e.target.checked }))} /><span style={{ textTransform: "none", fontWeight: 500 }}>Exclure les terminées</span></label>
        <label className="lp-checkbox-row"><input type="checkbox" checked={!!filter.assigneeEmpty} onChange={(e) => setFilter((f) => ({ ...f, assigneeEmpty: e.target.checked }))} /><span style={{ textTransform: "none", fontWeight: 500 }}>Uniquement sans responsable</span></label>
      </div>
      <div className="lp-row2">
        <div className="lp-field">
          <label>X jours dans le passé</label>
          <input
            type="number"
            min="0"
            value={filter.pastDays ?? ""}
            onChange={(e) => setFilter((f) => ({ ...f, pastDays: e.target.value }))}
            placeholder="Vide = tout"
            style={{ maxWidth: 120 }}
          />
        </div>
        <div className="lp-field">
          <label>Échéance dans les prochains jours</label>
          <input
            type="number"
            min="0"
            value={filter.dueWithinDays}
            onChange={(e) => setFilter((f) => ({ ...f, dueWithinDays: e.target.value }))}
            placeholder="Vide = tout"
            style={{ maxWidth: 120 }}
          />
        </div>
      </div>
      <div style={{fontSize:10,color:"var(--text-muted)",marginTop:-4,marginBottom:8}}>
        Passé : vide = tout · 0 = aujourd'hui + futur. Futur vide = aucune limite.
      </div>
      <div className="lp-field">
        <label>Période automatique</label>
        <div style={{ display: "flex", gap: 8 }}>
          <select value={filter.datePresetField || "end"} onChange={(e) => setFilter((f) => ({ ...f, datePresetField: e.target.value }))} style={{ maxWidth: 110 }}>
            <option value="end">Fin</option>
            <option value="start">Début</option>
          </select>
          <select value={filter.datePreset || ""} onChange={(e) => setFilter((f) => ({ ...f, datePreset: e.target.value }))}>
            <option value="">— Aucune —</option>
            {DATE_FILTER_PRESETS.map((p) => <option key={p.key} value={p.key}>{p.label}</option>)}
          </select>
        </div>
      </div>
      <hr className="lp-divider" style={{ margin: "14px 0" }} />
      <div className="lp-section-title">Conditions avancées <span style={{ fontWeight: 400, textTransform: "none", color: "var(--text-600)" }}>(groupes multiples combinables en ET / OU, y compris sur le titre)</span></div>
      <FilterGroupEditor group={filter.advanced || { op: "and", items: [] }} onChange={(g) => setFilter((f) => ({ ...f, advanced: g }))} ctx={ctx} />
    </>
  );
}

// Filtre de PAGE de tableau de bord : s'applique comme base à TOUS les
// widgets de la page (combiné en ET avec le filtre propre à chaque widget).
function PageFilterModal({ page, onSave, onSaveMeta, onClose, ctx }) {
  const [filter, setFilter] = useState(page.filter || widgetDefaultFilter());
  const [icon, setIcon] = useState(page.icon || "");
  const submit = () => { onSave(filter); if (icon !== (page.icon || "")) onSaveMeta({ icon: icon || null }); onClose(); };
  return (
    <Modal title={`Réglages de la page « ${page.name} »`} onClose={onClose} wide footer={
      <>
        <button className="lp-btn" onClick={onClose}>Annuler</button>
        <button className="lp-btn lp-btn-primary" onClick={submit}>Enregistrer</button>
      </>
    }>
      <div className="lp-field">
        <label>Icône de l'onglet <span style={{ fontWeight: 400, textTransform: "none", color: "var(--text-600)" }}>(icône Tabler, image importée, ou lien — facultatif)</span></label>
        <IconEditor icon={icon} setIcon={setIcon} />
      </div>
      <hr className="lp-divider" style={{ margin: "14px 0" }} />
      <p style={{ fontSize: 12.5, color: "var(--text-600)", marginTop: -4, marginBottom: 14 }}>
        Ce filtre s'applique automatiquement à tous les widgets de cette page, en plus du filtre propre à chacun.
      </p>
      <div className="lp-section-title">Filtres rapides</div>
      <TaskFilterFields filter={filter} setFilter={setFilter} ctx={ctx} />
    </Modal>
  );
}

function WidgetFormModal({ widget, existingWidgets, ctx, pageFilter, onSave, onClose, transferBoards, boardId, currentPageId, onTransfer }) {
  const [type, setType] = useState(widget?.type || "kpi");
  const [title, setTitle] = useState(widget?.title || "");
  const [typeSearch, setTypeSearch] = useState("");
  // À la création on affiche le catalogue ; à l'édition il reste replié pour
  // accéder immédiatement aux réglages de configuration.
  const [typePickerOpen, setTypePickerOpen] = useState(() => !widget);
  /* Changer de tableau de bord (issue #58). Proposé seulement sur un widget qui
     EXISTE : un widget en cours de création n'a pas encore d'emplacement à
     quitter, et le proposer laisserait croire qu'on peut le créer ailleurs. */
  const transferTargets = useMemo(() => widgetTransferTargets(transferBoards || []), [transferBoards]);
  const transferOffered = !!widget && !!onTransfer && transferTargets.length > 1;
  const [transferOpen, setTransferOpen] = useState(false);
  /* La liste déroulante travaille sur des INDEX et non sur une clé composée de
     l'identifiant du tableau et de celui de la page : deux identifiants
     concaténés peuvent se confondre dès qu'un séparateur apparaît dans l'un
     d'eux — et « nexora:today » en contient déjà un. */
  const transferIsHere = (t) => t.boardId === boardId && t.pageId === currentPageId;
  const [transferIndex, setTransferIndex] = useState("");
  /* Liste déroulante à recherche rapide, comme celles du statut, du type et du
     projet (retour de Quentin sur #58 : « comme d'habitude »). Un <select> natif
     ne peut pas en porter, et la liste grandit avec chaque tableau et chaque
     page — elle devient vite trop longue pour être parcourue à l'œil. */
  const [transferPickerOpen, setTransferPickerOpen] = useState(false);
  const [transferQuery, setTransferQuery] = useState("");
  const transferPickerRef = useRef(null);
  const transferSearchRef = useRef(null);
  useEffect(() => {
    function onDoc(e) { if (transferPickerRef.current && !transferPickerRef.current.contains(e.target)) setTransferPickerOpen(false); }
    document.addEventListener("mousedown", onDoc);
    return () => document.removeEventListener("mousedown", onDoc);
  }, []);
  // À l'ouverture, la recherche repart de zéro et prend le clavier : sans cela
  // il faudrait viser le champ à la souris avant de pouvoir taper.
  useEffect(() => {
    if (!transferPickerOpen) return;
    setTransferQuery("");
    const id = setTimeout(() => transferSearchRef.current?.focus(), 0);
    return () => clearTimeout(id);
  }, [transferPickerOpen]);
  /* Par défaut, la première destination QUI N'EST PAS celle où le widget se
     trouve déjà : ouvrir sur « ici » invite à valider un transfert qui ne fait
     rien. */
  const transferFiltered = useMemo(
    () => widgetTransferFilterTargets(transferTargets, transferQuery),
    [transferTargets, transferQuery]
  );
  const transferSelected = transferTargets[Number(transferIndex)]
    || transferTargets.find((t) => !transferIsHere(t))
    || transferTargets[0]
    || null;
  const [transferMode, setTransferMode] = useState("move");
  const [cardTaskMode, setCardTaskMode] = useState(widget?.cardTaskMode || "first");
  const [cardTaskId, setCardTaskId] = useState(widget?.cardTaskId || "");
  const [cardColumns, setCardColumns] = useState(Math.max(1, Math.min(3, Number(widget?.cardColumns) || 2)));
  const [cardSurface, setCardSurface] = useState(widget?.cardSurface || "plain");
  const [cardAccentColor, setCardAccentColor] = useState(widget?.cardAccentColor || "");
  const [cardBackground, setCardBackground] = useState(widget?.cardBackground || "");
  const [cardBorderColor, setCardBorderColor] = useState(widget?.cardBorderColor || "");
  const [cardRadius, setCardRadius] = useState(widget?.cardRadius || "medium");
  const [cardBlocks, setCardBlocks] = useState(() =>
    Array.isArray(widget?.cardBlocks) && widget.cardBlocks.length
      ? widget.cardBlocks
      : customCardDefaultBlocks()
  );
  const [metric, setMetric] = useState(widget?.metric || "count");
  const [groupBy, setGroupBy] = useState(widget?.groupBy || "status");
  const [chartStyle, setChartStyle] = useState(widget?.chartStyle || "pie");
  const [gaugeMetric, setGaugeMetric] = useState(widget?.gaugeMetric || "avgProgress");
  const [stackBy, setStackBy] = useState(widget?.stackBy || "status");
  const [sortBy, setSortBy] = useState(widget?.sortBy || "end");
  const [limit, setLimit] = useState(widget?.limit || 6);
  const [filter, setFilter] = useState(widgetFilterFor(widget || {}));
  const [listGroupBy, setListGroupBy] = useState((widget?.type === "list" || widget?.type === "minigantt" || widget?.type === "bubbles") && widget?.groupBy ? widget.groupBy : "none");
  const [showMilestones, setShowMilestones] = useState(widget?.showMilestones !== false);
  const [colorBy, setColorBy] = useState(widget?.colorBy || "status");
  const [miniGanttFields, setMiniGanttFields] = useState(widget?.miniGanttFields || ["assignee", "status", "taskType", "end", "progress"]);
  const [miniGanttFieldsLayout, setMiniGanttFieldsLayout] = useState(widget?.miniGanttFieldsLayout === "inline" ? "inline" : "aligned");
  // Mode Comparaison : propriété absente = mode Standard. Cet interrupteur et
  // le sélecteur rapide de l'en-tête écrivent la MÊME propriété.
  const [miniGanttComparisonEnabled, setMiniGanttComparisonEnabled] = useState(miniGanttComparisonEnabledOn(widget));
  // Ordre des lignes. Absent = « Date de début » croissant, l'ordre historique.
  const [miniGanttSort, setMiniGanttSort] = useState(normalizeMiniGanttSort(widget?.miniGanttSort));
  const [miniGanttSortDir, setMiniGanttSortDir] = useState(normalizeMiniGanttSortDir(widget?.miniGanttSortDir));
  // Cadrage temporel. Absent = « Automatique », le cadrage historique.
  const [miniGanttRange, setMiniGanttRange] = useState(() => normalizeMiniGanttRange(widget?.miniGanttRange));
  const [miniGanttWindowStart, setMiniGanttWindowStart] = useState(widget?.miniGanttWindow?.start || "");
  const [miniGanttWindowEnd, setMiniGanttWindowEnd] = useState(widget?.miniGanttWindow?.end || "");
  // Même verdict que le formulaire d'affichage, qui l'affiche sous les champs :
  // la fiche s'en sert pour refuser l'enregistrement d'un cadrage impossible.
  const miniGanttWindowError = miniGanttWindowMessage(miniGanttRange, miniGanttWindowStart, miniGanttWindowEnd);
  /* Les réglages d'affichage sont édités par un composant partagé avec la vue
     Gantt : il rend un correctif aux clés du widget enregistré, que la fiche
     range dans son état local jusqu'à l'enregistrement. */
  /* Réglages du widget « Bulles » (#92) : UN seul état pour toutes ses clés
     propres, plutôt qu'une quinzaine de useState. Les clés PARTAGÉES avec le
     Mini-Gantt (regroupement, jalons, tri, cadrage, annotations) restent dans
     l'état existant : la fiche garde une seule source de vérité par réglage, et
     changer un widget de Mini-Gantt à Bulles ne perd rien. */
  const [bubbleSettings, setBubbleSettings] = useState(() => normalizeBubblesWidget(widget || {}));
  /* Réglages du widget « Charge personnel » (#124), sur le même principe : un
     seul état pour toutes ses clés propres. Il ne partage RIEN avec le
     Mini-Gantt — ni cadrage, ni tri, ni filtre de tâches : ce widget ne montre
     pas des tâches, il montre des personnes. */
  const [staffingSettings, setStaffingSettings] = useState(() => normalizeStaffingWidget(widget || {}));
  const applyStaffingPatch = (patch) => setStaffingSettings((prev) => normalizeStaffingWidget({ ...prev, ...patch }));
  const applyBubblePatch = (patch) => {
    applyMiniGanttPatch(patch);
    if (Object.keys(patch).some((key) => key.startsWith("bubble"))) {
      setBubbleSettings((prev) => normalizeBubblesWidget({ ...prev, ...patch }));
    }
  };
  const applyMiniGanttPatch = (patch) => {
    if ("groupBy" in patch) setListGroupBy(patch.groupBy);
    if ("showMilestones" in patch) setShowMilestones(patch.showMilestones);
    if ("colorBy" in patch) setColorBy(patch.colorBy);
    if ("miniGanttFields" in patch) setMiniGanttFields(patch.miniGanttFields);
    if ("miniGanttFieldsLayout" in patch) setMiniGanttFieldsLayout(patch.miniGanttFieldsLayout);
    if ("miniGanttSort" in patch) setMiniGanttSort(patch.miniGanttSort);
    if ("miniGanttSortDir" in patch) setMiniGanttSortDir(patch.miniGanttSortDir);
    if ("miniGanttComparisonEnabled" in patch) setMiniGanttComparisonEnabled(patch.miniGanttComparisonEnabled);
    if ("miniGanttRange" in patch) setMiniGanttRange(normalizeMiniGanttRange(patch.miniGanttRange));
    if ("miniGanttWindow" in patch) {
      setMiniGanttWindowStart(patch.miniGanttWindow?.start || "");
      setMiniGanttWindowEnd(patch.miniGanttWindow?.end || "");
    }
  };
  const [countdownMode, setCountdownMode] = useState(widget?.countdownMode || "date");
  const [countdownDate, setCountdownDate] = useState(widget?.countdownDate || "");
  const [countdownTaskId, setCountdownTaskId] = useState(widget?.countdownTaskId || "");
  const [taskDetailTaskId, setTaskDetailTaskId] = useState(widget?.taskDetailTaskId || "");
  const [content, setContent] = useState(widget?.content || "");
  const [budgetProjectId, setBudgetProjectId] = useState(widget?.budgetProjectId || ctx.projects[0]?.id || "");
  const [burnRateProjectId, setBurnRateProjectId] = useState(widget?.burnRateProjectId || ctx.projects[0]?.id || "");
  // Nuage des échéances — un seul réglage propre : le champ qui définit les couloirs.
  const [scatterLaneField, setScatterLaneField] = useState(
    SCATTER_LANE_FIELDS.includes(widget?.scatterLaneField) ? widget.scatterLaneField : "project"
  );
  // Heat map — la normalisation reste seul juge des défauts et des collisions
  // d'axes ; la fiche ne fait qu'éditer.
  const heatmapCfg = useMemo(() => heatmapNormalizeConfig(widget || {}), [widget]);
  const [heatmapRowField, setHeatmapRowField] = useState(heatmapCfg.rowField);
  const [heatmapColField, setHeatmapColField] = useState(heatmapCfg.colField);
  const [heatmapMetric, setHeatmapMetric] = useState(heatmapCfg.metric);
  const [heatmapPalette, setHeatmapPalette] = useState(heatmapCfg.palette);
  const [heatmapShowValues, setHeatmapShowValues] = useState(heatmapCfg.showValues);
  // Fenêtre d'affichage — la normalisation reste seul juge des bornes.
  const scatterWin = useMemo(() => scatterNormalizeWindow(widget || {}), [widget]);
  const [scatterWindowMode, setScatterWindowMode] = useState(scatterWin.mode);
  const [scatterWindowBefore, setScatterWindowBefore] = useState(String(scatterWin.before));
  const [scatterWindowAfter, setScatterWindowAfter] = useState(String(scatterWin.after));
  // Treemap projets — la configuration est relue par normalizeProjectTreemapConfig,
  // qui reste seul juge des valeurs par défaut : la fiche ne fait que l'éditer.
  const treemapCfg = useMemo(() => normalizeProjectTreemapConfig(widget || {}), [widget]);
  const [treemapSizeFilter, setTreemapSizeFilter] = useState(() => ({ ...widgetDefaultFilter(), ...(treemapCfg.sizeFilter || {}) }));
  const [treemapColorFilter, setTreemapColorFilter] = useState(() => ({ ...widgetDefaultFilter(), ...(treemapCfg.colorFilter || {}) }));
  const [treemapTileBy, setTreemapTileBy] = useState(treemapCfg.tileBy);
  const [treemapColorMode, setTreemapColorMode] = useState(treemapCfg.colorMode);
  const [treemapPalette, setTreemapPalette] = useState(treemapCfg.palette);
  const [treemapDirection, setTreemapDirection] = useState(treemapCfg.direction);
  const [treemapShowZeroProjects, setTreemapShowZeroProjects] = useState(treemapCfg.showZeroProjects);
  const [treemapFields, setTreemapFields] = useState(treemapCfg.fields);
  const [treemapShowProgressRing, setTreemapShowProgressRing] = useState(treemapCfg.showProgressRing);
  const [treemapShowUpcoming, setTreemapShowUpcoming] = useState(treemapCfg.showUpcoming);
  const [treemapGroupBy, setTreemapGroupBy] = useState(treemapCfg.groupBy);
  const [treemapCompact, setTreemapCompact] = useState(treemapCfg.compact);
  const [treemapShowLegend, setTreemapShowLegend] = useState(treemapCfg.showLegend);
  const [treemapShowSearch, setTreemapShowSearch] = useState(treemapCfg.showSearch);
  const [treemapOpenOnClick, setTreemapOpenOnClick] = useState(treemapCfg.openOnClick);
  const [treemapRadius, setTreemapRadius] = useState(treemapCfg.radius);
  const [treemapGap, setTreemapGap] = useState(treemapCfg.gap);
  const [treemapBorder, setTreemapBorder] = useState(treemapCfg.border);
  const [treemapSizeFilterOpen, setTreemapSizeFilterOpen] = useState(false);
  const [treemapColorFilterOpen, setTreemapColorFilterOpen] = useState(false);
  // Le catalogue suit le champ qui porte les tuiles : proposer « Dossier » sur
  // des tuiles de statut donnerait une capsule que le normalisateur retire à
  // l'enregistrement — une case qui se coche et ne tient pas.
  const treemapFieldCatalogue = useMemo(() => [
    ...TREEMAP_TILE_FIELDS
      .filter((f) => treemapTileBy === "project" || !TREEMAP_PROJECT_ONLY_FIELDS.includes(f.key))
      .filter((f) => !(treemapTileBy === "status" && f.key === "dominantStatus"))
      .map((f) => (f.key === "projectName" ? { ...f, label: TREEMAP_TILE_BY_LABELS[treemapTileBy].tileName } : f)),
  ], [treemapTileBy]);
  const treemapFieldLabel = (key) => treemapFieldCatalogue.find((f) => f.key === key)?.label || key;
  const moveTreemapField = (key, dir) => setTreemapFields((prev) => {
    const i = prev.indexOf(key);
    const j = i + dir;
    if (i < 0 || j < 0 || j >= prev.length) return prev;
    const next = [...prev];
    [next[i], next[j]] = [next[j], next[i]];
    return next;
  });
  const [budgetMetric, setBudgetMetric] = useState(widget?.budgetMetric || "engaged");
  const [titleColor, setTitleColor] = useState(widget?.titleColor || "");
  const [onlyMine, setOnlyMine] = useState(widget?.onlyMine || false);
  const [showAppearance, setShowAppearance] = useState(!!(widget?.titleEmoji || widget?.titleColor || widget?.bandColor || widget?.bgColor));
  const [bgColor, setBgColor] = useState(widget?.bgColor || "");
  const [bandColor, setBandColor] = useState(widget?.bandColor || "");
  const [titleEmoji, setTitleEmoji] = useState(widget?.titleEmoji || "");
  // Annotations du Gantt embarqué : éditées ici puis enregistrées dans la
  // configuration du widget, jamais dans les tâches elles-mêmes.
  const [ganttAnnotations, setGanttAnnotations] = useState(() => {
    const stored = ganttAnnotationsOf(widget);
    const list = (value) => (Array.isArray(value) ? value : []);
    return {
      temporalBlocks: list(stored.temporalBlocks),
      highlightFrames: list(stored.highlightFrames),
      milestones: list(stored.milestones),
      notes: list(stored.notes),
      spans: list(stored.spans),
    };
  });
  // Un bloc dont les dates sont invalides (ou dont la fin précède le début)
  // bloque l'enregistrement : l'erreur reste affichée sous les champs.
  const ganttAnnotationsValid = ganttAnnotations.temporalBlocks.every((b) => validateTemporalBlock(b).ok);
  // Les listes déroulantes des annotations ne proposent que les tâches que ce
  // widget affiche réellement : filtre de la page, puis filtre du widget, tel
  // qu'il est en cours d'édition dans cette même fiche.
  const ganttTasks = useMemo(() => {
    const pageScoped = applyWidgetFilter(ctx.tasks || [], pageFilter, ctx);
    // Une tâche-jalon n'a qu'une date de fin : l'exiger des deux côtés vidait
    // le sélecteur de « Tâche rattachée » (#94).
    return applyWidgetFilter(pageScoped, filter, ctx).filter((t) => t.start || t.end);
  }, [ctx, pageFilter, filter]);
  // Les bornes par défaut se lisent sur les tâches RÉELLEMENT datées de chaque
  // côté : depuis que les tâches-jalons (fin seule) sont proposées, prendre la
  // date de la première venue pouvait donner `undefined`.
  const ganttDefaultStart = ganttTasks.reduce((m, t) => (t.start && (!m || t.start < m) ? t.start : m), "") || iso(new Date());
  const ganttDefaultEnd = ganttTasks.reduce((m, t) => (t.end && (!m || t.end > m) ? t.end : m), "") || iso(new Date());
  // Les risques de délai vivent sur les tâches : la fiche les lit et les écrit
  // là, jamais dans la configuration du widget qu'elle enregistre.
  const ganttTaskRisks = useMemo(() => collectTaskDelayRisks(ganttTasks), [ganttTasks]);

  const updateCardBlock = (id, patch) => setCardBlocks((prev) => prev.map((b) => b.id === id ? { ...b, ...patch } : b));
  const removeCardBlock = (id) => setCardBlocks((prev) => prev.filter((b) => b.id !== id));
  const addCardBlock = () => setCardBlocks((prev) => [...prev, { id:uid(), kind:"taskTitle", label:"", emphasis:"normal", showIcon:true, icon:"tabler:circle-check", color:"", bgColor:"", showLabel:true, accent:"none" }]);
  const moveCardBlock = (id, dir) => setCardBlocks((prev) => {
    const i = prev.findIndex((b)=>b.id===id);
    const j = i + dir;
    if (i < 0 || j < 0 || j >= prev.length) return prev;
    const next=[...prev];
    [next[i],next[j]]=[next[j],next[i]];
    return next;
  });

  const toggleInList = (key, id) => setFilter((f) => {
    const list = f[key] || [];
    return { ...f, [key]: list.includes(id) ? list.filter((x) => x !== id) : [...list, id] };
  });

  const usesTaskFilter = type === "kpi" || type === "customCard" || type === "chart" || type === "list" || type === "minigantt" || type === "bubbles" || type === "criticalPath" || type === "heatmapMonth" || type === "milestoneTimeline" || type === "verticalMetroTimeline" || type === "metroDeadline" || type === "blockers" || type === "nextBestAction" || type === "dailyBriefing" || type === "dominoEffect" || type === "embedMetro" || type === "embedTimeline" || type === "embedRadar" || type === "taskDetail" || type === "projectTreemap" || type === "deadlineScatter" || type === "heatmapGrid" || (type === "countdown" && countdownMode === "filter");

  // Tâches proposées dans le sélecteur du widget "Tâche détaillée" : le filtre
  // de page (onglet) s'applique en priorité, puis le filtre propre au widget
  // vient encore restreindre — jamais l'inverse (même logique qu'à l'affichage,
  // voir `scoped` dans DashboardView).
  const taskDetailPickerTasks = useMemo(
    () => applyWidgetFilter(applyWidgetFilter(ctx.tasks, pageFilter, ctx), filter, ctx),
    [ctx, pageFilter, filter]
  );

  // Grise le bouton "Ajouter" tant qu'un champ requis pour ce type de widget manque —
  // évite de créer un widget qui s'afficherait vide faute d'une info essentielle.
  const isValid = (() => {
    if (type === "countdown") {
      if (countdownMode === "date") return !!countdownDate;
      if (countdownMode === "task") return !!countdownTaskId;
      return true; // mode "filtre" : toujours valide, vide = toutes les tâches
    }
    if (type === "taskDetail") return !!taskDetailTaskId;
    if (type === "customCard") {
      if (!cardBlocks.length) return false;
      if (cardTaskMode === "fixed" && !cardTaskId && cardBlocks.some((b)=>!["aggregate","staticText"].includes(b.kind))) return false;
      return true;
    }
    if (type === "budget") return !!budgetProjectId;
    if (type === "budgetBurnRate") return !!burnRateProjectId;
    if (type === "list") return Number(limit) > 0;
    // Un cadrage « Dates fixes » incomplet ou à l'envers n'a pas d'axe : la
    // fiche le dit sous les champs et refuse l'enregistrement.
    if (type === "minigantt") return ganttAnnotationsValid && !miniGanttWindowError;
    // Une macro-bulle sans libellé ne serait qu'une enveloppe anonyme : la
    // fiche refuse l'enregistrement, comme pour un bloc temporel sans titre.
    if (type === "bubbles") {
      return ganttAnnotationsValid && !miniGanttWindowError
        && bubbleSettings.bubbleMacros.every((m) => validateBubbleMacro(m).ok);
    }
    return true;
  })();

  /* Les réglages de la fiche, rassemblés une fois pour deux sorties :
     l'enregistrement classique, et le transfert vers un autre tableau de bord
     (#58) qui doit emporter EXACTEMENT la même configuration. Deux
     constructions séparées se seraient désynchronisées au premier réglage
     ajouté à un type de widget. */
  const buildData = () => {
    // Si aucun titre n'a été saisi, en génère un par défaut ("Type de widget N") —
    // toujours modifiable ensuite depuis la fiche du widget.
    let finalTitle = title.trim();
    if (!finalTitle) {
      const typeLabel = WIDGET_TYPE_META.find((m) => m.key === type)?.label || "Widget";
      const sameTypeCount = (existingWidgets || []).filter((w) => w.type === type).length;
      finalTitle = `${typeLabel} ${sameTypeCount + 1}`;
    }
    const data = { type, title: finalTitle };
    if (usesTaskFilter) data.filter = filter;
    if (type === "kpi") data.metric = metric;
    if (type === "customCard") {
      data.cardTaskMode = cardTaskMode;
      data.cardTaskId = cardTaskId || null;
      data.cardColumns = cardColumns;
      data.cardSurface = cardSurface;
      data.cardAccentColor = cardAccentColor || null;
      data.cardBackground = cardBackground || null;
      data.cardBorderColor = cardBorderColor || null;
      data.cardRadius = cardRadius;
      data.cardBlocks = cardBlocks.map((b)=>({...b}));
    }
    if (type === "chart") {
      data.chartStyle = chartStyle;
      if (chartStyle === "gauge") data.gaugeMetric = gaugeMetric;
      else if (chartStyle === "stackedBar") { data.groupBy = groupBy; data.stackBy = stackBy; }
      else if (chartStyle !== "line") { data.groupBy = groupBy; }
    }
    if (type === "list") { data.sortBy = sortBy; data.limit = Number(limit) || 6; data.groupBy = listGroupBy; }
    if (type === "countdown") { data.countdownMode = countdownMode; data.countdownDate = countdownDate; data.countdownTaskId = countdownTaskId; }
    if (type === "taskDetail") data.taskDetailTaskId = taskDetailTaskId;
    if (type === "note") data.content = content;
    if (type === "budget") { data.budgetProjectId = budgetProjectId; data.budgetMetric = budgetMetric; }
    if (type === "budgetBurnRate") data.burnRateProjectId = burnRateProjectId;
    if (type === "heatmapGrid") {
      data.heatmapRowField = heatmapRowField;
      data.heatmapColField = heatmapColField;
      data.heatmapMetric = heatmapMetric;
      data.heatmapPalette = heatmapPalette;
      data.heatmapShowValues = heatmapShowValues;
    }
    if (type === "deadlineScatter") {
      data.scatterLaneField = scatterLaneField;
      data.scatterWindowMode = scatterWindowMode;
      data.scatterWindowBefore = Number(scatterWindowBefore);
      data.scatterWindowAfter = Number(scatterWindowAfter);
    }
    if (type === "projectTreemap") {
      data.treemapTileBy = treemapTileBy;
      data.treemapSizeFilter = treemapSizeFilter;
      data.treemapColorFilter = treemapColorMode === "secondaryFilterGradient" ? treemapColorFilter : (widget?.treemapColorFilter || null);
      data.treemapColorMode = treemapColorMode;
      data.treemapPalette = treemapPalette;
      data.treemapDirection = treemapDirection;
      data.treemapShowZeroProjects = treemapShowZeroProjects;
      data.treemapFields = treemapFields;
      data.treemapShowProgressRing = treemapShowProgressRing;
      data.treemapShowUpcoming = treemapShowUpcoming;
      data.treemapGroupBy = treemapGroupBy;
      data.treemapCompact = treemapCompact;
      data.treemapShowLegend = treemapShowLegend;
      data.treemapShowSearch = treemapShowSearch;
      data.treemapOpenOnClick = treemapOpenOnClick;
      data.treemapRadius = treemapRadius;
      data.treemapGap = treemapGap;
      data.treemapBorder = treemapBorder;
    }
    if (type === "minigantt" || type === "bubbles") {
      data.ganttAnnotations = {
        temporalBlocks: normalizeTemporalBlocks(ganttAnnotations.temporalBlocks),
        highlightFrames: pruneHighlightFrames(ganttAnnotations.highlightFrames, ganttTasks.map((t) => t.id)),
        milestones: normalizeMiniGanttMilestones(ganttAnnotations.milestones),
        notes: normalizeMiniGanttNotes(ganttAnnotations.notes),
        spans: normalizeMiniGanttSpans(ganttAnnotations.spans),
      };
    }
    if (type === "minigantt") {
      data.groupBy = listGroupBy; data.showMilestones = showMilestones; data.colorBy = colorBy; data.miniGanttFields = miniGanttFields; data.miniGanttFieldsLayout = miniGanttFieldsLayout;
      data.miniGanttComparisonEnabled = miniGanttComparisonEnabled;
      data.miniGanttSort = miniGanttSort;
      data.miniGanttSortDir = miniGanttSortDir;
      data.miniGanttRange = normalizeMiniGanttRange(miniGanttRange);
      /* Les dates fixes vivent dans `miniGanttWindow`, comme avant : le rendu
         les lit déjà, et un widget qui en portait une ne change pas de forme.
         Les autres cadrages la relâchent, sinon elle primerait sur eux. */
      data.miniGanttWindow = miniGanttRange.mode === "fixed" && !miniGanttWindowError
        ? { start: miniGanttWindowStart, end: miniGanttWindowEnd }
        : null;
      if (widget?.miniGanttZoomLevel != null) data.miniGanttZoomLevel = widget.miniGanttZoomLevel;
    }
    if (type === "bubbles") {
      // Les clés du cadrage et du regroupement sont celles du Mini-Gantt, aux
      // mêmes noms : un widget qui change de type garde sa fenêtre, son zoom,
      // son tri et ses annotations.
      data.groupBy = listGroupBy;
      data.showMilestones = showMilestones;
      data.miniGanttSort = miniGanttSort;
      data.miniGanttSortDir = miniGanttSortDir;
      data.miniGanttRange = normalizeMiniGanttRange(miniGanttRange);
      data.miniGanttWindow = miniGanttRange.mode === "fixed" && !miniGanttWindowError
        ? { start: miniGanttWindowStart, end: miniGanttWindowEnd }
        : null;
      if (widget?.miniGanttZoomLevel != null) data.miniGanttZoomLevel = widget.miniGanttZoomLevel;
      const bubbles = normalizeBubblesWidget({
        ...bubbleSettings,
        // Une tâche supprimée entre-temps quitte la macro-bulle à
        // l'ENREGISTREMENT, jamais au rendu : un filtre de widget ne doit pas
        // détruire une configuration.
        bubbleMacros: pruneBubbleMacros(bubbleSettings.bubbleMacros, ganttTasks.map((t) => t.id)),
      });
      data.bubbleColorBy = bubbles.bubbleColorBy;
      data.bubbleFields = bubbles.bubbleFields;
      data.bubbleFieldsLayout = bubbles.bubbleFieldsLayout;
      data.bubbleLayout = bubbles.bubbleLayout;
      data.bubbleSize = bubbles.bubbleSize;
      data.bubbleShowDates = bubbles.bubbleShowDates;
      data.bubbleShowProgress = bubbles.bubbleShowProgress;
      data.bubbleShowDescription = bubbles.bubbleShowDescription;
      data.bubbleDescriptionLines = bubbles.bubbleDescriptionLines;
      data.bubbleShowLegend = bubbles.bubbleShowLegend;
      data.bubbleTruncateTitles = bubbles.bubbleTruncateTitles;
      data.bubbleMacroGrouping = bubbles.bubbleMacroGrouping;
      data.bubbleMacros = bubbles.bubbleMacros;
    }
    if (type === "staffing") {
      const st = normalizeStaffingWidget(staffingSettings);
      data.staffingRange = st.staffingRange;
      data.staffingOffset = st.staffingOffset;
      data.staffingMembers = st.staffingMembers;
      data.staffingExtraMembers = st.staffingExtraMembers;
      data.staffingShowWeekends = st.staffingShowWeekends;
      data.staffingShowLoad = st.staffingShowLoad;
    }
    if (titleColor) data.titleColor = titleColor; else data.titleColor = null;
    if (bgColor) data.bgColor = bgColor; else data.bgColor = null;
    if (bandColor) data.bandColor = bandColor; else data.bandColor = null;
    if (titleEmoji.trim()) data.titleEmoji = titleEmoji.trim(); else data.titleEmoji = null;
    if (type === "nextBestAction" || type === "dailyBriefing") data.onlyMine = onlyMine;
    return data;
  };

  const submit = () => {
    if (!isValid) return;
    onSave(buildData());
  };

  return (
    <Modal title={widget ? "Modifier le widget" : "Nouveau widget"} onClose={onClose} wide footer={
      <>
        <button className="lp-btn" onClick={onClose}>Annuler</button>
        <button className="lp-btn lp-btn-primary" onClick={submit} disabled={!isValid} title={!isValid ? "Renseigne les champs requis pour ce widget" : undefined}>{widget ? "Enregistrer" : "Ajouter le widget"}</button>
      </>
    }>
      <div className="lp-field"><label>Titre <span style={{ fontWeight: 400, textTransform: "none", color: "var(--text-600)" }}>(facultatif — sinon généré automatiquement)</span></label><input type="text" value={title} onChange={(e) => setTitle(e.target.value)} placeholder="Ex. Tâches en retard" autoFocus /></div>

      {/* Changer de tableau de bord (issue #58). Replié par défaut : c'est un
          geste rare, et déplié il pousserait les réglages du widget plus bas à
          chaque ouverture de la fiche. */}
      {transferOffered && (
        <div className="lp-widget-transfer">
          <div className="lp-widget-transfer-row">
            <span className="lp-widget-transfer-label"><LayoutDashboard size={13} /> Emplacement</span>
            <span className="lp-widget-transfer-here">{transferTargets.find(transferIsHere)?.label || "—"}</span>
            <button
              type="button"
              className="lp-btn lp-btn-mini"
              onClick={() => setTransferOpen((v) => !v)}
              aria-expanded={transferOpen}
            >
              Changer de tableau de bord
              <ChevronDown size={12} style={{ transform: transferOpen ? "rotate(180deg)" : "none" }} />
            </button>
          </div>

          {transferOpen && (
            <div className="lp-widget-transfer-panel">
              <div className="lp-field">
                <label>Tableau de bord de destination</label>
                <div className="lp-color-select" ref={transferPickerRef}>
                  <button
                    type="button"
                    className="lp-color-select-btn"
                    onClick={() => setTransferPickerOpen((o) => !o)}
                    aria-expanded={transferPickerOpen}
                  >
                    <span className="lp-color-select-label">
                      {transferSelected ? `${transferSelected.label}${transferIsHere(transferSelected) ? " — ici" : ""}` : "Aucune destination"}
                    </span>
                    <ChevronDown size={14} />
                  </button>
                  {transferPickerOpen && (
                    <div className="lp-color-select-panel">
                      {/* Même seuil que les autres listes de Nexora : en dessous
                          de six entrées, un champ de recherche encombre plus
                          qu'il n'aide. */}
                      {transferTargets.length > 5 && (
                        <input
                          ref={transferSearchRef}
                          type="text"
                          className="lp-select-search"
                          placeholder="Rechercher un tableau ou une page…"
                          value={transferQuery}
                          onChange={(e) => setTransferQuery(e.target.value)}
                          onClick={(e) => e.stopPropagation()}
                        />
                      )}
                      {transferFiltered.map((t) => (
                        <button
                          type="button"
                          key={`${t.boardId}-${t.pageId}`}
                          className={"lp-color-select-option" + (t === transferSelected ? " active" : "")}
                          onClick={() => { setTransferIndex(String(transferTargets.indexOf(t))); setTransferPickerOpen(false); }}
                        >
                          {t.label}{transferIsHere(t) ? " — ici" : ""}
                        </button>
                      ))}
                      {transferFiltered.length === 0 && <div className="lp-select-empty">Aucun résultat</div>}
                    </div>
                  )}
                </div>
              </div>

              <div className="lp-field">
                <label>Ce qu'il advient du widget</label>
                <div className="lp-widget-transfer-modes">
                  <label className={transferMode === "move" ? "active" : undefined}>
                    <input type="radio" name="lp-widget-transfer-mode" checked={transferMode === "move"} onChange={() => setTransferMode("move")} />
                    <span><strong>Le déplacer</strong> — il quitte ce tableau de bord.</span>
                  </label>
                  <label className={transferMode === "duplicate" ? "active" : undefined}>
                    <input type="radio" name="lp-widget-transfer-mode" checked={transferMode === "duplicate"} onChange={() => setTransferMode("duplicate")} />
                    <span><strong>Le dupliquer</strong> — une copie indépendante part là-bas, l'original reste ici.</span>
                  </label>
                </div>
              </div>

              <p className="lp-widget-transfer-hint">
                Les réglages affichés dans cette fiche partent avec le widget. Sa position
                dans la grille est recalculée à l'arrivée : elle n'aurait pas de sens sur
                une autre page.
              </p>

              <button
                type="button"
                className="lp-btn lp-btn-primary"
                disabled={!isValid || !transferSelected || (transferMode === "move" && transferIsHere(transferSelected))}
                title={transferMode === "move" && transferSelected && transferIsHere(transferSelected) ? "Le widget est déjà sur ce tableau de bord" : undefined}
                onClick={() => onTransfer({ data: buildData(), target: { boardId: transferSelected.boardId, pageId: transferSelected.pageId }, mode: transferMode })}
              >
                {transferMode === "move" ? "Déplacer le widget" : "Dupliquer le widget"}
              </button>
            </div>
          )}
        </div>
      )}

      <div className="lp-widget-type-hard-selector">
        <div className="lp-widget-type-hard-selector-row">
          <span className="lp-widget-type-hard-selector-label">
            <LayoutDashboard size={14}/>
            Type de widget
          </span>
          <button
            type="button"
            className="lp-widget-type-hard-selector-current"
            onClick={()=>setTypePickerOpen((v)=>!v)}
            aria-expanded={typePickerOpen}
          >
            <span>{WIDGET_TYPE_META.find((m)=>m.key===type)?.label || type}</span>
            <ChevronDown size={13} style={{transform:typePickerOpen ? "rotate(180deg)" : "none"}}/>
          </button>
        </div>

        {typePickerOpen && (
          <div className="lp-widget-type-hard-selector-panel">
            <div className="lp-widget-type-search-wrap">
              <Search size={13} className="lp-widget-type-search-icon" />
              <input
                type="text"
                className="lp-widget-type-search"
                placeholder="Rechercher un type de widget…"
                value={typeSearch}
                onChange={(e)=>setTypeSearch(e.target.value)}
              />
              {typeSearch && (
                <button type="button" className="lp-icon-btn" onClick={()=>setTypeSearch("")}>
                  <X size={12}/>
                </button>
              )}
            </div>

            <div className="lp-widget-type-picker">
              {WIDGET_TYPE_GROUPS.map((g)=>{
                const q=typeSearch.trim().toLowerCase();
                const items=WIDGET_TYPE_META.filter((m)=>m.group===g && (!q || m.label.toLowerCase().includes(q)));
                if(!items.length) return null;
                return (
                  <div key={g} className="lp-widget-type-group">
                    <div className="lp-widget-type-group-label">{g}</div>
                    <div className="lp-widget-type-grid">
                      {items.map((m)=>{
                        const Icon=m.icon;
                        return (
                          <button
                            key={m.key}
                            type="button"
                            className={"lp-widget-type-card"+(type===m.key ? " active" : "")}
                            onClick={()=>{
                              setType(m.key);
                              if(widget) setTypePickerOpen(false);
                            }}
                          >
                            <span className="lp-widget-type-card-icon"><Icon size={15}/></span>
                            <span>{m.label}</span>
                          </button>
                        );
                      })}
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        )}
      </div>

      <div className="lp-widget-config-section">
        <div className="lp-widget-config-title"><SlidersHorizontal size={12} /> Configuration</div>
        {["criticalPath", "heatmapMonth", "milestoneTimeline", "verticalMetroTimeline", "metroDeadline", "blockers"].includes(type) && (
          <p style={{ fontSize: 12, color: "var(--text-600)", margin: 0 }}>Ce widget n'a pas de réglage spécifique — choisis les projets concernés dans le filtre ci-dessous.</p>
        )}
        {type === "kpi" && (
        <div className="lp-field">
          <label>Mesure</label>
          <select value={metric} onChange={(e) => setMetric(e.target.value)}>
            {WIDGET_METRICS.map((m) => <option key={m.key} value={m.key}>{m.label}</option>)}
          </select>
        </div>
      )}
      {type === "customCard" && (
        <div className="lp-custom-card-config">
          <div className="lp-row2">
            <div className="lp-field">
              <label>Source des informations de tâche</label>
              <select value={cardTaskMode} onChange={(e)=>setCardTaskMode(e.target.value)}>
                <option value="first">Première tâche du filtre</option>
                <option value="fixed">Une tâche précise</option>
              </select>
            </div>
            <div className="lp-field">
              <label>Colonnes de la carte</label>
              <select value={cardColumns} onChange={(e)=>setCardColumns(Number(e.target.value))}>
                <option value={1}>1 colonne</option>
                <option value={2}>2 colonnes</option>
                <option value={3}>3 colonnes</option>
              </select>
            </div>
          </div>

          <div className="lp-custom-card-appearance">
            <div className="lp-custom-card-appearance-title">
              <Palette size={13}/> Apparence de la carte
            </div>
            <div className="lp-row3">
              <div className="lp-field">
                <label>Style</label>
                <select value={cardSurface} onChange={(e)=>setCardSurface(e.target.value)}>
                  <option value="plain">Classique</option>
                  <option value="soft">Teinté</option>
                  <option value="outline">Contour accentué</option>
                  <option value="minimal">Minimal</option>
                </select>
              </div>
              <div className="lp-field">
                <label>Arrondi</label>
                <select value={cardRadius} onChange={(e)=>setCardRadius(e.target.value)}>
                  <option value="none">Aucun</option>
                  <option value="small">Petit</option>
                  <option value="medium">Moyen</option>
                  <option value="large">Grand</option>
                </select>
              </div>
              <div className="lp-field">
                <label>Couleur d'accent</label>
                <div className="lp-custom-card-color-row">
                  <input type="color" value={cardAccentColor || "#4F6AF5"} onChange={(e)=>setCardAccentColor(e.target.value)}/>
                  <button type="button" className="lp-btn" onClick={()=>setCardAccentColor("")}>Auto</button>
                </div>
              </div>
            </div>
            <div className="lp-row2">
              <div className="lp-field">
                <label>Fond général</label>
                <div className="lp-custom-card-color-row">
                  <input type="color" value={cardBackground || "#FFFFFF"} onChange={(e)=>setCardBackground(e.target.value)}/>
                  <button type="button" className="lp-btn" onClick={()=>setCardBackground("")}>Auto</button>
                </div>
              </div>
              <div className="lp-field">
                <label>Bordure générale</label>
                <div className="lp-custom-card-color-row">
                  <input type="color" value={cardBorderColor || "#D9DEE7"} onChange={(e)=>setCardBorderColor(e.target.value)}/>
                  <button type="button" className="lp-btn" onClick={()=>setCardBorderColor("")}>Auto</button>
                </div>
              </div>
            </div>
          </div>

          {cardTaskMode === "fixed" && (
            <div className="lp-field">
              <label>Tâche de référence</label>
              <TaskDetailPicker tasks={ctx.tasks} projects={ctx.projects} value={cardTaskId} onChange={setCardTaskId}/>
            </div>
          )}

          <div className="lp-custom-card-blocks-head">
            <div>
              <strong>Blocs affichés</strong>
              <span>Les agrégations utilisent les tâches du filtre ; les autres blocs utilisent la tâche de référence.</span>
            </div>
            <button type="button" className="lp-btn" onClick={addCardBlock}><Plus size={12}/> Ajouter un bloc</button>
          </div>

          <div className="lp-custom-card-block-editor-list">
            {cardBlocks.map((b,i)=>(
              <div key={b.id} className="lp-custom-card-block-editor">
                <div className="lp-custom-card-block-editor-top">
                  <span className="lp-custom-card-block-index">{i+1}</span>
                  <select value={b.kind} onChange={(e)=>updateCardBlock(b.id,{kind:e.target.value})}>
                    {CUSTOM_CARD_BLOCK_TYPES.map((o)=><option key={o.key} value={o.key}>{o.label}</option>)}
                  </select>
                  <button type="button" className="lp-icon-btn" disabled={i===0} onClick={()=>moveCardBlock(b.id,-1)} title="Monter"><ChevronUp size={13}/></button>
                  <button type="button" className="lp-icon-btn" disabled={i===cardBlocks.length-1} onClick={()=>moveCardBlock(b.id,1)} title="Descendre"><ChevronDown size={13}/></button>
                  <button type="button" className="lp-icon-btn" onClick={()=>removeCardBlock(b.id)} title="Supprimer"><Trash2 size={13}/></button>
                </div>

                <div className="lp-row3">
                  <div className="lp-field">
                    <label>Libellé <span style={{fontWeight:400,textTransform:"none"}}>(facultatif)</span></label>
                    <input value={b.label || ""} onChange={(e)=>updateCardBlock(b.id,{label:e.target.value})} placeholder="Ex. Échéance"/>
                  </div>
                  <div className="lp-field">
                    <label>Importance visuelle</label>
                    <select value={b.emphasis || "normal"} onChange={(e)=>updateCardBlock(b.id,{emphasis:e.target.value})}>
                      <option value="hero">Grande</option>
                      <option value="normal">Normale</option>
                      <option value="small">Compacte</option>
                    </select>
                  </div>
                  <div className="lp-field">
                    <label>Largeur</label>
                    <select value={b.span || "auto"} onChange={(e)=>updateCardBlock(b.id,{span:e.target.value})}>
                      <option value="auto">Automatique</option>
                      <option value="full">Toute la ligne</option>
                    </select>
                  </div>
                </div>

                <div className="lp-custom-card-block-style">
                  <div className="lp-custom-card-block-style-head">
                    <span>Style du bloc</span>
                    <label className="lp-checkbox-line">
                      <input
                        type="checkbox"
                        checked={b.showLabel !== false}
                        onChange={(e)=>updateCardBlock(b.id,{showLabel:e.target.checked})}
                      />
                      Afficher le libellé
                    </label>
                    <label className="lp-checkbox-line">
                      <input
                        type="checkbox"
                        checked={b.showIcon !== false}
                        onChange={(e)=>updateCardBlock(b.id,{showIcon:e.target.checked})}
                      />
                      Icône
                    </label>
                  </div>

                  {b.showIcon !== false && (
                    <div className="lp-field">
                      <label>Icône du bloc</label>
                      <IconEditor
                        icon={b.icon || CUSTOM_CARD_DEFAULT_ICONS[b.kind] || ""}
                        setIcon={(icon)=>updateCardBlock(b.id,{icon})}
                      />
                    </div>
                  )}

                  <div className="lp-row3">
                    <div className="lp-field">
                      <label>Couleur texte / icône</label>
                      <div className="lp-custom-card-color-row">
                        <input type="color" value={b.color || cardAccentColor || "#4F6AF5"} onChange={(e)=>updateCardBlock(b.id,{color:e.target.value})}/>
                        <button type="button" className="lp-btn" onClick={()=>updateCardBlock(b.id,{color:""})}>Auto</button>
                      </div>
                    </div>
                    <div className="lp-field">
                      <label>Fond du bloc</label>
                      <div className="lp-custom-card-color-row">
                        <input type="color" value={b.bgColor || "#FFFFFF"} onChange={(e)=>updateCardBlock(b.id,{bgColor:e.target.value})}/>
                        <button type="button" className="lp-btn" onClick={()=>updateCardBlock(b.id,{bgColor:""})}>Auto</button>
                      </div>
                    </div>
                    <div className="lp-field">
                      <label>Accent</label>
                      <select value={b.accent || "none"} onChange={(e)=>updateCardBlock(b.id,{accent:e.target.value})}>
                        <option value="none">Aucun</option>
                        <option value="left">Barre gauche</option>
                        <option value="top">Barre haute</option>
                        <option value="icon">Pastille icône</option>
                      </select>
                    </div>
                  </div>
                </div>

                {b.kind === "aggregate" && (
                  <div className="lp-field">
                    <label>Mesure agrégée</label>
                    <select value={b.metric || "count"} onChange={(e)=>updateCardBlock(b.id,{metric:e.target.value})}>
                      {WIDGET_METRICS.map((m)=><option key={m.key} value={m.key}>{m.label}</option>)}
                    </select>
                  </div>
                )}



                {b.kind === "staticText" && (
                  <div className="lp-field">
                    <label>Texte</label>
                    <textarea rows={2} value={b.text || ""} onChange={(e)=>updateCardBlock(b.id,{text:e.target.value})} placeholder="Texte libre à afficher sur la carte…"/>
                  </div>
                )}
              </div>
            ))}
            {!cardBlocks.length && <div className="lp-empty" style={{padding:12}}>Ajoute au moins un bloc à la carte.</div>}
          </div>
        </div>
      )}
      {type === "chart" && (
        <>
          <div className="lp-field">
            <label>Style de graphique</label>
            <select value={chartStyle} onChange={(e) => setChartStyle(e.target.value)}>
              {CHART_STYLES.map((s) => <option key={s.key} value={s.key}>{s.label}</option>)}
            </select>
          </div>
          {chartStyle === "gauge" && (
            <div className="lp-field">
              <label>Mesure</label>
              <select value={gaugeMetric} onChange={(e) => setGaugeMetric(e.target.value)}>
                {GAUGE_METRICS.map((m) => <option key={m.key} value={m.key}>{m.label}</option>)}
              </select>
            </div>
          )}
          {chartStyle === "line" && (
            <p style={{ fontSize: 12, color: "var(--text-600)", marginTop: -6 }}>La courbe montre l'évolution du nombre de tâches, mois par mois, selon leur date de fin.</p>
          )}
          {(chartStyle === "pie" || chartStyle === "bar" || chartStyle === "barh") && (
            <div className="lp-field">
              <label>Regrouper par</label>
              <select value={groupBy} onChange={(e) => setGroupBy(e.target.value)}>
                <WidgetGroupByOptions ctx={ctx} />
              </select>
            </div>
          )}
          {chartStyle === "stackedBar" && (
            <div className="lp-row2">
              <div className="lp-field">
                <label>Axe principal</label>
                <select value={groupBy} onChange={(e) => setGroupBy(e.target.value)}>
                  <WidgetGroupByOptions ctx={ctx} />
                </select>
              </div>
              <div className="lp-field">
                <label>Empilement</label>
                <select value={stackBy} onChange={(e) => setStackBy(e.target.value)}>
                  <WidgetGroupByOptions ctx={ctx} />
                </select>
              </div>
            </div>
          )}
        </>
      )}
      {type === "list" && (
        <div className="lp-row2">
          <div className="lp-field">
            <label>Trier par</label>
            <select value={sortBy} onChange={(e) => setSortBy(e.target.value)}>
              <option value="end">Date de fin</option>
              <option value="progress">Avancement</option>
              <option value="title">Titre</option>
              <option value="inactivity">Inactivité</option>
            </select>
          </div>
          <div className="lp-field"><label>Nombre max.</label><input type="number" min="1" max="30" value={limit} onChange={(e) => setLimit(e.target.value)} /></div>
        </div>
      )}

      {type === "list" && (
        <div className="lp-field">
          <label>Grouper par <span style={{ fontWeight: 400, textTransform: "none", color: "var(--text-600)" }}>(distingue visuellement les tâches par sections)</span></label>
          <select value={listGroupBy} onChange={(e) => setListGroupBy(e.target.value)}>
            <option value="none">Aucun</option>
            <option value="project">Projet</option>
            <option value="status">Statut</option>
            <option value="taskType">Type</option>
            <option value="assignee">Responsable</option>
            <option value="inactivity">Inactivité</option>
            <option value="period">Période</option>
          </select>
        </div>
      )}

      {type === "taskDetail" && (
        <div className="lp-field">
          <label>Tâche à afficher</label>
          <TaskDetailPicker
            tasks={taskDetailPickerTasks}
            projects={ctx.projects}
            value={taskDetailTaskId}
            onChange={setTaskDetailTaskId}
          />
          <p style={{fontSize:12,color:"var(--text-600)",marginTop:6,marginBottom:0}}>
            Recherche par nom de tâche ou par projet. Le projet est affiché pour chaque résultat — seules les tâches correspondant aux filtres ci-dessous (et à ceux de l'onglet) sont proposées.
          </p>
        </div>
      )}

      {type === "countdown" && (
        <>
          <div className="lp-field">
            <label>Suivre</label>
            <div className="lp-density-row">
              <button className={"lp-density-btn" + (countdownMode === "date" ? " active" : "")} onClick={() => setCountdownMode("date")}>Une date fixe</button>
              <button className={"lp-density-btn" + (countdownMode === "task" ? " active" : "")} onClick={() => setCountdownMode("task")}>Une tâche / un jalon</button>
              <button className={"lp-density-btn" + (countdownMode === "filter" ? " active" : "")} onClick={() => setCountdownMode("filter")}>Prochaine échéance filtrée</button>
            </div>
          </div>
          {countdownMode === "date" && (
            <div className="lp-field"><label>Date cible</label><input type="date" value={countdownDate} onChange={(e) => setCountdownDate(e.target.value)} /></div>
          )}
          {countdownMode === "task" && (
            <div className="lp-field">
              <label>Tâche ou jalon</label>
              <select value={countdownTaskId} onChange={(e) => setCountdownTaskId(e.target.value)}>
                <option value="">— Choisir —</option>
                {ctx.tasks.map((t) => <option key={t.id} value={t.id}>{t.title} ({fmtShort(t.end)})</option>)}
              </select>
            </div>
          )}
          {countdownMode === "filter" && (
            <p style={{ fontSize: 12, color: "var(--text-600)", marginTop: -6, marginBottom: 0 }}>La tâche dont l'échéance est la plus proche parmi celles qui correspondent au filtre ci-dessous est suivie automatiquement — plus besoin de repointer une tâche précise à chaque fois.</p>
          )}
        </>
      )}

      {type === "note" && (
        <div className="lp-field">
          <label>Contenu</label>
          <textarea className="lp-widget-note-edit" value={content} onChange={(e) => setContent(e.target.value)} placeholder="Écris ta note ici…" rows={5} />
        </div>
      )}

      {type === "budget" && (
        <>
          <div className="lp-field">
            <label>Projet</label>
            <ProjectSelect projects={ctx.projects} value={budgetProjectId} onChange={setBudgetProjectId} />
          </div>
          <div className="lp-field">
            <label>Mesure</label>
            <select value={budgetMetric} onChange={(e) => setBudgetMetric(e.target.value)}>
              <option value="engaged">Total dépensé (réel)</option>
              <option value="pctConsumed">% du budget consommé</option>
              <option value="reste">Reste disponible</option>
              <option value="byCategory">Répartition par catégorie</option>
            </select>
          </div>
        </>
      )}




      {type === "budgetBurnRate" && (
        <div className="lp-field">
          <label>Projet</label>
          <ProjectSelect projects={ctx.projects} value={burnRateProjectId} onChange={setBurnRateProjectId} />
          <p style={{ fontSize: 12, color: "var(--text-600)", marginTop: 6, marginBottom: 0 }}>Calculé à partir des dépenses réellement enregistrées dans le Chiffrage de ce projet — nécessite qu'au moins une dépense datée y soit renseignée.</p>
        </div>
      )}


      {(type === "nextBestAction" || type === "dailyBriefing") && (
        <label className="lp-checkbox-line" style={{ marginTop: -4 }}>
          <input type="checkbox" checked={onlyMine} onChange={(e) => setOnlyMine(e.target.checked)} /> Seulement mes tâches
        </label>
      )}


      {type === "heatmapGrid" && (
        <>
          <p style={{ fontSize: 12, color: "var(--text-600)", marginTop: -6, marginBottom: 10 }}>
            Une case = un croisement entre les deux champs choisis. Toutes les cases ont la même taille : c'est la couleur
            seule qui porte l'information, là où le Treemap encode aussi une surface. Une case hachurée n'a aucune tâche ;
            une case colorée affichant 0 en a, mais aucune ne compte pour la mesure. Le filtre général du widget (plus bas)
            décide du périmètre.
          </p>
          <div style={{ display: "flex", gap: 8 }}>
            <div className="lp-field" style={{ flex: 1, margin: 0 }}>
              <label>Lignes</label>
              <select value={heatmapRowField} onChange={(e) => setHeatmapRowField(e.target.value)}>
                {HEATMAP_AXIS_FIELDS.map((k) => <option value={k} key={k}>{HEATMAP_AXIS_LABELS[k]}</option>)}
              </select>
            </div>
            <div className="lp-field" style={{ flex: 1, margin: 0 }}>
              <label>Colonnes</label>
              <select value={heatmapColField} onChange={(e) => setHeatmapColField(e.target.value)}>
                {HEATMAP_AXIS_FIELDS.map((k) => <option value={k} key={k}>{HEATMAP_AXIS_LABELS[k]}</option>)}
              </select>
            </div>
          </div>
          {heatmapRowField === heatmapColField && (
            <p style={{ fontSize: 12, color: "var(--warning)", marginTop: 6, marginBottom: 0 }}>
              Les deux axes sont identiques : la grille se réduirait à une diagonale. Un second champ sera choisi
              à l'enregistrement.
            </p>
          )}
          <div className="lp-field" style={{ marginTop: 8 }}>
            <label>Mesure portée par la couleur</label>
            <select value={heatmapMetric} onChange={(e) => setHeatmapMetric(e.target.value)}>
              {HEATMAP_METRICS.map((k) => <option value={k} key={k}>{HEATMAP_METRIC_LABELS[k]}</option>)}
            </select>
          </div>
          <div className="lp-field" style={{ marginTop: 8 }}>
            <label>Palette</label>
            <select value={heatmapPalette} onChange={(e) => setHeatmapPalette(e.target.value)}>
              {Object.entries(TREEMAP_PALETTES).map(([k, p]) => <option value={k} key={k}>{p.label}</option>)}
            </select>
          </div>
          <label className="lp-checkbox-line" style={{ marginTop: 8 }}>
            <input type="checkbox" checked={heatmapShowValues} onChange={(e) => setHeatmapShowValues(e.target.checked)} />
            Afficher la valeur dans chaque case
          </label>
        </>
      )}
      {type === "deadlineScatter" && (
        <>
          <p style={{ fontSize: 12, color: "var(--text-600)", marginTop: -6, marginBottom: 10 }}>
            Un point = une tâche, placée selon le nombre de jours qui la sépare de son échéance : à droite ce qui vient,
            à gauche ce qui est en retard. Les tâches sans date de fin ne sont pas placées. Le filtre général du widget
            (plus bas) décide du périmètre.
          </p>
          <div className="lp-field">
            <label>Couloirs</label>
            <select
              value={scatterLaneField}
              onChange={(e) => setScatterLaneField(e.target.value)}
            >
              <option value="project">Projet</option>
              <option value="status">Statut</option>
              <option value="criticality">Criticité</option>
            </select>
          </div>
          <div className="lp-field">
            <label>Plage affichée</label>
            <div className="lp-density-row">
              <button type="button" className={"lp-density-btn" + (scatterWindowMode === "auto" ? " active" : "")} onClick={() => setScatterWindowMode("auto")}>Automatique</button>
              <button type="button" className={"lp-density-btn" + (scatterWindowMode === "fixed" ? " active" : "")} onClick={() => setScatterWindowMode("fixed")}>Fenêtre fixe</button>
            </div>
            {scatterWindowMode === "auto" ? (
              <p style={{ fontSize: 12, color: "var(--text-600)", marginTop: 6, marginBottom: 0 }}>
                L'axe s'ajuste aux tâches du filtre. Une seule échéance lointaine suffit alors à tasser tout le reste
                autour de l'origine : passe en fenêtre fixe si ça t'arrive.
              </p>
            ) : (
              <>
                <div style={{ display: "flex", gap: 8, marginTop: 8 }}>
                  <div className="lp-field" style={{ flex: 1, margin: 0 }}>
                    <label>Jours de retard affichés</label>
                    <input type="number" min={1} max={SCATTER_WINDOW_MAX_DAYS} value={scatterWindowBefore}
                           onChange={(e) => setScatterWindowBefore(e.target.value)} />
                  </div>
                  <div className="lp-field" style={{ flex: 1, margin: 0 }}>
                    <label>Jours à venir affichés</label>
                    <input type="number" min={1} max={SCATTER_WINDOW_MAX_DAYS} value={scatterWindowAfter}
                           onChange={(e) => setScatterWindowAfter(e.target.value)} />
                  </div>
                </div>
                <p style={{ fontSize: 12, color: "var(--text-600)", marginTop: 6, marginBottom: 0 }}>
                  Les tâches hors fenêtre ne sont pas masquées : elles sont rabattues sur le bord, dessinées en chevron
                  tourné vers l'extérieur, et comptées aux deux bouts de l'axe. Leur vraie échéance reste dans l'infobulle.
                </p>
              </>
            )}
          </div>
        </>
      )}
      {type === "projectTreemap" && (
        <>
          <p style={{ fontSize: 12, color: "var(--text-600)", marginTop: -6, marginBottom: 10 }}>
            Une tuile = une valeur du champ choisi ci-dessous. La surface vient du nombre de tâches de la tuile retenues par
            le filtre de taille ; la couleur, du réglage « Coloration ». Le filtre général du widget (plus bas) décide d'abord
            du périmètre.
          </p>

          <div className="lp-widget-config-title" style={{ marginTop: 4 }}><Search size={12} /> Données</div>
          <div className="lp-field">
            <label>Une tuile représente</label>
            <select value={treemapTileBy} onChange={(e) => setTreemapTileBy(e.target.value)}>
              {TREEMAP_TILE_BY.map((key) => (
                <option value={key} key={key}>{TREEMAP_TILE_BY_LABELS[key].label}</option>
              ))}
            </select>
            {treemapTileBy !== "project" && (
              <p style={{ fontSize: 12, color: "var(--text-600)", marginTop: 6, marginBottom: 0 }}>
                Dossier, priorité, budget et risques appartiennent au projet : ces champs de tuile et ces regroupements sont
                retirés tant que les tuiles ne sont pas des projets. Ouvrir, modifier ou filtrer sur la tuile reste également
                propre aux projets.
              </p>
            )}
          </div>
          <div className="lp-field">
            <label>Filtre de taille <span style={{ fontWeight: 400, textTransform: "none", color: "var(--text-600)" }}>(vide = toutes les tâches du périmètre)</span></label>
            <div className="lp-widget-appearance-toggle" onClick={() => setTreemapSizeFilterOpen((v) => !v)}>
              <ChevronRight size={13} style={{ transform: treemapSizeFilterOpen ? "rotate(90deg)" : "none" }} />
              <Filter size={13} /> Tâches comptées pour la surface
              <span className="lp-widget-appearance-hint">{activeWidgetFilterCount(treemapSizeFilter) || "aucune"} condition{activeWidgetFilterCount(treemapSizeFilter) > 1 ? "s" : ""}</span>
            </div>
            {treemapSizeFilterOpen && (
              <div className="lp-widget-appearance-panel">
                <TaskFilterFields filter={treemapSizeFilter} setFilter={setTreemapSizeFilter} ctx={ctx} />
              </div>
            )}
          </div>
          <label className="lp-checkbox-line">
            <input type="checkbox" checked={treemapShowZeroProjects} onChange={(e) => setTreemapShowZeroProjects(e.target.checked)} />
            Afficher les {TREEMAP_TILE_BY_LABELS[treemapTileBy].plural} sans tâche correspondante, en tuile minimale
          </label>

          <div className="lp-widget-config-title" style={{ marginTop: 14 }}><Palette size={12} /> Encodage visuel</div>
          <div className="lp-field">
            <label>Coloration des projets</label>
            <div className="lp-density-row">
              <button type="button" className={"lp-density-btn" + (treemapColorMode === "sizeFilterGradient" ? " active" : "")} onClick={() => setTreemapColorMode("sizeFilterGradient")}>Même filtre</button>
              <button type="button" className={"lp-density-btn" + (treemapColorMode === "secondaryFilterGradient" ? " active" : "")} onClick={() => setTreemapColorMode("secondaryFilterGradient")}>Second filtre</button>
              <button type="button" className={"lp-density-btn" + (treemapColorMode === "averageCriticality" ? " active" : "")} onClick={() => { setTreemapColorMode("averageCriticality"); setTreemapPalette("levels"); }}>Criticité moyenne</button>
            </div>
            <p className="lp-gantt-annot-hint">
              {treemapColorMode === "sizeFilterGradient" && "La couleur suit le même comptage que la surface : plus un projet est gros, plus il est intense."}
              {treemapColorMode === "secondaryFilterGradient" && "La couleur suit un second comptage, indépendant de la surface — par exemple taille = tâches actives, couleur = tâches en retard."}
              {treemapColorMode === "averageCriticality" && `Criticité = moyenne, sur les tâches retenues, de : retard ${TREEMAP_CRITICALITY_WEIGHTS.late}, criticité urgente ${TREEMAP_CRITICALITY_WEIGHTS.urgent}, échéance ≤ ${TREEMAP_DUE_SOON_DAYS} j ${TREEMAP_CRITICALITY_WEIGHTS.dueSoon}, jalon ${TREEMAP_CRITICALITY_WEIGHTS.milestone}, inactivité ≥ ${TREEMAP_STALE_DAYS} j ${TREEMAP_CRITICALITY_WEIGHTS.stale}, projet prioritaire ${TREEMAP_CRITICALITY_WEIGHTS.projectPriorityHigh}. Une tâche terminée vaut 0. La règle est rappelée dans l'infobulle de chaque tuile.`}
            </p>
          </div>
          {treemapColorMode === "secondaryFilterGradient" && (
            <div className="lp-field">
              <label>Filtre de coloration</label>
              <div className="lp-widget-appearance-toggle" onClick={() => setTreemapColorFilterOpen((v) => !v)}>
                <ChevronRight size={13} style={{ transform: treemapColorFilterOpen ? "rotate(90deg)" : "none" }} />
                <Filter size={13} /> Tâches comptées pour la couleur
                <span className="lp-widget-appearance-hint">{activeWidgetFilterCount(treemapColorFilter) || "aucune"} condition{activeWidgetFilterCount(treemapColorFilter) > 1 ? "s" : ""}</span>
              </div>
              {treemapColorFilterOpen && (
                <div className="lp-widget-appearance-panel">
                  <TaskFilterFields filter={treemapColorFilter} setFilter={setTreemapColorFilter} ctx={ctx} />
                </div>
              )}
            </div>
          )}
          <div className="lp-row2">
            <div className="lp-field">
              <label>Palette</label>
              <select value={treemapPalette} onChange={(e) => setTreemapPalette(e.target.value)}>
                {Object.entries(TREEMAP_PALETTES).map(([key, p]) => <option key={key} value={key}>{p.label}</option>)}
              </select>
            </div>
            <div className="lp-field">
              <label>Sens</label>
              <div className="lp-density-row">
                <button type="button" className={"lp-density-btn" + (treemapDirection === "lowToHigh" ? " active" : "")} onClick={() => setTreemapDirection("lowToHigh")}>Croissant</button>
                <button type="button" className={"lp-density-btn" + (treemapDirection === "highToLow" ? " active" : "")} onClick={() => setTreemapDirection("highToLow")}>Décroissant</button>
              </div>
            </div>
          </div>
          <label className="lp-checkbox-line">
            <input type="checkbox" checked={treemapShowLegend} onChange={(e) => setTreemapShowLegend(e.target.checked)} /> Afficher la légende (cliquable pour isoler une tranche)
          </label>

          <div className="lp-widget-config-title" style={{ marginTop: 14 }}><Layers size={12} /> Contenu des tuiles</div>
          <div className="lp-field">
            <label>Champs affichés <span style={{ fontWeight: 400, textTransform: "none", color: "var(--text-600)" }}>(dans cet ordre — les petites tuiles n'en gardent que le début)</span></label>
            <div style={{ display: "flex", flexDirection: "column", gap: 4 }}>
              {treemapFields.map((key) => (
                <div className="lp-gantt-annot-head" key={key} style={{ cursor: "default" }}>
                  <span className="lp-gantt-annot-summary"><strong>{treemapFieldLabel(key)}</strong></span>
                  <span className="lp-gantt-annot-actions">
                    <button type="button" className="lp-icon-btn" onClick={() => moveTreemapField(key, -1)} disabled={treemapFields[0] === key} title="Monter"><ChevronUp size={12} /></button>
                    <button type="button" className="lp-icon-btn" onClick={() => moveTreemapField(key, 1)} disabled={treemapFields[treemapFields.length - 1] === key} title="Descendre"><ChevronDown size={12} /></button>
                    <button type="button" className="lp-icon-btn" onClick={() => setTreemapFields((prev) => prev.filter((k) => k !== key))} disabled={key === "projectName"} title={key === "projectName" ? "Le nom du projet est toujours affiché" : "Retirer"}><X size={12} /></button>
                  </span>
                </div>
              ))}
            </div>
            <div style={{ marginTop: 6 }}>
              <DropdownButton label={`${treemapFields.length} champ${treemapFields.length > 1 ? "s" : ""} affiché${treemapFields.length > 1 ? "s" : ""}`} icon={<Plus size={13} />} title="Champs disponibles">
                <div className="lp-dropdown-group-label">Champs disponibles</div>
                {treemapFieldCatalogue.map((f) => (
                  <label className="lp-checkbox-line" key={f.key}>
                    <input
                      type="checkbox"
                      checked={treemapFields.includes(f.key)}
                      disabled={f.key === "projectName"}
                      onChange={() => setTreemapFields((prev) => (prev.includes(f.key) ? prev.filter((k) => k !== f.key) : [...prev, f.key]))}
                    /> {f.label}
                  </label>
                ))}
              </DropdownButton>
            </div>
          </div>
          <label className="lp-checkbox-line">
            <input type="checkbox" checked={treemapShowProgressRing} onChange={(e) => setTreemapShowProgressRing(e.target.checked)} /> Afficher la progression sous forme d'anneau (champ « Progression »)
          </label>
          <label className="lp-checkbox-line">
            <input type="checkbox" checked={treemapShowUpcoming} onChange={(e) => setTreemapShowUpcoming(e.target.checked)} /> Afficher les prochaines tâches du projet
          </label>
          {treemapShowUpcoming && (
            <p className="lp-gantt-annot-hint">
              Les tâches non terminées qui portent une échéance, de la plus ancienne à la plus récente, en rouge si elles sont en retard.
              Le nombre affiché s'adapte tout seul à la hauteur de chaque tuile ; le reste est annoncé par un « + N autres ».
            </p>
          )}
          <label className="lp-checkbox-line">
            <input type="checkbox" checked={treemapCompact} onChange={(e) => setTreemapCompact(e.target.checked)} /> Mode compact — plus d'informations sur les petites tuiles
          </label>

          <div className="lp-widget-config-title" style={{ marginTop: 14 }}><Crosshair size={12} /> Interactions</div>
          <label className="lp-checkbox-line">
            <input type="checkbox" checked={treemapOpenOnClick} onChange={(e) => setTreemapOpenOnClick(e.target.checked)} /> Ouvrir le projet au clic sur sa tuile
          </label>
          <label className="lp-checkbox-line">
            <input type="checkbox" checked={treemapShowSearch} onChange={(e) => setTreemapShowSearch(e.target.checked)} /> Afficher la recherche par nom de tuile
          </label>
          <div className="lp-field" style={{ marginTop: 8 }}>
            <label>Regroupement</label>
            <div className="lp-density-row">
              <button type="button" className={"lp-density-btn" + (treemapGroupBy === "none" ? " active" : "")} onClick={() => setTreemapGroupBy("none")}>Aucun</button>
              {treemapTileBy === "project" && (
                <>
                  <button type="button" className={"lp-density-btn" + (treemapGroupBy === "folder" ? " active" : "")} onClick={() => setTreemapGroupBy("folder")}>Dossier</button>
                  <button type="button" className={"lp-density-btn" + (treemapGroupBy === "priority" ? " active" : "")} onClick={() => setTreemapGroupBy("priority")}>Priorité</button>
                </>
              )}
              <button type="button" className={"lp-density-btn" + (treemapGroupBy === "owner" ? " active" : "")} onClick={() => setTreemapGroupBy("owner")}>Responsable</button>
              <button type="button" className={"lp-density-btn" + (treemapGroupBy === "criticality" ? " active" : "")} onClick={() => setTreemapGroupBy("criticality")}>Criticité</button>
            </div>
          </div>

          <div className="lp-widget-config-title" style={{ marginTop: 14 }}><Palette size={12} /> Apparence des tuiles</div>
          <div className="lp-row2">
            <div className="lp-field">
              <label>Arrondi</label>
              <div className="lp-density-row">
                <button type="button" className={"lp-density-btn" + (treemapRadius === "sharp" ? " active" : "")} onClick={() => setTreemapRadius("sharp")}>Net</button>
                <button type="button" className={"lp-density-btn" + (treemapRadius === "medium" ? " active" : "")} onClick={() => setTreemapRadius("medium")}>Doux</button>
                <button type="button" className={"lp-density-btn" + (treemapRadius === "round" ? " active" : "")} onClick={() => setTreemapRadius("round")}>Arrondi</button>
              </div>
            </div>
            <div className="lp-field">
              <label>Espacement — {treemapGap} px</label>
              <input type="range" min="0" max="12" value={treemapGap} onChange={(e) => setTreemapGap(Number(e.target.value))} style={{ width: "100%" }} />
            </div>
          </div>
          <label className="lp-checkbox-line">
            <input type="checkbox" checked={treemapBorder} onChange={(e) => setTreemapBorder(e.target.checked)} /> Contour discret autour de chaque tuile
          </label>
        </>
      )}

      {type === "minigantt" && (
        /* Le formulaire d'affichage du Mini-Gantt vit dans un composant partagé
           avec les réglages de la vue pleine page : la fiche ne fait que lui
           prêter son état local, et les deux ne peuvent plus diverger (#86). */
        <MiniGanttDisplayFields
          value={{
            groupBy: listGroupBy,
            showMilestones,
            colorBy,
            miniGanttFields,
            miniGanttFieldsLayout,
            miniGanttSort,
            miniGanttSortDir,
            miniGanttRange,
            miniGanttWindow: { start: miniGanttWindowStart, end: miniGanttWindowEnd },
            miniGanttComparisonEnabled,
          }}
          onChange={applyMiniGanttPatch}
          ctx={ctx}
          scope="widget"
        />
      )}

      {type === "staffing" && (
        <StaffingDisplayFields value={staffingSettings} onChange={applyStaffingPatch} ctx={ctx} />
      )}

      {type === "bubbles" && (
        /* Même contrat que le Mini-Gantt : un formulaire partagé, qui ne
           connaît que des clés, et la fiche qui les range dans son état local
           jusqu'à l'enregistrement. */
        <BubblesDisplayFields
          value={{
            ...bubbleSettings,
            groupBy: listGroupBy,
            showMilestones,
            miniGanttSort,
            miniGanttSortDir,
            miniGanttRange,
            miniGanttWindow: { start: miniGanttWindowStart, end: miniGanttWindowEnd },
          }}
          onChange={applyBubblePatch}
          ctx={ctx}
        />
      )}

      {type === "bubbles" && (
        <BubbleMacrosEditor
          macros={bubbleSettings.bubbleMacros}
          tasks={ganttTasks}
          ctx={ctx}
          onChange={(bubbleMacros) => applyBubblePatch({ bubbleMacros })}
        />
      )}

      {(type === "minigantt" || type === "bubbles") && (
        <>
          <p style={{ fontSize: 12, color: "var(--text-600)", marginTop: -6, marginBottom: 8 }}>
            Les annotations ci-dessous sont enregistrées avec ce widget : elles suivent sa duplication, celle de l'onglet et celle du tableau de bord, sans jamais modifier les tâches.
          </p>
          {/* Un seul éditeur, pour les deux types : les blocs temporels, les
              encadrés, les jalons et les annotations sont les MÊMES couches,
              dessinées par le même diagramme. La branche « sans jalons ni
              annotations » qui vivait ici ne servait plus personne. */}
          <MiniGanttAnnotationsEditor
            blocks={ganttAnnotations.temporalBlocks}
            frames={ganttAnnotations.highlightFrames}
            milestones={ganttAnnotations.milestones}
            risks={ganttTaskRisks}
            notes={ganttAnnotations.notes}
            spans={ganttAnnotations.spans}
            allowSpans
            tasks={ganttTasks}
            ctx={ctx}
            defaultStart={ganttDefaultStart}
            defaultEnd={ganttDefaultEnd}
            onChange={(patch) => setGanttAnnotations((prev) => ({ ...prev, ...patch }))}
          />
        </>
      )}

      </div>

      {usesTaskFilter && (
        <div className="lp-widget-config-section">
          <div className="lp-widget-config-title"><Search size={12} /> Filtrer les tâches prises en compte</div>
          <TaskFilterFields filter={filter} setFilter={setFilter} ctx={ctx} />
        </div>
      )}

      <div className="lp-widget-appearance-toggle" onClick={() => setShowAppearance((v) => !v)}>
        <ChevronRight size={13} style={{ transform: showAppearance ? "rotate(90deg)" : "none" }} />
        <Palette size={13} /> Personnalisation visuelle
        <span className="lp-widget-appearance-hint">emoji, couleurs</span>
      </div>
      {showAppearance && (
        <div className="lp-widget-appearance-panel">
          <div className="lp-field">
            <label>Icône du titre <span style={{ fontWeight: 400, textTransform: "none", color: "var(--text-600)" }}>(icône Tabler, image importée ou lien d'image)</span></label>
            <IconEditor icon={titleEmoji} setIcon={setTitleEmoji} />
          </div>
          <div className="lp-row3">
            <div className="lp-field">
              <label>Couleur du titre</label>
              <div style={{ display: "flex", gap: 6 }}>
                <input type="color" value={titleColor || "#0B1526"} onChange={(e) => setTitleColor(e.target.value)} style={{ flex: 1, height: 34 }} />
                {titleColor && <button type="button" className="lp-icon-btn" onClick={() => setTitleColor("")} title="Revenir à la couleur par défaut"><X size={13} /></button>}
              </div>
            </div>
            <div className="lp-field">
              <label>Couleur du bandeau</label>
              <div style={{ display: "flex", gap: 6 }}>
                <input type="color" value={bandColor || "#F3EFE6"} onChange={(e) => setBandColor(e.target.value)} style={{ flex: 1, height: 34 }} />
                {bandColor && <button type="button" className="lp-icon-btn" onClick={() => setBandColor("")} title="Revenir à la couleur par défaut"><X size={13} /></button>}
              </div>
            </div>
            <div className="lp-field">
              <label>Couleur de fond</label>
              <div style={{ display: "flex", gap: 6 }}>
                <input type="color" value={bgColor || "#ffffff"} onChange={(e) => setBgColor(e.target.value)} style={{ flex: 1, height: 34 }} />
                {bgColor && <button type="button" className="lp-icon-btn" onClick={() => setBgColor("")} title="Revenir à la couleur par défaut"><X size={13} /></button>}
              </div>
            </div>
          </div>
        </div>
      )}
    </Modal>
  );
}

// ============================================================================
// Authentification multi-utilisateur — porte d'accès avant l'application
// Chaque compte a ses propres données, isolées via users/{uid}/kv_store côté
// Firestore (voir window.storage dans la page hôte + firestore.rules fourni).
// ============================================================================
// Authentification multi-utilisateur — page d'accueil, connexion/inscription,
// puis l'application. Chaque compte a ses propres données, isolées via
// users/{uid}/kv_store côté Firestore (voir window.storage + firestore.rules).
// ============================================================================

// Illustration signature : une carte de métro stylisée, écho direct de la vue
// "Planning Projets" — c'est la seule vraie signature visuelle de Nexora.
function MetroHeroArt() {
  return (
    <svg viewBox="0 0 640 420" className="lp-hero-art" xmlns="http://www.w3.org/2000/svg">
      <path className="lp-hero-line lp-hero-line-1" d="M 30 120 L 220 120 Q 260 120 260 160 L 260 220 Q 260 260 300 260 L 610 260" />
      <path className="lp-hero-line lp-hero-line-2" d="M 60 320 L 240 320 Q 280 320 280 280 L 280 180 Q 280 140 320 140 L 580 140" />
      <path className="lp-hero-line lp-hero-line-3" d="M 100 40 L 100 200 Q 100 240 140 240 L 400 240 Q 440 240 440 280 L 440 380" />
      {[[30,120],[220,120],[260,220],[610,260],[60,320],[240,320],[280,180],[580,140],[100,40],[100,200],[400,240],[440,380]].map(([x,y],i) => (
        <circle key={i} cx={x} cy={y} r="7" className="lp-hero-station" />
      ))}
    </svg>
  );
}

function LandingPage({ onGetStarted, onLogin }) {
  const FEATURES = [
    { icon: "🚇", title: "Planning Projets", text: "Chaque projet devient une ligne de métro : bifurcations pour les tâches, épaisseur du trait selon l'avancement." },
    { icon: "📊", title: "Gantt", text: "Planning visuel unique : regroupements, annotations, risques et comparaison." },
    { icon: "🎯", title: "Radar annuel", text: "Vue circulaire de toute l'année, pour voir la charge se répartir dans le temps." },
    { icon: "🗂️", title: "Tableur type Airtable", text: "Édition en masse, duplication, ajout rapide — sans jamais quitter la grille." },
  ];
  return (
    <div className="lp-theme lp-landing">
      <nav className="lp-landing-nav">
        <img src={NEXORA_LOGO_FULL} alt="Nexora" className="lp-landing-logo-img" />
        <div className="lp-landing-nav-actions">
          <button className="lp-ghost-btn" onClick={onLogin}>Se connecter</button>
          <button className="lp-primary-btn" onClick={onGetStarted}>Essayer gratuitement</button>
        </div>
      </nav>

      <header className="lp-landing-hero">
        <div className="lp-landing-hero-text">
          <span className="lp-landing-eyebrow">Gestion de projet</span>
          <h1 className="lp-landing-title">Vos projets, tracés<br />comme un plan de métro.</h1>
          <p className="lp-landing-sub">
            Liste, Gantt, Radar annuel, Tableur, Planning en ligne de métro — neuf vues sur les
            mêmes données, pour trouver enfin celle qui vous parle vraiment.
          </p>
          <div className="lp-landing-cta-row">
            <button className="lp-primary-btn lp-landing-cta" onClick={onGetStarted}>Créer mon compte gratuitement</button>
            <button className="lp-ghost-btn" onClick={onLogin}>J'ai déjà un compte</button>
          </div>
        </div>
        <div className="lp-landing-hero-art-wrap"><MetroHeroArt /></div>
      </header>

      <section className="lp-landing-features">
        {FEATURES.map((f) => (
          <div className="lp-landing-feature-card" key={f.title}>
            <span className="lp-landing-feature-icon">{f.icon}</span>
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </div>
        ))}
      </section>

      <section className="lp-landing-band">
        <h2>Prêt à voir vos projets autrement ?</h2>
        <button className="lp-primary-btn lp-landing-cta" onClick={onGetStarted}>Essayer gratuitement</button>
      </section>

      <footer className="lp-landing-footer">© {new Date().getFullYear()} Nexora</footer>
    </div>
  );
}

function ReadmeModal({ onClose }) {
  return (
    <Modal title="Guide de démarrage" onClose={onClose} wide>
      <div className="lp-readme">
        <p className="lp-readme-intro">
          Nexora affiche les mêmes projets et tâches sous <strong>neuf angles différents</strong> —
          l'idée est de piocher la vue qui correspond à ce que vous voulez comprendre à l'instant T,
          pas d'en choisir une seule pour toujours.
        </p>

        <h3>Les vues disponibles</h3>
        <div className="lp-readme-grid">
          <div><strong>📋 Liste</strong> — grille classique, groupement, sous-tâches.</div>
          <div><strong>📊 Gantt</strong> — zoom du jour à 5 ans, dépendances entre tâches.</div>
          <div><strong>🔥 Heat map</strong> — densité de charge sur l'année, par semaine.</div>
          <div><strong>📅 Calendrier</strong> — vue semaine/mois classique.</div>
          <div><strong>🛤️ Timeline + Liste</strong> — frise chronologique en bulles.</div>
          <div><strong>🎯 Radar</strong> — calendrier circulaire de toute l'année.</div>
          <div><strong>☀️ Aujourd'hui</strong> — tableau de bord du jour.</div>
          <div><strong>🚇 Planning Projets</strong> — chaque projet en ligne de métro.</div>
          <div><strong>🗂️ Tableur</strong> — édition en masse façon Airtable.</div>
        </div>

        <h3>Fonctionnalités clés</h3>
        <ul className="lp-readme-list">
          <li><strong>Dépendances</strong> — dans la fiche d'une tâche, indiquez de quelles tâches elle dépend. Sa date de début se recale alors automatiquement, et un avertissement apparaît en cas de conflit.</li>
          <li><strong>Tâches récurrentes</strong> — cochez "Tâche récurrente" dans la fiche : une nouvelle occurrence est créée automatiquement à chaque passage à "Terminé".</li>
          <li><strong>Filtres et tri</strong> — en haut de l'écran, s'appliquent à toutes les vues à la fois.</li>
          <li><strong>Ctrl/Cmd+clic</strong> sur un projet dans la barre latérale pour l'ajouter/le retirer du filtre, sans remplacer toute la sélection.</li>
        </ul>

        <h3>Raccourcis clavier</h3>
        <div className="lp-readme-shortcuts">
          <span><kbd>N</kbd> Nouvelle tâche</span>
          <span><kbd>Ctrl</kbd>+<kbd>Alt</kbd>+<kbd>N</kbd> Tâche rapide</span>
          <span><kbd>/</kbd> Rechercher</span>
          <span><kbd>Échap</kbd> Fermer</span>
        </div>

        <p className="lp-readme-footer-note">
          Ce guide reste accessible à tout moment depuis "Guide de démarrage", en bas de la barre latérale.
        </p>
      </div>
    </Modal>
  );
}

function AssistantFirebaseExport({ user }) {
  const [state, setState] = useState({ status:"loading", payload:null, error:"" });

  useEffect(() => {
    let cancelled = false;
    const readValue = async (key, fallback) => {
      try {
        const result = await window.storage.get(key);
        return {
          value:parseStoredValue(result.value),
          revision:result.revision || null,
          updatedAt:result.updatedAt || null,
          storageMode:result.storageMode || "inline",
          chunkCount:Number(result.chunkCount || 0),
        };
      } catch (error) {
        const message = (error && error.message) || String(error);
        if (message.includes("Key not found")) {
          return { value:fallback, revision:null, updatedAt:null, storageMode:"missing", chunkCount:0 };
        }
        throw new Error(`${key} : ${message}`);
      }
    };

    (async () => {
      try {
        if (!window.storage) throw new Error("Firebase/storage indisponible.");
        const [tasksDoc, archiveDoc, projectsDoc, statusesDoc, typesDoc, membersDoc] = await Promise.all([
          readValue("nexora:tasks", []),
          readValue("nexora:taskArchive", []),
          readValue("nexora:projects", []),
          readValue("nexora:statuses", []),
          readValue("nexora:taskTypes", []),
          readValue("nexora:teamMembers", []),
        ]);

        const tasks = Array.isArray(tasksDoc.value) ? tasksDoc.value : [];
        const archive = Array.isArray(archiveDoc.value) ? archiveDoc.value : [];
        const projects = Array.isArray(projectsDoc.value) ? projectsDoc.value : [];
        const statuses = Array.isArray(statusesDoc.value) ? statusesDoc.value : [];
        const taskTypes = Array.isArray(typesDoc.value) ? typesDoc.value : [];
        const teamMembers = Array.isArray(membersDoc.value) ? membersDoc.value : [];
        const projectById = new Map(projects.map((item) => [item.id, item]));
        const statusById = new Map(statuses.map((item) => [item.id, item]));
        const typeById = new Map(taskTypes.map((item) => [item.id, item]));
        const doneStatusIds = new Set(statuses
          .filter((item) => /^(termine|terminee|terminees|fait|faite|done|clos|cloture)$/i.test(normalizeForMatch(item?.name || "")))
          .map((item) => item.id));

        const enrich = (task, source="active") => ({
          id:task.id || null,
          source,
          archivedAt:source === "archive" ? (task.archivedAt || null) : null,
          title:task.title || "",
          project:{ id:task.projectId || null, name:projectById.get(task.projectId)?.name || null },
          status:{ id:task.statusId || null, name:statusById.get(task.statusId)?.name || null, done:doneStatusIds.has(task.statusId) },
          taskType:{ id:task.taskTypeId || null, name:typeById.get(task.taskTypeId)?.name || null },
          start:task.start || null,
          end:task.end || null,
          milestone:!!task.milestone,
          progress:Number.isFinite(Number(task.progress)) ? Number(task.progress) : null,
          assignee:task.assignee || null,
          priority:task.priority || null,
          description:task.desc || "",
          checklist:Array.isArray(task.checklist) ? task.checklist : [],
          attachments:Array.isArray(task.attachments) ? task.attachments : [],
          customFields:task.customFields && typeof task.customFields === "object" ? task.customFields : {},
          lastInteraction:task.lastInteraction || null,
        });

        const activeTasks = tasks.map((task) => enrich(task));
        const now = new Date();
        const parisDate = new Intl.DateTimeFormat("fr-CA", {
          timeZone:"Europe/Paris", year:"numeric", month:"2-digit", day:"2-digit"
        }).format(now);
        const dated = activeTasks.filter((task) => task.start || task.end);
        const today = dated.filter((task) => task.start === parisDate || task.end === parisDate);
        const overdue = dated.filter((task) => !task.status.done && (task.end || task.start) < parisDate);
        const upcoming = dated.filter((task) => (task.start || task.end) > parisDate)
          .sort((a,b) => String(a.start || a.end).localeCompare(String(b.start || b.end)));
        const inactive = activeTasks.filter((task) => {
          if (!task.lastInteraction) return false;
          const age = now.getTime() - new Date(task.lastInteraction).getTime();
          return Number.isFinite(age) && age > 30 * 86400000;
        });
        const scope = new URLSearchParams(window.location.search).get("scope") || "today";
        const documents = {
          tasks:{ revision:tasksDoc.revision, updatedAt:tasksDoc.updatedAt, storageMode:tasksDoc.storageMode, chunkCount:tasksDoc.chunkCount },
          taskArchive:{ revision:archiveDoc.revision, updatedAt:archiveDoc.updatedAt, storageMode:archiveDoc.storageMode, chunkCount:archiveDoc.chunkCount },
          projects:{ revision:projectsDoc.revision, updatedAt:projectsDoc.updatedAt, storageMode:projectsDoc.storageMode, chunkCount:projectsDoc.chunkCount },
          statuses:{ revision:statusesDoc.revision, updatedAt:statusesDoc.updatedAt, storageMode:statusesDoc.storageMode, chunkCount:statusesDoc.chunkCount },
          taskTypes:{ revision:typesDoc.revision, updatedAt:typesDoc.updatedAt, storageMode:typesDoc.storageMode, chunkCount:typesDoc.chunkCount },
        };
        const payload = {
          ok:true,
          mode:"firebase-direct-readonly",
          export:"assistant",
          scope,
          generatedAt:now.toISOString(),
          timezone:"Europe/Paris",
          date:parisDate,
          user:{ uid:user.uid, email:user.email || null },
          health:{
            authenticated:true,
            activeTaskCount:tasks.length,
            archivedTaskCount:archive.length,
            projectCount:projects.length,
            statusCount:statuses.length,
            taskTypeCount:taskTypes.length,
            teamMemberCount:teamMembers.length,
            documents,
          },
          data: scope === "health" ? null
            : scope === "catalogs" ? { projects, statuses, taskTypes, teamMembers }
            : scope === "tasks" ? { active:activeTasks, archived:archive.map((task) => enrich(task, "archive")) }
            : { today, overdue, upcoming, inactive },
        };
        if (!cancelled) setState({ status:"ready", payload, error:"" });
      } catch (error) {
        const message = (error && error.message) || String(error);
        if (!cancelled) setState({ status:"error", payload:null, error:message });
      }
    })();
    return () => { cancelled = true; };
  }, [user.uid]);

  const output = state.status === "ready" ? state.payload
    : state.status === "error" ? { ok:false, mode:"firebase-direct-readonly", export:"assistant", error:state.error }
    : { ok:false, mode:"firebase-direct-readonly", export:"assistant", status:"loading" };

  return (
    <main className="lp-theme" style={{ minHeight:"100vh", background:"var(--bg)", padding:24 }}>
      <h1 style={{ fontSize:20, margin:"0 0 12px" }}>Assistant personnel Nexora — Firebase</h1>
      <p style={{ color:"var(--text-600)", margin:"0 0 16px" }}>Lecture seule · aucune donnée n’est modifiée.</p>
      <pre id="nexora-assistant-export" style={{ whiteSpace:"pre-wrap", overflowWrap:"anywhere", background:"var(--surface)", border:"1px solid var(--border)", borderRadius:12, padding:16, fontSize:12 }}>
        {JSON.stringify(output, null, 2)}
      </pre>
    </main>
  );
}

function MeetingFirebaseExport({ user }) {
  const [state, setState] = useState({ status:"loading", payload:null, error:"" });

  useEffect(() => {
    let cancelled = false;

    const readValue = async (key, fallback) => {
      try {
        const result = await window.storage.get(key);
        return {
          value: parseStoredValue(result.value),
          revision: result.revision || null,
          updatedAt: result.updatedAt || null,
          storageMode: result.storageMode || "inline",
          chunkCount: Number(result.chunkCount || 0),
        };
      } catch (error) {
        const message = (error && error.message) || String(error);
        if (message.includes("Key not found")) {
          return { value:fallback, revision:null, updatedAt:null, storageMode:"missing", chunkCount:0 };
        }
        throw new Error(`${key} : ${message}`);
      }
    };

    (async () => {
      try {
        if (!window.storage) throw new Error("Firebase/storage indisponible.");

        const [tasksDoc, archiveDoc, typesDoc, projectsDoc, statusesDoc] = await Promise.all([
          readValue("nexora:tasks", []),
          readValue("nexora:taskArchive", []),
          readValue("nexora:taskTypes", []),
          readValue("nexora:projects", []),
          readValue("nexora:statuses", []),
        ]);

        const tasks = Array.isArray(tasksDoc.value) ? tasksDoc.value : [];
        const archive = Array.isArray(archiveDoc.value) ? archiveDoc.value : [];
        const taskTypes = Array.isArray(typesDoc.value) ? typesDoc.value : [];
        const projects = Array.isArray(projectsDoc.value) ? projectsDoc.value : [];
        const statuses = Array.isArray(statusesDoc.value) ? statusesDoc.value : [];
        const meetingTypeIds = new Set(
          taskTypes
            .filter((type) => ["reunion", "reunions"].includes(normalizeForMatch(type?.name || "")))
            .map((type) => type.id)
            .filter(Boolean)
        );

        const projectById = new Map(projects.map((project) => [project.id, project]));
        const statusById = new Map(statuses.map((status) => [status.id, status]));
        const typeById = new Map(taskTypes.map((type) => [type.id, type]));

        const selectMeeting = (task, source) => {
          if (!task || !meetingTypeIds.has(task.taskTypeId)) return null;
          const type = typeById.get(task.taskTypeId);
          const project = projectById.get(task.projectId);
          const status = statusById.get(task.statusId);
          return {
            id: task.id || null,
            source,
            archivedAt: source === "archive" ? (task.archivedAt || null) : null,
            title: task.title || "",
            project: project ? { id:project.id, name:project.name || "" } : { id:task.projectId || null, name:null },
            status: status ? { id:status.id, name:status.name || "" } : { id:task.statusId || null, name:null },
            taskType: { id:type?.id || task.taskTypeId, name:type?.name || null },
            start: task.start || null,
            end: task.end || null,
            milestone: !!task.milestone,
            progress: Number.isFinite(Number(task.progress)) ? Number(task.progress) : null,
            assignee: task.assignee || null,
            description: task.desc || "",
            checklist: Array.isArray(task.checklist) ? task.checklist : [],
            attachments: Array.isArray(task.attachments) ? task.attachments : [],
            customFields: task.customFields && typeof task.customFields === "object" ? task.customFields : {},
            lastInteraction: task.lastInteraction || null,
          };
        };

        const meetings = [
          ...tasks.map((task) => selectMeeting(task, "active")),
          ...archive.map((task) => selectMeeting(task, "archive")),
        ].filter(Boolean).sort((a, b) =>
          String(a.start || a.end || "9999-12-31").localeCompare(String(b.start || b.end || "9999-12-31")) ||
          String(a.title).localeCompare(String(b.title), "fr")
        );

        const now = new Date();
        const parisDate = new Intl.DateTimeFormat("fr-CA", {
          timeZone:"Europe/Paris", year:"numeric", month:"2-digit", day:"2-digit"
        }).format(now);
        const payload = {
          ok:true,
          mode:"firebase-direct-readonly",
          generatedAt:now.toISOString(),
          timezone:"Europe/Paris",
          date:parisDate,
          user:{ uid:user.uid, email:user.email || null },
          diagnostics:{
            activeTaskCount:tasks.length,
            archivedTaskCount:archive.length,
            meetingCount:meetings.length,
            meetingTypeIds:[...meetingTypeIds],
            documents:{
              tasks:{ revision:tasksDoc.revision, updatedAt:tasksDoc.updatedAt, storageMode:tasksDoc.storageMode, chunkCount:tasksDoc.chunkCount },
              taskArchive:{ revision:archiveDoc.revision, updatedAt:archiveDoc.updatedAt, storageMode:archiveDoc.storageMode, chunkCount:archiveDoc.chunkCount },
              taskTypes:{ revision:typesDoc.revision, updatedAt:typesDoc.updatedAt, storageMode:typesDoc.storageMode, chunkCount:typesDoc.chunkCount },
            },
          },
          meetings,
        };

        if (!cancelled) setState({ status:"ready", payload, error:"" });
      } catch (error) {
        const message = (error && error.message) || String(error);
        if (!cancelled) setState({ status:"error", payload:null, error:message });
      }
    })();

    return () => { cancelled = true; };
  }, [user.uid]);

  const output = state.status === "ready"
    ? state.payload
    : state.status === "error"
      ? { ok:false, mode:"firebase-direct-readonly", error:state.error }
      : { ok:false, mode:"firebase-direct-readonly", status:"loading" };

  return (
    <main className="lp-theme" style={{ minHeight:"100vh", background:"var(--bg)", padding:24 }}>
      <h1 style={{ fontSize:20, margin:"0 0 12px" }}>Export Réunions Nexora — Firebase</h1>
      <p style={{ color:"var(--text-600)", margin:"0 0 16px" }}>
        Lecture seule · aucune donnée n’est modifiée.
      </p>
      <pre id="nexora-meeting-export" style={{ whiteSpace:"pre-wrap", overflowWrap:"anywhere", background:"var(--surface)", border:"1px solid var(--border)", borderRadius:12, padding:16, fontSize:12 }}>
        {JSON.stringify(output, null, 2)}
      </pre>
    </main>
  );
}

function AuthGate() {
  const [screen, setScreen] = useState("landing"); // landing | auth | app (dérivé pour les non-connectés)
  const [authState, setAuthState] = useState("checking"); // checking | out | in
  const [user, setUser] = useState(null);
  const [mode, setMode] = useState("signup"); // login | signup | reset
  const [email, setEmail] = useState("");
  const [password, setPassword] = useState("");
  const [error, setError] = useState("");
  const [busy, setBusy] = useState(false);
  const [info, setInfo] = useState("");

  // Migration ponctuelle des données de l'ancien emplacement partagé (kv_store)
  // vers l'emplacement isolé du compte (users/{uid}/kv_store), proposée une
  // seule fois si des données pré-existantes sont détectées.
  const [migration, setMigration] = useState(null); // null | "checking" | "available" | "running" | "done"

  useEffect(() => {
    const unsub = onAuthStateChanged(auth, (u) => {
      setUser(u);
      setAuthState(u ? "in" : "out");
    });
    return () => unsub();
  }, []);

  useEffect(() => {
    if (authState !== "in" || !user) return;
    let cancelled = false;
    (async () => {
      setMigration("checking");
      try {
        const newCol = collection(db, "users", user.uid, "kv_store");
        const newSnap = await getDocs(newCol);
        if (!newSnap.empty) { if (!cancelled) setMigration(null); return; }
        const oldCol = collection(db, "kv_store");
        const oldSnap = await getDocs(oldCol);
        if (oldSnap.empty) { if (!cancelled) setMigration(null); return; }
        if (!cancelled) setMigration("available");
      } catch {
        if (!cancelled) setMigration(null);
      }
    })();
    return () => { cancelled = true; };
  }, [authState, user]);

  const runMigration = async () => {
    setMigration("running");
    try {
      const oldSnap = await getDocs(collection(db, "kv_store"));
      for (const d of oldSnap.docs) {
        await setDoc(doc(db, "users", user.uid, "kv_store", d.id), d.data());
      }
      setMigration("done");
    } catch (e) {
      setMigration("available");
      setError("La migration a échoué : " + (e.message || e));
    }
  };

  const translateError = (code) => {
    const map = {
      "auth/invalid-email": "Adresse e-mail invalide.",
      "auth/user-not-found": "Aucun compte ne correspond à cet e-mail.",
      "auth/wrong-password": "Mot de passe incorrect.",
      "auth/invalid-credential": "E-mail ou mot de passe incorrect.",
      "auth/email-already-in-use": "Un compte existe déjà avec cet e-mail.",
      "auth/weak-password": "Le mot de passe doit contenir au moins 6 caractères.",
      "auth/too-many-requests": "Trop de tentatives — réessaie dans quelques minutes.",
    };
    return map[code] || "Une erreur est survenue.";
  };

  const submit = async (e) => {
    e.preventDefault();
    setError(""); setInfo("");
    if (!email.trim() || (mode !== "reset" && !password)) return;
    setBusy(true);
    try {
      if (mode === "login") await signInWithEmailAndPassword(auth, email.trim(), password);
      else if (mode === "signup") await createUserWithEmailAndPassword(auth, email.trim(), password);
      else if (mode === "reset") { await sendPasswordResetEmail(auth, email.trim()); setInfo("E-mail de réinitialisation envoyé — vérifie ta boîte de réception."); }
    } catch (err) {
      setError(translateError(err.code));
    } finally {
      setBusy(false);
    }
  };

  let content;
  if (authState === "checking") {
    content = <div className="lp-theme lp-auth-boot"><div className="lp-sync-dot" /></div>;
  } else if (authState === "in") {
    if (migration === "available" || migration === "running") {
      content = (
        <div className="lp-theme lp-auth-wrap">
          <div className="lp-auth-card">
            <img src={NEXORA_LOGO_FULL} alt="Nexora" className="lp-landing-logo-img" style={{ marginBottom: 18, display: "block" }} />
            <h2 className="lp-display">Données existantes trouvées</h2>
            <p style={{ fontSize: 13.5, color: "var(--text-600)", marginBottom: 18 }}>
              Nexora a détecté des projets et tâches enregistrés avant la mise en place des comptes. Veux-tu les rattacher à ton compte <strong>{user.email}</strong> ?
            </p>
            <div style={{ display: "flex", gap: 8 }}>
              <button className="lp-primary-btn" onClick={runMigration} disabled={migration === "running"}>{migration === "running" ? "Import en cours…" : "Importer mes données"}</button>
              <button className="lp-ghost-btn" onClick={() => setMigration(null)} disabled={migration === "running"}>Ignorer, démarrer à vide</button>
            </div>
            {error && <div className="lp-auth-error">{error}</div>}
          </div>
        </div>
      );
    } else {
      const params = new URLSearchParams(window.location.search);
      const assistantExportMode = params.get("nexoraAssistantExport") === "1";
      const meetingExportMode = params.get("nexoraMeetingExport") === "1";
      content = assistantExportMode
        ? <AssistantFirebaseExport user={user} />
        : meetingExportMode
          ? <MeetingFirebaseExport user={user} />
          : <LePlan currentUser={user} onSignOut={() => signOut(auth)} />;
    }
  } else if (screen === "landing") {
    content = <LandingPage onGetStarted={() => { setMode("signup"); setScreen("auth"); }} onLogin={() => { setMode("login"); setScreen("auth"); }} />;
  } else {
    content = (
      <div className="lp-theme lp-auth-wrap">
        <form className="lp-auth-card" onSubmit={submit}>
          <button type="button" className="lp-auth-logo-btn" onClick={() => setScreen("landing")}><img src={NEXORA_LOGO_FULL} alt="Nexora" className="lp-landing-logo-img" /></button>
          <h2 className="lp-display lp-auth-title">
            {mode === "login" && "Content de te revoir"}
            {mode === "signup" && "Créer ton compte"}
            {mode === "reset" && "Mot de passe oublié"}
          </h2>
          <p className="lp-auth-lede">
            {mode === "login" && "Connecte-toi à ton espace de projets."}
            {mode === "signup" && "Chaque compte a son propre espace, isolé des autres — gratuit pour commencer."}
            {mode === "reset" && "Reçois un lien pour réinitialiser ton mot de passe."}
          </p>
          <div className="lp-field">
            <label>E-mail</label>
            <input type="email" placeholder="toi@exemple.com" value={email} onChange={(e) => setEmail(e.target.value)} autoFocus required />
          </div>
          {mode !== "reset" && (
            <div className="lp-field">
              <label>Mot de passe</label>
              <input type="password" placeholder="••••••••" value={password} onChange={(e) => setPassword(e.target.value)} minLength={6} required />
            </div>
          )}
          {error && <div className="lp-auth-error">{error}</div>}
          {info && <div className="lp-auth-info">{info}</div>}
          <button className="lp-auth-submit" type="submit" disabled={busy}>
            {busy ? <span className="lp-sync-dot" /> : mode === "login" ? "Se connecter" : mode === "signup" ? "Créer mon compte" : "Envoyer le lien"}
          </button>
          <div className="lp-auth-links">
            {mode === "login" && <>
              <button type="button" onClick={() => { setMode("signup"); setError(""); }}>Créer un compte</button>
              <button type="button" onClick={() => { setMode("reset"); setError(""); }}>Mot de passe oublié ?</button>
            </>}
            {mode === "signup" && <button type="button" onClick={() => { setMode("login"); setError(""); }}>J'ai déjà un compte</button>}
            {mode === "reset" && <button type="button" onClick={() => { setMode("login"); setError(""); }}>Retour à la connexion</button>}
          </div>
        </form>
      </div>
    );
  }

  return (
    <>
      <GlobalStyles />
      {content}
    </>
  );
}

// ============================================================================
// Vue "Chiffrage" — suivi budgétaire par projet : budget initial/actuel,
// dépenses engagées/à venir/aléas, table détaillée et synthèse par catégorie
// (catégories personnalisables par l'utilisateur, comme les statuts/projets).
// ============================================================================
function fmtEuro(n) {
  const v = Number(n) || 0;
  return v.toLocaleString("fr-FR", { maximumFractionDigits: 0 }) + " €";
}
// Version compacte pour les axes de graphiques (1,2k€ au lieu de 1200 €).
function fmtEuroCompact(n) {
  const v = Number(n) || 0;
  if (Math.abs(v) >= 1000000) return (v / 1000000).toLocaleString("fr-FR", { maximumFractionDigits: 1 }) + "M€";
  if (Math.abs(v) >= 1000) return (v / 1000).toLocaleString("fr-FR", { maximumFractionDigits: 1 }) + "k€";
  return Math.round(v) + "€";
}

// Taux de consommation budgétaire réel — utilisé à la fois dans l'en-tête du
// tableau de bord financier ET dans le widget "Budget Burn Rate" du dashboard,
// pour ne jamais dupliquer ce calcul. Basé sur les dépenses réellement
// enregistrées (jamais de rythme inventé) : rythme journalier depuis la
// première dépense, projeté sur le budget restant.
// Accepte soit un projet unique (mode historique, filtre lui-même ses dépenses),
// soit un budget + des dépenses déjà agrégées (mode dossier — plusieurs
// projets réunis) — pour rester réutilisable dans les deux cas sans dupliquer
// le calcul de rythme de consommation.
// Échelle 5×5 classique (probabilité × impact, chacun de 1 à 5) — le standard
// le plus reconnu en gestion de risques, pour rester lisible sans formation
// spécifique. Score = probabilité × impact (1 à 25), regroupé en 4 niveaux.









function calculateBudgetBurnRate({ project, expenses, budgetActuel: budgetActuelOverride, poolExpenses }) {
  if (!project && budgetActuelOverride === undefined) return { status: "noProject" };
  const budgetActuel = budgetActuelOverride !== undefined ? budgetActuelOverride : (Number(project.budgetActuel) || Number(project.budgetInitial) || 0);
  const projExpenses = poolExpenses || expenses.filter((e) => e.projectId === project.id);
  const totalSpent = projExpenses.reduce((s, e) => s + (Number(e.amount) || 0), 0);
  const pctConsumed = budgetActuel > 0 ? Math.round((totalSpent / budgetActuel) * 100) : 0;
  const remaining = budgetActuel - totalSpent;

  const dates = projExpenses.map((e) => e.date).filter(Boolean).sort();
  if (dates.length === 0) return { status: "noDates", budgetActuel, totalSpent, remaining, pctConsumed };

  const firstDate = dates[0];
  const today = iso(new Date());
  const daysElapsed = Math.max(1, dayIndex(today) - dayIndex(firstDate));
  const dailyRate = totalSpent / daysElapsed;
  const weeklyRate = dailyRate * 7;
  const weeksRemaining = dailyRate > 0 ? Math.round((remaining / dailyRate) / 7 * 10) / 10 : null;

  let healthStatus;
  if (remaining < 0) healthStatus = "over";
  else if (weeksRemaining !== null && weeksRemaining < 4) healthStatus = "risk";
  else healthStatus = "ok";

  return { status: "ready", budgetActuel, totalSpent, remaining, pctConsumed, dailyRate, weeklyRate, weeksRemaining, healthStatus, daysElapsed };
}
























// ============================================================================
// Échéances — sources publiques + manuel/récurrent (hors Google Calendar,
// hors finances, et sans réimporter les tâches Nexora comme source).
// ============================================================================
const DEADLINE_TYPES = [
  { value:"info", label:"Information" },
  { value:"action", label:"Action requise" },
  { value:"renewal", label:"Renouvellement" },
  { value:"expiration", label:"Expiration" },
  { value:"important", label:"Événement important" },
];
const DEADLINE_CATEGORIES = ["Impôts","Administratif","Famille","Santé","Véhicules","Maison","Abonnements","Voyages","Calendrier public"];
const DEADLINE_COLORS = { tax:"#E5573F", school:"#4E7CC7", holiday:"#2E9B72", clock:"#8A64C5", manual:"#A56A2A", gmail:"#D14F4F" };
const deadlineDate = (d) => { const x=new Date((d||"")+"T12:00:00"); return Number.isNaN(x.getTime()) ? null : x; };
const daysFromToday = (d) => { const x=deadlineDate(d); if(!x) return 0; const t=new Date(); t.setHours(12,0,0,0); return Math.round((x-t)/86400000); };
const deadlineMonthLabel = (date) => deadlineDate(date)?.toLocaleDateString("fr-FR",{month:"long",year:"numeric"}) || "";
const deadlineDayLabel = (date) => deadlineDate(date)?.toLocaleDateString("fr-FR",{day:"2-digit",month:"short"}).replace(".","") || date;
function lastSunday(year, monthIndex){ const d=new Date(year,monthIndex+1,0,12); d.setDate(d.getDate()-d.getDay()); return iso(d); }
function easterSunday(year){ const a=year%19,b=Math.floor(year/100),c=year%100,d=Math.floor(b/4),e=b%4,f=Math.floor((b+8)/25),g=Math.floor((b-f+1)/3),h=(19*a+b-d-g+15)%30,i=Math.floor(c/4),k=c%4,l=(32+2*e+2*i-h-k)%7,m=Math.floor((a+11*h+22*l)/451),month=Math.floor((h+l-7*m+114)/31)-1,day=((h+l-7*m+114)%31)+1; return new Date(year,month,day,12); }
function addDaysIso(date,n){ const d=new Date(date); d.setDate(d.getDate()+n); return iso(d); }
function publicHolidayItems(year){ const easter=easterSunday(year); return [
  [year+"-01-01","Jour de l’An"],[addDaysIso(easter,1),"Lundi de Pâques"],[year+"-05-01","Fête du Travail"],[year+"-05-08","Victoire 1945"],[addDaysIso(easter,39),"Ascension"],[addDaysIso(easter,50),"Lundi de Pentecôte"],[year+"-07-14","Fête nationale"],[year+"-08-15","Assomption"],[year+"-11-01","Toussaint"],[year+"-11-11","Armistice"],[year+"-12-25","Noël"]
].map(([date,title])=>({id:`public-holiday-${date}`,title,date,type:"info",category:"Calendrier public",source:"PUBLIC",provider:"Jours fériés France",description:"Jour férié national",status:"upcoming",reminders:[],publicKey:`holiday:${date}`})); }
function schoolHolidayItems(zone="A"){
  const common=[["2026-09-01","Rentrée scolaire","Rentrée des élèves 2026-2027"],["2026-10-17","Vacances de la Toussaint","Fin des cours"],["2026-11-02","Reprise après Toussaint","Reprise des cours"],["2026-12-19","Vacances de Noël","Fin des cours"],["2027-01-04","Reprise après Noël","Reprise des cours"]];
  const byZone={
    A:[["2027-02-13","Vacances d’hiver","Fin des cours"],["2027-03-01","Reprise après vacances d’hiver","Reprise des cours"],["2027-04-10","Vacances de printemps","Fin des cours"],["2027-04-26","Reprise après vacances de printemps","Reprise des cours"]],
    B:[["2027-02-20","Vacances d’hiver","Fin des cours"],["2027-03-08","Reprise après vacances d’hiver","Reprise des cours"],["2027-04-17","Vacances de printemps","Fin des cours"],["2027-05-03","Reprise après vacances de printemps","Reprise des cours"]],
    C:[["2027-02-06","Vacances d’hiver","Fin des cours"],["2027-02-22","Reprise après vacances d’hiver","Reprise des cours"],["2027-04-03","Vacances de printemps","Fin des cours"],["2027-04-19","Reprise après vacances de printemps","Reprise des cours"]]
  };
  return [...common,...(byZone[zone]||byZone.A),["2027-05-07","Pont scolaire","Pas de classe · calendrier national"],["2027-07-03","Vacances d’été","Fin des cours 2026-2027"]]
    .map(([date,title,description])=>({id:`school-${zone}-${date}-${title}`,title,date,type:"info",category:"Famille",source:"PUBLIC",provider:`Éducation nationale · Zone ${zone}`,description:`${description} · Zone ${zone}`,status:"upcoming",reminders:[],publicKey:`school:${zone}:${date}:${title}`}));
}
function clockChangeItems(year){ return [
  {date:lastSunday(year,2),title:"Passage à l’heure d’été",description:"Changement d’heure · France"},
  {date:lastSunday(year,9),title:"Passage à l’heure d’hiver",description:"Changement d’heure · France"}
].map(x=>({...x,id:`clock-${x.date}`,type:"info",category:"Calendrier public",source:"PUBLIC",provider:"Changement d’heure",status:"upcoming",reminders:[],publicKey:`clock:${x.date}`})); }
function taxItems2026(){ return [
  ["2026-09-15","Impôt sur le revenu : date limite de paiement","Paiement non dématérialisé, si concerné"],
  ["2026-09-20","Impôt sur le revenu : paiement en ligne","Date limite de paiement en ligne, si concerné"],
  ["2026-09-25","Impôt sur le revenu : prélèvement du solde","1 échéance si solde ≤ 300 €, sinon 1re des 4 échéances"],
  ["2026-09-30","Taxe foncière : adhésion au prélèvement à l’échéance","Date limite d’adhésion, si concerné"],
  ["2026-10-15","Taxe foncière : date limite de paiement","Paiement non dématérialisé, si concerné"],
  ["2026-10-20","Taxe foncière : paiement en ligne","Date limite de paiement en ligne, si concerné"],
  ["2026-10-26","Impôt sur le revenu : 2e prélèvement du solde","Si solde supérieur à 300 €"],
  ["2026-11-25","Impôt sur le revenu : 3e prélèvement du solde","Si solde supérieur à 300 €"],
  ["2026-11-30","Correction déclaration de revenus : fermeture","Fin du service de correction en ligne 2026"],
  ["2026-12-28","Impôt sur le revenu : 4e prélèvement du solde","Si solde supérieur à 300 €"]
].map(([date,title,description])=>({id:`tax-${date}-${title}`,title,date,type:"action",category:"Impôts",source:"PUBLIC",provider:"DGFiP · calendrier fiscal 2026",description,status:"upcoming",reminders:[30,7,1],publicKey:`tax:${date}:${title}`})); }
function mergePublicDeadlines(existing, incoming){ const manual=existing.filter(x=>x.source!=="PUBLIC"); const existingPublic=new Map(existing.filter(x=>x.source==="PUBLIC").map(x=>[x.publicKey||x.id,x])); const merged=incoming.map(x=>({...x,...(existingPublic.get(x.publicKey||x.id)||{}),title:x.title,date:x.date,source:"PUBLIC",provider:x.provider,publicKey:x.publicKey})); return [...manual,...merged]; }

const SYNCED_CALENDAR_DEFS = [
  { id:"fr-holidays", label:"Jours fériés France", description:"Jours fériés nationaux français", icon:"tabler:flag", defaultProjectName:"Jours fériés", defaultColor:"#2E9B72" },
  { id:"school-holidays", label:"Vacances scolaires", description:"Rentrée, vacances et reprises selon la zone scolaire", icon:"tabler:school", defaultProjectName:"Vacances scolaires", defaultColor:"#4E7CC7" },
  { id:"clock-changes", label:"Changements d’heure", description:"Passage heure d’été / heure d’hiver", icon:"tabler:clock", defaultProjectName:"Changements d’heure", defaultColor:"#8A64C5" },
  { id:"taxes", label:"Calendrier fiscal DGFiP", description:"Principales dates fiscales des particuliers", icon:"tabler:building-bank", defaultProjectName:"Fiscalité", defaultColor:"#E5573F" },
];

function normalizedSyncedCalendars(settings){
  const saved = Array.isArray(settings?.calendars) ? settings.calendars : [];
  return SYNCED_CALENDAR_DEFS.map(def => {
    const hit = saved.find(c => c.id === def.id) || {};
    return {
      id: def.id,
      enabled: hit.enabled !== false,
      projectName: hit.projectName || def.defaultProjectName,
      color: hit.color || def.defaultColor,
    };
  });
}

function syncedCalendarItems(calendarId, settings){
  const years=[new Date().getFullYear(), new Date().getFullYear()+1];
  if(calendarId==="fr-holidays") return years.flatMap(y=>publicHolidayItems(y));
  if(calendarId==="school-holidays") return schoolHolidayItems(settings?.zone || "A");
  if(calendarId==="clock-changes") return years.flatMap(y=>clockChangeItems(y));
  if(calendarId==="taxes"){
    // Référentiel fiscal actuellement disponible dans cette version : 2026.
    return new Date().getFullYear()===2026 ? taxItems2026() : [];
  }
  return [];
}

function SyncedCalendarsSettingsPane({ settings, setSettings, projects, tasks, onSync, pushToast }){
  const calendars = normalizedSyncedCalendars(settings);
  const updateCalendar = (id, patch) => {
    setSettings(prev => {
      const current = normalizedSyncedCalendars(prev);
      return { ...prev, calendars: current.map(c => c.id===id ? { ...c, ...patch } : c) };
    });
  };
  const linkedProject = (id) => projects.find(p => p.syncedCalendarSource && p.syncedCalendarId===id);
  return (
    <div className="lp-settings-pane">
      <div className="lp-section-title">Calendriers synchronisés</div>
      <p style={{fontSize:12.5,color:"var(--text-600)",marginTop:-6,lineHeight:1.5}}>
        Chaque calendrier activé crée son propre projet Nexora. Les dates sont importées comme jalons du projet correspondant.
        La source reste le calendrier public : lors d’une synchronisation, les jalons générés sont reconstruits sans toucher aux autres projets.
      </p>

      <div className="lp-row2">
        <div className="lp-field">
          <label>Zone scolaire</label>
          <select value={settings?.zone || "A"} onChange={e=>setSettings(p=>({...p,zone:e.target.value}))}>
            <option value="A">Zone A</option><option value="B">Zone B</option><option value="C">Zone C</option>
          </select>
        </div>
        <div className="lp-field">
          <label>Département fiscal</label>
          <input value={settings?.department || "69"} onChange={e=>setSettings(p=>({...p,department:e.target.value}))} placeholder="69"/>
        </div>
      </div>

      <div className="lp-section-title" style={{marginTop:4}}>Sources</div>
      {SYNCED_CALENDAR_DEFS.map(def=>{
        const cal=calendars.find(c=>c.id===def.id);
        const proj=linkedProject(def.id);
        const count=proj ? tasks.filter(t=>t.projectId===proj.id && t.syncedCalendarImported).length : 0;
        return (
          <div key={def.id} className="lp-gcal-calendar-row" style={{alignItems:"center",padding:"8px 0"}}>
            <label className="lp-checkbox-row" style={{padding:"7px 0",minWidth:210}}>
              <input type="checkbox" checked={!!cal.enabled} onChange={e=>updateCalendar(def.id,{enabled:e.target.checked})}/>
              <span className="lp-project-dot" style={{background:cal.color,width:16,height:16}}><IconGlyph icon={def.icon} size={9}/></span>
              <span style={{textTransform:"none",fontWeight:650,fontSize:13.5}}>{def.label}</span>
            </label>
            <div style={{flex:1,minWidth:0}}>
              <div style={{fontSize:10.5,color:"var(--text-600)",marginBottom:5}}>{def.description}</div>
              <input
                type="text"
                className="lp-gcal-custom-name-input"
                value={cal.projectName}
                onChange={e=>updateCalendar(def.id,{projectName:e.target.value})}
                placeholder={def.defaultProjectName}
                disabled={!cal.enabled}
              />
            </div>
            <input
              type="color"
              value={cal.color}
              onChange={e=>updateCalendar(def.id,{color:e.target.value})}
              disabled={!cal.enabled}
              title="Couleur du projet"
              style={{width:34,height:30,border:"1px solid var(--border)",borderRadius:6,background:"var(--surface)",padding:3}}
            />
            <div style={{width:110,textAlign:"right",fontSize:9.5,color:"var(--text-muted)"}}>
              {proj ? `${count} jalon${count>1?"s":""}` : (cal.enabled ? "Projet à créer" : "Désactivé")}
            </div>
          </div>
        );
      })}

      <div style={{display:"flex",alignItems:"center",gap:8,marginTop:8}}>
        <button className="lp-btn lp-btn-primary" onClick={onSync}><RefreshCw size={13}/> Synchroniser maintenant</button>
        {settings?.lastSyncAt && <span style={{fontSize:9.5,color:"var(--text-muted)"}}>Dernière synchro : {new Date(settings.lastSyncAt).toLocaleString("fr-FR")}</span>}
      </div>
      <div style={{marginTop:8,padding:"9px 11px",borderLeft:"3px solid var(--line-blue)",background:"var(--paper-soft)",fontSize:11.5,lineHeight:1.45,color:"var(--text-600)"}}>
        Gmail n’est plus utilisé par ce module. Google Calendar conserve sa synchronisation séparée dans son propre réglage.
      </div>
    </div>
  );
}

function NotificationsView({ notifications, setNotifications, toolbarSlot }) {
  const unreadCount = notifications.filter((n) => !n.read).length;
  const markRead = (id) => setNotifications((prev) => prev.map((n) => (n.id === id ? { ...n, read: true } : n)));
  const markAllRead = () => setNotifications((prev) => prev.map((n) => ({ ...n, read: true })));
  const [confirmClearAll, setConfirmClearAll] = useState(false);

  return (
    <div className="lp-notifications-wrap">
      <ViewToolbarPortal slot={toolbarSlot}>
        {unreadCount > 0 && <button className="lp-btn" onClick={markAllRead}><Check size={13} style={{ marginRight: 4, verticalAlign: -2 }} />Tout marquer comme lu</button>}
        {notifications.length > 0 && <button className="lp-btn" onClick={() => setConfirmClearAll(true)}><Trash2 size={13} style={{ marginRight: 4, verticalAlign: -2 }} />Tout effacer</button>}
      </ViewToolbarPortal>
      {confirmClearAll && (
        <ConfirmModal
          title="Effacer les notifications"
          message="Effacer toutes les notifications ? Cette action est irréversible."
          danger
          confirmLabel="Tout effacer"
          onConfirm={() => { setNotifications([]); setConfirmClearAll(false); }}
          onClose={() => setConfirmClearAll(false)}
        />
      )}

      {notifications.length === 0 ? (
        <div className="lp-empty" style={{ padding: 30 }}>Aucune notification pour l'instant. Les automatisations avec une action « Créer une notification » apparaîtront ici.</div>
      ) : (
        <div className="lp-notifications-list">
          {notifications.map((n) => (
            <div key={n.id} className={"lp-notification-row" + (n.read ? "" : " unread")} onClick={() => markRead(n.id)}>
              {!n.read && <span className="lp-notification-dot" />}
              <div className="lp-notification-main">
                <div className="lp-notification-message">{n.message}</div>
                <div className="lp-notification-time">{new Date(n.createdAt).toLocaleString("fr-FR")}</div>
              </div>
            </div>
          ))}
        </div>
      )}
    </div>
  );
}





const root = createRoot(document.getElementById('root'));
root.render(React.createElement(AuthGate));
</script>

<style id="life-suite-visual-system-v1">
/* Life dashboards · shared visual system · 2026-09-04
   Presentation only. App-specific grids, data colours and saved sizes remain owned by each app. */
:root {
  --life-font: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  --life-mono: ui-monospace, 'SFMono-Regular', Consolas, monospace;
  --life-bg: #f3f5f9;
