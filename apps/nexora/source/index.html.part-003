  const chipLate = (d) => '<span class="lp-cosmos-chip is-late">↘ Retard ' + d + " j</span>";
  function labelHtml(c) {
    const M = S.model;
    if (c.kind === "galaxy") {
      const g = M.galaxyById[c.id];
