  function box(w, h, d, m, x, y, z, parent, cast) {
    const mesh = new THREE.Mesh(geo("box:" + w + ":" + h + ":" + d, () => new THREE.BoxGeometry(w, h, d)), m);
    mesh.position.set(x, y, z); mesh.receiveShadow = true; if (cast !== false && S.quality === "high") mesh.castShadow = true;
    (parent || S.scene).add(mesh); return mesh;
