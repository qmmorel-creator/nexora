  --life-control-radius: 9px;
  --life-shadow: 0 2px 8px rgba(24,38,61,.035), 0 8px 24px rgba(24,38,61,.025);
  --life-menu-shadow: 0 16px 48px rgba(24,38,61,.16);
}
body[data-life-app] {
  margin: 0;
  background: var(--life-bg) !important;
  color: var(--life-text);
  font-family: var(--life-font) !important;
  font-size: 14px;
