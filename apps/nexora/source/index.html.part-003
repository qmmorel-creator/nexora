    if (Object.keys(pool).length > 500) Object.keys(pool).forEach((k) => { if (!seen[k]) { pool[k].remove(); delete pool[k]; } });
  }

  // ---------- Données ----------
  function setData(d) {
    const modelChanged = d.model !== S.model;
    const prevExtent = S.model ? S.model.extent : null;
    S.model = d.model; S.norm = d.norm; S.visible = d.visible || null; S.dimmed = d.dimmed || new Set();
    S.preview = d.preview || null;
