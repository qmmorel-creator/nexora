      if (c.tier === 2) return '<span class="lp-cosmos-gtext"><b>' + esc(g.name) + "</b><em>" + (g.projectIds.length ? plural(g.projectIds.length, "projet") : "Aucun projet") + late + "</em></span>";
      return '<span class="lp-cosmos-gico" aria-hidden="true"></span><span class="lp-cosmos-gtext"><small>' + (g.unsorted ? "SANS DOSSIER" : "DOSSIER") + "</small><b>" + esc(g.name) + "</b><em>" + (g.projectIds.length ? plural(g.projectIds.length, "projet") + " · " + plural(g.stats.total, "tâche") : "Aucun projet") + late + "</em></span>";
    }
