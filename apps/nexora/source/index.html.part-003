    if (modelChanged) {
      resolveQuality();
      if (prevExtent == null || Math.abs(prevExtent - S.model.extent) > 1) buildEnvironment();
      buildGalaxies();
      if (prevExtent == null) goTo(frameFor(S.level, S.level === "galaxy" ? S.galaxyId : S.planetId), true);
    }
    buildPlanets();
    S.dirty = true;
  }
  function setPreview(p) { S.preview = p; if (satCubes) placeSatellites(); S.dirty = true; }
  function recenter() { S.yaw = 0.35; S.pitch = S.level === "planet" ? 0.42 : S.level === "galaxy" ? 0.6 : 0.72; goTo(frameFor(S.level, S.level === "galaxy" ? S.galaxyId : S.planetId)); }
  function setQuality(q) { S.quality = q; if (S.model) { resolveQuality(); buildEnvironment(); buildPlanets(); } }
  function setAnimate(on) { S.animate = on !== false; S.dirty = true; }
  S.viewOffset = [0, 0];
  function applyViewOffset() {
    const w = container.clientWidth || 300, h = container.clientHeight || 300;
    if (S.viewOffset[0] || S.viewOffset[1]) camera.setViewOffset(w, h, S.viewOffset[0], S.viewOffset[1], w, h);
    else camera.clearViewOffset();
    camera.updateProjectionMatrix();
    S.dirty = true;
  }
  function resize() {
    const w = container.clientWidth || 300, h = container.clientHeight || 300;
    renderer.setSize(w, h);
    camera.aspect = w / h;
    applyViewOffset();
  }
  const ro = new ResizeObserver(resize);
  ro.observe(container);
  resize();
  // Hors de l'écran (widget d'un tableau de bord qu'on a fait défiler, #439),
  // l'univers ne se redessine plus : aucune animation ne tourne pour rien.
  S.onScreen = true;
  const io = typeof IntersectionObserver === "function" ? new IntersectionObserver((entries) => { entries.forEach((en) => { S.onScreen = en.isIntersecting; if (en.isIntersecting) S.dirty = true; }); }) : null;
  if (io) io.observe(container);

  let last = performance.now();
  function frame(now) {
    if (S.disposed) return;
    S.raf = requestAnimationFrame(frame);
    if (document.hidden || !S.onScreen) { last = now; return; }
    const dt = Math.min(0.05, (now - last) / 1000);
    last = now;
    if (!S.model) return;
    const anim = animOn() && satList.length > 0;
    if (anim) { S.time += dt; placeSatellites(); S.dirty = true; }
    // Couronnes des soleils : rotation lente (effet visuel seulement).
    if (animOn() && S.level !== "planet") { coronaMats[0].rotation += dt * 0.04; coronaMats[1].rotation -= dt * 0.025; S.dirty = true; }
    updateHover();
    if (!S.dirty && !S.goal) return;
    S.dirty = false;
    updateCamera(dt);
    updateSelectionFx();
    renderer.render(scene, camera);
    updateLabels();
  }
  S.raf = requestAnimationFrame(frame);

  return {
    setData, setPreview, setQuality, setAnimate, recenter, zoomBy: (f) => zoomBy(f),
    universe, enterGalaxy, enterPlanet, up, levelUp, reveal,
    select: (sel) => setSelected(sel),
    rotate: (d) => { S.yaw += d; S.dirty = true; },
    yaw: () => S.yaw,
    setViewOffset: (dx, dy) => { const nx = Math.round(dx || 0), ny = Math.round(dy || 0); if (nx === S.viewOffset[0] && ny === S.viewOffset[1]) return; S.viewOffset = [nx, ny]; applyViewOffset(); },
    state: () => ({ level: S.level, galaxyId: S.galaxyId, planetId: S.planetId, selected: S.selected, quality: S.effQuality, dist: S.dist }),
    dispose() {
      S.disposed = true;
      cancelAnimationFrame(S.raf);
      ro.disconnect();
