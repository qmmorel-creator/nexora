    if (!S.model) return;
    if (S.galaxyId && !S.model.galaxyById[S.galaxyId]) { S.level = "universe"; S.galaxyId = null; S.planetId = null; }
    if (S.planetId && !S.model.planets[S.planetId]) { S.level = S.galaxyId ? "galaxy" : "universe"; S.planetId = null; }
    if (S.selected) {
      const k = S.selected.kind, id = S.selected.id;
